{
  "outputs": [
    "test_button_click.py"
  ],
  "input_files": [
    "page.html"
  ],
  "output_properties": {
    "test_button_click.py": {
      "contains_import": "from playwright.sync_api import sync_playwright",
      "launches_chromium_headless": true,
      "loads_local_file": "file://.../page.html",
      "wait_for_button_text": "Click Me",
      "clicks_button": true,
      "verifies_button_text_changes_to": "Clicked!",
      "closes_browser": true
    },
    "page.html": {
      "contains_button_id": "mybtn",
      "button_initial_text": "Click Me",
      "button_onclick_function_changes_text_to": "Clicked!"
    }
  }
}