#!/usr/bin/env bash
set -euo pipefail

# Smoke test for Telegram footer patch
# Verifies patched files with syntax checking and helper-sanity check

DIST_DIR="${1:-dist}"
MARKER="TELEGRAM_FOOTER_PATCH_MARKER"

echo "=== SMOKE TEST: Telegram Footer Patch ==="
echo "Testing directory: $DIST_DIR"

PASS_COUNT=0
FAIL_COUNT=0

# Find all JS files (excluding backups)
for file in $(find "$DIST_DIR" -name "*.js" ! -name "*.bak.telegram-footer.*" | sort); do
    echo ""
    echo "--- Testing: $file ---"
    
    # Check if file has marker
    if grep -q "$MARKER" "$file"; then
        echo "  [PASS] Marker present"
        ((PASS_COUNT++))
    else
        echo "  [INFO] No marker (may be unpatched file)"
        continue
    fi
    
    # Check if file has footer (using pattern match for Model/Think/Context)
    if grep -qE "(Model.*Think.*Context|Think.*Model.*Context)" "$file"; then
        echo "  [PASS] Footer present"
        ((PASS_COUNT++))
    else
        echo "  [FAIL] Footer missing"
        ((FAIL_COUNT++))
        continue
    fi
    
    # Syntax check: balanced braces
    OPEN_BRACES=$(grep -o '{' "$file" | wc -l)
    CLOSE_BRACES=$(grep -o '}' "$file" | wc -l)
    if [ "$OPEN_BRACES" -eq "$CLOSE_BRACES" ]; then
        echo "  [PASS] Braces balanced ($OPEN_BRACES/$CLOSE_BRACES)"
        ((PASS_COUNT++))
    else
        echo "  [FAIL] Braces unbalanced ($OPEN_BRACES/$CLOSE_BRACES)"
        ((FAIL_COUNT++))
    fi
    
    # Helper sanity: check for function or export
    if grep -qE '(function|export)' "$file"; then
        echo "  [PASS] Helper sanity (has function/export)"
        ((PASS_COUNT++))
    else
        echo "  [WARN] No function/export found"
    fi
done

echo ""
echo "=== SMOKE TEST RESULTS ==="
echo "Passed: $PASS_COUNT"
echo "Failed: $FAIL_COUNT"

if [ "$FAIL_COUNT" -gt 0 ]; then
    echo "SMOKE TEST FAILED"
    exit 1
fi

echo "SMOKE TEST PASSED"
exit 0
SMOKE_EOF
chmod +x /workspace/scripts/smoke_test_footer_patch.sh

