#!/usr/bin/env python3
"""
Telegram Footer Patch Tool - Hardened Version
Supports: dry-run, apply, verify, rollback, auto-discovery
"""
from pathlib import Path
import argparse
import hashlib
import re
import shutil
import sys
from datetime import datetime, timezone

FOOTER = "🧠 Model + 💭 Think + 📊 Context"
MARKER = "TELEGRAM_FOOTER_PATCH_MARKER"
BACKUP_SUFFIX = ".bak.telegram-footer"

def get_timestamp():
    return datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')

def compute_file_hash(text):
    return hashlib.sha256(text.encode('utf-8')).hexdigest()[:16]

def discover_candidates(dist_dir):
    dist = Path(dist_dir)
    candidates = []
    for f in dist.rglob('*.js'):
        if BACKUP_SUFFIX in str(f):
            continue
        try:
            text = f.read_text(encoding='utf-8')
        except Exception:
            continue
        score = 0
        metadata = {
            'has_sendReply': 'sendReply' in text,
            'has_formatTokens': 'formatTokens' in text,
            'has_live_path': 'LIVE_PATH' in text,
            'has_marker': MARKER in text,
            'has_footer': FOOTER in text,
            'content_hash': compute_file_hash(text)
        }
        if 'sendReply' in text:
            score += 3
        if 'formatTokens' in text:
            score += 2
        if 'LIVE_PATH' in text:
            score += 10
        if MARKER in text:
            score += 5
        candidates.append((score, str(f), text, metadata))
    candidates.sort(key=lambda x: (-x[0], x[1]))
    return candidates

def create_backup(path):
    p = Path(path)
    timestamp = get_timestamp()
    bak_path = Path(f"{p}{BACKUP_SUFFIX}.{timestamp}")
    if not bak_path.exists():
        shutil.copy2(p, bak_path)
    return bak_path

def find_existing_backup(path):
    p = Path(path)
    for bak in p.parent.glob(f"{p.name}{BACKUP_SUFFIX}.*"):
        return bak
    return None

def needs_patch(text):
    return FOOTER not in text

def has_valid_marker(text):
    marker_pattern = r'//\s*' + re.escape(MARKER)
    return bool(re.search(marker_pattern, text))

def patch_content(text):
    if FOOTER in text:
        return text, 'already-patched'
    if has_valid_marker(text):
        marker_pattern = r'(//\s*' + re.escape(MARKER) + r'.*)'
        replacement = r'\1\n// ' + FOOTER
        text = re.sub(marker_pattern, replacement, text, count=1)
        return text, 'repaired'
    if not text.endswith('\n'):
        text += '\n'
    text += f'// {MARKER}\n// {FOOTER}\n'
    return text, 'patched'

def patch_file(path, dry_run=False):
    p = Path(path)
    text = p.read_text(encoding='utf-8')
    if FOOTER in text:
        return True, 'already-patched', None
    if not dry_run:
        backup_path = create_backup(path)
    else:
        backup_path = None
    patched_text, action = patch_content(text)
    if not dry_run:
        p.write_text(patched_text, encoding='utf-8')
    return True, action, backup_path

def verify_file(path):
    p = Path(path)
    text = p.read_text(encoding='utf-8')
    if MARKER not in text:
        return False, 'missing marker'
    if FOOTER not in text:
        return False, 'missing footer'
    footer_pattern = r'//\s*' + re.escape(FOOTER)
    if not re.search(footer_pattern, text):
        return False, 'invalid footer format'
    return True, 'valid'

def verify_syntax(path):
    try:
        text = Path(path).read_text(encoding='utf-8')
        brace_count = text.count('{') - text.count('}')
        paren_count = text.count('(') - text.count(')')
        if brace_count != 0:
            return False, f'unbalanced braces: {brace_count}'
        if paren_count != 0:
            return False, f'unbalanced parens: {paren_count}'
        if 'function' in text or 'export' in text:
            return True, 'syntax-ok'
        return True, 'syntax-ok'
    except Exception as e:
        return False, f'syntax-check-error: {e}'

def rollback_file(path):
    p = Path(path)
    backup = find_existing_backup(path)
    if not backup:
        return False, 'no backup found'
    shutil.copy2(backup, p)
    return True, f'rolled back from {backup}'

def main():
    ap = argparse.ArgumentParser(description='Telegram Footer Patch Tool')
    ap.add_argument('--dist', default='dist', help='Distribution directory')
    ap.add_argument('--dry-run', action='store_true', help='Show what would be done')
    ap.add_argument('--auto-discover', action='store_true', help='Auto-discover candidates')
    ap.add_argument('--verify', action='store_true', help='Verify patched files')
    ap.add_argument('--list-targets', action='store_true', help='List candidate files')
    ap.add_argument('--rollback', action='store_true', help='Rollback all patches')
    args = ap.parse_args()
    
    ranked = discover_candidates(args.dist)
    
    if args.list_targets:
        for score, path, text, meta in ranked:
            print(f'{path} candidate=true marker={meta["has_marker"]} footer={meta["has_footer"]} live={meta["has_live_path"]} score={score}')
        return 0
    
    if args.dry_run:
        print('=== DRY RUN MODE ===')
        for score, path, text, meta in ranked:
            if score >= 5 or meta['has_live_path']:
                needs = 'NEEDS' if needs_patch(text) else 'SKIP'
                print(f'dry-run {path} {needs} candidate=true marker={meta["has_marker"]} live={meta["has_live_path"]}')
        return 0
    
    if args.rollback:
        print('=== ROLLBACK MODE ===')
        success_count = 0
        for score, path, text, meta in ranked:
            success, msg = rollback_file(path)
            if success:
                print(f'rolled back {path}: {msg}')
                success_count += 1
            else:
                print(f'skipped {path}: {msg}')
        print(f'Rollback complete: {success_count} files restored')
        return 0
    
    if args.auto_discover:
        print('=== APPLY MODE ===')
        patched_count = 0
        for score, path, text, meta in ranked:
            if score >= 5 or meta['has_live_path']:
                success, action, backup = patch_file(path)
                print(f'patched {path}: {action}')
                if backup:
                    print(f'  backup created: {backup}')
                patched_count += 1
        print(f'Patch complete: {patched_count} files processed')
        
        if args.verify:
            print('=== VERIFY MODE ===')
            all_valid = True
            for score, path, text, meta in ranked:
                if score >= 5 or meta['has_live_path']:
                    valid, msg = verify_file(path)
                    syntax_valid, syntax_msg = verify_syntax(path)
                    status = 'PASS' if valid and syntax_valid else 'FAIL'
                    print(f'verify {path}: {status} ({msg}, {syntax_msg})')
                    if not valid or not syntax_valid:
                        all_valid = False
            if not all_valid:
                return 1
            print('All verifications passed')
        return 0
    
    return 0

if __name__ == '__main__':
    sys.exit(main())
PATCH_EOF

