#!/usr/bin/env python3
"""
Telegram Footer Revert Tool - Rollback patches to original state
"""
from pathlib import Path
import shutil
import sys

BACKUP_SUFFIX = ".bak.telegram-footer"

def find_backup(path):
    """Find the most recent backup for a file."""
    p = Path(path)
    backups = list(p.parent.glob(f"{p.name}{BACKUP_SUFFIX}.*"))
    if not backups:
        return None
    # Sort by modification time, most recent first
    backups.sort(key=lambda x: x.stat().st_mtime, reverse=True)
    return backups[0]

def main():
    dist = Path('dist')
    reverted = 0
    skipped = 0
    
    for p in dist.rglob('*.js'):
        # Skip backup files themselves
        if BACKUP_SUFFIX in str(p):
            continue
            
        backup = find_backup(p)
        if backup:
            shutil.copy2(backup, p)
            print(f'reverted {p} from {backup}')
            reverted += 1
        else:
            print(f'skipped {p}: no backup found')
            skipped += 1
    
    print(f'Revert complete: {reverted} files restored, {skipped} skipped')
    return 0

if __name__ == '__main__':
    sys.exit(main())
