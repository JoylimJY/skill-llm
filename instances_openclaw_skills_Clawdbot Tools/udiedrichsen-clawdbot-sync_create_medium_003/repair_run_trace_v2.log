[EXECUTING python]:
import json
import os

sync_dir = "/workspace/workspace/memory/clawdbot-sync"

# 1. Update peers.json - add office-peer
peers_file = os.path.join(sync_dir, "peers.json")
with open(peers_file, "r") as f:
    peers_data = json.load(f)

# Add the new peer
new_peer = {
    "name": "office-peer",
    "address": "100.64.12.34",
    "user": "clawdbot",
    "path": "/home/clawdbot/clawd",
    "status": "pending",
    "bidirectional": True
}
peers_data["peers"].append(new_peer)

with open(peers_file, "w") as f:
    json.dump(peers_data, f, indent=2)

# 2. Update history.json - record pending sync entry
history_file = os.path.join(sync_dir, "history.json")
with open(history_file, "r") as f:
    history_data = json.load(f)

pending_entry = {
    "peer": "office-peer",
    "action": "push",
    "status": "pending",
    "workspace": "$WORKSPACE",
    "timestamp": "pending"
}
history_data["entries"].append(pending_entry)

with open(history_file, "w") as f:
    json.dump(history_data, f, indent=2)

# 3. Update config.json - enable bi-directional sync for this peer
config_file = os.path.join(sync_dir, "config.json")
with open(config_file, "r") as f:
    config_data = json.load(f)

# Enable auto_sync for bi-directional sync, keep sync_identity false (don't touch identity)
config_data["auto_sync"] = True
config_data["sync_identity"] = False  # Keep as is - don't touch identity files
config_data["pending_peers"] = ["office-peer"]

with open(config_file, "w") as f:
    json.dump(config_data, f, indent=2)

print("Done! Updated files:")
print("- peers.json: added office-peer")
print("- history.json: added pending sync entry")
print("- config.json: enabled auto_sync for bi-directional sync")

