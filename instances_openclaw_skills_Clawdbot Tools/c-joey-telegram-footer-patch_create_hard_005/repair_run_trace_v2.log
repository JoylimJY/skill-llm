from pathlib import Path

patcher_code = r'''#!/usr/bin/env python3
"""OpenClaw Telegram Footer Patcher"""

import json
import sys
import shutil
import hashlib
from datetime import datetime
from pathlib import Path
from typing import Optional, List, Dict, Any

WORKSPACE = Path("/workspace")
DIST_DIR = WORKSPACE / "dist"
METADATA_FILE = WORKSPACE / "fixture_metadata.json"
REPORTS_DIR = WORKSPACE / "reports"

TELEGRAM_FOOTER = """
// OpenClaw Telegram Footer
// 🧠 Model + 💭 Think + 📊 Context
// Private chat marker: injected
"""

BACKUP_SUFFIX = ".patched-backup"

def load_metadata() -> Dict[str, Any]:
    with open(METADATA_FILE, "r") as f:
        return json.load(f)

def calculate_file_hash(filepath: Path) -> str:
    sha256 = hashlib.sha256()
    with open(filepath, "rb") as f:
        for chunk in iter(lambda: f.read(8192), b""):
            sha256.update(chunk)
    return sha256.hexdigest()

def get_candidate_bundles(metadata: Dict[str, Any]) -> List[Path]:
    candidates = []
    for path_str in metadata.get("bundle_candidates", []):
        path = WORKSPACE / path_str
        if path.exists():
            candidates.append(path)
    return candidates

def content_based_discovery(metadata: Dict[str, Any]) -> Optional[Path]:
    known_marker = metadata.get("known_marker", "")
    candidates = get_candidate_bundles(metadata)
    for candidate in candidates:
        with open(candidate, "r", encoding="utf-8", errors="ignore") as f:
            if known_marker in f.read():
                return candidate
    expected_primary = metadata.get("expected_primary", "")
    if expected_primary:
        primary_path = WORKSPACE / expected_primary
        if primary_path.exists():
            return primary_path
    for candidate in candidates:
        if candidate.exists():
            return candidate
    return None

def is_footer_present(content: str) -> bool:
    return any(c in content for c in [
        "OpenClaw Telegram Footer",
        "Private chat marker: injected",
        "🧠 Model + 💭 Think + 📊 Context"
    ])

def create_backup(filepath: Path) -> Path:
    backup_path = Path(str(filepath) + BACKUP_SUFFIX)
    shutil.copy2(filepath, backup_path)
    return backup_path

def read_file(filepath: Path) -> str:
    with open(filepath, "r", encoding="utf-8", errors="ignore") as f:
        return f.read()

def write_file(filepath: Path, content: str) -> None:
    with open(filepath, "w", encoding="utf-8") as f:
        f.write(content)

def patch_bundle(filepath: Path, dry_run: bool = False) -> Dict[str, Any]:
    result = {"file": str(filepath), "success": False, "already_patched": False,
              "backup_created": False, "dry_run": dry_run, "original_hash": "",
              "new_hash": "", "error": None}
    try:
        content = read_file(filepath)
        result["original_hash"] = calculate_file_hash(filepath)
        if is_footer_present(content):
            result["already_patched"] = True
            result["success"] = True
            result["message"] = "Footer already present, skipping"
            return result
        if dry_run:
            result["success"] = True
            result["message"] = "Dry run: would insert footer"
            result["new_hash"] = hashlib.sha256((content + TELEGRAM_FOOTER).encode("utf-8")).hexdigest()
            return result
        backup_path = create_backup(filepath)
        result["backup_created"] = True
        result["backup_path"] = str(backup_path)
        new_content = content.rstrip() + "\n" + TELEGRAM_FOOTER
        write_file(filepath, new_content)
        result["new_hash"] = calculate_file_hash(filepath)
        result["success"] = True
        result["message"] = "Footer inserted successfully"
    except Exception as e:
        result["error"] = str(e)
    return result

def revert_patch(filepath: Path) -> Dict[str, Any]:
    result = {"file": str(filepath), "success": False, "error": None}
    backup_path = Path(str(filepath) + BACKUP_SUFFIX)
    try:
        if not backup_path.exists():
            result["error"] = f"No backup found at {backup_path}"
            return result
        shutil.copy2(backup_path, filepath)
        result["success"] = True
        result["message"] = "Patch reverted successfully"
    except Exception as e:
        result["error"] = str(e)
    return result

def verify_patch(filepath: Path) -> Dict[str, Any]:
    result = {"file": str(filepath), "success": False, "has_footer": False,
              "is_valid_js": True, "error": None}
    try:
        content = read_file(filepath)
        result["has_footer"] = is_footer_present(content)
        result["success"] = result["has_footer"]
        if not content.strip():
            result["is_valid_js"] = False
            result["error"] = "File is empty"
    except Exception as e:
        result["error"] = str(e)
    return result

def generate_report(results: List[Dict[str, Any]], mode: str) -> str:
    report = {"timestamp": datetime.utcnow().isoformat() + "Z", "mode": mode,
              "workspace": str(WORKSPACE), "results": results,
              "summary": {"total": len(results), "successful": sum(1 for r in results if r.get("success")),
                          "already_patched": sum(1 for r in results if r.get("already_patched")),
                          "errors": sum(1 for r in results if r.get("error"))}}
    return json.dumps(report, indent=2)

def run_discovery(metadata: Dict[str, Any]) -> Dict[str, Any]:
    candidates = get_candidate_bundles(metadata)
    discovered = content_based_discovery(metadata)
    return {"candidates_found": len(candidates), "candidate_paths": [str(c) for c in candidates],
            "discovered_target": str(discovered) if discovered else None,
            "expected_primary": metadata.get("expected_primary")}

def main():
    if len(sys.argv) < 2:
        print("Usage: patcher.py <command> [options]")
        print("Commands: discover, dry-run, apply, verify, revert")
        sys.exit(1)
    command = sys.argv[1]
    metadata = load_metadata()
    
    if command == "discover":
        print(json.dumps(run_discovery(metadata), indent=2))
        sys.exit(0)
    
    discovered = content_based_discovery(metadata)
    if not discovered:
        print("Error: No bundle found", file=sys.stderr)
        sys.exit(1)
    
    if command == "dry-run":
        print(json.dumps(patch_bundle(discovered, dry_run=True), indent=2))
        sys.exit(0)
    
    if command == "apply":
        result = patch_bundle(discovered, dry_run=False)
        REPORTS_DIR.mkdir(exist_ok=True)
        write_file(REPORTS_DIR / "patch_report.json", generate_report([result], "apply"))
        print(json.dumps(result, indent=2))
        sys.exit(0 if result["success"] else 1)
    
    if command == "verify":
        result = verify_patch(discovered)
        print(json.dumps(result, indent=2))
        sys.exit(0 if result["success"] else 1)
    
    if command == "revert":
        result = revert_patch(discovered)
        print(json.dumps(result, indent=2))
        sys.exit(0 if result["success"] else 1)
    
    print(f"Unknown command: {command}", file=sys.stderr)
    sys.exit(1)

if __name__ == "__main__":
    main()
'''

