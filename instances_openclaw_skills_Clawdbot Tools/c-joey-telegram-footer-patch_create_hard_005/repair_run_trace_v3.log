# Write patcher.py using Python file operations
code = r'''#!/usr/bin/env python3
"""OpenClaw Telegram Footer Patcher"""

import json, sys, shutil, argparse
from pathlib import Path
from datetime import datetime

WORKSPACE = Path("/workspace")
FIXTURE_FILE = WORKSPACE / "fixture_metadata.json"
DIST_DIR = WORKSPACE / "dist"
BACKUP_DIR = WORKSPACE / "dist" / "backups"
REPORTS_DIR = WORKSPACE / "reports"

TELEGRAM_FOOTER_MARKER = "🧠 Model + 💬 Think + 📊 Context"
FOOTER_BLOCK = """
// OpenClaw Telegram Footer
// Marker: 🧠 Model + 💬 Think + 📊 Context
// Auto-patched by OpenClaw Patcher
"""

def load_fixture():
    with open(FIXTURE_FILE, "r") as f:
        return json.load(f)

def discover_bundles(fixture):
    candidates = []
    if "bundle_candidates" in fixture:
        for c in fixture["bundle_candidates"]:
            p = WORKSPACE / c
            if p.exists():
                candidates.append(p)
    if not candidates and DIST_DIR.exists():
        candidates = sorted(DIST_DIR.glob("*.js"))
    expected = fixture.get("expected_primary", "")
    if expected:
        primary = WORKSPACE / expected
        if primary in candidates:
            candidates.remove(primary)
            candidates.insert(0, primary)
    return candidates

def content_based_discovery(candidates):
    for c in candidates:
        try:
            content = c.read_text(encoding="utf-8")
            if any(p.lower() in content.lower() for p in ["module.exports", "sendReply", "version", "agent"]):
                return c
        except: pass
    return candidates[0] if candidates else None

def footer_present(content, marker):
    return marker in content

def create_backup(path):
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    bak = BACKUP_DIR / f"{path.stem}_{ts}.bak"
    shutil.copy2(path, bak)
    return bak

def patch_bundle(path, marker, dry_run=False):
    result = {"path": str(path), "success": False, "already_patched": False, "backup_created": None, "dry_run": dry_run, "error": None}
    try:
        content = path.read_text(encoding="utf-8")
        if footer_present(content, marker):
            result["already_patched"] = True
            result["success"] = True
            return result
        if dry_run:
            result["success"] = True
            result["would_append"] = len(FOOTER_BLOCK)
            return result
        bak = create_backup(path)
        result["backup_created"] = str(bak)
        new = content.rstrip() + "\n" + FOOTER_BLOCK + "\n"
        path.write_text(new, encoding="utf-8")
        result["success"] = True
    except Exception as e:
        result["error"] = str(e)
    return result

def verify_patch(path, marker):
    result = {"path": str(path), "verified": False, "error": None}
    try:
        content = path.read_text(encoding="utf-8")
        result["verified"] = footer_present(content, marker)
        result["contains_marker"] = marker in content
        result["file_size"] = path.stat().st_size
    except Exception as e:
        result["error"] = str(e)
    return result

def revert_patch(path, backup):
    result = {"path": str(path), "success": False, "error": None}
    try:
        if not Path(backup).exists():
            result["error"] = f"Backup not found: {backup}"
            return result
        shutil.copy2(backup, path)
        result["success"] = True
    except Exception as e:
        result["error"] = str(e)
    return result

def check_syntax(path):
    result = {"path": str(path), "syntax_valid": False, "error": None}
    try:
        content = path.read_text(encoding="utf-8")
        if not content.strip():
            result["error"] = "Empty file"
            return result
        if content.count("{") != content.count("}"):
            result["error"] = "Unbalanced braces"
            return result
        if content.count("(") != content.count(")"):
            result["error"] = "Unbalanced parens"
            return result
        result["syntax_valid"] = True
    except Exception as e:
        result["error"] = str(e)
    return result

def gen_report(ops, out):
    rpt = {"timestamp": datetime.now().isoformat(), "marker": TELEGRAM_FOOTER_MARKER, "operations": ops,
           "summary": {"total": len(ops), "successful": sum(1 for o in ops if o.get("success") or o.get("verified")),
                      "already_patched": sum(1 for o in ops if o.get("already_patched")),
                      "errors": sum(1 for o in ops if o.get("error"))}}
    REPORTS_DIR.mkdir(parents=True, exist_ok=True)
    with open(out, "w") as f:
        json.dump(rpt, f, indent=2)
    return rpt

def main():
    p = argparse.ArgumentParser(description="OpenClaw Telegram Footer Patcher")
    p.add_argument("mode", choices=["discover", "dry-run", "apply", "verify", "revert"])
    p.add_argument("--target", "-t", help="Target bundle")
    p.add_argument("--backup", "-b", help="Backup path for revert")
    p.add_argument("--report", "-r", default="patch_report.json")
    args = p.parse_args()

    fixture = load_fixture()
    marker = fixture.get("known_marker", TELEGRAM_FOOTER_MARKER)
    bundles = discover_bundles(fixture)
    if not bundles:
        print("ERROR: No bundles found!"); sys.exit(1)

    rpt_path = REPORTS_DIR / args.report
    ops = []

    if args.mode == "discover":
        print("Discovered bundles:")
        for b in bundles: print(f"  - {b}")
        tgt = bundles[0] if not args.target else Path(args.target)
        print(f"Primary target: {tgt}")
        ops.append({"mode": "discover", "bundles": [str(b) for b in bundles], "target": str(tgt)})

    elif args.mode == "dry-run":
        tgt = Path(args.target) if args.target else bundles[0]
        print(f"Dry-run: {tgt}")
        r = patch_bundle(tgt, marker, dry_run=True)
        ops.append(r)
        if r["success"]:
            print(f"  Would append {r.get('would_append', 0)} bytes")
        if r.get("already_patched"): print("  Already patched!")

    elif args.mode == "apply":
        tgt = Path(args.target) if args.target else bundles[0]
        print(f"Applying to: {tgt}")
        r = patch_bundle(tgt, marker, dry_run=False)
        ops.append(r)
        if r["success"]:
            print("  Patch applied!")
            if r.get("backup_created"): print(f"  Backup: {r['backup_created']}")
        elif r.get("already_patched"): print("  Already patched!")
        else: print(f"  Error: {r.get('error')}")

    elif args.mode == "verify":
        tgt = Path(args.target) if args.target else bundles[0]
        print(f"Verifying: {tgt}")
        r = verify_patch(tgt, marker)
        ops.append(r)
        print(f"  Verified: {r['verified']}")

    elif args.mode == "revert":
        if not args.target or not args.backup:
            print("ERROR: revert needs --target and --backup"); sys.exit(1)
        tgt, bak = Path(args.target), Path(args.backup)
        print(f"Reverting {tgt} from {bak}")
        r = revert_patch(tgt, bak)
        ops.append(r)
        if r["success"]: print("  Reverted!")
        else: print(f"  Error: {r.get('error')}")

    gen_report(ops, rpt_path)
    print(f"Report: {rpt_path}")

if __name__ == "__main__":
    main()
'''

with open("/workspace/patcher.py", "w") as f:
    f.write(code)
print("patcher.py created successfully")

