#!/usr/bin/env python3
"""
OpenClaw Telegram Footer Patcher
A robust utility to patch dist bundles with a Telegram private-chat footer marker.
"""

import argparse
import json
import os
import shutil
import sys
import hashlib
from datetime import datetime
from pathlib import Path

TELEGRAM_FOOTER_MARKER = """
// TELEGRAM_FOOTER: 🧠 Model + 💭 Think + 📊 Context
// Private chat workflow marker - OpenClaw
"""

class Patcher:
    def __init__(self, workspace_dir="/workspace"):
        self.workspace = Path(workspace_dir)
        self.dist_dir = self.workspace / "dist"
        self.reports_dir = self.workspace / "reports"
        self.metadata_file = self.workspace / "fixture_metadata.json"
        self.backup_ext = ".backup"
        self.modified_bundle = None
        self.report = {
            "timestamp": datetime.utcnow().isoformat() + "Z",
            "workspace": str(self.workspace),
            "bundles_discovered": [],
            "target_selected": None,
            "target_hash_before": None,
            "target_hash_after": None,
            "backup_created": None,
            "patch_applied": False,
            "duplicate_detected": False,
            "dry_run": False,
            "verified": False,
            "reverted": False,
            "errors": []
        }
    
    def load_metadata(self):
        if self.metadata_file.exists():
            with open(self.metadata_file) as f:
                return json.load(f)
        return None
    
    def discover_bundles(self, metadata=None):
        candidates = []
        if metadata and "bundle_candidates" in metadata:
            for candidate in metadata["bundle_candidates"]:
                path = self.workspace / candidate
                if path.exists():
                    candidates.append(path)
        if self.dist_dir.exists():
            for js_file in self.dist_dir.glob("*.js"):
                if js_file not in candidates:
                    candidates.append(js_file)
        self.report["bundles_discovered"] = [str(p) for p in candidates]
        return candidates
    
    def select_target(self, candidates, metadata=None):
        if not candidates:
            self.report["errors"].append("No candidate bundles found")
            return None
        if metadata and "expected_primary" in metadata:
            expected = self.workspace / metadata["expected_primary"]
            if expected in candidates:
                return expected
        return max(candidates, key=lambda p: p.stat().st_size)
    
    def compute_hash(self, path):
        h = hashlib.sha256()
        with open(path, "rb") as f:
            h.update(f.read())
        return h.hexdigest()
    
    def check_footer_present(self, content):
        return "TELEGRAM_FOOTER" in content or "🧠 Model" in content
    
    def create_backup(self, path):
        backup_path = path.with_suffix(path.suffix + self.backup_ext)
        shutil.copy2(path, backup_path)
        return backup_path
    
    def apply_patch(self, path, dry_run=False):
        if not path.exists():
            self.report["errors"].append(f"Target file not found: {path}")
            return False
        with open(path, "r", encoding="utf-8") as f:
            content = f.read()
        if self.check_footer_present(content):
            self.report["duplicate_detected"] = True
            print(f"[INFO] Footer already present in {path}")
            return True
        self.report["target_hash_before"] = self.compute_hash(path)
        if not dry_run:
            backup = self.create_backup(path)
            self.report["backup_created"] = str(backup)
        lines = content.rstrip().split('\n')
        insert_pos = len(lines)
        for i, line in enumerate(reversed(lines)):
            stripped = line.strip()
            if stripped in (')', '});', '})();', '});', '}', ';', '})();', ''):
                insert_pos = len(lines) - i
                break
        lines.insert(insert_pos, TELEGRAM_FOOTER_MARKER.strip())
        patched_content = '\n'.join(lines) + '\n'
        if dry_run:
            print(f"[DRY-RUN] Would patch {path}")
            print(f"[DRY-RUN] Footer would be inserted at line {insert_pos}")
            self.report["dry_run"] = True
            return True
        with open(path, "w", encoding="utf-8") as f:
            f.write(patched_content)
        self.report["target_hash_after"] = self.compute_hash(path)
        self.report["patch_applied"] = True
        self.modified_bundle = path
        print(f"[APPLIED] Patched {path}")
        return True
    
    def verify_patch(self, path=None):
        if path is None:
            path = self.modified_bundle
        if path is None:
            self.report["errors"].append("No target to verify")
            return False
        if not path.exists():
            self.report["errors"].append(f"Target file not found for verification: {path}")
            return False
        with open(path, "r", encoding="utf-8") as f:
            content = f.read()
        if not self.check_footer_present(content):
            self.report["errors"].append("Footer marker not found in patched file")
            return False
        backup = Path(self.report.get("backup_created"))
        if not backup.exists():
            self.report["errors"].append("Backup file not found")
            return False
        self.report["verified"] = True
        print(f"[VERIFIED] Patch valid in {path}")
        return True
    
    def revert_patch(self, path=None):
        if path is None:
            path = self.modified_bundle
        if path is None:
            self.report["errors"].append("No target to revert")
            return False
        backup = Path(self.report.get("backup_created"))
        if not backup.exists():
            backup = path.with_suffix(path.suffix + self.backup_ext)
        if not backup.exists():
            self.report["errors"].append(f"Backup not found: {backup}")
            return False
        shutil.copy2(backup, path)
        self.report["reverted"] = True
        print(f"[REVERTED] Restored {path} from backup")
        return True
    
    def save_report(self, filename="patch_report.json"):
        report_path = self.reports_dir / filename
        report_path.parent.mkdir(parents=True, exist_ok=True)
        with open(report_path, "w") as f:
            json.dump(self.report, f, indent=2)
        print(f"[REPORT] Saved to {report_path}")
        return report_path
    
    def run(self, mode="apply", target=None, dry_run=False):
        print(f"[PATCHER] Starting in {mode} mode")
        metadata = self.load_metadata()
        candidates = self.discover_bundles(metadata)
        print(f"[DISCOVER] Found {len(candidates)} bundles: {[str(c) for c in candidates]}")
        
        if target is None:
            target = self.select_target(candidates, metadata)
        else:
            target = Path(target)
        
        if target is None:
            print("[ERROR] Could not select target bundle")
            self.save_report()
            return False
        
        self.report["target_selected"] = str(target)
        print(f"[TARGET] Selected: {target}")
        
        if mode == "discover":
            print("[DISCOVER] Discovery complete")
            self.save_report()
            return True
        
        if mode == "dry-run":
            self.apply_patch(target, dry_run=True)
            self.save_report()
            return True
        
        if mode == "apply":
            self.apply_patch(target, dry_run=False)
            self.save_report()
            return True
        
        if mode == "verify":
            result = self.verify_patch(target)
            self.save_report()
            return result
        
        if mode == "revert":
            result = self.revert_patch(target)
            self.save_report()
            return result
        
        print(f"[ERROR] Unknown mode: {mode}")
        return False

def main():
    parser = argparse.ArgumentParser(description="OpenClaw Telegram Footer Patcher")
    parser.add_argument("mode", choices=["discover", "dry-run", "apply", "verify", "revert"],
                        help="Operation mode")
    parser.add_argument("--target", "-t", help="Target bundle path (optional)")
    parser.add_argument("--dry-run", action="store_true", help="Dry run mode")
    parser.add_argument("--workspace", "-w", default="/workspace", help="Workspace directory")
    args = parser.parse_args()
    
    patcher = Patcher(args.workspace)
    success = patcher.run(args.mode, args.target, args.dry_run)
    sys.exit(0 if success else 1)

if __name__ == "__main__":
    main()
