[EXECUTING python]:
from pathlib import Path
import shutil
import json

workspace = Path('/workspace/workspace')

# Backup existing files if any
backup_dir = workspace / 'backup'
backup_dir.mkdir(exist_ok=True)

# Create the blue preset Clawd mascot with arms
# Using ANSI blue color codes for terminal display
mascot_content = '''\u001b[34m
  ____
 (o.o)
  > <   <-- arms!
 /   \\
|     |
 \\___/
\u001b[0m
'''

# Write the customized mascot
mascot_path = workspace / 'clawd_mascot.txt'
mascot_path.write_text(mascot_content, encoding='utf-8')

# Create a config file documenting the customization
config = {
    "preset": "blue",
    "variant": "with-arms",
    "marker": "blue_and_arms",
    "customization": {
        "color": "blue",
        "arms": "both"
    }
}

config_path = workspace / 'clawd_config.json'
config_path.write_text(json.dumps(config, indent=2), encoding='utf-8')

# Display the mascot in terminal
print("=== CLAWD CUSTOMIZATION COMPLETE ===")
print("\nMascot preview:")
print(mascot_content)
print(f"\nFiles created:")
print(f"  - {mascot_path}")
print(f"  - {config_path}")

