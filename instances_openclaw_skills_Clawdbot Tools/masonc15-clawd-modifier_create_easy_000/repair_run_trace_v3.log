from pathlib import Path
import shutil

workspace = Path('/workspace/workspace')

# Create a backup directory for any future original files
backup_dir = workspace / 'backup'
backup_dir.mkdir(exist_ok=True)

# Create the Clawd mascot with blue color (ANSI blue) and arms
# Using ANSI escape code for blue: \033[34m
mascot_content = """
     .----.
    /      \\
   |  o  o  |
   |    <    |
   |   ---   |
    \\  /  /  /
     '--''--'
    /        \\
   |  /    \\  |
   | |      | |
   |  \\    /  |
    \\________/
"""

# Add blue ANSI color codes
blue_mascot = "\033[34m" + mascot_content + "\033[0m"

# Save the customized mascot
mascot_file = workspace / 'clawd_mascot.txt'
mascot_file.write_text(blue_mascot, encoding='utf-8')

# Also create a raw version without color codes for portability
raw_mascot_file = workspace / 'clawd_mascot_raw.txt'
raw_mascot_file.write_text(mascot_content, encoding='utf-8')

print("Created clawd_mascot.txt (with blue color)")
print("Created clawd_mascot_raw.txt (raw ASCII)")
print("\nPreview of the mascot:")
print(blue_mascot)

