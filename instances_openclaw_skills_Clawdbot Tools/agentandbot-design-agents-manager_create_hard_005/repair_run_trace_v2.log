import json
from datetime import datetime

# Read the seed data
with open('/workspace/registry_seed.json', 'r') as f:
    seed_data = json.load(f)

agents = seed_data['agents']
marker = seed_data['marker']

# Create the registry structure
registry = {
    "registry_version": "1.0.0",
    "created_at": datetime.now().isoformat(),
    "marker": marker,
    "agents": agents,
    "routing_rules": {
        "handoff_protocol": "explicit_approval_required",
        "escalation_path": "specialist -> main -> supervisor",
        "assignment_flow": "top-down only"
    }
}

# Save the registry
with open('/workspace/agent_registry.json', 'w') as f:
    json.dump(registry, f, indent=2)

print("Agent registry created successfully")

# Validate the hierarchy
def validate_hierarchy(agents):
    errors = []
    agent_ids = {a['id'] for a in agents}
    
    for agent in agents:
        # Check reports_to exists
        if agent['reports_to'] is not None and agent['reports_to'] not in agent_ids:
            errors.append(f"Agent {agent['id']} reports to non-existent agent {agent['reports_to']}")
        
        # Check can_assign_to exists
        for target in agent['can_assign_to']:
            if target not in agent_ids:
                errors.append(f"Agent {agent['id']} can assign to non-existent agent {target}")
    
    # Check specific constraints
    main_agent = next((a for a in agents if a['id'] == 'main'), None)
    if main_agent:
        if main_agent['reports_to'] != 'Ilkerkaan':
            errors.append("main must report to Ilkerkaan")
        if not all(s in main_agent['can_assign_to'] for s in ['research-1', 'dev-1', 'ops-1']):
            errors.append("main must be able to assign to all specialists")
    
    # Check specialists cannot assign to anyone
    for agent in agents:
        if agent['id'] in ['research-1', 'dev-1', 'ops-1']:
            if agent['can_assign_to']:
                errors.append(f"Specialist {agent['id']} should not be able to assign to anyone")
    
    return errors

errors = validate_hierarchy(agents)
if errors:
    print("Validation errors found:")
    for e in errors:
        print(f"  - {e}")
else:
    print("Hierarchy validation passed!")

# Create the routing audit
routing_audit = {
    "audit_timestamp": datetime.now().isoformat(),
    "audit_marker": "ROUTING-RULES-DELTA-114",
    "handshake_approval_flow": {
        "description": "All task assignments require explicit approval from the reporting agent",
        "steps": [
            "1. Assigning agent initiates task assignment",
            "2. Receiving agent acknowledges assignment (handshake)",
            "3. Supervisor approval required for cross-domain assignments",
            "4. Assignment confirmed and logged"
        ],
        "escalation_rules": [
            "Specialists escalate to main (Clawdia) for unresolved issues",
            "Main escalates to supervisor (Ilkerkaan) for strategic decisions",
            "Supervisor has final authority on all assignments"
        ]
    },
    "assignment_matrix": {
        "Ilkerkaan": ["main"],
        "main": ["research-1", "dev-1", "ops-1"],
        "research-1": [],
        "dev-1": [],
        "ops-1": []
    },
    "reporting_structure": {
        "Ilkerkaan": None,
        "main": "Ilkerkaan",
        "research-1": "main",
        "dev-1": "main",
        "ops-1": "main"
    },
    "validation_status": "PASSED" if not errors else "FAILED",
    "validation_errors": errors
}

with open('/workspace/routing_audit.json', 'w') as f:
    json.dump(routing_audit, f, indent=2)

print("Routing audit created successfully")

