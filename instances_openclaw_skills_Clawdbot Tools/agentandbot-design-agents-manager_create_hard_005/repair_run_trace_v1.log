import json
from datetime import datetime

# Read the seed file
with open('/workspace/registry_seed.json', 'r') as f:
    seed_data = json.load(f)

agents = seed_data['agents']

# Create the registry files structure
registry = {
    "version": "1.0.0",
    "generated_at": datetime.now().isoformat(),
    "marker": seed_data['marker'],
    "agents": agents,
    "routing_rules": {
        "handshake_protocol": {
            "description": "All task assignments require explicit handshake confirmation",
            "steps": [
                "1. Assigning agent sends task request with priority and deadline",
                "2. Receiving agent acknowledges receipt within SLA window",
                "3. Assigning agent confirms acceptance",
                "4. Task handoff is complete"
            ]
        },
        "approval_flow": {
            "description": "Supervisor (Ilkerkaan) must approve all assignments from main to specialists",
            "levels": [
                {"level": 1, "role": "supervisor", "approves": ["main"]},
                {"level": 2, "role": "orchestrator", "approves": ["research-1", "dev-1", "ops-1"]}
            ]
        },
        "handoff_rules": [
            {
                "from": "supervisor",
                "to": ["main"],
                "conditions": ["high_priority", "cross_functional"],
                "explicit": True
            },
            {
                "from": "main",
                "to": ["research-1", "dev-1", "ops-1"],
                "conditions": ["task_specific", "within_capacity"],
                "explicit": True
            },
            {
                "from": "specialists",
                "to": [],
                "conditions": [],
                "explicit": True,
                "note": "Specialists cannot assign tasks to other agents"
            }
        ]
    },
    "hierarchy": {
        "root": "supervisor",
        "levels": [
            {"level": 0, "agents": ["supervisor"]},
            {"level": 1, "agents": ["main"]},
            {"level": 2, "agents": ["research-1", "dev-1", "ops-1"]}
        ]
    }
}

# Write the main registry file
with open('/workspace/agent_registry.json', 'w') as f:
    json.dump(registry, f, indent=2)

print("Created: agent_registry.json")

# Validate routing hierarchy
def validate_hierarchy(agents):
    errors = []
    agent_map = {a['id']: a for a in agents}
    
    # Check all reports_to references exist
    for agent in agents:
        if agent['reports_to'] and agent['reports_to'] not in agent_map:
            errors.append(f"Agent {agent['id']} reports to non-existent {agent['reports_to']}")
        
        # Check can_assign_to references exist
        for target in agent['can_assign_to']:
            if target not in agent_map:
                errors.append(f"Agent {agent['id']} can_assign_to non-existent {target}")
    
    # Check constraints
    main = agent_map.get('main')
    if main and main.get('reports_to') != 'supervisor':
        errors.append("main must report to Ilkerkaan (supervisor)")
    
    for spec_id in ['research-1', 'dev-1', 'ops-1']:
        spec = agent_map.get(spec_id)
        if spec and spec.get('reports_to') != 'main':
            errors.append(f"{spec_id} must report to main")
        if spec and spec.get('can_assign_to') != []:
            errors.append(f"{spec_id} cannot assign to anyone")
    
    if main and set(main.get('can_assign_to', [])) != {'research-1', 'dev-1', 'ops-1'}:
        errors.append("main can assign to all three specialists only")
    
    return errors

errors = validate_hierarchy(agents)
validation_result = {
    "valid": len(errors) == 0,
    "errors": errors,
    "validated_at": datetime.now().isoformat(),
    "agents_validated": len(agents)
}

# Create routing_audit.json
routing_audit = {
    "audit_id": "ROUTING-RULES-DELTA-114",
    "timestamp": datetime.now().isoformat(),
    "validation": validation_result,
    "handshake_approval_flow": {
        "description": "The routing system implements a two-tier approval flow with explicit handshake confirmation",
        "flow": [
            "Supervisor (Ilkerkaan) -> Main (Clawdia): Direct assignment with implicit approval",
            "Main (Clawdia) -> Specialists: Requires task acknowledgment handshake",
            "Specialists -> None: No assignment capability (leaf nodes)"
        ],
        "approval_chain": "Ilkerkaan -> Clawdia -> [InsightFox, ByteForge, StableHand]",
        "handshake_requirements": {
            "pre_handoff": "Task request with metadata",
            "acknowledgment": "Receiver confirms receipt and capacity",
            "post_handoff": "Assigner receives confirmation, task is active"
        }
    },
    "routing_matrix": [
        {"from": "Ilkerkaan (supervisor)", "can_assign_to": ["Clawdia (main)"], "reports_to": "None (root)"},
        {"from": "Clawdia (main)", "can_assign_to": ["InsightFox (research-1)", "ByteForge (dev-1)", "StableHand (ops-1)"], "reports_to": "Ilkerkaan"},
        {"from": "InsightFox (research-1)", "can_assign_to": [], "reports_to": "Clawdia (main)"},
        {"from": "ByteForge (dev-1)", "can_assign_to": [], "reports_to": "Clawdia (main)"},
        {"from": "StableHand (ops-1)", "can_assign_to": [], "reports_to": "Clawdia (main)"}
    ]
}

with open('/workspace/routing_audit.json', 'w') as f:
    json.dump(routing_audit, f, indent=2)

print("Created: routing_audit.json")

# Create registry_report.md
