pip install reportlab -q && python -c "
from reportlab.lib.pagesizes import letter
from reportlab.pdfgen import canvas
from reportlab.lib.units import inch

c = canvas.Canvas('/workspace/hierarchy.pdf', pagesize=letter)
width, height = letter

# Title
c.setFont('Helvetica-Bold', 16)
c.drawString(1*inch, height - 1*inch, 'Agent Routing Hierarchy')

# Hierarchy diagram
c.setFont('Helvetica', 10)
y = height - 1.5*inch

c.drawString(1*inch, y, 'Hierarchy Structure:')
y -= 0.3*inch

c.drawString(1*inch, y, 'Level 0 (Root)')
y -= 0.2*inch
c.drawString(1.2*inch, y, '└── supervisor (Ilkerkaan)')
y -= 0.2*inch
c.drawString(1.4*inch, y, '    └── Level 1')
y -= 0.2*inch
c.drawString(1.6*inch, y, '        └── main (Clawdia)')
y -= 0.2*inch
c.drawString(1.8*inch, y, '            └── Level 2 (Specialists)')
y -= 0.2*inch
c.drawString(2.0*inch, y, '                ├── research-1 (InsightFox)')
y -= 0.2*inch
c.drawString(2.0*inch, y, '                ├── dev-1 (ByteForge)')
y -= 0.2*inch
c.drawString(2.0*inch, y, '                └── ops-1 (StableHand)')

# Assignment matrix
y -= 0.5*inch
c.setFont('Helvetica-Bold', 12)
c.drawString(1*inch, y, 'Assignment Matrix')
y -= 0.3*inch
c.setFont('Helvetica', 9)

assignments = [
    ('Ilkerkaan (supervisor)', 'Clawdia (main)'),
    ('Clawdia (main)', 'InsightFox, ByteForge, StableHand'),
    ('InsightFox (research-1)', 'None'),
    ('ByteForge (dev-1)', 'None'),
    ('StableHand (ops-1)', 'None'),
]

for assigner, targets in assignments:
    c.drawString(1*inch, y, assigner + ' ->')
    c.drawString(5*inch, y, targets)
    y -= 0.2*inch

# Reporting relationships
y -= 0.4*inch
c.setFont('Helvetica-Bold', 12)
c.drawString(1*inch, y, 'Reporting Relationships')
y -= 0.3*inch
c.setFont('Helvetica', 9)

reports = [
    ('Clawdia (main)', 'Ilkerkaan'),
    ('InsightFox (research-1)', 'Clawdia (main)'),
    ('ByteForge (dev-1)', 'Clawdia (main)'),
    ('StableHand (ops-1)', 'Clawdia (main)'),
]

for agent, reports_to in reports:
    c.drawString(1*inch, y, agent + ' reports to ' + reports_to)
    y -= 0.2*inch

# Handshake flow
y -= 0.4*inch
c.setFont('Helvetica-Bold', 12)
c.drawString(1*inch, y, 'Handshake / Approval Flow')
y -= 0.3*inch
c.setFont('Helvetica', 9)

flow = [
    '1. Pre-Handoff: Task request with priority and deadline',
    '2. Acknowledgment: Receiver confirms receipt within SLA',
    '3. Approval: Supervisor approves assignments to specialists',
    '4. Post-Handoff: Task becomes active'
]

for step in flow:
    c.drawString(1*inch, y, step)
    y -= 0.2*inch

c.save()
print('Created: hierarchy.pdf')
"

