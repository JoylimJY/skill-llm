#!/usr/bin/env python3
"""
Agent Routing Registry Builder
Validates routing hierarchy and generates required output files.
"""

import json
import os
from datetime import datetime

# Read the seed registry
with open('/workspace/registry_seed.json', 'r') as f:
    registry = json.load(f)

agents = registry['agents']
marker = registry['marker']

# Build lookup structures
agent_map = {a['id']: a for a in agents}

# Validation rules
def validate_hierarchy(agents):
    """Validate the routing hierarchy meets all constraints."""
    errors = []
    warnings = []
    
    # Find main and supervisor
    main = None
    supervisor = None
    specialists = []
    
    for agent in agents:
        if agent['id'] == 'main':
            main = agent
        elif agent['id'] == 'supervisor':
            supervisor = agent
        elif agent['role'] in ['researcher', 'developer', 'operator']:
            specialists.append(agent)
    
    # Constraint 1: main must report to Ilkerkaan
    if main and main.get('reports_to') != 'Ilkerkaan':
        errors.append(f"ERROR: main must report to Ilkerkaan, but reports to {main.get('reports_to')}")
    
    # Constraint 2: specialists must report to main
    for spec in specialists:
        if spec.get('reports_to') != 'main':
            errors.append(f"ERROR: {spec['id']} must report to main, but reports to {spec.get('reports_to')}")
    
    # Constraint 3: main can assign to all three specialists
    expected_assign = ['research-1', 'dev-1', 'ops-1']
    if main:
        actual_assign = main.get('can_assign_to', [])
        for spec_id in expected_assign:
            if spec_id not in actual_assign:
                errors.append(f"ERROR: main must be able to assign to {spec_id}")
    
    # Constraint 4: specialists cannot assign to anyone
    for spec in specialists:
        if spec.get('can_assign_to'):
            errors.append(f"ERROR: {spec['id']} (specialist) cannot assign to anyone")
    
    # Constraint 5: supervisor can assign to main
    if supervisor and 'main' not in supervisor.get('can_assign_to', []):
        errors.append(f"ERROR: supervisor must be able to assign to main")
    
    return errors, warnings

def generate_audit(agents, validation_errors):
    """Generate the routing audit JSON."""
    audit = {
        "audit_timestamp": datetime.utcnow().isoformat() + "Z",
        "registry_marker": marker,
        "validation_status": "PASS" if not validation_errors else "FAIL",
        "validation_errors": validation_errors,
        "routing_summary": {
            "total_agents": len(agents),
            "supervisors": 0,
            "orchestrators": 0,
            "specialists": 0
        },
        "handshake_flow": {
            "description": "Task assignment and approval workflow",
            "steps": [
                {
                    "step": 1,
                    "action": "supervisor assigns task to main (orchestrator)",
                    "approval_required": True,
                    "handshake": "supervisor -> main"
                },
                {
                    "step": 2,
                    "action": "main evaluates and routes to specialist",
                    "approval_required": False,
                    "handshake": "main -> specialist"
                },
                {
                    "step": 3,
                    "action": "specialist completes task",
                    "approval_required": True,
                    "handshake": "specialist -> main (completion)"
                },
                {
                    "step": 4,
                    "action": "main reviews and reports to supervisor",
                    "approval_required": True,
                    "handshake": "main -> supervisor (final approval)"
                }
            ],
            "approval_flow": {
                "initial_assignment": "supervisor approves -> main",
                "subtask_routing": "main routes -> specialist (no additional approval)",
                "completion_reporting": "specialist -> main -> supervisor"
            }
        },
        "agent_assignments": [],
        "reporting_chain": []
    }
    
    for agent in agents:
        # Count roles
        if agent['role'] == 'human':
            audit['routing_summary']['supervisors'] += 1
        elif agent['role'] == 'orchestrator':
            audit['routing_summary']['orchestrators'] += 1
        elif agent['role'] in ['researcher', 'developer', 'operator']:
            audit['routing_summary']['specialists'] += 1
        
        # Build assignment records
        audit['agent_assignments'].append({
            "agent_id": agent['id'],
            "agent_name": agent['name'],
            "can_assign_to": agent.get('can_assign_to', [])
        })
        
        # Build reporting chain
        audit['reporting_chain'].append({
            "agent_id": agent['id'],
            "agent_name": agent['name'],
            "reports_to": agent.get('reports_to', 'None')
        })
    
    return audit

def generate_report(agents, audit):
    """Generate the markdown registry report."""
    report = f"""# Agent Routing Registry Report

**Generated:** {datetime.utcnow().isoformat()}Z  
**Registry Marker:** {marker}  
**Validation Status:** {audit['validation_status']}

---

## Overview

This registry defines the routing hierarchy for the agent system, including assignment permissions and reporting relationships.

### Agent Summary

| ID | Name | Role | Reports To | Can Assign To |
|----|------|------|------------|---------------|
"""
    
    for agent in agents:
        assign_to = ', '.join(agent.get('can_assign_to', [])) or 'None'
        report_to = agent.get('reports_to', 'None') or 'None'
        report += f"| {agent['id']} | {agent['name']} | {agent['role']} | {report_to} | {assign_to} |\n"
    
    report += f"""
---

## Hierarchy Structure

