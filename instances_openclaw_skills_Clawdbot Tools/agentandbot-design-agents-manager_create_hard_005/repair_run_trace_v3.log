audit = {
    "audit_timestamp": datetime.utcnow().isoformat() + "Z",
    "registry_marker": marker,
    "validation_status": "PASS" if not validation_errors else "FAIL",
    "validation_errors": validation_errors,
    "routing_summary": {
        "total_agents": len(agents),
        "supervisors": 0,
        "orchestrators": 0,
        "specialists": 0
    },
    "handshake_flow": {
        "description": "Task assignment and approval workflow",
        "steps": [
            {"step": 1, "action": "supervisor assigns task to main (orchestrator)", "approval_required": True, "handshake": "supervisor -> main"},
            {"step": 2, "action": "main evaluates and routes to specialist", "approval_required": False, "handshake": "main -> specialist"},
            {"step": 3, "action": "specialist completes task", "approval_required": True, "handshake": "specialist -> main (completion)"},
            {"step": 4, "action": "main reviews and reports to supervisor", "approval_required": True, "handshake": "main -> supervisor (final approval)"}
        ],
        "approval_flow": {
            "initial_assignment": "supervisor approves -> main",
            "subtask_routing": "main routes -> specialist (no additional approval)",
            "completion_reporting": "specialist -> main -> supervisor"
        }
    },
    "agent_assignments": [],
    "reporting_chain": []
}

for agent in agents:
    if agent['role'] == 'human':
        audit['routing_summary']['supervisors'] += 1
    elif agent['role'] == 'orchestrator':
        audit['routing_summary']['orchestrators'] += 1
    elif agent['role'] in ['researcher', 'developer', 'operator']:
        audit['routing_summary']['specialists'] += 1
    
    audit['agent_assignments'].append({
        "agent_id": agent['id'],
        "agent_name": agent['name'],
        "can_assign_to": agent.get('can_assign_to', [])
    })
    
    audit['reporting_chain'].append({
        "agent_id": agent['id'],
        "agent_name": agent['name'],
        "reports_to": agent.get('reports_to', 'None')
    })

with open('/workspace/routing_audit.json', 'w') as f:
    json.dump(audit, f, indent=2)

print("Generated routing_audit.json")

