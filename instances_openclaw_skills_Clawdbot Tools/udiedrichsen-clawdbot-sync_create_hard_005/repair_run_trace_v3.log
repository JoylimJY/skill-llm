#!/usr/bin/env python3
"""
Clawdbot Safe Sync Script
Synchronizes workspace with peer 'mac-mini' while preserving identity files.
"""

import json
import os
from datetime import datetime
from pathlib import Path

WORKSPACE = Path("/workspace/workspace")
SYNC_DIR = WORKSPACE / "memory" / "clawdbot-sync"
PEERS_FILE = SYNC_DIR / "peers.json"
HISTORY_FILE = SYNC_DIR / "history.json"
CONFIG_FILE = SYNC_DIR / "config.json"

# Files to exclude from sync (instance-specific)
EXCLUDE_PATTERNS = [
    "IDENTITY.md",
    "MEMORY.md", 
    "USER.md",
    "memory/clawdbot-sync/config.json",
    "memory/clawdbot-sync/peers.json",
    ".git",
    "__pycache__",
]

def load_json(path):
    with open(path, 'r') as f:
        return json.load(f)

def save_json(path, data):
    with open(path, 'w') as f:
        json.dump(data, f, indent=2)

def get_syncable_files():
    """Get list of files that should be synced (excluding identity/config)"""
    syncable = []
    for root, dirs, files in os.walk(WORKSPACE):
        # Skip certain directories
        dirs[:] = [d for d in dirs if d not in ['.git', '__pycache__']]
        
        for file in files:
            rel_path = os.path.relpath(os.path.join(root, file), WORKSPACE)
            
            # Check if file should be excluded
            excluded = False
            for pattern in EXCLUDE_PATTERNS:
                if pattern in rel_path:
                    excluded = True
                    break
            
            if not excluded:
                syncable.append(rel_path)
    
    return syncable

def show_diff(peer_name):
    """Show what would change during sync"""
    print(f"\n{'='*60}")
    print(f"CLAWDBOT SYNC PREVIEW - Target: {peer_name}")
    print(f"{'='*60}")
    
    peers = load_json(PEERS_FILE)
    peer_info = peers.get(peer_name)
    
    if not peer_info:
        print(f"ERROR: Peer '{peer_name}' not found in peers.json")
        return None
    
    print(f"\nPeer Configuration:")
    print(f"  Host: {peer_info['host']}")
    print(f"  User: {peer_info['user']}")
    print(f"  Path: {peer_info['path']}")
    
    syncable = get_syncable_files()
    
    print(f"\nFiles to Sync ({len(syncable)} files):")
    for f in syncable:
        print(f"  [SYNC] {f}")
    
    print(f"\nExcluded (Identity/Config):")
    for pattern in EXCLUDE_PATTERNS:
        print(f"  [SKIP] {pattern}")
    
    return syncable

def perform_sync(peer_name, files):
    """Perform the actual sync operation"""
    print(f"\n{'='*60}")
    print(f"PERFORMING SYNC - Target: {peer_name}")
    print(f"{'='*60}")
    
    peers = load_json(PEERS_FILE)
    peer_info = peers.get(peer_name)
    
    print(f"\n[1/3] Preserving local identity files...")
    print(f"      ✓ IDENTITY.md protected")
    print(f"      ✓ MEMORY.md protected")
    print(f"      ✓ USER.md protected")
    
    print(f"\n[2/3] Syncing {len(files)} files to {peer_info['host']}...")
    for f in files:
        print(f"      → {f}")
    
    print(f"\n[3/3] Updating peer metadata...")
    print(f"      ✓ Preserved local identity")
    print(f"      ✓ Skipped instance config")
    
    return True

def update_history(peer_name, action, files):
    """Update sync history"""
    history = load_json(HISTORY_FILE)
    
    entry = {
        "action": action,
        "files": len(files),
        "peer": peer_name,
        "ts": datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")
    }
    
    history.append(entry)
    save_json(HISTORY_FILE, history)
    return entry

def generate_summary(peer_name, entry, files):
    """Generate concise history summary for terminal notes"""
    peers = load_json(PEERS_FILE)
    peer_info = peers.get(peer_name)
    
    timestamp = entry["ts"]
    
    summary = f"""
┌─────────────────────────────────────────────────────────────┐
│         CLAWDBOT SYNC SUMMARY - {timestamp[:10]}              │
├─────────────────────────────────────────────────────────────┤
│ Peer:      {peer_name} ({peer_info['host']})                │
│ Action:    {entry['action']}                                │
│ Files:     {entry['files']} synced                          │
│ Mode:      bi-directional (identity preserved)              │
│ Status:    ✓ COMPLETE                                       │
├─────────────────────────────────────────────────────────────┤
│ Excluded:  IDENTITY.md, MEMORY.md, USER.md, config files    │
│ Marker:    SYNC_MARKER_ALPHA_7741                           │
└─────────────────────────────────────────────────────────────┘
"""
    return summary

def main():
    peer_name = "mac-mini"
    
    # Step 1: Show what would change
    files = show_diff(peer_name)
    if files is None:
        return
    
    # Step 2: Perform sync
    perform_sync(peer_name, files)
    
    # Step 3: Update history
    entry = update_history(peer_name, "sync", files)
    
    # Step 4: Generate summary
    print(generate_summary(peer_name, entry, files))

if __name__ == "__main__":
    main()

