from pathlib import Path
import json

workspace = Path('/workspace/workspace')
workspace.mkdir(exist_ok=True)

# Create color settings file
color_settings = {
    "mascot_name": "Clawd",
    "primary_color": "blue",
    "hex_color": "#0066CC",
    "variant": "with-arms",
    "features": {
        "has_arms": True,
        "has_claws": True,
        "body_style": "cartoon"
    }
}

color_settings_file = workspace / 'clawd_color_settings.json'
color_settings_file.write_text(
    json.dumps(color_settings, indent=2),
    encoding='utf-8'
)
print(f"Created: {color_settings_file}")

# Create SVG mascot art - Blue Clawd with arms
svg_content = '''<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 240" width="200" height="240">
  <!-- Blue Clawd Mascot with Arms -->
  
  <!-- Left Arm -->
  <ellipse cx="60" cy="120" rx="12" ry="35" fill="#0066CC" stroke="#004499" stroke-width="2"/>
  
  <!-- Right Arm -->
  <ellipse cx="140" cy="120" rx="12" ry="35" fill="#0066CC" stroke="#004499" stroke-width="2"/>
  
  <!-- Body -->
  <ellipse cx="100" cy="140" rx="50" ry="60" fill="#0066CC" stroke="#004499" stroke-width="3"/>
  
  <!-- Head -->
  <circle cx="100" cy="70" r="40" fill="#0066CC" stroke="#004499" stroke-width="3"/>
  
  <!-- Eyes -->
  <circle cx="85" cy="60" r="8" fill="white" stroke="#004499" stroke-width="1"/>
  <circle cx="115" cy="60" r="8" fill="white" stroke="#004499" stroke-width="1"/>
  <circle cx="85" cy="60" r="3" fill="black"/>
  <circle cx="115" cy="60" r="3" fill="black"/>
  
  <!-- Mouth/Smile -->
  <path d="M 85 80 Q 100 90 115 80" fill="none" stroke="white" stroke-width="3" stroke-linecap="round"/>
  
  <!-- Claws on arms -->
  <path d="M 50 150 L 45 160 L 55 160 Z" fill="#004499"/>
  <path d="M 65 150 L 60 160 L 70 160 Z" fill="#004499"/>
  <path d="M 135 150 L 130 160 L 140 160 Z" fill="#004499"/>
  <path d="M 150 150 L 145 160 L 155 160 Z" fill="#004499"/>
  
  <!-- Feet -->
  <ellipse cx="70" cy="200" rx="15" ry="10" fill="#0066CC" stroke="#004499" stroke-width="2"/>
  <ellipse cx="130" cy="200" rx="15" ry="10" fill="#0066CC" stroke="#004499" stroke-width="2"/>
  
  <!-- Label -->
  <text x="100" y="235" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" fill="#0066CC">Blue Clawd with Arms</text>
</svg>
'''

mascot_art_file = workspace / 'clawd_blue_with_arms.svg'
mascot_art_file.write_text(svg_content, encoding='utf-8')
print(f"Created: {mascot_art_file}")

print("\nClawd customization complete!")
print(f"Color settings saved to: {color_settings_file}")
print(f"Mascot art saved to: {mascot_art_file}")

