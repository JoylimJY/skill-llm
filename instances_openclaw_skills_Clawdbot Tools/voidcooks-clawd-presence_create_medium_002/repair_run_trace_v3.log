#!/usr/bin/env python3
"""Display Clawd Presence dashboard in terminal."""
import json
import sys
import time
import os
from pathlib import Path
from datetime import datetime

CONFIG_FILE = Path('/workspace/config.json')
MONOGRAMS_DIR = Path('/workspace/assets/monograms')

def load_config():
    if CONFIG_FILE.exists():
        with open(CONFIG_FILE, 'r') as f:
            return json.load(f)
    return {
        'agent_name': 'QUARTZ',
        'idle_timeout': 420,
        'monogram': 'Q'
    }

def get_monogram(letter):
    """Load monogram ASCII art for given letter."""
    monogram_file = MONOGRAMS_DIR / f"{letter}.txt"
    if monogram_file.exists():
        return monogram_file.read_text().strip()
    # Default fallback
    return f"""
   {letter}
  {letter}{letter}
 {letter} {letter}
  {letter}{letter}
   {letter}
"""

def clear_screen():
    """Clear terminal screen."""
    os.system('clear')

def display_dashboard(config, idle_seconds=0):
    """Render the presence dashboard."""
    clear_screen()
    
    name = config.get('agent_name', 'QUARTZ')
    timeout = config.get('idle_timeout', 420)
    monogram_letter = config.get('monogram', 'Q')
    
    monogram = get_monogram(monogram_letter)
    
    # Calculate status
    if idle_seconds == 0:
        status = "ACTIVE"
        status_color = "\033[92m"  # Green
    elif idle_seconds < timeout:
        remaining = timeout - idle_seconds
        status = f"IDLE ({remaining}s remaining)"
        status_color = "\033[93m"  # Yellow
    else:
        status = "AWAY"
        status_color = "\033[91m"  # Red
    
    reset_color = "\033[0m"
    
    # Build dashboard
    width = 60
    border = "╭" + "─" * (width - 2) + "╮"
    
    lines = [
        "\n",
        " " * 15 + f"\033[1mCLAWD PRESENCE\033[0m",
        " " * 12 + "╭───────┬───────╮",
        " " * 12 + "│  " + status_color + status + reset_color.ljust(15) + "│",
        " " * 12 + "╰───────┴───────╯",
        "",
        " " * 8 + f"\033[1mAGENT: {name}\033[0m",
        "",
        monogram,
        "",
        " " * 10 + f"Idle Timeout: {timeout}s",
        " " * 10 + f"Last Active: {datetime.now().strftime('%H:%M:%S')}",
        "",
        f"\033[90m{'─' * width}\033[0m",
        f"\033[90mPress Ctrl+C to exit | Auto-refresh: 2s\033[0m"
    ]
    
    print("\n".join(lines))

def main():
    config = load_config()
    
    print("Clawd Presence Dashboard starting...")
    print(f"Agent: {config.get('agent_name', 'QUARTZ')}")
    print(f"Monogram: {config.get('monogram', 'Q')}")
    print(f"Idle Timeout: {config.get('idle_timeout', 420)}s")
    print("\nPress Ctrl+C to exit\n")
    
    try:
        idle_seconds = 0
        while True:
            display_dashboard(config, idle_seconds)
            time.sleep(2)
            idle_seconds += 2
    except KeyboardInterrupt:
        print("\nDashboard stopped.")
        sys.exit(0)

if __name__ == '__main__':
    main()
EOF
