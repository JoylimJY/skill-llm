#!/usr/bin/env python3
"""Configure Clawd Presence settings."""
import json
import argparse
from pathlib import Path

CONFIG_FILE = Path('/workspace/config.json')

def load_config():
    if CONFIG_FILE.exists():
        with open(CONFIG_FILE, 'r') as f:
            return json.load(f)
    return {
        'agent_name': 'QUARTZ',
        'idle_timeout': 420,
        'monogram': 'Q'
    }

def save_config(config):
    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(CONFIG_FILE, 'w') as f:
        json.dump(config, f, indent=2)

def main():
    parser = argparse.ArgumentParser(description='Configure Clawd Presence')
    parser.add_argument('--name', type=str, help='Set agent name')
    parser.add_argument('--timeout', type=int, help='Set idle timeout in seconds')
    parser.add_argument('--monogram', type=str, help='Set monogram letter')
    parser.add_argument('--show', action='store_true', help='Show current configuration')
    
    args = parser.parse_args()
    config = load_config()
    
    if args.show:
        print(json.dumps(config, indent=2))
        return
    
    if args.name:
        config['agent_name'] = args.name
    
    if args.timeout:
        config['idle_timeout'] = args.timeout
    
    if args.monogram:
        config['monogram'] = args.monogram
    
    save_config(config)
    print(f"Configuration saved: {CONFIG_FILE}")
    print(json.dumps(config, indent=2))

if __name__ == '__main__':
    main()
EOF
