Displays current configuration without launching the full dashboard.
"""

import json
from pathlib import Path
from datetime import datetime

CONFIG_FILE = Path(__file__).parent.parent / "presence_config.json"

def load_config():
    """Load configuration from file."""
    if CONFIG_FILE.exists():
        with open(CONFIG_FILE, 'r') as f:
            return json.load(f)
    return {
        "agent_name": "Clawd",
        "idle_timeout": 300,
        "monogram_file": "Q.txt"
    }

