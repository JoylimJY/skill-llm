#!/usr/bin/env python3
"""
Clawd Presence Configuration Script

Usage:
    configure.py --name <agent_name> --timeout <idle_timeout_seconds>

Example:
    ./configure.py --name QUARTZ --timeout 420
"""

import argparse
import json
from pathlib import Path

CONFIG_FILE = Path(__file__).parent.parent / "presence_config.json"

def load_config():
    """Load existing configuration or return defaults."""
    if CONFIG_FILE.exists():
        with open(CONFIG_FILE, 'r') as f:
            return json.load(f)
    return {
        "agent_name": "Clawd",
        "idle_timeout": 300,
        "monogram_file": "Q.txt"
    }

def save_config(config):
    """Save configuration to file."""
    with open(CONFIG_FILE, 'w') as f:
        json.dump(config, f, indent=2)
    print(f"Configuration saved to {CONFIG_FILE}")

def main():
    parser = argparse.ArgumentParser(description="Configure Clawd Presence settings")
    parser.add_argument("--name", type=str, help="Agent display name")
    parser.add_argument("--timeout", type=int, help="Idle timeout in seconds")
    parser.add_argument("--monogram", type=str, help="Monogram file name (e.g., Q.txt)")
    
    args = parser.parse_args()
    
    config = load_config()
    
    if args.name:
        config["agent_name"] = args.name
        print(f"Agent name set to: {args.name}")
    
    if args.timeout:
        config["idle_timeout"] = args.timeout
        print(f"Idle timeout set to: {args.timeout} seconds")
    
    if args.monogram:
        config["monogram_file"] = args.monogram
        print(f"Monogram file set to: {args.monogram}")
    
    save_config(config)
    
    print("\nCurrent Configuration:")
    print(f"  Agent Name: {config['agent_name']}")
    print(f"  Idle Timeout: {config['idle_timeout']} seconds")
    print(f"  Monogram: {config['monogram_file']}")

if __name__ == "__main__":
    main()
EOF
