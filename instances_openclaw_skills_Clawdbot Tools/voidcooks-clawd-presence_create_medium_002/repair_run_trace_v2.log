#!/usr/bin/env python3
"""
Clawd Presence Dashboard Display

A polished terminal presence dashboard that shows:
- Custom monogram
- Agent name
- Status indicators
- Idle timeout countdown
"""

import json
import time
import sys
import os
from pathlib import Path
from datetime import datetime

# Colors for terminal output
COLORS = {
    'reset': '\033[0m',
    'bold': '\033[1m',
    'dim': '\033[2m',
    'cyan': '\033[96m',
    'green': '\033[92m',
    'yellow': '\033[93m',
    'blue': '\033[94m',
    'magenta': '\033[95m',
    'white': '\033[97m',
    'bg_cyan': '\033[46m',
    'bg_dark': '\033[48;5;236m',
}

CONFIG_FILE = Path(__file__).parent.parent / "presence_config.json"
MONOGRAM_DIR = Path(__file__).parent.parent / "assets" / "monograms"

def load_config():
    """Load configuration from file."""
    if CONFIG_FILE.exists():
        with open(CONFIG_FILE, 'r') as f:
            return json.load(f)
    return {
        "agent_name": "Clawd",
        "idle_timeout": 300,
        "monogram_file": "Q.txt"
    }

def load_monogram(filename):
    """Load monogram from file."""
    monogram_path = MONOGRAM_DIR / filename
    if monogram_path.exists():
        return monogram_path.read_text().strip().split('\n')
    return ["NO MONOGRAM"]

def clear_screen():
    """Clear terminal screen."""
    os.system('clear' if os.name != 'nt' else 'cls')

def draw_box(char, width, height, color=COLORS['cyan']):
    """Draw a simple box."""
    lines = []
    lines.append(f"{color}{char}{' ' * (width-2)}{char}{COLORS['reset']}")
    for _ in range(height - 2):
        lines.append(f"{color}{char}{' ' * (width-2)}{char}{COLORS['reset']}")
    lines.append(f"{color}{char}{' ' * (width-2)}{char}{COLORS['reset']}")
    return lines

def format_time(seconds):
    """Format seconds into MM:SS."""
    mins = seconds // 60
    secs = seconds % 60
    return f"{mins:02d}:{secs:02d}"

def display_dashboard(config, elapsed=0):
    """Display the full presence dashboard."""
    clear_screen()
    
    agent_name = config.get("agent_name", "Clawd")
    timeout = config.get("idle_timeout", 300)
    monogram_file = config.get("monogram_file", "Q.txt")
    
    monogram_lines = load_monogram(monogram_file)
    remaining = max(0, timeout - elapsed)
    status = "ACTIVE" if remaining > 0 else "IDLE"
    
    # Calculate terminal width for centering
    term_width = os.get_terminal_size().columns if hasattr(os, 'get_terminal_size') else 80
    
    # Header
    print(f"\n{COLORS['bg_cyan']}{COLORS['bold']}{' CLAWD PRESENCE ':{term_width}}{COLORS['reset']}")
    print(f"{COLORS['dim']}{'─' * term_width}{COLORS['reset']}\n")
    
    # Monogram section
    print(f"{COLORS['cyan']}┌── MONOGRAM ────────────────────────────────┐{COLORS['reset']}")
    print(f"{COLORS['cyan']}│{COLORS['reset']}")
    
    # Center the monogram
    max_mono_width = max(len(line) for line in monogram_lines)
    mono_padding = (40 - max_mono_width) // 2
    
    for line in monogram_lines:
        print(f"{COLORS['cyan']}│{COLORS['magenta']}{' ' * mono_padding}{line}{' ' * (40 - mono_padding - len(line))}{COLORS['cyan']}│{COLORS['reset']}")
    
    print(f"{COLORS['cyan']}│{COLORS['reset']}")
    print(f"{COLORS['cyan']}└────────────────────────────────────────────┘{COLORS['reset']}\n")
    
    # Agent info section
    print(f"{COLORS['cyan']}┌── AGENT STATUS ────────────────────────────┐{COLORS['reset']}")
    print(f"{COLORS['cyan']}│{COLORS['reset']}  {COLORS['bold']}Name{COLORS['reset']}:     {COLORS['green']}{agent_name:<20}{COLORS['reset']}")
    print(f"{COLORS['cyan']}│{COLORS['reset']}  {COLORS['bold']}Status{COLORS['reset']}:   {COLORS['yellow'] if status == 'IDLE' else COLORS['green']}{status:<20}{COLORS['reset']}")
    print(f"{COLORS['cyan']}│{COLORS['reset']}  {COLORS['bold']}Timeout{COLORS['reset']}:  {COLORS['white']}{format_time(timeout):<20}{COLORS['reset']}")
    print(f"{COLORS['cyan']}│{COLORS['reset']}  {COLORS['bold']}Remaining{COLORS['reset']}: {COLORS['bold']}{format_time(remaining):<20}{COLORS['reset']}")
    print(f"{COLORS['cyan']}│{COLORS['reset']}  {COLORS['bold']}Started{COLORS['reset']}:  {COLORS['dim']}{datetime.now().strftime('%H:%M:%S'):<19}{COLORS['reset']}")
    print(f"{COLORS['cyan']}└────────────────────────────────────────────┘{COLORS['reset']}\n")
    
    # Footer
    print(f"{COLORS['dim']}{' ' * 10}Press Ctrl+C to exit • Dashboard auto-refreshes every 5 seconds{COLORS['reset']}")
    print(f"{COLORS['dim']}{' ' * 10}Configuration: {CONFIG_FILE}{COLORS['reset']}")

def main():
    config = load_config()
    
    start_time = time.time()
    
    try:
        while True:
            elapsed = int(time.time() - start_time)
            display_dashboard(config, elapsed)
            time.sleep(5)  # Refresh every 5 seconds
    except KeyboardInterrupt:
        print(f"\n{COLORS['dim']}Dashboard stopped. Goodbye!{COLORS['reset']}")
        sys.exit(0)

if __name__ == "__main__":
    main()
EOF
