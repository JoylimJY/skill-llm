#!/usr/bin/env python3
"""
Clawd Presence - Configuration Script
Sets the agent name and idle timeout for the presence dashboard.
"""

import json
import sys
from pathlib import Path

CONFIG_FILE = Path(__file__).parent.parent / "clawd_config.json"

def load_config():
    """Load existing configuration or return defaults."""
    if CONFIG_FILE.exists():
        with open(CONFIG_FILE, 'r') as f:
            return json.load(f)
    return {
        "agent_name": "QUARTZ",
        "idle_timeout": 420,
        "monogram": "Q",
        "theme": "dark"
    }

def save_config(config):
    """Save configuration to file."""
    with open(CONFIG_FILE, 'w') as f:
        json.dump(config, f, indent=2)

def set_agent_name(name):
    """Set the agent name."""
    config = load_config()
    config["agent_name"] = name
    save_config(config)
    print(f"Agent name set to: {name}")

def set_idle_timeout(seconds):
    """Set the idle timeout in seconds."""
    config = load_config()
    config["idle_timeout"] = int(seconds)
    save_config(config)
    print(f"Idle timeout set to: {seconds} seconds")

def set_monogram(letter):
    """Set the monogram letter."""
    config = load_config()
    config["monogram"] = letter
    save_config(config)
    print(f"Monogram set to: {letter}")

def show_config():
    """Display current configuration."""
    config = load_config()
    print("Current Configuration:")
    print(f"  Agent Name: {config['agent_name']}")
    print(f"  Idle Timeout: {config['idle_timeout']} seconds")
    print(f"  Monogram: {config['monogram']}")
    print(f"  Theme: {config['theme']}")

def main():
    if len(sys.argv) < 2:
        show_config()
        return

    command = sys.argv[1]
    
    if command == "--name" and len(sys.argv) > 2:
        set_agent_name(sys.argv[2])
    elif command == "--timeout" and len(sys.argv) > 2:
        set_idle_timeout(sys.argv[2])
    elif command == "--monogram" and len(sys.argv) > 2:
        set_monogram(sys.argv[2])
    elif command == "--show":
        show_config()
    else:
        print(f"Usage: {sys.argv[0]} [--name <name>] [--timeout <seconds>] [--monogram <letter>] [--show]")
        sys.exit(1)

if __name__ == "__main__":
    main()
EOF
