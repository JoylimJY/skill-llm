#!/usr/bin/env python3
"""
Clawd Presence - Display Script
Renders the presence dashboard in the terminal with a monogram and status.
"""

import json
import time
import sys
import os
from pathlib import Path
from datetime import datetime

CONFIG_FILE = Path(__file__).parent.parent / "clawd_config.json"
MONOGRAMS_DIR = Path(__file__).parent.parent / "assets" / "monograms"

def load_config():
    """Load configuration from file."""
    if CONFIG_FILE.exists():
        with open(CONFIG_FILE, 'r') as f:
            return json.load(f)
    return {
        "agent_name": "QUARTZ",
        "idle_timeout": 420,
        "monogram": "Q",
        "theme": "dark"
    }

def load_monogram(letter):
    """Load monogram ASCII art for the given letter."""
    monogram_path = MONOGRAMS_DIR / f"{letter}.txt"
    if monogram_path.exists():
        with open(monogram_path, 'r') as f:
            return f.read().strip()
    # Default monogram if file not found
    return f"{letter}{letter}{letter}{letter}{letter}\n{letter}   {letter}\n{letter} {letter} {letter}\n{letter}   {letter}\n{letter}{letter}{letter}{letter}{letter}"

def clear_screen():
    """Clear the terminal screen."""
    os.system('clear')

def draw_dashboard(config):
    """Draw the presence dashboard."""
    letter = config.get("monogram", "Q")
    agent_name = config.get("agent_name", "QUARTZ")
    timeout = config.get("idle_timeout", 420)
    
    monogram = load_monogram(letter)
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    timeout_minutes = timeout // 60
    
    # ANSI color codes for dark theme
    colors = {
        "reset": "\033[0m",
        "cyan": "\033[96m",
        "green": "\033[92m",
        "yellow": "\033[93m",
        "white": "\033[97m",
        "dim": "\033[90m"
    }
    
    dashboard = f"""
{colors['dim']}╔═══════════════════════════════════════════════════════════╗{colors['reset']}
{colors['dim']}║{colors['reset']}                    {colors['cyan']}CLAWD PRESENCE{colors['reset']}                    {colors['dim']}║{colors['reset']}
{colors['dim']}╠═══════════════════════════════════════════════════════════╣{colors['reset']}
{colors['dim']}║{colors['reset']}                                                             {colors['dim']}║{colors['reset']}
{colors['dim']}║{colors['reset']}  {monogram}
{colors['dim']}║{colors['reset']}                                                             {colors['dim']}║{colors['reset']}
{colors['dim']}╠═══════════════════════════════════════════════════════════╣{colors['reset']}
{colors['dim']}║{colors['reset']}  {colors['yellow']}AGENT{colors['reset']}: {colors['green']}{agent_name}{colors['reset']}                                {colors['dim']}║{colors['reset']}
{colors['dim']}║{colors['reset']}  {colors['yellow']}STATUS{colors['reset']}: {colors['green']}● ACTIVE{colors['reset']}                               {colors['dim']}║{colors['reset']}
{colors['dim']}║{colors['reset']}  {colors['yellow']}TIMEOUT{colors['reset']}: {timeout_minutes} minutes                         {colors['dim']}║{colors['reset']}
{colors['dim']}║{colors['reset']}  {colors['yellow']}TIME{colors['reset']}:  {timestamp}                        {colors['dim']}║{colors['reset']}
{colors['dim']}║{colors['reset']}                                                             {colors['dim']}║{colors['reset']}
{colors['dim']}╠═══════════════════════════════════════════════════════════╣{colors['reset']}
{colors['dim']}║{colors['reset']}  {colors['dim']}Press Ctrl+C to exit. Updates every 5 seconds.{colors['reset']}        {colors['dim']}║{colors['reset']}
{colors['dim']}╚═══════════════════════════════════════════════════════════╝{colors['reset']}
"""
    print(dashboard)

def main():
    """Main display loop."""
    config = load_config()
    clear_screen()
    
    try:
        while True:
            draw_dashboard(config)
            time.sleep(5)
            clear_screen()
    except KeyboardInterrupt:
        print(f"\n{chr(27)}[0mClawd Presence stopped.{chr(27)}[0m")
        sys.exit(0)

if __name__ == "__main__":
    main()
