#!/usr/bin/env python3
"""
Clawd Presence - Status Script
Checks and displays the current status of the presence system.
"""

import json
import subprocess
import sys
from pathlib import Path

CONFIG_FILE = Path(__file__).parent.parent / "clawd_config.json"
DISPLAY_SCRIPT = Path(__file__).parent / "display.py"

def load_config():
    """Load configuration from file."""
    if CONFIG_FILE.exists():
        with open(CONFIG_FILE, 'r') as f:
            return json.load(f)
    return None

def check_display_running():
    """Check if the display is currently running."""
    try:
        result = subprocess.run(
            ['pgrep', '-f', 'display.py'],
            capture_output=True,
            text=True
        )
        return len(result.stdout.strip()) > 0
    except Exception:
        return False

def main():
    """Display status information."""
    config = load_config()
    display_running = check_display_running()
    
    print("Clawd Presence Status")
    print("=" * 40)
    
    if config:
        print(f"Configuration:    ✓ Loaded")
        print(f"  Agent Name:     {config.get('agent_name', 'N/A')}")
        print(f"  Idle Timeout:   {config.get('idle_timeout', 'N/A')} seconds")
        print(f"  Monogram:       {config.get('monogram', 'N/A')}")
    else:
        print("Configuration:    ✗ Not found")
    
    print()
    if display_running:
        print("Display Status:   ● Running")
    else:
        print("Display Status:   ○ Stopped")
    
    print()
    print("Commands:")
    print("  ./scripts/display.py       - Start the presence dashboard")
    print("  ./scripts/configure.py     - Configure settings")
    print("  ./scripts/status.py        - Show this status")

if __name__ == "__main__":
    main()
EOF
