[EXECUTING python]:
import json
import os

# Define paths
inputs_dir = "/workspace/inputs"
output_file = "/workspace/avatar_state.json"

# Read project name
with open(os.path.join(inputs_dir, "project_name.txt"), "r") as f:
    project_name = f.read().strip()

# Read notes JSON
with open(os.path.join(inputs_dir, "notes.json"), "r") as f:
    notes = json.load(f)

# Read status
status = {}
with open(os.path.join(inputs_dir, "status.txt"), "r") as f:
    for line in f:
        if ":" in line:
            key, value = line.strip().split(":", 1)
            status[key.strip()] = value.strip()

# Build the avatar state
avatar_state = {
    "project_name": project_name,
    "marker": notes["marker"],
    "status": {
        "done": status.get("done", "false") == "true",
        "mode": status.get("mode", "unknown")
    },
    "avatar_state": "happy_successful",
    "message": f"🎉 ClawFace avatar workflow completed successfully for '{project_name}'! Robot mode finished with a smile. 🤖✨"
}

# Write output
with open(output_file, "w") as f:
    json.dump(avatar_state, f, indent=2)

print(f"Generated {output_file}")
print(json.dumps(avatar_state, indent=2))

