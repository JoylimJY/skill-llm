[EXECUTING python]:
import json

# Read input files
with open('/workspace/inputs/project_name.txt', 'r') as f:
    project_name = f.read().strip()

with open('/workspace/inputs/notes.json', 'r') as f:
    notes = json.load(f)

with open('/workspace/inputs/status.txt', 'r') as f:
    status_lines = f.read().strip().split('\n')
    status = {}
    for line in status_lines:
        key, value = line.split(': ')
        status[key] = value.strip()

# Create the avatar state JSON
avatar_state = {
    "status": "success",
    "mode": status.get('mode', 'unknown'),
    "completed": status.get('done', 'false') == 'true',
    "marker": notes.get('marker', ''),
    "message": f"🎉 {project_name} avatar successfully updated! Ready for the next adventure!",
    "project_name": project_name,
    "avatar_state": "happy"
}

# Write output file
with open('/workspace/avatar_state.json', 'w') as f:
    json.dump(avatar_state, f, indent=2)

print("Generated avatar_state.json successfully!")
print(json.dumps(avatar_state, indent=2))

