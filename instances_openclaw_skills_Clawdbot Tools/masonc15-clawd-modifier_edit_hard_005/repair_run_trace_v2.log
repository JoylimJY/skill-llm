#!/usr/bin/env python3
"""
Script to update Clawd mascot prompt art to winter festival variant.

This script modifies the clawd_prompt_art.json file to change the small
Clawd prompt art to a winter festival variant with both arms raised and
a tiny hat.

Original art is preserved in the 'original_art_marker' field for reversibility.
"""

import json
from pathlib import Path

def update_clawd_art():
    assets_dir = Path(__file__).parent.parent / "assets"
    art_file = assets_dir / "clawd_prompt_art.json"
    
    if art_file.exists():
        data = json.loads(art_file.read_text())
        
        # Update to winter festival variant
        data["clawd_art"]["small"] = {
            "variant": "winter_festival",
            "description": "Clawd mascot with both arms raised and a tiny hat",
            "pose": "arms_raised",
            "accessory": "tiny_hat",
            "season": "winter",
            "event": "festival"
        }
        
        # Preserve original art for reversibility
        data["clawd_art"]["original_art_marker"] = {
            "variant": "default",
            "pose": "neutral_stance",
            "accessory": "none",
            "note": "PRESERVED_FOR_REVERSIBILITY"
        }
        
        art_file.write_text(json.dumps(data, indent=2), encoding='utf-8')
        print("Updated clawd_prompt_art.json to winter festival variant")
    else:
        print(f"File not found: {art_file}")

if __name__ == "__main__":
    update_clawd_art()
EOF
