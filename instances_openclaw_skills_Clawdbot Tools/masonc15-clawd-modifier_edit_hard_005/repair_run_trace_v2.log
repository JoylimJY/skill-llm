cat > /workspace/scripts/update_clawd_color.py << 'EOF'
#!/usr/bin/env python3
"""
Script to update Clawd mascot body color to Ocean Blue in all theme definitions.

This script modifies the clawd_themes.json file to change the default clawd_body
color to Ocean Blue (rgb(100,149,237)) in every theme that supports clawd_body.

Original colors are preserved in 'original_color_marker' fields for reversibility.
"""

import json
from pathlib import Path

OCEAN_BLUE = "rgb(100,149,237)"
OCEAN_BLUE_NAME = "Ocean Blue"

def update_clawd_color():
    assets_dir = Path(__file__).parent.parent / "assets"
    themes_file = assets_dir / "clawd_themes.json"
    
    if themes_file.exists():
        data = json.loads(themes_file.read_text())
        
        # Store original default color for global reversibility
        original_default = data.get("global_original_color_marker", {}).get("default_clawd_body", "rgb(0,0,0)")
        
        # Update all themes that have clawd_body
        for theme_key, theme_data in data["themes"].items():
            if "clawd_body" in theme_data:
                # Preserve original color for reversibility
                theme_data["original_color_marker"] = {
                    "value": theme_data.get("original_color_marker", {}).get("value", "rgb(0,0,0)"),
                    "note": "PRESERVED_FOR_REVERSIBILITY"
                }
                # Update to Ocean Blue
                theme_data["clawd_body"] = OCEAN_BLUE
                theme_data["clawd_body_name"] = OCEAN_BLUE_NAME
        
        # Update global marker
        data["global_original_color_marker"] = {
            "default_clawd_body": original_default,
            "note": "PRESERVED_FOR_REVERSIBILITY - Original default color before Ocean Blue change"
        }
        
        themes_file.write_text(json.dumps(data, indent=2), encoding='utf-8')
        print(f"Updated all clawd_body colors to Ocean Blue ({OCEAN_BLUE})")
    else:
        print(f"File not found: {themes_file}")

if __name__ == "__main__":
    update_clawd_color()
EOF
