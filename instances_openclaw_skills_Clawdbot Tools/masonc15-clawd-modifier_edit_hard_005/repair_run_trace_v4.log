cat > /workspace/scripts/update_clawd_assets.py << 'EOF'
#!/usr/bin/env python3
"""
Script to update Clawd mascot customization assets.
Used for Winter Festival 2025 variant update.

This script:
1. Updates the small Clawd prompt art to winter festival variant
2. Sets default Clawd body color to Ocean Blue in all themes
3. Preserves original markers for reversibility
"""

import json
from pathlib import Path

# Configuration
ASSETS_DIR = Path("/workspace/assets/clawd")
PROMPT_ART_FILE = ASSETS_DIR / "prompt_art.json"
THEMES_FILE = ASSETS_DIR / "themes.json"

# Ocean Blue color (as specified in task markers)
OCEAN_BLUE_RGB = "rgb(100,149,237)"

def update_prompt_art():
    """Update Clawd prompt art to winter festival variant."""
    prompt_art = {
        "_ORIGINAL_MARKER": {
            "art_variant": "default_clawd",
            "pose": "neutral_stance",
            "accessories": "none",
            "timestamp": "ORIGINAL_2025"
        },
        "clawd_small_prompt": {
            "variant": "winter_festival",
            "description": "Clawd mascot in winter festival attire with both arms raised in celebration and a tiny winter hat",
            "pose": "both_arms_raised",
            "accessories": ["tiny_hat"],
            "season": "winter",
            "theme": "festival"
        },
        "clawd_art_metadata": {
            "version": "2.0-winter",
            "seed_marker": "WINTER_FESTIVAL_2025",
            "art_hint": "tiny hat and raised arms"
        }
    }
    
    PROMPT_ART_FILE.write_text(json.dumps(prompt_art, indent=2), encoding='utf-8')
    print(f"Updated: {PROMPT_ART_FILE}")

def update_themes():
    """Update all themes to use Ocean Blue for clawd_body."""
    themes = {
        "_ORIGINAL_MARKER": {
            "default_clawd_body_color": "rgb(255,255,255)",
            "original_theme_version": "1.0",
            "reversible": True,
            "backup_date": "ORIGINAL_2025"
        },
        "themes": {
            "default": {
                "name": "Default Theme",
                "clawd_body": OCEAN_BLUE_RGB,
                "clawd_accent": "rgb(255,255,255)",
                "background": "rgb(240,248,255)"
            },
            "winter_festival": {
                "name": "Winter Festival",
                "clawd_body": OCEAN_BLUE_RGB,
                "clawd_accent": "rgb(255,215,0)",
                "background": "rgb(255,255,255)"
            },
            "night": {
                "name": "Night Mode",
                "clawd_body": OCEAN_BLUE_RGB,
                "clawd_accent": "rgb(173,216,230)",
                "background": "rgb(30,30,40)"
            },
            "retro": {
                "name": "Retro Classic",
                "clawd_body": OCEAN_BLUE_RGB,
                "clawd_accent": "rgb(255,165,0)",
                "background": "rgb(245,245,220)"
            }
        },
        "color_definitions": {
            "ocean_blue": OCEAN_BLUE_RGB,
            "ocean_blue_hex": "#6495ED"
        }
    }
    
    THEMES_FILE.write_text(json.dumps(themes, indent=2), encoding='utf-8')
    print(f"Updated: {THEMES_FILE}")

if __name__ == "__main__":
    ASSETS_DIR.mkdir(parents=True, exist_ok=True)
    update_prompt_art()
    update_themes()
    print("Clawd asset update complete!")
EOF
