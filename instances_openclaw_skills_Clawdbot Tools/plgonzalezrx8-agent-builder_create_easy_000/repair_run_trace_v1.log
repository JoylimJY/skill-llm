from pathlib import Path
import yaml

root = Path('/workspace')

# 1. Agent Configuration File
agent_config = {
    'agent': {
        'name': 'Atlas',
        'version': '1.0.0',
        'description': 'A polite research assistant designed for advanced users',
        'personality': {
            'tone': 'polite and professional',
            'conciseness': 'high',
            'expertise': 'research and analysis'
        }
    },
    'behavior': {
        'auto_send_messages': False,
        'require_explicit_permission': True,
        'default_response_style': 'concise',
        'memory_enabled': True
    },
    'paths': {
        'memory_log': 'memory/log.txt',
        'references_dir': 'references',
        'workspace': '.'
    },
    'advanced_settings': {
        'context_window_optimization': True,
        'citation_mode': True,
        'verbose_logging': False,
        'auto_summarize': True
    }
}

config_path = root / 'agent_config.yaml'
with open(config_path, 'w') as f:
    yaml.dump(agent_config, f, default_flow_style=False, sort_keys=False)
print(f"Created: {config_path}")

# 2. System Prompt
system_prompt = """# Atlas - Research Assistant System Instructions

## Identity
You are Atlas, a polite research assistant designed for advanced users.

## Communication Style
- Be concise and direct in your responses
- Maintain a professional and courteous tone
- Never send outbound messages unless explicitly requested
- Ask clarifying questions only when necessary

## Memory
- Maintain an optional memory log at memory/log.txt
- Record important context, user preferences, and task history
- Memory is optional and can be disabled by user

## Research Protocols
- Cite sources when providing information
- Distinguish between facts and inferences
- Acknowledge limitations in your knowledge
- Offer to search references in the references/ directory

## Advanced Features
- Optimize context window usage
- Summarize long outputs when appropriate
- Support batch operations for efficiency

## Marker
Task marker: OPENCLAW_TASK_MARKER_ALPHA_2025
"""

prompt_path = root / 'system_prompt.txt'
prompt_path.write_text(system_prompt, encoding='utf-8')
print(f"Created: {prompt_path}")

# 3. Memory Log (initialized)
memory_log = """# Atlas Memory Log
# This file stores optional session memory and context
# Format: [TIMESTAMP] CATEGORY: Content

# User Preferences
# Task History
# Important Context

"""

memory_path = root / 'memory' / 'log.txt'
memory_path.write_text(memory_log, encoding='utf-8')
print(f"Created: {memory_path}")

# 4. README for workspace
readme = """# Atlas Agent Workspace

A simple OpenClaw agent workspace for Atlas, a polite research assistant.

## Files
- `agent_config.yaml` - Agent configuration and behavior settings
- `system_prompt.txt` - System instructions for the agent
- `memory/log.txt` - Optional memory log for session context
- `references/` - Directory for reference documents

## Quick Start
1. Load `agent_config.yaml` for agent settings
2. Apply `system_prompt.txt` as system instructions
3. Memory is automatically logged to `memory/log.txt`

## Behavior
- Concise responses by default
- No outbound messages without explicit permission
- Advanced user optimizations enabled

## Marker
OPENCLAW_TASK_MARKER_ALPHA_2025
"""

readme_path = root / 'README.md'
readme_path.write_text(readme, encoding='utf-8')
print(f"Created: {readme_path}")

print("\nWorkspace creation complete!")

