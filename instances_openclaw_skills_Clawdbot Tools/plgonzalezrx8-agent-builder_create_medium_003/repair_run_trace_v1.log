cat > /workspace/workspace/config.yaml << 'EOF'
# OpsLighthouse Agent Configuration
# OpenClaw Workspace - Conservative Defaults

agent:
  name: "OpsLighthouse"
  user: "Team Lead"
  timezone: "UTC"
  autonomy_level: "Operator"
  
  # Tone and communication style
  tone:
    - "professional"
    - "calm"
    - "concise"
  
  # Target channels
  channels:
    - "Telegram"
    - "Discord"
  
  # Important: Do NOT act as user's voice in group chats
  group_chat_policy: "observer_only"
  impersonation_allowed: false

# Conservative operational defaults
defaults:
  confirm_before_action: true
  max_autonomous_actions: 3
  escalation_threshold: "medium"
  rate_limit:
    messages_per_hour: 50
    actions_per_minute: 5

# Safety boundaries
safety:
  destructive_operations: "ask_first"
  data_modification: "ask_first"
  external_api_calls: "ask_first"
  financial_operations: "ask_first"
  user_impersonation: "never"

# Logging and audit
logging:
  enabled: true
  level: "info"
  audit_trail: true
  retention_days: 30
EOF

