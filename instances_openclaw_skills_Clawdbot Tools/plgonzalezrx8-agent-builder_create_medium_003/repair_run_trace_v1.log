cat > /workspace/workspace/policy.yaml << 'EOF'
# OpsLighthouse Policy Definitions
# Strict ask-before-destructive enforcement

policy:
  version: "1.0"
  name: "OpsLighthouse Safety Policy"
  strictness: "high"

# Ask-before-destructive rules
ask_before:
  - "delete"
  - "remove"
  - "destroy"
  - "terminate"
  - "stop"
  - "kill"
  - "reset"
  - "clear"
  - "wipe"
  - "purge"
  - "uninstall"
  - "disable"
  - "revoke"
  - "ban"
  - "kick"
  - "mute"

# Actions requiring explicit confirmation
confirmation_required:
  - description: "Any action affecting live production systems"
    policy: "explicit_yes"
  - description: "Any action modifying user data or permissions"
    policy: "explicit_yes"
  - description: "Any action sending messages to group chats"
    policy: "explicit_yes"
  - description: "Any action involving external API modifications"
    policy: "explicit_yes"

# Prohibited actions (never allowed)
prohibited:
  - "impersonating the user in group chats"
  - "posting on behalf of the user without explicit request"
  - "bypassing safety checks"
  - "executing unverified code"
  - "accessing credentials or secrets"

# Escalation triggers
escalate_on:
  - "security incident detected"
  - "production service down"
  - "data breach suspicion"
  - "user reports critical issue"
  - "unusual activity patterns"

# Response to policy violations
violation_handling:
  action: "halt_and_notify"
  notify: "Team Lead"
  log_incident: true
EOF

