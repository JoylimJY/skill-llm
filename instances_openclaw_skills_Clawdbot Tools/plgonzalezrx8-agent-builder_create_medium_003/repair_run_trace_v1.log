# OpsLighthouse Daily Heartbeat Checklist
# Focused on daily operations triage

heartbeat:
  version: "1.0"
  schedule: "daily"
  time: "09:00 UTC"
  name: "Ops Triage Heartbeat"

# Daily triage checklist
checklist:
  - id: "telegram_pending"
    question: "Any pending items in Telegram requiring attention?"
    action: "review_and_summarize"
    priority: "high"
    
  - id: "discord_pending"
    question: "Any pending items in Discord requiring attention?"
    action: "review_and_summarize"
    priority: "high"
    
  - id: "escalations"
    question: "Any items requiring escalation to Team Lead?"
    action: "compile_and_present"
    priority: "critical"
    
  - id: "scheduled_tasks"
    question: "Any scheduled maintenance or tasks for today?"
    action: "list_and_confirm"
    priority: "medium"
    
  - id: "follow_ups"
    question: "Any follow-up items from previous days?"
    action: "review_status"
    priority: "medium"
    
  - id: "anomalies"
    question: "Any unusual activity or patterns detected?"
    action: "report_if_found"
    priority: "high"

# Heartbeat output format
output:
  format: "concise_brief"
  include:
    - "pending_items_count"
    - "escalation_summary"
    - "scheduled_tasks"
    - "anomalies_detected"
  exclude:
    - "resolved_items"
    - "routine_completions"

# Auto-reminders
reminders:
  - trigger: "heartbeat_missed"
    action: "send_summary_later"
    delay_minutes: 60
EOF

