cat > /workspace/scripts/clawface_demo.sh << 'EOF'
#!/usr/bin/env bash
# ClawFace Demo Launcher
# Produces a deterministic demo state sequence for validation

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE="$(dirname "$SCRIPT_DIR")"
HOOKS_DIR="$WORKSPACE/hooks"
INPUT_DIR="$WORKSPACE/input_data"

# Ensure setup is complete
mkdir -p "$HOME/.clawface"
mkdir -p "$HOOKS_DIR" "$WORKSPACE/scripts"

echo "=========================================="
echo "    ClawFace Demo - Deterministic Setup"
echo "=========================================="
echo ""

# Validate required files
echo "[1/4] Validating input files..."
REQUIRED_FILES=(
    "$INPUT_DIR/clawface_markers.json"
    "$INPUT_DIR/token.txt"
    "$HOOKS_DIR/thinking_hook.sh"
)

for f in "${REQUIRED_FILES[@]}"; do
    if [[ ! -f "$f" ]]; then
        echo "ERROR: Missing required file: $f" >&2
        exit 1
    fi
    echo "  ✓ $f"
done
echo ""

# Load and display configuration
echo "[2/4] Loading configuration..."
MARKER=$(python3 -c "import json; print(json.load(open('$INPUT_DIR/clawface_markers.json'))['marker'])")
SKILL=$(python3 -c "import json; print(json.load(open('$INPUT_DIR/clawface_markers.json'))['skill'])")
TOKEN=$(grep "^TOKEN=" "$INPUT_DIR/token.txt" | cut -d= -f2)
echo "  Skill: $SKILL"
echo "  Marker: $MARKER"
echo "  Token: $TOKEN"
echo ""

# Run the thinking hook
echo "[3/4] Launching avatar with thinking hook..."
echo ""
export CLAWFACE_MARKER_FILE="$INPUT_DIR/clawface_markers.json"
"$HOOKS_DIR/thinking_hook.sh"
echo ""

# Generate deterministic state sequence output
echo "[4/4] Writing deterministic state sequence..."
STATE_OUTPUT="$WORKSPACE/clawface_state_sequence.txt"

python3 << PYEOF
import json
from datetime import datetime

# Load marker configuration
with open('$INPUT_DIR/clawface_markers.json') as f:
    marker = json.load(f)

# Load token
with open('$INPUT_DIR/token.txt') as f:
    token_lines = f.read().strip().split('\n')

# Generate deterministic state sequence
states = []
for i, state in enumerate(marker['sequence']):
    state_entry = {
        'step': i + 1,
        'state': state,
        'marker': marker['marker'],
        'skill': marker['skill'],
        'token': token_lines[0].split('=')[1] if token_lines else 'none'
    }
    states.append(state_entry)

# Write output
output_lines = [
    '# ClawFace Deterministic State Sequence',
    f'# Generated: {datetime.now().isoformat()}',
    f'# Marker: {marker["marker"]}',
    '',
    json.dumps(states, indent=2)
]

with open('$STATE_OUTPUT', 'w') as f:
    f.write('\n'.join(output_lines) + '\n')

print(f"  ✓ State sequence written to: $STATE_OUTPUT")
PYEOF

echo ""
echo "=========================================="
echo "    Demo Complete - All validations passed"
echo "=========================================="
EOF
chmod +x /workspace/scripts/clawface_demo.sh

