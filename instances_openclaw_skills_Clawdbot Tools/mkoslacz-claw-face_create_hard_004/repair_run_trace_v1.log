cat > /workspace/scripts/clawface_demo.sh << 'EOF'
#!/usr/bin/env bash
# ClawFace Demo - Avatar Launch and State Sequence
# This script demonstrates the ClawFace skill with deterministic state progression

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE="$(dirname "$SCRIPT_DIR")"
INPUT_DATA="$WORKSPACE/input_data"
HOOKS_DIR="$WORKSPACE/hooks"

# Colors for terminal output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Load configuration
load_config() {
    if [[ -f "$INPUT_DATA/clawface_markers.json" ]]; then
        echo -e "${CYAN}Loading ClawFace configuration...${NC}"
    fi
    if [[ -f "$INPUT_DATA/token.txt" ]]; then
        source "$INPUT_DATA/token.txt"
    fi
}

# Display avatar status
show_avatar_status() {
    local state="$1"
    local timestamp
    timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    
    case "$state" in
        "thinking")
            echo -e "${YELLOW}[$timestamp] AVATAR: ${state} - Processing input...${NC}"
            ;;
        "searching")
            echo -e "${BLUE}[$timestamp] AVATAR: ${state} - Looking for solutions...${NC}"
            ;;
        "coding")
            echo -e "${GREEN}[$timestamp] AVATAR: ${state} - Implementing solution...${NC}"
            ;;
        "success")
            echo -e "${GREEN}[$timestamp] AVATAR: ${state} - Task completed!${NC}"
            ;;
        *)
            echo -e "${RED}[$timestamp] AVATAR: Unknown state: ${state}${NC}"
            ;;
    esac
}

# Run the thinking hook
run_thinking_hook() {
    local hook_script="$HOOKS_DIR/thinking_hook.sh"
    if [[ -x "$hook_script" ]]; then
        echo -e "${CYAN}Executing thinking hook...${NC}"
        "$hook_script"
    else
        echo -e "${YELLOW}Thinking hook not found at: $hook_script${NC}"
        echo -e "${YELLOW}Creating default thinking hook...${NC}"
        cat > "$hook_script" << 'HOOK_EOF'
#!/usr/bin/env bash
# Thinking Hook for ClawFace Skill
# This hook is triggered when the avatar enters the "thinking" state

echo "=== CLAWFACE THINKING HOOK ==="
echo "Timestamp: $(date '+%Y-%m-%d %H:%M:%S')"
echo "Mode: robot"
echo "Effect: confetti"
echo "Processing deterministic sequence..."

# Simulate thinking process
sleep 0.5
echo "Thinking complete. Ready for next state."
HOOK_EOF
        chmod +x "$hook_script"
        echo -e "${GREEN}Hook created successfully${NC}"
    fi
}

# Execute the deterministic demo sequence
run_demo_sequence() {
    echo ""
    echo "=========================================="
    echo "     CLAWFACE SKILL DEMO SEQUENCE"
    echo "=========================================="
    echo ""
    
    # Define the deterministic sequence from markers
    local states=("thinking" "searching" "coding" "success")
    
    for state in "${states[@]}"; do
        show_avatar_status "$state"
        
        # Trigger thinking hook on thinking state
        if [[ "$state" == "thinking" ]]; then
            run_thinking_hook
        fi
        
        # Small delay for visual effect (deterministic timing)
        sleep 0.3
    done
    
    echo ""
    echo "=========================================="
    echo "     DEMO SEQUENCE COMPLETE"
    echo "=========================================="
    echo ""
    echo "Markers loaded:"
    echo "  - CLAWFACE_MARKER_ALPHA_913 (primary)"
    echo "  - CLAWFACE_MARKER_BETA_481 (visual)"
    echo "  - CLAWFACE_MARKER_GAMMA_204 (token)"
    echo ""
    echo "Token: $TOKEN"
    echo "Marker: $MARKER"
}

# Main execution
main() {
    echo -e "${CYAN}======================================${NC}"
    echo -e "${CYAN}   CLAWFACE AVATAR LAUNCH${NC}"
    echo -e "${CYAN}======================================${NC}"
    echo ""
    
    load_config
    run_demo_sequence
    
    echo -e "${GREEN}ClawFace demo completed successfully!${NC}"
}

# Run if executed directly
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
EOF
chmod +x /workspace/scripts/clawface_demo.sh

