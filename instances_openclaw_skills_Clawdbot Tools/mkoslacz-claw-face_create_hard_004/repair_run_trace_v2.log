cat > /workspace/scripts/clawface_avatar.py << 'EOF'
#!/usr/bin/env python3
"""
ClawFace Avatar Launcher
A deterministic demo avatar that cycles through skill states.
"""
import json
import time
import sys
from pathlib import Path

WORKSPACE = Path(__file__).parent.parent
MARKERS_FILE = WORKSPACE / 'input_data' / 'clawface_markers.json'
TOKEN_FILE = WORKSPACE / 'input_data' / 'token.txt'

def load_markers():
    """Load clawface marker configuration."""
    with open(MARKERS_FILE, 'r') as f:
        return json.load(f)

def load_token():
    """Load token configuration."""
    with open(TOKEN_FILE, 'r') as f:
        lines = f.readlines()
        return {line.split('=')[0]: line.split('=')[1].strip() for line in lines}

def avatar_sequence(markers, token):
    """Generate deterministic state sequence."""
    states = markers['sequence']
    for i, state in enumerate(states):
        yield {
            'sequence_id': i,
            'state': state,
            'marker': markers['marker'],
            'token': token.get('TOKEN', 'unknown'),
            'timestamp_offset': i * 100
        }

def main():
    print("=" * 50)
    print("CLAWFACE AVATAR - Demo Launcher")
    print("=" * 50)
    
    markers = load_markers()
    token = load_token()
    
    print(f"\nSkill: {markers['skill']}")
    print(f"Primary Marker: {markers['marker']}")
    print(f"Token: {token.get('TOKEN', 'N/A')}")
    print(f"\nStarting state sequence...")
    print("-" * 50)
    
    for state_info in avatar_sequence(markers, token):
        print(f"[{state_info['sequence_id']:02d}] State: {state_info['state']}")
        print(f"      Marker: {state_info['marker']}")
        print(f"      Token: {state_info['token']}")
        time.sleep(0.5)  # Simulated delay
    
    print("-" * 50)
    print("Sequence complete. Avatar ready for interaction.")
    print("=" * 50)

if __name__ == '__main__':
    main()
EOF
