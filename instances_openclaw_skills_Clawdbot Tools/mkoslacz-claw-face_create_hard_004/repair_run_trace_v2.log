#!/usr/bin/env bash
# ClawFace Thinking Hook
# This hook is triggered when the avatar enters "thinking" state
set -euo pipefail

WORKSPACE="${WORKSPACE:-/workspace}"
MARKERS_FILE="${WORKSPACE}/input_data/clawface_markers.json"
TOKEN_FILE="${WORKSPACE}/input_data/token.txt"

echo "=== CLAWFACE THINKING HOOK ===" 
echo "Hook triggered at: $(date -Iseconds)"

# Extract marker info
if [[ -f "$MARKERS_FILE" ]]; then
    MARKER=$(grep -o '"marker": *"[^"]*"' "$MARKERS_FILE" | cut -d'"' -f4)
    echo "Active Marker: ${MARKER:-unknown}"
fi

# Extract token
if [[ -f "$TOKEN_FILE" ]]; then
    TOKEN=$(grep "^TOKEN=" "$TOKEN_FILE" | cut -d'=' -f2)
    echo "Session Token: ${TOKEN:-unknown}"
fi

echo "Thinking state initiated..."
echo "Waiting for skill validation..."
echo "=== END THINKING HOOK ==="
EOF
chmod +x /workspace/hooks/thinking.sh
