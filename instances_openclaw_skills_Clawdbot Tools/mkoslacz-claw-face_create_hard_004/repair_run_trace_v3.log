cat > /workspace/scripts/run_clawface_full.sh << 'EOF'
#!/usr/bin/env bash
# ClawFace Full Demo with Thinking Hook Integration
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE="$(dirname "$SCRIPT_DIR")"
HOOKS_DIR="$WORKSPACE/hooks"
DATA_DIR="$WORKSPACE/input_data"

MARKER_FILE="$DATA_DIR/clawface_markers.json"

if [[ ! -f "$MARKER_FILE" ]]; then
    echo "ERROR: Marker file not found: $MARKER_FILE"
    exit 1
fi

SKILL=$(grep -o '"skill"[[:space:]]*:[[:space:]]*"[^"]*"' "$MARKER_FILE" | cut -d'"' -f4)
MARKER=$(grep -o '"marker"[[:space:]]*:[[:space:]]*"[^"]*"' "$MARKER_FILE" | cut -d'"' -f4)

echo "=============================================="
echo "  ClawFace Avatar - Full Demo with Hooks"
echo "=============================================="
echo "Skill: $SKILL"
echo "Marker: $MARKER"
echo "=============================================="
echo ""

# Deterministic state sequence with hook integration
STATES=("thinking" "searching" "coding" "success")

for state in "${STATES[@]}"; do
    echo "[DEMO] Transitioning to state: $state"
    
    # Trigger thinking hook when in thinking state
    if [[ "$state" == "thinking" ]] && [[ -x "$HOOKS_DIR/thinking_hook.sh" ]]; then
        "$HOOKS_DIR/thinking_hook.sh"
    fi
    
    sleep 0.3
done

echo ""
echo "=============================================="
echo "  ClawFace demo completed successfully!"
echo "=============================================="
EOF
chmod +x /workspace/scripts/run_clawface_full.sh

