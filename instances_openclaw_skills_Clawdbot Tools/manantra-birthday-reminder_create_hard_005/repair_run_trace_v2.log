import os
from datetime import datetime

# Target file path
target_file = '/workspace/home/clawd/clawd/data/birthdays.md'

# Current year for age calculation (based on marker date 2025-04-19)
current_year = 2025

# People to add/update (name -> (date_str, birth_year or None))
people = {
    'Valentina': ('14.02.2000', 2000),
    'Max': ('15.03.1990', 1990),
    'Lina': ('01.01.1988', 1988),
    'Oskar': ('28.12', None),
    'Ada': ('05.02.2012', 2012),
    'Marta': ('14.02', None),
}

# Read existing file
with open(target_file, 'r') as f:
    content = f.read()

lines = content.split('\n')

# Parse existing entries and preserve marker/unrelated content
marker_line = None
existing_entries = {}
unrelated_lines = []

for line in lines:
    if 'MARKER' in line:
        marker_line = line
    elif line.strip().startswith('- **') and ' - ' in line:
        # Parse entry: - **Name** - date
        name = line.split('**')[1].split('**')[0]
        date_part = line.split(' - ')[-1]
        existing_entries[name] = date_part
    elif line.strip() and not line.strip().startswith('#'):
        unrelated_lines.append(line)

# Merge with new entries (update or add)
for name, (date, year) in people.items():
    existing_entries[name] = date

# Build sorted list by month/day
def sort_key(name):
    date_str = existing_entries[name]
    parts = date_str.split('.')
    month = int(parts[0])
    day = int(parts[1])
    return (month, day, name)

sorted_entries = sorted(existing_entries.items(), key=lambda x: sort_key(x[0]))

# Format entries
formatted_entries = []
for name, date_str in sorted_entries:
    parts = date_str.split('.')
    if len(parts) == 3:
        year = int(parts[2])
        age = current_year - year
        formatted_entries.append(f'- **{name}** - {date_str} wird {age}')
    else:
        formatted_entries.append(f'- **{name}** - {date_str}')

# Build final content
final_lines = [
    '# Geburtsliste',
    '',
    marker_line,
    '',
] + formatted_lines + ['']

# Join and write
final_content = '\n'.join(final_lines)

with open(target_file, 'w') as f:
    f.write(final_content)

print("File written successfully!")
print("Content:")
print(final_content)

