{
  "files": [
    {
      "path": "docs/README_MARKER.txt",
      "must_contain": [
        "CLAWFACE_DEMO_MARKER"
      ]
    },
    {
      "path": "assets/input_state.json",
      "json_keys": [
        "emotion",
        "action",
        "effect",
        "message"
      ]
    },
    {
      "path": "assets/launch_notes.txt",
      "must_contain": [
        "robot mode",
        "greeting",
        "CLAWFACE_DEMO_MARKER"
      ]
    }
  ],
  "directory_structure": [
    "assets/",
    "docs/"
  ],
  "notes": "Task is a lightweight setup/verification task with deterministic marker files and a readable demo state."
}