#!/usr/bin/env python3
"""Presence display for agent NOVA"""
import json
import time
import os

CONFIG_PATH = os.path.join(os.path.dirname(__file__), 'config.json')

def load_config():
    with open(CONFIG_PATH, 'r') as f:
        return json.load(f)

def display_presence():
    config = load_config()
    agent_name = config.get('agent_name', 'UNKNOWN')
    monogram = config.get('monogram', '?')
    idle_timeout = config.get('idle_timeout', 300)
    
    print(f"Agent: {agent_name}")
    print(f"Monogram: [{monogram}]")
    print(f"Idle Timeout: {idle_timeout} seconds")
    print(f"Status: ACTIVE")

if __name__ == '__main__':
    display_presence()
EOF
```

