import json
import hashlib
from datetime import datetime
from collections import Counter

# Read input files
with open('/workspace/input/events.log', 'r') as f:
    events = [json.loads(line) for line in f.strip().split('\n')]

with open('/workspace/input/expected_marker.txt', 'r') as f:
    expected_marker = f.read().strip()

with open('/workspace/input/summary_template.json', 'r') as f:
    template = json.load(f)

# Validate marker
if not all(e.get('marker') == expected_marker for e in events):
    print("ERROR: Marker mismatch detected!")
    exit(1)

# Create summary statistics
event_counts = Counter(e['event'] for e in events)
paths_accessed = list(set(e['path'] for e in events))
timestamps = [e['ts'] for e in events]

# Build tamper-evident summary
summary = {
    "title": template['title'],
    "version": template['version'],
    "marker": expected_marker,
    "generated_at": datetime.utcnow().isoformat() + 'Z',
    "event_summary": {
        "total_events": len(events),
        "event_types": dict(event_counts),
        "unique_paths": len(paths_accessed),
        "paths": paths_accessed,
        "time_range": {
            "first": min(timestamps),
            "last": max(timestamps)
        }
    },
    "events": events,
    "integrity": {}
}

# Create tamper-evident hash (hash of the content without the integrity field)
content_to_hash = json.dumps(summary, sort_keys=True, separators=(',', ':'))
content_hash = hashlib.sha256(content_to_hash.encode()).hexdigest()

# Add integrity hash
summary["integrity"]["sha256"] = content_hash
summary["integrity"]["algorithm"] = "SHA-256"

# Write output
output_path = '/workspace/workspace/audit_summary.json'
with open(output_path, 'w') as f:
    json.dump(summary, f, indent=2)

# Also write the raw content hash for verification
with open('/workspace/workspace/content_hash.txt', 'w') as f:
    f.write(content_hash + '\n')

print(f"Audit summary generated: {output_path}")
print(f"Content hash (SHA-256): {content_hash}")
print(f"Total events processed: {len(events)}")
print(f"Marker verified: {expected_marker}")

