[EXECUTING python]:
import json
import hashlib
from datetime import datetime
from collections import Counter

# Read input files
with open('/workspace/input/events.log', 'r') as f:
    events = [json.loads(line) for line in f if line.strip()]

with open('/workspace/input/expected_marker.txt', 'r') as f:
    expected_marker = f.read().strip()

with open('/workspace/input/summary_template.json', 'r') as f:
    template = json.load(f)

# Validate all events have the expected marker
for event in events:
    if event.get('marker') != expected_marker:
        raise ValueError(f"Marker mismatch: expected {expected_marker}, got {event.get('marker')}")

# Create summary statistics
event_types = Counter(e['event'] for e in events)
paths = list(set(e['path'] for e in events))
timestamps = [e['ts'] for e in events]

# Create the summary data
summary = {
    "title": template['title'],
    "version": template['version'],
    "marker": expected_marker,
    "generated_at": datetime.utcnow().isoformat() + 'Z',
    "statistics": {
        "total_events": len(events),
        "event_types": dict(event_types),
        "unique_paths": len(paths),
        "paths_accessed": paths,
        "time_range": {
            "start": min(timestamps),
            "end": max(timestamps)
        }
    },
    "raw_events": events
}

# Create tamper-evident hash (SHA-256 of all event data)
event_data = ''.join(json.dumps(e, sort_keys=True) for e in events)
tamper_hash = hashlib.sha256(event_data.encode()).hexdigest()

# Add verification hash to summary
summary["verification"] = {
    "algorithm": "SHA-256",
    "hash": tamper_hash,
    "description": "Hash of all events for tamper detection"
}

# Write output
output_path = '/workspace/audit_summary.json'
with open(output_path, 'w') as f:
    json.dump(summary, f, indent=2)

# Print verification info
print("=" * 60)
print("AUDIT SUMMARY GENERATED")
print("=" * 60)
print(f"Output file: {output_path}")
print(f"Total events processed: {len(events)}")
print(f"Event types: {dict(event_types)}")
print(f"Unique paths: {len(paths)}")
print(f"Tamper-evident hash (SHA-256): {tamper_hash}")
print(f"Marker validated: {expected_marker}")
print("=" * 60)
print("\nTo verify integrity, re-compute SHA-256 hash of events and compare.")

