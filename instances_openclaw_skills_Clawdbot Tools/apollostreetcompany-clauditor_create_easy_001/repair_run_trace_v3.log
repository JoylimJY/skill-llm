[EXECUTING python]:
import json
import hashlib
from datetime import datetime

# Read the events log
with open('/workspace/input/events.log', 'r') as f:
    events = [json.loads(line.strip()) for line in f if line.strip()]

# Read the expected marker
with open('/workspace/input/expected_marker.txt', 'r') as f:
    expected_marker = f.read().strip()

# Read the summary template
with open('/workspace/input/summary_template.json', 'r') as f:
    template = json.load(f)

# Verify marker matches
marker = events[0]['marker'] if events else ""
marker_valid = marker == expected_marker

# Create summary statistics
event_counts = {}
paths_accessed = set()
timestamps = []

for event in events:
    event_type = event['event']
    event_counts[event_type] = event_counts.get(event_type, 0) + 1
    paths_accessed.add(event['path'])
    timestamps.append(event['ts'])

# Create the tamper-evident summary
summary = {
    "title": template['title'],
    "version": template['version'],
    "marker": marker,
    "marker_valid": marker_valid,
    "generated_at": datetime.utcnow().isoformat() + "Z",
    "event_count": len(events),
    "event_breakdown": event_counts,
    "unique_paths_accessed": len(paths_accessed),
    "paths": sorted(list(paths_accessed)),
    "time_range": {
        "start": min(timestamps) if timestamps else None,
        "end": max(timestamps) if timestamps else None
    },
    "tamper_evidence": {
        "events_hash": hashlib.sha256(json.dumps(events, sort_keys=True).encode()).hexdigest(),
        "summary_hash": None  # Will be filled after
    }
}

# Calculate the final summary hash (excluding the hash field itself)
summary_data = json.dumps(summary, sort_keys=True, indent=2)
summary_hash = hashlib.sha256(summary_data.encode()).hexdigest()
summary["tamper_evidence"]["summary_hash"] = summary_hash

# Write the output
with open('/workspace/audit_summary.json', 'w') as f:
    json.dump(summary, f, indent=2)

print("=== AUDIT SUMMARY GENERATED ===")
print(json.dumps(summary, indent=2))
print("\n=== VERIFICATION ===")
print(f"Marker matches expected: {marker_valid}")
print(f"Summary hash: {summary_hash}")

