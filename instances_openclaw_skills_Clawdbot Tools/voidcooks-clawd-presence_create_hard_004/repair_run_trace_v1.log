#!/usr/bin/env python3
"""
clawd-presence display - Command Deck Layout

A polished terminal display with:
- Status/state behavior
- Bottom footer with active script name and mode hint
- Custom monogram support
- Auto-idle behavior
- Small terminal friendly
"""

import json
import time
import sys
import os
import signal
import argparse
from pathlib import Path
from datetime import datetime

CONFIG_FILE = Path('config.json')
STATE_FILE = Path('state.json')
MONOGRAMS_DIR = Path('assets/monograms')


class PresenceDisplay:
    def __init__(self, script_name='display', mode='live'):
        self.script_name = script_name
        self.mode = mode
        self.config = self._load_config()
        self.state = self._load_state()
        self.running = True
        self.idle_start = time.time()
        
        signal.signal(signal.SIGINT, self._handle_signal)
        signal.signal(signal.SIGTERM, self._handle_signal)
    
    def _load_config(self):
        if CONFIG_FILE.exists():
            try:
                with open(CONFIG_FILE, 'r', encoding='utf-8') as f:
                    return json.load(f)
            except (json.JSONDecodeError, IOError):
                pass
        return {
            'letter': 'A',
            'name': 'PRESENCE',
            'idle_timeout': 300,
        }
    
    def _load_state(self):
        if STATE_FILE.exists():
            try:
                with open(STATE_FILE, 'r', encoding='utf-8') as f:
                    return json.load(f)
            except (json.JSONDecodeError, IOError):
                pass
        return {
            'state': 'idle',
            'message': 'Ready',
            'updated': time.time(),
        }
    
    def _get_monogram(self, letter):
        """Get monogram for letter, preferring custom if available."""
        letter = letter.upper()
        monogram_file = MONOGRAMS_DIR / f'{letter}.txt'
        
        if monogram_file.exists():
            try:
                return monogram_file.read_text(encoding='utf-8').rstrip('\n')
            except IOError:
                pass
        
        return f"  {letter}  "
    
    def _check_idle(self):
        """Check if we should transition to idle state."""
        idle_timeout = self.config.get('idle_timeout', 300)
        elapsed = time.time() - self.idle_start
        
        if elapsed > idle_timeout:
            self.state['state'] = 'idle'
            self.state['message'] = 'Auto-idle timeout'
            self.state['updated'] = time.time()
            self._save_state()
            return True
        return False
    
    def _save_state(self):
        with open(STATE_FILE, 'w', encoding='utf-8') as f:
            json.dump(self.state, f, indent=2)
            f.write('\n')
    
    def _handle_signal(self, signum, frame):
        self.running = False
    
    def _get_terminal_size(self):
        try:
            size = os.get_terminal_size()
            return max(size.columns, 40), max(size.lines, 12)
        except OSError:
            return 80, 24
    
    def _wrap_text(self, text, width):
        words = text.split()
        lines = []
        current = []
        current_len = 0
        
        for word in words:
            if current_len + len(word) + (1 if current else 0) <= width:
                current.append(word)
                current_len += len(word) + (1 if current else 0)
            else:
                if current:
                    lines.append(' '.join(current))
                current = [word]
                current_len = len(word)
        
        if current:
            lines.append(' '.join(current))
        
        return lines if lines else ['']
    
    def _build_display(self):
        cols, rows = self._get_terminal_size()
        self._check_idle()
        
        letter = self.config.get('letter', 'A')
        name = self.config.get('name', 'PRESENCE')
        monogram = self._get_monogram(letter)
        
        current_state = self.state.get('state', 'idle')
        message = self.state.get('message', '')
        updated = self.state.get('updated', time.time())
        
        lines = []
        
        # Header spacer
        lines.append('')
        
        # Monogram section (centered)
        monogram_lines = monogram.split('\n')
        mono_width = max(len(line) for line in monogram_lines) if monogram_lines else 6
        
        for mono_line in monogram_lines:
            padding = (cols - mono_width) // 2
            lines.append(' ' * padding + mono_line)
        
        lines.append('')
        
        # Status bar with name
        status_bar = f"[{current_state.upper()}]"
        center_content = f"{status_bar} {name} "
        center_pad = (cols - len(center_content)) // 2
        lines.append(' ' * center_pad + center_content)
        lines.append('')
        
        # Message section
        if message:
            wrap_width = max(40, cols - 4)
            wrapped = self._wrap_text(message, wrap_width)
            for line in wrapped:
                lines.append('  ' + line)
        lines.append('')
        
        # Timestamp
        ts = datetime.fromtimestamp(updated).strftime('%H:%M:%S')
        lines.append(f"  Updated: {ts}")
        lines.append('')
        
        # Footer - subtle bottom footer with script name and mode hint
        footer_content = f"{self.script_name} | {self.mode}"
        footer_len = len(footer_content)
        footer_pad = (cols - footer_len) // 2
        lines.append('─' * footer_len)
        lines.append(' ' * footer_pad + footer_content)
        lines.append('─' * footer_len)
        lines.append('')
        
        return '\n'.join(lines)
    
    def display(self, once=False):
        self.idle_start = time.time()
        
        if once:
            print(self._build_display())
            return
        
        while self.running:
            try:
                sys.stdout.write('\033[2J\033[H')
                sys.stdout.write(self._build_display())
                sys.stdout.flush()
                time.sleep(0.5)
            except (BrokenPipeError, IOError):
                break
    
    def update_state(self, state=None, message=None):
        if state is not None:
            self.state['state'] = state
        if message is not None:
            self.state['message'] = message
        self.state['updated'] = time.time()
        self._save_state()
        self.idle_start = time.time()


def main():
    parser = argparse.ArgumentParser(
        description='clawd-presence command deck display'
    )
    parser.add_argument('--once', '-o', action='store_true',
                        help='Display once and exit')
    parser.add_argument('--state', '-s',
                        help='Set current state')
    parser.add_argument('--message', '-m',
                        help='Set current message')
    parser.add_argument('--script-name', default='display',
                        help='Script name for footer')
    parser.add_argument('--mode', default='live',
                        help='Mode hint for footer')
    
    args = parser.parse_args()
    
    display = PresenceDisplay(
        script_name=args.script_name,
        mode=args.mode
    )
    
    if args.state or args.message:
        display.update_state(
            state=args.state,
            message=args.message
        )
    
    if args.once:
        display.display(once=True)
    else:
        display.display()


if __name__ == '__main__':
    main()
EOF
