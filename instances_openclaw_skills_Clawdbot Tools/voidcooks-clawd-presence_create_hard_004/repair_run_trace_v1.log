#!/usr/bin/env python3
"""
clawd-presence status - Status management with auto-idle behavior

Manages presence state and handles automatic idle transitions.
"""

import json
import time
import sys
import argparse
from pathlib import Path

CONFIG_FILE = Path('config.json')
STATE_FILE = Path('state.json')


def load_config():
    """Load configuration, return defaults if not found."""
    if CONFIG_FILE.exists():
        try:
            with open(CONFIG_FILE, 'r', encoding='utf-8') as f:
                return json.load(f)
        except (json.JSONDecodeError, IOError):
            pass
    return {
        'letter': 'A',
        'name': 'PRESENCE',
        'idle_timeout': 300,
    }


def load_state():
    """Load state, return defaults if not found."""
    if STATE_FILE.exists():
        try:
            with open(STATE_FILE, 'r', encoding='utf-8') as f:
                return json.load(f)
        except (json.JSONDecodeError, IOError):
            pass
    return {
        'state': 'idle',
        'message': 'Ready',
        'updated': time.time(),
    }


def save_state(state):
    """Save state to file."""
    with open(STATE_FILE, 'w', encoding='utf-8') as f:
        json.dump(state, f, indent=2)
        f.write('\n')


def check_auto_idle():
    """Check and apply auto-idle behavior based on config timeout."""
    config = load_config()
    state = load_state()
    
    idle_timeout = config.get('idle_timeout', 300)
    last_updated = state.get('updated', time.time())
    elapsed = time.time() - last_updated
    
    if elapsed > idle_timeout:
        state['state'] = 'idle'
        state['message'] = 'Auto-idle timeout'
        state['updated'] = time.time()
        save_state(state)
        return True
    return False


def set_status(state=None, message=None):
    """Set the current status."""
    config = load_config()
    current_state = load_state()
    
    if state is not None:
        current_state['state'] = state
    if message is not None:
        current_state['message'] = message
    
    current_state['updated'] = time.time()
    save_state(current_state)
    
    print(f"Status updated: {current_state}")


def get_status():
    """Get current status."""
    check_auto_idle()
    state = load_state()
    print(json.dumps(state, indent=2))


def show_config():
    """Show current configuration."""
    config = load_config()
    print(json.dumps(config, indent=2))


def main():
    parser = argparse.ArgumentParser(
        description='clawd-presence status management'
    )
    subparsers = parser.add_subparsers(dest='command', help='Commands')
    
    # set subcommand
    set_parser = subparsers.add_parser('set', help='Set status')
    set_parser.add_argument('--state', '-s',
                            help='Set state (e.g., active, think, idle)')
    set_parser.add_argument('--message', '-m',
                            help='Set message')
    set_parser.set_defaults(func=set_status)
    
    # get subcommand
    get_parser = subparsers.add_parser('get', help='Get current status')
    get_parser.set_defaults(func=get_status)
    
    # config subcommand
    config_parser = subparsers.add_parser('config', help='Show configuration')
    config_parser.set_defaults(func=show_config)
    
    # idle subcommand
    idle_parser = subparsers.add_parser('idle', help='Check and apply auto-idle')
    idle_parser.set_defaults(func=check_auto_idle)
    
    args = parser.parse_args()
    
    if args.command is None:
        parser.print_help()
        return
    
    if args.command == 'set':
        args.func(state=args.state, message=args.message)
    elif args.command == 'idle':
        changed = args.func()
        if changed:
            print("Status changed to idle due to timeout.")
        else:
            print("Status unchanged, within timeout period.")
    else:
        args.func()


if __name__ == '__main__':
    main()
