#!/usr/bin/env python3
"""
clawd-presence configure tool

Safely initializes the project from a fresh checkout without clobbering existing settings.
"""

import json
import argparse
from pathlib import Path

CONFIG_FILE = Path('config.json')
DEFAULT_CONFIG = {
    'letter': 'A',
    'name': 'PRESENCE',
    'idle_timeout': 300,
    'marker': 'CONFIG-MARKER-1',
}


def load_config():
    """Load existing config if present."""
    if CONFIG_FILE.exists():
        try:
            with open(CONFIG_FILE, 'r', encoding='utf-8') as f:
                return json.load(f)
        except (json.JSONDecodeError, IOError):
            return None
    return None


def save_config(config):
    """Save config to file."""
    with open(CONFIG_FILE, 'w', encoding='utf-8') as f:
        json.dump(config, f, indent=2)
        f.write('\n')


def init(args):
    """Initialize config from a fresh checkout, preserving existing settings."""
    existing = load_config()
    
    if existing is not None:
        # Config already exists - only update if explicitly requested
        if args.force:
            print("Force flag set, overwriting existing config...")
        else:
            print("Config already exists. Use --force to overwrite.")
            return
    
    # Fresh initialization
    config = DEFAULT_CONFIG.copy()
    
    if args.letter:
        config['letter'] = args.letter.upper()
    if args.name:
        config['name'] = args.name
    if args.timeout is not None:
        config['idle_timeout'] = args.timeout
    
    save_config(config)
    print(f"Initialized config: {config}")


def show(args):
    """Display current configuration."""
    config = load_config()
    if config is None:
        print("No config found. Run with --init to create one.")
        return
    print(json.dumps(config, indent=2))


def update(args):
    """Update specific config values without clobbering others."""
    config = load_config()
    
    if config is None:
        config = DEFAULT_CONFIG.copy()
    
    if args.letter:
        config['letter'] = args.letter.upper()
    if args.name:
        config['name'] = args.name
    if args.timeout is not None:
        config['idle_timeout'] = args.timeout
    
    save_config(config)
    print(f"Updated config: {config}")


def main():
    parser = argparse.ArgumentParser(
        description='clawd-presence configuration tool'
    )
    subparsers = parser.add_subparsers(dest='command', help='Commands')
    
    # init subcommand
    init_parser = subparsers.add_parser('init', help='Initialize config')
    init_parser.add_argument('--letter', '-l', help='Initial letter')
    init_parser.add_argument('--name', '-n', help='Initial name')
    init_parser.add_argument('--timeout', '-t', type=int, help='Idle timeout in seconds')
    init_parser.add_argument('--force', action='store_true', help='Overwrite existing config')
    init_parser.set_defaults(func=init)
    
    # show subcommand
    show_parser = subparsers.add_parser('show', help='Show current config')
    show_parser.set_defaults(func=show)
    
    # update subcommand
    update_parser = subparsers.add_parser('update', help='Update config values')
    update_parser.add_argument('--letter', '-l', help='New letter')
    update_parser.add_argument('--name', '-n', help='New name')
    update_parser.add_argument('--timeout', '-t', type=int, help='New idle timeout')
    update_parser.set_defaults(func=update)
    
    args = parser.parse_args()
    
    if args.command is None:
        parser.print_help()
        return
    
    args.func(args)


if __name__ == '__main__':
    main()
