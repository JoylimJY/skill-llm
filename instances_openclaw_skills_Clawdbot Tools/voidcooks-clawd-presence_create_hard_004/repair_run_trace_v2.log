#!/usr/bin/env python3
"""
status.py - Status management for clawd-presence

Handles state updates and status reporting for the presence system.
"""

import json
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CONFIG_PATH = ROOT / "config.json"
STATE_PATH = ROOT / "state.json"


def load_config():
    """Load configuration."""
    if CONFIG_PATH.exists():
        try:
            with open(CONFIG_PATH, "r", encoding="utf-8") as f:
                return json.load(f)
        except (json.JSONDecodeError, IOError):
            pass
    return {
        "letter": "A",
        "name": "PRESENCE",
        "idle_timeout": 300,
        "marker": "CONFIG-DEFAULT",
    }


def load_state():
    """Load current state."""
    if STATE_PATH.exists():
        try:
            with open(STATE_PATH, "r", encoding="utf-8") as f:
                return json.load(f)
        except (json.JSONDecodeError, IOError):
            pass
    return {
        "state": "idle",
        "message": "Waiting for input",
        "updated": time.time(),
        "marker": "STATE-DEFAULT",
    }


def save_state(state):
    """Save state to file."""
    with open(STATE_PATH, "w", encoding="utf-8") as f:
        json.dump(state, f, indent=2)
        f.write("\n")


def update_state(new_state, message=""):
    """Update the current state."""
    state = load_state()
    state["state"] = new_state
    state["message"] = message
    state["updated"] = time.time()
    save_state(state)
    print(f"State updated: {new_state}")
    if message:
        print(f"Message: {message}")


def set_idle():
    """Set state to idle."""
    update_state("idle", "Idle mode active")


def set_think():
    """Set state to thinking."""
    update_state("think", "Processing...")


def set_active(message=""):
    """Set state to active with optional message."""
    update_state("active", message or "Active")


def get_status():
    """Get current status information."""
    config = load_config()
    state = load_state()
    
    idle_timeout = config.get("idle_timeout", 300)
    updated = state.get("updated", 0)
    is_idle = (time.time() - updated) > idle_timeout
    
    status = {
        "name": config.get("name", "PRESENCE"),
        "letter": config.get("letter", "A"),
        "state": state.get("state", "idle"),
        "message": state.get("message", ""),
        "is_idle": is_idle,
        "time_since_update": time.time() - updated,
        "idle_timeout": idle_timeout,
    }
    return status


def main():
    if len(sys.argv) < 2:
        # Default: show current status
        status = get_status()
        print(json.dumps(status, indent=2))
        return 0
    
    command = sys.argv[1].lower()
    
    if command == "show":
        status = get_status()
        print(json.dumps(status, indent=2))
        return 0
    
    elif command == "idle":
        set_idle()
        return 0
    
    elif command == "think":
        set_think()
        return 0
    
    elif command == "active":
        message = " ".join(sys.argv[2:]) if len(sys.argv) > 2 else ""
        set_active(message)
        return 0
    
    elif command == "set":
        if len(sys.argv) >= 3:
            new_state = sys.argv[2]
            message = " ".join(sys.argv[3:]) if len(sys.argv) > 3 else ""
            update_state(new_state, message)
        else:
            print("Usage: status.py set <state> [message]")
            return 1
        return 0
    
    else:
        print(f"Usage: status.py [show|idle|think|active [msg]|set <state> [msg]]")
        print("  show   - Display current status")
        print("  idle   - Set state to idle")
        print("  think  - Set state to thinking")
        print("  active - Set state to active")
        print("  set    - Set arbitrary state")
        return 1


if __name__ == "__main__":
    sys.exit(main())
