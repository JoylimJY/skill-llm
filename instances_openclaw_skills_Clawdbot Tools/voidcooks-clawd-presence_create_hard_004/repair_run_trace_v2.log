#!/usr/bin/env python3
"""
display.py - Command deck layout for clawd-presence

Displays presence state in a polished command deck format with:
- Status/state behavior
- Bottom footer with active script name and mode hint
- Custom monogram support (prefers monogram if available)
- Auto-idle behavior
- Robust on small terminals
"""

import json
import os
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CONFIG_PATH = ROOT / "config.json"
STATE_PATH = ROOT / "state.json"
MONOGRAMS_DIR = ROOT / "assets" / "monograms"

# Script name for footer
SCRIPT_NAME = "display"
MODE_HINT = "live"


def load_config():
    """Load configuration."""
    if CONFIG_PATH.exists():
        try:
            with open(CONFIG_PATH, "r", encoding="utf-8") as f:
                return json.load(f)
        except (json.JSONDecodeError, IOError):
            pass
    return {
        "letter": "A",
        "name": "PRESENCE",
        "idle_timeout": 300,
        "marker": "CONFIG-DEFAULT",
    }


def load_state():
    """Load current state."""
    if STATE_PATH.exists():
        try:
            with open(STATE_PATH, "r", encoding="utf-8") as f:
                return json.load(f)
        except (json.JSONDecodeError, IOError):
            pass
    return {
        "state": "idle",
        "message": "Waiting for input",
        "updated": time.time(),
        "marker": "STATE-DEFAULT",
    }


def load_monogram(letter):
    """Load custom monogram for letter if it exists."""
    monogram_path = MONOGRAMS_DIR / f"{letter}.txt"
    if monogram_path.exists():
        try:
            with open(monogram_path, "r", encoding="utf-8") as f:
                content = f.read()
                # Strip marker lines
                lines = content.strip().split("\n")
                # Remove MARKER lines
                lines = [l for l in lines if not l.startswith("MARKER-MONO")]
                return lines
        except IOError:
            pass
    return None


def get_letter_display(letter):
    """Get display for letter - prefers monogram if available."""
    monogram = load_monogram(letter)
    if monogram:
        return monogram
    
    # Fallback: simple letter display
    return [f"  {letter}  ", f" {letter}{letter}{letter} ", f"  {letter}  "]


def check_idle(state, config):
    """Check if state should be considered idle based on timeout."""
    idle_timeout = config.get("idle_timeout", 300)
    updated = state.get("updated", 0)
    if time.time() - updated > idle_timeout:
        return True
    return False


def get_terminal_size():
    """Get terminal size, with fallbacks for small terminals."""
    try:
        cols, rows = os.get_terminal_size()
    except (OSError, ValueError):
        cols, rows = 80, 24
    
    # Ensure minimum size
    cols = max(cols, 40)
    rows = max(rows, 10)
    return cols, rows


def render_command_deck(config, state, is_idle):
    """Render the command deck layout."""
    cols, rows = get_terminal_size()
    
    letter = config.get("letter", "A")
    name = config.get("name", "PRESENCE")
    
    # Get monogram or fallback
    monogram = get_letter_display(letter)
    
    # Determine current state display
    current_state = state.get("state", "idle")
    message = state.get("message", "")
    
    # Build the display
    lines = []
    
    # Header line
    header = f"[{name.upper()}]"
    lines.append(header.center(cols))
    lines.append("─" * min(cols, len(header) + 4))
    lines.append("")
    
    # Monogram section (scaled for small terminals)
    mono_height = len(monogram)
    if rows < 15:
        # Compress monogram for small terminals
        mono_height = min(mono_height, 3)
        display_mono = monogram[:mono_height]
    else:
        display_mono = monogram
    
    # Add monogram with some padding
    for line in display_mono:
        # Truncate if too wide
        if len(line) > cols - 4:
            line = line[:cols - 4 - 3] + "..."
        lines.append(f"  {line}")
    lines.append("")
    
    # Status section
    status_indicator = "●" if not is_idle else "○"
    status_text = f"{status_indicator} {current_state.upper()}"
    lines.append(status_text)
    
    # Message (wrap if needed)
    if message:
        # Word wrap message for small terminals
        max_msg_width = cols - 6
        words = message.split()
        current_line = []
        current_length = 0
        
        for word in words:
            if current_length + len(word) + 1 <= max_msg_width:
                current_line.append(word)
                current_length += len(word) + 1
            else:
                if current_line:
                    lines.append(f"  {' '.join(current_line)}")
                current_line = [word]
                current_length = len(word)
        
        if current_line:
            lines.append(f"  {' '.join(current_line)}")
    
    lines.append("")
    
    # Footer section - subtle bottom footer with script name and mode hint
    footer_text = f"{SCRIPT_NAME} | {MODE_HINT}"
    footer = f"└─ {footer_text}"
    lines.append(footer)
    
    # Trim to terminal height if needed
    if len(lines) > rows - 1:
        lines = lines[:rows - 1]
    
    return "\n".join(lines)


def main():
    """Main display loop."""
    # Check for single render mode (for testing or non-interactive use)
    single_render = "--once" in sys.argv or "-1" in sys.argv
    
    config = load_config()
    state = load_state()
    
    # Clear screen
    print("\033[2J\033[H", end="")
    
    if single_render:
        is_idle = check_idle(state, config)
        deck = render_command_deck(config, state, is_idle)
        print(deck)
        return 0
    
    # Continuous mode with auto-idle checking
    try:
        while True:
            # Reload state to detect changes
            state = load_state()
            is_idle = check_idle(state, config)
            
            # Clear and render
            print("\033[2J\033[H", end="")
            deck = render_command_deck(config, state, is_idle)
            print(deck)
            
            # Refresh rate
            time.sleep(0.5)
    
    except KeyboardInterrupt:
        print("\nExiting...")
        return 0
    except Exception as e:
        print(f"Error: {e}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
