#!/usr/bin/env python3
"""
configure.py - Safe configuration tool for clawd-presence

Safely initializes the project from a fresh checkout without clobbering existing settings.
"""

import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CONFIG_PATH = ROOT / "config.json"

DEFAULT_CONFIG = {
    "letter": "A",
    "name": "PRESENCE",
    "idle_timeout": 300,
    "marker": "CONFIG-DEFAULT",
}


def load_config():
    """Load existing config if it exists."""
    if CONFIG_PATH.exists():
        try:
            with open(CONFIG_PATH, "r", encoding="utf-8") as f:
                return json.load(f)
        except (json.JSONDecodeError, IOError):
            return None
    return None


def save_config(config):
    """Save config to file."""
    with open(CONFIG_PATH, "w", encoding="utf-8") as f:
        json.dump(config, f, indent=2)
        f.write("\n")


def init_config():
    """Initialize config only if it doesn't exist (safe for fresh checkout)."""
    existing = load_config()
    if existing is not None:
        # Config already exists - do not clobber
        print(f"Configuration already exists at {CONFIG_PATH}")
        print("Current settings:")
        for key, value in existing.items():
            print(f"  {key}: {value}")
        return existing
    
    # Fresh checkout - create default config
    save_config(DEFAULT_CONFIG)
    print(f"Initialized new configuration at {CONFIG_PATH}")
    print("Default settings:")
    for key, value in DEFAULT_CONFIG.items():
        print(f"  {key}: {value}")
    return DEFAULT_CONFIG


def update_config(key, value):
    """Update a specific config key."""
    config = load_config()
    if config is None:
        config = DEFAULT_CONFIG.copy()
    
    config[key] = value
    save_config(config)
    print(f"Updated {key} = {value}")
    return config


def main():
    if len(sys.argv) < 2:
        # Default: safe init (won't clobber existing)
        init_config()
        return 0
    
    command = sys.argv[1].lower()
    
    if command == "init":
        init_config()
        return 0
    
    elif command == "set" and len(sys.argv) >= 4:
        key = sys.argv[2]
        value = sys.argv[3]
        # Try to parse as int or float
        try:
            value = int(value)
        except ValueError:
            try:
                value = float(value)
            except ValueError:
                pass
        update_config(key, value)
        return 0
    
    elif command == "show":
        config = load_config()
        if config:
            print(json.dumps(config, indent=2))
        else:
            print("No configuration found. Run 'configure.py init' to create one.")
            return 1
        return 0
    
    else:
        print(f"Usage: configure.py [init|show|set <key> <value>]")
        print("  init  - Initialize config (safe: won't overwrite existing)")
        print("  show  - Display current configuration")
        print("  set   - Set a configuration value")
        return 1


if __name__ == "__main__":
    sys.exit(main())
