#!/usr/bin/env python3
"""Configure the clawd-presence dashboard."""
import json
import argparse
from pathlib import Path

CONFIG_FILE = Path('clawd_config.json')

def configure(letter: str, name: str, idle_timeout: int, marker: str = "clawd-presence-demo"):
    """Create or update the presence configuration."""
    config = {
        "letter": letter.upper(),
        "name": name.upper(),
        "idle_timeout": idle_timeout,
        "marker": marker
    }
    CONFIG_FILE.write_text(json.dumps(config, indent=2), encoding='utf-8')
    print(f"Configuration saved: {name} ({letter}) with {idle_timeout}s idle timeout")
    return config

def load_config():
    """Load the current configuration."""
    if CONFIG_FILE.exists():
        return json.loads(CONFIG_FILE.read_text(encoding='utf-8'))
    return None

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Configure clawd-presence")
    parser.add_argument("--letter", required=True, help="Single letter monogram")
    parser.add_argument("--name", required=True, help="Agent name")
    parser.add_argument("--idle-timeout", type=int, default=600, help="Idle timeout in seconds")
    parser.add_argument("--marker", default="clawd-presence-demo", help="Config marker")
    
    args = parser.parse_args()
    configure(args.letter, args.name, args.idle_timeout, args.marker)
