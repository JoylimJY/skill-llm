#!/usr/bin/env python3
"""Manage status transitions for clawd-presence."""
import json
import argparse
from pathlib import Path
from datetime import datetime

STATUS_FILE = Path('presence_status.json')
TRANSITION_LOG = Path('transition_log.txt')

VALID_STATES = ['idle', 'work', 'think', 'alert', 'away', 'busy']

def get_current_status():
    """Get current status."""
    if STATUS_FILE.exists():
        return json.loads(STATUS_FILE.read_text(encoding='utf-8'))
    return {"state": "idle", "message": "", "last_transition": None}

def set_status(state: str, message: str = ""):
    """Set a new status and log the transition."""
    current = get_current_status()
    previous_state = current.get("state", "idle")
    
    if state not in VALID_STATES:
        print(f"Error: Invalid state '{state}'. Valid states: {VALID_STATES}")
        return None
    
    timestamp = datetime.now().isoformat()
    new_status = {
        "state": state,
        "message": message,
        "last_transition": timestamp,
        "previous_state": previous_state
    }
    
    STATUS_FILE.write_text(json.dumps(new_status, indent=2), encoding='utf-8')
    
    # Log the transition
    log_entry = f"[{timestamp}] {previous_state} -> {state} | message: '{message}'\n"
    if TRANSITION_LOG.exists():
        TRANSITION_LOG.write_text(TRANSITION_LOG.read_text(encoding='utf-8') + log_entry, encoding='utf-8')
    else:
        TRANSITION_LOG.write_text(f"=== CLAWD PRESENCE TRANSITION LOG ===\n{log_entry}", encoding='utf-8')
    
    print(f"Status changed: {previous_state} -> {state}")
    if message:
        print(f"Message: {message}")
    return new_status

def clear_message():
    """Clear the current status message."""
    current = get_current_status()
    set_status(current.get("state", "idle"), "")
    print("Message cleared")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Manage clawd-presence status")
    parser.add_argument("state", nargs="?", choices=VALID_STATES, help="New state")
    parser.add_argument("--message", "-m", default="", help="Status message")
    parser.add_argument("--clear", action="store_true", help="Clear the message")
    parser.add_argument("--show", "-s", action="store_true", help="Show current status")
    
    args = parser.parse_args()
    
    if args.show:
        status = get_current_status()
        print(json.dumps(status, indent=2))
    elif args.clear:
        clear_message()
    elif args.state:
        set_status(args.state, args.message)
    else:
        parser.print_help()
EOF
