#!/usr/bin/env python3
"""Display the clawd-presence dashboard."""
import json
import argparse
from pathlib import Path
from datetime import datetime

CONFIG_FILE = Path('clawd_config.json')
STATUS_FILE = Path('presence_status.json')
MONOGRAMS_DIR = Path('assets/monograms')

def get_config():
    """Load configuration."""
    if CONFIG_FILE.exists():
        return json.loads(CONFIG_FILE.read_text(encoding='utf-8'))
    return None

def get_status():
    """Load current status."""
    if STATUS_FILE.exists():
        return json.loads(STATUS_FILE.read_text(encoding='utf-8'))
    return {"state": "idle", "message": "", "last_transition": None}

def get_monogram(letter: str):
    """Get monogram art for a letter."""
    monogram_file = MONOGRAMS_DIR / f"{letter.upper()}.txt"
    if monogram_file.exists():
        return monogram_file.read_text(encoding='utf-8').strip()
    # Fallback: simple letter display
    return letter.upper()

def display_dashboard():
    """Display the presence dashboard."""
    config = get_config()
    if not config:
        print("Error: No configuration found. Run 'configure.py' first.")
        return
    
    status = get_status()
    letter = config.get("letter", "?")
    name = config.get("name", "UNKNOWN")
    idle_timeout = config.get("idle_timeout", 600)
    state = status.get("state", "idle")
    message = status.get("message", "")
    last_transition = status.get("last_transition")
    
    monogram = get_monogram(letter)
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    
    # Color codes for different states
    state_colors = {
        'idle': '\033[90m',      # Gray
        'work': '\033[32m',      # Green
        'think': '\033[33m',     # Yellow
        'alert': '\033[31m',     # Red
        'away': '\033[36m',      # Cyan
        'busy': '\033[91m'       # Bright Red
    }
    reset = '\033[0m'
    color = state_colors.get(state, '\033[0m')
    
    print("=" * 50)
    print(f"  CLAWD PRESENCE DASHBOARD  {timestamp}")
    print("=" * 50)
    print()
    print(f"Agent: {name}")
    print(f"Letter: {letter}")
    print(f"State: {color}{state.upper()}{reset}")
    if message:
        print(f"Message: {message}")
    print()
    print("Monogram:")
    print(monogram)
    print()
    if last_transition:
        print(f"Last transition: {last_transition}")
    print()
    print(f"Idle timeout: {idle_timeout}s ({idle_timeout // 60} minutes)")
    print("=" * 50)

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Display clawd-presence dashboard")
    parser.add_argument("--watch", "-w", action="store_true", help="Watch mode (refresh every 2s)")
    args = parser.parse_args()
    
    display_dashboard()
EOF
