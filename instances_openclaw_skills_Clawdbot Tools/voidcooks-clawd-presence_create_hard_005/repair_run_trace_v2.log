#!/usr/bin/env python3
"""Manage clawd-presence status transitions."""
import json
import argparse
from pathlib import Path
from datetime import datetime

STATUS_FILE = Path('presence_status.json')

VALID_STATES = ['idle', 'work', 'think', 'alert']

def load_status():
    if STATUS_FILE.exists():
        return json.loads(STATUS_FILE.read_text())
    return {'state': 'idle', 'message': '', 'last_transition': None}

def save_status(status):
    STATUS_FILE.write_text(json.dumps(status, indent=2))

def main():
    parser = argparse.ArgumentParser(description='Manage clawd-presence status')
    parser.add_argument('--set', type=str, choices=VALID_STATES, help='Set new state')
    parser.add_argument('--message', type=str, help='Optional message')
    parser.add_argument('--show', action='store_true', help='Show current status')
    args = parser.parse_args()
    
    status = load_status()
    
    if args.set:
        old_state = status['state']
        status['state'] = args.set
        if args.message:
            status['message'] = args.message
        else:
            status['message'] = ''
        status['last_transition'] = f"{old_state} -> {args.set}"
        status['timestamp'] = datetime.now().isoformat()
        save_status(status)
        print(f"State transitioned: {old_state} -> {args.set}")
    elif args.show:
        print(json.dumps(status, indent=2))
    else:
        print(json.dumps(status, indent=2))

if __name__ == '__main__':
    main()
EOF
