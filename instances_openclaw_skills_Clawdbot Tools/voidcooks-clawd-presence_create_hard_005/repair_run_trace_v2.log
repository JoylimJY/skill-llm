#!/usr/bin/env python3
"""Display clawd-presence dashboard."""
import json
import argparse
from pathlib import Path

CONFIG_FILE = Path('presence_config.json')
STATUS_FILE = Path('presence_status.json')
ASSETS_DIR = Path('assets/monograms')

def load_config():
    if CONFIG_FILE.exists():
        return json.loads(CONFIG_FILE.read_text())
    return {}

def load_status():
    if STATUS_FILE.exists():
        return json.loads(STATUS_FILE.read_text())
    return {'state': 'idle', 'message': '', 'last_transition': None}

def get_monogram(letter):
    """Get monogram art for a letter."""
    monogram_file = ASSETS_DIR / f'{letter.upper()}.txt'
    if monogram_file.exists():
        content = monogram_file.read_text()
        # Remove marker line if present
        lines = [l for l in content.strip().split('\n') if not l.startswith('marker:')]
        return '\n'.join(lines)
    return f"  {letter.upper()}  "

def main():
    parser = argparse.ArgumentParser(description='Display clawd-presence dashboard')
    parser.add_argument('--compact', action='store_true', help='Compact display')
    args = parser.parse_args()
    
    config = load_config()
    status = load_status()
    
    name = config.get('name', 'AGENT')
    letter = config.get('letter', 'A')
    idle_timeout = config.get('idle_timeout', 300)
    state = status.get('state', 'idle')
    message = status.get('message', '')
    last_transition = status.get('last_transition', 'N/A')
    timestamp = status.get('timestamp', 'N/A')
    
    monogram = get_monogram(letter)
    
    state_colors = {
        'idle': '🔵',
        'work': '🟢',
        'think': '🟡',
        'alert': '🔴'
    }
    
    if args.compact:
        print(f"[{state_colors.get(state, '⚪')} {state.upper():6}] {name} ({letter}) | Timeout: {idle_timeout}s")
    else:
        print("=" * 50)
        print(f"  CLAWD PRESENCE DASHBOARD")
        print("=" * 50)
        print()
        print(f"  {monogram}")
        print()
        print(f"  Name:     {name}")
        print(f"  Letter:   {letter}")
        print(f"  State:    {state_colors.get(state, '⚪')} {state.upper()}")
        print(f"  Timeout:  {idle_timeout} seconds ({idle_timeout // 60} minutes)")
        if message:
            print(f"  Message:  {message}")
        print(f"  Last:     {last_transition}")
        print(f"  Time:     {timestamp}")
        print()
        print("=" * 50)

if __name__ == '__main__':
    main()
EOF
