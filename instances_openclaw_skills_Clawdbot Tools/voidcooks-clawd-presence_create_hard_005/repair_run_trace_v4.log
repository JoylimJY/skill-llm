#!/usr/bin/env python3
"""Display the clawd-presence dashboard."""

import json
import os
import sys
from pathlib import Path
from datetime import datetime

CONFIG_FILE = Path("presence_config.json")
STATUS_FILE = Path("presence_status.json")
MONOGRAMS_DIR = Path("assets/monograms")

def load_config():
    if CONFIG_FILE.exists():
        with open(CONFIG_FILE) as f:
            return json.load(f)
    return {}

def load_status():
    if STATUS_FILE.exists():
        with open(STATUS_FILE) as f:
            return json.load(f)
    return {'state': 'idle', 'message': '', 'last_transition': None}

def load_monogram(letter):
    monogram_path = MONOGRAMS_DIR / f"{letter.upper()}.txt"
    if monogram_path.exists():
        return monogram_path.read_text().strip()
    return f"  {letter.upper()}  "

def get_state_indicator(state):
    indicators = {
        'idle': '○',
        'work': '●',
        'think': '◎',
        'alert': '▲'
    }
    return indicators.get(state, '?')

def display_dashboard():
    config = load_config()
    status = load_status()
    
    name = config.get('name', 'Unknown')
    letter = config.get('letter', '?')
    idle_timeout = config.get('idle_timeout', 600)
    state = status['state']
    message = status['message']
    
    monogram = load_monogram(letter)
    indicator = get_state_indicator(state)
    
    # Clear screen
    os.system('clear' if os.name != 'nt' else 'cls')
    
    # Build display
    lines = []
    lines.append("╔" + "═" * 48 + "╗")
    lines.append("║" + " CLAWD PRESENCE DASHBOARD".center(48) + "║")
    lines.append("╠" + "═" * 48 + "╣")
    
    # Monogram display
    monogram_lines = monogram.split('\n')
    padding = (10 - len(monogram_lines)) // 2
    for i, line in enumerate(monogram_lines):
        if i < padding:
            lines.append("║" + " " * 48 + "║")
        elif i >= padding + len(monogram_lines):
            break
        else:
            centered = line.center(48)
            lines.append("║" + centered + "║")
    
    lines.append("╠" + "═" * 48 + "╣")
    
    # Agent info
    name_line = f"  Agent: {name}".ljust(48)
    state_line = f"  State: {indicator} {state.upper()}".ljust(48)
    timeout_line = f"  Idle Timeout: {idle_timeout}s ({idle_timeout//60} min)".ljust(48)
    
    lines.append("║" + name_line + "║")
    lines.append("║" + state_line + "║")
    lines.append("║" + timeout_line + "║")
    
    if message:
        msg_wrapped = []
        words = message.split()
        current = ""
        for word in words:
            if len(current) + len(word) + 1 <= 46:
                current += (" " if current else "") + word
            else:
                if current:
                    msg_wrapped.append(current)
                current = word
        if current:
            msg_wrapped.append(current)
        
        lines.append("║" + " " * 48 + "║")
        for w in msg_wrapped:
            lines.append("║" + f"  Message: {w}".ljust(48) + "║")
    
    lines.append("╠" + "═" * 48 + "╣")
    
    # Timestamp
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    ts_line = f"  Last Update: {timestamp}".ljust(48)
    lines.append("║" + ts_line + "║")
    lines.append("╚" + "═" * 48 + "╝")
    
    for line in lines:
        print(line)

def main():
    display_dashboard()

if __name__ == '__main__':
    main()
EOF
