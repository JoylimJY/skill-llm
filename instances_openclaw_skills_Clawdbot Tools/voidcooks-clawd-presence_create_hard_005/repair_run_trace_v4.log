#!/usr/bin/env python3
"""Manage presence status transitions for clawd-presence."""

import argparse
import json
from pathlib import Path
from datetime import datetime

STATUS_FILE = Path("presence_status.json")
CONFIG_FILE = Path("presence_config.json")

VALID_STATES = ['idle', 'work', 'think', 'alert']

def load_status():
    if STATUS_FILE.exists():
        with open(STATUS_FILE) as f:
            return json.load(f)
    return {'state': 'idle', 'message': '', 'last_transition': None, 'history': []}

def save_status(status):
    with open(STATUS_FILE, 'w') as f:
        json.dump(status, f, indent=2)

def load_config():
    if CONFIG_FILE.exists():
        with open(CONFIG_FILE) as f:
            return json.load(f)
    return {}

def transition(state, message=None):
    if state not in VALID_STATES:
        print(f"Error: Invalid state '{state}'. Valid states: {VALID_STATES}")
        return False

    status = load_status()
    old_state = status['state']
    timestamp = datetime.now().isoformat()

    status['state'] = state
    status['message'] = message or ''
    status['last_transition'] = f"{old_state} -> {state} at {timestamp}"
    status['history'].append({
        'from': old_state,
        'to': state,
        'message': message or '',
        'timestamp': timestamp
    })

    save_status(status)
    print(f"Transition: {old_state} -> {state}")
    if message:
        print(f"Message: {message}")
    return True

def show_status():
    status = load_status()
    config = load_config()
    
    print("\n=== CLAWD PRESENCE STATUS ===")
    print(f"Agent: {config.get('name', 'Unknown')}")
    print(f"Letter: {config.get('letter', '?')}")
    print(f"State: {status['state']}")
    print(f"Message: {status['message'] or '(none)'}")
    print(f"Last Transition: {status['last_transition'] or 'N/A'}")
    print(f"Idle Timeout: {config.get('idle_timeout', 600)}s")
    print("\n=== Transition History ===")
    for i, h in enumerate(status['history'], 1):
        print(f"{i}. {h['from']} -> {h['to']} ({h['timestamp']})")
        if h['message']:
            print(f"   Message: {h['message']}")
    print()

def main():
    parser = argparse.ArgumentParser(description='Manage clawd-presence status')
    parser.add_argument('state', nargs='?', choices=VALID_STATES, help='Target state')
    parser.add_argument('--message', '-m', help='Status message')
    parser.add_argument('--show', '-s', action='store_true', help='Show current status')
    args = parser.parse_args()

    if args.show or args.state is None:
        show_status()
    else:
        transition(args.state, args.message)

if __name__ == '__main__':
    main()
EOF
