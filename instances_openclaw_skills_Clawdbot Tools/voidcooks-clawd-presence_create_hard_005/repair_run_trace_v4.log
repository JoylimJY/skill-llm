#!/usr/bin/env python3
"""Configure the clawd-presence dashboard settings."""

import argparse
import json
from pathlib import Path

CONFIG_FILE = Path("presence_config.json")

def load_config():
    if CONFIG_FILE.exists():
        with open(CONFIG_FILE) as f:
            return json.load(f)
    return {}

def save_config(config):
    with open(CONFIG_FILE, 'w') as f:
        json.dump(config, f, indent=2)

def main():
    parser = argparse.ArgumentParser(description='Configure clawd-presence')
    parser.add_argument('--name', help='Agent name')
    parser.add_argument('--letter', help='Monogram letter')
    parser.add_argument('--idle-timeout', type=int, help='Idle timeout in seconds')
    parser.add_argument('--marker', help='Demo marker')
    parser.add_argument('--show', action='store_true', help='Show current config')
    args = parser.parse_args()

    config = load_config()

    if args.show:
        print(json.dumps(config, indent=2))
        return

    if args.name:
        config['name'] = args.name
    if args.letter:
        config['letter'] = args.letter
    if args.idle_timeout:
        config['idle_timeout'] = args.idle_timeout
    if args.marker:
        config['marker'] = args.marker

    save_config(config)
    print(f"Configuration saved: {config}")

if __name__ == '__main__':
    main()
