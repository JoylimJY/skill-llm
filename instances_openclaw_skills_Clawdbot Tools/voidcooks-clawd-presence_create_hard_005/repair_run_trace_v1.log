#!/usr/bin/env python3
"""Display the clawd-presence dashboard."""
import argparse
import json
from pathlib import Path
from datetime import datetime

CONFIG_FILE = Path("presence_config.json")
STATUS_FILE = Path("presence_status.json")
ASSETS_DIR = Path("assets/monograms")

def load_config():
    if CONFIG_FILE.exists():
        return json.loads(CONFIG_FILE.read_text())
    return {}

def load_status():
    if STATUS_FILE.exists():
        return json.loads(STATUS_FILE.read_text())
    return {"state": "idle", "message": "", "updated_at": None}

def load_monogram(letter):
    monogram_path = ASSETS_DIR / f"{letter.upper()}.txt"
    if monogram_path.exists():
        content = monogram_path.read_text().strip()
        return content.split("marker:")[0].strip() if "marker:" in content else content
    return f"  {letter.upper()}  \n {letter.upper()} {letter.upper()} \n{letter.upper() * 5}\n {letter.upper()} {letter.upper()} \n  {letter.upper()}  "

def main():
    parser = argparse.ArgumentParser(description="Display clawd-presence dashboard")
    parser.add_argument("--compact", "-c", action="store_true", help="Compact display")
    parser.add_argument("--watch", "-w", action="store_true", help="Watch mode (not implemented)")
    args = parser.parse_args()

    config = load_config()
    status = load_status()
    
    name = config.get("name", "AGENT")
    letter = config.get("letter", "A")
    idle_timeout = config.get("idle_timeout", 600)
    state = status.get("state", "idle")
    message = status.get("message", "")
    updated_at = status.get("updated_at", "N/A")
    
    monogram = load_monogram(letter)
    
    # State indicators
    state_colors = {
        "idle": "○",
        "work": "●",
        "think": "◎",
        "alert": "◉"
    }
    indicator = state_colors.get(state, "?")
    
    if args.compact:
        print(f"{indicator} {name} [{state}]")
        print(f"Message: {message or '(none)'}")
    else:
        print("=" * 50)
        print(f"  CLAWD-PRESENCE DASHBOARD")
        print("=" * 50)
        print()
        print(f"  Agent: {name}")
        print(f"  Monogram: {letter}")
        print(f"  State: {state.upper()} {indicator}")
        print(f"  Idle Timeout: {idle_timeout}s ({idle_timeout // 60} min)")
        print()
        print("  " + "-" * 30)
        for line in monogram.split("\n"):
            print(f"  {line}")
        print("  " + "-" * 30)
        print()
        if message:
            print(f"  Message: {message}")
        print()
        print(f"  Updated: {updated_at}")
        print("=" * 50)

if __name__ == "__main__":
    main()
EOF
