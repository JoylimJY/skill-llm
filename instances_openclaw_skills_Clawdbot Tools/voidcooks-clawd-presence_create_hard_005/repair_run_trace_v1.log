#!/usr/bin/env python3
"""Configure the clawd-presence dashboard."""
import argparse
import json
from pathlib import Path

CONFIG_FILE = Path("presence_config.json")

def load_config():
    if CONFIG_FILE.exists():
        return json.loads(CONFIG_FILE.read_text())
    return {}

def save_config(config):
    CONFIG_FILE.write_text(json.dumps(config, indent=2) + "\n")

def main():
    parser = argparse.ArgumentParser(description="Configure clawd-presence")
    parser.add_argument("--letter", "-l", required=True, help="Monogram letter")
    parser.add_argument("--name", "-n", required=True, help="Agent name")
    parser.add_argument("--idle-timeout", "-t", type=int, default=600, help="Idle timeout in seconds")
