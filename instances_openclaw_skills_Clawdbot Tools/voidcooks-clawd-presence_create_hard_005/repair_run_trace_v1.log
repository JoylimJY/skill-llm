#!/usr/bin/env python3
"""Manage presence status transitions."""
import argparse
import json
from pathlib import Path
from datetime import datetime

STATUS_FILE = Path("presence_status.json")
STATE_LOG = Path("state_transitions.log")

VALID_STATES = ["idle", "work", "think", "alert"]

def load_status():
    if STATUS_FILE.exists():
        return json.loads(STATUS_FILE.read_text())
    return {"state": "idle", "message": "", "updated_at": None}

def save_status(status):
    status["updated_at"] = datetime.now().isoformat()
    STATUS_FILE.write_text(json.dumps(status, indent=2) + "\n")

def log_transition(from_state, to_state, message=""):
    entry = f"{datetime.now().isoformat()} | {from_state} -> {to_state} | {message or 'no message'}\n"
    STATE_LOG.write_text(STATE_LOG.read_text() + entry)

def main():
    parser = argparse.ArgumentParser(description="Manage clawd-presence status")
    parser.add_argument("state", choices=VALID_STATES + ["show"], help="State to set or 'show' to display")
    parser.add_argument("--message", "-m", default="", help="Status message")
    parser.add_argument("--show", "-s", action="store_true", help="Show current status")
    args = parser.parse_args()

    status = load_status()
    
    if args.state == "show" or args.show:
        print(json.dumps(status, indent=2))
        return

    if args.state not in VALID_STATES:
        print(f"Error: Invalid state '{args.state}'")
        return

    from_state = status.get("state", "idle")
    to_state = args.state
    
    if from_state != to_state:
        status["state"] = to_state
        status["message"] = args.message
        save_status(status)
        log_transition(from_state, to_state, args.message)
        print(f"Transition: {from_state} -> {to_state}")
    else:
        status["message"] = args.message
        save_status(status)
        print(f"Updated message in {to_state} state")

if __name__ == "__main__":
    main()
EOF
