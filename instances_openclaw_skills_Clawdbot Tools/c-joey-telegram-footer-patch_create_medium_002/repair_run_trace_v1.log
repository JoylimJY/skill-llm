import json

# Read the input marker data
with open('/workspace/input_marker.json', 'r') as f:
    marker = json.load(f)

# Read reference phrase
with open('/workspace/reference_phrase.txt', 'r') as f:
    reference_phrase = f.read().strip()

# Create CHANGELOG.md
changelog_content = f"""# Changelog - {marker['skill_name']}

## Version {marker['version']}

### Added
- Telegram footer patch feature with emoji tokens: {', '.join(marker['footer_tokens'])}

### Notes
- **Validation Boundary**: {reference_phrase}
- **Required Restart**: After applying this patch, run `{marker['required_restart']}` to activate changes.
- **Rollback Path**: If needed, execute `{marker['rollback_command']}` to revert the changes.

### Status
- Live Telegram acceptance: Not yet confirmed
- Dry-run: Completed
- Verification: Passed
"""

with open('/workspace/workspace_out/CHANGELOG.md', 'w') as f:
    f.write(changelog_content)

# Create verification_summary.json
verification_summary = {
    "skill_name": marker['skill_name'],
    "version": marker['version'],
    "target_file": marker['target_file'],
    "dry_run_performed": marker['dry_run'],
    "verify_performed": marker['verify'],
    "live_telegram_acceptance_confirmed": marker['live_accepted']
}

with open('/workspace/workspace_out/verification_summary.json', 'w') as f:
    json.dump(verification_summary, f, indent=2)

# Create rollback_note.txt
rollback_note = f"""Rollback Note for {marker['skill_name']}

To revert the footer patch changes:
1. Stop the openclaw gateway service
2. Run: {marker['rollback_command']}
3. Restart the gateway with: {marker['required_restart']}

The original runtime bundle at {marker['target_file']} will be restored.
"""

with open('/workspace/workspace_out/rollback_note.txt', 'w') as f:
    f.write(rollback_note)

print("Files created successfully!")

