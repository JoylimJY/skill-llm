from datetime import date
from pathlib import Path

# Valentina's birthday
birthday = date(2000, 2, 14)
today = date.today()

# Calculate age
age = today.year - birthday.year
if (today.month, today.day) < (birthday.month, birthday.day):
    age -= 1

# Create birthday entry
birthday_entry = f"""Valentina
Birthday: 14.02.2000
Turning age: {age}
"""

# Write to birthday file in data directory
data_dir = Path('/workspace/data')
birthday_file = data_dir / 'birthdays.txt'
birthday_file.write_text(birthday_entry, encoding='utf-8')

print(f"Birthday entry saved to {birthday_file}")
print(f"Content:\n{birthday_entry}")
```

