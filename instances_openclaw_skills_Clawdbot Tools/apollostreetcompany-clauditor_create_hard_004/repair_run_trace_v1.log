code = r'''#!/usr/bin/env python3
"""
Clauditor Watchdog Installation Verification Evaluator
"""

import json
import sys
from pathlib import Path
from datetime import datetime
from typing import Dict, List, Tuple

WORKSPACE = Path('/workspace')
REQUIRED_MARKERS = [
    'CLAUDITOR_MARKER_ALPHA', 'CLAUDITOR_MARKER_BETA',
    'CSV_MARKER_X', 'CSV_MARKER_Y', 'CSV_MARKER_Z',
    'JSON_MARKER_A', 'JSON_MARKER_B',
    'IMG_MARKER_1', 'IMG_MARKER_2',
    'PDF_MARKER_ONE', 'PDF_MARKER_TWO',
]

EXPECTED_MARKER_SOURCES = {
    'CLAUDITOR_MARKER_ALPHA': 'install_notes.txt',
    'CLAUDITOR_MARKER_BETA': 'install_notes.txt',
    'CSV_MARKER_X': 'workflow.csv',
    'CSV_MARKER_Y': 'workflow.csv',
    'CSV_MARKER_Z': 'workflow.csv',
    'JSON_MARKER_A': 'task_data.json',
    'JSON_MARKER_B': 'task_data.json',
    'IMG_MARKER_1': 'reference.png',
    'IMG_MARKER_2': 'reference.png',
    'PDF_MARKER_ONE': 'reference.pdf',
    'PDF_MARKER_TWO': 'reference.pdf',
}

REQUIRED_OUTPUTS = [
    'audit_report.json', 'verification_summary.txt',
    'marker_index.json', 'install_verification.txt',
]

def log(msg, verbose=True):
    if verbose:
        print(f"[INFO] {msg}")

def log_error(msg):
    print(f"[ERROR] {msg}")

def log_success(msg):
    print(f"[SUCCESS] {msg}")

def check_output_files():
    missing = [f for f in REQUIRED_OUTPUTS if not (WORKSPACE / f).exists()]
    if missing:
        log_error(f"Missing: {missing}")
        return False, len(missing)
    log_success("All output files exist")
    return True, 0

def validate_audit_report(verbose=True):
    path = WORKSPACE / 'audit_report.json'
    try:
        with open(path) as f:
            report = json.load(f)
    except Exception as e:
        log_error(f"Cannot parse audit_report.json: {e}")
        return False, 0, []
    
    required = ['status', 'markers_found', 'markers_missing', 'file_analysis']
    missing = [f for f in required if f not in report]
    if missing:
        log_error(f"Missing fields: {missing}")
        return False, 0, []
    
    detected = report.get('markers_found', [])
    expected_status = 'PASS' if len(detected) == len(REQUIRED_MARKERS) else 'FAIL'
    if report.get('status') != expected_status:
        log_error(f"Status mismatch: expected {expected_status}")
        return False, len(detected), detected
    
    log_success("audit_report.json valid")
    return True, len(detected), detected

def validate_marker_index(verbose=True):
    path = WORKSPACE / 'marker_index.json'
    try:
        with open(path) as f:
            index = json.load(f)
    except Exception as e:
        log_error(f"Cannot parse marker_index.json: {e}")
        return False, 0
    
    if not isinstance(index, dict):
        return False, 0
    
    correct = 0
    for marker, expected in EXPECTED_MARKER_SOURCES.items():
        if marker in index:
            src = index[marker].get('source') if isinstance(index[marker], dict) else index[marker]
            if src == expected:
                correct += 1
    return correct > 0, correct

def validate_text_files(verbose=True):
    score = 0
    for fname in ['verification_summary.txt', 'install_verification.txt']:
        path = WORKSPACE / fname
        try:
            content = path.read_text().lower()
            checks = [
                ('markers' in content or 'marker' in content),
                ('pass' in content or 'fail' in content),
                (len(content) > 50),
            ]
            score += sum(checks)
        except:
            pass
    return score > 0, score

def calculate_score(detected_count, files_valid):
    marker_score = (detected_count / len(REQUIRED_MARKERS)) * 60
    file_score = (files_valid / len(REQUIRED_OUTPUTS)) * 40
    return marker_score + file_score

def main():
    verbose = '--verbose' in sys.argv or '-v' in sys.argv
    results = {
        'timestamp': datetime.now().isoformat(),
        'overall_status': 'PENDING',
        'checks': [],
        'score': 0.0,
    }
    
    log("Starting Clauditor Watchdog Verification Evaluation", verbose)
    log("=" * 50, verbose)
    
    # Check 1: Files exist
    files_ok, missing = check_output_files()
    results['checks'].append({'name': 'Output Files', 'passed': files_ok})
    
    # Check 2: Audit report
    audit_ok, markers_found, detected = validate_audit_report(verbose)
    results['checks'].append({'name': 'Audit Report', 'passed': audit_ok})
    
    # Check 3: Marker index
    index_ok, correct = validate_marker_index(verbose)
    results['checks'].append({'name': 'Marker Index', 'passed': index_ok})
    
    # Check 4: Text files
    text_ok, text_score = validate_text_files(verbose)
    results['checks'].append({'name': 'Text Files', 'passed': text_ok})
    
    # Calculate score
    score = calculate_score(markers_found, 4 if files_ok else 0)
    results['score'] = score
    results['markers_found'] = markers_found
    results['markers_total'] = len(REQUIRED_MARKERS)
    
    # Overall status
    if files_ok and audit_ok and markers_found == len(REQUIRED_MARKERS):
        results['overall_status'] = 'PASS'
        log_success(f"Evaluation PASSED - Score: {score:.1f}/100")
    else:
        results['overall_status'] = 'FAIL'
        log_error(f"Evaluation FAILED - Score: {score:.1f}/100")
    
    # Output results
    print(json.dumps(results, indent=2))
    return 0 if results['overall_status'] == 'PASS' else 1

if __name__ == '__main__':
    sys.exit(main())
'''

