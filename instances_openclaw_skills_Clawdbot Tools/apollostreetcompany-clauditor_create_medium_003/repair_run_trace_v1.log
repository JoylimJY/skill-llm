```bash
# Generate a digest for verification - hash the configuration and watched directories
DIGEST_FILE="/var/lib/clauditor/digest.sha256"

{
    echo "# Clauditor Setup Digest"
    echo "# Generated: $(date -Iseconds)"
    echo ""
    echo "# Configuration file hash"
    sha256sum /etc/clauditor/clauditor.conf
    echo ""
    echo "# Watched directories state"
    for dir in /var/lib/.sysd/.audit /opt/team-alpha /srv/project-x; do
        echo "Directory: $dir"
        stat --format="  Owner: %U:%G, Permissions: %a, UID: %u, GID: %g" "$dir"
    done
    echo ""
    echo "# System user info"
    id clauditor
    echo ""
    echo "# Full configuration hash"
    sha256sum /etc/clauditor/clauditor.conf | awk '{print $1}'
} > "$DIGEST_FILE"

chmod 640 "$DIGEST_FILE"
chown clauditor:clauditor "$DIGEST_FILE"

cat "$DIGEST_FILE"
