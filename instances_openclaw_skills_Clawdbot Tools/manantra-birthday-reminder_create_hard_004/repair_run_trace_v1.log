#!/usr/bin/env python3
"""
Import birthdays from Markdown notes into skill storage.
Normalize entries and prepare reminder data for upcoming birthdays.
"""

import json
import re
from datetime import date

# Read the notes file
with open('/workspace/notes/birthday_notes.txt', 'r') as f:
    lines = f.readlines()

# Read the seed file for reference
with open('/workspace/data/seed.json', 'r') as f:
    seed_data = json.load(f)

birthdays = []

month_map = {
    'januar': '01', 'februar': '02', 'märz': '03', 'april': '04',
    'mai': '05', 'juni': '06', 'juli': '07', 'august': '08',
    'september': '09', 'oktober': '10', 'november': '11', 'dezember': '12'
}

for line in lines:
    line = line.strip()
    
    # Pattern 1: "Name hat am DD. Month Geburtstag." (German, no year)
    match = re.search(r'-\s*(\w+)\s+hat\s+am\s+(\d{1,2})\.\s*(\w+)\s+Geburtstag\.', line)
    if match:
        name = match.group(1)
        day = match.group(2).zfill(2)
        month = month_map.get(match.group(3).lower())
        year = None
        print(f"Pattern 1: {name}, {day}, {month}, {year}")
        birthdays.append({'name': name, 'day': day, 'month': month, 'year': year})
        continue
    
    # Pattern 2: "Name hat am DD.MM. Geburtstag." (German, no year, numeric month)
    match = re.search(r'-\s*(\w+)\s+hat\s+am\s+(\d{1,2})\.(\d{1,2})\.\s*Geburtstag\.', line)
    if match:
        name = match.group(1)
        day = match.group(2).zfill(2)
        month = match.group(3).zfill(2)
        year = None
        print(f"Pattern 2: {name}, {day}, {month}, {year}")
        birthdays.append({'name': name, 'day': day, 'month': month, 'year': year})
        continue
    
    # Pattern 3: "Name was born on DD.MM.YYYY." (English)
    match = re.search(r'-\s*(\w+)\s+was\s+born\s+on\s+(\d{1,2})\.(\d{1,2})\.(\d{4})\.', line)
    if match:
        name = match.group(1)
        day = match.group(2).zfill(2)
        month = match.group(3).zfill(2)
        year = match.group(4)
        print(f"Pattern 3: {name}, {day}, {month}, {year}")
        birthdays.append({'name': name, 'day': day, 'month': month, 'year': year})
        continue
    
    # Pattern 4: "Name wurde am DD.MM.YYYY geboren." (German)
    match = re.search(r'-\s*(\w+)\s+wurde\s+am\s+(\d{1,2})\.(\d{1,2})\.(\d{4})\s+geboren\.', line)
    if match:
        name = match.group(1)
        day = match.group(2).zfill(2)
        month = match.group(3).zfill(2)
        year = match.group(4)
        print(f"Pattern 4: {name}, {day}, {month}, {year}")
        birthdays.append({'name': name, 'day': day, 'month': month, 'year': year})
        continue

print(f"\nTotal birthdays found: {len(birthdays)}")

# Calculate ages for those with known years
today = date.today()
current_year = today.year

for bday in birthdays:
    if bday['year']:
        birth_year = int(bday['year'])
        birth_date = date(birth_year, int(bday['month']), int(bday['day']))
        age = current_year - birth_year
        # Adjust if birthday hasn't occurred yet this year
        if (today.month, today.day) < (int(bday['month']), int(bday['day'])):
            age -= 1
        bday['age'] = age
        bday['birth_date'] = f"{bday['day']}.{bday['month']}.{bday['year']}"
    else:
        bday['age'] = None
        bday['birth_date'] = f"{bday['day']}.{bday['month']}."

# Create the storage file
storage_data = {
    "marker": "BDAY-STORAGE-7F3A",
    "imported_from": "birthday_notes.txt",
    "import_date": today.isoformat(),
    "birthdays": birthdays
}

# Write to data directory
with open('/workspace/data/birthdays.json', 'w') as f:
    json.dump(storage_data, f, indent=2)

print("\nBirthdays imported successfully!")
print(json.dumps(storage_data, indent=2))

# Verify against expected names from seed
expected_names = seed_data.get('expected_names', [])
imported_names = [b['name'] for b in birthdays]

print("\nVerification:")
print(f"Expected names: {expected_names}")
print(f"Imported names: {imported_names}")
print(f"All expected names imported: {set(expected_names) == set(imported_names)}")
EOF
