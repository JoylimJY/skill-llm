#!/usr/bin/env python3
"""
Import birthdays from Markdown notes into skill storage.
Normalize entries and prepare reminder data for upcoming birthdays.
"""

import json
import re
from datetime import datetime, date

# Read the notes file
with open('/workspace/notes/birthday_notes.txt', 'r') as f:
    notes_content = f.read()

# Read the seed file for reference
with open('/workspace/data/seed.json', 'r') as f:
    seed_data = json.load(f)

# Extract birthdays from notes
# Patterns for German date formats
birthdays = []

# Parse each line for birthday info
lines = notes_content.split('\n')

# Pattern to extract names and dates
# German: "Name hat am DD. MM. [YYYY] Geburtstag." or "Name wurde am DD.MM.YYYY geboren."
# English: "Name was born on DD.MM.YYYY."

patterns = [
    # "Name hat am DD. MM. [YYYY] Geburtstag."
    r'-(\w+)\s+hat\s+am\s+(\d{1,2})\.\s*(\w+)\.?(?:\s*(\d{4}))?\s+Geburtstag\.',
    # "Name was born on DD.MM.YYYY."
    r'-(\w+)\s+was\s+born\s+on\s+(\d{1,2})\.\s*(\d{1,2})\.\s*(\d{4})\.',
    # "Name wurde am DD.MM.YYYY geboren."
    r'-(\w+)\s+wurde\s+am\s+(\d{1,2})\.(\d{1,2})\.(\d{4})\s+geboren\.',
]

month_map = {
    'januar': '01', 'februar': '02', 'märz': '03', 'april': '04',
    'mai': '05', 'juni': '06', 'juli': '07', 'august': '08',
    'september': '09', 'oktober': '10', 'november': '11', 'dezember': '12'
}

for line in lines:
    for pattern in patterns:
        match = re.search(pattern, line, re.IGNORECASE)
        if match:
            groups = match.groups()
            name = groups[0]
            
            if len(groups) == 4 and groups[2] in month_map:
                # German format: Name, day, month_name, year
                day = groups[1].zfill(2)
                month = month_map[groups[2].lower()]
                year = groups[3] if groups[3] else None
            elif len(groups) == 4:
                # Numeric format: Name, day, month, year
                day = groups[1].zfill(2)
                month = groups[2].zfill(2)
                year = groups[3] if groups[3] else None
            
            birthdays.append({
                'name': name,
                'day': day,
                'month': month,
                'year': year
            })
            break

# Calculate ages for those with known years
today = date.today()
current_year = today.year

for bday in birthdays:
    if bday['year']:
        birth_year = int(bday['year'])
        # Calculate age
        birth_date = date(birth_year, int(bday['month']), int(bday['day']))
        age = current_year - birth_year
        # Adjust if birthday hasn't occurred yet this year
        if (today.month, today.day) < (int(bday['month']), int(bday['day'])):
            age -= 1
        bday['age'] = age
        bday['birth_date'] = f"{bday['day']}.{bday['month']}.{bday['year']}"
    else:
        bday['age'] = None
        bday['birth_date'] = f"{bday['day']}.{bday['month']}."

# Create the storage file
storage_data = {
    "marker": "BDAY-STORAGE-7F3A",
    "imported_from": "birthday_notes.txt",
    "import_date": today.isoformat(),
    "birthdays": birthdays
}

# Write to data directory
with open('/workspace/data/birthdays.json', 'w') as f:
    json.dump(storage_data, f, indent=2)

print("Birthdays imported successfully!")
print(json.dumps(storage_data, indent=2))

# Verify against expected names from seed
expected_names = seed_data.get('expected_names', [])
imported_names = [b['name'] for b in birthdays]

print("\nVerification:")
print(f"Expected names: {expected_names}")
print(f"Imported names: {imported_names}")
print(f"All expected names imported: {set(expected_names) == set(imported_names)}")
EOF
