#!/usr/bin/env python3
"""
Prepare reminder data for upcoming birthdays.
"""

import json
from datetime import date, timedelta

# Read the birthdays storage
with open('/workspace/data/birthdays.json', 'r') as f:
    storage_data = json.load(f)

today = date.today()
current_year = today.year

# Calculate upcoming birthdays
upcoming_birthdays = []
past_birthdays_this_year = []

for bday in storage_data['birthdays']:
    month = int(bday['month'])
    day = int(bday['day'])
    
    # Determine the birthday date for this year or next year
    try:
        birthday_this_year = date(current_year, month, day)
    except ValueError:
        # Handle Feb 29 in non-leap years
        birthday_this_year = date(current_year, 3, 1)
    
    if birthday_this_year < today:
        # Birthday already passed this year, check next year
        birthday_next_year = date(current_year + 1, month, day)
        days_until = (birthday_next_year - today).days
        status = "next_year"
        reminder_date = birthday_next_year
    else:
        days_until = (birthday_this_year - today).days
        status = "this_year"
        reminder_date = birthday_this_year
    
    reminder = {
        'name': bday['name'],
        'birth_date': bday['birth_date'],
        'days_until': days_until,
        'status': status,
        'reminder_date': reminder_date.isoformat(),
        'age': bday.get('age')
    }
    
    if status == "this_year":
        upcoming_birthdays.append(reminder)
    else:
        past_birthdays_this_year.append(reminder)

# Sort by days until
upcoming_birthdays.sort(key=lambda x: x['days_until'])
past_birthdays_this_year.sort(key=lambda x: x['days_until'])

# Create reminders file
reminders_data = {
    "marker": "BDAY-REMINDERS-7F3A",
    "generated_date": today.isoformat(),
    "upcoming_birthdays": upcoming_birthdays,
    "past_birthdays_this_year": past_birthdays_this_year
}

with open('/workspace/data/birthday_reminders.json', 'w') as f:
    json.dump(reminders_data, f, indent=2)

print("=== Upcoming Birthdays ===")
for r in upcoming_birthdays:
    print(f"  {r['name']}: {r['birth_date']} - {r['days_until']} days away (turning {r['age']})")

print("\n=== Past Birthdays This Year ===")
for r in past_birthdays_this_year:
    print(f"  {r['name']}: {r['birth_date']} - {r['days_until']} days until next (turning {r['age']})")

print("\nReminder data saved to /workspace/data/birthday_reminders.json")
