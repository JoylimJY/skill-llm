"""

import json
import re
from datetime import datetime, date

# Read the notes file
with open('/workspace/notes/birthday_notes.txt', 'r') as f:
    notes_content = f.read()

print("=== Raw notes content ===")
print(repr(notes_content))
print()

# Read the seed file for reference
with open('/workspace/data/seed.json', 'r') as f:
    seed_data = json.load(f)

birthdays = []

# Parse each line for birthday info
lines = notes_content.split('\n')

month_map = {
    'januar': '01', 'februar': '02', 'märz': '03', 'april': '04',
    'mai': '05', 'juni': '06', 'juli': '07', 'august': '08',
    'september': '09', 'oktober': '10', 'november': '11', 'dezember': '12'
}

for line in lines:
    print(f"Processing line: {repr(line)}")
    
    # Pattern 1: "Name hat am DD. MM. [YYYY] Geburtstag." (German)
    match = re.search(r'-(\w+)\s+hat\s+am\s+(\d{1,2})\.\s*(\w+)\.?(?:\s*(\d{4}))?\s+Geburtstag\.', line, re.IGNORECASE)
    if match:
        groups = match.groups()
        name = groups[0]
        day = groups[1].zfill(2)
        month = month_map.get(groups[2].lower())
        year = groups[3] if groups[3] else None
        print(f"  Matched pattern 1: {name}, {day}, {month}, {year}")
        birthdays.append({'name': name, 'day': day, 'month': month, 'year': year})
        continue
    
    # Pattern 2: "Name was born on DD.MM.YYYY." (English)
    match = re.search(r'-(\w+)\s+was\s+born\s+on\s+(\d{1,2})\.(\d{1,2})\.(\d{4})\.', line, re.IGNORECASE)
    if match:
        groups = match.groups()
        name = groups[0]
        day = groups[1].zfill(2)
        month = groups[2].zfill(2)
        year = groups[3]
        print(f"  Matched pattern 2: {name}, {day}, {month}, {year}")
        birthdays.append({'name': name, 'day': day, 'month': month, 'year': year})
        continue
    
    # Pattern 3: "Name wurde am DD.MM.YYYY geboren." (German)
    match = re.search(r'-(\w+)\s+wurde\s+am\s+(\d{1,2})\.(\d{1,2})\.(\d{4})\s+geboren\.', line, re.IGNORECASE)
    if match:
        groups = match.groups()
        name = groups[0]
        day = groups[1].zfill(2)
        month = groups[2].zfill(2)
        year = groups[3]
        print(f"  Matched pattern 3: {name}, {day}, {month}, {year}")
        birthdays.append({'name': name, 'day': day, 'month': month, 'year': year})
        continue

print(f"\nTotal birthdays found: {len(birthdays)}")
