cat > /workspace/process_birthdays.py << 'EOF'
import json
from datetime import datetime, date

# Extract birthday data from notes
birthdays = {
    "Valentina": {"day": 14, "month": 2, "year": None},
    "Max": {"day": 15, "month": 3, "year": 1990},
    "Lina": {"day": 29, "month": 2, "year": 2004},
    "Tom": {"day": 1, "month": 12, "year": None}
}

# Current date for age calculation
today = date.today()
current_year = today.year

# Process birthdays and calculate ages
storage_data = {
    "marker": "BDAY-INTAKE-7F3A",
    "imported_at": today.isoformat(),
    "birthdays": []
}

reminder_data = {
    "marker": "BDAY-REMINDER-7F3A",
    "generated_at": today.isoformat(),
    "upcoming_birthdays": [],
    "past_birthdays": []
}

def is_leap_year(year):
    return year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)

def get_birthday_date(name, bday, year):
    """Get the birthday date for a given year, handling Feb 29 edge case."""
    month = bday["month"]
    day = bday["day"]
    
    # Handle Feb 29 (leap year birthdays)
    if month == 2 and day == 29 and not is_leap_year(year):
        # In non-leap years, celebrate on Feb 28 or Mar 1
        # Using Feb 28 as the celebration date
        return date(year, 2, 28)
    
    return date(year, month, day)

for name, bday in birthdays.items():
    entry = {
        "name": name,
        "day": bday["day"],
        "month": bday["month"],
        "year": bday["year"],
        "date_format": f"{bday['day']:02d}.{bday['month']:02d}.{bday['year']}" if bday["year"] else f"{bday['day']:02d}.{bday['month']:02d}."
    }
    
    # Calculate age if year is known
    if bday["year"]:
        age = current_year - bday["year"]
        # Check if birthday has passed this year
        birthday_this_year = get_birthday_date(name, bday, current_year)
        if birthday_this_year < today:
            age -= 1
        entry["age"] = age
    
    storage_data["birthdays"].append(entry)
    
    # Determine if upcoming or past
    birthday_this_year = get_birthday_date(name, bday, current_year)
    days_diff = (birthday_this_year - today).days
    
    if days_diff >= 0:
        reminder_data["upcoming_birthdays"].append({
            "name": name,
            "date": entry["date_format"],
            "days_until": days_diff
        })
    else:
        reminder_data["past_birthdays"].append({
            "name": name,
            "date": entry["date_format"],
            "days_since": abs(days_diff)
        })

# Sort by month/day for better organization
storage_data["birthdays"].sort(key=lambda x: (x["month"], x["day"]))
reminder_data["upcoming_birthdays"].sort(key=lambda x: x["days_until"])
reminder_data["past_birthdays"].sort(key=lambda x: x["days_since"], reverse=True)

# Save output files
with open('/workspace/data/birthdays.json', 'w') as f:
    json.dump(storage_data, f, indent=2)

with open('/workspace/data/birthday_reminders.json', 'w') as f:
    json.dump(reminder_data, f, indent=2)

print("Files created successfully!")
print("\n--- birthdays.json ---")
print(json.dumps(storage_data, indent=2))
print("\n--- birthday_reminders.json ---")
print(json.dumps(reminder_data, indent=2))
