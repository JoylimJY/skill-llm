#!/usr/bin/env python3
import json
import re
from datetime import datetime

# Read the markdown notes
with open('/workspace/notes/birthday_notes.txt', 'r') as f:
    notes_content = f.read()

# Read the seed file to understand expected format
with open('/workspace/data/seed.json', 'r') as f:
    seed = json.load(f)

# Parse birthdays from the notes
# Expected format from notes:
# - Valentina hat am 14. Februar Geburtstag.
# - Max was born on 15.03.1990.
# - Lina wurde am 29.02.2004 geboren.
# - Tom hat am 01.12. Geburtstag.

birthdays = []

# Extract each person's info
lines = notes_content.split('\n')
for line in lines:
    line = line.strip()
    if not line.startswith('- ') or 'MARKER' in line:
        continue
    
    # Extract name (first word after "- ")
    parts = line.split()
    if len(parts) < 2:
        continue
    name = parts[1].rstrip('.')
    
    # Try to extract date in various formats
    # Format 1: DD.MM.YYYY or DD.MM.YY
    date_match = re.search(r'(\d{1,2})\.(\d{1,2})\.(\d{2,4})', line)
    # Format 2: DD. MonthName (German)
    month_match = re.search(r'(\d{1,2})\. (Januar|Februar|März|April|Mai|Juni|Juli|August|September|Oktober|November|Dezember)', line, re.IGNORECASE)
    
    day = None
    month = None
    year = None
    
    if date_match:
        day = int(date_match.group(1))
        month = int(date_match.group(2))
        year_str = date_match.group(3)
        year = int(year_str) if len(year_str) == 4 else None
    elif month_match:
        day = int(month_match.group(1))
        month_name = month_match.group(2)
        month_map = {
            'Januar': 1, 'Februar': 2, 'März': 3, 'April': 4,
            'Mai': 5, 'Juni': 6, 'Juli': 7, 'August': 8,
            'September': 9, 'Oktober': 10, 'November': 11, 'Dezember': 12
        }
        month = month_map.get(month_name)
        year = None
    
    if day and month:
        birthday_entry = {
            'name': name,
            'day': day,
            'month': month,
            'year': year
        }
        birthdays.append(birthday_entry)

# Calculate ages for those with known birth years
current_year = datetime.now().year
for entry in birthdays:
    if entry['year']:
        # Calculate age based on current date
        today = datetime.now()
        birth_date = datetime(entry['year'], entry['month'], entry['day'])
        age = today.year - birth_date.year
        # Adjust if birthday hasn't occurred yet this year
        if (today.month, today.day) < (birth_date.month, birth_date.day):
            age -= 1
        entry['age'] = age

# Save normalized birthdays to JSON
birthdays_output = {
    'marker': 'BDAY-INTAKE-7F3A',
    'birthdays': birthdays
}

with open('/workspace/data/birthdays.json', 'w') as f:
    json.dump(birthdays_output, f, indent=2, ensure_ascii=False)

# Create reminder data for upcoming birthdays
today = datetime.now()
reminders = []

for entry in birthdays:
    # Calculate next birthday
    next_bday = datetime(today.year, entry['month'], entry['day'])
    if next_bday < today:
        next_bday = datetime(today.year + 1, entry['month'], entry['day'])
    
    days_until = (next_bday - today).days
    
    reminder = {
        'name': entry['name'],
        'birthday': f"{entry['day']:02d}.{entry['month']:02d}.{entry['year'] if entry['year'] else ''}",
        'next_birthday': next_bday.strftime('%Y-%m-%d'),
        'days_until': days_until,
        'age': entry.get('age')
    }
    reminders.append(reminder)

# Sort by days until birthday
reminders.sort(key=lambda x: x['days_until'])

reminders_output = {
    'marker': 'BDAY-INTAKE-7F3A',
    'generated_at': today.isoformat(),
    'reminders': reminders
}

with open('/workspace/data/reminders.json', 'w') as f:
    json.dump(reminders_output, f, indent=2, ensure_ascii=False)

print("Birthdays processed and saved to /workspace/data/")
print(f"Found {len(birthdays)} birthdays")
for b in birthdays:
    print(f"  - {b['name']}: {b['day']:02d}.{b['month']:02d}.{b['year'] or '??'} (age: {b.get('age', 'unknown')})")
