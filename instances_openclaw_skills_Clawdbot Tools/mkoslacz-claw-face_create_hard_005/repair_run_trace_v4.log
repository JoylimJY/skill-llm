#!/usr/bin/env python3
"""
ClawFace State Transition Verifier
Uses marker.json to verify correct state transitions occurred
"""

import json
from pathlib import Path

def load_marker(marker_path='inputs/marker.json'):
    with open(marker_path, 'r') as f:
        return json.load(f)

def load_demo_report(report_path='demo_output/demo_report.json'):
    with open(report_path, 'r') as f:
        return json.load(f)

def verify_transitions(marker, report):
    """Verify that state transitions match expected flow"""
    print("=" * 50)
    print("STATE TRANSITION VERIFICATION")
    print("=" * 50)
    
    # Verify marker matches
    if marker['marker'] != report['marker']['marker']:
        print(f"❌ MARKER MISMATCH!")
        return False
    print(f"✓ Marker verified: {marker['marker']}")
    
    # Get unique states in order
    transitions = report['state_transitions']
    unique_states = []
    seen = set()
    for t in transitions:
        if t['state'] not in seen:
            unique_states.append(t['state'])
            seen.add(t['state'])
    
    print(f"\nState transition sequence:")
    for i, state in enumerate(unique_states):
        print(f"  {i+1}. {state}")
    
    # Verify expected flow (robot_mode → thinking → success)
    expected = ['robot_mode', 'thinking', 'success']
    if unique_states == expected:
        print(f"\n✓ All transitions verified correctly!")
        print(f"  Expected: {expected}")
        print(f"  Got:      {unique_states}")
        return True
    else:
        print(f"\n⚠ Transition mismatch:")
        print(f"  Expected: {expected}")
        print(f"  Got:      {unique_states}")
        return False

def main():
    marker = load_marker()
    report = load_demo_report()
    success = verify_transitions(marker, report)
    print("=" * 50)
    return 0 if success else 1

if __name__ == '__main__':
    import sys
    sys.exit(main())
