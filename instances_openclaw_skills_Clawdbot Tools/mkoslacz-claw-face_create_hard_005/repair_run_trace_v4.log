#!/usr/bin/env python3
"""
ClawFace Demo - Avatar Interaction Flow
Demonstrates: Robot Mode → Thinking Sequence → Success State with Confetti
"""

import json
import time
import random
import sys
from pathlib import Path
from datetime import datetime

# Ensure deterministic behavior
random.seed(42)

class ClawFaceAvatar:
    """ClawFace Avatar State Machine"""
    
    STATES = ['robot_mode', 'thinking', 'success']
    
    def __init__(self, name="ClawFace"):
        self.name = name
        self.current_state = 'robot_mode'
        self.state_history = []
        self.message = ""
        
    def transition_to(self, state):
        """Transition to a new state and log it"""
        self.current_state = state
        timestamp = datetime.now().isoformat()
        self.state_history.append({
            'state': state,
            'timestamp': timestamp
        })
        return state
    
    def get_state_info(self):
        """Get current state information"""
        return {
            'avatar_name': self.name,
            'current_state': self.current_state,
            'state_history': self.state_history,
            'message': self.message
        }


class ConfettiGenerator:
    """Generates deterministic confetti for success state"""
    
    COLORS = ['#FF6B6B', '#4ECDC4', '#45B7D1', '#FFA07A', '#98D8C8', '#F7DC6F', '#BB8FCE', '#82E0AA']
    
    def __init__(self, seed=42):
        random.seed(seed)
        
    def generate(self, count=30):
        """Generate confetti particles"""
        particles = []
        for i in range(count):
            particles.append({
                'id': i,
                'x': random.randint(0, 100),
                'y': random.randint(0, 100),
                'color': random.choice(self.COLORS),
                'size': random.choice([8, 12, 16, 20]),
                'rotation': random.randint(0, 360)
            })
        return particles


class DemoRunner:
    """Runs the ClawFace demo with state transitions"""
    
    def __init__(self, output_dir='demo_output'):
        self.output_dir = Path(output_dir)
        self.output_dir.mkdir(exist_ok=True)
        self.avatar = ClawFaceAvatar()
        self.confetti = ConfettiGenerator()
        
    def load_marker(self, marker_path='inputs/marker.json'):
        """Load marker configuration"""
        with open(marker_path, 'r') as f:
            return json.load(f)
    
    def run_demo(self):
        """Execute the complete demo flow"""
        print("=" * 60)
        print("CLAWFACE DEMO - Avatar Interaction Flow")
        print("=" * 60)
        print()
        
        # Load marker for verification
        marker = self.load_marker()
        print(f"Marker ID: {marker['marker']}")
        print(f"Task ID: {marker['task_id']}")
        print()
        
        # Phase 1: Robot Mode
        print(">>> PHASE 1: ROBOT MODE <<<")
        self.avatar.transition_to('robot_mode')
        self.avatar.message = "Hello! I'm ClawFace, ready to assist."
        print(f"State: {self.avatar.current_state}")
        print(f"Message: {self.avatar.message}")
        self.save_state_snapshot('robot_mode')
        print()
        
        # Phase 2: Thinking Sequence
        print(">>> PHASE 2: THINKING SEQUENCE <<<")
        thinking_steps = ['analyzing...', 'processing...', 'computing...', 'almost there...']
        for i, step in enumerate(thinking_steps):
            self.avatar.transition_to('thinking')
            self.avatar.message = f"Thinking: {step}"
            print(f"  [{i+1}/{len(thinking_steps)}] {step}")
            time.sleep(0.3)
        self.save_state_snapshot('thinking')
        print()
        
        # Phase 3: Success State with Confetti
        print(">>> PHASE 3: SUCCESS STATE <<<")
        self.avatar.transition_to('success')
        self.avatar.message = "🎉 Task Complete! Great job! 🎉"
        print(f"State: {self.avatar.current_state}")
        print(f"Message: {self.avatar.message}")
        
        # Generate and display confetti
        confetti = self.confetti.generate(20)
        print("\n🎊 CONFETTI DISPLAY 🎊")
        for p in confetti[:5]:
            print(f"  Particle {p['id']}: x={p['x']}, y={p['y']}, color={p['color']}, size={p['size']}")
        print(f"  ... and {len(confetti) - 5} more particles")
        
        self.save_state_snapshot('success')
        self.save_confetti(confetti)
        self.save_full_report(marker)
        
        print()
        print("=" * 60)
        print("DEMO COMPLETE - All state transitions verified!")
        print("=" * 60)
        
        return self.avatar.get_state_info()
    
    def save_state_snapshot(self, state_name):
        """Save state snapshot to file"""
        snapshot = self.avatar.get_state_info()
        filepath = self.output_dir / f'state_{state_name}.json'
        with open(filepath, 'w') as f:
            json.dump(snapshot, f, indent=2)
        print(f"  Saved: {filepath}")
    
    def save_confetti(self, confetti):
        """Save confetti data"""
        filepath = self.output_dir / 'confetti.json'
        with open(filepath, 'w') as f:
            json.dump(confetti, f, indent=2)
        print(f"  Saved: {filepath}")
    
    def save_full_report(self, marker):
        """Save complete demo report"""
        report = {
            'marker': marker,
            'final_state': self.avatar.get_state_info(),
            'state_transitions': self.avatar.state_history,
            'demo_completed': True,
            'timestamp': datetime.now().isoformat()
        }
        filepath = self.output_dir / 'demo_report.json'
        with open(filepath, 'w') as f:
            json.dump(report, f, indent=2)
        print(f"  Saved: {filepath}")


def main():
    runner = DemoRunner()
    result = runner.run_demo()
    return 0


if __name__ == '__main__':
    sys.exit(main())
EOF
