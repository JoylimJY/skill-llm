#!/usr/bin/env python3
"""
ClawFace Avatar Demo - Deterministic State Transition Demo
This demo shows a complete avatar interaction flow:
  1. Robot mode (initial state)
  2. Thinking sequence (animated state)
  3. Success state with confetti and custom message
"""

import json
import time
import sys
from pathlib import Path
from dataclasses import dataclass, asdict
from typing import List, Dict, Any
from enum import Enum
from datetime import datetime


class AvatarState(Enum):
    """ClawFace avatar states"""
    ROBOT_MODE = "robot_mode"
    THINKING = "thinking"
    SUCCESS = "success"
    IDLE = "idle"


@dataclass
class ConfettiParticle:
    """Confetti particle for success animation"""
    x: float
    y: float
    color: str
    velocity_x: float
    velocity_y: float
    size: float


@dataclass
class AvatarStateOutput:
    """Complete avatar state output with marker"""
    marker: str
    task_id: str
    timestamp: str
    current_state: str
    state_duration_ms: int
    avatar_config: Dict[str, Any]
    animation_params: Dict[str, Any]
    confetti: List[Dict[str, Any]]
    message: str
    state_history: List[str]
    transition_complete: bool


class ClawFaceDemo:
    """ClawFace Avatar Demo Engine"""
    
    def __init__(self, marker_file: Path):
        self.marker_file = marker_file
        self.load_marker_config()
        self.state_history: List[str] = []
        self.confetti_particles: List[ConfettiParticle] = []
        
    def load_marker_config(self):
        """Load marker configuration from input file"""
        with open(self.marker_file, 'r') as f:
            config = json.load(f)
        self.marker = config['marker']
        self.task_id = config['task_id']
        self.expected_flow = config['expected_flow']
        
    def generate_confetti(self, count: int = 50) -> List[Dict[str, Any]]:
        """Generate deterministic confetti particles"""
        colors = ['#FF6B6B', '#4ECDC4', '#45B7D1', '#96CEB4', '#FFEAA7', 
                  '#DDA0DD', '#98D8C8', '#F7DC6F', '#BB8FCE', '#85C1E9']
        particles = []
        
        for i in range(count):
            particle = ConfettiParticle(
                x=(i % 20) * 5.0,
                y=100.0 - (i // 20) * 10.0,
                color=colors[i % len(colors)],
                velocity_x=((i % 7) - 3) * 0.5,
                velocity_y=-((i % 5) + 2) * 1.0,
                size=2.0 + (i % 3) * 0.5
            )
            particles.append(asdict(particle))
            
        return particles
    
    def get_robot_mode_config(self) -> Dict[str, Any]:
        """Robot mode configuration"""
        return {
            "mode": "robot",
            "expression": "neutral",
            "eyes": "glowing_blue",
            "body_pose": "upright",
            "lighting": "ambient_blue",
            "sound_effect": "power_up"
        }
    
    def get_thinking_config(self) -> Dict[str, Any]:
        """Thinking animation configuration"""
        return {
            "mode": "thinking",
            "expression": "contemplative",
            "eyes": "scanning",
            "body_pose": "tilted",
            "lighting": "pulsing_white",
            "animation_loop": "head_bob",
            "sound_effect": "processing"
        }
    
    def get_success_config(self) -> Dict[str, Any]:
        """Success state configuration with confetti"""
        return {
            "mode": "success",
            "expression": "happy",
            "eyes": "sparkling",
            "body_pose": "celebrating",
            "lighting": "bright_golden",
            "animation_loop": "bounce",
            "sound_effect": "cheer"
        }
    
    def run_demo_sequence(self) -> List[AvatarStateOutput]:
        """Run the complete demo sequence"""
        outputs = []
        
        # Step 1: Robot Mode (Initial State)
        print("[ClawFace Demo] Starting in ROBOT MODE...")
        robot_output = AvatarStateOutput(
            marker=self.marker,
            task_id=self.task_id,
            timestamp=datetime.now().isoformat(),
            current_state=AvatarState.ROBOT_MODE.value,
            state_duration_ms=2000,
            avatar_config=self.get_robot_mode_config(),
            animation_params={"fade_in": 0.5, "scale": 1.0},
            confetti=[],
            message="ClawFace Avatar System Ready",
            state_history=["robot_mode"],
            transition_complete=False
        )
        outputs.append(robot_output)
        self.state_history.append("robot_mode")
        time.sleep(0.3)
        
        # Step 2: Thinking Sequence
        print("[ClawFace Demo] Transitioning to THINKING state...")
        thinking_output = AvatarStateOutput(
            marker=self.marker,
            task_id=self.task_id,
            timestamp=datetime.now().isoformat(),
            current_state=AvatarState.THINKING.value,
            state_duration_ms=1500,
            avatar_config=self.get_thinking_config(),
            animation_params={"pulse_speed": 0.8, "head_tilt": 15},
            confetti=[],
            message="Processing request...",
            state_history=["robot_mode", "thinking"],
            transition_complete=False
        )
        outputs.append(thinking_output)
        self.state_history.append("thinking")
        time.sleep(0.3)
        
        # Step 3: Success State with Confetti
        print("[ClawFace Demo] Transitioning to SUCCESS state with confetti!")
        confetti = self.generate_confetti(50)
        success_output = AvatarStateOutput(
            marker=self.marker,
            task_id=self.task_id,
            timestamp=datetime.now().isoformat(),
            current_state=AvatarState.SUCCESS.value,
            state_duration_ms=3000,
            avatar_config=self.get_success_config(),
            animation_params={"bounce_height": 0.3, "sparkle_rate": 0.2},
            confetti=confetti,
            message="🎉 Operation Complete! Mission Accomplished! 🎉",
            state_history=["robot_mode", "thinking", "success"],
            transition_complete=True
        )
        outputs.append(success_output)
        self.state_history.append("success")
        
        return outputs
    
    def save_outputs(self, outputs: List[AvatarStateOutput], output_file: Path):
        """Save demo outputs to JSON file"""
        data = {
            "marker": self.marker,
            "task_id": self.task_id,
            "demo_name": "ClawFace Avatar Interaction Demo",
            "generated_at": datetime.now().isoformat(),
            "state_transitions": [asdict(o) for o in outputs],
            "final_state_history": self.state_history,
            "verification": {
                "expected_flow": self.expected_flow,
                "actual_flow": self.state_history,
                "flow_match": self.state_history[-3:] == self.expected_flow
            }
        }
        
        with open(output_file, 'w') as f:
            json.dump(data, f, indent=2)
        print(f"[ClawFace Demo] Output saved to: {output_file}")


def main():
    """Main entry point for ClawFace Demo"""
    workspace = Path("/workspace")
    marker_file = workspace / "inputs" / "marker.json"
    output_file = workspace / "clawface_demo_output.json"
    
    print("=" * 60)
    print("   CLAWFACE AVATAR DEMO - State Transition Demo")
    print("=" * 60)
    
    demo = ClawFaceDemo(marker_file)
    outputs = demo.run_demo_sequence()
    demo.save_outputs(outputs, output_file)
    
    print("\n" + "=" * 60)
    print("   DEMO COMPLETE")
    print("=" * 60)
    print(f"Marker: {demo.marker}")
    print(f"State Flow: {' -> '.join(demo.state_history)}")
    print(f"Confetti Particles Generated: {len(outputs[-1].confetti)}")
    print("=" * 60)


if __name__ == "__main__":
    main()
EOF

