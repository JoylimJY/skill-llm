import json
from pathlib import Path

script = r'''#!/usr/bin/env python3
"""
ClawFace Avatar Demo - Deterministic State Transition Demo
"""

import json
import time
from pathlib import Path
from dataclasses import dataclass, asdict
from typing import List, Dict, Any
from datetime import datetime


@dataclass
class ConfettiParticle:
    x: float
    y: float
    color: str
    velocity_x: float
    velocity_y: float
    size: float


@dataclass
class AvatarStateOutput:
    marker: str
    task_id: str
    timestamp: str
    current_state: str
    state_duration_ms: int
    avatar_config: Dict[str, Any]
    animation_params: Dict[str, Any]
    confetti: List[Dict[str, Any]]
    message: str
    state_history: List[str]
    transition_complete: bool


class ClawFaceDemo:
    def __init__(self, marker_file: Path):
        self.marker_file = marker_file
        self.load_marker_config()
        self.state_history: List[str] = []
        
    def load_marker_config(self):
        with open(self.marker_file, 'r') as f:
            config = json.load(f)
        self.marker = config['marker']
        self.task_id = config['task_id']
        self.expected_flow = config['expected_flow']
        
    def generate_confetti(self, count: int = 50) -> List[Dict[str, Any]]:
        colors = ['#FF6B6B', '#4ECDC4', '#45B7D1', '#96CEB4', '#FFEAA7', 
                  '#DDA0DD', '#98D8C8', '#F7DC6F', '#BB8FCE', '#85C1E9']
        particles = []
        for i in range(count):
            particle = ConfettiParticle(
                x=(i % 20) * 5.0,
                y=100.0 - (i // 20) * 10.0,
                color=colors[i % len(colors)],
                velocity_x=((i % 7) - 3) * 0.5,
                velocity_y=-((i % 5) + 2) * 1.0,
                size=2.0 + (i % 3) * 0.5
            )
            particles.append(asdict(particle))
        return particles
    
    def get_robot_mode_config(self):
        return {"mode": "robot", "expression": "neutral", "eyes": "glowing_blue",
                "body_pose": "upright", "lighting": "ambient_blue", "sound_effect": "power_up"}
    
    def get_thinking_config(self):
        return {"mode": "thinking", "expression": "contemplative", "eyes": "scanning",
                "body_pose": "tilted", "lighting": "pulsing_white",
                "animation_loop": "head_bob", "sound_effect": "processing"}
    
    def get_speaking_config(self):
        return {"mode": "speaking", "expression": "friendly", "eyes": "engaging",
                "body_pose": "gesturing", "lighting": "warm_gold",
                "animation_loop": "mouth_sync", "sound_effect": "voice_output"}
    
    def get_idle_config(self):
        return {"mode": "idle", "expression": "happy", "eyes": "sparkling",
                "body_pose": "relaxed", "lighting": "bright_golden",
                "animation_loop": "gentle_breath", "sound_effect": "soft_chime"}
    
    def run_demo_sequence(self) -> List[AvatarStateOutput]:
        outputs = []
        print("[ClawFace Demo] Starting in ROBOT MODE...")
        robot_output = AvatarStateOutput(
            marker=self.marker, task_id=self.task_id,
            timestamp=datetime.now().isoformat(), current_state="robot_mode",
            state_duration_ms=2000, avatar_config=self.get_robot_mode_config(),
            animation_params={"fade_in": 0.5, "scale": 1.0}, confetti=[],
            message="ClawFace Avatar System Ready",
            state_history=["robot_mode"], transition_complete=False
        )
        outputs.append(robot_output)
        self.state_history.append("robot_mode")
        time.sleep(0.2)
        
        for i, state_name in enumerate(self.expected_flow):
            print(f"[ClawFace Demo] Transitioning to {state_name.upper()} state...")
            is_last = i == len(self.expected_flow) - 1
            
            if state_name == "thinking":
                cfg = self.get_thinking_config()
                msg = "Processing request..."
                anim = {"pulse_speed": 0.8, "head_tilt": 15}
                confetti = []
            elif state_name == "speaking":
                cfg = self.get_speaking_config()
                msg = "Delivering response..."
                anim = {"mouth_speed": 1.0, "gesture_amplitude": 0.5}
                confetti = []
            elif state_name == "idle":
                cfg = self.get_idle_config()
                msg = "Operation Complete! Mission Accomplished!"
                anim = {"breath_rate": 0.3, "sparkle_rate": 0.2}
                confetti = self.generate_confetti(50)
            else:
                cfg = {"mode": state_name, "expression": "neutral"}
                msg = f"State: {state_name}"
                anim = {}
                confetti = []
            
            state_output = AvatarStateOutput(
                marker=self.marker, task_id=self.task_id,
                timestamp=datetime.now().isoformat(), current_state=state_name,
                state_duration_ms=1500 if not is_last else 3000,
                avatar_config=cfg, animation_params=anim, confetti=confetti,
                message=msg, state_history=self.state_history + [state_name],
                transition_complete=is_last
            )
            outputs.append(state_output)
            self.state_history.append(state_name)
            time.sleep(0.2)
        
        return outputs
    
    def save_outputs(self, outputs: List[AvatarStateOutput], output_file: Path):
        data = {
            "marker": self.marker, "task_id": self.task_id,
            "demo_name": "ClawFace Avatar Interaction Demo",
            "generated_at": datetime.now().isoformat(),
            "state_transitions": [asdict(o) for o in outputs],
            "final_state_history": self.state_history,
            "verification": {
                "expected_flow": self.expected_flow,
                "actual_flow": self.state_history[1:],
                "flow_match": self.state_history[1:] == self.expected_flow
            }
        }
        with open(output_file, 'w') as f:
            json.dump(data, f, indent=2)
        print(f"[ClawFace Demo] Output saved to: {output_file}")


def main():
    workspace = Path("/workspace")
    marker_file = workspace / "inputs" / "marker.json"
    output_file = workspace / "clawface_demo_output.json"
    
    print("=" * 60)
    print("   CLAWFACE AVATAR DEMO - State Transition Demo")
    print("=" * 60)
    
    demo = ClawFaceDemo(marker_file)
    outputs = demo.run_demo_sequence()
    demo.save_outputs(outputs, output_file)
    
    print("\n" + "=" * 60)
    print("   DEMO COMPLETE")
    print("=" * 60)
    print(f"Marker: {demo.marker}")
    print(f"State Flow: {' -> '.join(demo.state_history)}")
    print(f"Confetti Particles: {len(outputs[-1].confetti)}")
    print("=" * 60)


if __name__ == "__main__":
    main()
'''

Path("/workspace/clawface_demo.py").write_text(script)
print("Script written successfully")

