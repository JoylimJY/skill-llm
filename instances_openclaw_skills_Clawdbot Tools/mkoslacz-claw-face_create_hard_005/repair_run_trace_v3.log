#!/usr/bin/env python3
"""
ClawFace Avatar Demo - Shared Linux Workstation
Demonstrates avatar state transitions: robot -> thinking -> success with confetti
"""

import json
import time
import sys
from pathlib import Path
from dataclasses import dataclass, asdict
from typing import List, Dict, Any
from datetime import datetime

@dataclass
class AvatarState:
    """Represents the current state of the ClawFace avatar"""
    state: str
    timestamp: str
    emotion: str
    expression: str
    is_thinking: bool
    is_speaking: bool
    has_confetti: bool
    message: str
    transition_from: str

class ClawFaceAvatar:
    """ClawFace Avatar Controller for deterministic demo"""
    
    STATE_ROBOT = "robot"
    STATE_THINKING = "thinking"
    STATE_SUCCESS = "success"
    
    def __init__(self, marker_data: Dict[str, Any]):
        self.marker_data = marker_data
        self.current_state = self.STATE_ROBOT
        self.state_history: List[AvatarState] = []
        self._init_robot_state()
    
    def _init_robot_state(self):
        """Initialize avatar in robot mode"""
        state = AvatarState(
            state=self.STATE_ROBOT,
            timestamp=datetime.now().isoformat(),
            emotion="neutral",
            expression="robotic_gaze",
            is_thinking=False,
            is_speaking=False,
            has_confetti=False,
            message="System initialized. Ready for interaction.",
            transition_from="none"
        )
        self.state_history.append(state)
        return state
    
    def transition_to_thinking(self, duration_seconds: int = 2) -> AvatarState:
        """Transition to thinking state with visual indicators"""
        state = AvatarState(
            state=self.STATE_THINKING,
            timestamp=datetime.now().isoformat(),
            emotion="contemplative",
            expression="processing_gaze",
            is_thinking=True,
            is_speaking=False,
            has_confetti=False,
            message="Processing request...",
            transition_from=self.current_state
        )
        self.current_state = self.STATE_THINKING
        self.state_history.append(state)
        return state
    
    def transition_to_success(self, custom_message: str) -> AvatarState:
        """Transition to success state with confetti"""
        state = AvatarState(
            state=self.STATE_SUCCESS,
            timestamp=datetime.now().isoformat(),
            emotion="joyful",
            expression="celebratory_smile",
            is_thinking=False,
            is_speaking=True,
            has_confetti=True,
            message=custom_message,
            transition_from=self.current_state
        )
        self.current_state = self.STATE_SUCCESS
        self.state_history.append(state)
        return state
    
    def run_demo_flow(self) -> List[Dict[str, Any]]:
        """Run the complete demo flow with deterministic timing"""
        print("=" * 60)
        print("ClawFace Avatar Demo - Starting Interaction Flow")
        print("=" * 60)
        print(f"Marker: {self.marker_data.get('marker', 'N/A')}")
        print(f"Task ID: {self.marker_data.get('task_id', 'N/A')}")
        print()
        
        # Phase 1: Robot Mode
        print("[PHASE 1] ROBOT MODE")
        robot_state = self.state_history[0]
        print(f"  State: {robot_state.state}")
        print(f"  Message: {robot_state.message}")
        print(f"  Expression: {robot_state.expression}")
        print()
        
        # Simulate processing delay
        time.sleep(0.5)
        
        # Phase 2: Thinking Sequence
        print("[PHASE 2] THINKING SEQUENCE")
        thinking_state = self.transition_to_thinking()
        print(f"  State: {thinking_state.state}")
        print(f"  Message: {thinking_state.message}")
        print(f"  Is Thinking: {thinking_state.is_thinking}")
        
        # Simulate thinking delay (deterministic)
        time.sleep(1.0)
        
        # Phase 3: Success with Confetti
        print("[PHASE 3] SUCCESS STATE")
        success_state = self.transition_to_success(
            "🎉 Demo completed successfully! All systems operational! 🎉"
        )
        print(f"  State: {success_state.state}")
        print(f"  Message: {success_state.message}")
        print(f"  Confetti Active: {success_state.has_confetti}")
        print(f"  Expression: {success_state.expression}")
        print()
        
        print("=" * 60)
        print("Demo Flow Complete")
        print("=" * 60)
        
        return [asdict(s) for s in self.state_history]

def verify_state_transitions(state_history: List[Dict], expected_flow: List[str]) -> bool:
    """Verify that state transitions match expected flow"""
    actual_states = [s['state'] for s in state_history]
    
    # Check if expected flow is contained in actual states
    for i, expected in enumerate(expected_flow):
        if expected not in actual_states:
            print(f"❌ FAIL: Expected state '{expected}' not found")
            return False
    
    print(f"✅ State transition verification PASSED")
    print(f"   Expected: {expected_flow}")
    print(f"   Actual: {actual_states}")
    return True

def main():
    """Main entry point for ClawFace demo"""
    # Load marker data
    marker_path = Path('/workspace/inputs/marker.json')
    if not marker_path.exists():
        print("Error: marker.json not found at /workspace/inputs/marker.json")
        sys.exit(1)
    
    marker_data = json.loads(marker_path.read_text())
    print(f"Loaded marker: {marker_data.get('marker', 'N/A')}")
    print()
    
    # Create avatar and run demo
    avatar = ClawFaceAvatar(marker_data)
    state_history = avatar.run_demo_flow()
    
    # Save state history to output file
    output_path = Path('/workspace/demo_output/avatar_state_history.json')
    output_data = {
        'marker': marker_data.get('marker'),
        'task_id': marker_data.get('task_id'),
        'demo_timestamp': datetime.now().isoformat(),
        'state_history': state_history,
        'final_state': state_history[-1]['state'] if state_history else None
    }
    output_path.write_text(json.dumps(output_data, indent=2), encoding='utf-8')
    print(f"\nState history saved to: {output_path}")
    
    # Verify state transitions
    expected_flow = marker_data.get('expected_flow', ['thinking', 'speaking', 'idle'])
    print("\n[VERIFICATION]")
    verify_state_transitions(state_history, expected_flow)
    
    return 0

if __name__ == '__main__':
    sys.exit(main())
EOF
