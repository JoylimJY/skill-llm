#!/usr/bin/env python3
"""
ClawFace Demo - Avatar Interaction Flow
Demonstrates: Robot Mode → Thinking → Success (with confetti)
"""

import json
import time
import os
from datetime import datetime
from pathlib import Path

# Configuration
WORKSPACE = Path('/workspace')
OUTPUT_DIR = WORKSPACE / 'demo_output'
MARKER_FILE = WORKSPACE / 'inputs' / 'marker.json'

# Avatar States
ROBOT_MODE = {
    "state": "robot",
    "expression": "neutral",
    "eyes": "glowing",
    "message": "System initialized. Ready for interaction.",
    "timestamp": None
}

THINKING_STATE = {
    "state": "thinking",
    "expression": "focused",
    "eyes": "processing",
    "message": "Processing request...",
    "progress": 0,
    "timestamp": None
}

SUCCESS_STATE = {
    "state": "success",
    "expression": "happy",
    "eyes": "sparkling",
    "message": "Task completed successfully!",
    "effects": ["confetti"],
    "timestamp": None
}

IDLE_STATE = {
    "state": "idle",
    "expression": "calm",
    "eyes": "normal",
    "message": "Standing by...",
    "timestamp": None
}


def load_marker():
    """Load marker configuration from input file."""
    with open(MARKER_FILE, 'r') as f:
        return json.load(f)


def get_timestamp():
    """Get deterministic timestamp for demo."""
    return datetime.now().isoformat()


def simulate_thinking_sequence(duration=3, steps=5):
    """Simulate a thinking sequence with progress updates."""
    print("\n🤖 [THINKING] Processing...")
    states = []
    
    for i in range(steps + 1):
        progress = int((i / steps) * 100)
        state = THINKING_STATE.copy()
        state['progress'] = progress
        state['timestamp'] = get_timestamp()
        states.append(state)
        
        bar = '█' * (progress // 10) + '░' * (10 - progress // 10)
        print(f"  Progress: [{bar}] {progress}%")
        
        time.sleep(duration / steps)
    
    return states


def create_confetti_config():
    """Create confetti configuration for success state."""
    return {
        "enabled": True,
        "particles": 100,
        "colors": ["#FFD700", "#FF6B6B", "#4ECDC4", "#45B7D1", "#96CEB4"],
        "duration": 3.0,
        "gravity": 0.5,
        "velocity": {"min": 2, "max": 5}
    }


def run_demo():
    """Execute the complete ClawFace demo flow."""
    print("=" * 60)
    print("🦾 CLAWFACE DEMO - Avatar Interaction Flow")
    print("=" * 60)
    
    marker = load_marker()
    print(f"\n📋 Marker: {marker['marker']}")
    print(f"📋 Task ID: {marker['task_id']}")
    print(f"📋 Expected Flow: {' → '.join(marker['expected_flow'])}")
    
    OUTPUT_DIR.mkdir(exist_ok=True)
    
    all_states = []
    
    # Phase 1: Robot Mode
    print("\n" + "=" * 40)
    print("PHASE 1: ROBOT MODE (Initial State)")
    print("=" * 40)
    robot_state = ROBOT_MODE.copy()
    robot_state['timestamp'] = get_timestamp()
    robot_state['marker'] = marker['marker']
    all_states.append(robot_state)
    print(f"🤖 State: {robot_state['state']}")
    print(f"💬 Message: {robot_state['message']}")
    print(f"👁️ Eyes: {robot_state['eyes']}")
    time.sleep(1)
    
    # Phase 2: Thinking Sequence
    print("\n" + "=" * 40)
    print("PHASE 2: THINKING SEQUENCE")
    print("=" * 40)
    thinking_states = simulate_thinking_sequence(duration=2, steps=4)
    for ts in thinking_states:
        ts['marker'] = marker['marker']
        all_states.append(ts)
    
    # Phase 3: Success State with Confetti
    print("\n" + "=" * 40)
    print("PHASE 3: SUCCESS STATE (with Confetti)")
    print("=" * 40)
    success_state = SUCCESS_STATE.copy()
    success_state['timestamp'] = get_timestamp()
    success_state['marker'] = marker['marker']
    success_state['custom_message'] = "🎉 Demo completed successfully! 🎉"
    all_states.append(success_state)
    
    print(f"✨ State: {success_state['state']}")
    print(f"💬 Message: {success_state['custom_message']}")
    print(f"🎨 Effects: {', '.join(success_state['effects'])}")
    
    confetti_config = create_confetti_config()
    print(f"🎊 Confetti: {confetti_config['particles']} particles ready!")
    print("🎊 Colors: " + ', '.join(confetti_config['colors'][:3]) + "...")
    time.sleep(1.5)
    
    # Phase 4: Return to Idle
    print("\n" + "=" * 40)
    print("PHASE 4: RETURN TO IDLE")
    print("=" * 40)
    idle_state = IDLE_STATE.copy()
    idle_state['timestamp'] = get_timestamp()
    idle_state['marker'] = marker['marker']
    all_states.append(idle_state)
    print(f"🌙 State: {idle_state['state']}")
    print(f"💬 Message: {idle_state['message']}")
    
    save_outputs(all_states, confetti_config, marker)
    
    print("\n" + "=" * 60)
    print("✅ DEMO COMPLETE - All states recorded successfully!")
    print("=" * 60)
    
    return all_states


def save_outputs(states, confetti_config, marker):
    """Save all output files for verification."""
    
    output_file = OUTPUT_DIR / 'avatar_states.json'
    with open(output_file, 'w') as f:
        json.dump({
            'marker': marker['marker'],
            'task_id': marker['task_id'],
            'total_states': len(states),
            'states': states
        }, f, indent=2)
    print(f"\n💾 Saved: {output_file}")
    
    confetti_file = OUTPUT_DIR / 'confetti_config.json'
    with open(confetti_file, 'w') as f:
        json.dump(confetti_config, f, indent=2)
    print(f"💾 Saved: {confetti_file}")
    
    summary = {
        'marker': marker['marker'],
        'task_id': marker['task_id'],
        'flow_completed': True,
        'states_visited': list(set(s['state'] for s in states)),
        'confetti_enabled': True,
        'custom_message': states[-3].get('custom_message', ''),
        'execution_time': get_timestamp()
    }
    summary_file = OUTPUT_DIR / 'demo_summary.json'
    with open(summary_file, 'w') as f:
        json.dump(summary, f, indent=2)
    print(f"💾 Saved: {summary_file}")


if __name__ == '__main__':
    run_demo()
EOF

