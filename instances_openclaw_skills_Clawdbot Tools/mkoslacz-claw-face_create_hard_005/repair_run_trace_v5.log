#!/usr/bin/env python3
"""
ClawFace Avatar Demo - Deterministic State Flow
Demonstrates: Robot Mode → Thinking Sequence → Success with Confetti
"""

import json
import time
import sys
from pathlib import Path

# Demo configuration
DEMO_CONFIG = {
    "marker": "CLAWFACE_DETERMINISTIC_MARKER_7F3A",
    "task_id": "clawface-hard-demo-001",
    "states": {
        "robot_mode": {
            "avatar_state": "robot",
            "expression": "neutral",
            "animation": "idle_robot",
            "duration_ms": 1000
        },
        "thinking": {
            "avatar_state": "thinking",
            "expression": "contemplative",
            "animation": "head_tilt_pulse",
            "duration_ms": 2000,
            "particles": ["sparkles"]
        },
        "success": {
            "avatar_state": "success",
            "expression": "happy",
            "animation": "bounce_celebrate",
            "duration_ms": 3000,
            "particles": ["confetti", "stars"],
            "message": "Mission Accomplished! 🎉"
        }
    },
    "flow_sequence": ["robot_mode", "thinking", "success"]
}

class ClawFaceDemo:
    """Deterministic ClawFace avatar state machine for demo."""
    
    def __init__(self, config: dict, output_dir: Path):
        self.config = config
        self.output_dir = output_dir
        self.state_log = []
        self.marker = config["marker"]
        
    def log_state(self, state_name: str, state_data: dict):
        """Log state transition for verification."""
        entry = {
            "marker": self.marker,
            "timestamp_seq": len(self.state_log),
            "state": state_name,
            "data": state_data
        }
        self.state_log.append(entry)
        return entry
    
    def run_robot_mode(self) -> dict:
        """Initialize avatar in robot mode."""
        state_data = self.config["states"]["robot_mode"].copy()
        state_data["transition_from"] = None
        state_data["transition_to"] = "robot_mode"
        print(f"[ROBOT MODE] Avatar initialized - {state_data['expression']} expression")
        return self.log_state("robot_mode", state_data)
    
    def run_thinking_sequence(self) -> dict:
        """Execute thinking animation sequence."""
        state_data = self.config["states"]["thinking"].copy()
        state_data["transition_from"] = "robot_mode"
        state_data["transition_to"] = "thinking"
        print(f"[THINKING] Processing... {', '.join(state_data['particles'])} particles active")
        return self.log_state("thinking", state_data)
    
    def run_success_with_confetti(self) -> dict:
        """Execute success state with confetti and custom message."""
        state_data = self.config["states"]["success"].copy()
        state_data["transition_from"] = "thinking"
        state_data["transition_to"] = "success"
        print(f"[SUCCESS] {state_data['message']}")
        print(f"         Confetti: {', '.join(state_data['particles'])}")
        return self.log_state("success", state_data)
    
    def run_demo(self) -> dict:
        """Execute complete demo flow."""
        print("=" * 50)
        print(f"ClawFace Demo - Marker: {self.marker}")
        print("=" * 50)
        
        # Execute state transitions
        self.run_robot_mode()
        self.run_thinking_sequence()
        self.run_success_with_confetti()
        
        print("=" * 50)
        print("Demo completed successfully!")
        print("=" * 50)
        
        return {
            "marker": self.marker,
            "task_id": self.config["task_id"],
            "flow_completed": True,
            "state_log": self.state_log
        }
    
    def save_results(self, results: dict):
        """Save demo results to output files."""
        # Save state log
        log_path = self.output_dir / "state_transitions.json"
        with open(log_path, 'w') as f:
            json.dump(results["state_log"], f, indent=2)
        print(f"Saved state transitions to: {log_path}")
        
        # Save verification summary
        summary_path = self.output_dir / "demo_summary.json"
        with open(summary_path, 'w') as f:
            json.dump({
                "marker": results["marker"],
                "task_id": results["task_id"],
                "flow_completed": results["flow_completed"],
                "states_visited": [entry["state"] for entry in results["state_log"]],
                "total_states": len(results["state_log"])
            }, f, indent=2)
        print(f"Saved demo summary to: {summary_path}")


def main():
    """Main entry point for ClawFace demo."""
    output_dir = Path(__file__).parent
    config = DEMO_CONFIG
    
    demo = ClawFaceDemo(config, output_dir)
    results = demo.run_demo()
    demo.save_results(results)
    
    return 0


if __name__ == "__main__":
    sys.exit(main())
EOF
