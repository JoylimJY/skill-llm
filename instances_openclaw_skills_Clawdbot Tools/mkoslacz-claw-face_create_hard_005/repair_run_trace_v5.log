#!/usr/bin/env python3
"""
Verification script for ClawFace demo state transitions.
Validates marker consistency and expected flow.
"""

import json
import sys
from pathlib import Path

def verify_demo(input_marker_path: str, state_log_path: str) -> bool:
    """Verify demo outputs match expected flow."""
    
    # Load input marker
    with open(input_marker_path) as f:
        marker_config = json.load(f)
    
    # Load state transitions
    with open(state_log_path) as f:
        state_log = json.load(f)
    
    marker = marker_config["marker"]
    expected_flow = marker_config["expected_flow"]
    
    print(f"Verifying ClawFace Demo - Marker: {marker}")
    print("-" * 50)
    
    # Check 1: Marker consistency
    all_markers_match = all(entry["marker"] == marker for entry in state_log)
    print(f"✓ Marker consistency: {'PASS' if all_markers_match else 'FAIL'}")
    
    # Check 2: State flow
    actual_flow = [entry["state"] for entry in state_log]
    flow_match = actual_flow == expected_flow
    print(f"✓ State flow: {'PASS' if flow_match else 'FAIL'}")
    print(f"  Expected: {expected_flow}")
    print(f"  Actual:   {actual_flow}")
    
    # Check 3: Transition consistency
    transitions_valid = True
    for i, entry in enumerate(state_log):
        if i > 0:
            prev_state = state_log[i-1]["state"]
            expected_from = prev_state
            actual_from = entry["data"]["transition_from"]
            if actual_from != expected_from:
                transitions_valid = False
                print(f"  Invalid transition at {entry['state']}: expected from {expected_from}, got {actual_from}")
    print(f"✓ Transition consistency: {'PASS' if transitions_valid else 'FAIL'}")
    
    # Check 4: Confetti in success state
    success_entry = next((e for e in state_log if e["state"] == "success"), None)
    has_confetti = success_entry and "confetti" in success_entry["data"].get("particles", [])
    print(f"✓ Confetti in success: {'PASS' if has_confetti else 'FAIL'}")
    
    # Check 5: Custom message
    has_message = success_entry and "message" in success_entry["data"]
    print(f"✓ Custom message: {'PASS' if has_message else 'FAIL'}")
    if has_message:
        print(f"  Message: {success_entry['data']['message']}")
    
    all_pass = all_markers_match and flow_match and transitions_valid and has_confetti and has_message
    print("-" * 50)
    print(f"VERIFICATION: {'ALL TESTS PASSED' if all_pass else 'SOME TESTS FAILED'}")
    
    return all_pass


def main():
    """Run verification."""
    base = Path(__file__).parent
    marker_path = base / "input_marker.json"
    state_log_path = base / "state_transitions.json"
    
    success = verify_demo(marker_path, state_log_path)
    return 0 if success else 1


if __name__ == "__main__":
    sys.exit(main())
EOF
