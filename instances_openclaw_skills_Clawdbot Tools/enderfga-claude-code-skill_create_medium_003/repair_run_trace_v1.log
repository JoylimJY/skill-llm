  console.log(`Available tools: ${before.toolCount}`);
  
  console.log('\n--- Initializing MCP System ---');
  const initialized = initializeMCP(config);
  console.log(`Initialized servers: ${initialized.serverIds.join(', ')}`);
  console.log(`Total tools registered: ${initialized.toolCount}`);
  
  console.log('\n--- After MCP Startup ---');
  const after = verifyToolsAfterStartup(config);
  console.log(`Active servers: ${after.serverIds.join(', ')}`);
  console.log(`Available tools: ${after.toolCount}`);
  
  const finalState = runStatePersistenceDemo();
  
  const summary = {
    task_id: 'mcp-demo-001',
    marker: 'OPENCLAW_MARKER_7f3c2a',
    active_server_ids: after.serverIds,
    tool_count: after.toolCount,
    state_persistence: {
      counter: finalState.counter,
      items_count: finalState.items.length,
      last_item: finalState.items[finalState.items.length - 1]
    },
    timestamp: new Date().toISOString()
  };
  
  fs.writeFileSync(OUTPUT_FILE, JSON.stringify(summary, null, 2));
  console.log('\n--- Summary Written ---');
  console.log(`Output file: ${OUTPUT_FILE}`);
  console.log('Summary:', JSON.stringify(summary, null, 2));
}

main();
