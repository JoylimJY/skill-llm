[EXECUTING bash]:
cat > /workspace/demo.mjs << 'EOF'
import { Client } from "@modelcontextprotocol/sdk/client/index.js";
import { StdioClientTransport } from "@modelcontextprotocol/sdk/client/stdio.js";
import fs from "fs";
import path from "path";
import { fileURLToPath } from "url";

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const CONFIG_PATH = path.join(__dirname, "mcp_config.json");
const OUTPUT_PATH = path.join(__dirname, "output", "mcp_summary.json");
const PERSIST_PATH = path.join(__dirname, "output", "persistence_store.json");

// Load config
const config = JSON.parse(fs.readFileSync(CONFIG_PATH, "utf-8"));
console.log("=== MCP Demo: OpenClaw Claude Code Skill ===\n");
console.log("Config loaded:", CONFIG_PATH);

// State persistence demo
function loadPersistence() {
  try {
    return JSON.parse(fs.readFileSync(PERSIST_PATH, "utf-8"));
  } catch {
    return { counter: 0, items: [] };
  }
}

function savePersistence(data) {
  fs.writeFileSync(PERSIST_PATH, JSON.stringify(data, null, 2));
}

// Verify tools before startup (simulated - no server running yet)
console.log("\n--- Before MCP Server Startup ---");
console.log("Active servers: 0");
console.log("Available tools: 0");
let toolsBefore = [];

// Initialize MCP with filesystem server
async function initMCP() {
  const serverConfig = config.mcpServers.filesystem;
  console.log("\n--- Starting MCP Server ---");
  console.log("Server ID:", "filesystem");
  console.log("Command:", serverConfig.command);
  console.log("Args:", serverConfig.args.join(" "));

  const transport = new StdioClientTransport({
    command: serverConfig.command,
    args: serverConfig.args,
  });

  const client = new Client(
    {
      name: "mcp-demo-client",
      version: "1.0.0",
    },
    {
      capabilities: {},
    }
  );

  await client.connect(transport);
  console.log("MCP Client connected successfully");

  // List available tools
  const tools = await client.listTools();
  console.log("\n--- After MCP Server Startup ---");
  console.log("Active servers: 1");
  console.log("Server ID: filesystem");
  console.log("Available tools:", tools.tools.length);

  return {
    serverId: "filesystem",
    tools: tools.tools.map(t => t.name),
  };
}

// Main execution
(async () => {
  try {
    const result = await initMCP();
    toolsBefore = result.tools;

    // State persistence demo - write counter and item
    console.log("\n--- State Persistence Demo ---");
    let persistence = loadPersistence();
    console.log("Loaded persistence state:", JSON.stringify(persistence));

    // Increment counter
    persistence.counter = persistence.counter + 1;
    console.log("Counter incremented to:", persistence.counter);

    // Add an item
    persistence.items.push({
      id: Date.now(),
      name: "demo-item",
      timestamp: new Date().toISOString(),
    });
    console.log("Added item:", persistence.items[persistence.items.length - 1]);

    // Save persistence
    savePersistence(persistence);
    console.log("Persistence saved to:", PERSIST_PATH);

    // Write summary output
    const summary = {
      timestamp: new Date().isoString(),
      activeServers: [result.serverId],
      toolCount: toolsBefore.length,
      tools: toolsBefore,
      persistence: {
        counter: persistence.counter,
        itemsCount: persistence.items.length,
      },
    };

    // Fix ISO string
    summary.timestamp = new Date().toISOString();

    fs.mkdirSync(path.dirname(OUTPUT_PATH), { recursive: true });
    fs.writeFileSync(OUTPUT_PATH, JSON.stringify(summary, null, 2));
    console.log("\n--- Summary written to ---");
    console.log(OUTPUT_PATH);

    console.log("\n=== Demo Complete ===");
    console.log("Active server IDs:", summary.activeServers);
    console.log("Tool count:", summary.toolCount);
    console.log("Tools:", summary.tools);

  } catch (error) {
    console.error("Error:", error.message);
    process.exit(1);
  }
})();
EOF

