    registry = json.load(f)

# Update the main agent to include sap-helper in can_assign_to
for agent in registry['agents']:
    if agent['id'] == 'main':
        agent['can_assign_to'].append('sap-helper')
        agent['agent_card']['routing']['can_assign_to'].append('sap-helper')

# Add the new sap-helper agent
sap_helper_agent = {
    "id": "sap-helper",
    "name": "SAP Helper",
    "model": "glm-4.7",
    "reports_to": {
        "type": "human",
        "target": "Ilkerkaan"
    },
    "can_assign_to": [],
