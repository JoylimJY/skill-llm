        "capabilities": [
            "SAP data extraction",
            "SAP report generation",
            "SAP status queries",
            "SAP transaction monitoring"
        ],
        "input_format": "Natural language with SAP context",
        "output_format": "Structured SAP data/reports",
        "routing": {
            "reports_to": "Ilkerkaan",
