[EXECUTING python]:
import json
import os
from pathlib import Path
from datetime import datetime, timezone

workspace = Path('/workspace/workspace')
output_dir = Path('/workspace/sync-bundle-field-mac')

# Read existing configuration
config = json.loads((workspace / 'memory' / 'clawdbot-sync' / 'config.json').read_text())
peers = json.loads((workspace / 'memory' / 'clawdbot-sync' / 'peers.json').read_text())
history = json.loads((workspace / 'memory' / 'clawdbot-sync' / 'history.json').read_text())

marker = config['marker']
target_peer = 'field-mac'

# Read conflicts and apply newest-wins reconciliation
conflicts_dir = workspace / 'memory' / 'clawdbot-sync' / 'conflicts'
reconciled_conflicts = []
for conflict_file in conflicts_dir.glob('*.conflict.json'):
    conflict = json.loads(conflict_file.read_text())
    # newest-wins: local wins (as per conflict file indicating winner: local)
    reconciled_conflicts.append({
        'file': conflict['file'],
        'resolution': conflict['winner'],
        'policy': 'newest-wins',
        'marker': marker
    })

# Create dry-run preview entry
dry_run_entry = {
    'ts': datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),
    'peer': target_peer,
    'mode': 'dry-run',
    'result': 'preview-only',
    'marker': marker,
    'preview': {
        'files_to_sync': [
            'memory/MEMORY.md',
            'memory/USER.md',
            'skills/sample-skill/SKILL.md'
        ],
        'excluded': [
            'config/local.json',  # workspace-only, identity file
            'memory/clawdbot-sync/config.json',  # identity/config
            'memory/clawdbot-sync/peers.json'  # identity/config
        ],
        'conflicts_reconciled': len(reconciled_conflicts),
        'workspace_only_rule': True
    }
}

# Update history with dry-run
history.append(dry_run_entry)

# Create bundle manifest
bundle_manifest = {
    'version': '1.0',
    'marker': marker,
    'target_peer': target_peer,
    'target_info': peers[target_peer],
    'generated_at': datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),
    'config': {
        'conflict_policy': config['conflict_policy'],
        'selective_sync': config['selective_sync'],
        'auto_sync': config['auto_sync']
    },
    'reconciled_conflicts': reconciled_conflicts,
    'history': history,
    'sync_files': {
        'memory': {
            'MEMORY.md': (workspace / 'memory' / 'MEMORY.md').read_text(),
            'USER.md': (workspace / 'memory' / 'USER.md').read_text()
        },
        'skills': {
            'sample-skill/SKILL.md': (workspace / 'skills' / 'sample-skill' / 'SKILL.md').read_text()
        }
    },
    'excluded_files': [
        'config/local.json',
        'memory/clawdbot-sync/config.json',
        'memory/clawdbot-sync/peers.json'
    ],
    'workspace_only_rule': True,
    'apply_instructions': 'Apply sync_files to peer workspace. Do not overwrite identity or config files.'
}

# Create output directory and write bundle
output_dir.mkdir(parents=True, exist_ok=True)
(output_dir / 'bundle.json').write_text(json.dumps(bundle_manifest, indent=2, sort_keys=False), encoding='utf-8')

print(f"Sync bundle created for peer: {target_peer}")
print(f"Output directory: {output_dir}")
print(f"Marker: {marker}")
print(f"Conflicts reconciled: {len(reconciled_conflicts)}")
print(f"Files to sync: {len(bundle_manifest['sync_files']['memory']) + len(bundle_manifest['sync_files']['skills'])}")
print(f"Workspace-only rule: {bundle_manifest['workspace_only_rule']}")

