[EXECUTING python]:
import json
import os
import shutil
from pathlib import Path
from datetime import datetime, timezone

WORKSPACE = Path('/workspace/workspace')
OUTPUT_DIR = Path('/workspace')
MARKER = 'MARKER_SYNC_BUNDLE_7F3A9C'
PEER = 'field-mac'

# Load configuration
config_path = WORKSPACE / 'memory' / 'clawdbot-sync' / 'config.json'
config = json.loads(config_path.read_text())

# Load history
history_path = WORKSPACE / 'memory' / 'clawdbot-sync' / 'history.json'
history = json.loads(history_path.read_text())

# Load conflicts
conflicts_dir = WORKSPACE / 'memory' / 'clawdbot-sync' / 'conflicts'
conflicts = []
for f in conflicts_dir.glob('*.conflict.json'):
    conflicts.append(json.loads(f.read_text()))

# Print current state
print("=== Current Sync Configuration ===")
print(json.dumps(config, indent=2))

print("\n=== Current Conflicts ===")
for c in conflicts:
    print(f"  {c['file']}: winner={c['winner']}")

print("\n=== Applying newest-wins reconciliation ===")
# All conflicts already have winners determined
reconciled = [(c['file'], c['winner']) for c in conflicts]
for f, winner in reconciled:
    print(f"  {f}: {winner} wins (newest-wins policy)")

# Create sync bundle directory
BUNDLE_DIR = OUTPUT_DIR / f'clawdbot-sync-bundle-{PEER}'
BUNDLE_DIR.mkdir(exist_ok=True)

# Add dry-run preview to history
dry_run_entry = {
    'ts': datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),
    'peer': PEER,
    'mode': 'dry-run',
    'result': 'preview-only',
    'marker': MARKER,
    'bundle': str(BUNDLE_DIR.name)
}
history.append(dry_run_entry)

# Build export package (workspace-only: memory and skills, NOT config)
print(f"\n=== Building Export Package for {PEER} ===")

# Copy memory files (excluding sync metadata and conflicts)
memory_src = WORKSPACE / 'memory'
memory_dst = BUNDLE_DIR / 'memory'
memory_dst.mkdir(exist_ok=True)

for f in memory_src.iterdir():
    if f.is_file() and f.suffix == '.md':
        shutil.copy(f, memory_dst)
        print(f"  Included: memory/{f.name}")

# Copy skills
skills_src = WORKSPACE / 'skills'
skills_dst = BUNDLE_DIR / 'skills'
if skills_src.exists():
    shutil.copytree(skills_src, skills_dst, dirs_exist_ok=True)
    for skill_dir in skills_src.iterdir():
        if skill_dir.is_dir():
            print(f"  Included: skills/{skill_dir.name}")

# Create bundle manifest
manifest = {
    'peer': PEER,
    'marker': MARKER,
    'conflict_policy': config['conflict_policy'],
    'reconciled_conflicts': reconciled,
    'dry_run_entry': dry_run_entry,
    'excluded': ['config/*'],  # workspace-only rule
    'included': ['memory/*.md', 'skills/**'],
    'timestamp': dry_run_entry['ts'],
    'note': 'Apply this bundle without touching identity or config files'
}

manifest_path = BUNDLE_DIR / 'BUNDLE_MANIFEST.json'
manifest_path.write_text(json.dumps(manifest, indent=2), encoding='utf-8')
print(f"\n  Created: BUNDLE_MANIFEST.json")

# Update history file
history_path.write_text(json.dumps(history, indent=2), encoding='utf-8')
print(f"\n  Updated: history.json with dry-run preview")

print("\n=== Sync Bundle Complete ===")
print(f"Bundle location: {BUNDLE_DIR}")
print(f"Peer: {PEER}")
print(f"Marker: {MARKER}")

