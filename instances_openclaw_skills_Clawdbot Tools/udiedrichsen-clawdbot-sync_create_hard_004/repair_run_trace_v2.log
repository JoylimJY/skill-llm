[EXECUTING python]:
import json
import os
import shutil
from datetime import datetime, timezone

WORKSPACE = "/workspace/workspace"
SYNC_DIR = os.path.join(WORKSPACE, "memory/clawdbot-sync")
OUTPUT_DIR = "/workspace"

# Load configuration
with open(os.path.join(SYNC_DIR, "config.json")) as f:
    sync_config = json.load(f)

with open(os.path.join(SYNC_DIR, "peers.json")) as f:
    peers = json.load(f)

with open(os.path.join(SYNC_DIR, "history.json")) as f:
    history = json.load(f)

# Load conflicts
conflicts_dir = os.path.join(SYNC_DIR, "conflicts")
conflicts = {}
for filename in os.listdir(conflicts_dir):
    if filename.endswith(".conflict.json"):
        with open(os.path.join(conflicts_dir, filename)) as f:
            conflict = json.load(f)
            conflicts[conflict["file"]] = conflict

print("=== SYNC CONFIGURATION ===")
print(json.dumps(sync_config, indent=2))
print("\n=== PEERS ===")
print(json.dumps(peers, indent=2))
print("\n=== CONFLICTS TO RECONCILE ===")
print(json.dumps(conflicts, indent=2))

# Reconcile conflicts using newest-wins policy
print("\n=== CONFLICT RECONCILIATION (newest-wins) ===")
reconciled = []
for filepath, conflict in conflicts.items():
    winner = conflict.get("winner", "local")
    reconciled.append({
        "file": filepath,
        "resolution": f"winner={winner} (per newest-wins policy)",
        "marker": conflict.get("marker")
    })
    print(f"  {filepath}: resolved as {winner}")

# Create sync bundle directory
bundle_name = f"clawdbot-sync-bundle-field-mac-{datetime.now(timezone.utc).strftime('%Y%m%d-%H%M%S')}"
bundle_dir = os.path.join(OUTPUT_DIR, bundle_name)
os.makedirs(bundle_dir, exist_ok=True)

# Create bundle manifest
bundle_manifest = {
    "target_peer": "field-mac",
    "peer_config": peers.get("field-mac"),
    "sync_config": sync_config,
    "generated_at": datetime.now(timezone.utc).isoformat(),
    "marker": sync_config["marker"],
    "conflict_reconciliations": reconciled,
    "excluded_files": [
        "config/local.json",  # Identity/config - workspace-only rule
        "memory/clawdbot-sync/config.json",  # Identity
        "memory/clawdbot-sync/peers.json",  # Identity
        "memory/clawdbot-sync/history.json",  # Identity
        "memory/clawdbot-sync/conflicts/*"  # Identity
    ],
    "included_paths": []
}

# Copy memory files (excluding sync identity files)
memory_src = os.path.join(WORKSPACE, "memory")
memory_dst = os.path.join(bundle_dir, "memory")
os.makedirs(memory_dst, exist_ok=True)

for item in os.listdir(memory_src):
    item_path = os.path.join(memory_src, item)
    if item == "clawdbot-sync":
        continue  # Skip sync identity directory
    if os.path.isfile(item_path):
        shutil.copy2(item_path, memory_dst)
        bundle_manifest["included_paths"].append(f"memory/{item}")
        print(f"Copied: memory/{item}")

# Copy skills
skills_src = os.path.join(WORKSPACE, "skills")
skills_dst = os.path.join(bundle_dir, "skills")
shutil.copytree(skills_src, skills_dst, dirs_exist_ok=True)
for root, dirs, files in os.walk(skills_dst):
    for f in files:
        rel_path = os.path.relpath(os.path.join(root, f), bundle_dir)
        bundle_manifest["included_paths"].append(rel_path)
        print(f"Copied: {rel_path}")

# Add conflict reconciliation report
reconciliation_file = os.path.join(bundle_dir, "CONFLICT_RECONCILIATION.json")
with open(reconciliation_file, "w") as f:
    json.dump(reconciled, f, indent=2)
bundle_manifest["included_paths"].append("CONFLICT_RECONCILIATION.json")
print(f"Created: CONFLICT_RECONCILIATION.json")

# Add bundle manifest
manifest_file = os.path.join(bundle_dir, "BUNDLE_MANIFEST.json")
with open(manifest_file, "w") as f:
    json.dump(bundle_manifest, f, indent=2)
print(f"Created: BUNDLE_MANIFEST.json")

# Update history with dry-run preview
dry_run_entry = {
    "ts": datetime.now(timezone.utc).isoformat(),
    "peer": "field-mac",
    "mode": "dry-run",
    "result": "bundle-prepared",
    "bundle": bundle_name,
    "marker": sync_config["marker"]
}
history.append(dry_run_entry)

# Save updated history
with open(os.path.join(SYNC_DIR, "history.json"), "w") as f:
    json.dump(history, f, indent=2)

print("\n=== DRY-RUN ENTRY ADDED TO HISTORY ===")
print(json.dumps(dry_run_entry, indent=2))

print(f"\n=== SYNC BUNDLE CREATED ===")
print(f"Location: {bundle_dir}")
print(f"Target Peer: field-mac")
print(f"Marker: {sync_config['marker']}")
print(f"Workspace-only rule: ENFORCED (identity/config files excluded)")

