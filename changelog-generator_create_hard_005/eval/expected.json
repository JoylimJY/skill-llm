{
  "filenames": [
    "CHANGELOG.md"
  ],
  "file_properties": {
    "CHANGELOG.md": {
      "format": "markdown",
      "contains_headings": [
        "Features",
        "Improvements",
        "Bug Fixes",
        "Breaking Changes",
        "Security"
      ],
      "contains_date_range": "2024-03-01 to 2024-03-15",
      "excludes_keywords": [
        "refactor",
        "doc",
        "ci",
        "test"
      ],
      "contains_user_friendly_phrases": [
        "Create separate workspaces for different projects",
        "Files now sync 2x faster",
        "Fixed issue where large images wouldn't upload",
        "Remove deprecated sync API",
        "Patch security vulnerability",
        "Press ? to see all available shortcuts",
        "Corrected notification badge count"
      ],
      "bullet_points_min_per_category": 1
    }
  }
}