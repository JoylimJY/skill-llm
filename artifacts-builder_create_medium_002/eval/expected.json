{
  "output_files": [
    "task-artifact/package.json",
    "task-artifact/src/index.css",
    "task-artifact/src/**/*.tsx",
    "task-artifact/bundle.html"
  ],
  "bundle_file": "task-artifact/bundle.html",
  "bundle_properties": {
    "contains_inline_js_css": true,
    "min_file_size_bytes": 10000
  },
  "required_components": [
    "Button",
    "Card",
    "Dialog",
    "Accordion",
    "Tabs",
    "Tooltip"
  ],
  "routing_required": true,
  "style_guidelines": {
    "no_centered_layouts_excessive": true,
    "no_purple_gradients": true,
    "no_uniform_rounded_corners_excessive": true,
    "no_inter_font": true
  }
}