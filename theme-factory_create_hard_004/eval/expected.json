{
  "filenames": [
    "corporate_clarity.json",
    "quarterly_results_styled.html"
  ],
  "properties": {
    "corporate_clarity.json": {
      "type": "json",
      "required_keys": [
        "colors",
        "fonts",
        "name"
      ],
      "colors": [
        "#2A4365",
        "#E2E8F0",
        "#FFFFFF"
      ],
      "fonts": {
        "header": "Open Sans",
        "body": "Roboto"
      },
      "name_contains": "Corporate Clarity"
    },
    "quarterly_results_styled.html": {
      "type": "html",
      "must_use_colors": [
        "#2A4365",
        "#E2E8F0",
        "#FFFFFF"
      ],
      "must_use_fonts": [
        "Open Sans",
        "Roboto"
      ],
      "must_include_headers": true,
      "must_include_body_text": true
    }
  }
}