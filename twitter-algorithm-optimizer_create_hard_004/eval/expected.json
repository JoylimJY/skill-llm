{
  "output_files": [
    "optimized_tweet.txt",
    "optimization_explanation.md"
  ],
  "optimized_tweet": {
    "min_length_chars": 20,
    "includes_question_or_engagement_invite": true,
    "avoids_engagement_bait_phrases": true,
    "topical_relevance_terms": [
      "programming",
      "code",
      "developer"
    ]
  },
  "optimization_explanation": {
    "min_word_count": 150,
    "mentions_core_algorithm_terms": [
      "Real-graph",
      "SimClusters",
      "TwHIN",
      "Tweepcred"
    ],
    "mentions_engagement_signals": [
      "likes",
      "replies",
      "retweets",
      "bookmarks"
    ],
    "mentions_avoidance_of_negative_signals": true
  }
}