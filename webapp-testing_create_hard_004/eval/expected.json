{
  "filenames": [
    "backend/server.py",
    "backend/requirements.txt",
    "frontend/package.json",
    "frontend/src/App.js",
    "frontend/src/index.js",
    "frontend/public/index.html",
    "frontend/.env",
    "scripts/with_server.py",
    "frontend_test.py",
    "frontend_screenshot.png",
    "frontend_console.log"
  ],
  "key_properties": {
    "backend_marker": "[MARKER-BACKEND]",
    "frontend_marker": "[MARKER-FRONTEND]",
    "screenshot_min_size_bytes": 1000,
    "console_log_keywords": [
      "Fetch Message",
      "Refetch"
    ],
    "playwright_script_name": "frontend_test.py"
  }
}