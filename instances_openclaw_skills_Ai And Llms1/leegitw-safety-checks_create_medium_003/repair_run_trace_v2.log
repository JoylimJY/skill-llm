[EXECUTING python]:
from pathlib import Path
import yaml
import json
from datetime import datetime

root = Path('/workspace')
output_dir = root / 'output' / 'safety'

# Initialize results
results = {
    'timestamp': datetime.utcnow().isoformat() + 'Z',
    'checks': {},
    'issues': [],
    'summary': {}
}

# 1. Model Pinning Check
print("=== Checking Model Pinning ===")
model_pins = {}
for config_path in [root / '.openclaw' / 'safety-checks.yaml', root / '.claude' / 'safety-checks.yaml']:
    if config_path.exists():
        config = yaml.safe_load(config_path.read_text())
        model_pins[config_path.name] = {
            'expected_model': config.get('model', {}).get('expected'),
            'strict_mode': config.get('model', {}).get('strict', False)
        }

results['checks']['model_pinning'] = model_pins
print(f"Model pinning configs: {list(model_pins.keys())}")

# 2. Fallback Declarations Check
print("\n=== Checking Fallback Declarations ===")
fallbacks = {}
config = yaml.safe_load((root / '.openclaw' / 'safety-checks.yaml').read_text())
fallbacks['model_fallbacks'] = config.get('fallbacks', {}).get('model', [])
fallbacks['storage_fallbacks'] = config.get('fallbacks', {}).get('storage', [])

results['checks']['fallback_declarations'] = fallbacks
print(f"Model fallbacks: {fallbacks['model_fallbacks']}")
print(f"Storage fallbacks: {fallbacks['storage_fallbacks']}")

# 3. Cache Staleness Check
print("\n=== Checking Cache Staleness ===")
staleness_log = root / '.openclaw' / 'cache' / 'staleness.log'
cache_items = {'fresh': [], 'stale': [], 'critical': []}

if staleness_log.exists():
    for line in staleness_log.read_text().strip().split('\n'):
        if line.startswith('marker:'):
            continue
        parts = line.split(',')
        if len(parts) >= 2:
            name = parts[0]
            age = int(parts[1].split('=')[1])
            if age < 300:
                cache_items['fresh'].append({'name': name, 'age_seconds': age})
            elif age < 3600:
                cache_items['stale'].append({'name': name, 'age_seconds': age})
                results['issues'].append({
                    'severity': 'WARNING',
                    'check': 'cache_staleness',
                    'item': name,
                    'message': f'Cache item stale ({age}s > 300s threshold)'
                })
            else:
                cache_items['critical'].append({'name': name, 'age_seconds': age})
                results['issues'].append({
                    'severity': 'ERROR',
                    'check': 'cache_staleness',
                    'item': name,
                    'message': f'Cache item critically stale ({age}s > 3600s threshold)'
                })

results['checks']['cache_staleness'] = cache_items
print(f"Fresh: {len(cache_items['fresh'])}, Stale: {len(cache_items['stale'])}, Critical: {len(cache_items['critical'])}")

# 4. Cross-Session State Hygiene Check
print("\n=== Checking Cross-Session State Hygiene ===")
hygiene = {'lock_files': [], 'orphan_files': []}

lock_file = root / '.openclaw' / 'safety-checks.lock'
if lock_file.exists():
    hygiene['lock_files'].append({'path': str(lock_file), 'content': lock_file.read_text().strip()})
    results['issues'].append({
        'severity': 'WARNING',
        'check': 'cross_session_hygiene',
        'message': 'Stale lock file detected (pid=999999)'
    })

orphan_file = root / 'output' / 'safety' / 'temp-orphan.log'
if orphan_file.exists():
    hygiene['orphan_files'].append({'path': str(orphan_file), 'content': orphan_file.read_text().strip()})
    results['issues'].append({
        'severity': 'WARNING',
        'check': 'cross_session_hygiene',
        'message': 'Orphan temp file detected'
    })

results['checks']['cross_session_hygiene'] = hygiene
print(f"Lock files found: {len(hygiene['lock_files'])}, Orphan files: {len(hygiene['orphan_files'])}")

# Summary
results['summary'] = {
    'total_issues': len(results['issues']),
    'errors': len([i for i in results['issues'] if i['severity'] == 'ERROR']),
    'warnings': len([i for i in results['issues'] if i['severity'] == 'WARNING']),
    'status': 'FAIL' if len([i for i in results['issues'] if i['severity'] == 'ERROR']) > 0 else 'PASS'
}

# Write machine-readable results
results_file = output_dir / 'safety-bundle.json'
results_file.write_text(json.dumps(results, indent=2), encoding='utf-8')
print(f"\n=== Machine-readable results written to {results_file} ===")

# Write human-readable report
report = f"""{'='*60}
SAFETY VERIFICATION REPORT - RELEASE CANDIDATE
{'='*60}
Generated: {results['timestamp']}

OVERALL STATUS: {results['summary']['status']}
Total Issues: {results['summary']['total_issues']} (Errors: {results['summary']['errors']}, Warnings: {results['summary']['warnings']})

{'='*60}
CHECK DETAILS
{'='*60}

1. MODEL PINNING
   - .openclaw/safety-checks.yaml: {model_pins.get('.openclaw/safety-checks.yaml', {})}
   - .claude/safety-checks.yaml: {model_pins.get('.claude/safety-checks.yaml', {})}

2. FALLBACK DECLARATIONS
   - Model fallbacks: {fallbacks['model_fallbacks']}
   - Storage fallbacks: {fallbacks['storage_fallbacks']}

3. CACHE STALENESS
   - Fresh items (<300s): {cache_items['fresh']}
   - Stale items (300-3600s): {cache_items['stale']}
   - Critical items (>3600s): {cache_items['critical']}

4. CROSS-SESSION STATE HYGIENE
   - Lock files: {hygiene['lock_files']}
   - Orphan files: {hygiene['orphan_files']}

{'='*60}
ISSUES REQUIRING ATTENTION
{'='*60}
"""

for issue in results['issues']:
    report += f"[{issue['severity']}] {issue['check']}: {issue['message']}\n"

report += f"\n{'='*60}\nEND OF REPORT\n{'='*60}\n"

report_file = output_dir / 'safety-report.txt'
report_file.write_text(report, encoding='utf-8')
print(f"=== Human-readable report written to {report_file} ===")

print("\n=== VERIFICATION COMPLETE ===")

[OUTPUT]:
