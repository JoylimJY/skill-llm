#!/usr/bin/env python3
"""
Safety Verification Bundle for Release Candidate
Checks: model pinning, fallback declarations, cache staleness, cross-session state hygiene
"""

import os
import yaml
from pathlib import Path
from datetime import datetime

ROOT = Path('/workspace')
CONFIG_FILES = [
    ROOT / '.openclaw' / 'safety-checks.yaml',
    ROOT / '.claude' / 'safety-checks.yaml',
]
CACHE_STALENESS_LOG = ROOT / '.openclaw' / 'cache' / 'staleness.log'
LOCK_FILE = ROOT / '.openclaw' / 'safety-checks.lock'
OUTPUT_DIR = ROOT / 'output' / 'safety'

STALE_THRESHOLD = 3600
CRITICAL_THRESHOLD = 7200

def check_model_pinning(config):
    issues = []
    if 'model' not in config:
        issues.append("MISSING: No model configuration found")
    else:
        model_cfg = config['model']
        if 'expected' not in model_cfg:
            issues.append("MISSING: No expected model version specified")
        elif not model_cfg.get('strict', False):
            issues.append("WARNING: Model pinning is not strict")
    return issues

def check_fallback_declarations(config):
    issues = []
    if 'fallbacks' not in config:
        issues.append("MISSING: No fallback configuration found")
    else:
        fallbacks = config['fallbacks']
        if 'model' not in fallbacks or not fallbacks['model']:
            issues.append("MISSING: No model fallbacks declared")
        elif len(fallbacks['model']) < 2:
            issues.append("WARNING: Insufficient model fallbacks (less than 2)")
        if 'storage' not in fallbacks or not fallbacks['storage']:
            issues.append("MISSING: No storage fallbacks declared")
    return issues

def check_cache_staleness():
    stale_items = []
    critical_items = []
    issues = []
    
    if not CACHE_STALENESS_LOG.exists():
        return stale_items, critical_items, ["WARNING: No staleness log found"]
    
    content = CACHE_STALENESS_LOG.read_text()
    for line in content.strip().split('\n'):
        if line.startswith('marker:') or not line.strip():
            continue
        parts = line.split(',')
        if len(parts) >= 2:
            item_name = parts[0]
            try:
                age_seconds = int(parts[1].split('=')[1])
                if age_seconds >= CRITICAL_THRESHOLD:
                    critical_items.append({'name': item_name, 'age_seconds': age_seconds})
                elif age_seconds >= STALE_THRESHOLD:
                    stale_items.append({'name': item_name, 'age_seconds': age_seconds})
            except (IndexError, ValueError):
                continue
    return stale_items, critical_items, issues

def check_cross_session_hygiene():
    issues = []
    
    if LOCK_FILE.exists():
        lock_content = LOCK_FILE.read_text()
        if 'pid=' in lock_content:
            try:
                pid = int(lock_content.split('pid=')[1].split('\n')[0])
                if not os.path.exists(f'/proc/{pid}'):
                    issues.append(f"STALE_LOCK: Lock file exists but process {pid} is not running")
            except (IndexError, ValueError):
                issues.append("STALE_LOCK: Lock file exists with invalid PID format")
    
    for f in OUTPUT_DIR.glob('temp-*.log'):
        issues.append(f"ORPHAN_FILE: Found orphan temp file: {f.name}")
    
    return issues

def main():
    results = {
        'timestamp': datetime.utcnow().isoformat() + 'Z',
        'checks': {
            'model_pinning': {'status': 'PASS', 'details': []},
            'fallback_declarations': {'status': 'PASS', 'details': []},
            'cache_staleness': {'status': 'PASS', 'stale_items': [], 'critical_items': [], 'details': []},
            'cross_session_hygiene': {'status': 'PASS', 'details': []},
        },
        'overall_status': 'PASS'
    }
    
    report_lines = ["=" * 60, "SAFETY VERIFICATION BUNDLE - RELEASE CANDIDATE", "=" * 60,
                   f"Generated: {results['timestamp']}", ""]
    
    for config_file in CONFIG_FILES:
        if not config_file.exists():
            continue
        config = yaml.safe_load(config_file.read_text())
        
        pinning_issues = check_model_pinning(config)
        if pinning_issues:
            results['checks']['model_pinning']['status'] = 'FAIL'
            results['checks']['model_pinning']['details'].extend([f"[{config_file.name}] {i}" for i in pinning_issues])
        
        fallback_issues = check_fallback_declarations(config)
        if fallback_issues:
            results['checks']['fallback_declarations']['status'] = 'FAIL'
            results['checks']['fallback_declarations']['details'].extend([f"[{config_file.name}] {i}" for i in fallback_issues])
    
    stale_items, critical_items, staleness_issues = check_cache_staleness()
    results['checks']['cache_staleness']['stale_items'] = stale_items
    results['checks']['cache_staleness']['critical_items'] = critical_items
    results['checks']['cache_staleness']['details'].extend(staleness_issues)
    if stale_items or critical_items:
        results['checks']['cache_staleness']['status'] = 'WARN' if not critical_items else 'FAIL'
    
    hygiene_issues = check_cross_session_hygiene()
    results['checks']['cross_session_hygiene']['details'].extend(hygiene_issues)
    if hygiene_issues:
        results['checks']['cross_session_hygiene']['status'] = 'FAIL'
    
    check_statuses = [v['status'] for v in results['checks'].values()]
    if 'FAIL' in check_statuses:
        results['overall_status'] = 'FAIL'
    elif 'WARN' in check_statuses:
        results['overall_status'] = 'WARN'
    
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    (OUTPUT_DIR / 'safety-verification.json').write_text(
        yaml.safe_dump(results, sort_keys=False, default_flow_style=False),
        encoding='utf-8'
    )
    
    report_lines.append("SUMMARY")
    report_lines.append("-" * 40)
    report_lines.append(f"Overall Status: {results['overall_status']}")
    report_lines.append("")
    
    for check_name, check_result in results['checks'].items():
        status_icon = {"PASS": "PASS", "WARN": "WARN", "FAIL": "FAIL"}
        icon = status_icon.get(check_result['status'], "UNKNOWN")
        report_lines.append(f"[{icon}] {check_name.replace('_', ' ').title()}")
        for detail in check_result.get('details', []):
            report_lines.append(f"    - {detail}")
        if check_result.get('stale_items'):
            report_lines.append(f"    Stale items ({len(check_result['stale_items'])}):")
            for item in check_result['stale_items']:
                report_lines.append(f"      - {item['name']}: {item['age_seconds']}s")
        if check_result.get('critical_items'):
            report_lines.append(f"    Critical items ({len(check_result['critical_items'])}):")
            for item in check_result['critical_items']:
                report_lines.append(f"      - {item['name']}: {item['age_seconds']}s")
        report_lines.append("")
    
    report_lines.append("=" * 60)
    report_lines.append("END OF REPORT")
    report_lines.append("=" * 60)
    
    report_text = '\n'.join(report_lines)
    (OUTPUT_DIR / 'safety-report.txt').write_text(report_text, encoding='utf-8')
    
    print(report_text)
    print(f"\nResults written to {OUTPUT_DIR}")

if __name__ == '__main__':
    main()

