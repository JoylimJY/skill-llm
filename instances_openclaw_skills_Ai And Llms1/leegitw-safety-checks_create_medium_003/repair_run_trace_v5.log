#!/usr/bin/env python3
"""
Safety Verification Bundle for Release Candidate
Checks: model pinning, fallbacks, cache staleness, cross-session hygiene
"""

import yaml
import json
import os
from pathlib import Path
from datetime import datetime

WORKSPACE = Path('/workspace')
OUTPUT_DIR = WORKSPACE / 'output' / 'safety'
CONFIG_FILES = [
    WORKSPACE / '.openclaw' / 'safety-checks.yaml',
    WORKSPACE / '.claude' / 'safety-checks.yaml',
]
CACHE_LOG = WORKSPACE / '.openclaw' / 'cache' / 'staleness.log'
LOCK_FILE = WORKSPACE / '.openclaw' / 'safety-checks.lock'
STALENESS_THRESHOLDS = {
    'fresh': 300,      # 5 minutes
    'stale': 3600,     # 60 minutes
    'critical': float('inf'),
}

def check_model_pinning(configs):
    """Verify model is properly pinned across all configs."""
    results = {'status': 'PASS', 'details': [], 'issues': []}
    expected_model = None
    
    for cfg_path, cfg in configs.items():
        model_cfg = cfg.get('model', {})
        pinned = model_cfg.get('expected')
        strict = model_cfg.get('strict', False)
        
        if expected_model is None:
            expected_model = pinned
        elif expected_model != pinned:
            results['status'] = 'FAIL'
            results['issues'].append(f'Model mismatch: {cfg_path} has {pinned}')
        
        if not pinned:
            results['status'] = 'FAIL'
            results['issues'].append(f'No model pinned in {cfg_path}')
        elif not strict:
            results['issues'].append(f'Model pinning not strict in {cfg_path}')
        
        results['details'].append({
            'config': str(cfg_path),
            'pinned_model': pinned,
            'strict': strict,
        })
    
    return results

def check_fallbacks(configs):
    """Verify fallback declarations are present and valid."""
    results = {'status': 'PASS', 'details': [], 'issues': []}
    
    for cfg_path, cfg in configs.items():
        fallbacks = cfg.get('fallbacks', {})
        model_fallbacks = fallbacks.get('model', [])
        storage_fallbacks = fallbacks.get('storage', [])
        
        if not model_fallbacks:
            results['issues'].append(f'No model fallbacks in {cfg_path}')
        if not storage_fallbacks:
            results['issues'].append(f'No storage fallbacks in {cfg_path}')
        
        results['details'].append({
            'config': str(cfg_path),
            'model_fallbacks': model_fallbacks,
            'storage_fallbacks': storage_fallbacks,
        })
    
    if results['issues']:
        results['status'] = 'WARN'
    return results

def check_cache_staleness():
    """Analyze cache staleness from staleness.log."""
    results = {'status': 'PASS', 'details': [], 'issues': []}
    
    if not CACHE_LOG.exists():
        results['status'] = 'WARN'
        results['issues'].append('No staleness log found')
        return results
    
    items = []
    for line in CACHE_LOG.read_text().strip().split('\n'):
        if line.startswith('marker:'):
            continue
        if ',' not in line:
            continue
        name, age_str = line.split(',', 1)
        age = int(age_str.split('=')[1])
        items.append({'name': name, 'age_seconds': age})
    
    for item in items:
        age = item['age_seconds']
        if age > STALENESS_THRESHOLDS['stale']:
            item['status'] = 'CRITICAL'
            results['issues'].append(f"Critical stale item: {item['name']} ({age}s)")
            results['status'] = 'FAIL'
        elif age > STALENESS_THRESHOLDS['fresh']:
            item['status'] = 'STALE'
            results['issues'].append(f"Stale item: {item['name']} ({age}s)")
            if results['status'] != 'FAIL':
                results['status'] = 'WARN'
        else:
            item['status'] = 'FRESH'
        results['details'].append(item)
    
    return results

def check_cross_session_hygiene():
    """Check for stale locks and orphan temp files."""
    results = {'status': 'PASS', 'details': [], 'issues': []}
    
    # Check lock file
    if LOCK_FILE.exists():
        lock_content = LOCK_FILE.read_text()
        results['details'].append({'type': 'lock', 'path': str(LOCK_FILE), 'content': lock_content})
        if 'pid=999999' in lock_content:
            results['issues'].append('Stale lock detected (orphan PID)')
            results['status'] = 'WARN'
    
    # Check for orphan temp files
    for f in OUTPUT_DIR.glob('temp-*.log'):
        results['details'].append({'type': 'orphan', 'path': str(f)})
        results['issues'].append(f'Orphan temp file: {f}')
        results['status'] = 'WARN'
    
    return results

def generate_report(all_results):
    """Generate human-readable summary report."""
    report_lines = [
        "=" * 60,
        "SAFETY VERIFICATION REPORT",
        f"Generated: {datetime.now().isoformat()}",
        "=" * 60,
        "",
    ]
    
    overall_status = 'PASS'
    
    for check_name, result in all_results.items():
        status = result['status']
        if status == 'FAIL':
            overall_status = 'FAIL'
        elif status == 'WARN' and overall_status != 'FAIL':
            overall_status = 'WARN'
        
        report_lines.append(f"[{status}] {check_name.upper()}")
        report_lines.append("-" * 40)
        
        for issue in result.get('issues', []):
            report_lines.append(f"  * {issue}")
        
        report_lines.append("")
    
    report_lines.append("=" * 60)
    report_lines.append(f"OVERALL STATUS: {overall_status}")
    report_lines.append("=" * 60)
    
    return '\n'.join(report_lines)

def main():
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    
    # Load all configs
    configs = {}
    for cfg_path in CONFIG_FILES:
        if cfg_path.exists():
            configs[cfg_path] = yaml.safe_load(cfg_path.read_text())
    
    # Run all checks
    all_results = {
        'model_pinning': check_model_pinning(configs),
        'fallbacks': check_fallbacks(configs),
        'cache_staleness': check_cache_staleness(),
        'cross_session_hygiene': check_cross_session_hygiene(),
    }
    
    # Write individual check results as JSON
    for check_name, result in all_results.items():
        output_file = OUTPUT_DIR / f'{check_name}.json'
        output_file.write_text(json.dumps(result, indent=2), encoding='utf-8')
    
    # Write summary report
    report = generate_report(all_results)
    (OUTPUT_DIR / 'safety_report.txt').write_text(report, encoding='utf-8')
    
    print(report)

if __name__ == '__main__':
    main()

