[EXECUTING python]:
import json
import os
import re
from pathlib import Path

# Read manifest
with open('/workspace/inputs/manifest.json', 'r') as f:
    manifest = json.load(f)

# Initialize extraction results
people = set()
projects = set()
decisions = []
summaries = []

# Common person names to look for (based on the content)
common_names = ['Alice', 'Bob', 'Carol', 'Dan', 'Eve', 'Frank', 'Grace', 'Henry']

# Process each input file
for input_info in manifest['inputs']:
    filepath = f"/workspace/{input_info['filename']}"
    marker = input_info['marker']
    
    with open(filepath, 'r') as f:
        content = f.read()
    
    lines = content.strip().split('\n')
    # Skip marker and date line, get the actual content
    conversation_text = '\n'.join(lines[2:]).strip()
    
    # Extract people (look for common names in the text)
    for name in common_names:
        if name in conversation_text:
            people.add(name)
    
    # Extract projects (look for capitalized words after "Project" or standalone capitalized project-like names)
    # Pattern for "Project X"
    project_matches = re.findall(r'Project\s+(\w+)', conversation_text)
    for proj in project_matches:
        projects.add(proj)
    
    # Also look for standalone project names like "Nimbus", "Atlas"
    # These are typically mentioned in context like "the X migration" or "the X prototype"
    project_keywords = re.findall(r'the\s+(\w+)\s+(migration|prototype|launch|release)', conversation_text)
    for proj, _ in project_keywords:
        if proj.capitalize() not in common_names:
            projects.add(proj.capitalize())
    
    # Extract decisions (look for "Decision:" pattern)
    decision_matches = re.findall(r'Decision:\s*(.+?)(?:\n|$)', conversation_text)
    for decision_text in decision_matches:
        decisions.append({
            "marker": marker,
            "text": decision_text.strip()
        })
    
    # Create summary paragraph
    summary = f"{marker}: {conversation_text}"
    summaries.append(summary)

# Build the entities JSON
entities = {
    "people": sorted(list(people)),
    "projects": sorted(list(projects)),
    "decisions": decisions
}

# Create output directory if needed
output_dir = Path('/workspace/percept_bundle')
output_dir.mkdir(exist_ok=True)

# Write entities.json
with open(output_dir / 'entities.json', 'w') as f:
    json.dump(entities, f, indent=2)

# Write summary.txt
with open(output_dir / 'summary.txt', 'w') as f:
    f.write('\n\n'.join(summaries))

print("Extraction complete!")
print(f"Found {len(people)} people: {sorted(list(people))}")
print(f"Found {len(projects)} projects: {sorted(list(projects))}")
print(f"Found {len(decisions)} decisions")

[OUTPUT]:
Extraction complete!
Found 4 people: ['Alice', 'Bob', 'Carol', 'Dan']
Found 4 projects: ['Atlas', 'Current', 'Nimbus', 'Orion']
Found 3 decisions


