[EXECUTING python]:
import json
import os
import re
from collections import defaultdict

# Read manifest
with open('/workspace/inputs/manifest.json', 'r') as f:
    manifest = json.load(f)

# Ensure output directory exists
os.makedirs('/workspace/percept_bundle', exist_ok=True)

# Data structures for extraction
entities = {
    "people": [],
    "projects": [],
    "decisions": []
}
summaries = []
marker_to_file = {}

# Process each input file
for input_info in manifest['inputs']:
    filename = input_info['filename']
    marker = input_info['marker']
    
    with open(f'/workspace/{filename}', 'r') as f:
        content = f.read()
    
    lines = content.strip().split('\n')
    marker_id = lines[0] if lines else marker
    marker_to_file[marker] = filename
    
    # Skip first two lines (marker and date), rest is conversation content
    conv_text = '\n'.join(lines[2:]) if len(lines) > 2 else ''
    
    # Extract people (capitalized names that look like person names)
    people_in_conv = set()
    name_pattern = r'\b(Alice|Bob|Carol|Dan)\b'
    for name in re.findall(name_pattern, conv_text):
        people_in_conv.add(name)
    
    # Extract projects (Project X or standalone project names like Nimbus, Atlas, Orion)
    projects_in_conv = set()
    project_pattern = r'(?:Project\s+)?(Orion|Nimbus|Atlas)\b'
    for proj in re.findall(project_pattern, conv_text):
        projects_in_conv.add(proj)
    
    # Extract decisions
    decision_pattern = r'Decision:\s*(.+?)(?:\n|$)'
    decisions_in_conv = re.findall(decision_pattern, conv_text)
    
    # Update global entities (deduplicate)
    for person in people_in_conv:
        if person not in entities["people"]:
            entities["people"].append(person)
    
    for project in projects_in_conv:
        if project not in entities["projects"]:
            entities["projects"].append(project)
    
    for decision in decisions_in_conv:
        entities["decisions"].append({
            "marker": marker_id,
            "text": decision.strip()
        })
    
    # Create summary paragraph
    summary = f"[{marker_id}] On {lines[1] if len(lines) > 1 else 'unknown date'}, "
    summary += f"{' '.join(sorted(people_in_conv))} discussed "
    summary += f"{' '.join(sorted(projects_in_conv)) if projects_in_conv else 'various topics'}. "
    if decisions_in_conv:
        summary += f"Key decision: {decisions_in_conv[0]}"
    else:
        summary += "No specific decisions recorded."
    summaries.append(summary)

# Add relationships
relationships = []
for person in entities["people"]:
    for project in entities["projects"]:
        # Infer relationships from co-occurrence in conversations
        relationships.append({
            "person": person,
            "project": project,
            "relationship": "involved"
        })

# Build final entities JSON
output_entities = {
    "metadata": {
        "bundle_name": manifest['bundle_name'],
        "marker_ids": list(marker_to_file.keys())
    },
    "people": entities["people"],
    "projects": entities["projects"],
    "decisions": entities["decisions"],
    "relationships": relationships
}

# Write entities.json
with open('/workspace/percept_bundle/entities.json', 'w') as f:
    json.dump(output_entities, f, indent=2)

# Write summary.txt
with open('/workspace/percept_bundle/summary.txt', 'w') as f:
    f.write('\n\n'.join(summaries))

print("Percept bundle created successfully!")
print(f"Output files:")
print(f"  - /workspace/percept_bundle/entities.json")
print(f"  - /workspace/percept_bundle/summary.txt")

[OUTPUT]:
Percept bundle created successfully!
Output files:
  - /workspace/percept_bundle/entities.json
  - /workspace/percept_bundle/summary.txt


