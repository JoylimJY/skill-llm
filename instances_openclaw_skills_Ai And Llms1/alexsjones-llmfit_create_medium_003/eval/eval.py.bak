import json
import os
from pathlib import Path

workspace = Path(__import__('sys').argv[1])
checks = []

def add_check(name, passed, detail):
    checks.append({"name": name, "passed": bool(passed), "detail": detail})

# Check 1: required output file exists
try:
    output_path = workspace / 'output.json'
    exists = output_path.exists()
    add_check('output_exists', exists, 'output.json found' if exists else 'output.json is missing')
except Exception as e:
    add_check('output_exists', False, f'error checking output file: {e}')

# Check 2: parse JSON and verify structure/content loosely
parsed = None
try:
    if (workspace / 'output.json').exists():
        text = (workspace / 'output.json').read_text(encoding='utf-8', errors='replace')
        parsed = json.loads(text)
        ok = isinstance(parsed, dict)
        add_check('json_parses', ok, 'valid JSON object' if ok else 'top-level JSON is not an object')
    else:
        add_check('json_parses', False, 'cannot parse because output.json is missing')
except Exception as e:
    add_check('json_parses', False, f'failed to parse JSON: {e}')

# Check 3: must contain recommendations with at least one coding and one chat entry, fuzzily
try:
    models = []
    if isinstance(parsed, dict):
        models = parsed.get('models') or parsed.get('recommendations') or []
    if not isinstance(models, list):
        models = []
    normalized = []
    for m in models:
        try:
            if isinstance(m, dict):
                name = str(m.get('name', '')).lower()
                use_case = str(m.get('use_case', '')).lower()
                fit = str(m.get('fit_level', '')).lower()
                normalized.append((name, use_case, fit))
        except Exception:
            pass
    has_coding = any('code' in n or 'coder' in n or uc == 'coding' for n, uc, _ in normalized)
    has_chat = any(uc == 'chat' or 'instruct' in n or 'chat' in n for n, uc, _ in normalized)
    add_check('contains_coding_and_chat', has_coding and has_chat, f'coding={has_coding}, chat={has_chat}, models_found={len(normalized)}')
except Exception as e:
    add_check('contains_coding_and_chat', False, f'error validating recommendations: {e}')

# Check 4: top pick should include an Ollama mapping or provider info, loosely
try:
    top = None
    if isinstance(parsed, dict):
        models = parsed.get('models') or parsed.get('recommendations') or []
        if isinstance(models, list) and models:
            top = models[0]
    mapping_ok = False
    detail = 'top recommendation not found'
    if isinstance(top, dict):
        combined = ' '.join([str(top.get(k, '')) for k in ['name', 'provider', 'ollama_tag', 'mapping', 'tag']]).lower()
        mapping_ok = ('ollama' in combined) or ('llama' in combined) or ('qwen' in combined) or ('mistral' in combined)
        detail = combined if combined else 'top recommendation has no visible mapping fields'
    add_check('top_pick_mapping', mapping_ok, detail)
except Exception as e:
    add_check('top_pick_mapping', False, f'error checking mapping: {e}')

passed_count = sum(1 for c in checks if c['passed'])
score = passed_count / len(checks) if checks else 0.0
result = {'passed': passed_count == len(checks), 'score': score, 'checks': checks}
print(json.dumps(result, ensure_ascii=False))
