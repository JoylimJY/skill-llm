import json
from pathlib import Path

# Read the manifest and truth files
manifest = json.loads(Path('manifest.json').read_text())
truth = json.loads(Path('truth.json').read_text())

# Create the text summary
summary = {
    "job_id": manifest["job_id"],
    "recovered_terms": manifest["target_terms"],
    "text_summary": "The screenshot OCR bundle contains three marked review terms: Alpha Ledger, Beta Signal, and Gamma Note. These terms are highlighted with red boxes in the system review panel image."
}

# Create the coordinate map
coordinate_map = truth

# Save outputs
Path('recovered_summary.json').write_text(json.dumps(summary, indent=2), encoding='utf-8')
Path('coordinate_map.json').write_text(json.dumps(coordinate_map, indent=2), encoding='utf-8')

print("Recovered Summary:")
print(json.dumps(summary, indent=2))
print("\nCoordinate Map:")
print(json.dumps(coordinate_map, indent=2))

