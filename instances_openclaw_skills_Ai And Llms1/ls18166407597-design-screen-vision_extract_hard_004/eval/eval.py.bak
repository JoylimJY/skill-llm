import json
import os
from pathlib import Path

workspace = Path(__import__('sys').argv[1])
checks = []


def add_check(name, passed, detail):
    checks.append({'name': name, 'passed': bool(passed), 'detail': str(detail)})


def safe_read_text(path):
    try:
        return Path(path).read_text(encoding='utf-8', errors='replace')
    except Exception as e:
        return None, f'error reading {path}: {e}'


def normalize(s):
    try:
        return ''.join(ch.lower() for ch in str(s) if ch.isalnum() or ch.isspace())
    except Exception:
        return ''

# Expected outputs
summary_path = workspace / 'summary.txt'
coords_path = workspace / 'coordinates.json'

# Check 1: summary file exists and contains all target terms fuzzily
try:
    if summary_path.exists():
        text = summary_path.read_text(encoding='utf-8', errors='replace')
        norm = normalize(text)
        terms = ['alpha ledger', 'beta signal', 'gamma note']
        hits = [t for t in terms if normalize(t) in norm]
        passed = len(hits) == len(terms)
        add_check('summary_contains_terms', passed, f'hits={hits}, len={len(text)}')
    else:
        add_check('summary_contains_terms', False, 'summary.txt is missing')
except Exception as e:
    add_check('summary_contains_terms', False, f'exception: {e}')

# Check 2: coordinates file exists and has approximate numeric positions
try:
    if coords_path.exists():
        data = json.loads(coords_path.read_text(encoding='utf-8', errors='replace'))
        expected = {
            'alpha ledger': (185, 192),
            'beta signal': (820, 372),
            'gamma note': (475, 712),
        }
        passed = True
        details = []
        for key, (ex, ey) in expected.items():
            found = None
            for k, v in data.items():
                if normalize(k) == key and isinstance(v, dict):
                    x = v.get('x')
                    y = v.get('y')
                    if isinstance(x, (int, float)) and isinstance(y, (int, float)):
                        found = (x, y)
                    break
            if found is None:
                passed = False
                details.append(f'missing or malformed entry for {key}')
            else:
                x, y = found
                ok = abs(x - ex) <= 25 and abs(y - ey) <= 25
                if not ok:
                    passed = False
                    details.append(f'{key}: got=({x},{y}) expected~({ex},{ey})')
        add_check('coordinates_approximate_positions', passed, '; '.join(details) if details else 'all entries within tolerance')
    else:
        add_check('coordinates_approximate_positions', False, 'coordinates.json is missing')
except Exception as e:
    add_check('coordinates_approximate_positions', False, f'exception: {e}')

# Check 3: mention the job id or screenshot context in a note file if present, otherwise fail gracefully
try:
    note_path = workspace / 'notes.txt'
    if note_path.exists():
        text = note_path.read_text(encoding='utf-8', errors='replace')
        passed = 'screen-vision-hard-042' in normalize(text) or 'review panel' in normalize(text)
        add_check('context_note_present', passed, 'notes.txt inspected')
    else:
        add_check('context_note_present', False, 'notes.txt is missing')
except Exception as e:
    add_check('context_note_present', False, f'exception: {e}')

score = (sum(1 for c in checks if c['passed']) / len(checks)) if checks else 0.0
passed = all(c['passed'] for c in checks) if checks else False
result = {'passed': passed, 'score': score, 'checks': checks}
print(json.dumps(result, ensure_ascii=False))
