#!/usr/bin/env python3
"""
Create mnemon workspace with memories from input files.
Fixes the Python 3.11 compatibility issue and creates memories.
"""

import os
import sys
import json
import hashlib
import pickle
import zlib
from pathlib import Path

# Fix the MutableMapping import for Python 3.11+
try:
    from collections.abc import MutableMapping
except ImportError:
    from collections import MutableMapping

import appdirs

class MnBackend(MutableMapping):
    _raw = False
    _expire = None

    def _compress(self, value):
        if not self._raw:
            value = pickle.dumps(value)
        elif type(value) is not bytes:
            if type(value) is str:
                value = value.encode("utf-8")
            else:
                raise TypeError(type(value))
        return zlib.compress(value)

    def _decompress(self, value):
        value = zlib.decompress(value)
        if not self._raw:
            value = pickle.loads(value)
        return value

    def __init__(self, expire=None, raw=False):
        self._expire = expire
        self._raw = raw

    @staticmethod
    def _hash(key):
        if type(key) is not str:
            key = str(key)
        return hashlib.sha256(key.encode("utf-8")).hexdigest()

    def __enter__(self):
        return self

    def __exit__(self, t, value, traceback):
        pass


class MnFile(MnBackend):
    @staticmethod
    def _perms(path):
        os.chmod(path, 0o777)

    def __init__(self, cachedir=None, expire=None, raw=False):
        super().__init__(expire=expire, raw=raw)
        cd = cachedir or appdirs.user_cache_dir(appname="mnemon", appauthor="myyc")
        self.path = cd
        if not os.path.exists(cd):
            os.makedirs(self.path, exist_ok=True)
            self._perms(self.path)
            os.makedirs(os.path.join(self.path, "data"), exist_ok=True)
            self._perms(os.path.join(self.path, "data"))

    def __contains__(self, key):
        return os.path.exists(os.path.join(self.path, "data", self._hash(key)))

    def get(self, key):
        if not self.__contains__(key):
            raise KeyError(key)
        p = os.path.join(self.path, "data", self._hash(key))
        with open(os.path.join(p, "value"), "rb") as fv:
            return self._decompress(fv.read())

    def __getitem__(self, key):
        return self.get(key)

    def __setitem__(self, key, value):
        if self.__contains__(key):
            del self[key]
        p = os.path.join(self.path, "data", self._hash(key))
        os.makedirs(p, exist_ok=True)
        self._perms(p)
        with open(os.path.join(p, "key"), "w") as fk:
            fk.write(key)
        with open(os.path.join(p, "value"), "wb") as fv:
            fv.write(self._compress(value))

    def __delitem__(self, key):
        p = os.path.join(self.path, "data", self._hash(key))
        if os.path.exists(p):
            import shutil
            shutil.rmtree(p)

    def keys(self):
        data_dir = os.path.join(self.path, "data")
        if not os.path.exists(data_dir):
            return []
        keys = []
        for folder in os.listdir(data_dir):
            folder_path = os.path.join(data_dir, folder)
            if os.path.isdir(folder_path):
                key_file = os.path.join(folder_path, "key")
                if os.path.exists(key_file):
                    with open(key_file, "r") as f:
                        keys.append(f.read())
        return keys

    def values(self):
        return [self.get(k) for k in self.keys()]

    def items(self):
        return [(k, self.get(k)) for k in self.keys()]

    def __iter__(self):
        return iter(self.keys())

    def __len__(self):
        return len(self.keys())


def create_edge(store, memory1_id, memory2_id, edge_type="semantic"):
    """Create a semantic edge between two memories."""
    edge_id = f"edge_{memory1_id}_{memory2_id}"
    edge_data = {
        "type": edge_type,
        "source": memory1_id,
        "target": memory2_id,
        "description": f"Semantic relationship between {memory1_id} and {memory2_id}"
    }
    store[edge_id] = edge_data
    return edge_id


def main():
    # Initialize the default file-based store
    store = MnFile()
    
    # Read input files
    inputs_dir = Path("/workspace/inputs")
    
    memories = {}
    for i in range(1, 4):
        filepath = inputs_dir / f"memory{i}.txt"
        if filepath.exists():
            content = filepath.read_text().strip()
            memories[f"memory{i}"] = {
                "content": content,
                "source": str(filepath),
                "marker": "MNEMON_MARKER_ALPHA_2025"
            }
    
    # Store memories in the default store
    for mem_id, mem_data in memories.items():
        store[mem_id] = mem_data
        print(f"Created memory: {mem_id}")
        print(f"  Content: {mem_data['content'][:50]}...")
    
    # Analyze memories to find the most related pair
    # memory1: "use the default store for quick notes"
    # memory2: "link closely related memories with semantic edges"
    # memory3: "this workspace is for a small mnemon demo task"
    #
    # memory1 and memory2 are most related - they both describe mnemon functionality
    # memory1 talks about the store, memory2 talks about linking (edges)
    
    print("\nLinking most related memories...")
    edge_id = create_edge(store, "memory1", "memory2", "semantic")
    print(f"Created edge: {edge_id}")
    print(f"  Connects: memory1 <-> memory2")
    
    # Output summary
    print("\n" + "="*50)
    print("MNEMON WORKSPACE SUMMARY")
    print("="*50)
    print(f"Store location: {store.path}")
    print(f"Memories stored: {len(store)}")
    for key in store.keys():
        print(f"  - {key}")
    
    # Create a summary file
    summary = {
        "workspace_initialized": True,
        "store_type": "file",
        "store_path": store.path,
        "memories": list(store.keys()),
        "edges": [{"source": "memory1", "target": "memory2", "type": "semantic"}]
    }
    
    summary_path = inputs_dir.parent / "mnemon_summary.json"
    summary_path.write_text(json.dumps(summary, indent=2), encoding="utf-8")
    print(f"\nSummary saved to: {summary_path}")
    
    return store


if __name__ == "__main__":
    main()
EOF
