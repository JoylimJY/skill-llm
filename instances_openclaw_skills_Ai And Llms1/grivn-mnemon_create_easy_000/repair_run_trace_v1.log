with open('/workspace/inputs/memory2.txt', 'r') as f:
    memory2_content = f.read().strip()

with open('/workspace/inputs/memory3.txt', 'r') as f:
    memory3_content = f.read().strip()

# Initialize mnemon workspace using default store (MnFile)
# Using mnc which provides the backend classes
from mnemon.mnemon import MnFile

with MnFile() as store:
    # Create three memories
    store['memory1'] = {
        'content': memory1_content,
        'type': 'preference',
        'source': 'inputs/memory1.txt'
    }
    
    store['memory2'] = {
        'content': memory2_content,
        'type': 'decision',
        'source': 'inputs/memory2.txt'
    }
    
    store['memory3'] = {
        'content': memory3_content,
        'type': 'context',
        'source': 'inputs/memory3.txt'
    }
    
    # Link memory1 and memory2 with a semantic edge
    # These are most related as they both concern mnemon workspace configuration
    store['edge_memory1_memory2'] = {
        'type': 'semantic_edge',
        'from': 'memory1',
        'to': 'memory2',
        'relationship': 'related_configuration',
        'description': 'Both memories relate to mnemon workspace setup - memory1 specifies using default store, memory2 specifies linking related memories'
    }
    
    # Verify memories were created
    print("Memories created:")
    for key in ['memory1', 'memory2', 'memory3', 'edge_memory1_memory2']:
        print(f"  {key}: {store.get(key)}")

print("\nWorkspace initialized successfully!")
print(f"Store path: {store.path}")
