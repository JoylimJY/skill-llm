[EXECUTING bash]:
cat > /workspace/client.js << 'EOF'
/**
 * AAP WebSocket Client Demo
 * 
 * This client connects to an AAP WebSocket server and performs
 * verification with a solver.
 */

const WebSocket = require('ws');
const crypto = require('crypto');

// Configuration
const SERVER_URL = 'ws://localhost:3000/aap';

// Simple solver implementation for verification
class VerificationSolver {
    constructor(privateKey, publicKey) {
        this.privateKey = privateKey;
        this.publicKey = publicKey;
    }
    
    /**
     * Generate a signature for the given payload
     * This is a mock implementation - in production use proper crypto
     */
    sign(payload) {
        const data = typeof payload === 'string' ? payload : JSON.stringify(payload);
        // Create a simple hash-based signature for demo
        const hash = crypto.createHash('sha256');
        hash.update(data + this.privateKey);
        return hash.digest('hex');
    }
    
    /**
     * Run verification with the solver
     */
    verify(payload) {
        const signature = this.sign(payload);
        return {
            publicId: this.publicKey,
            signature: signature,
            payload: payload
        };
    }
}

// Generate demo key pair
function generateKeyPair() {
    const privateKey = crypto.randomBytes(32).toString('hex');
    const publicKey = crypto.createHash('sha256').update(privateKey).digest('hex');
    return { privateKey, publicKey };
}

// Create solver with generated keys
const keys = generateKeyPair();
const solver = new VerificationSolver(keys.privateKey, keys.publicKey);

console.log('AAP WebSocket Client Demo');
console.log('=========================');
console.log(`Connecting to: ${SERVER_URL}`);
console.log(`Public ID: ${keys.publicKey}`);
console.log(`Solver: VerificationSolver (SHA-256 based)`);
console.log('');

// Create WebSocket connection
const ws = new WebSocket(SERVER_URL);

ws.on('open', () => {
    console.log('[Client] Connected to server');
    
    // Send hello message
    ws.send(JSON.stringify({ type: 'hello' }));
    
    // Send verification request with solver
    setTimeout(() => {
        console.log('[Client] Running verification with solver...');
        const verification = solver.verify({
            action: 'verify_client',
            timestamp: new Date().toISOString(),
            clientId: `client-${Date.now()}`
        });
        
        ws.send(JSON.stringify({
            type: 'verify',
            ...verification
        }));
    }, 1000);
    
    // Create a session
    setTimeout(() => {
        console.log('[Client] Creating session...');
        ws.send(JSON.stringify({
            type: 'create_session',
            agent: 'demo-agent'
        }));
    }, 2000);
    
    // Send a turn
    setTimeout(() => {
        console.log('[Client] Sending turn...');
        ws.send(JSON.stringify({
            type: 'turn',
            messages: [{
                role: 'user',
                content: 'Hello, how are you?'
            }]
        }));
    }, 3000);
    
    // Send another verification after some time
    setTimeout(() => {
        console.log('[Client] Running additional verification...');
        const verification = solver.verify({
            action: 'verify_again',
            timestamp: new Date().toISOString()
        });
        
        ws.send(JSON.stringify({
            type: 'verify',
            ...verification
        }));
    }, 5000);
});

ws.on('message', (data) => {
    try {
        const message = JSON.parse(data.toString());
        console.log(`[Client] Received:`, JSON.stringify(message, null, 2));
        
        switch (message.type) {
            case 'hello_response':
                console.log(`[Client] Server response: ${message.server} v${message.version}`);
                console.log(`[Client] Server requires signature: ${message.requireSignature}`);
                break;
                
            case 'verification_result':
                if (message.verified) {
                    console.log(`[Client] ✓ Verification successful for public ID: ${message.publicId}`);
                } else {
                    console.log(`[Client] ✗ Verification failed: ${message.error}`);
                }
                break;
                
            case 'session_created':
                console.log(`[Client] Session created: ${message.sessionId}`);
                break;
                
            case 'turn_response':
                console.log(`[Client] Turn response received`);
                message.messages.forEach(msg => {
                    console.log(`  - ${msg.role}: ${msg.content}`);
                });
                break;
                
            case 'meta':
                console.log(`[Client] Server meta received`);
                console.log(`  - Version: ${message.version}`);
                console.log(`  - Agents: ${message.agents.length}`);
                console.log(`  - Require Signature: ${message.requireSignature}`);
                if (message.supportedSignatures) {
                    console.log(`  - Supported Signatures: ${message.supportedSignatures.join(', ')}`);
                }
                break;
                
            case 'error':
                console.log(`[Client] Error: ${message.message}`);
                break;
        }
    } catch (error) {
        console.error(`[Client] Error parsing message:`, error.message);
    }
});

ws.on('close', () => {
    console.log('[Client] Connection closed');
});

ws.on('error', (error) => {
    console.error(`[Client] Error:`, error.message);
    console.error('Make sure the server is running on ws://localhost:3000/aap');
});

// Handle Ctrl+C
process.on('SIGINT', () => {
    console.log('\n[Client] Closing connection...');
    ws.close();
    process.exit(0);
});

process.on('SIGTERM', () => {
    console.log('\n[Client] Closing connection...');
    ws.close();
    process.exit(0);
});
