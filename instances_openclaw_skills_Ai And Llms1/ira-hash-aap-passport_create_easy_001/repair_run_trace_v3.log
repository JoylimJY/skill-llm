/**
 * AAP WebSocket Server Demo
 * 
 * This is a simple AAP (Agent Application Protocol) WebSocket server
 * that supports signature verification and logs verified public IDs.
 */

const WebSocket = require('ws');

// Configuration
const PORT = 3000;
const PATH = '/aap';

// Store for verified public IDs
const verifiedPublicIds = new Set();

// Simple signature verification (mock implementation for demo)
// In production, you would use proper cryptographic verification
function verifySignature(message, signature, publicKey) {
    // This is a simplified verification for demo purposes
    // In real implementation, use crypto library to verify the signature
    if (!signature || !publicKey) {
        return false;
    }
    // Mock verification - accept any valid-looking signature for demo
    return typeof signature === 'string' && signature.length > 0;
}

// Create WebSocket server
const wss = new WebSocket.Server({ 
    port: PORT, 
    path: PATH,
    verifyClient: (info, callback) => {
        // Allow all connections for demo purposes
        callback(true);
    }
});

console.log(`AAP WebSocket Server started on ws://localhost:${PORT}${PATH}`);
console.log(`requireSignature: enabled`);

wss.on('connection', (ws, req) => {
    const clientId = `client-${Date.now()}`;
    console.log(`[Server] New connection: ${clientId}`);
    
    // Send welcome message with server capabilities
    const serverMeta = {
        type: 'meta',
        version: 1,
        agents: [
            {
                name: 'demo-agent',
                title: 'AAP Demo Agent',
                version: '1.0.0',
                description: 'A demo agent for AAP WebSocket protocol',
                capabilities: {
                    history: { compacted: {} },
                    stream: { delta: {} }
                }
            }
        ],
        requireSignature: true,
        supportedSignatures: ['ed25519', 'secp256k1']
    };
    
    ws.send(JSON.stringify(serverMeta));
    console.log(`[Server] Sent meta to ${clientId}`);
    
    ws.on('message', (data) => {
        try {
            const message = JSON.parse(data.toString());
            console.log(`[Server] Received from ${clientId}:`, message.type || 'unknown');
            
            // Handle signature verification
            if (message.signature && message.publicId) {
                const isValid = verifySignature(
                    message.payload || message,
                    message.signature,
                    message.publicId
                );
                
                if (isValid) {
                    verifiedPublicIds.add(message.publicId);
                    console.log(`[Server] Verified public ID: ${message.publicId}`);
                    
                    // Send verification confirmation
                    ws.send(JSON.stringify({
                        type: 'verification_result',
                        verified: true,
                        publicId: message.publicId,
                        timestamp: new Date().toISOString()
                    }));
                } else {
                    console.log(`[Server] Signature verification failed for public ID: ${message.publicId}`);
                    ws.send(JSON.stringify({
                        type: 'verification_result',
                        verified: false,
                        publicId: message.publicId,
                        error: 'Invalid signature',
                        timestamp: new Date().toISOString()
                    }));
                }
            }
            
            // Handle different message types
            switch (message.type) {
                case 'hello':
                    ws.send(JSON.stringify({
                        type: 'hello_response',
                        server: 'AAP WebSocket Server',
                        version: '1.0.0',
                        requireSignature: true
                    }));
                    break;
                    
                case 'create_session':
                    const sessionId = `session-${Date.now()}`;
                    ws.send(JSON.stringify({
                        type: 'session_created',
                        sessionId,
                        timestamp: new Date().toISOString()
                    }));
                    break;
                    
                case 'turn':
                    ws.send(JSON.stringify({
                        type: 'turn_response',
                        messages: [{
                            role: 'assistant',
                            content: 'Hello! This is a demo response from the AAP WebSocket server.'
                        }],
                        timestamp: new Date().toISOString()
                    }));
                    break;
                    
                case 'verify':
                    // Handle explicit verification request
                    if (message.publicId) {
                        const isValid = verifySignature(
                            message.payload,
                            message.signature,
                            message.publicId
                        );
                        
                        if (isValid) {
                            verifiedPublicIds.add(message.publicId);
                            console.log(`[Server] Verified public ID: ${message.publicId}`);
                        }
                        
                        ws.send(JSON.stringify({
                            type: 'verification_result',
                            verified: isValid,
                            publicId: message.publicId
                        }));
                    }
                    break;
                    
                default:
                    ws.send(JSON.stringify({
                        type: 'error',
                        message: `Unknown message type: ${message.type}`
                    }));
            }
            
        } catch (error) {
            console.error(`[Server] Error processing message from ${clientId}:`, error.message);
            ws.send(JSON.stringify({
                type: 'error',
                message: 'Failed to parse message'
            }));
        }
    });
    
    ws.on('close', () => {
        console.log(`[Server] Connection closed: ${clientId}`);
    });
    
    ws.on('error', (error) => {
        console.error(`[Server] Error from ${clientId}:`, error.message);
    });
});

// Log all verified public IDs periodically
setInterval(() => {
    if (verifiedPublicIds.size > 0) {
        console.log(`[Server] Currently verified public IDs:`, Array.from(verifiedPublicIds));
    }
}, 30000);

// Graceful shutdown
process.on('SIGINT', () => {
    console.log('\n[Server] Shutting down...');
    wss.close(() => {
        console.log('[Server] Server closed');
        process.exit(0);
    });
});

process.on('SIGTERM', () => {
    console.log('\n[Server] Shutting down...');
    wss.close(() => {
        console.log('[Server] Server closed');
        process.exit(0);
    });
});
