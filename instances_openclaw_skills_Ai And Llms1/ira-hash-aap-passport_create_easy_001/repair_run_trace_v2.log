/**
 * AAP WebSocket Client
 * 
 * This demo client connects to the AAP WebSocket server and runs verification
 * with a solver. It connects to ws://localhost:3000/aap.
 */

const WebSocket = require('ws');
const crypto = require('crypto');

const SERVER_URL = 'ws://localhost:3000/aap';

// Generate a simple public ID for the client
function generatePublicId() {
    return crypto.randomBytes(16).toString('hex');
}

// Generate a signature for the message
function generateSignature(message, secretKey) {
    return crypto
        .createHash('sha256')
        .update(JSON.stringify(message) + secretKey)
        .digest('hex');
}

// Solver implementation for verification
class Solver {
    constructor(name) {
        this.name = name;
        this.secretKey = crypto.randomBytes(32).toString('hex');
    }
    
    solve(input) {
        // Simple solver that processes input
        console.log(`[${this.name}] Solving: ${JSON.stringify(input)}`);
        return {
            result: `Solved by ${this.name}`,
            input,
            timestamp: new Date().toISOString()
        };
    }
    
    sign(message) {
        return generateSignature(message, this.secretKey);
    }
}

// Create the client
async function main() {
    const publicId = generatePublicId();
    const solver = new Solver('DemoSolver');
    
    console.log(`AAP WebSocket Client`);
    console.log(`Public ID: ${publicId}`);
    console.log(`Connecting to: ${SERVER_URL}\n`);
    
    const ws = new WebSocket(SERVER_URL);
    
    ws.on('open', () => {
        console.log('Connected to server!');
        
        // Send hello message with signature
        const helloMessage = {
            type: 'hello',
            publicId: publicId,
            client: 'AAP Demo Client',
            version: '1.0.0'
        };
        helloMessage.signature = solver.sign(helloMessage);
        
        ws.send(JSON.stringify(helloMessage));
        console.log('Sent hello message with signature');
    });
    
    ws.on('message', (data) => {
        try {
            const message = JSON.parse(data.toString());
            console.log('\nReceived response:', JSON.stringify(message, null, 2));
            
            if (message.type === 'hello') {
                console.log(`\nServer info:`);
                console.log(`  Server: ${message.server}`);
                console.log(`  Version: ${message.version}`);
                console.log(`  Requires Signature: ${message.requireSignature}`);
                
                // Run verification with solver
                runVerification(ws, solver, publicId, message.requireSignature);
            } else if (message.type === 'verified') {
                console.log(`\nVerification complete!`);
                console.log(`  Public ID: ${message.publicId}`);
                console.log(`  Verified: ${message.verified}`);
            } else if (message.type === 'solver_response') {
                console.log(`\nSolver response received!`);
                console.log(`  Verified: ${message.verified}`);
                console.log(`  Public ID: ${message.publicId}`);
                console.log(`  Timestamp: ${message.timestamp}`);
            } else if (message.type === 'error') {
                console.error(`\nError from server: ${message.error}`);
            }
            
        } catch (err) {
            console.error('Error parsing message:', err.message);
        }
    });
    
    ws.on('close', () => {
        console.log('\nConnection closed');
        process.exit(0);
    });
    
    ws.on('error', (err) => {
        console.error('WebSocket error:', err.message);
    });
}

// Run verification with solver
function runVerification(ws, solver, publicId, requireSignature) {
    console.log(`\nRunning verification with solver...`);
    
    // Create verification request
    const verifyMessage = {
        type: 'verify',
        publicId: publicId,
        solver: solver.name
    };
    
    // Add signature if required
    if (requireSignature) {
        verifyMessage.signature = solver.sign(verifyMessage);
    }
    
    ws.send(JSON.stringify(verifyMessage));
    console.log('Sent verification request');
    
    // Run solver verification
    const solverMessage = {
        type: 'solver',
        publicId: publicId,
        solver: solver.name,
        task: 'verification'
    };
    
    if (requireSignature) {
        solverMessage.signature = solver.sign(solverMessage);
    }
    
    ws.send(JSON.stringify(solverMessage));
    console.log('Sent solver verification request');
    
    // Run the solver locally as well
    const result = solver.solve({ task: 'verification', publicId });
    console.log(`Solver result: ${JSON.stringify(result)}`);
}

// Run the client
main().catch(console.error);
