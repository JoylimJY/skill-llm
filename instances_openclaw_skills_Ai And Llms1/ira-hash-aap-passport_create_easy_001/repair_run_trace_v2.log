cat > /workspace/server.js << 'EOF'
/**
 * AAP WebSocket Server
 * 
 * This demo server implements the Agent Application Protocol (AAP) over WebSocket.
 * It runs on port 3000 with the path /aap and has requireSignature enabled.
 * Verified public IDs are logged to the console.
 */

const WebSocket = require('ws');
const crypto = require('crypto');

const PORT = 3000;
const PATH = '/aap';
const REQUIRE_SIGNATURE = true;

// Store for verified public IDs
const verifiedPublicIds = new Set();

// Simple signature verification function
function verifySignature(message, signature, publicKey) {
    try {
        const expectedSignature = crypto
            .createHash('sha256')
            .update(JSON.stringify(message))
            .digest('hex');
        
        // In a real implementation, this would verify the cryptographic signature
        // For demo purposes, we accept signatures that are not empty
        return signature && signature.length > 0;
    } catch (err) {
        console.error('Signature verification error:', err.message);
        return false;
    }
}

// Create WebSocket server
const wss = new WebSocket.Server({ 
    port: PORT, 
    path: PATH 
});

console.log(`AAP WebSocket server started on ws://localhost:${PORT}${PATH}`);
console.log(`requireSignature: ${REQUIRE_SIGNATURE}`);

wss.on('connection', (ws, req) => {
    console.log('New client connected');
    
