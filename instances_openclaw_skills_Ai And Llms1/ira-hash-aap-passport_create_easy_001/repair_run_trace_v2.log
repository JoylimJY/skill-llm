    let clientVerified = false;
    
    ws.on('message', (data) => {
        try {
            const message = JSON.parse(data.toString());
            console.log('Received message:', JSON.stringify(message, null, 2));
            
            // Check if signature is required and present
            if (REQUIRE_SIGNATURE) {
                if (!message.signature) {
                    ws.send(JSON.stringify({
                        type: 'error',
                        error: 'Signature required but not provided'
                    }));
                    return;
                }
                
                // Verify the signature
                const isValid = verifySignature(
                    message,
                    message.signature,
                    message.publicId
                );
                
                if (isValid) {
                    clientPublicId = message.publicId;
                    clientVerified = true;
                    
                    if (!verifiedPublicIds.has(message.publicId)) {
                        verifiedPublicIds.add(message.publicId);
                        console.log(`[VERIFIED] Public ID: ${message.publicId}`);
                    }
                } else {
                    ws.send(JSON.stringify({
                        type: 'error',
                        error: 'Invalid signature'
                    }));
                    return;
                }
            }
            
            // Handle different message types
            if (message.type === 'hello') {
                ws.send(JSON.stringify({
                    type: 'hello',
                    server: 'AAP WebSocket Server',
                    version: '1.0.0',
                    requireSignature: REQUIRE_SIGNATURE
                }));
            } else if (message.type === 'verify') {
                ws.send(JSON.stringify({
                    type: 'verified',
                    publicId: message.publicId || 'unknown',
                    verified: clientVerified
                }));
            } else if (message.type === 'solver') {
                // Handle solver verification request
                ws.send(JSON.stringify({
                    type: 'solver_response',
                    verified: clientVerified,
                    publicId: message.publicId || 'unknown',
                    timestamp: new Date().toISOString()
                }));
            } else {
                ws.send(JSON.stringify({
                    type: 'ack',
                    message: 'Message received',
                    verified: clientVerified
                }));
            }
            
        } catch (err) {
            console.error('Error processing message:', err.message);
            ws.send(JSON.stringify({
                type: 'error',
                error: err.message
            }));
        }
    });
    
    ws.on('close', () => {
        console.log('Client disconnected');
        if (clientPublicId && verifiedPublicIds.has(clientPublicId)) {
            verifiedPublicIds.delete(clientPublicId);
        }
    });
    
    ws.on('error', (err) => {
        console.error('WebSocket error:', err.message);
    });
});

// Handle server errors
wss.on('error', (err) => {
    console.error('Server error:', err.message);
});

// Graceful shutdown
process.on('SIGINT', () => {
    console.log('Shutting down server...');
    wss.close(() => {
        console.log('Server closed');
        process.exit(0);
    });
});

module.exports = { wss, PORT, PATH, REQUIRE_SIGNATURE };
