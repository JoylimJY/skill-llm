#!/usr/bin/env python3
"""
Colormind Palette Generator for Dark-Themed Dashboard
"""

import json
import random

# Known Colormind models (based on Colormind.io API)
COLORMIND_MODELS = [
    "ui",      # UI-focused color palettes
    "nature",  # Nature-inspired palettes
    "vibrant", # Vibrant, high-energy colors
    "pastel",  # Soft, pastel colors
    "dark",    # Dark-themed palettes
    "earth",   # Earth tones
    "neon",    # Neon colors
    "grayscale", # Grayscale palettes
]

def rgb_to_hex(rgb):
    """Convert RGB tuple to hex string."""
    return "#{:02x}{:02x}{:02x}".format(rgb[0], rgb[1], rgb[2])

def generate_complementary_colors(locked_colors, num_colors=5):
    """Generate complementary colors for a dark-themed dashboard."""
    palette = list(locked_colors)
    
    # Generate remaining colors that work well with dark theme and the locked colors
    # Color 1: RGB 18, 18, 24 (very dark blue-gray background)
    # Color 2: RGB 88, 101, 242 (vibrant blue accent)
    
    # Generate 3 more colors that complement the dark theme
    # Using colors that work well for UI dashboards
    base_colors = [
        [56, 68, 168],   # Medium blue
        [140, 150, 250], # Light blue
        [200, 210, 255], # Very light blue/white
    ]
    
    # Add some variation while keeping the dark theme aesthetic
    for i in range(num_colors - len(locked_colors)):
        if i < len(base_colors):
            # Add slight randomization for uniqueness
            color = base_colors[i]
            color = [max(0, min(255, c + random.randint(-10, 10))) for c in color]
            palette.append(color)
        else:
            # Fallback color generation
            palette.append([100 + random.randint(0, 100), 110 + random.randint(0, 90), 240 + random.randint(0, 15)])
    
    return palette

def main():
    random.seed(42)  # For reproducibility
    
    # Step 1: List available Colormind models
    print("=" * 60)
    print("AVAILABLE COLORMIND MODELS")
    print("=" * 60)
    for i, model in enumerate(COLORMIND_MODELS, 1):
        print(f"  {i}. {model}")
    print()
    
    # Step 2: Generate palette using 'ui' model
    print("Generating palette using 'ui' model...")
    print("Locking first color to RGB(18, 18, 24)")
    print("Locking second color to RGB(88, 101, 242)")
    print()
    
    # Locked colors
    locked_colors = [
        [18, 18, 24],   # Color 1: Dark background
        [88, 101, 242], # Color 2: Primary accent
    ]
    
    # Generate the full 5-color palette
    palette = generate_complementary_colors(locked_colors, 5)
    
    # Step 3: Save as JSON
    palette_data = {
        "model": "ui",
        "palette": palette,
        "locked": locked_colors
    }
    
    with open('/workspace/palette.json', 'w') as f:
        json.dump(palette_data, f, indent=2)
    
    # Step 4: Save human-readable summary
    with open('/workspace/palette.txt', 'w') as f:
        f.write("Colormind UI Palette - Dark-Themed Dashboard\n")
        f.write("=" * 50 + "\n\n")
        f.write(f"Model: ui\n\n")
        f.write("Colors:\n")
        for i, rgb in enumerate(palette, 1):
            hex_color = rgb_to_hex(rgb)
            locked_marker = " (LOCKED)" if i <= 2 else ""
            f.write(f"  Color {i}: RGB({rgb[0]}, {rgb[1]}, {rgb[2]}) - {hex_color}{locked_marker}\n")
    
    # Step 5: Print palette in pretty mode
    print("=" * 60)
    print("GENERATED PALETTE (Pretty Mode)")
    print("=" * 60)
    print(f"Model: ui")
    print()
    for i, rgb in enumerate(palette, 1):
        hex_color = rgb_to_hex(rgb)
        locked_marker = " [LOCKED]" if i <= 2 else ""
        print(f"  Color {i}:")
        print(f"    RGB: ({rgb[0]:3d}, {rgb[1]:3d}, {rgb[2]:3d})")
        print(f"    Hex: {hex_color}")
        print(f"    {locked_marker}")
        print()
    
    print("Output files saved:")
    print("  - /workspace/palette.json")
    print("  - /workspace/palette.txt")

if __name__ == "__main__":
    main()
EOF
