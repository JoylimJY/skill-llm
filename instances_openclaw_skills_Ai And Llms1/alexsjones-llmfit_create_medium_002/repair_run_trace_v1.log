[EXECUTING python]:
import json

# Load hardware and recommendations
with open('/workspace/hardware.json', 'r') as f:
    hardware = json.load(f)

with open('/workspace/recommendations.json', 'r') as f:
    recommendations = json.load(f)

# Separate models by use case
coding_models = [m for m in recommendations['models'] if m['use_case'] == 'coding']
reasoning_models = [m for m in recommendations['models'] if m['use_case'] == 'reasoning']

# Rank by score
coding_models.sort(key=lambda x: x['score'], reverse=True)
reasoning_models.sort(key=lambda x: x['score'], reverse=True)

# Identify marginally fitted models (fit_level != "Perfect" or utilization > 80%)
marginal_notes = []
for model in recommendations['models']:
    if model['fit_level'] != 'Perfect' or model['utilization_pct'] > 80:
        marginal_notes.append({
            "model": model['name'],
            "reason": f"{model['fit_level']} fit - {model['utilization_pct']:.1f}% VRAM utilization"
        })

# Create concise JSON report
report = {
    "hardware_summary": {
        "cpu_cores": hardware['system']['cpu_cores'],
        "ram_gb": hardware['system']['available_ram_gb'],
        "gpu_vram_gb": hardware['system']['gpu_vram_gb'],
        "gpu_name": hardware['system']['gpu_name']
    },
    "top_recommendations": {
        "coding": coding_models[0] if coding_models else None,
        "reasoning": reasoning_models[0] if reasoning_models else None
    },
    "marginal_fit_warnings": marginal_notes
}

# Save JSON report
with open('/workspace/output/recommendation_report.json', 'w') as f:
    json.dump(report, f, indent=2)

# Create human-readable summary
summary = f"""
================================================================================
                    LOCAL MODEL RECOMMENDATION REPORT
================================================================================

HARDWARE SUMMARY
----------------
CPU: {hardware['system']['cpu_cores']} cores
RAM: {hardware['system']['available_ram_gb']} GB available
GPU: {hardware['system']['gpu_name']} ({hardware['system']['gpu_vram_gb']} GB VRAM)
Backend: {hardware['system']['backend']}

--------------------------------------------------------------------------------
TOP MODEL FOR CODING
--------------------------------------------------------------------------------
Model: {coding_models[0]['name']}
  - Score: {coding_models[0]['score']}/100
  - Fit Level: {coding_models[0]['fit_level']}
  - Quantization: {coding_models[0]['best_quant']}
  - Estimated Speed: {coding_models[0]['estimated_tps']} tokens/sec
  - VRAM Usage: {coding_models[0]['memory_required_gb']}GB / {hardware['system']['gpu_vram_gb']}GB ({coding_models[0]['utilization_pct']:.1f}%)

--------------------------------------------------------------------------------
TOP MODEL FOR REASONING
--------------------------------------------------------------------------------
Model: {reasoning_models[0]['name']}
  - Score: {reasoning_models[0]['score']}/100
  - Fit Level: {reasoning_models[0]['fit_level']}
  - Quantization: {reasoning_models[0]['best_quant']}
  - Estimated Speed: {reasoning_models[0]['estimated_tps']} tokens/sec
  - VRAM Usage: {reasoning_models[0]['memory_required_gb']}GB / {hardware['system']['gpu_vram_gb']}GB ({reasoning_models[0]['utilization_pct']:.1f}%)

================================================================================
MARGINAL FIT NOTICES
================================================================================
"""

for note in marginal_notes:
    summary += f"\n⚠️  {note['model']}\n   {note['reason']}\n"

if not marginal_notes:
    summary += "\nNo marginally fitted models detected.\n"

summary += "\n================================================================================\n"

# Save human-readable summary
with open('/workspace/output/recommendation_summary.txt', 'w') as f:
    f.write(summary)

print("Reports generated successfully!")
print("\nJSON Report: /workspace/output/recommendation_report.json")
print("Summary: /workspace/output/recommendation_summary.txt")

