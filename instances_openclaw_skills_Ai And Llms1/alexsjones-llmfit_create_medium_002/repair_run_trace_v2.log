[EXECUTING python]:
import json
import os

# Load the recommendations data
with open('/workspace/recommendations.json', 'r') as f:
    data = json.load(f)

# Load hardware for context
with open('/workspace/hardware.json', 'r') as f:
    hardware = json.load(f)

# Sort models by score
models = sorted(data['models'], key=lambda x: x['score'], reverse=True)

# Separate by use case
coding_models = [m for m in models if m['use_case'] == 'coding']
reasoning_models = [m for m in models if m['use_case'] == 'reasoning']
general_models = [m for m in models if m['use_case'] == 'general']

# Check for marginally fitted models (fit_level not "Perfect")
marginal_notes = []
for m in models:
    if m['fit_level'] != 'Perfect':
        marginal_notes.append(f"- {m['name']}: {m['fit_level']} fit ({m['utilization_pct']}% VRAM utilization)")

# Create JSON report
json_report = {
    "hardware_summary": {
        "cpu_cores": hardware['system']['cpu_cores'],
        "available_ram_gb": hardware['system']['available_ram_gb'],
        "gpu_vram_gb": hardware['system']['gpu_vram_gb'],
        "gpu_backend": hardware['system']['backend']
    },
    "ranked_recommendations": {
        "coding": [
            {
                "rank": i+1,
                "model": m['name'],
                "score": m['score'],
                "estimated_tps": m['estimated_tps'],
                "best_quant": m['best_quant']
            }
            for i, m in enumerate(coding_models)
        ],
        "reasoning": [
            {
                "rank": i+1,
                "model": m['name'],
                "score": m['score'],
                "estimated_tps": m['estimated_tps'],
                "best_quant": m['best_quant']
            }
            for i, m in enumerate(reasoning_models)
        ]
    },
    "marginal_fit_notes": marginal_notes if marginal_notes else "All recommended models have excellent fit."
}

# Save JSON report
os.makedirs('/workspace/output', exist_ok=True)
with open('/workspace/output/report.json', 'w') as f:
    json.dump(json_report, f, indent=2)

# Create human-readable summary
summary = f"""
=== LOCAL MODEL RECOMMENDATION REPORT ===

HARDWARE SUMMARY:
- CPU: {hardware['system']['cpu_cores']} cores
- RAM: {hardware['system']['available_ram_gb']}GB available
- GPU: {hardware['system']['gpu_name']} ({hardware['system']['gpu_vram_gb']}GB VRAM, {hardware['system']['backend']})

--- TOP PICK FOR CODING ---
"""

if coding_models:
    m = coding_models[0]
    summary += f"""
1. {m['name']}
   - Score: {m['score']}/100
   - Params: {m['params_b']}B | Quant: {m['best_quant']}
   - Speed: ~{m['estimated_tps']} tokens/sec
   - Fit: {m['fit_level']} ({m['utilization_pct']}% VRAM)
   - Context: {m['context_length']} tokens
"""

summary += "\n--- TOP PICK FOR REASONING ---\n"

if reasoning_models:
    m = reasoning_models[0]
    summary += f"""
1. {m['name']}
   - Score: {m['score']}/100
   - Params: {m['params_b']}B | Quant: {m['best_quant']}
   - Speed: ~{m['estimated_tps']} tokens/sec
   - Fit: {m['fit_level']} ({m['utilization_pct']}% VRAM)
   - Context: {m['context_length']} tokens
"""

if marginal_notes:
    summary += "\n--- MARGINAL FIT NOTES ---\n"
    summary += "\n".join(marginal_notes)
    summary += "\n\nNote: The above model(s) are at the edge of recommended usage.\nConsider lighter quantization or CPU offloading for better stability."

summary += "\n=== END REPORT ==="

# Save summary
with open('/workspace/output/summary.txt', 'w') as f:
    f.write(summary)

print("Reports generated successfully!")
print("\n" + summary)

