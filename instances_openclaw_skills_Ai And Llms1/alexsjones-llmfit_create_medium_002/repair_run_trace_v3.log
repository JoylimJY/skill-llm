[EXECUTING python]:
import json
import os

# Load input data
with open('/workspace/hardware.json', 'r') as f:
    hardware = json.load(f)

with open('/workspace/recommendations.json', 'r') as f:
    recommendations = json.load(f)

# Extract system specs
system = hardware['system']
gpu_vram = system['gpu_vram_gb']
available_ram = system['available_ram_gb']

# Separate models by use case and rank by score
coding_models = [m for m in recommendations['models'] if m['use_case'] == 'coding']
reasoning_models = [m for m in recommendations['models'] if m['use_case'] == 'reasoning']

coding_models.sort(key=lambda x: x['score'], reverse=True)
reasoning_models.sort(key=lambda x: x['score'], reverse=True)

# Identify marginally fitted models (>85% utilization)
marginally_fitted = []
for model in recommendations['models']:
    if model['utilization_pct'] > 85:
        marginally_fitted.append({
            'name': model['name'],
            'utilization_pct': model['utilization_pct'],
            'reason': 'High VRAM utilization may impact performance/stability'
        })

# Create concise JSON report
report = {
    "hardware_summary": {
        "cpu_cores": system['cpu_cores'],
        "ram_gb": system['total_ram_gb'],
        "gpu": f"{system['gpu_name']} ({gpu_vram}GB VRAM)"
    },
    "ranked_recommendations": {
        "coding": [
            {
                "rank": i+1,
                "name": m['name'],
                "score": m['score'],
                "estimated_tps": m['estimated_tps'],
                "fit_level": m['fit_level']
            }
            for i, m in enumerate(coding_models)
        ],
        "reasoning": [
            {
                "rank": i+1,
                "name": m['name'],
                "score": m['score'],
                "estimated_tps": m['estimated_tps'],
                "fit_level": m['fit_level']
            }
            for i, m in enumerate(reasoning_models)
        ]
    },
    "marginal_fit_warnings": marginally_fitted
}

# Save JSON report
os.makedirs('/workspace/output', exist_ok=True)
with open('/workspace/output/recommendation_report.json', 'w') as f:
    json.dump(report, f, indent=2)

# Create human-readable summary
summary_lines = [
    "=" * 60,
    "LOCAL MODEL RECOMMENDATION REPORT",
    "=" * 60,
    "",
    "HARDWARE SUMMARY:",
    f"  - CPU: {system['cpu_cores']} cores ({system['cpu_name']})",
    f"  - RAM: {system['total_ram_gb']}GB ({available_ram}GB available)",
    f"  - GPU: {system['gpu_name']} ({gpu_vram}GB VRAM, {system['backend']})",
    "",
    "-" * 60,
    "TOP RECOMMENDATIONS FOR CODING:",
    "-" * 60,
]

for i, m in enumerate(coding_models, 1):
    summary_lines.append(f"  {i}. {m['name']}")
    summary_lines.append(f"     Score: {m['score']} | TPS: ~{m['estimated_tps']} | Fit: {m['fit_level']}")
    summary_lines.append(f"     Recommended Quant: {m['best_quant']} | VRAM: {m['memory_required_gb']}GB")
    summary_lines.append("")

summary_lines.extend([
    "-" * 60,
    "TOP RECOMMENDATIONS FOR REASONING:",
    "-" * 60,
])

for i, m in enumerate(reasoning_models, 1):
    summary_lines.append(f"  {i}. {m['name']}")
    summary_lines.append(f"     Score: {m['score']} | TPS: ~{m['estimated_tps']} | Fit: {m['fit_level']}")
    summary_lines.append(f"     Recommended Quant: {m['best_quant']} | VRAM: {m['memory_required_gb']}GB")
    summary_lines.append("")

if marginally_fitted:
    summary_lines.extend([
        "!" * 60,
        "MARGINAL FIT WARNING:",
        "!" * 60,
    ])
    for mf in marginally_fitted:
        summary_lines.append(f"  ⚠️  {mf['name']}")
        summary_lines.append(f"      Utilization: {mf['utilization_pct']}% - {mf['reason']}")
        summary_lines.append("")

summary_lines.extend([
    "=" * 60,
    "END OF REPORT",
    "=" * 60,
])

summary = "\n".join(summary_lines)

with open('/workspace/output/recommendation_summary.txt', 'w') as f:
    f.write(summary)

print("Reports generated successfully!")
print("\n" + summary)

