[EXECUTING python]:
import json
import os
from pathlib import Path

# Paths
workspace = Path("/workspace")
tokenguard_dir = workspace / ".tokenguard"
limit_file = tokenguard_dir / "limit.json"
session_file = tokenguard_dir / "session.json"

# Output files
summary_txt = workspace / "tokenguard_summary.txt"
summary_json = workspace / "tokenguard_summary.json"

def generate_reports():
    # Check if session file exists
    if not session_file.exists():
        # No session data found
        txt_content = """
================================================================================
                        TOKENGUARD SESSION SUMMARY REPORT
================================================================================

NO SESSION DATA FOUND

The TokenGuard session file was not found. No cost tracking data is available
for the current session.

================================================================================
"""
        json_content = {
            "error": "No session data found",
            "session_file": str(session_file),
            "current_limit": None,
            "total_spent": None,
            "remaining_budget": None,
            "warning_threshold": None,
            "number_of_log_entries": None,
            "top_3_entries": []
        }
        
        with open(summary_txt, 'w') as f:
            f.write(txt_content)
        with open(summary_json, 'w') as f:
            json.dump(json_content, f, indent=2)
        print("Reports generated (no session data).")
        return

    # Read session data
    with open(session_file, 'r') as f:
        session = json.load(f)
    
    # Read limit data
    with open(limit_file, 'r') as f:
        limits = json.load(f)
    
    # Extract values
    current_limit = limits.get("limit", 0)
    currency = limits.get("currency", "USD")
    warning_pct = limits.get("warning_pct", 0.8)
    warning_threshold = current_limit * warning_pct
    total_spent = session.get("spent", 0)
    remaining_budget = current_limit - total_spent
    entries = session.get("entries", [])
    num_entries = len(entries)
    
    # Get top 3 most expensive entries
    sorted_entries = sorted(entries, key=lambda x: x.get("amount", 0), reverse=True)
    top_3 = sorted_entries[:3]
    
    # Generate human-readable report
    txt_lines = [
        "=" * 80,
        "                        TOKENGUARD SESSION SUMMARY REPORT",
        "=" * 80,
        "",
        f"Session Date: {session.get('date', 'N/A')}",
        "",
        "-" * 40,
        "BUDGET OVERVIEW",
        "-" * 40,
        f"  Current Limit:        ${current_limit:.2f} {currency}",
        f"  Total Spent:          ${total_spent:.2f} {currency}",
        f"  Remaining Budget:     ${remaining_budget:.2f} {currency}",
        f"  Warning Threshold:    ${warning_threshold:.2f} {currency} ({warning_pct*100:.0f}%)",
        f"  Number of Log Entries: {num_entries}",
        "",
        "-" * 40,
        "TOP 3 MOST EXPENSIVE LOG ENTRIES",
        "-" * 40,
    ]
    
    for i, entry in enumerate(top_3, 1):
        amount = entry.get("amount", 0)
        desc = entry.get("desc", "N/A")
        ts = entry.get("ts", "N/A")
        txt_lines.append(f"  {i}. ${amount:.2f} - {desc}")
        txt_lines.append(f"     Time: {ts}")
    
    txt_lines.extend([
        "",
        "=" * 80,
        "                              END OF REPORT",
        "=" * 80,
    ])
    
    txt_content = "\n".join(txt_lines)
    
    # Generate JSON report
    json_content = {
        "session_date": session.get("date"),
        "current_limit": current_limit,
        "currency": currency,
        "total_spent": total_spent,
        "remaining_budget": remaining_budget,
        "warning_threshold": warning_threshold,
        "number_of_log_entries": num_entries,
        "top_3_entries": [
            {
                "amount": e.get("amount"),
                "description": e.get("desc"),
                "timestamp": e.get("ts")
            } for e in top_3
        ]
    }
    
    # Write files
    with open(summary_txt, 'w') as f:
        f.write(txt_content)
    
    with open(summary_json, 'w') as f:
        json.dump(json_content, f, indent=2)
    
    print("Reports generated successfully!")
    print(f"  - {summary_txt}")
    print(f"  - {summary_json}")

if __name__ == "__main__":
    generate_reports()

