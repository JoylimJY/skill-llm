[EXECUTING python]:
import json
import os
from pathlib import Path

WORKSPACE = Path("/workspace")
TOKENGUARD_DIR = WORKSPACE / ".tokenguard"
LIMIT_FILE = TOKENGUARD_DIR / "limit.json"
SESSION_FILE = TOKENGUARD_DIR / "session.json"

def load_limit():
    """Load limit configuration."""
    if LIMIT_FILE.exists():
        with open(LIMIT_FILE, 'r') as f:
            return json.load(f)
    return None

def load_session():
    """Load session data."""
    if SESSION_FILE.exists():
        with open(SESSION_FILE, 'r') as f:
            return json.load(f)
    return None

def generate_reports():
    limit_data = load_limit()
    session_data = load_session()
    
    # Output paths
    txt_report_path = WORKSPACE / "tokenguard_summary.txt"
    json_report_path = WORKSPACE / "tokenguard_summary.json"
    
    if session_data is None:
        # No session data found
        txt_content = """================================================================================
                         TOKENGUARD SESSION SUMMARY REPORT
================================================================================

STATUS: No session data found

The TokenGuard session file was not found at: .tokenguard/session.json

No cost tracking data is available for this session.

================================================================================
"""
        json_content = {
            "status": "no_session_data",
            "message": "TokenGuard session file not found",
            "limit": None,
            "currency": None,
            "warning_threshold": None,
            "total_spent": None,
            "remaining_budget": None,
            "num_log_entries": None,
            "top_entries": []
        }
    else:
        # Extract values
        limit = limit_data["limit"] if limit_data else None
        currency = limit_data.get("currency", "USD") if limit_data else "USD"
        warning_pct = limit_data.get("warning_pct", 0.8) if limit_data else 0.8
        warning_threshold = limit * warning_pct if limit else None
        
        total_spent = session_data.get("spent", 0)
        remaining_budget = limit - total_spent if limit else None
        
        entries = session_data.get("entries", [])
        num_log_entries = len(entries)
        
        # Sort entries by amount descending and get top 3
        sorted_entries = sorted(entries, key=lambda x: x.get("amount", 0), reverse=True)
        top_3_entries = sorted_entries[:3]
        
        # Build human-readable report
        txt_lines = [
            "================================================================================",
            "                         TOKENGUARD SESSION SUMMARY REPORT",
            "================================================================================",
            "",
            f"Session Date: {session_data.get('date', 'N/A')}",
            "",
            "BUDGET OVERVIEW",
            "--------------------------------------------------------------------------------",
            f"  Current Limit:        ${limit:.2f} {currency}",
            f"  Total Spent:          ${total_spent:.2f}",
            f"  Remaining Budget:     ${remaining_budget:.2f}" if remaining_budget is not None else "  Remaining Budget:     N/A",
            f"  Warning Threshold:    ${warning_threshold:.2f} ({warning_pct*100:.0f}% of limit)",
            "",
            "LOG ENTRIES",
            "--------------------------------------------------------------------------------",
            f"  Total Number of Entries:  {num_log_entries}",
            "",
            "TOP 3 MOST EXPENSIVE ENTRIES",
            "--------------------------------------------------------------------------------",
        ]
        
        for i, entry in enumerate(top_3_entries, 1):
            amount = entry.get("amount", 0)
            desc = entry.get("desc", "N/A")
            ts = entry.get("ts", "N/A")
            txt_lines.append(f"  {i}. ${amount:.2f} - {desc}")
            txt_lines.append(f"       Timestamp: {ts}")
        
        txt_lines.extend([
            "",
            "================================================================================",
            "                              END OF REPORT",
            "================================================================================",
        ])
        
        txt_content = "\n".join(txt_lines)
        
        # Build JSON report
        json_content = {
            "session_date": session_data.get("date"),
            "limit": limit,
            "currency": currency,
            "warning_threshold": warning_threshold,
            "total_spent": total_spent,
            "remaining_budget": remaining_budget,
            "num_log_entries": num_log_entries,
            "top_3_entries": [
                {
                    "rank": i,
                    "amount": entry.get("amount"),
                    "description": entry.get("desc"),
                    "timestamp": entry.get("ts")
                }
                for i, entry in enumerate(top_3_entries, 1)
            ]
        }
    
    # Write files
    with open(txt_report_path, 'w') as f:
        f.write(txt_content)
    
    with open(json_report_path, 'w') as f:
        json.dump(json_content, f, indent=2)
    
    print(f"Reports generated successfully:")
    print(f"  - {txt_report_path}")
    print(f"  - {json_report_path}")

if __name__ == "__main__":
    generate_reports()

