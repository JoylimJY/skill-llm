[EXECUTING python]:
from pathlib import Path
import json

WORKSPACE = Path('/workspace')
TOKENGUARD_DIR = WORKSPACE / '.tokenguard'
LIMIT_FILE = TOKENGUARD_DIR / 'limit.json'
SESSION_FILE = TOKENGUARD_DIR / 'session.json'
SUMMARY_TXT = WORKSPACE / 'tokenguard_summary.txt'
SUMMARY_JSON = WORKSPACE / 'tokenguard_summary.json'

def load_json(path):
    try:
        return json.loads(path.read_text(encoding='utf-8'))
    except FileNotFoundError:
        return None
    except json.JSONDecodeError:
        return None

def generate_report():
    limit_data = load_json(LIMIT_FILE)
    session_data = load_json(SESSION_FILE)
    
    # Check if session data exists
    if session_data is None:
        # No session data found
        txt_report = """TokenGuard Session Summary
==========================

No session data was found.

The TokenGuard session file is missing or unreadable.
"""
        json_report = {
            "session_found": False,
            "error": "No session data found"
        }
    else:
        # Extract values
        current_limit = limit_data.get('limit', 0) if limit_data else 0
        currency = limit_data.get('currency', 'USD') if limit_data else 'USD'
        warning_pct = limit_data.get('warning_pct', 0.8) if limit_data else 0.8
        warning_threshold = current_limit * warning_pct
        
        total_spent = session_data.get('spent', 0)
        remaining_budget = current_limit - total_spent
        entries = session_data.get('entries', [])
        num_entries = len(entries)
        session_date = session_data.get('date', 'Unknown')
        
        # Sort entries by amount descending and get top 3
        sorted_entries = sorted(entries, key=lambda x: x.get('amount', 0), reverse=True)
        top_3 = sorted_entries[:3]
        
        # Build human-readable report
        lines = [
            "TokenGuard Session Summary",
            "==========================",
            "",
            f"Session Date: {session_date}",
            "",
            "Budget Overview",
            "---------------",
            f"Current Limit:       ${current_limit:.2f} {currency}",
            f"Total Spent:         ${total_spent:.2f} {currency}",
            f"Remaining Budget:    ${remaining_budget:.2f} {currency}",
            f"Warning Threshold:   ${warning_threshold:.2f} {currency} ({warning_pct*100:.0f}%)",
            "",
            "Log Statistics",
            "--------------",
            f"Number of Log Entries: {num_entries}",
            "",
            "Top 3 Most Expensive Entries",
            "----------------------------"
        ]
        
        for i, entry in enumerate(top_3, 1):
            amount = entry.get('amount', 0)
            desc = entry.get('desc', 'No description')
            ts = entry.get('ts', 'Unknown')
            lines.append(f"{i}. ${amount:.2f} - {desc}")
            lines.append(f"   Timestamp: {ts}")
            lines.append("")
        
        txt_report = "\n".join(lines)
        
        # Build JSON report
        json_report = {
            "session_found": True,
            "session_date": session_date,
            "current_limit": current_limit,
            "currency": currency,
            "total_spent": total_spent,
            "remaining_budget": remaining_budget,
            "warning_threshold": warning_threshold,
            "warning_pct": warning_pct,
            "num_log_entries": num_entries,
            "top_3_entries": [
                {
                    "amount": e.get('amount'),
                    "description": e.get('desc'),
                    "timestamp": e.get('ts')
                } for e in top_3
            ]
        }
    
    # Write files
    SUMMARY_TXT.write_text(txt_report, encoding='utf-8')
    SUMMARY_JSON.write_text(json.dumps(json_report, indent=2), encoding='utf-8')
    
    print("Reports generated successfully:")
    print(f"  - {SUMMARY_TXT}")
    print(f"  - {SUMMARY_JSON}")

if __name__ == '__main__':
    generate_report()

