[EXECUTING python]:
import json
import os
from pathlib import Path

# Paths
WORKSPACE = Path("/workspace")
TOKENGUARD_DIR = WORKSPACE / ".tokenguard"
LIMIT_FILE = TOKENGUARD_DIR / "limit.json"
SESSION_FILE = TOKENGUARD_DIR / "session.json"
SUMMARY_TXT = WORKSPACE / "tokenguard_summary.txt"
SUMMARY_JSON = WORKSPACE / "tokenguard_summary.json"

def load_json(path):
    """Load JSON file, return None if not found."""
    try:
        with open(path, 'r') as f:
            return json.load(f)
    except FileNotFoundError:
        return None

def main():
    # Load data
    limit_data = load_json(LIMIT_FILE)
    session_data = load_json(SESSION_FILE)
    
    # Check if session data is missing
    if session_data is None:
        # No session found - create empty reports
        txt_content = """
================================================================================
                        TOKENGUARD SESSION SUMMARY REPORT
================================================================================

No session data found.

The TokenGuard session file was not found at: .tokenguard/session.json

Please start a new session to begin tracking API costs.

================================================================================
"""
        json_content = {
            "error": "No session data found",
            "session_file": str(SESSION_FILE),
            "current_limit": None,
            "total_spent": None,
            "remaining_budget": None,
            "warning_threshold": None,
            "num_log_entries": None,
            "top_3_entries": []
        }
    else:
        # Extract values
        current_limit = limit_data.get("limit", 0) if limit_data else 0
        currency = limit_data.get("currency", "USD") if limit_data else "USD"
        warning_pct = limit_data.get("warning_pct", 0.8) if limit_data else 0.8
        
        total_spent = session_data.get("spent", 0)
        entries = session_data.get("entries", [])
        session_date = session_data.get("date", "N/A")
        
        remaining_budget = current_limit - total_spent
        warning_threshold = current_limit * warning_pct
        num_log_entries = len(entries)
        
        # Get top 3 most expensive entries
        sorted_entries = sorted(entries, key=lambda x: x.get("amount", 0), reverse=True)
        top_3 = sorted_entries[:3]
        
        # Build human-readable report
        lines = [
            "=" * 80,
            "                        TOKENGUARD SESSION SUMMARY REPORT",
            "=" * 80,
            "",
            f"Session Date: {session_date}",
            "",
            "-" * 40,
            "BUDGET OVERVIEW",
            "-" * 40,
            f"  Current Limit:       ${current_limit:.2f} {currency}",
            f"  Total Spent:         ${total_spent:.2f} {currency}",
            f"  Remaining Budget:    ${remaining_budget:.2f} {currency}",
            f"  Warning Threshold:   ${warning_threshold:.2f} {currency} ({warning_pct*100:.0f}% of limit)",
            "",
            "-" * 40,
            "LOG STATISTICS",
            "-" * 40,
            f"  Number of Log Entries: {num_log_entries}",
            "",
            "-" * 40,
            "TOP 3 MOST EXPENSIVE ENTRIES",
            "-" * 40,
        ]
        
        for i, entry in enumerate(top_3, 1):
            amount = entry.get("amount", 0)
            desc = entry.get("desc", "N/A")
            ts = entry.get("ts", "N/A")
            lines.append(f"  {i}. ${amount:.2f} - {desc}")
            lines.append(f"     Timestamp: {ts}")
        
        if not top_3:
            lines.append("  (No entries recorded)")
        
        lines.extend([
            "",
            "=" * 80,
            "                              END OF REPORT",
            "=" * 80,
        ])
        
        txt_content = "\n".join(lines)
        
        # Build JSON content
        json_content = {
            "session_date": session_date,
            "current_limit": current_limit,
            "currency": currency,
            "total_spent": total_spent,
            "remaining_budget": remaining_budget,
            "warning_threshold": warning_threshold,
            "warning_pct": warning_pct,
            "num_log_entries": num_log_entries,
            "top_3_entries": [
                {
                    "amount": e.get("amount"),
                    "desc": e.get("desc"),
                    "ts": e.get("ts")
                }
                for e in top_3
            ]
        }
    
    # Write files
    with open(SUMMARY_TXT, 'w') as f:
        f.write(txt_content)
    
    with open(SUMMARY_JSON, 'w') as f:
        json.dump(json_content, f, indent=2)
    
    print(f"Generated: {SUMMARY_TXT}")
    print(f"Generated: {SUMMARY_JSON}")

if __name__ == "__main__":
    main()

