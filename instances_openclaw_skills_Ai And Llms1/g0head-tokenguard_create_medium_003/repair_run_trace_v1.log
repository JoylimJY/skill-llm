#!/usr/bin/env python3
"""
TokenGuard Session Summary Report Generator

Reads TokenGuard session data and generates both human-readable and 
machine-readable summary reports.
"""

import json
import os
from pathlib import Path

# TokenGuard storage locations
TOKENGUARD_DIR = Path("/workspace/.tokenguard")
LIMIT_FILE = TOKENGUARD_DIR / "limit.json"
SESSION_FILE = TOKENGUARD_DIR / "session.json"

# Output files
TEXT_REPORT = Path("/workspace/tokenguard_summary.txt")
JSON_REPORT = Path("/workspace/tokenguard_summary.json")


def load_json_file(filepath):
    """Load and parse a JSON file."""
    try:
        with open(filepath, 'r') as f:
            return json.load(f)
    except FileNotFoundError:
        return None
    except json.JSONDecodeError as e:
        print(f"Warning: Invalid JSON in {filepath}: {e}")
        return None


def generate_report():
    """Generate TokenGuard session summary reports."""
    
    # Load data files
    limit_data = load_json_file(LIMIT_FILE)
    session_data = load_json_file(SESSION_FILE)
    
    # Check if we have any session data
    if session_data is None:
        # No session data found - create empty reports
        text_content = """
================================================================================
                        TOKENGUARD SESSION SUMMARY
================================================================================

NO SESSION DATA FOUND

The TokenGuard session file was not found or could not be read.
Please check that a session exists at: .tokenguard/session.json

================================================================================
"""
        json_content = {
            "session_found": False,
            "message": "No session data found",
            "current_limit": None,
            "total_spent": None,
            "remaining_budget": None,
            "warning_threshold": None,
            "number_of_log_entries": 0,
            "top_3_entries": []
        }
    else:
        # Extract values from session data
        total_spent = session_data.get("spent", 0)
        entries = session_data.get("entries", [])
        session_date = session_data.get("date", "N/A")
        
        # Extract values from limit data
        current_limit = limit_data.get("limit", 0) if limit_data else 0
        currency = limit_data.get("currency", "USD") if limit_data else "USD"
        warning_pct = limit_data.get("warning_pct", 0.8) if limit_data else 0.8
        
        # Calculate derived values
        remaining_budget = current_limit - total_spent
        warning_threshold = current_limit * warning_pct
        
        # Sort entries by amount (descending) to find top 3
        sorted_entries = sorted(entries, key=lambda x: x.get("amount", 0), reverse=True)
        top_3_entries = sorted_entries[:3]
        
        # Build human-readable report
        text_lines = [
            "=" * 80,
            "                        TOKENGUARD SESSION SUMMARY",
            "=" * 80,
            "",
            f"Session Date: {session_date}",
            "",
            "-" * 80,
            "BUDGET OVERVIEW",
            "-" * 80,
            f"  Current Limit:        ${current_limit:.2f} {currency}",
            f"  Total Spent:          ${total_spent:.2f} {currency}",
            f"  Remaining Budget:     ${remaining_budget:.2f} {currency}",
            f"  Warning Threshold:    ${warning_threshold:.2f} {currency} ({warning_pct*100:.0f}% of limit)",
            "",
            "-" * 80,
            "LOG ENTRIES",
            "-" * 80,
            f"  Number of Log Entries: {len(entries)}",
            "",
            "-" * 80,
            "TOP 3 MOST EXPENSIVE ENTRIES",
            "-" * 80,
        ]
        
        for i, entry in enumerate(top_3_entries, 1):
            amount = entry.get("amount", 0)
            desc = entry.get("desc", "No description")
            ts = entry.get("ts", "N/A")
            text_lines.append(f"  {i}. ${amount:.2f} - {desc}")
            text_lines.append(f"      Timestamp: {ts}")
        
        text_lines.extend([
            "",
            "=" * 80,
            "                           END OF REPORT",
            "=" * 80,
            "",
        ])
        
        text_content = "\n".join(text_lines)
        
        # Build machine-readable JSON report
        json_content = {
            "session_found": True,
            "session_date": session_date,
            "current_limit": current_limit,
            "currency": currency,
            "total_spent": total_spent,
            "remaining_budget": remaining_budget,
            "warning_threshold": warning_threshold,
            "warning_pct": warning_pct,
            "number_of_log_entries": len(entries),
            "top_3_entries": [
                {
                    "amount": e.get("amount"),
                    "desc": e.get("desc"),
                    "ts": e.get("ts")
                }
                for e in top_3_entries
            ]
        }
    
    # Write text report
    with open(TEXT_REPORT, 'w') as f:
        f.write(text_content)
    print(f"Text report saved to: {TEXT_REPORT}")
    
    # Write JSON report
    with open(JSON_REPORT, 'w') as f:
        json.dump(json_content, f, indent=2)
    print(f"JSON report saved to: {JSON_REPORT}")


if __name__ == "__main__":
    generate_report()
EOF

