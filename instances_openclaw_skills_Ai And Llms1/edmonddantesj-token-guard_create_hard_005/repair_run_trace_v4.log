"""TokenGuard - LLM API 429 Prevention Engine"""

import time
import re
from collections import defaultdict
from dataclasses import dataclass, field
from typing import Optional


@dataclass
class Decision:
    action: str  # proceed, wait, fallback, block
    estimated_tokens: int
    wait_seconds: float = 0
    fallback_model: Optional[str] = None
    reason: str = ""


class TokenGuard:
    """TokenGuard engine for LLM rate limiting and quota management."""
    
    # Model TPM (tokens per minute) limits
    MODEL_LIMITS = {
        "gemini-3-flash": 1_000_000,
        "gemini-3-pro": 2_000_000,
        "claude-haiku": 50_000,
        "claude-sonnet": 200_000,
        "claude-opus": 200_000,
        "gpt-4o": 800_000,
        "deepseek": 1_000_000,
    }
    
    # Fallback hierarchy (fallback to models with higher limits)
    FALLBACK_ORDER = ["deepseek", "gemini-3-flash", "gemini-3-pro", "gpt-4o", "claude-opus", "claude-sonnet", "claude-haiku"]
    
    def __init__(self):
        self._usage_history: dict[str, list[tuple[float, int]]] = defaultdict(list)
        self._response_cache: dict[str, dict] = {}
        self._prompt_history: list[tuple[str, float]] = []
        self._rate_limit_info: dict[str, dict] = {}
    
    def _estimate_tokens(self, text: str) -> int:
        """CJK-aware token estimation. CJK chars count more than ASCII."""
        cjk_pattern = re.compile(r'[\u4e00-\u9fff\u3040-\u309f\u30a0-\u30ff\uac00-\ud7af]')
        cjk_chars = len(cjk_pattern.findall(text))
        ascii_chars = len(text) - cjk_chars
        
        cjk_tokens = int(cjk_chars * 1.5)
        ascii_tokens = max(1, ascii_chars // 4) if ascii_chars > 0 else 0
        
        return cjk_tokens + ascii_tokens
    
    def _cleanup_old_entries(self, model: str, current_time: float, window: int = 60):
        """Remove entries older than the sliding window."""
        cutoff = current_time - window
        self._usage_history[model] = [
            (ts, tokens) for ts, tokens in self._usage_history[model]
            if ts > cutoff
        ]
    
    def _get_usage_in_window(self, model: str, window: int = 60) -> int:
        """Get total tokens used in the sliding window."""
        current_time = time.time()
        self._cleanup_old_entries(model, current_time, window)
        return sum(tokens for _, tokens in self._usage_history[model])
    
    def _get_quota_percentage(self, model: str) -> float:
        """Get current quota usage percentage for a model."""
        limit = self.MODEL_LIMITS.get(model, 100_000)
        used = self._get_usage_in_window(model)
        return (used / limit) * 100
    
    def _find_fallback_model(self, current_model: str) -> Optional[str]:
        """Find a fallback model with available quota."""
        for model in self.FALLBACK_ORDER:
            if model != current_model and self._get_quota_percentage(model) < 80:
                return model
        return None
    
    def _check_duplicate(self, prompt: str, threshold: int = 3, window: int = 60) -> bool:
        """Check if prompt has been seen threshold times in window seconds."""
        current_time = time.time()
        cutoff = current_time - window
        
        self._prompt_history = [(p, t) for p, t in self._prompt_history if t > cutoff]
        count = sum(1 for p, _ in self._prompt_history if p == prompt)
        return count >= threshold
    
    def _add_prompt_to_history(self, prompt: str):
        """Add prompt to history for duplicate detection."""
        self._prompt_history.append((prompt, time.time()))
    
    def check(self, prompt: str, model: str) -> Decision:
        """Check if request should proceed, wait, fallback, or block."""
        estimated_tokens = self._estimate_tokens(prompt)
        quota_pct = self._get_quota_percentage(model)
        
        if self._check_duplicate(prompt):
            return Decision(
                action="block",
                estimated_tokens=estimated_tokens,
                reason="Duplicate prompt detected (3+ times in 60s)"
            )
        
        if model in self._rate_limit_info:
            info = self._rate_limit_info[model]
            if info["last_429"] and time.time() - info["last_429"] < info["retry_after"]:
                wait_time = info["retry_after"] - (time.time() - info["last_429"])
                return Decision(
                    action="wait",
                    estimated_tokens=estimated_tokens,
                    wait_seconds=max(0, wait_time),
                    reason=f"Rate limited, retry after {wait_time:.1f}s"
                )
        
        if quota_pct > 95:
            return Decision(
                action="block",
                estimated_tokens=estimated_tokens,
                reason=f"Quota exceeded: {quota_pct:.1f}% used"
            )
        
        if quota_pct > 80:
            fallback = self._find_fallback_model(model)
            if fallback:
                return Decision(
                    action="fallback",
                    estimated_tokens=estimated_tokens,
                    fallback_model=fallback,
                    reason=f"High quota usage ({quota_pct:.1f}%), fallback to {fallback}"
                )
            else:
                wait_time = max(1, (quota_pct - 80) * 0.5)
                return Decision(
                    action="wait",
                    estimated_tokens=estimated_tokens,
                    wait_seconds=wait_time,
                    reason=f"High quota usage ({quota_pct:.1f}%), wait {wait_time:.1f}s"
                )
        
        if prompt in self._response_cache:
            cached = self._response_cache[prompt]
            if time.time() - cached["timestamp"] < 300:
                return Decision(
                    action="proceed",
                    estimated_tokens=estimated_tokens,
                    reason=f"Cached response available"
                )
        
        self._add_prompt_to_history(prompt)
        return Decision(
            action="proceed",
            estimated_tokens=estimated_tokens,
            reason="OK"
        )
    
    def record_usage(self, tokens: int, model: str):
        """Record token usage for a model."""
        self._usage_history[model].append((time.time(), tokens))
    
    def cache_response(self, prompt: str, response: str):
        """Cache a response for future use."""
        self._response_cache[prompt] = {
            "response": response,
            "timestamp": time.time()
        }
    
    def record_429(self, model: str, retry_delay: float):
        """Parse 429 error and record rate limit info."""
        self._rate_limit_info[model] = {
            "retry_after": retry_delay,
            "last_429": time.time()
        }
    
    def status(self) -> dict:
        """Return status dict with models and stats info."""
        models_status = {}
        for model in self.MODEL_LIMITS:
            used = self._get_usage_in_window(model)
            limit = self.MODEL_LIMITS[model]
            models_status[model] = {
                "tokens_used": used,
                "limit": limit,
                "percentage": round((used / limit) * 100, 2),
                "status": "blocked" if (used / limit) > 0.95 else "throttled" if (used / limit) > 0.8 else "ok"
            }
        
        return {
            "models": models_status,
            "stats": {
                "cached_responses": len(self._response_cache),
                "tracked_prompts": len(self._prompt_history),
                "rate_limited_models": len([m for m in self._rate_limit_info if self._rate_limit_info[m]["last_429"]])
            }
        }
