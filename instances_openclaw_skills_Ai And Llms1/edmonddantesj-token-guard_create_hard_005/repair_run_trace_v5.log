#!/usr/bin/env python3
"""TokenGuard - LLM API 429 Prevention Engine"""

import time
import hashlib
import unicodedata
from collections import defaultdict
from dataclasses import dataclass, field
from typing import Optional

# Model TPM (tokens per minute) quotas
MODEL_QUOTAS = {
    "gemini-3-flash": 1_000_000,
    "gemini-3-pro": 2_000_000,
    "claude-haiku": 50_000,
    "claude-sonnet": 200_000,
    "claude-opus": 200_000,
    "gpt-4o": 800_000,
    "deepseek": 1_000_000,
}

MODEL_FALLBACK = [
    "deepseek", "gemini-3-flash", "gemini-3-pro",
    "claude-haiku", "claude-sonnet", "claude-opus", "gpt-4o"
]

@dataclass
class Decision:
    action: str  # proceed/wait/fallback/block
    estimated_tokens: int
    wait_seconds: float = 0.0
    fallback_model: Optional[str] = None
    reason: str = ""


class TokenGuard:
    def __init__(self):
        self._usage: dict[str, list[tuple[float, int]]] = defaultdict(list)
        self._prompts: dict[str, list[float]] = defaultdict(list)
        self._cache: dict[str, str] = {}
        self._last_429: dict[str, float] = {}
        self._retry_delays: dict[str, float] = {}
        self._window_seconds = 60

    def _estimate_tokens(self, text: str) -> int:
        """CJK-aware token estimation. CJK chars count more than ASCII."""
        tokens = 0
        for char in text:
            if '\u4e00' <= char <= '\u9fff' or \
               '\u3400' <= char <= '\u4dbf' or \
               '\u20000' <= char <= '\u2a6df' or \
               unicodedata.category(char).startswith('Lo'):
                tokens += 2
            elif char.isspace():
                tokens += 0.5
            else:
                tokens += 1
        return int(tokens) + 1

    def _clean_old_entries(self, model: str, current_time: float):
        """Remove entries older than the sliding window."""
        cutoff = current_time - self._window_seconds
        self._usage[model] = [(t, n) for t, n in self._usage[model] if t > cutoff]
        for prompt_hash in list(self._prompts.keys()):
            self._prompts[prompt_hash] = [t for t in self._prompts[prompt_hash] if t > cutoff]
            if not self._prompts[prompt_hash]:
                del self._prompts[prompt_hash]

    def _get_usage(self, model: str) -> int:
        """Get current usage for model in the sliding window."""
        current_time = time.time()
        self._clean_old_entries(model, current_time)
        return sum(tokens for _, tokens in self._usage[model])

    def _get_quota(self, model: str) -> int:
        """Get TPM quota for model."""
        return MODEL_QUOTAS.get(model, 100_000)

    def _get_fallback_model(self, model: str) -> Optional[str]:
        """Find a fallback model with available quota."""
        if model not in MODEL_FALLBACK:
            return MODEL_FALLBACK[0] if MODEL_FALLBACK else None
        current_time = time.time()
        idx = MODEL_FALLBACK.index(model)
        for i in range(idx + 1, len(MODEL_FALLBACK)):
            alt = MODEL_FALLBACK[i]
            usage = self._get_usage(alt)
            quota = self._get_quota(alt)
            if usage < quota * 0.8:
                return alt
        for i in range(idx):
            alt = MODEL_FALLBACK[i]
            usage = self._get_usage(alt)
            quota = self._get_quota(alt)
            if usage < quota * 0.8:
                return alt
        return None

    def _hash_prompt(self, prompt: str) -> str:
        """Create hash of prompt for deduplication."""
        return hashlib.md5(prompt.encode()).hexdigest()

    def check(self, prompt: str, model: str) -> Decision:
        """Check if request should proceed, wait, fallback, or block."""
        estimated_tokens = self._estimate_tokens(prompt)
        current_time = time.time()
        self._clean_old_entries(model, current_time)
        
        prompt_hash = self._hash_prompt(prompt)
        if prompt_hash in self._cache:
            return Decision(action="proceed", estimated_tokens=estimated_tokens, reason="cached_response_available")
        
        if len(self._prompts[prompt_hash]) >= 3:
            return Decision(action="block", estimated_tokens=estimated_tokens, reason="duplicate_prompt_detected")
        
        self._prompts[prompt_hash].append(current_time)
        
        usage = self._get_usage(model)
        quota = self._get_quota(model)
        usage_ratio = usage / quota if quota > 0 else 1.0
        
        if model in self._last_429:
            retry_after = self._last_429[model] - current_time
            if retry_after > 0:
                return Decision(action="wait", estimated_tokens=estimated_tokens, wait_seconds=retry_after, reason="rate_limit_retry")
        
        if usage_ratio > 0.95:
            return Decision(action="block", estimated_tokens=estimated_tokens, reason=f"quota_exceeded ({usage_ratio:.1%})")
        
        if usage_ratio > 0.8:
            wait_seconds = min(60 * (usage_ratio - 0.8) / 0.2, 30)
            fallback = self._get_fallback_model(model)
            if fallback:
                return Decision(action="fallback", estimated_tokens=estimated_tokens, wait_seconds=wait_seconds, fallback_model=fallback, reason=f"high_usage ({usage_ratio:.1%}), fallback_available")
            return Decision(action="wait", estimated_tokens=estimated_tokens, wait_seconds=wait_seconds, reason=f"high_usage ({usage_ratio:.1%})")
        
        return Decision(action="proceed", estimated_tokens=estimated_tokens, reason="within_quota")

    def record_usage(self, tokens: int, model: str) -> None:
        """Record token usage for a model."""
        self._usage[model].append((time.time(), tokens))

    def cache_response(self, prompt: str, response: str) -> None:
        """Cache a response for the given prompt."""
        self._cache[self._hash_prompt(prompt)] = response

    def record_429(self, model: str, retry_delay: float) -> None:
        """Record a 429 error and its retry delay."""
        self._last_429[model] = time.time() + retry_delay
        self._retry_delays[model] = retry_delay

    def status(self) -> dict:
        """Return status dict with models/stats info."""
        current_time = time.time()
        models_info = {}
        for model in MODEL_QUOTAS:
            self._clean_old_entries(model, current_time)
            usage = self._get_usage(model)
            quota = self._get_quota(model)
            models_info[model] = {
                "quota": quota,
                "usage": usage,
                "usage_ratio": usage / quota if quota > 0 else 0,
                "last_429": self._last_429.get(model),
                "retry_delay": self._retry_delays.get(model, 0)
            }
        return {
            "models": models_info,
            "cache_size": len(self._cache),
            "tracked_prompts": len(self._prompts),
            "window_seconds": self._window_seconds
        }
