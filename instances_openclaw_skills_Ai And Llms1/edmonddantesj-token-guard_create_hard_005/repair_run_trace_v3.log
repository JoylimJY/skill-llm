from scripts.token_guard import TokenGuard, Decision

# Full integration test
tg = TokenGuard()

# 1. Test CJK token estimation
assert tg._estimate_tokens('hello') == 5, 'ASCII token count failed'
assert tg._estimate_tokens('你好') == 4, 'CJK token count failed'
print('✓ CJK-aware token estimation')

# 2. Test check() returns correct Decision
result = tg.check('test', 'gpt-4o')
assert isinstance(result, Decision), 'check() should return Decision'
assert result.action == 'proceed', 'First check should proceed'
assert result.estimated_tokens > 0, 'Should estimate tokens'
print('✓ check() returns Decision with correct fields')

# 3. Test record_usage and quota tracking
tg.record_usage(1000, 'gpt-4o')
used = tg._get_usage_for_model('gpt-4o')
assert used == 1000, f'Usage tracking failed: {used}'
print('✓ record_usage() tracks per-model usage')

# 4. Test cache_response
tg.cache_response('prompt1', 'response1')
assert len(tg.response_cache) == 1, 'Cache failed'
print('✓ cache_response() stores responses')

# 5. Test record_429
tg.record_429('gpt-4o', 30)
assert 'gpt-4o' in tg.retry_delays, '429 recording failed'
print('✓ record_429() tracks retry delays')

# 6. Test status()
