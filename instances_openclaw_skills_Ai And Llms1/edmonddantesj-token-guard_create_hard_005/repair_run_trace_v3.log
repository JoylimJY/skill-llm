assert 'models' in status, 'Status missing models'
assert 'cache_size' in status, 'Status missing cache_size'
assert len(status['models']) == 7, f'Expected 7 models, got {len(status[\"models\"])}'
print('✓ status() returns complete model/stats info')

# 7. Test duplicate detection
tg2 = TokenGuard()
for i in range(3):
    r = tg2.check('same prompt', 'gpt-4o')
    assert r.action == 'proceed', f'First 3 should proceed, got {r.action}'
r = tg2.check('same prompt', 'gpt-4o')
assert r.action == 'block', f'4th should block, got {r.action}'
print('✓ Duplicate detection (3+ in 60s = block)')

# 8. Test smart throttle thresholds
