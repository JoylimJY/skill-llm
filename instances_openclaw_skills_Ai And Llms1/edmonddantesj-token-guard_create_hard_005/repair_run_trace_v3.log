"""TokenGuard - LLM API 429 Prevention Engine"""

import time
import hashlib
from collections import defaultdict
from dataclasses import dataclass
from typing import Optional


@dataclass
class Decision:
    action: str  # proceed/wait/fallback/block
    estimated_tokens: int
    wait_seconds: float = 0.0
    fallback_model: Optional[str] = None
    reason: str = ""


# Model quotas (tokens per minute)
MODEL_QUOTAS = {
    "gemini-3-flash": 1_000_000,
    "gemini-3-pro": 2_000_000,
    "claude-haiku": 50_000,
    "claude-sonnet": 200_000,
    "claude-opus": 200_000,
    "gpt-4o": 800_000,
    "deepseek": 1_000_000,
}

# Fallback chain (fallback to cheaper/smaller models on quota issues)
FALLBACK_CHAIN = {
    "gemini-3-pro": "gemini-3-flash",
    "claude-opus": "claude-sonnet",
    "claude-sonnet": "claude-haiku",
    "gpt-4o": "deepseek",
}


class TokenGuard:
    """TokenGuard engine for LLM API rate limiting and 429 prevention."""

    def __init__(self, window_seconds: int = 60):
        self.window_seconds = window_seconds
        self.usage_history: dict[str, list[tuple[float, int]]] = defaultdict(list)
        self.response_cache: dict[str, tuple[str, float]] = {}
        self.prompt_history: dict[str, list[float]] = defaultdict(list)
        self.retry_delays: dict[str, float] = {}

    def _estimate_tokens(self, text: str) -> int:
        """Estimate tokens with CJK-aware counting."""
        tokens = 0
        for char in text:
            if '\u4e00' <= char <= '\u9fff':
                tokens += 2
            elif '\u3040' <= char <= '\u309f':
                tokens += 2
            elif '\u30a0' <= char <= '\u30ff':
                tokens += 2
            elif '\uac00' <= char <= '\ud7af':
                tokens += 2
            elif '\u1100' <= char <= '\u11ff':
                tokens += 2
            elif '\uff00' <= char <= '\uffef':
                tokens += 2
            else:
                tokens += 1
        return tokens

    def _get_prompt_hash(self, prompt: str) -> str:
        """Get a hash of the prompt for caching and duplicate detection."""
        return hashlib.md5(prompt.encode()).hexdigest()

    def _clean_old_records(self, records: list, current_time: float) -> list:
        """Remove records older than window_seconds."""
        cutoff = current_time - self.window_seconds
        return [(t, v) for t, v in records if t > cutoff]

    def _get_usage_for_model(self, model: str) -> int:
        """Get total tokens used by model in current window."""
        current_time = time.time()
        self.usage_history[model] = self._clean_old_records(
            self.usage_history[model], current_time
        )
        return sum(tokens for _, tokens in self.usage_history[model])

    def _get_quota_percentage(self, model: str) -> float:
        """Get current usage as percentage of quota."""
        quota = MODEL_QUOTAS.get(model, 100_000)
        used = self._get_usage_for_model(model)
        return (used / quota) * 100 if quota > 0 else 100

    def _check_duplicate(self, prompt: str) -> bool:
        """Check if prompt has been seen 3+ times in the last 60 seconds."""
        prompt_hash = self._get_prompt_hash(prompt)
        current_time = time.time()
        self.prompt_history[prompt_hash] = [
            t for t in self.prompt_history[prompt_hash]
            if current_time - t < 60
        ]
        return len(self.prompt_history[prompt_hash]) >= 3

    def _record_prompt(self, prompt: str) -> None:
        """Record a prompt for duplicate detection."""
        prompt_hash = self._get_prompt_hash(prompt)
        self.prompt_history[prompt_hash].append(time.time())

    def check(self, prompt: str, model: str) -> Decision:
        """Check if a request should proceed, wait, fallback, or be blocked."""
        estimated_tokens = self._estimate_tokens(prompt)
        quota_pct = self._get_quota_percentage(model)
        current_time = time.time()

        if self._check_duplicate(prompt):
            return Decision(
                action="block",
                estimated_tokens=estimated_tokens,
                reason="Duplicate prompt detected (3+ times in 60s)"
            )

        if model in self.retry_delays:
            retry_time = self.retry_delays[model]
            if current_time - retry_time < 60:
                wait_seconds = max(0, 60 - (current_time - retry_time))
                return Decision(
                    action="wait",
                    estimated_tokens=estimated_tokens,
                    wait_seconds=wait_seconds,
                    reason=f"Recent 429 error, wait {wait_seconds:.1f}s"
                )

        if quota_pct > 95:
            return Decision(
                action="block",
                estimated_tokens=estimated_tokens,
                reason=f"Quota exceeded ({quota_pct:.1f}%)"
            )
        elif quota_pct > 80:
            wait_seconds = (quota_pct - 80) * 0.5
            return Decision(
                action="wait",
                estimated_tokens=estimated_tokens,
                wait_seconds=min(wait_seconds, 60),
                reason=f"High quota usage ({quota_pct:.1f}%)"
            )
        elif quota_pct > 60:
            fallback = FALLBACK_CHAIN.get(model)
            if fallback:
                return Decision(
                    action="fallback",
                    estimated_tokens=estimated_tokens,
                    fallback_model=fallback,
                    reason=f"Consider fallback (quota at {quota_pct:.1f}%)"
                )

        self._record_prompt(prompt)
        return Decision(
            action="proceed",
            estimated_tokens=estimated_tokens,
            reason="OK"
        )

    def record_usage(self, tokens: int, model: str) -> None:
        """Record token usage for a model."""
        current_time = time.time()
        self.usage_history[model].append((current_time, tokens))

    def cache_response(self, prompt: str, response: str) -> None:
        """Cache a response for a prompt."""
        prompt_hash = self._get_prompt_hash(prompt)
        self.response_cache[prompt_hash] = (response, time.time())

    def record_429(self, model: str, retry_delay: float) -> None:
        """Record a 429 error and its retry delay."""
        self.retry_delays[model] = time.time() + retry_delay

    def status(self) -> dict:
        """Return status information about all models."""
        current_time = time.time()
        models_status = {}
        
        for model in MODEL_QUOTAS:
            self.usage_history[model] = self._clean_old_records(
                self.usage_history[model], current_time
            )
            used = sum(tokens for _, tokens in self.usage_history[model])
            quota = MODEL_QUOTAS[model]
            pct = (used / quota) * 100 if quota > 0 else 100
            
            models_status[model] = {
                "quota": quota,
                "used": used,
                "percentage": round(pct, 2),
                "remaining": quota - used,
                "status": "blocked" if pct > 95 else "throttled" if pct > 80 else "ok"
            }

        return {
            "models": models_status,
            "cache_size": len(self.response_cache),
            "prompt_history_size": sum(len(v) for v in self.prompt_history.values()),
            "active_429s": len([d for d in self.retry_delays.values() 
                               if current_time - d < 60]),
            "window_seconds": self.window_seconds
        }
