#!/usr/bin/env python3
"""Analyst Agent - Analyzes collected findings and produces insights"""

import json
import os
from datetime import datetime

def run():
    status_file = "/workspace/agents/analyst/status.json"
    input_file = "/workspace/agents/data-collector/outbox/collected_findings.json"
    output_file = "/workspace/agents/analyst/outbox/market_insights.json"
    
    try:
        # Update status
        with open(status_file, 'r') as f:
            status = json.load(f)
        status['started_at'] = datetime.now().isoformat()
        with open(status_file, 'w') as f:
            json.dump(status, f, indent=2)
        
        # Read collected findings
        with open(input_file, 'r') as f:
            findings = json.load(f)
        
        companies = findings.get("companies", [])
        
        # Calculate market metrics
        total_market = findings.get("market_totals", {}).get("total_market_size_bn", 0)
        forecast = findings.get("market_totals", {}).get("forecast_2025_bn", 0)
        market_growth_rate = ((forecast - total_market) / total_market * 100) if total_market else 0
        
        # Sort companies by various metrics
        by_market_share = sorted(companies, key=lambda x: x.get("market_share", 0), reverse=True)
        by_growth = sorted(companies, key=lambda x: x.get("yoy_growth", 0), reverse=True)
        by_revenue = sorted(companies, key=lambda x: x.get("revenue_bn", 0), reverse=True)
        
        # Calculate HHI (Herfindahl-Hirschman Index)
        hhi = sum((c.get("market_share", 0) ** 2) for c in companies)
        
        # Generate insights
        insights = {
            "analyzed_at": datetime.now().isoformat(),
            "market_overview": {
                "sector": findings.get("metadata", {}).get("sector"),
                "total_size_bn": total_market,
                "forecast_2025_bn": forecast,
                "projected_growth_rate_pct": round(market_growth_rate, 2)
            },
            "competitive_analysis": {
                "market_leader": {
                    "name": by_market_share[0]["name"] if by_market_share else None,
                    "market_share_pct": by_market_share[0].get("market_share") if by_market_share else None
                },
                "fastest_growing": {
                    "name": by_growth[0]["name"] if by_growth else None,
                    "yoy_growth_pct": by_growth[0].get("yoy_growth") if by_growth else None
                },
                "revenue_leader": {
                    "name": by_revenue[0]["name"] if by_revenue else None,
                    "revenue_bn": by_revenue[0].get("revenue_bn") if by_revenue else None
                },
                "market_concentration": {
                    "hhi_index": round(hhi, 2),
                    "classification": "Moderately Concentrated" if 1500 <= hhi <= 2500 else ("Highly Concentrated" if hhi > 2500 else "Unconcentrated")
                }
            },
            "growth_analysis": {
                "growth_leaders": [
                    {"name": c["name"], "growth_pct": c["yoy_growth"]} 
                    for c in by_growth[:3]
                ],
                "market_outlier": {
                    "name": by_growth[0]["name"] if len(by_growth) > 0 else None,
                    "observation": "EpsilonEV showing exceptional 67.1% YoY growth, indicating strong product-market fit"
                }
            },
            "trend_impact": {
                "positive_drivers": findings.get("key_trends", []),
                "trend_summary": "Battery cost reduction and expanding subsidies are accelerating adoption, while infrastructure growth supports mainstream transition"
            },
            "risk_assessment": {
                "identified_risks": findings.get("risks", []),
                "risk_summary": "Supply chain constraints and regulatory uncertainty pose significant challenges to sustained growth"
            },
            "strategic_insights": [
                "Market is moderately concentrated with clear leader (AlphaMotors at 34.2% share)",
                "High growth potential indicated by 30% projected market expansion by 2025",
                "Emerging players (EpsilonEV, DeltaAuto) showing disruptive growth rates",
                "Infrastructure expansion is key enabler for continued adoption",
                "Supply chain diversification critical to mitigate lithium constraints"
            ]
        }
        
        # Ensure output directory exists
        os.makedirs(os.path.dirname(output_file), exist_ok=True)
        
        # Write insights
        with open(output_file, 'w') as f:
