#!/usr/bin/env python3
"""Data Collector Agent - Reads raw market data and extracts findings"""

import json
import os
from datetime import datetime

def run():
    status_file = "/workspace/agents/data-collector/status.json"
    input_file = "/workspace/input_data/raw_market_data.json"
    output_file = "/workspace/agents/data-collector/outbox/collected_findings.json"
    
    try:
        # Update status
        with open(status_file, 'r') as f:
            status = json.load(f)
        status['started_at'] = datetime.now().isoformat()
        with open(status_file, 'w') as f:
            json.dump(status, f, indent=2)
        
        # Read raw data
        with open(input_file, 'r') as f:
            raw_data = json.load(f)
        
        # Extract and structure findings
        findings = {
            "collected_at": datetime.now().isoformat(),
            "metadata": {
                "report_id": raw_data.get("report_id"),
                "sector": raw_data.get("sector"),
                "marker": raw_data.get("marker")
            },
            "companies": raw_data.get("companies", []),
            "market_totals": {
                "total_market_size_bn": raw_data.get("total_market_size_bn"),
                "forecast_2025_bn": raw_data.get("forecast_2025_bn")
            },
            "key_trends": raw_data.get("key_trends", []),
            "risks": raw_data.get("risks", []),
            "validation": {
                "companies_count": len(raw_data.get("companies", [])),
                "trends_count": len(raw_data.get("key_trends", [])),
                "risks_count": len(raw_data.get("risks", [])),
                "data_valid": True
            }
        }
        
        # Ensure output directory exists
        os.makedirs(os.path.dirname(output_file), exist_ok=True)
        
        # Write findings
        with open(output_file, 'w') as f:
            json.dump(findings, f, indent=2)
        
        # Update status
        status['status'] = 'completed'
        status['completed_at'] = datetime.now().isoformat()
        with open(status_file, 'w') as f:
            json.dump(status, f, indent=2)
        
        print(f"[Data Collector] Successfully collected findings to {output_file}")
        return True
        
    except Exception as e:
        with open(status_file, 'r') as f:
            status = json.load(f)
        status['status'] = 'failed'
        status['error'] = str(e)
        with open(status_file, 'w') as f:
            json.dump(status, f, indent=2)
        print(f"[Data Collector] Error: {e}")
        return False

if __name__ == "__main__":
    run()
EOF

