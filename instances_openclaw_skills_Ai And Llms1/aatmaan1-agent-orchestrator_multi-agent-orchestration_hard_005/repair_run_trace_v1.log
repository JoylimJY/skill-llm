#!/usr/bin/env python3
"""
Market Analysis Pipeline Orchestrator
Runs all agents in sequence: data-collector -> analyst -> writer -> reviewer
"""

import subprocess
import sys
import json
from datetime import datetime

def run_agent(agent_name, script_path):
    """Run a single agent and return success status"""
    print(f"\n{'='*60}")
    print(f"Running Agent: {agent_name}")
    print(f"{'='*60}")
    
    try:
        result = subprocess.run(
            [sys.executable, script_path],
            capture_output=True,
            text=True,
            cwd="/workspace"
        )
        
        if result.returncode == 0:
            print(f"✓ Agent '{agent_name}' completed successfully")
            return True
        else:
            print(f"✗ Agent '{agent_name}' failed with return code {result.returncode}")
            if result.stderr:
                print(f"Error: {result.stderr}")
            return False
    except Exception as e:
        print(f"✗ Agent '{agent_name}' raised exception: {e}")
        return False

def check_agent_status(agent_name):
    """Check the status of an agent from its status.json"""
    status_file = f"/workspace/agents/{agent_name}/status.json"
    try:
        with open(status_file, 'r') as f:
            status = json.load(f)
        return status.get('status', 'unknown')
    except:
        return 'unknown'

def main():
    print("\n" + "="*60)
    print("MARKET ANALYSIS PIPELINE")
    print(f"Started at: {datetime.now().isoformat()}")
    print("="*60)
    
    agents = [
        ("data-collector", "/workspace/agents/data-collector/run.py"),
        ("analyst", "/workspace/agents/analyst/run.py"),
        ("writer", "/workspace/agents/writer/run.py"),
        ("reviewer", "/workspace/agents/reviewer/run.py"),
    ]
    
    all_success = True
    
    for agent_name, script_path in agents:
        if not run_agent(agent_name, script_path):
            all_success = False
            print(f"\n⚠ Pipeline stopped due to failure in agent: {agent_name}")
            break
    
    # Final summary
    print("\n" + "="*60)
    print("PIPELINE SUMMARY")
    print("="*60)
    
    for agent_name, _ in agents:
        status = check_agent_status(agent_name)
        status_icon = "✓" if status == 'completed' else ("✗" if status == 'failed' else "?")
        print(f"  {status_icon} {agent_name}: {status}")
    
    print("\n" + "="*60)
    if all_success:
        print("✓ PIPELINE COMPLETED SUCCESSFULLY")
        print("\nFinal outputs:")
        print("  - /workspace/final_output/market_report.md")
        print("  - /workspace/final_output/approved.json")
    else:
        print("✗ PIPELINE FAILED")
    print("="*60 + "\n")
    
    return 0 if all_success else 1

if __name__ == "__main__":
    sys.exit(main())
EOF

