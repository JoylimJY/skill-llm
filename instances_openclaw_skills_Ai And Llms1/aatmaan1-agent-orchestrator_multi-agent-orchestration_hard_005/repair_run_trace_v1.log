#!/usr/bin/env python3
"""Reviewer Agent - Validates report and produces final approval"""

import json
import os
import shutil
from datetime import datetime

def run():
    status_file = "/workspace/agents/reviewer/status.json"
    input_report = "/workspace/agents/writer/outbox/draft_report.md"
    findings_file = "/workspace/agents/data-collector/outbox/collected_findings.json"
    output_approval = "/workspace/agents/reviewer/outbox/approved.json"
    final_report = "/workspace/final_output/market_report.md"
    final_approval = "/workspace/final_output/approved.json"
    
    try:
        # Update status
        with open(status_file, 'r') as f:
            status = json.load(f)
        status['started_at'] = datetime.now().isoformat()
        with open(status_file, 'w') as f:
            json.dump(status, f, indent=2)
        
        # Read draft report
        with open(input_report, 'r') as f:
            report_content = f.read()
        
        # Read findings for verification
        with open(findings_file, 'r') as f:
            findings = json.load(f)
        
        # Validation checks
        validation_results = []
        approved = True
        
        # Check 1: Report contains sector name
        sector = findings.get("metadata", {}).get("sector")
        if sector and sector in report_content:
            validation_results.append({"check": "sector_present", "passed": True})
        else:
            validation_results.append({"check": "sector_present", "passed": False})
            approved = False
        
        # Check 2: Report contains market size
        market_size = findings.get("market_totals", {}).get("total_market_size_bn")
        if market_size and str(market_size) in report_content:
            validation_results.append({"check": "market_size_present", "passed": True})
        else:
            validation_results.append({"check": "market_size_present", "passed": False})
            approved = False
        
        # Check 3: Report contains forecast
        forecast = findings.get("market_totals", {}).get("forecast_2025_bn")
        if forecast and str(forecast) in report_content:
            validation_results.append({"check": "forecast_present", "passed": True})
        else:
            validation_results.append({"check": "forecast_present", "passed": False})
            approved = False
        
        # Check 4: Report has all required sections
        required_sections = ["Executive Summary", "Market Overview", "Competitive Landscape", 
                           "Key Trends Analysis", "Risk Assessment", "Strategic Recommendations"]
        for section in required_sections:
            if section in report_content:
                validation_results.append({"check": f"section_{section.lower().replace(' ', '_')}", "passed": True})
            else:
                validation_results.append({"check": f"section_{section.lower().replace(' ', '_')}", "passed": False})
                approved = False
        
        # Check 5: Company names are present
        company_names = [c["name"] for c in findings.get("companies", [])]
        for company in company_names:
            if company in report_content:
                validation_results.append({"check": f"company_{company.lower()}", "passed": True})
            else:
                validation_results.append({"check": f"company_{company.lower()}", "passed": False})
                approved = False
        
        # Create approval document
        approval = {
            "reviewed_at": datetime.now().isoformat(),
            "report_file": "market_report.md",
            "approval_status": "APPROVED" if approved else "REJECTED",
            "validation_results": validation_results,
            "summary": {
                "total_checks": len(validation_results),
                "passed_checks": sum(1 for v in validation_results if v["passed"]),
                "failed_checks": sum(1 for v in validation_results if not v["passed"])
            },
            "reviewer_notes": "Report has been validated against source data. All key metrics and sections verified." if approved else "Report failed validation checks.",
            "final_output": {
                "report_path": final_report,
                "approval_path": final_approval
            }
        }
        
        # Ensure output directories exist
        os.makedirs(os.path.dirname(output_approval), exist_ok=True)
        os.makedirs(os.path.dirname(final_report), exist_ok=True)
        
        # Copy report to final output
        shutil.copy(input_report, final_report)
        
        # Write approval to reviewer outbox
        with open(output_approval, 'w') as f:
            json.dump(approval, f, indent=2)
        
        # Copy approval to final output
        shutil.copy(output_approval, final_approval)
        
        # Update status
        status['status'] = 'completed'
        status['completed_at'] = datetime.now().isoformat()
        with open(status_file, 'w') as f:
            json.dump(status, f, indent=2)
        
        print(f"[Reviewer] Review complete. Status: {approval['approval_status']}")
        print(f"[Reviewer] Final report: {final_report}")
        print(f"[Reviewer] Final approval: {final_approval}")
        return approved
        
    except Exception as e:
        with open(status_file, 'r') as f:
            status = json.load(f)
        status['status'] = 'failed'
        status['error'] = str(e)
        with open(status_file, 'w') as f:
            json.dump(status, f, indent=2)
        print(f"[Reviewer] Error: {e}")
        return False

if __name__ == "__main__":
    run()
