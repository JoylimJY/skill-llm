#!/usr/bin/env python3
"""Data Collector Agent - Reads raw market data and prepares findings."""

import json
import os

def run():
    input_file = "/workspace/input_data/raw_market_data.json"
    output_file = "/workspace/agents/data-collector/outbox/collected_data.json"
    status_file = "/workspace/agents/data-collector/status.json"
    
    # Read raw data
    with open(input_file, 'r') as f:
        raw_data = json.load(f)
    
    # Validate and extract data
    collected = {
        "report_id": raw_data.get("report_id"),
        "sector": raw_data.get("sector"),
        "marker": raw_data.get("marker"),
        "companies": raw_data.get("companies", []),
        "total_market_size_bn": raw_data.get("total_market_size_bn"),
        "forecast_2025_bn": raw_data.get("forecast_2025_bn"),
        "key_trends": raw_data.get("key_trends", []),
        "risks": raw_data.get("risks", []),
        "validation": {
            "companies_count": len(raw_data.get("companies", [])),
            "data_complete": True
        }
    }
    
    # Write findings to outbox
    os.makedirs(os.path.dirname(output_file), exist_ok=True)
    with open(output_file, 'w') as f:
        json.dump(collected, f, indent=2)
    
    # Update status
    status = {
        "agent": "data-collector",
        "status": "completed",
        "input_file": input_file,
        "output_file": output_file,
        "dependencies": [],
        "next_agent": "analyst"
    }
    with open(status_file, 'w') as f:
        json.dump(status, f, indent=2)
    
    print(f"[data-collector] Collected data for {collected['sector']} market")
    print(f"[data-collector] Found {collected['validation']['companies_count']} companies")
    return True

if __name__ == "__main__":
    run()
EOF

