#!/usr/bin/env python3
"""
Market Analysis Pipeline Orchestrator

This script orchestrates the full market analysis pipeline using 4 sub-agents:
1. data-collector - Reads raw market data
2. analyst - Analyzes data and produces insights
3. writer - Drafts the report
4. reviewer - Validates and approves the report
"""

import subprocess
import sys
import os

AGENTS = [
    {
        "name": "data-collector",
        "script": "/workspace/agents/data-collector/run.py"
    },
    {
        "name": "analyst",
        "script": "/workspace/agents/analyst/run.py"
    },
    {
        "name": "writer",
        "script": "/workspace/agents/writer/run.py"
    },
    {
        "name": "reviewer",
        "script": "/workspace/agents/reviewer/run.py"
    }
]

def run_agent(agent):
    """Run a single agent script."""
    print(f"\n{'='*60}")
    print(f"EXECUTING AGENT: {agent['name']}")
    print(f"{'='*60}")
    
    result = subprocess.run([sys.executable, agent['script']], capture_output=False)
    
    if result.returncode != 0:
        print(f"[ERROR] Agent {agent['name']} failed!")
        return False
    
    return True

def main():
    print("="*60)
    print("MARKET ANALYSIS PIPELINE")
    print("="*60)
    print("Starting full pipeline execution...")
    
    all_success = True
    
    for agent in AGENTS:
        success = run_agent(agent)
        if not success:
            all_success = False
            print(f"\nPipeline halted at agent: {agent['name']}")
            break
    
    print("\n" + "="*60)
    print("PIPELINE COMPLETE")
    print("="*60)
    
    if all_success:
        print("\n✓ All agents executed successfully!")
        print("\nOutput files:")
        print("  - Report: /workspace/final_output/market_report.md")
        print("  - Approval: /workspace/final_output/approved.json")
        print("\nAgent workspaces:")
        for agent in AGENTS:
            print(f"  - {agent['name']}: /workspace/agents/{agent['name']}/")
    else:
        print("\n✗ Pipeline execution failed!")
        return 1
    
    return 0

if __name__ == "__main__":
    sys.exit(main())
EOF

