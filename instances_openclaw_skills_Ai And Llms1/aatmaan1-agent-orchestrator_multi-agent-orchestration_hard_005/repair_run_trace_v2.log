cat > /workspace/agents/analyst/run.py << 'EOF'
#!/usr/bin/env python3
"""Analyst Agent - Analyzes market data and produces insights."""

import json
import os

def run():
    input_file = "/workspace/agents/data-collector/outbox/collected_data.json"
    output_file = "/workspace/agents/analyst/outbox/analysis_insights.json"
    status_file = "/workspace/agents/analyst/status.json"
    
    # Read collected data
    with open(input_file, 'r') as f:
        data = json.load(f)
    
    companies = data["companies"]
    
    # Calculate market dynamics
    total_market_share = sum(c["market_share"] for c in companies)
    hhi = sum(c["market_share"] ** 2 for c in companies)  # Herfindahl-Hirschman Index
    
    # Sort by growth rate
    growth_sorted = sorted(companies, key=lambda x: x["yoy_growth"], reverse=True)
    growth_leader = growth_sorted[0]
    growth_laggard = growth_sorted[-1]
    
    # Sort by market share
    share_sorted = sorted(companies, key=lambda x: x["market_share"], reverse=True)
    market_leader = share_sorted[0]
    
    # Calculate averages
    avg_growth = sum(c["yoy_growth"] for c in companies) / len(companies)
    avg_revenue = sum(c["revenue_bn"] for c in companies) / len(companies)
    
    # Market forecast growth
    forecast_growth = ((data["forecast_2025_bn"] - data["total_market_size_bn"]) / 
                       data["total_market_size_bn"]) * 100
    
    # Generate insights
    insights = {
        "report_id": data["report_id"],
        "sector": data["sector"],
        "market_dynamics": {
            "market_concentration": {
                "hhi_index": round(hhi, 2),
                "interpretation": "Moderately concentrated" if hhi < 2500 else "Highly concentrated"
            },
            "market_leader": {
                "name": market_leader["name"],
                "market_share": market_leader["market_share"],
                "revenue_bn": market_leader["revenue_bn"]
            },
            "growth_leader": {
                "name": growth_leader["name"],
                "yoy_growth": growth_leader["yoy_growth"]
            },
            "growth_laggard": {
                "name": growth_laggard["name"],
                "yoy_growth": growth_laggard["yoy_growth"]
            },
            "average_growth_rate": round(avg_growth, 2),
            "average_revenue": round(avg_revenue, 2)
        },
        "market_forecast": {
            "current_size_bn": data["total_market_size_bn"],
            "forecast_2025_bn": data["forecast_2025_bn"],
            "projected_growth_pct": round(forecast_growth, 2)
        },
        "key_trends": data["key_trends"],
        "risks": data["risks"],
        "analysis_notes": [
            f"{growth_leader['name']} shows exceptional growth at {growth_leader['yoy_growth']}% YoY",
            f"{market_leader['name']} maintains market leadership with {market_leader['market_share']}% share",
            f"Market projected to grow {forecast_growth:.1f}% by 2025",
            f"HHI of {hhi:.0f} indicates {'moderate' if hhi < 2500 else 'high'} market concentration"
        ]
