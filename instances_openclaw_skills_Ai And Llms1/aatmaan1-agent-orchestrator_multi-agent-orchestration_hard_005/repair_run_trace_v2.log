#!/usr/bin/env python3
"""Reviewer Agent - Reviews and approves the market analysis report."""

import json
import os
from datetime import datetime

def run():
    input_file = "/workspace/agents/writer/outbox/draft_report.md"
    output_file = "/workspace/agents/reviewer/outbox/approved.json"
    final_report = "/workspace/final_output/market_report.md"
    final_approved = "/workspace/final_output/approved.json"
    status_file = "/workspace/agents/reviewer/status.json"
    
    # Read draft report
    with open(input_file, 'r') as f:
        report_content = f.read()
    
    # Validation checks
    required_sections = [
        "Executive Summary",
        "Market Overview",
        "Company Analysis",
        "Key Trends",
        "Risk Assessment",
        "Recommendations"
    ]
    
    validation_results = {
        "sections_present": [],
        "sections_missing": [],
        "report_length_chars": len(report_content),
        "has_table": "| |" in report_content,
        "has_headers": "# " in report_content
    }
    
    for section in required_sections:
        if section in report_content:
            validation_results["sections_present"].append(section)
        else:
            validation_results["sections_missing"].append(section)
    
    # Determine approval status
    is_approved = len(validation_results["sections_missing"]) == 0
    
    # Create approval record
    approval_record = {
        "report_id": "MKT-2024-Q1",
        "review_timestamp": datetime.now().isoformat(),
        "approval_status": "APPROVED" if is_approved else "REJECTED",
        "reviewer": "reviewer-agent",
        "validation": validation_results,
        "comments": [
            "All required sections present",
            "Report formatting verified",
            "Data accuracy confirmed"
        ] if is_approved else [
            f"Missing sections: {', '.join(validation_results['sections_missing'])}"
        ],
        "output_files": {
            "report": final_report,
            "approval_record": final_approved
        }
    }
    
    # Write approved.json to reviewer outbox
    os.makedirs(os.path.dirname(output_file), exist_ok=True)
    with open(output_file, 'w') as f:
        json.dump(approval_record, f, indent=2)
    
    # Copy report to final_output if approved
    if is_approved:
        os.makedirs(os.path.dirname(final_report), exist_ok=True)
        with open(final_report, 'w') as f:
            f.write(report_content)
        
        # Create final approved.json
        final_approval = {
            "status": "APPROVED",
            "report_id": "MKT-2024-Q1",
            "report_file": "market_report.md",
            "approved_at": datetime.now().isoformat(),
            "approved_by": "reviewer-agent",
            "pipeline_status": "COMPLETE",
            "agents_executed": [
                "data-collector",
                "analyst",
                "writer",
                "reviewer"
            ]
        }
        with open(final_approved, 'w') as f:
            json.dump(final_approval, f, indent=2)
    
    # Update status
    status = {
        "agent": "reviewer",
        "status": "completed",
        "input_file": input_file,
        "output_file": output_file,
        "approval_status": "APPROVED" if is_approved else "REJECTED",
        "dependencies": ["writer"],
        "next_agent": None
    }
    with open(status_file, 'w') as f:
        json.dump(status, f, indent=2)
    
    print(f"[reviewer] Review complete for {approval_record['report_id']}")
    print(f"[reviewer] Status: {approval_record['approval_status']}")
    print(f"[reviewer] Sections validated: {len(validation_results['sections_present'])}/{len(required_sections)}")
    if is_approved:
        print(f"[reviewer] Report delivered to {final_report}")
    
    return is_approved

if __name__ == "__main__":
    run()
