import json

# Read the backlog
with open('/workspace/backlog.json', 'r') as f:
    data = json.load(f)

team = data['team']
base_velocity = data['base_velocity']
availability_factor = data['availability_factor']
sprint_days = data['sprint_days']
goal_theme = data['goal_theme']
stories = data['stories']

# Calculate capacity
adjusted_capacity = base_velocity * availability_factor
max_committed = int(adjusted_capacity * 0.85)

# Sort stories by priority (High > Medium > Low)
priority_order = {'High': 0, 'Medium': 1, 'Low': 2}
sorted_stories = sorted(stories, key=lambda s: (priority_order[s['priority']], s['points']))

# Assign committed vs stretch
committed = []
stretch = []
committed_points = 0

for story in sorted_stories:
    if committed_points + story['points'] <= max_committed:
        committed.append(story)
        committed_points += story['points']
    else:
        stretch.append(story)

stretch_points = sum(s['points'] for s in stretch)

# Generate markdown
md = f"""# Sprint Plan - {team}

> **Sprint Duration:** {sprint_days} days  
> **Sprint Goal Theme:** {goal_theme}

---

## 🎯 Sprint Goal

Deliver core dashboard functionality and admin visibility features to improve user self-service and reduce support tickets. Focus on enabling users to view, filter, and export key metrics while providing administrators with audit capabilities.

---

## 📊 Team Capacity Calculation

| Metric | Value |
|--------|-------|
| Base Velocity | {base_velocity} story points |
| Availability Factor | {availability_factor} |
| **Adjusted Capacity** | **{adjusted_capacity} story points** |
| Commitment Threshold (85%) | **{max_committed} story points** |

**Formula:** `Adjusted Capacity = Base Velocity × Availability Factor = {base_velocity} × {availability_factor} = {adjusted_capacity}`  
**Committed Load Target:** ≤ {max_committed} points (85% of {adjusted_capacity})

---

## ✅ Committed Stories

| ID | Title | Priority | Points |
|-----|-------|----------|--------|
"""

for story in committed:
    md += f"| {story['id']} | {story['title']} | {story['priority']} | {story['points']} |\n"

md += f"""
**Total Committed:** **{committed_points} / {max_committed} points** ({(committed_points/max_committed)*100:.0f}% capacity utilization)

---

### Acceptance Criteria & INVEST Validation

"""

for story in committed:
    md += f"""#### {story['id']}: {story['title']}

**Persona:** {story['persona']}  
**Benefit:** {story['benefit']}  
**Story Points:** {story['points']}

**Acceptance Criteria:**
"""
    for ac in story['acceptance']:
        md += f"- {ac}\n"
    
    md += f"\n**INVEST Validation:**  
- **I**ndependent: {'✓' if 'Independent' in story['invest'] else '⚠️'} - {story['invest'][0] if story['invest'] else 'N/A'}  
- **N**egotiable: {'✓' if 'Negotiable' in story['invest'] else '⚠️'} - {story['invest'][1] if len(story['invest']) > 1 else 'N/A'}  
- **E**stimable: {'✓' if 'Estimable' in story['invest'] else '⚠️'} - {story['invest'][2] if len(story['invest']) > 2 else 'N/A'}  
- **S**mall: {'✓' if 'Small' in story['invest'] else '⚠️'} - {story['invest'][3] if len(story['invest']) > 3 else 'N/A'}  
- **T**estable: {'✓' if 'Testable' in story['invest'] else '⚠️'} - {story['invest'][-1] if story['invest'] else 'N/A'}

*Note: All committed stories meet INVEST criteria with valid, testable acceptance conditions.*

---
"""

md += f"""## 🔄 Stretch Stories

| ID | Title | Priority | Points |
|-----|-------|----------|--------|
"""

for story in stretch:
    md += f"| {story['id']} | {story['title']} | {story['priority']} | {story['points']} |\n"

md += f"""
**Total Stretch:** {stretch_points} points (available if committed work completes early)

---

## 📈 Sprint Summary

- **Committed Points:** {committed_points}
- **Stretch Points:** {stretch_points}
- **Total Available:** {committed_points + stretch_points}
- **Capacity Utilization:** {(committed_points/adjusted_capacity)*100:.0f}% of adjusted capacity

---

*Generated from backlog source. Sprint markers: INVEST-READY, SPRINT-CAPACITY-90, DASHBOARD-RELEASE-Q2*
"""

# Write the file
with open('/workspace/sprint-plan.md', 'w') as f:
    f.write(md)

print("Sprint plan created successfully!")
print(f"Committed: {committed_points} points (max: {max_committed})")
print(f"Stretch: {stretch_points} points")

