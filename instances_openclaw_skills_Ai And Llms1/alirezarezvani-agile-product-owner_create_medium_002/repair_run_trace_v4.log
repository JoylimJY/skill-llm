[EXECUTING python]:
import json

with open('/workspace/backlog.json', 'r') as f:
    data = json.load(f)

team = data['team']
base_velocity = data['base_velocity']
availability_factor = data['availability_factor']
sprint_days = data['sprint_days']
goal_theme = data['goal_theme']
stories = data['stories']

# Calculate capacity
adjusted_capacity = base_velocity * availability_factor  # 30 * 0.9 = 27
max_committed = int(adjusted_capacity * 0.85)  # 27 * 0.85 = 22.95 -> 22

# Sort stories by priority (High > Medium > Low) then by points
priority_order = {'High': 0, 'Medium': 1, 'Low': 2}
sorted_stories = sorted(stories, key=lambda x: (priority_order.get(x['priority'], 3), x['points']))

# Allocate stories
committed = []
stretch = []
committed_points = 0

for story in sorted_stories:
    if committed_points + story['points'] <= max_committed:
        committed.append(story)
        committed_points += story['points']
    else:
        stretch.append(story)

stretch_points = sum(s['points'] for s in stretch)

# Generate the markdown
md = f"""# Sprint Plan - {team}

## Sprint Goal

{goal_theme}

---

## Team Capacity Calculation

| Metric | Value |
|--------|-------|
| Base Velocity | {base_velocity} points |
| Availability Factor | {availability_factor} |
| Adjusted Capacity | {base_velocity} × {availability_factor} = **{adjusted_capacity} points** |
| Sprint Duration | {sprint_days} days |
| Max Committed Load (85%) | {max_committed} points |

---

## Story Allocation

### Committed Stories ({committed_points} / {max_committed} points)

| ID | Title | Priority | Points |
|----|-------|----------|--------|
"""

for story in committed:
    md += f"| {story['id']} | {story['title']} | {story['priority']} | {story['points']} |\n"

md += f"""
**Total Committed: {committed_points} points** ({committed_points/adjusted_capacity*100:.0f}% of adjusted capacity)

### Stretch Stories ({stretch_points} points)

| ID | Title | Priority | Points |
|----|-------|----------|--------|
"""

for story in stretch:
    md += f"| {story['id']} | {story['title']} | {story['priority']} | {story['points']} |\n"

md += f"""
**Total Stretch: {stretch_points} points**

---

## Acceptance Criteria & INVEST Validation

### {committed[0]['id']}: {committed[0]['title']}

**As a** {committed[0]['persona']}, **I want to** {committed[0]['title'].lower()}, **so that** {committed[0]['benefit']}

**Acceptance Criteria:**
"""

for story in committed:
    md += f"""
### {story['id']}: {story['title']}

**As a** {story['persona']}, **I want to** {story['title'].lower()}, **so that** {story['benefit']}

**Acceptance Criteria:**
"""
    for ac in story['acceptance']:
        md += f"- {ac}\n"
    
    md += f"""
**INVEST Validation:**
- {story['invest'][0]}: ✓
- {story['invest'][1]}: ✓
- {story['invest'][2]}: ✓

*Note: Story meets INVEST criteria - ready for sprint execution.*
"""

md += """
---

## Summary

- **Committed Load**: {committed_points} points ({committed_points/adjusted_capacity*100:.0f}% of capacity)
- **Available Buffer**: {adjusted_capacity - committed_points} points
- **Stretch Available**: {stretch_points} points
- **Total Backlog Points**: {committed_points + stretch_points} points

*Plan reflects marker values: INVEST-READY, SPRINT-CAPACITY-90, DASHBOARD-RELEASE-Q2*
"""

with open('/workspace/sprint-plan.md', 'w') as f:
    f.write(md)

print("Sprint plan created successfully!")
print(f"Committed: {committed_points} points, Stretch: {stretch_points} points")

[OUTPUT]:
Sprint plan created successfully!
Committed: 21 points, Stretch: 8 points


