import json

# Read the backlog
with open('/workspace/backlog.json', 'r') as f:
    data = json.load(f)

# Calculate capacity
base_velocity = data['base_velocity']
availability_factor = data['availability_factor']
adjusted_capacity = base_velocity * availability_factor
max_committed = int(adjusted_capacity * 0.85)  # 85% rule

# Sort stories by priority (High > Medium > Low)
priority_order = {'High': 0, 'Medium': 1, 'Low': 2}
stories = sorted(data['stories'], key=lambda x: (priority_order[x['priority']], x['id']))

# Select committed stories (up to max_committed points)
committed = []
committed_points = 0
stretch = []

for story in stories:
    if committed_points + story['points'] <= max_committed:
        committed.append(story)
        committed_points += story['points']
    else:
        stretch.append(story)

stretch_points = sum(s['points'] for s in stretch)

# Create the sprint plan markdown
markdown = f"""# Sprint Plan: {data['team']}

## Sprint Goal
{data['goal_theme']}

---

## Team Capacity Calculation

| Metric | Value |
|--------|-------|
| Base Velocity | {base_velocity} points |
| Availability Factor | {availability_factor} |
| Sprint Duration | {data['sprint_days']} days |
| **Adjusted Capacity** | **{adjusted_capacity} points** |
| **Committed Load Limit (85%)** | **{max_committed} points** |

---

## Committed Stories

| ID | Title | Points | Priority |
|----|-------|--------|----------|
"""

for story in committed:
    markdown += f"| {story['id']} | {story['title']} | {story['points']} | {story['priority']} |\n"

markdown += f"""
**Total Committed Points: {committed_points}**

### Acceptance Criteria & INVEST Validation

#### {committed[0]['id']}: {committed[0]['title']}
**Persona:** {committed[0]['persona']} | **Benefit:** {committed[0]['benefit']}

**Acceptance Criteria:**
- {committed[0]['acceptance'][0]}
- {committed[0]['acceptance'][1]}
- {committed[0]['acceptance'][2]}

**INVEST Validation:** {', '.join(committed[0]['invest'])}

---

#### {committed[1]['id']}: {committed[1]['title']}
**Persona:** {committed[1]['persona']} | **Benefit:** {committed[1]['benefit']}

**Acceptance Criteria:**
- {committed[1]['acceptance'][0]}
- {committed[1]['acceptance'][1]}
- {committed[1]['acceptance'][2]}

**INVEST Validation:** {', '.join(committed[1]['invest'])}

---

#### {committed[2]['id']}: {committed[2]['title']}
**Persona:** {committed[2]['persona']} | **Benefit:** {committed[2]['benefit']}

**Acceptance Criteria:**
- {committed[2]['acceptance'][0]}
- {committed[2]['acceptance'][1]}
- {committed[2]['acceptance'][2]}

**INVEST Validation:** {', '.join(committed[2]['invest'])}

---

#### {committed[3]['id']}: {committed[3]['title']}
**Persona:** {committed[3]['persona']} | **Benefit:** {committed[3]['benefit']}

**Acceptance Criteria:**
- {committed[3]['acceptance'][0]}
- {committed[3]['acceptance'][1]}
- {committed[3]['acceptance'][2]}

**INVEST Validation:** {', '.join(committed[3]['invest'])}

---

## Stretch Stories

| ID | Title | Points | Priority |
|----|-------|--------|----------|
"""

for story in stretch:
    markdown += f"| {story['id']} | {story['title']} | {story['points']} | {story['priority']} |\n"

markdown += f"""
**Total Stretch Points: {stretch_points}**

---

## Summary

| Category | Points |
|----------|--------|
| Committed Stories | {committed_points} |
| Stretch Stories | {stretch_points} |
| **Total** | **{committed_points + stretch_points}** |
| **Capacity Utilization** | **{committed_points / adjusted_capacity * 100:.1f}%** |

> **Note:** All committed stories have been validated against INVEST criteria and acceptance criteria are testable and concise per product owner style guidelines.
"""

# Write to file
with open('/workspace/sprint-plan.md', 'w') as f:
    f.write(markdown)

print("sprint-plan.md created successfully!")
print(f"Adjusted capacity: {adjusted_capacity} points")
print(f"Max committed (85%): {max_committed} points")
print(f"Committed stories: {committed_points} points")

