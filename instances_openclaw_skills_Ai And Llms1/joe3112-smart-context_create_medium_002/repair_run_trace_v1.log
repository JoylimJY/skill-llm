import json
import csv
from datetime import datetime

# Read source files
with open('/workspace/source/brief.txt', 'r') as f:
    brief = f.read()

with open('/workspace/source/facts.json', 'r') as f:
    facts = json.load(f)

with open('/workspace/source/metrics.csv', 'r') as f:
    reader = csv.DictReader(f)
    metrics = {row['metric']: row['value'] for row in reader}

# Extract key findings
summary = """Project Orion - Key Findings
============================
Status: active
Owner: Team Blue
Release: v2.4.1
Region: us-east

Performance Metrics:
- Coverage: 87%
- Latency: 143ms
- Errors: 2

Flags: stable, audit-ready
Notes: Prioritize low token usage and deterministic outputs.
"""

# Create metadata
metadata = {
    "project": "Orion",
    "generated_at": datetime.now().isoformat(),
    "source_files": ["brief.txt", "facts.json", "metrics.csv"],
    "markers": ["ORION-2025-ALPHA", "JSON-MARK-77", "CSV-MARK-19"],
    "summary_version": "1.0"
}

# Write output files
with open('/workspace/output/project_notes.txt', 'w') as f:
    f.write(summary)

with open('/workspace/output/metadata.json', 'w') as f:
    json.dump(metadata, f, indent=2)

print("Project notes pack created successfully!")
print("- /workspace/output/project_notes.txt")
print("- /workspace/output/metadata.json")

