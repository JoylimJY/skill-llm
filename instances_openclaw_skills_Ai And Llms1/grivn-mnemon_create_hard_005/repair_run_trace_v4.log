    "type": "decision",
    "category": "decisions",
    "content": "All weekly review notes must be summarized in Markdown before being archived.",
    "source": "briefing.json"
}

# 4. Factual constraint about staging API
store["staging_api_constraint"] = {
    "type": "fact",
    "category": "constraints",
    "content": "The staging API endpoint is read-only during the current test window.",
    "source": "briefing.json"
}

# 5. Operational impact (causal consequence)
store["staging_api_impact"] = {
    "type": "operational",
    "category": "constraints",
