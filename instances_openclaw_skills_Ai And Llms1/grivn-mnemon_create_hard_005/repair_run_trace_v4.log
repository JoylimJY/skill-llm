    "from": "team_preference",
    "to": "weekly_review_decision",
    "description": "Preference for concise labels influences the Markdown summarization decision"
}

print("\nMemories created:")
for key in store.keys():
    print(f"  - {key}")

print(f"\nTotal memories: {len(store)}")
