def mnemon(be="redis", **kwargs):
    if be not in {"file", "redis"}:
        raise NotImplementedError(be)

    if be == "redis":
        try:
            rc = MnRedis(**kwargs)
            rc.d.ping()
            return rc
        except (ImportError, RedisConnectionError):
            # todo: something not too invasive to point out the 'file' fallback
            pass

    return MnFile(**kwargs)



