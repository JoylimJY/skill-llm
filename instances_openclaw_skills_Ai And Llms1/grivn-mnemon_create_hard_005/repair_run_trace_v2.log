python3 << 'EOF'
import mnemon
import json
import os

# Initialize mnemon store
mnc = mnemon.mnc()

# Read briefing data
with open('/workspace/briefing.json', 'r') as f:
    briefing = json.load(f)

# Create memories for each important item
memories = {}

# 1. Project codename
memories['codename'] = mnc.set('codename', {
    'type': 'codename',
    'value': briefing['codename'],
    'project': briefing['project'],
    'description': f"Project {briefing['project']} uses codename {briefing['codename']}"
})

# 2. Team preference
memories['preference'] = mnc.set('preference', {
    'type': 'preference',
    'value': briefing['preference'],
    'description': "Team preference for memory handling"
})

# 3. Explicit decision
memories['decision'] = mnc.set('decision', {
    'type': 'decision',
    'value': briefing['decision'],
    'description': "Archival policy for weekly review notes"
})

# 4. Factual constraint
memories['fact'] = mnc.set('fact', {
    'type': 'fact',
    'value': briefing['fact'],
    'description': "Staging API constraint during test window"
})

# 5. Causal note (impact)
memories['causal_note'] = mnc.set('causal_note', {
    'type': 'causal_note',
    'value': briefing['causal_note'],
    'description': "Operational impact of read-only staging API"
})

# Store relationships/links - only where genuinely related
# The causal link: fact -> causal_note (the read-only fact causes the mutation blocking)
mnc.set('link_fact_to_causal', {
    'source': 'fact',
    'target': 'causal_note',
    'edge_type': 'causes',
    'description': 'The read-only staging API fact causes the mutation blocking operational impact'
})

# Decision is related to preference (both about memory handling)
mnc.set('link_preference_to_decision', {
    'source': 'preference', 
    'target': 'decision',
    'edge_type': 'aligns_with',
    'description': 'Markdown summary decision aligns with concise memory preference'
})

# Codename identifies the project context for all other memories
mnc.set('link_codename_to_all', {
    'source': 'codename',
    'targets': ['preference', 'decision', 'fact', 'causal_note'],
    'edge_type': 'context_for',
    'description': 'Project codename provides context for all memories'
})

# Store metadata about all created memories
mnc.set('memories_index', memories)

print("Memories created:")
for k, v in memories.items():
    print(f"  {k}: {v}")

print("\nLinks created:")
links = ['link_fact_to_causal', 'link_preference_to_decision', 'link_codename_to_all']
for link in links:
    if link in mnc:
        print(f"  {link}: {mnc.get(link)}")
EOF

