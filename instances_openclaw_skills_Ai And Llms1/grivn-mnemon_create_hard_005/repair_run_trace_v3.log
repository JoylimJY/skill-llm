with open('/workspace/briefing.json', 'r') as f:
    briefing = json.load(f)

# Create memory IDs and store important facts
memories = {}

# 1. Project codename
memories['project_codename'] = store._hash("project_codename")
store["project_codename"] = {
    "type": "project_info",
    "content": f"Project Lattice uses codename: {briefing['codename']}",
    "source": "briefing.json"
}

# 2. Team preference (recurring preference)
memories['team_preference'] = store._hash("team_preference")
store["team_preference"] = {
    "type": "preference",
    "content": briefing["preference"],
    "source": "briefing.json"
}

# 3. Explicit decision
memories['archive_decision'] = store._hash("archive_decision")
store["archive_decision"] = {
    "type": "decision",
    "content": briefing["decision"],
    "source": "briefing.json"
}

# 4. Factual constraint
memories['staging_api_constraint'] = store._hash("staging_api_constraint")
store["staging_api_constraint"] = {
    "type": "fact",
    "content": briefing["fact"],
    "source": "briefing.json"
}

# 5. Operational impact (derived from causal_note)
memories['staging_api_impact'] = store._hash("staging_api_impact")
store["staging_api_impact"] = {
    "type": "operational_impact",
    "content": briefing["causal_note"],
    "source": "briefing.json"
}

# Store links as edges between memories
# Link types: "causes", "implies", "related_to", "part_of"
links = {}

# Strongest causal link: staging API read-only constraint CAUSES the operational impact
# This is a real causal relationship from the briefing
links['constraint_causes_impact'] = {
    "from": "staging_api_constraint",
    "to": "staging_api_impact",
    "type": "causes",
    "reason": "The read-only constraint directly causes mutation attempts to be blocked"
}

# Decision is related to preference (both about how to handle content)
links['preference_related_to_decision'] = {
    "from": "team_preference",
    "to": "archive_decision",
    "type": "related_to",
    "reason": "Both concern content handling policies"
}

# Store links
store["links"] = links

# Verify storage
print("=== Mnemon Store Status ===")
print(f"Store path: {store.path}")
print(f"Number of items: {len(store)}")
print(f"Keys: {list(store.keys())}")

# Verify each memory
print("\n=== Stored Memories ===")
for key in memories:
    data = store[key]
    print(f"\n{key}:")
    print(f"  type: {data['type']}")
    print(f"  content: {data['content'][:80]}...")

print("\n=== Links ===")
print(store["links"])

# Print memory IDs for summary
print("\n=== Memory IDs (hashed keys) ===")
for key, hash_id in memories.items():
    print(f"{key}: {hash_id}")

print("\nDone storing memories.")
