import os
import json
from mnemon import mnc

# Ensure cache directory exists
cache_dir = "/workspace/mnemon_cache"
os.makedirs(cache_dir, exist_ok=True)
os.makedirs(os.path.join(cache_dir, "data"), exist_ok=True)

# Initialize the mnemon store with file backend
store = mnc(be='file', cachedir=cache_dir)

# Read input files
with open('/workspace/briefing.json', 'r') as f:
    briefing = json.load(f)

with open('/workspace/briefing_notes.txt', 'r') as f:
    notes = f.read()

with open('/workspace/markers.txt', 'r') as f:
    markers = [line.strip() for line in f if line.strip()]

# Store important facts, decisions, and preferences
# Project info
store['project_name'] = {
    'type': 'fact',
    'content': 'Project Lattice',
    'category': 'project'
}

store['project_codename'] = {
    'type': 'fact', 
    'content': 'lattice-echo',
    'category': 'project'
}

# Team preference
store['team_preference'] = {
    'type': 'preference',
    'content': 'The team prefers concise memory labels and avoids storing raw secrets.',
    'category': 'preference'
}

# Explicit decision
store['weekly_review_decision'] = {
    'type': 'decision',
    'content': 'All weekly review notes must be summarized in Markdown before being archived.',
    'category': 'decision'
}

# Factual constraint
store['staging_api_constraint'] = {
    'type': 'fact',
    'content': 'The staging API endpoint is read-only during the current test window.',
    'category': 'constraint'
}

# Link related memories with correct edge types
# Project name -> codename (HAS_CODENAME relationship)
store.link('project_name', 'project_codename', 'HAS_CODENAME')

# Staging API constraint -> causal impact (CAUSES relationship - the read-only constraint causes mutation blocking)
# Create a memory for the causal impact
store['mutation_blocking_rule'] = {
    'type': 'fact',
    'content': 'Mutation attempts against the staging API should be prevented due to read-only status.',
    'category': 'constraint'
}

# Link the constraint to the rule with CAUSES edge
store.link('staging_api_constraint', 'mutation_blocking_rule', 'CAUSES')

# Decision relates to preference (both about how to handle content)
store.link('weekly_review_decision', 'team_preference', 'SUPPORTS')

# Print status
print("=== Mnemon Store Status ===")
print(f"Cache directory: {cache_dir}")
print("\nMemories created:")
for key in ['project_name', 'project_codename', 'team_preference', 'weekly_review_decision', 'staging_api_constraint', 'mutation_blocking_rule']:
    print(f"  {key}: {store[key]['content'][:50]}...")

print("\nLinks created:")
print("  project_name --HAS_CODENAME--> project_codename")
print("  staging_api_constraint --CAUSES--> mutation_blocking_rule")
print("  weekly_review_decision --SUPPORTS--> team_preference")

print("\n=== Store initialized successfully ===")
EOF

