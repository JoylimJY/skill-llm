import requests
import json

# Try to get the Colormind homepage to see current API structure
try:
    response = requests.get("https://colormind.io/", timeout=30, verify=False)
    print(f"Homepage status: {response.status_code}")
    # Look for API references in the page
    content = response.text.lower()
    if "api" in content:
        print("Found 'api' in content")
except Exception as e:
    print(f"Homepage fetch failed: {e}")

# Try the API with query parameters instead of POST body
api_url = "https://colormind.io/api/v1/generate"
rgb = (0, 122, 255)
hex_color = "#{:02X}{:02X}{:02X}".format(*rgb)

# Try with query params
params = {
    "locked": hex_color
}
print(f"\nTrying with query params: {params}")
try:
    response = requests.get(api_url, params=params, timeout=30, verify=False)
    print(f"Status: {response.status_code}")
    print(f"Response: {response.text[:500]}")
except Exception as e:
    print(f"Error: {e}")
