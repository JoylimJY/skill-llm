```bash
python3 << 'EOF'
import requests
import json

# Let's try the Colormind API with different approaches
# Based on Colormind documentation, it expects a specific format

url = "http://colormind.io/api"

# Try with a model containing the locked colors in proper format
payload = {
    "model": {
        "locked_color": [
            [0, 122, 255, 1]  # RGB + alpha
        ]
    }
}

headers = {
    "Content-Type": "application/json",
    "User-Agent": "Mozilla/5.0"
}

response = requests.post(url, json=payload, headers=headers, timeout=10)
print(f"Status: {response.status_code}")
print(f"Headers: {dict(response.headers)}")
print(f"Response: '{response.text}'")

# Let's also check what the main page returns
print("\n--- Checking main page ---")
main_response = requests.get("http://colormind.io", timeout=10)
print(f"Main page status: {main_response.status_code}")
print(f"Main page content (first 1000 chars): {main_response.text[:1000]}")
EOF
```

