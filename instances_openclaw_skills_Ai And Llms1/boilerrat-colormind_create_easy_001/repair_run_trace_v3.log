import requests
import json

# Try the Colormind raw palette generation URL
# Colormind allows generating palettes via URL parameters
urls = [
    "http://colormind.io/api/raw",
    "http://colormind.io/api/raw.php",
    "http://colormind.io/api/generate",
    "http://colormind.io/generate.json",
]

for url in urls:
    print(f"\nTrying: {url}")
    params = {"locked_color": "[[0,122,255]]"}
    try:
        response = requests.get(url, params=params, timeout=10)
        print(f"Status: {response.status_code}")
        print(f"Response: {response.text[:300]}")
