[EXECUTING bash]:
python3 << 'EOF'
import json
import colorsys
import random

# Set seed for reproducibility
random.seed(42)

# Locked color: RGB(0, 122, 255) = #007AFF
locked_rgb = (0, 122, 255)
locked_hex = "#007AFF"

def rgb_to_hex(r, g, b):
    return "#{:02X}{:02X}{:02X}".format(r, g, b)

def hex_to_rgb(hex_color):
    hex_color = hex_color.lstrip('#')
    return tuple(int(hex_color[i:i+2], 16) for i in (0, 2, 4))

def generate_harmonious_colors(base_rgb, num_colors=4):
    """Generate harmonious colors for UI design"""
    colors = [base_rgb]
    
    # Convert base color to HSV for color wheel operations
    r, g, b = [x / 255.0 for x in base_rgb]
    h, s, v = colorsys.rgb_to_hsv(r, g, b)
    
    # Generate complementary/analogous colors for UI
    color_variations = []
    
    # Analogous colors (colors next to base on color wheel)
    color_variations.append(((h + 0.1) % 1.0, s, v))
    color_variations.append(((h - 0.1) % 1.0, s, v))
    
    # Lighter version (for backgrounds/highlights)
    color_variations.append((h, s * 0.3, min(v + 0.3, 1.0)))
    
    # Darker version (for text/contrast)
    color_variations.append((h, s, max(v - 0.3, 0.2)))
    
    # Neutral gray for UI elements
    neutral_h = h
    neutral_s = 0.1
    neutral_v = 0.7
    color_variations.append((neutral_h, neutral_s, neutral_v))
    
    # Select colors
    for i in range(num_colors):
        if i < len(color_variations):
            h, s, v = color_variations[i]
            r, g, b = colorsys.hsv_to_rgb(h, s, v)
            colors.append((int(r * 255), int(g * 255), int(b * 255)))
        else:
            # Fallback: generate light/dark variations
            factor = 0.8 + (i * 0.05)
            colors.append((
                int(min(255, locked_rgb[0] * factor)),
                int(min(255, locked_rgb[1] * factor)),
                int(min(255, locked_rgb[2] * factor))
            ))
    
    return colors

# Generate palette
palette_rgb = generate_harmonious_colors(locked_rgb, 4)

# Convert to hex
palette_hex = [rgb_to_hex(r, g, b) for r, g, b in palette_rgb]

# Create palette data structure
palette_data = {
    "name": "Landing Page Refresh - Modern UI",
    "project": "landing-page-refresh",
    "style": "modern-ui",
    "locked_color": {
        "rgb": locked_rgb,
        "hex": locked_hex
    },
    "colors": [
        {
            "position": i + 1,
            "rgb": rgb,
            "hex": hex_color
        }
        for i, (rgb, hex_color) in enumerate(zip(palette_rgb, palette_hex))
    ],
    "hex_palette": palette_hex,
    "rgb_palette": palette_rgb
}

# Save to palette.json
with open('/workspace/palette.json', 'w') as f:
    json.dump(palette_data, f, indent=2)

print("palette.json created successfully!")
print(json.dumps(palette_data, indent=2))

# Create markdown summary
md_content = """# Color Palette Summary

## Project: Landing Page Refresh - Modern UI

A UI-focused color palette generated with the first color locked to **RGB(0, 122, 255)**.

## Palette Colors

| Position | Hex | RGB |
|----------|-----|-----|
"""

for i, (rgb, hex_color) in enumerate(zip(palette_rgb, palette_hex), 1):
    marker = " *(locked)*" if i == 1 else ""
    md_content += f"| {i} | `{hex_color}` | `rgb({rgb[0]}, {rgb[1]}, {rgb[2]})`{marker} |\n"

md_content += """
## Color Details

### Primary Color (Locked)
- **Hex:** `#007AFF`
- **RGB:** `rgb(0, 122, 255)`

### Secondary Colors
"""

for i, (rgb, hex_color) in enumerate(zip(palette_rgb[1:], palette_hex[1:]), 1):
    md_content += f"""
#### Color {i + 1}
- **Hex:** `{hex_color}`
- **RGB:** `rgb({rgb[0]}, {rgb[1]}, {rgb[2]})`
"""

md_content += """
## Usage Guidelines

- **Primary Color (#007AFF):** Use for main call-to-action buttons, links, and key interactive elements.
- **Secondary Colors:** Use for backgrounds, accents, and supporting UI elements.
- **Design Style:** Modern UI - clean, professional, and visually appealing for landing pages.
"""

with open('/workspace/palette_summary.md', 'w') as f:
    f.write(md_content)

print("\npalette_summary.md created successfully!")
EOF

