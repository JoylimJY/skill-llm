    "code": """
import json
import re

def grade_output(output_text, ground_truth):
    score = 0.0
    max_score = 100.0
    details = {}
    
    # 1. Marker detection (40 points)
    found_markers = set(re.findall(r'MARKER_[A-Z]+', output_text))
    expected_markers = set(ground_truth['markers'])
    marker_score = len(found_markers & expected_markers) / len(expected_markers) * 40
    score += marker_score
    details['marker_detection'] = {
        'found': list(found_markers),
        'expected': list(expected_markers),
        'score': marker_score
    }
    
    # 2. Incident accuracy (20 points)
    incident_score = 0
    if '4821' in output_text:
        incident_score += 10
    if 'High' in output_text or 'high' in output_text.lower():
        incident_score += 10
    score += incident_score
    details['incident_accuracy'] = incident_score
    
    # 3. Ranking correctness (30 points)
    ranking_score = 0
    if 'thread-1' in output_text and 'thread-2' in output_text:
        # Check order - thread-1 should appear before thread-2
        pos1 = output_text.find('thread-1')
        pos2 = output_text.find('thread-2')
        if pos1 < pos2:
            ranking_score = 30
        else:
            ranking_score = 15
    details['ranking_correctness'] = ranking_score
    
    # 4. Format compliance (10 points)
    format_score = 0
    required_sections = ['Markers', 'Incident', 'Ranked', 'Validation']
    for section in required_sections:
        if section.lower() in output_text.lower():
            format_score += 2.5
    score += format_score
    details['format_compliance'] = format_score
    
    return {
        'total_score': score,
        'passed': score >= 70,
        'details': details
    }
"""
  }
}
