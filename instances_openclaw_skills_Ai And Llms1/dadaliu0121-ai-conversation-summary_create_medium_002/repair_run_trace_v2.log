import json

# Read the chat log
with open('/workspace/chat.json', 'r') as f:
    chat = json.load(f)

# Read the history summary
with open('/workspace/history_summary.txt', 'r') as f:
    history_summary = f.read().strip()

# Create the summary
summary = {
    "main_topics": ["Weekend trip planning to Kyoto"],
    "decisions": [
        "Mix of activities: temples, food, and shopping",
        "Budget constraint: under $600 total"
    ],
    "action_items": [
        "Draft a budget-friendly 2-day itinerary with transit estimates",
        "Book hotels before Friday"
    ],
    "incremental": {
        "previous_summary": history_summary,
        "new_details": "User confirmed mix of activities (temples, food, shopping) with $600 budget. Assistant will create 2-day itinerary with transit. Hotel booking deadline set for Friday.",
        "combined_summary": "User planning a weekend trip to Kyoto with a $600 budget, wanting a mix of temples, food, and shopping. Assistant will draft a 2-day budget-friendly itinerary with transit estimates. Hotel booking reminder set for Friday."
    }
}

# Save to summary.json
with open('/workspace/summary.json', 'w') as f:
    json.dump(summary, f, indent=2)

print("Summary created successfully!")
print(json.dumps(summary, indent=2))

