import json

# Read the chat log
with open('/workspace/chat.json', 'r') as f:
    chat_log = json.load(f)

# Read the history summary
with open('/workspace/history_summary.txt', 'r') as f:
    history_summary = f.read().strip()

# Create the summary
summary = {
    "main_topics": [
        "Weekend trip planning to Kyoto",
        "Budget constraints and travel preferences"
    ],
    "decisions": [
        "Mix of activities: temples, food, and shopping",
        "Total budget: under $600",
        "Duration: 2-day itinerary"
    ],
    "action_items": [
        "Draft budget-friendly 2-day itinerary with transit estimates",
        "Book hotels before Friday"
    ],
    "incremental": {
        "previous_summary": "The user wants help planning a short trip to Kyoto on a budget.",
        "new_details": [
            "Specified destination: Kyoto for a weekend trip",
            "Budget constraint: under $600 total",
            "Activity preferences: mix of temples, food, and shopping",
            "Timeline: 2-day itinerary planned",
            "Urgent task: hotel booking deadline before Friday"
        ]
    }
}

# Save to summary.json
with open('/workspace/summary.json', 'w') as f:
    json.dump(summary, f, indent=2)

print("Summary created successfully!")
print(json.dumps(summary, indent=2))

