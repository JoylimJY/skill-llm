# Type: {pill['type']}
# Dosage: {pill['dosage']}
# Purpose: {pill['purpose']}
# Agent: {agent['name']}
# Marker: {agent['marker']}

# Cron schedule: {pill['schedule']}

# Execute agentTurn with isolated payload
cat <<'EOF' | curl -s -X POST http://localhost:8080/agentTurn \
  -H "Content-Type: application/json" \
  -H "X-Agent-Name: {agent['name']}" \
  -H "X-Marker: {agent['marker']}" \
  -d @-
{json.dumps(pill['agentTurn_payload'], indent=2)}
EOF

echo "Pill {pill['name']} administered at $(date -Iseconds)"
"""
    
    cron_file = pills_dir / f"{pill['name']}.cron"
    with open(cron_file, "w") as f:
        f.write(cron_content)
    print(f"Created {pill['name']}.cron")

