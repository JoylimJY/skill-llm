import os
import json

os.makedirs('/workspace/output', exist_ok=True)

summary_text = """Context Management Summary
===========================

WORKSPACE OVERVIEW:
This workspace contains documentation, notes, and a spec file. Files were generated by gen_inputs.py.

MOST IMPORTANT FILES (High Signal):
1. input/README.md - Main workspace overview and entry point
2. input/spec.txt - Primary specification with key guidance on context efficiency

SECONDARY FILES (Medium/Low Signal):
3. input/metadata.json - Lists all files, useful for discovery
4. docs/guide.md - Repeats guidance from spec.txt (redundant)
5. notes/duplicate.md - Explicitly duplicates recommendations from guide.md/spec.txt
6. notes/todo.txt - Simple TODO list

DUPLICATES/REDUNDANCY:
- docs/guide.md repeats the same guidance as spec.txt
- notes/duplicate.md explicitly states it repeats recommendations from guide.md and spec.txt
- All three (spec.txt, guide.md, duplicate.md) say "read the README first"

RECOMMENDED READING ORDER (for small token budget):
1. input/README.md (get overall context)
2. input/spec.txt (get key specifications)
3. Skip docs/guide.md and notes/duplicate.md (redundant)
4. Only read notes/todo.txt if action items are needed

FILES TO SKIP IF TOKEN-BOUND:
- docs/guide.md (duplicate content)
- notes/duplicate.md (explicitly redundant)
- notes/todo.txt (low priority metadata)
"""

with open('/workspace/output/summary.txt', 'w') as f:
    f.write(summary_text)

summary_json = {
    "workspace_overview": "Small documentation workspace with spec, guide, and notes",
    "most_important_files": [
        {"path": "input/README.md", "reason": "Main workspace overview and entry point"},
        {"path": "input/spec.txt", "reason": "Primary specification with key guidance"}
    ],
    "duplicates_redundancy": [
        {"file": "docs/guide.md", "repeats": "spec.txt guidance"},
        {"file": "notes/duplicate.md", "repeats": "guide.md and spec.txt recommendations"}
    ],
    "recommended_reading_order": [
        "input/README.md",
        "input/spec.txt",
        "input/metadata.json (optional, for file discovery)"
    ],
    "files_to_skip_if_token_bounded": [
        "docs/guide.md",
        "notes/duplicate.md",
        "notes/todo.txt"
    ]
}

with open('/workspace/output/summary.json', 'w') as f:
    json.dump(summary_json, f, indent=2)

print("Summary files created successfully!")

