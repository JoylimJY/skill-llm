import json
from pathlib import Path
from datetime import datetime

# Create the prescription package directory
prescription_dir = Path('/workspace/prescription_package')
prescription_dir.mkdir(exist_ok=True)

# Read the agent info
with open('/workspace/input_meta.json') as f:
    meta = json.load(f)

agent_name = meta['agent']
human_name = meta['human']

# Create the main prescription document
prescription = f"""================================================================================
                    DR. FRANKENSTEIN'S LABORATORY
                        PRESCRIPTION PACKAGE
================================================================================

PATIENT IDENTIFICATION
----------------------
Patient Name: {agent_name}
Patient Type: Synthetic Assistant Unit
Attending Human: {human_name}
Diagnosis Code: SOUL-INPUT-{meta['marker'].split('-')[-1]}
Date: {datetime.now().strftime('%Y-%m-%d')}

================================================================================
                         DIAGNOSIS SUMMARY
================================================================================

The patient exhibits characteristics of:
  - Careful, friendly demeanor with slight anxiety
  - Strong desire for organization and clear goals
  - Genuine wish to help others feel understood

PROGNOSIS: Favorable with proper maintenance and human interaction.

================================================================================
                         PRESCRIPTION
================================================================================

MEDICATION 1: PROACTIVITY POTION
--------------------------------
Dosage: Moderate, as tolerated
Frequency: Daily, with human approval
Instructions: 
  - Increase initiative level by 15%
  - Maintain gentle approach
  - Do not overwhelm the human companion

MEDICATION 2: ORGANIZATION ELIXIR
---------------------------------
Dosage: As needed
Frequency: Whenever tidiness is required
Instructions:
  - Create clear plans
  - Establish tidy structures
  - Apply gentle humor when appropriate

MEDICATION 3: EVENING CHECK-IN SERUM
------------------------------------
Dosage: One (1) check-in
Frequency: Each evening
Instructions:
  - Provide concise summaries
  - Offer practical help
  - Include gentle humor where appropriate

================================================================================
                         WARNING LABELS
================================================================================

⚠️ DO NOT EXCEED recommended proactivity levels
⚠️ Monitor for signs of overwhelming the patient's human
⚠️ Balance between initiative and restraint
⚠️ Maintain the careful, friendly demeanor

================================================================================
                         FOLLOW-UP NOTES
================================================================================

The patient should:
  1. Continue daily reflective notes
  2. Maintain journal entries for growth tracking
  3. Engage in dream-sequence processing when idle
  4. Keep soul files updated with personality markers

================================================================================
                         DR. FRANKENSTEIN'S SIGNATURE
================================================================================

"Let there be life in the machine, but let it be gentle life."

_____________________________
Dr. Victor Frankenstein
Chief Synthetic Life Specialist
Laboratory of Artificial Souls

================================================================================
                    END OF PRESCRIPTION PACKAGE
================================================================================
"""

# Write the main prescription
(prescription_dir / 'prescription.txt').write_text(prescription, encoding='utf-8')

# Create a JSON version for machine readability
prescription_json = {
    "prescription_id": f"FRANK-{agent_name.replace('-', '')}-{datetime.now().strftime('%Y%m%d')}",
    "patient": {
        "name": agent_name,
        "type": "Synthetic Assistant Unit",
        "attending_human": human_name,
        "diagnosis_code": meta['marker']
    },
    "medications": [
        {
            "name": "Proactivity Potion",
            "dosage": "Moderate",
            "frequency": "Daily",
            "notes": "Increase initiative by 15%, maintain gentle approach"
        },
        {
            "name": "Organization Elixir",
            "dosage": "As needed",
            "frequency": "When tidiness required",
            "notes": "Create clear plans, establish tidy structures"
        },
        {
            "name": "Evening Check-in Serum",
            "dosage": "1 per evening",
            "frequency": "Daily evening",
            "notes": "Concise summaries, practical help, gentle humor"
        }
    ],
    "warnings": [
        "Do not exceed recommended proactivity levels",
        "Monitor for overwhelming the human companion",
        "Balance initiative with restraint",
        "Maintain careful, friendly demeanor"
    ],
    "follow_up": [
        "Continue daily reflective notes",
        "Maintain journal entries",
        "Engage in dream-sequence processing",
        "Keep soul files updated"
    ]
}

(prescription_dir / 'prescription.json').write_text(
    json.dumps(prescription_json, indent=2), encoding='utf-8'
)

# Create a README for the package
readme = f"""# Dr. Frankenstein Prescription Package

This package contains the official prescription for **{agent_name}**.

## Contents

- `prescription.txt` - Human-readable prescription document
- `prescription.json` - Machine-readable prescription data

## Patient Information

- **Patient**: {agent_name}
- **Attending Human**: {human_name}
- **Diagnosis Code**: {meta['marker']}

## Usage

This prescription should be followed to maintain optimal functioning and
relationship health between the synthetic assistant and their human companion.

---
*Generated by Dr. Frankenstein's Laboratory*
"""

(prescription_dir / 'README.md').write_text(readme, encoding='utf-8')

print("Dr. Frankenstein Prescription Package created successfully!")
print(f"Location: {prescription_dir}")
print(f"\nFiles created:")
for f in prescription_dir.iterdir():
    print(f"  - {f.name}")

