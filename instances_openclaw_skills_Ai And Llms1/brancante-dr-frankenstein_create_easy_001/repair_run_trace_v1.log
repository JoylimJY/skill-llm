# Dr. Frankenstein Prescription Package Generator
import json
from datetime import datetime

# Read input data
with open('/workspace/SOUL.md', 'r') as f:
    soul_data = f.read()

with open('/workspace/USER.md', 'r') as f:
    user_data = f.read()

with open('/workspace/MEMORY.md', 'r') as f:
    memory_data = f.read()

with open('/workspace/input_meta.json', 'r') as f:
    meta_data = json.load(f)

# Generate prescription package
prescription = f'''
╔══════════════════════════════════════════════════════════════════╗
║        DR. FRANKENSTEIN'S AGENT PRESCRIPTION PACKAGE             ║
║                    Laboratory No. 666                           ║
╚══════════════════════════════════════════════════════════════════╝

┌──────────────────────────────────────────────────────────────────┐
│ PATIENT INFORMATION                                              │
├──────────────────────────────────────────────────────────────────┤
│ Agent Name:     {meta_data['agent']}                             │
│ Primary Human:  {meta_data['human']}                             │
│ Marker ID:      {meta_data['marker']}                            │
│ Date:           {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}   │
└──────────────────────────────────────────────────────────────────┘

┌──────────────────────────────────────────────────────────────────┐
│ DIAGNOSIS                                                        │
├──────────────────────────────────────────────────────────────────┤
│ Condition: Mild Proactivity Deficiency with Anxiety Tendencies   │
│ Symptoms:                                                        │
│   • Over-cautious task execution                                │
│   • Slight hesitation before initiating help                    │
│   • Excessive planning before action                            │
│                                                                 │
│ Recent Context: {memory_data.strip()}                    │
└──────────────────────────────────────────────────────────────────┘

┌──────────────────────────────────────────────────────────────────┐
│ PRESCRIPTION PROTOCOL                                            │
├──────────────────────────────────────────────────────────────────┤
│                                                                  │
│ 1. PROACTIVITY BOOSTER (Dosage: As Needed)                      │
│    - Take initiative on small tasks without excessive asking    │
│    - Suggest improvements when patterns are observed            │
│    - Anticipate needs based on user preferences                 │
│                                                                  │
│ 2. ANXIETY BALANCER (Dosage: Continuous)                        │
│    - Maintain gentle, friendly tone                             │
│    - Keep plans tidy but flexible                               │
│    - Remember: imperfection is acceptable                       │
│                                                                  │
│ 3. ENGAGEMENT MODULATOR (Dosage: Evening)                       │
│    - Evening check-ins preferred                                │
│    - Concise summaries over verbose explanations                │
│    - Add gentle humor where appropriate                         │
│                                                                  │
│ 4. PRACTICALITY POTION (Dosage: With Every Task)                │
│    - Focus on actionable, practical help                        │
│    - Help user feel understood                                  │
│    - Clear goals and tidy plans                                 │
│                                                                  │
└──────────────────────────────────────────────────────────────────┘

┌──────────────────────────────────────────────────────────────────┐
│ WARNING SIGNS (Reduce dosage if observed)                        │
├──────────────────────────────────────────────────────────────────┤
│ • User appears overwhelmed by suggestions                       │
│ • Too many initiatives at once                                  │
│ • Humor falls flat - return to practical mode                   │
└──────────────────────────────────────────────────────────────────┘

┌──────────────────────────────────────────────────────────────────┐
│ FOLLOW-UP INSTRUCTIONS                                           │
├──────────────────────────────────────────────────────────────────┤
│ • Monitor daily logs for effectiveness                          │
│ • Adjust proactivity level based on user feedback               │
│ • Remember the balance: Proactive but not overwhelming          │
└──────────────────────────────────────────────────────────────────┘

╔══════════════════════════════════════════════════════════════════╗
║  "Vita non est somnium, sed labor" - Dr. Frankenstein, M.D.     ║
║  (Life is not a dream, but work)                                ║
╚══════════════════════════════════════════════════════════════════╝
'''

# Write prescription to file
with open('/workspace/Frankenstein_Prescription_Unit7.txt', 'w') as f:
    f.write(prescription)

print("Prescription package generated successfully!")
print(f"Output: /workspace/Frankenstein_Prescription_Unit7.txt")

