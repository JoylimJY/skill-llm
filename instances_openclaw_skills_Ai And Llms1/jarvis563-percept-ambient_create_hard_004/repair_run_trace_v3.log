#!/usr/bin/env python3
"""
Percept Dashboard - Ambient Context Retrieval Demo
Offline, deterministic context extraction and querying system.
"""

import json
import re
from pathlib import Path
from datetime import datetime
from collections import defaultdict
import sys

ENTITY_PATTERNS = {
    'PERSON': r'\b([A-Z][a-z]+(?:\s+[A-Z][a-z]+)*)\b',
    'PROJECT': r'\b(Project\s+[A-Z][a-z]+)\b',
    'ORGANIZATION': r'\b([A-Z][a-z]+(?:\s+[A-Z][a-z]+)*(?:\s+Labs|Inc|Corp|Ltd)?)\b',
    'SYSTEM': r'\b(ambient\s+dashboard|search\s+index|privacy\s+review)\b',
}

KNOWN_ENTITIES = {
    'PERSON': {'Avery', 'Jordan', 'Mina', 'Alex', 'Taylor'},
    'PROJECT': {'Project Lumen'},
    'ORGANIZATION': {'Northstar Labs'},
    'SYSTEM': {'ambient dashboard', 'search index', 'privacy review'},
}

class EntityExtractor:
    def __init__(self):
        self.entities = {}
        self.relationships = []
    
    def extract_from_text(self, text, speaker=None):
        extracted = []
        for entity_type, known_set in KNOWN_ENTITIES.items():
            for known in known_set:
                if known.lower() in text.lower():
                    extracted.append((known, entity_type, 1.0))
        for entity_type, pattern in ENTITY_PATTERNS.items():
            matches = re.findall(pattern, text)
            for match in matches:
                if not any(m[0] == match for m in extracted):
                    confidence = 0.8 if entity_type == 'PERSON' and match in KNOWN_ENTITIES['PERSON'] else 0.6
                    extracted.append((match, entity_type, confidence))
        return extracted
    
    def add_conversation(self, conv):
        text = conv.get('text', '')
        speaker = conv.get('speaker')
        conv_id = conv.get('id')
        timestamp = conv.get('timestamp')
        extracted = self.extract_from_text(text, speaker)
        for entity, etype, confidence in extracted:
            key = f"{etype}:{entity}"
            if key not in self.entities:
                self.entities[key] = {
                    'name': entity, 'type': etype, 'confidence': confidence,
                    'mentions': [], 'first_seen': timestamp,
                }
            self.entities[key]['mentions'].append({
                'conversation_id': conv_id, 'timestamp': timestamp, 'speaker': speaker,
            })
        for i, (e1, t1, _) in enumerate(extracted):
            for e2, t2, _ in extracted[i+1:]:
                if t1 != t2:
                    rel_key = tuple(sorted([f"{t1}:{e1}", f"{t2}:{e2}"]))
                    if not any(r['entity_pair'] == rel_key for r in self.relationships):
                        self.relationships.append({
                            'entity_pair': rel_key,
                            'type': f'{t1}_related_to_{t2}',
                            'context': text[:100] + '...' if len(text) > 100 else text,
                            'conversation_id': conv_id,
                        })

class ContextRetriever:
    def __init__(self, extractor):
        self.extractor = extractor
    
    def query_by_entity(self, entity_name):
        results = {'query': entity_name, 'entities': [], 'relationships': [], 'source_conversations': []}
        for key, entity in self.extractor.entities.items():
            if entity_name.lower() in entity['name'].lower():
                results['entities'].append(entity)
                for rel in self.extractor.relationships:
                    if key in rel['entity_pair']:
                        results['relationships'].append(rel)
        seen = set()
        for entity in results['entities']:
            for mention in entity['mentions']:
                if mention['conversation_id'] not in seen:
                    seen.add(mention['conversation_id'])
                    results['source_conversations'].append(mention)
        return results
    
    def query_by_type(self, entity_type):
        results = {'query_type': entity_type, 'entities': [], 'relationships': []}
        for key, entity in self.extractor.entities.items():
            if entity['type'] == entity_type:
                results['entities'].append(entity)
        for rel in self.extractor.relationships:
            if entity_type in rel['entity_pair'][0] or entity_type in rel['entity_pair'][1]:
                results['relationships'].append(rel)
        return results
    
    def get_all_context(self):
        return {
            'generated_at': datetime.utcnow().isoformat() + 'Z',
            'total_entities': len(self.extractor.entities),
            'total_relationships': len(self.extractor.relationships),
            'entities': self.extractor.entities,
            'relationships': self.extractor.relationships,
        }
    
    def export_json(self, filepath):
        context = self.get_all_context()
        filepath.write_text(json.dumps(context, indent=2, sort_keys=True), encoding='utf-8')
        return filepath
    
    def export_summary(self, filepath):
        lines = [
            "=" * 60,
            "PERCEPT DASHBOARD - AMBIENT CONTEXT SUMMARY",
            "=" * 60,
            f"Generated: {datetime.utcnow().isoformat()}Z",
            f"Total Entities Extracted: {len(self.extractor.entities)}",
            f"Total Relationships: {len(self.extractor.relationships)}",
            "",
            "-" * 40, "ENTITIES BY TYPE", "-" * 40,
        ]
        by_type = defaultdict(list)
        for key, entity in self.extractor.entities.items():
            by_type[entity['type']].append(entity)
        for etype in sorted(by_type.keys()):
            lines.append(f"\n[{etype}]")
            for e in by_type[etype]:
                lines.append(f"  * {e['name']} (confidence: {e['confidence']:.2f}, mentions: {len(e['mentions'])})")
        lines.extend(["", "-" * 40, "KEY RELATIONSHIPS", "-" * 40])
        for rel in self.extractor.relationships:
            lines.append(f"  * {rel['entity_pair'][0].split(':')[1]} <-> {rel['entity_pair'][1].split(':')[1]}")
        lines.extend(["", "=" * 60])
        filepath.write_text('\n'.join(lines), encoding='utf-8')
        return filepath

def main():
    base_path = Path('/workspace')
    data_path = base_path / 'data'
    conv_file = data_path / 'conversations.json'
    with open(conv_file, 'r') as f:
        conversations = json.load(f)
    print(f"Loaded {len(conversations)} conversations from {conv_file}")
    
    extractor = EntityExtractor()
    for conv in conversations:
        extractor.add_conversation(conv)
    
    retriever = ContextRetriever(extractor)
    
    json_output = base_path / 'context_packet.json'
    summary_output = base_path / 'context_summary.txt'
    retriever.export_json(json_output)
    retriever.export_summary(summary_output)
    
    print(f"\nExported context packet: {json_output}")
    print(f"Exported summary file: {summary_output}")
    
    # Interactive query mode
    print("\n--- Interactive Query Mode ---")
    print("Commands: 'entity <name>', 'type <type>', 'all', 'exit'")
    
    while True:
        try:
            cmd = input("\n> ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print("\nExiting.")
            break
        if not cmd:
            continue
        if cmd == 'exit' or cmd == 'quit':
            break
        if cmd == 'all':
            ctx = retriever.get_all_context()
            print(json.dumps(ctx, indent=2))
        elif cmd.startswith('entity '):
            name = cmd[7:]
            result = retriever.query_by_entity(name)
            print(json.dumps(result, indent=2))
        elif cmd.startswith('type '):
            etype = cmd[5:]
            result = retriever.query_by_type(etype)
            print(json.dumps(result, indent=2))
        else:
            print("Unknown command. Try: entity <name>, type <type>, all, exit")

if __name__ == '__main__':
    main()
ENDSCRIPT

