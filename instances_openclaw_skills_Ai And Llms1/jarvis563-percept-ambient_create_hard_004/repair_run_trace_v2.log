#!/usr/bin/env python3
"""
Ambient Context Retrieval Demo for Percept Dashboard
Offline, deterministic entity extraction and relationship building.
"""

import json
import csv
import re
from datetime import datetime
from collections import defaultdict

# Load conversations
with open('/workspace/data/conversations.json', 'r') as f:
    conversations = json.load(f)

# Define entity patterns for deterministic extraction
ENTITY_PATTERNS = {
    'person': r'\b(Avery|Jordan|Mina)\b',
    'organization': r'\b(Northstar Labs)\b',
    'project': r'\b(Project Lumen|ambient dashboard|search index)\b',
    'date': r'\b(Friday|2025-05-01)\b'
}

def extract_entities(text):
    """Extract entities from text using regex patterns."""
    entities = []
    for entity_type, pattern in ENTITY_PATTERNS.items():
        matches = re.findall(pattern, text)
        for match in matches:
            entities.append({
                'text': match,
                'type': entity_type
            })
    return entities

def normalize_entity_name(name):
    """Normalize entity name for consistent matching."""
    return name.lower().strip()

def build_entity_id(entity):
    """Build unique ID for an entity."""
    return f"{entity['type']}_{normalize_entity_name(entity['text'])}"

def extract_relationships(conversation):
    """Extract relationships between entities in a conversation."""
    text = conversation['text']
    entities = extract_entities(text)
    relationships = []
    
    # Build co-occurrence relationships
    for i, e1 in enumerate(entities):
        for e2 in entities[i+1:]:
            if e1['type'] != e2['type']:
                relationships.append({
                    'source': build_entity_id(e1),
                    'target': build_entity_id(e2),
                    'source_type': e1['type'],
                    'target_type': e2['type'],
                    'source_text': e1['text'],
                    'target_text': e2['text'],
                    'context': conversation['text'][:100] + '...'
                })
    
    # Extract speaker-entity relationships
    speaker = conversation['speaker']
    for entity in entities:
        if entity['type'] != 'person' or normalize_entity_name(entity['text']) != normalize_entity_name(speaker):
            relationships.append({
                'source': f"person_{normalize_entity_name(speaker)}",
                'target': build_entity_id(entity),
                'source_type': 'person',
                'target_type': entity['type'],
                'source_text': speaker,
                'target_text': entity['text'],
                'context': conversation['text'][:100] + '...'
            })
    
    return relationships

# Process all conversations
all_entities = {}
all_relationships = []
conversation_summaries = []

for conv in conversations:
    entities = extract_entities(conv['text'])
    
    # Store unique entities
    for entity in entities:
        entity_id = build_entity_id(entity)
        if entity_id not in all_entities:
            all_entities[entity_id] = {
                'id': entity_id,
                'text': entity['text'],
                'type': entity['type'],
                'mentions': 0
            }
        all_entities[entity_id]['mentions'] += 1
    
    # Extract relationships
    relationships = extract_relationships(conv)
    all_relationships.extend(relationships)
    
    # Build conversation summary
    conversation_summaries.append({
        'id': conv['id'],
        'timestamp': conv['timestamp'],
        'speaker': conv['speaker'],
        'entities_found': [e['text'] for e in entities]
    })

# Deduplicate relationships
unique_relationships = []
seen = set()
for rel in all_relationships:
    key = (rel['source'], rel['target'])
    if key not in seen:
        seen.add(key)
        unique_relationships.append(rel)

# Generate summary.txt
summary_lines = [
    "=" * 60,
    "PERCEPT DASHBOARD - AMBIENT CONTEXT RETRIEVAL SUMMARY",
    "=" * 60,
    "",
    f"Processing Date: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
    f"Total Conversations Analyzed: {len(conversations)}",
    "",
    "-" * 40,
    "ENTITIES EXTRACTED",
    "-" * 40,
]

# Group entities by type
entities_by_type = defaultdict(list)
for eid, entity in all_entities.items():
    entities_by_type[entity['type']].append(entity)

for etype, entities in sorted(entities_by_type.items()):
    summary_lines.append(f"\n{etype.upper()} ({len(entities)}):")
    for e in entities:
        summary_lines.append(f"  - {e['text']} (mentions: {e['mentions']})")

summary_lines.extend([
    "",
    "-" * 40,
    "RELATIONSHIPS BUILT",
    "-" * 40,
])

for rel in unique_relationships:
    summary_lines.append(f"  {rel['source_text']} ({rel['source_type']}) <-> {rel['target_text']} ({rel['target_type']})")

summary_lines.extend([
    "",
    "-" * 40,
    "CONVERSATION TIMELINE",
    "-" * 40,
])

for cs in conversation_summaries:
    summary_lines.append(f"\n[{cs['id']}] {cs['timestamp']} - {cs['speaker']}")
    summary_lines.append(f"  Entities: {', '.join(cs['entities_found']) if cs['entities_found'] else 'None'}")

summary_lines.extend([
    "",
    "=" * 60,
    "END OF SUMMARY",
    "=" * 60,
])

with open('/workspace/summary.txt', 'w') as f:
    f.write('\n'.join(summary_lines))

# Generate context_packet.json
context_packet = {
    'metadata': {
        'version': '1.0',
        'generated_at': datetime.now().isoformat(),
        'source': 'data/conversations.json',
        'total_conversations': len(conversations),
        'total_entities': len(all_entities),
        'total_relationships': len(unique_relationships)
    },
    'conversations': conversations,
    'entities': list(all_entities.values()),
    'relationships': unique_relationships,
    'conversation_summaries': conversation_summaries
}

with open('/workspace/context_packet.json', 'w') as f:
    json.dump(context_packet, f, indent=2)

# Generate entities.csv
with open('/workspace/entities.csv', 'w', newline='') as f:
    writer = csv.writer(f)
    writer.writerow(['id', 'text', 'type', 'mentions'])
    for eid, entity in sorted(all_entities.items()):
        writer.writerow([entity['id'], entity['text'], entity['type'], entity['mentions']])

print("Ambient Context Retrieval Complete!")
print(f"- Summary: /workspace/summary.txt")
print(f"- Context Packet: /workspace/context_packet.json")
print(f"- Entities CSV: /workspace/entities.csv")
print(f"\nExtracted {len(all_entities)} entities and {len(unique_relationships)} relationships.")
EOF

