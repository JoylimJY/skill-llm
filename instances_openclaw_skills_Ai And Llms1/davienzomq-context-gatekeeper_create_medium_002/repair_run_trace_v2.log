#!/usr/bin/env python3
"""
Context Gatekeeper - Generates a compact summary from conversation history.
Preserves key sections: compact summary, pending actions, and recent turns.
"""

import os
import sys
from pathlib import Path


def find_marker(notes_path: Path) -> str:
    """Extract marker from input notes file."""
    marker = "MARKER:UNKNOWN"
    if notes_path.exists():
        content = notes_path.read_text(encoding='utf-8')
        for line in content.split('\n'):
            if 'Marker:' in line:
                parts = line.split('Marker:')
                if len(parts) > 1:
                    marker = parts[1].strip()
                    break
    return marker


def parse_history(history_path: Path) -> list:
    """Parse history file into list of turns."""
    turns = []
    if not history_path.exists():
        return turns
    
    content = history_path.read_text(encoding='utf-8')
    for line in content.strip().split('\n'):
        if line.startswith('USER:') or line.startswith('ASSISTANT:'):
            role = 'USER' if line.startswith('USER:') else 'ASSISTANT'
            text = line.split(':', 1)[1].strip() if ':' in line else ''
            turns.append({'role': role, 'text': text})
    return turns


def extract_pending_actions(turns: list) -> list:
    """Extract pending actions from conversation."""
    actions = []
    action_keywords = ['precisa', 'precisamos', 'deve', 'falta', 'listar', 'revisar', 'incluir']
    
    for turn in turns:
        text_lower = turn['text'].lower()
        if any(kw in text_lower for kw in action_keywords):
            actions.append(turn['text'])
    
    # Also look for explicit to-do items
    for turn in turns:
        if 'teste' in turn['text'].lower() or 'automática' in turn['text'].lower():
            if turn['text'] not in actions:
                actions.append(turn['text'])
    
    return actions if actions else ['Nenhuma ação pendente identificada.']


def generate_compact_summary(turns: list, marker: str) -> str:
    """Generate a compact summary of the conversation."""
    if not turns:
        return "Sem histórico disponível."
    
    # Extract key themes
    themes = []
    for turn in turns:
        text_lower = turn['text'].lower()
        if 'plano' in text_lower or '2026' in text_lower:
            themes.append('Plano 2026')
        if 'itau' in text_lower or 'portfólio' in text_lower:
            themes.append('Portfólio Itaú')
        if 'métric' in text_lower or 'dividendos' in text_lower:
            themes.append('Métricas financeiras')
        if 'gatekeeper' in text_lower or 'teste' in text_lower:
            themes.append('Teste Context Gatekeeper')
        if 'discípulos' in text_lower:
            themes.append('Pergunta sobre discípulos')
    
    unique_themes = list(dict.fromkeys(themes))  # Remove duplicates, keep order
    
    if unique_themes:
        return f"Conversa focada em: {'; '.join(unique_themes)}. Marker: {marker}"
    return f"Resumo compacto do histórico. Marker: {marker}"


def get_recent_turns(turns: list, max_turns: int = 5) -> list:
    """Get the most recent turns."""
    return turns[-max_turns:] if turns else []


def generate_summary_file(output_path: Path, turns: list, marker: str):
    """Generate the current-summary.md file."""
    # Create output directory if needed
    output_path.parent.mkdir(parents=True, exist_ok=True)
    
    compact_summary = generate_compact_summary(turns, marker)
    pending_actions = extract_pending_actions(turns)
    recent_turns = get_recent_turns(turns)
    
    # Build the markdown content
    content = f"""# Context Summary
Generated by Context Gatekeeper

---

## Compact Summary

{compact_summary}

---

## Pending Actions

"""
    for i, action in enumerate(pending_actions, 1):
        content += f"- {action}\n"
    
    content += """
---

## Recent Turns

"""
    for turn in recent_turns:
        role_marker = "👤" if turn['role'] == 'USER' else "🤖"
        content += f"### {role_marker} {turn['role']}\n\n"
        content += f"{turn['text']}\n\n---\n"
    
    content += f"""
---

*Marker: {marker}*
"""
    
    output_path.write_text(content, encoding='utf-8')
    return output_path


def main():
    """Main entry point for Context Gatekeeper."""
    # Determine paths
    script_dir = Path(__file__).parent
    workspace = script_dir.parent.parent.parent
    
    # Try multiple path configurations
    history_path = None
    notes_path = None
    output_path = None
    
    # Configuration 1: Running from skills directory
    if (workspace / 'context' / 'history.txt').exists():
        history_path = workspace / 'context' / 'history.txt'
        notes_path = workspace / 'context' / 'input-notes.md'
        output_path = workspace / 'context' / 'current-summary.md'
    
    # Configuration 2: Running from workspace root
    if history_path is None and (Path('context/history.txt')).exists():
        history_path = Path('context/history.txt')
        notes_path = Path('context/input-notes.md')
        output_path = Path('context/current-summary.md')
    
    # Configuration 3: Custom paths from environment
    if history_path is None:
        history_path = Path(os.environ.get('HISTORY_PATH', 'context/history.txt'))
        notes_path = Path(os.environ.get('NOTES_PATH', 'context/input-notes.md'))
        output_path = Path(os.environ.get('OUTPUT_PATH', 'context/current-summary.md'))
    
    print(f"Context Gatekeeper starting...")
    print(f"History file: {history_path}")
    print(f"Notes file: {notes_path}")
    print(f"Output file: {output_path}")
    
    # Handle missing input gracefully
    if not history_path.exists():
        print(f"Warning: History file not found at {history_path}")
        print("Creating empty summary...")
        turns = []
    else:
        turns = parse_history(history_path)
        print(f"Parsed {len(turns)} turns from history")
    
    # Extract marker
    marker = find_marker(notes_path)
    print(f"Marker: {marker}")
    
    # Generate summary
    output = generate_summary_file(output_path, turns, marker)
    print(f"Summary generated: {output}")
    print("Context Gatekeeper complete.")
    
    return 0


if __name__ == '__main__':
    sys.exit(main())
EOF

