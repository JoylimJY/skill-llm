#!/usr/bin/env python3
"""
Context Gatekeeper - Generates a compact summary from conversation history.
Reads history.txt and input-notes.md from the context directory,
and produces current-summary.md with key sections.
"""

import os
import sys
from pathlib import Path
from typing import Optional


def find_marker(notes_path: Path) -> Optional[str]:
    """Extract marker from input-notes.md for deterministic output."""
    if not notes_path.exists():
        return None
    content = notes_path.read_text(encoding='utf-8')
    for line in content.splitlines():
        if 'Marker:' in line:
            parts = line.split('Marker:')
            if len(parts) > 1:
                return parts[1].strip()
    return None


def parse_history(history_path: Path) -> list:
    """Parse conversation history into list of (speaker, message) tuples."""
    if not history_path.exists():
        return []
    
    conversations = []
    content = history_path.read_text(encoding='utf-8')
    
    for line in content.strip().splitlines():
        if ':' in line:
            speaker, message = line.split(':', 1)
            conversations.append((speaker.strip(), message.strip()))
    
    return conversations


def extract_pending_actions(conversations: list) -> list:
    """Extract pending actions from conversation history."""
    actions = []
    action_keywords = ['precisamos', 'falta', 'listar', 'testar', 'revisar', 
                       'decidir', 'incluir', 'montar']
    
    for speaker, message in conversations:
        message_lower = message.lower()
        if any(kw in message_lower for kw in action_keywords):
            actions.append(message)
    
    seen = set()
    unique_actions = []
    for action in actions:
        if action not in seen:
            seen.add(action)
            unique_actions.append(action)
    
    return unique_actions[:5]


def get_recent_turns(conversations: list, max_turns: int = 5) -> list:
    """Get the most recent conversation turns."""
    return conversations[-max_turns:] if conversations else []


def generate_compact_summary(conversations: list, marker: Optional[str]) -> str:
    """Generate a compact summary of the conversation."""
    if not conversations:
        return "No conversation history available."
    
    user_count = sum(1 for s, _ in conversations if s == 'USER')
    assistant_count = sum(1 for s, _ in conversations if s == 'ASSISTANT')
    
    last_user_msg = next(
        (msg for s, msg in reversed(conversations) if s == 'USER'),
        "No user input"
    )
    
    summary = f"Conversation with {user_count} user messages and {assistant_count} assistant responses."
    if marker:
        summary += f" [Marker: {marker}]"
    summary += f"\nLatest topic: {last_user_msg[:80]}..." if len(last_user_msg) > 80 else f"\nLatest topic: {last_user_msg}"
    
    return summary


def generate_summary_file(context_dir: Path, output_path: Path) -> bool:
    """Generate the current-summary.md file from history and notes."""
    history_path = context_dir / 'history.txt'
    notes_path = context_dir / 'input-notes.md'
    
    if not history_path.exists():
        print(f"Warning: History file not found at {history_path}")
        print("Creating empty summary with placeholder content.")
        
        summary_content = """# Context Summary

## Compact Summary
No conversation history available.

## Pending Actions
- No pending actions identified.

## Recent Turns
- No recent turns to display.
"""
        output_path.write_text(summary_content, encoding='utf-8')
        return True
    
    marker = find_marker(notes_path)
    conversations = parse_history(history_path)
    
    if not conversations:
        print("Warning: No valid conversation entries found.")
        marker_str = f" [Marker: {marker}]" if marker else ""
        summary_content = f"""# Context Summary

## Compact Summary
No valid conversation entries found.{marker_str}

## Pending Actions
- No pending actions identified.

## Recent Turns
- No turns to display.
"""
        output_path.write_text(summary_content, encoding='utf-8')
        return True
    
    compact_summary = generate_compact_summary(conversations, marker)
    pending_actions = extract_pending_actions(conversations)
    recent_turns = get_recent_turns(conversations)
    
    sections = [
        "# Context Summary",
        "",
        "## Compact Summary",
        compact_summary,
        "",
        "## Pending Actions",
    ]
    
    if pending_actions:
        for action in pending_actions:
            sections.append(f"- {action}")
    else:
        sections.append("- No pending actions identified.")
    
    sections.extend([
        "",
        "## Recent Turns",
    ])
    
    if recent_turns:
        for speaker, message in recent_turns:
            sections.append(f"- **{speaker}**: {message}")
    else:
        sections.append("- No recent turns to display.")
    
    if marker:
        sections.extend(["", f"**Generated with marker**: {marker}"])
    
    summary_content = "\n".join(sections) + "\n"
    
    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text(summary_content, encoding='utf-8')
    
    print(f"Summary generated: {output_path}")
    return True


def main():
    """Main entry point for the context gatekeeper."""
    script_dir = Path(__file__).parent.resolve()
    workspace_dir = script_dir.parent.parent.parent
    
    context_dir = workspace_dir / 'context'
    output_path = context_dir / 'current-summary.md'
    
    if len(sys.argv) > 1:
        context_dir = Path(sys.argv[1]).resolve()
    if len(sys.argv) > 2:
        output_path = Path(sys.argv[2]).resolve()
    
    print(f"Context Gatekeeper v1.0")
