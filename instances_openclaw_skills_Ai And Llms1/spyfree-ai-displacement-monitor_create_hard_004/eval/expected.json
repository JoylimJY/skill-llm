      "properties": [
        "English markdown report",
        "contains Signal Board",
        "contains Composite Risk Light",
        "contains Actionable Notes",
        "contains Data Gaps"
      ]
    },
    {
      "path": "output.json",
      "must_exist": true,
      "properties": [
        "valid JSON",
