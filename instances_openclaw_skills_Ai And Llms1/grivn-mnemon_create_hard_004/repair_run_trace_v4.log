recall_script = '''#!/usr/bin/env python3
"""
Mnemon Recall Utility for Aurora Relay Project
Usage: python recall.py <query>
"""
import os
import sys
from mnemon.mnemon import MnFile

workspace_dir = "/workspace/mnemon_workspace"
store = MnFile(os.path.join(workspace_dir, "store"))

def recall(query):
    """Perform a recall query on the memory store."""
    query_lower = query.lower()
    
    # Get index
    index = store.get("__index__", {})
    memories = index.get("memories", [])
    
    results = []
    
    for key in memories:
        m = store[key]
        content_lower = m["content"].lower()
        
        # Simple keyword matching
        if any(word in content_lower for word in query_lower.split()):
            results.append((key, m))
    
    if not results:
        # Fallback: return all memories for the project
        for key in memories:
            results.append((key, store[key]))
    
    return results

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: python recall.py <query>")
        print("Example: python recall.py 'What did we decide for Aurora Relay and why?'")
        sys.exit(1)
    
    query = " ".join(sys.argv[1:])
    results = recall(query)
    
    print(f"Recall query: '{query}'\\n")
    print(f"Found {len(results)} memory(ies):\\n")
    
    for key, m in results:
