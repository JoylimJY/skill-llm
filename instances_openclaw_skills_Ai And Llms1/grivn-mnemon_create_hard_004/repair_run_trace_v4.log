import os
import json
from mnemon.mnemon import MnFile

# Create workspace directory
workspace_dir = "/workspace/mnemon_workspace"
os.makedirs(workspace_dir, exist_ok=True)

# Initialize mnemon file store
store = MnFile(os.path.join(workspace_dir, "store"))

# Define memory structure
# Each memory has: content, category, importance, links (causal, semantic)

memories = {
    # Memory 1: Project Goal
    "aurora_goal": {
        "content": "Aurora Relay is a lightweight incident relay system for on-call teams, designed to shorten incident handoff time.",
        "category": "project_goal",
        "importance": 10,
        "tags": ["aurora", "incident-relay", "on-call"],
        "links": {
            "causal": [],
            "semantic": ["aurora_implementation"]
        }
    },
    
    # Memory 2: User-facing constraint (offline mode)
    "aurora_constraint_offline": {
        "content": "The first release of Aurora Relay must support offline mode to ensure reliability during network disruptions.",
        "category": "constraint",
        "importance": 9,
        "tags": ["aurora", "offline", "requirement"],
        "links": {
            "causal": [],
            "semantic": []
        }
    },
    
    # Memory 3: Shipping decision (message queue)
    "aurora_decision_ship": {
        "content": "Decision: Ship Aurora Relay with a message queue architecture instead of direct sync for better reliability and decoupling.",
        "category": "decision",
        "importance": 10,
        "tags": ["aurora", "architecture", "message-queue", "shipping"],
        "links": {
            "causal": ["aurora_constraint_offline"],  # Causally linked to offline constraint
            "semantic": []
        }
    },
    
    # Memory 4: Implementation insight (message queue)
    "aurora_implementation": {
        "content": "Using a message queue for Aurora Relay enables reliable message delivery, supports offline mode, and provides better system decoupling.",
        "category": "implementation_insight",
        "importance": 8,
        "tags": ["aurora", "message-queue", "implementation"],
        "links": {
            "causal": [],
            "semantic": ["aurora_goal", "aurora_testing"]  # Semantically linked to goal and testing
        }
    },
    
    # Memory 5: Testing insight (deterministic fixtures)
    "aurora_testing": {
        "content": "Deterministic fixtures make queue replay tests stable and reproducible for Aurora Relay.",
        "category": "testing_insight",
        "importance": 7,
        "tags": ["aurora", "testing", "deterministic", "fixtures"],
        "links": {
            "causal": [],
            "semantic": ["aurora_implementation"]  # Semantically linked to implementation insight
        }
    }
}

# Store each memory
for key, memory in memories.items():
    store[key] = memory

# Create an index for quick lookup
index = {
    "project": "Aurora Relay",
    "memories": list(memories.keys()),
    "categories": ["project_goal", "constraint", "decision", "implementation_insight", "testing_insight"],
    "last_updated": "2024-01-15"
}
store["__index__"] = index

# Verify storage
print("Stored memories:")
for key in memories.keys():
    print(f"  - {key}: {store[key]['category']} (importance: {store[key]['importance']})")

print("\nIndex:", store["__index__"])

