        raise NotImplementedError("No.")

    def __len__(self):
        pass

    @staticmethod
    def _hash(key):
        if type(key) is not str:
            key = str(key)
        return sha256(key.encode("utf-8")).hexdigest()

    def __enter__(self):
        return self

    def __exit__(self, t, value, traceback):
        pass


