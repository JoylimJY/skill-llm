    @staticmethod
    def _perms(path):
        return os.chmod(path, 0o777)

    def __init__(self, cachedir=None, expire=None, raw=False):
        super().__init__(expire=expire, raw=raw)
        cd = cachedir or appdirs.user_cache_dir(appname="mnemon",
