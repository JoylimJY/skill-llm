#!/usr/bin/env python3
"""
Token Guard CLI Utility
Reads usage logs and generates quota summaries, JSON reports, and duplicate burst alerts.
"""

import json
import sys
from pathlib import Path
from collections import defaultdict
from datetime import datetime


def parse_timestamp(ts_str):
    """Parse ISO timestamp string to datetime."""
    return datetime.fromisoformat(ts_str.replace('Z', '+00:00'))


def load_usage_log(input_path):
    """Load and parse the usage log JSON file."""
    with open(input_path, 'r', encoding='utf-8') as f:
        return json.load(f)


def detect_duplicate_bursts(records, threshold):
    """
    Detect duplicate request bursts.
    Returns list of bursts where same prompt appears >= threshold times.
    """
    bursts = []
    prompt_groups = defaultdict(list)
    
    for record in records:
        prompt_groups[record['prompt']].append(record)
    
    for prompt, group in prompt_groups.items():
        if len(group) >= threshold:
            bursts.append({
                'prompt': prompt,
                'count': len(group),
                'records': group
            })
    
    return bursts


def calculate_quota_usage(records, quota_limit, window_seconds):
    """Calculate quota usage statistics."""
    total_tokens = sum(r['tokens'] for r in records)
    usage_percent = (total_tokens / quota_limit * 100) if quota_limit > 0 else 0
    
    # Group by time window
    window_usage = defaultdict(int)
    for record in records:
        ts = parse_timestamp(record['ts'])
        window_key = ts.strftime('%Y-%m-%d %H:%M')
        window_usage[window_key] += record['tokens']
    
    return {
        'total_tokens': total_tokens,
        'quota_limit': quota_limit,
        'remaining': quota_limit - total_tokens,
        'usage_percent': usage_percent,
        'window_usage': dict(window_usage)
    }


def generate_summary_text(data, quota_stats, bursts, output_path):
    """Generate human-readable summary text file."""
    lines = []
    lines.append("=" * 60)
    lines.append("TOKEN GUARD - QUOTA SUMMARY")
    lines.append("=" * 60)
    lines.append("")
    lines.append(f"Project: {data['project']}")
    lines.append(f"Model: {data['model']}")
    lines.append(f"Marker: {data.get('marker', 'N/A')}")
    lines.append("")
    lines.append("-" * 40)
    lines.append("QUOTA STATUS")
    lines.append("-" * 40)
    lines.append(f"Total Tokens Used: {quota_stats['total_tokens']}")
    lines.append(f"Quota Limit: {quota_stats['quota_limit']}")
    lines.append(f"Remaining: {quota_stats['remaining']}")
    lines.append(f"Usage: {quota_stats['usage_percent']:.1f}%")
    lines.append("")
    lines.append("-" * 40)
    lines.append("REQUEST SUMMARY")
    lines.append("-" * 40)
    lines.append(f"Total Requests: {len(data['records'])}")
    
    lines.append("")
    lines.append("Usage by Time Window:")
    for window, tokens in sorted(quota_stats['window_usage'].items()):
        lines.append(f"  {window}: {tokens} tokens")
    
    lines.append("")
    lines.append("-" * 40)
    lines.append("DUPLICATE BURST ALERTS")
    lines.append("-" * 40)
    
    if bursts:
        lines.append(f"WARNING: {len(bursts)} duplicate burst(s) detected!")
        lines.append("")
        for i, burst in enumerate(bursts, 1):
            lines.append(f"Burst #{i}:")
            lines.append(f"  Prompt: {burst['prompt'][:50]}")
            lines.append(f"  Occurrences: {burst['count']}")
            lines.append(f"  Timestamps:")
            for rec in burst['records']:
                lines.append(f"    - {rec['ts']}")
            lines.append("")
    else:
        lines.append("No duplicate bursts detected.")
    
    lines.append("")
    lines.append("=" * 60)
    lines.append("END OF SUMMARY")
    lines.append("=" * 60)
    
    with open(output_path, 'w', encoding='utf-8') as f:
        f.write('\n'.join(lines))


def generate_json_report(data, quota_stats, bursts, output_path):
    """Generate machine-readable JSON report."""
    report = {
        'project': data['project'],
        'model': data['model'],
        'marker': data.get('marker', 'N/A'),
        'generated_at': datetime.utcnow().isoformat() + 'Z',
        'quota': {
            'limit': quota_stats['quota_limit'],
            'used': quota_stats['total_tokens'],
            'remaining': quota_stats['remaining'],
            'usage_percent': round(quota_stats['usage_percent'], 2)
        },
        'requests': {
            'total_count': len(data['records']),
            'window_seconds': data.get('window_seconds', 60),
            'breakdown': quota_stats['window_usage']
        },
        'duplicate_bursts': {
            'threshold': data.get('duplicate_burst_threshold', 3),
            'detected': len(bursts),
            'alerts': [
                {
                    'prompt': b['prompt'],
                    'count': b['count'],
                    'timestamps': [r['ts'] for r in b['records']]
                }
                for b in bursts
            ]
        }
    }
    
    with open(output_path, 'w', encoding='utf-8') as f:
        json.dump(report, f, indent=2)


def generate_alert_file(bursts, data, output_path):
    """Generate alert file when duplicate bursts are detected."""
    if not bursts:
        return False
    
    lines = []
    lines.append("ALERT: Duplicate Request Bursts Detected")
    lines.append(f"Project: {data['project']}")
    lines.append(f"Time: {datetime.utcnow().isoformat()}Z")
    lines.append("")
    
    for i, burst in enumerate(bursts, 1):
        lines.append(f"=== BURST ALERT #{i} ===")
        lines.append(f"Prompt: {burst['prompt']}")
        lines.append(f"Count: {burst['count']} (threshold: {data.get('duplicate_burst_threshold', 3)})")
        lines.append("Timestamps:")
        for rec in burst['records']:
            lines.append(f"  - {rec['ts']}")
        lines.append("")
    
    with open(output_path, 'w', encoding='utf-8') as f:
        f.write('\n'.join(lines))
    
    return True


def main():
    input_dir = Path('/workspace/input')
    output_dir = Path('/workspace/output')
    
    if len(sys.argv) > 1:
        input_path = Path(sys.argv[1])
    else:
        input_path = input_dir / 'usage_log.json'
    
    if len(sys.argv) > 2:
        output_dir = Path(sys.argv[2])
    
    output_dir.mkdir(parents=True, exist_ok=True)
    
    print(f"Loading usage log from: {input_path}")
    data = load_usage_log(input_path)
    
    quota_limit = data.get('quota_limit', 10000)
    threshold = data.get('duplicate_burst_threshold', 3)
    
    quota_stats = calculate_quota_usage(data['records'], quota_limit, data.get('window_seconds', 60))
    bursts = detect_duplicate_bursts(data['records'], threshold)
    
    summary_path = output_dir / 'summary.txt'
    generate_summary_text(data, quota_stats, bursts, summary_path)
    print(f"Generated summary: {summary_path}")
    
    report_path = output_dir / 'report.json'
    generate_json_report(data, quota_stats, bursts, report_path)
    print(f"Generated JSON report: {report_path}")
    
    alert_path = output_dir / 'alerts.txt'
    if generate_alert_file(bursts, data, alert_path):
        print(f"Generated alert file: {alert_path}")
    else:
        print("No alerts generated (no duplicate bursts detected)")
    
    print("Done!")


if __name__ == '__main__':
    main()
