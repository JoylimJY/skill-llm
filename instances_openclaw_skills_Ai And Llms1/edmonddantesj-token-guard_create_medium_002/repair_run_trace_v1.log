    input_path = '/workspace/input/usage_log.json'
    output_dir = '/workspace/output'
    summary_path = f'{output_dir}/summary.txt'
    report_path = f'{output_dir}/report.json'
    alert_path = f'{output_dir}/alerts.txt'
    
