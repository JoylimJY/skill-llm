    data = load_usage_log(input_path)
    
    records = data['records']
    quota_limit = data.get('quota_limit', 10000)
    window_seconds = data.get('window_seconds', 60)
    duplicate_threshold = data.get('duplicate_burst_threshold', 3)
    
    quota_stats = calculate_quota_stats(records, quota_limit)
    bursts = detect_duplicate_bursts(records, window_seconds, duplicate_threshold)
    
    print(f"Generating summary: {summary_path}")
    generate_summary(data, quota_stats, bursts, summary_path)
    
    print(f"Generating JSON report: {report_path}")
    generate_json_report(data, quota_stats, bursts, report_path)
    
    print(f"Checking for alerts: {alert_path}")
