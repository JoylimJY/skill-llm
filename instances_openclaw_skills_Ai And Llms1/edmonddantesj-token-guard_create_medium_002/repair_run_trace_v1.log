"""
Token Guard CLI Utility
Reads usage logs and generates quota summary, JSON report, and alerts for duplicate bursts.
"""

import json
import sys
from datetime import datetime
from collections import defaultdict

def parse_timestamp(ts_str):
    """Parse ISO timestamp string to datetime object."""
    return datetime.fromisoformat(ts_str.replace('Z', '+00:00'))

def load_usage_log(filepath):
    """Load and parse the usage log JSON file."""
    with open(filepath, 'r') as f:
        return json.load(f)

def calculate_quota_stats(records, quota_limit):
    """Calculate quota usage statistics."""
    total_tokens = sum(r['tokens'] for r in records)
    remaining = quota_limit - total_tokens
    usage_percent = (total_tokens / quota_limit * 100) if quota_limit > 0 else 0
    return {
        'total_tokens': total_tokens,
        'quota_limit': quota_limit,
        'remaining': remaining,
        'usage_percent': round(usage_percent, 2)
    }

def detect_duplicate_bursts(records, window_seconds, threshold):
    """
    Detect duplicate request bursts.
    A burst is when the same prompt appears >= threshold times within window_seconds.
    """
    bursts = []
    prompt_times = defaultdict(list)
    
    for record in records:
        ts = parse_timestamp(record['ts'])
        prompt_times[record['prompt']].append({
            'timestamp': ts,
            'record': record
        })
    
    for prompt, entries in prompt_times.items():
        entries.sort(key=lambda x: x['timestamp'])
        
        for i, entry in enumerate(entries):
            window_start = entry['timestamp']
            window_entries = []
            
            for j in range(i, len(entries)):
                time_diff = (entries[j]['timestamp'] - window_start).total_seconds()
                if time_diff <= window_seconds:
                    window_entries.append(entries[j])
                else:
                    break
            
            if len(window_entries) >= threshold:
                burst_info = {
                    'prompt': prompt,
                    'count': len(window_entries),
                    'start_time': window_entries[0]['record']['ts'],
                    'end_time': window_entries[-1]['record']['ts'],
                    'window_seconds': window_seconds,
                    'threshold': threshold
                }
                if burst_info not in bursts:
                    bursts.append(burst_info)
    
    return bursts

def generate_summary(data, quota_stats, bursts, output_path):
    """Generate human-readable summary file."""
    lines = []
    lines.append("=" * 50)
    lines.append("TOKEN GUARD QUOTA SUMMARY")
    lines.append("=" * 50)
    lines.append("")
    lines.append(f"Project: {data['project']}")
