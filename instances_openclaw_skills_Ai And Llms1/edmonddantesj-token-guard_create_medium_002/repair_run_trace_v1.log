        alert_content.append(f"  First Occurrence: {burst['start_time']}")
        alert_content.append(f"  Last Occurrence: {burst['end_time']}")
        alert_content.append("")
    
    with open(output_path, 'w') as f:
        f.write('\n'.join(alert_content))
    
    return True

