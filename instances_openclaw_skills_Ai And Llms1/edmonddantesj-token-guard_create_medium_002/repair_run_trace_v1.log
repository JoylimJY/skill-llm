#!/usr/bin/env python3
"""
Token Guard CLI Utility
Reads usage logs and generates quota summary, JSON report, and alerts for duplicate bursts.
"""

import json
import sys
from datetime import datetime
from collections import defaultdict

def parse_timestamp(ts_str):
    """Parse ISO timestamp string to datetime object."""
    return datetime.fromisoformat(ts_str.replace('Z', '+00:00'))

def load_usage_log(filepath):
    """Load and parse the usage log JSON file."""
    with open(filepath, 'r') as f:
        return json.load(f)

def calculate_quota_stats(records, quota_limit):
    """Calculate quota usage statistics."""
    total_tokens = sum(r['tokens'] for r in records)
    remaining = quota_limit - total_tokens
    usage_percent = (total_tokens / quota_limit * 100) if quota_limit > 0 else 0
    return {
        'total_tokens': total_tokens,
        'quota_limit': quota_limit,
        'remaining': remaining,
        'usage_percent': round(usage_percent, 2)
    }

def detect_duplicate_bursts(records, window_seconds, threshold):
    """
    Detect duplicate request bursts.
    A burst is when the same prompt appears >= threshold times within window_seconds.
    """
    bursts = []
    prompt_times = defaultdict(list)
    
    # Group records by prompt and collect timestamps
    for record in records:
        ts = parse_timestamp(record['ts'])
        prompt_times[record['prompt']].append({
            'timestamp': ts,
            'record': record
        })
    
    # Check each prompt for bursts
    for prompt, entries in prompt_times.items():
        # Sort by timestamp
        entries.sort(key=lambda x: x['timestamp'])
        
        # Sliding window check
        for i, entry in enumerate(entries):
            window_start = entry['timestamp']
            window_entries = []
            
            for j in range(i, len(entries)):
                time_diff = (entries[j]['timestamp'] - window_start).total_seconds()
                if time_diff <= window_seconds:
                    window_entries.append(entries[j])
                else:
                    break
            
            if len(window_entries) >= threshold:
                # Found a burst
                burst_info = {
                    'prompt': prompt,
                    'count': len(window_entries),
                    'start_time': window_entries[0]['record']['ts'],
                    'end_time': window_entries[-1]['record']['ts'],
                    'window_seconds': window_seconds,
                    'threshold': threshold
                }
                # Avoid duplicate burst reports
                if burst_info not in bursts:
                    bursts.append(burst_info)
    
    return bursts

def generate_summary(data, quota_stats, bursts, output_path):
    """Generate human-readable summary file."""
    lines = []
    lines.append("=" * 50)
    lines.append("TOKEN GUARD QUOTA SUMMARY")
    lines.append("=" * 50)
    lines.append("")
    lines.append(f"Project: {data['project']}")
    lines.append(f"Model: {data['model']}")
    lines.append(f"Marker: {data.get('marker', 'N/A')}")
    lines.append("")
    lines.append("-" * 50)
    lines.append("QUOTA STATUS")
    lines.append("-" * 50)
    lines.append(f"Total Tokens Used: {quota_stats['total_tokens']}")
    lines.append(f"Quota Limit: {quota_stats['quota_limit']}")
    lines.append(f"Remaining: {quota_stats['remaining']}")
    lines.append(f"Usage: {quota_stats['usage_percent']}%")
    lines.append("")
    lines.append("-" * 50)
    lines.append("REQUEST BREAKDOWN")
    lines.append("-" * 50)
    
    for i, record in enumerate(data['records'], 1):
        prompt_preview = record['prompt'][:50]
        lines.append(f"{i}. [{record['ts']}] {record['tokens']} tokens")
        lines.append(f"   Prompt: {prompt_preview}")
    
    lines.append("")
    lines.append("-" * 50)
    lines.append("ALERTS")
    lines.append("-" * 50)
    
    if bursts:
        for burst in bursts:
            lines.append(f"WARNING: DUPLICATE BURST DETECTED")
            lines.append(f"   Prompt: {burst['prompt']}")
            lines.append(f"   Occurrences: {burst['count']} in {burst['window_seconds']}s window")
            lines.append(f"   Time Range: {burst['start_time']} to {burst['end_time']}")
            lines.append("")
    else:
        lines.append("No alerts.")
    
    lines.append("")
    lines.append("=" * 50)
    lines.append("END OF SUMMARY")
    lines.append("=" * 50)
    
    with open(output_path, 'w') as f:
        f.write('\n'.join(lines))

def generate_json_report(data, quota_stats, bursts, output_path):
    """Generate machine-readable JSON report."""
    report = {
        'project': data['project'],
        'model': data['model'],
        'marker': data.get('marker', 'N/A'),
        'generated_at': datetime.utcnow().isoformat() + 'Z',
        'quota': {
            'total_tokens': quota_stats['total_tokens'],
            'quota_limit': quota_stats['quota_limit'],
            'remaining': quota_stats['remaining'],
            'usage_percent': quota_stats['usage_percent']
        },
        'record_count': len(data['records']),
        'duplicate_bursts': bursts,
        'alert_count': len(bursts)
    }
    
    with open(output_path, 'w') as f:
        json.dump(report, f, indent=2)

def generate_alert_file(bursts, output_path):
    """Generate alert file when duplicate bursts are detected."""
    if not bursts:
        return False
    
    alert_content = []
    alert_content.append("TOKEN GUARD ALERT")
    alert_content.append("Generated: " + datetime.utcnow().isoformat() + 'Z')
    alert_content.append("")
    alert_content.append(f"Duplicate Burst Alerts: {len(bursts)}")
    alert_content.append("")
    
    for i, burst in enumerate(bursts, 1):
        alert_content.append(f"ALERT #{i}:")
        alert_content.append(f"  Type: DUPLICATE_REQUEST_BURST")
        alert_content.append(f"  Prompt: {burst['prompt']}")
        alert_content.append(f"  Count: {burst['count']} requests")
        alert_content.append(f"  Window: {burst['window_seconds']} seconds")
        alert_content.append(f"  Threshold Exceeded: {burst['threshold']}")
        alert_content.append(f"  First Occurrence: {burst['start_time']}")
        alert_content.append(f"  Last Occurrence: {burst['end_time']}")
        alert_content.append("")
    
    with open(output_path, 'w') as f:
        f.write('\n'.join(alert_content))
    
    return True

def main():
    # Default paths
    input_path = '/workspace/input/usage_log.json'
    output_dir = '/workspace/output'
    summary_path = f'{output_dir}/summary.txt'
    report_path = f'{output_dir}/report.json'
    alert_path = f'{output_dir}/alerts.txt'
    
    # Load usage log
    print(f"Loading usage log from: {input_path}")
    data = load_usage_log(input_path)
    
    # Extract configuration
    records = data['records']
    quota_limit = data.get('quota_limit', 10000)
    window_seconds = data.get('window_seconds', 60)
    duplicate_threshold = data.get('duplicate_burst_threshold', 3)
    
    # Calculate quota statistics
    quota_stats = calculate_quota_stats(records, quota_limit)
    
    # Detect duplicate bursts
    bursts = detect_duplicate_bursts(records, window_seconds, duplicate_threshold)
    
    # Generate outputs
    print(f"Generating summary: {summary_path}")
    generate_summary(data, quota_stats, bursts, summary_path)
    
    print(f"Generating JSON report: {report_path}")
    generate_json_report(data, quota_stats, bursts, report_path)
    
    print(f"Checking for alerts: {alert_path}")
    alert_generated = generate_alert_file(bursts, alert_path)
    if alert_generated:
        print(f"Alert file generated: {alert_path}")
    else:
        print("No alerts generated (no duplicate bursts detected)")
    
    print("\nDone!")
    print(f"  Total tokens: {quota_stats['total_tokens']}")
    print(f"  Quota usage: {quota_stats['usage_percent']}%")
    print(f"  Duplicate bursts detected: {len(bursts)}")

if __name__ == '__main__':
    main()
