#!/usr/bin/env python3
"""
Token Guard CLI Utility
Reads usage logs, generates quota summaries, and detects duplicate request bursts.
"""

import json
import sys
from datetime import datetime
from collections import defaultdict


def parse_timestamp(ts_str):
    """Parse ISO 8601 timestamp."""
    return datetime.fromisoformat(ts_str.replace('Z', '+00:00'))


def load_usage_log(filepath):
    """Load and parse the usage log JSON file."""
    with open(filepath, 'r') as f:
        return json.load(f)


def calculate_quota_summary(data):
    """Calculate quota usage statistics."""
    records = data.get('records', [])
    total_tokens = sum(r.get('tokens', 0) for r in records)
    quota_limit = data.get('quota_limit', 0)
    
    return {
        'total_tokens': total_tokens,
        'quota_limit': quota_limit,
        'remaining_tokens': quota_limit - total_tokens,
        'usage_percentage': (total_tokens / quota_limit * 100) if quota_limit > 0 else 0,
        'record_count': len(records)
    }


def detect_duplicate_bursts(data):
    """
    Detect duplicate request bursts.
    A burst occurs when the same prompt appears >= threshold times within window_seconds.
    """
    records = data.get('records', [])
    window_seconds = data.get('window_seconds', 60)
    threshold = data.get('duplicate_burst_threshold', 3)
    
    bursts = []
    
    # Group records by prompt
    prompt_groups = defaultdict(list)
    for i, record in enumerate(records):
        prompt = record.get('prompt', '')
        ts = parse_timestamp(record.get('ts', ''))
        prompt_groups[prompt].append({'index': i, 'ts': ts, 'tokens': record.get('tokens', 0)})
    
    # Check each prompt group for bursts
    for prompt, entries in prompt_groups.items():
        if len(entries) < threshold:
            continue
        
        # Sort by timestamp
        entries.sort(key=lambda x: x['ts'])
        
        # Sliding window to find bursts
        for i in range(len(entries)):
            window_entries = [entries[i]]
            for j in range(i + 1, len(entries)):
                time_diff = (entries[j]['ts'] - entries[i]['ts']).total_seconds()
                if time_diff <= window_seconds:
                    window_entries.append(entries[j])
            
            if len(window_entries) >= threshold:
                burst = {
                    'prompt': prompt,
                    'count': len(window_entries),
                    'window_seconds': window_seconds,
                    'threshold': threshold,
                    'first_occurrence': window_entries[0]['ts'].isoformat(),
                    'last_occurrence': window_entries[-1]['ts'].isoformat(),
                    'total_tokens': sum(e['tokens'] for e in window_entries)
                }
                # Avoid duplicate burst reports
                if burst not in bursts:
                    bursts.append(burst)
                break
    
    return bursts


def generate_human_summary(data, quota_summary, bursts):
    """Generate human-readable summary."""
    lines = []
    lines.append("=" * 50)
    lines.append("TOKEN GUARD QUOTA SUMMARY")
    lines.append("=" * 50)
    lines.append("")
    lines.append(f"Project: {data.get('project', 'N/A')}")
    lines.append(f"Model: {data.get('model', 'N/A')}")
    lines.append("")
    lines.append("-" * 30)
    lines.append("QUOTA STATUS")
    lines.append("-" * 30)
    lines.append(f"Total Tokens Used: {quota_summary['total_tokens']}")
    lines.append(f"Quota Limit: {quota_summary['quota_limit']}")
    lines.append(f"Remaining: {quota_summary['remaining_tokens']}")
    lines.append(f"Usage: {quota_summary['usage_percentage']:.1f}%")
    lines.append(f"Total Requests: {quota_summary['record_count']}")
    lines.append("")
    
    if bursts:
        lines.append("-" * 30)
        lines.append("DUPLICATE BURST ALERTS")
        lines.append("-" * 30)
        for burst in bursts:
            lines.append(f"  * Prompt: \"{burst['prompt']}\"")
            lines.append(f"    Occurrences: {burst['count']} (threshold: {burst['threshold']})")
            lines.append(f"    Time Window: {burst['first_occurrence']} to {burst['last_occurrence']}")
            lines.append(f"    Tokens Consumed: {burst['total_tokens']}")
            lines.append("")
    else:
        lines.append("No duplicate request bursts detected.")
        lines.append("")
    
    lines.append("=" * 50)
    return "\n".join(lines)


def generate_json_report(data, quota_summary, bursts):
    """Generate machine-readable JSON report."""
    return {
        'project': data.get('project', ''),
        'model': data.get('model', ''),
        'marker': data.get('marker', ''),
        'quota': {
            'total_tokens': quota_summary['total_tokens'],
            'quota_limit': quota_summary['quota_limit'],
            'remaining_tokens': quota_summary['remaining_tokens'],
            'usage_percentage': round(quota_summary['usage_percentage'], 2),
            'record_count': quota_summary['record_count']
        },
        'duplicate_bursts': bursts,
        'burst_alert_count': len(bursts)
    }


def write_alert_file(bursts, output_path):
    """Write alert file when duplicate bursts are detected."""
    if not bursts:
        return False
    
    lines = []
    lines.append("ALERT: Duplicate Request Bursts Detected")
    lines.append("=" * 40)
    lines.append(f"Total Bursts: {len(bursts)}")
    lines.append("")
    
    for i, burst in enumerate(bursts, 1):
        lines.append(f"Burst #{i}:")
        lines.append(f"  Prompt: {burst['prompt']}")
        lines.append(f"  Count: {burst['count']} requests")
        lines.append(f"  Window: {burst['window_seconds']} seconds")
        lines.append(f"  Tokens: {burst['total_tokens']}")
        lines.append("")
    
    with open(output_path, 'w') as f:
        f.write("\n".join(lines))
    
    return True


def main():
    if len(sys.argv) < 2:
        print("Usage: token_guard_cli.py <input_json> [output_dir]")
        sys.exit(1)
    
    input_path = sys.argv[1]
    output_dir = sys.argv[2] if len(sys.argv) > 2 else '.'
    
    # Load data
    data = load_usage_log(input_path)
    
    # Calculate quota
    quota_summary = calculate_quota_summary(data)
    
    # Detect duplicate bursts
    bursts = detect_duplicate_bursts(data)
    
    # Generate outputs
    human_summary = generate_human_summary(data, quota_summary, bursts)
    json_report = generate_json_report(data, quota_summary, bursts)
    
    # Write summary.txt
    summary_path = f"{output_dir}/summary.txt"
    with open(summary_path, 'w') as f:
        f.write(human_summary)
    print(f"Written: {summary_path}")
    
    # Write report.json
    report_path = f"{output_dir}/report.json"
    with open(report_path, 'w') as f:
        json.dump(json_report, f, indent=2)
    print(f"Written: {report_path}")
    
    # Write alert file if bursts detected
    alert_path = f"{output_dir}/alerts.txt"
    if write_alert_file(bursts, alert_path):
        print(f"Written: {alert_path}")
    else:
        print("No alerts to write.")
    
    print("\nDone!")


if __name__ == '__main__':
    main()
