"""Command-line interface for TokenGuard."""

import argparse
import json
import sys
from pathlib import Path

from .engine import TokenGuardEngine


def main():
    """Main CLI entry point."""
    parser = argparse.ArgumentParser(
        prog="tokenguard",
        description="TokenGuard - Token estimation, quota tracking, and duplicate detection"
    )
    parser.add_argument(
        "--config", "-c",
        default="config.json",
        help="Path to configuration file (default: config.json)"
    )
    parser.add_argument(
        "--prompts", "-p",
        default="prompts.json",
        help="Path to prompts JSON file (default: prompts.json)"
    )
    parser.add_argument(
        "--report", "-r",
        default="report.json",
        help="Path to output report file (default: report.json)"
    )
    parser.add_argument(
        "--cache", "-C",
        default=None,
        help="Path to cache file (default: .tokenguard_cache.json in config dir)"
    )
    parser.add_argument(
        "--verbose", "-v",
        action="store_true",
        help="Enable verbose output"
    )
    
    args = parser.parse_args()
    
    config_path = Path(args.config)
    prompts_path = Path(args.prompts)
    report_path = Path(args.report)
    cache_path = args.cache
    
    if not config_path.exists():
        print(f"Error: Config file not found: {config_path}", file=sys.stderr)
        sys.exit(1)
    
    if not prompts_path.exists():
        print(f"Error: Prompts file not found: {prompts_path}", file=sys.stderr)
        sys.exit(1)
    
    # Load prompts
    with open(prompts_path, "r", encoding="utf-8") as f:
        prompts = json.load(f)
    
    # Initialize engine
    engine = TokenGuardEngine(str(config_path), cache_path)
    
    # Process batch
    results = engine.process_batch(prompts)
    
    # Save report
    engine.save_report(str(report_path))
    
    # Save cache
    engine._save_cache()
    
    # Output summary
    if args.verbose:
        print(json.dumps(engine.generate_report(), indent=2, ensure_ascii=False))
    else:
        stats = engine.stats
        print(f"Processed {len(results)} requests")
        print(f"  Allowed: {len(results) - stats['blocks']}")
        print(f"  Blocked: {stats['blocks']}")
        print(f"  Fallbacks: {stats['fallbacks']}")
        print(f"Report saved to: {report_path}")
        print(f"Cache saved to: {engine.cache_path}")


if __name__ == "__main__":
    main()
