"""Core TokenGuard engine for token estimation, quota tracking, and duplicate detection."""

import hashlib
import json
import time
from pathlib import Path
from typing import Any


class TokenGuardEngine:
    """Engine for pre-flight token estimation, quota tracking, and duplicate-request detection."""
    
    def __init__(self, config_path: str, cache_path: str = None):
        self.config_path = Path(config_path)
        self.cache_path = Path(cache_path) if cache_path else self.config_path.parent / ".tokenguard_cache.json"
        self.config = self._load_config()
        self.cache = self._load_cache()
        self.model_usage: dict[str, int] = {model: 0 for model in self.config.get("models", {})}
        self.stats = {"blocks": 0, "fallbacks": 0}
        self.results: list[dict[str, Any]] = []
    
    def _load_config(self) -> dict:
        with open(self.config_path, "r", encoding="utf-8") as f:
            return json.load(f)
    
    def _load_cache(self) -> dict:
        if self.cache_path.exists():
            with open(self.cache_path, "r", encoding="utf-8") as f:
                return json.load(f)
        return {"requests": {}, "model_usage": {}}
    
    def _save_cache(self) -> None:
        cache_data = {"requests": self.cache.get("requests", {}), "model_usage": self.model_usage}
        with open(self.cache_path, "w", encoding="utf-8") as f:
            json.dump(cache_data, f, indent=2, ensure_ascii=False)
    
    def _estimate_tokens(self, text: str) -> int:
        if not text:
            return 0
        cjk_count = sum(1 for c in text if '\u4e00' <= c <= '\u9fff')
        ascii_count = len(text) - cjk_count
        return max(1, (ascii_count // 4) + cjk_count)
    
    def _compute_hash(self, request_id: str, text: str) -> str:
        content = f"{request_id}:{text}"
        return hashlib.sha256(content.encode("utf-8")).hexdigest()
    
    def _is_duplicate(self, request_id: str, text: str, model: str) -> bool:
        if not self.config.get("cache_enabled", True):
            return False
        hash_key = self._compute_hash(request_id, text)
        window_seconds = self.config.get("duplicate_window_seconds", 60)
        current_time = time.time()
        cached = self.cache.get("requests", {}).get(hash_key, [])
        for cached_entry in cached:
            cached_time = cached_entry.get("timestamp", 0)
            if current_time - cached_time <= window_seconds:
                return True
        return False
    
    def _check_quota(self, model: str, token_count: int) -> tuple[bool, str]:
        model_config = self.config.get("models", {}).get(model, {})
        if not model_config:
            self.stats["fallbacks"] += 1
            return True, "fallback"
        tpm_limit = model_config.get("tpm_limit", 1000000)
        soft_limit_pct = model_config.get("soft_limit_pct", 80)
        hard_limit_pct = model_config.get("hard_limit_pct", 95)
        current_usage = self.model_usage.get(model, 0)
        hard_limit = tpm_limit * (hard_limit_pct / 100)
        if current_usage + token_count > hard_limit:
            return False, "hard_limit_exceeded"
        soft_limit = tpm_limit * (soft_limit_pct / 100)
        if current_usage + token_count > soft_limit:
            self.stats["fallbacks"] += 1
            return True, "soft_limit_warning"
        return True, "ok"
    
    def process_request(self, request: dict) -> dict:
        request_id = request.get("id", "")
        model = request.get("model", "")
        text = request.get("text", "")
        token_count = self._estimate_tokens(text)
        hash_key = self._compute_hash(request_id, text)
        is_duplicate = self._is_duplicate(request_id, text, model)
        allowed, quota_status = self._check_quota(model, token_count)
        if is_duplicate:
            status = "blocked_duplicate"
            self.stats["blocks"] += 1
        elif not allowed:
            status = "blocked_quota"
            self.stats["blocks"] += 1
        else:
            status = "allowed"
            self.model_usage[model] = self.model_usage.get(model, 0) + token_count
        if self.config.get("cache_enabled", True):
            if hash_key not in self.cache.get("requests", {}):
                self.cache.setdefault("requests", {})[hash_key] = []
            self.cache["requests"][hash_key].append({
                "request_id": request_id,
                "timestamp": time.time(),
                "model": model
            })
        result = {
            "request_id": request_id,
            "model": model,
            "status": status,
            "token_estimate": token_count,
            "hash": hash_key,
            "quota_status": quota_status
        }
        self.results.append(result)
        return result
    
    def process_batch(self, prompts: list[dict]) -> list[dict]:
        for prompt in prompts:
            self.process_request(prompt)
        return self.results
    
    def get_model_status(self) -> dict[str, dict]:
        status = {}
        for model, config in self.config.get("models", {}).items():
            tpm_limit = config.get("tpm_limit", 0)
            current = self.model_usage.get(model, 0)
            used_pct = (current / tpm_limit * 100) if tpm_limit > 0 else 0
            status[model] = {
                "tpm_limit": tpm_limit,
                "current_usage": current,
                "used_percent": round(used_pct, 2),
                "soft_limit": config.get("soft_limit_pct", 80),
                "hard_limit": config.get("hard_limit_pct", 95)
            }
        return status
    
    def generate_report(self) -> dict:
        return {
            "models": self.get_model_status(),
            "stats": self.stats,
            "results": self.results
        }
    
    def save_report(self, report_path: str) -> None:
        report = self.generate_report()
        with open(report_path, "w", encoding="utf-8") as f:
            json.dump(report, f, indent=2, ensure_ascii=False)
ENDOFFILE

