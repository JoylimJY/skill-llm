"""
TokenGuard Engine - Core logic for token estimation, quota tracking, and duplicate detection.
"""

import hashlib
import json
import time
from pathlib import Path
from typing import Any, Dict, List, Optional


class TokenGuardEngine:
    """
    Engine for pre-flight token estimation, quota tracking, and duplicate-request detection.
    """

    def __init__(self, config_path: str, cache_path: Optional[str] = None):
        """
        Initialize the TokenGuard engine.
        Args:
            config_path: Path to the config JSON file
            cache_path: Optional path for cache file
        """
        self.config_path = Path(config_path)
        self.cache_path = Path(cache_path) if cache_path else self._default_cache_path()
        self.config: Dict[str, Any] = {}
        self.cache: Dict[str, Any] = {}
        self._load_config()
        self._load_cache()

    def _default_cache_path(self) -> Path:
        return self.config_path.parent / ".tokenguard_cache.json"

    def _load_config(self) -> None:
        if not self.config_path.exists():
            raise FileNotFoundError(f"Config file not found: {self.config_path}")
        with open(self.config_path, 'r', encoding='utf-8') as f:
            self.config = json.load(f)

    def _load_cache(self) -> None:
        if self.cache_path.exists():
            try:
                with open(self.cache_path, 'r', encoding='utf-8') as f:
                    self.cache = json.load(f)
            except (json.JSONDecodeError, IOError):
                self.cache = {}
        else:
            self.cache = {"requests": {}, "model_usage": {}, "last_updated": None}

    def _save_cache(self) -> None:
        self.cache["last_updated"] = time.time()
        with open(self.cache_path, 'w', encoding='utf-8') as f:
            json.dump(self.cache, f, indent=2, sort_keys=True)

    def estimate_tokens(self, text: str) -> int:
        """Estimate token count for a given text using deterministic algorithm."""
        if not text:
            return 0
        token_count = 0
        for char in text:
            if '\u4e00' <= char <= '\u9fff' or '\u3040' <= char <= '\u30ff' or '\uac00' <= char <= '\ud7af':
                token_count += 1
            elif char.isspace():
                token_count += 0.5
            elif ord(char) < 128:
                token_count += 0.25
            else:
                token_count += 0.5
        return int(round(token_count))

    def compute_text_hash(self, text: str) -> str:
        """Compute a deterministic hash of the text for duplicate detection."""
        return hashlib.sha256(text.encode('utf-8')).hexdigest()

    def is_duplicate(self, request_id: str, text: str, current_time: float) -> bool:
        """Check if a request is a duplicate based on text content and time window."""
        if not self.config.get("cache_enabled", True):
            return False
        text_hash = self.compute_text_hash(text)
        window_seconds = self.config.get("duplicate_window_seconds", 60)
        if text_hash in self.cache.get("requests", {}):
            request_info = self.cache["requests"][text_hash]
            if request_info["request_id"] != request_id:
                if current_time - request_info["timestamp"] <= window_seconds:
                    return True
        return False

    def get_model_quota(self, model: str) -> Dict[str, Any]:
        """Get quota information for a specific model."""
        models_config = self.config.get("models", {})
        if model not in models_config:
            return {"model": model, "tpm_limit": 0, "soft_limit_pct": 0, "hard_limit_pct": 0,
                    "used_tokens": 0, "soft_limit": 0, "hard_limit": 0,
                    "remaining_tokens": 0, "status": "unknown"}
        model_config = models_config[model]
        tpm_limit = model_config.get("tpm_limit", 0)
        soft_limit_pct = model_config.get("soft_limit_pct", 80)
        hard_limit_pct = model_config.get("hard_limit_pct", 95)
        soft_limit = int(tpm_limit * soft_limit_pct / 100)
        hard_limit = int(tpm_limit * hard_limit_pct / 100)
        used_tokens = self.cache.get("model_usage", {}).get(model, 0)
        remaining_tokens = tpm_limit - used_tokens
        if used_tokens >= hard_limit:
            status = "exceeded"
        elif used_tokens >= soft_limit:
            status = "warning"
        else:
            status = "ok"
        return {"model": model, "tpm_limit": tpm_limit, "soft_limit_pct": soft_limit_pct,
                "hard_limit_pct": hard_limit_pct, "used_tokens": used_tokens,
                "soft_limit": soft_limit, "hard_limit": hard_limit,
                "remaining_tokens": remaining_tokens, "status": status}

    def process_request(self, request: Dict[str, Any], current_time: Optional[float] = None) -> Dict[str, Any]:
        """Process a single request: estimate tokens, check duplicates, track quota."""
        if current_time is None:
            current_time = time.time()
        request_id = request.get("id", "unknown")
        model = request.get("model", "unknown")
        text = request.get("text", "")
        token_count = self.estimate_tokens(text)
        is_dup = self.is_duplicate(request_id, text, current_time)
        quota = self.get_model_quota(model)
        can_proceed = quota["status"] != "exceeded"
        result = {
            "request_id": request_id, "model": model, "estimated_tokens": token_count,
            "is_duplicate": is_dup, "can_proceed": can_proceed and not is_dup,
            "quota_status": quota["status"], "quota_remaining": quota["remaining_tokens"],
            "text_hash": self.compute_text_hash(text)
        }
        if not is_dup:
            text_hash = result["text_hash"]
            self.cache.setdefault("requests", {})[text_hash] = {
                "request_id": request_id, "timestamp": current_time, "model": model
            }
        return result

    def process_batch(self, requests: List[Dict[str, Any]], current_time: Optional[float] = None) -> Dict[str, Any]:
        """Process a batch of requests."""
        if current_time is None:
            current_time = time.time()
        results = []
        total_tokens = 0
        duplicates = 0
        blocked = 0
        for request in requests:
            result = self.process_request(request, current_time)
            results.append(result)
            total_tokens += result["estimated_tokens"]
            if result["is_duplicate"]:
                duplicates += 1
            if not result["can_proceed"]:
                blocked += 1
            model = result["model"]
            self.cache.setdefault("model_usage", {})[model] = \
                self.cache.get("model_usage", {}).get(model, 0) + result["estimated_tokens"]
        quota_summaries = {}
        for model in sorted(set(r["model"] for r in results)):
            quota_summaries[model] = self.get_model_quota(model)
        report = {
            "batch_summary": {
                "total_requests": len(requests),
                "total_tokens_estimated": total_tokens,
                "duplicates_detected": duplicates,
                "blocked_requests": blocked,
                "processed_at": current_time
            },
            "quota_summaries": quota_summaries,
            "results": results
        }
        return report

    def generate_report(self, report: Dict[str, Any], output_path: str) -> None:
        """Write the report to a JSON file."""
        with open(output_path, 'w', encoding='utf-8') as f:
            json.dump(report, f, indent=2, sort_keys=True)
