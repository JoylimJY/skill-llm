"""
TokenGuard CLI - Command-line interface for TokenGuard.
"""

import argparse
import json
import sys
from pathlib import Path
from typing import Optional

from .engine import TokenGuardEngine


def load_prompts(prompts_path: str) -> list:
    """Load prompts from a JSON file."""
    path = Path(prompts_path)
    if not path.exists():
        raise FileNotFoundError(f"Prompts file not found: {prompts_path}")
    with open(path, 'r', encoding='utf-8') as f:
        return json.load(f)


def main(args: Optional[list] = None) -> int:
    """
    Main entry point for the TokenGuard CLI.
    
    Args:
        args: Command line arguments (defaults to sys.argv[1:])
    
    Returns:
        Exit code (0 for success, non-zero for failure)
    """
    parser = argparse.ArgumentParser(
        prog="tokenguard",
        description="TokenGuard - Pre-flight token estimation, quota tracking, and duplicate detection"
    )
    parser.add_argument(
        "--config", "-c",
        type=str,
        default="config.json",
        help="Path to the configuration file (default: config.json)"
    )
    parser.add_argument(
        "--prompts", "-p",
        type=str,
        default="prompts.json",
        help="Path to the prompts JSON file (default: prompts.json)"
    )
    parser.add_argument(
        "--output", "-o",
        type=str,
        default="report.json",
        help="Path for the output report (default: report.json)"
    )
    parser.add_argument(
        "--cache",
        type=str,
        default=None,
        help="Path for the cache file (default: .tokenguard_cache.json in config directory)"
    )
    parser.add_argument(
        "--time", "-t",
        type=float,
        default=None,
        help="Fixed timestamp for deterministic processing (default: current time)"
    )
    parser.add_argument(
        "--verbose", "-v",
        action="store_true",
        help="Enable verbose output"
    )

    parsed_args = parser.parse_args(args)

    try:
        # Initialize engine
        engine = TokenGuardEngine(
            config_path=parsed_args.config,
            cache_path=parsed_args.cache
        )

        if parsed_args.verbose:
            print(f"Loaded config from: {parsed_args.config}")
            print(f"Cache path: {engine.cache_path}")

        # Load prompts
        prompts = load_prompts(parsed_args.prompts)
        
        if parsed_args.verbose:
            print(f"Loaded {len(prompts)} prompts from: {parsed_args.prompts}")

        # Process batch
        report = engine.process_batch(prompts, current_time=parsed_args.time)

        # Save cache
        engine._save_cache()

        if parsed_args.verbose:
            print(f"Cache saved to: {engine.cache_path}")

        # Generate report
        engine.generate_report(report, parsed_args.output)

        if parsed_args.verbose:
            print(f"Report saved to: {parsed_args.output}")

        # Print summary
        summary = report["batch_summary"]
        print(f"TokenGuard Report Summary:")
        print(f"  Total requests: {summary['total_requests']}")
        print(f"  Total tokens estimated: {summary['total_tokens_estimated']}")
        print(f"  Duplicates detected: {summary['duplicates_detected']}")
        print(f"  Blocked requests: {summary['blocked_requests']}")

        return 0

    except FileNotFoundError as e:
        print(f"Error: {e}", file=sys.stderr)
        return 1
    except json.JSONDecodeError as e:
        print(f"JSON parsing error: {e}", file=sys.stderr)
        return 1
    except Exception as e:
        print(f"Unexpected error: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
