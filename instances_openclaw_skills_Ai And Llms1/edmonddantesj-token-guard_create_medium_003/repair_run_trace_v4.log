[EXECUTING python]:
# First, create the engine module
engine_code = '''"""
TokenGuard Engine - Core functionality for token estimation, quota tracking, and duplicate detection.
"""

import hashlib
import json
import time
import os
from typing import Dict, List, Any, Optional, Tuple


class TokenGuardEngine:
    """
    Core engine for TokenGuard providing:
    - Pre-flight token estimation
    - Quota tracking per model
    - Duplicate-request detection
    """
    
    def __init__(self, config_path: str):
        """Initialize engine with config file."""
        self.config = self._load_config(config_path)
        self.models = self.config.get("models", {})
        self.duplicate_window = self.config.get("duplicate_window_seconds", 60)
        self.cache_enabled = self.config.get("cache_enabled", True)
        
        # Runtime state
        self.model_usage: Dict[str, int] = {}  # model -> tokens used
        self.request_cache: Dict[str, Dict[str, Any]] = {}  # hash -> {timestamp, model, request_id}
        self.stats = {
            "blocks": 0,
            "fallbacks": 0
        }
        
        # Initialize model usage to 0
        for model in self.models:
            self.model_usage[model] = 0
    
    def _load_config(self, config_path: str) -> Dict[str, Any]:
        """Load configuration from JSON file."""
        with open(config_path, "r", encoding="utf-8") as f:
            return json.load(f)
    
    def estimate_tokens(self, text: str) -> int:
        """
        Estimate token count for a text string.
        Uses a simple estimation: ~4 chars per token (common approximation).
        """
        if not text:
            return 0
        # Simple estimation: 4 characters per token
        return max(1, len(text) // 4)
    
    def _hash_request(self, text: str) -> str:
        """Generate deterministic hash for request deduplication."""
        return hashlib.sha256(text.encode("utf-8")).hexdigest()[:16]
    
    def _is_duplicate(self, text: str, current_time: float) -> Optional[str]:
        """
        Check if request is a duplicate within the time window.
        Returns the original request_id if duplicate, None otherwise.
        """
        request_hash = self._hash_request(text)
        
        if request_hash not in self.request_cache:
            return None
        
        cached = self.request_cache[request_hash]
        time_diff = current_time - cached["timestamp"]
        
        if time_diff <= self.duplicate_window:
            return cached["request_id"]
        
        return None
    
    def _check_quota(self, model: str, estimated_tokens: int) -> Tuple[bool, str]:
        """
        Check if request fits within quota limits.
        Returns (allowed, status_message).
        """
        if model not in self.models:
            return False, "unknown_model"
        
        model_config = self.models[model]
        tpm_limit = model_config["tpm_limit"]
        soft_pct = model_config["soft_limit_pct"]
        hard_pct = model_config["hard_limit_pct"]
        
        current_usage = self.model_usage.get(model, 0)
        projected_usage = current_usage + estimated_tokens
        
        soft_limit = tpm_limit * (soft_pct / 100)
        hard_limit = tpm_limit * (hard_pct / 100)
        
        if projected_usage > hard_limit:
            return False, "hard_limit_exceeded"
        elif projected_usage > soft_limit:
            return False, "soft_limit_exceeded"
        
        return True, "ok"
    
    def _record_request(self, request_id: str, model: str, text: str, timestamp: float):
        """Record a request in the cache."""
        request_hash = self._hash_request(text)
        self.request_cache[request_hash] = {
            "timestamp": timestamp,
            "model": model,
            "request_id": request_id
        }
    
    def process_request(self, request: Dict[str, Any], current_time: float) -> Dict[str, Any]:
        """
        Process a single request through the engine.
        Returns result dict with status and details.
        """
        request_id = request.get("id", "unknown")
        model = request.get("model", "unknown")
        text = request.get("text", "")
        
        estimated_tokens = self.estimate_tokens(text)
        
        result = {
            "request_id": request_id,
            "model": model,
            "estimated_tokens": estimated_tokens,
            "status": "allowed",
            "reason": None
        }
        
        # Check for unknown model
        if model not in self.models:
            result["status"] = "blocked"
            result["reason"] = "unknown_model"
            self.stats["fallbacks"] += 1
            return result
        
        # Check for duplicate
        if self.cache_enabled:
            duplicate_id = self._is_duplicate(text, current_time)
            if duplicate_id:
                result["status"] = "blocked"
                result["reason"] = "duplicate_request"
                result["original_request_id"] = duplicate_id
                self.stats["blocks"] += 1
                return result
        
        # Check quota
        allowed, quota_status = self._check_quota(model, estimated_tokens)
        if not allowed:
            result["status"] = "blocked"
            result["reason"] = quota_status
            self.stats["blocks"] += 1
            return result
        
        # Request allowed - record it
        self._record_request(request_id, model, text, current_time)
        self.model_usage[model] = self.model_usage.get(model, 0) + estimated_tokens
        
        return result
    
    def process_batch(self, requests: List[Dict[str, Any]], current_time: float = None) -> List[Dict[str, Any]]:
        """Process a batch of requests."""
        if current_time is None:
            current_time = time.time()
        
        results = []
        for request in requests:
            result = self.process_request(request, current_time)
            results.append(result)
        
        return results
    
    def get_model_status(self) -> Dict[str, Dict[str, Any]]:
        """Get current status for all models."""
        status = {}
        for model, config in self.models.items():
            current = self.model_usage.get(model, 0)
            tpm_limit = config["tpm_limit"]
            
            status[model] = {
                "tpm_limit": tpm_limit,
                "current_usage": current,
                "remaining": max(0, tpm_limit - current),
                "soft_limit_pct": config["soft_limit_pct"],
                "hard_limit_pct": config["hard_limit_pct"],
                "utilization_pct": round((current / tpm_limit) * 100, 2) if tpm_limit > 0 else 0
            }
        
        return status
    
    def generate_report(self) -> Dict[str, Any]:
        """Generate a status report."""
        return {
            "models": self.get_model_status(),
            "stats": self.stats
        }
    
    def get_cache_data(self) -> Dict[str, Any]:
        """Get cache data for persistence."""
        return {
            "request_hashes": {
                h: {
                    "timestamp": data["timestamp"],
                    "model": data["model"],
                    "request_id": data["request_id"]
                }
                for h, data in self.request_cache.items()
            },
            "model_usage": dict(self.model_usage)
        }
    
    def save_cache(self, cache_path: str):
        """Save cache to file."""
        cache_data = self.get_cache_data()
        with open(cache_path, "w", encoding="utf-8") as f:
            json.dump(cache_data, f, indent=2, sort_keys=True)
    
    def load_cache(self, cache_path: str):
        """Load cache from file."""
        if not os.path.exists(cache_path):
            return
        
        with open(cache_path, "r", encoding="utf-8") as f:
            cache_data = json.load(f)
        
        self.request_cache = {}
        for h, data in cache_data.get("request_hashes", {}).items():
            self.request_cache[h] = {
                "timestamp": data["timestamp"],
                "model": data["model"],
                "request_id": data["request_id"]
            }
        
        self.model_usage = cache_data.get("model_usage", {})
        for model in self.models:
            if model not in self.model_usage:
                self.model_usage[model] = 0
'''

with open("/workspace/tokenguard/engine.py", "w") as f:
    f.write(engine_code)

