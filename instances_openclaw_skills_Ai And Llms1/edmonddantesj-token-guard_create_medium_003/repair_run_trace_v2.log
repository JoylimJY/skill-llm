"""
TokenGuard Engine - Core functionality for token estimation, quota tracking, and duplicate detection.
"""

import hashlib
import json
import time
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple


class TokenGuardEngine:
    """
    Main engine for TokenGuard operations.
    """
    
    def __init__(self, config_path: str, cache_path: Optional[str] = None):
        self.config_path = Path(config_path)
        self.cache_path = Path(cache_path) if cache_path else self.config_path.parent / ".tokenguard_cache.json"
        
        with open(self.config_path, 'r', encoding='utf-8') as f:
            self.config = json.load(f)
        
        self.model_quotas: Dict[str, Dict[str, Any]] = {}
        for model_name, model_config in self.config.get('models', {}).items():
            self.model_quotas[model_name] = {
                'tpm_limit': model_config['tpm_limit'],
                'soft_limit_pct': model_config['soft_limit_pct'],
                'hard_limit_pct': model_config['hard_limit_pct'],
                'tokens_used': 0,
                'requests_count': 0
            }
        
        self.duplicate_window = self.config.get('duplicate_window_seconds', 60)
        self.cache_enabled = self.config.get('cache_enabled', True)
        self.request_cache: Dict[str, Dict[str, Any]] = {}
        self._load_cache()
    
    def _load_cache(self) -> None:
        if self.cache_path.exists() and self.cache_enabled:
            try:
                with open(self.cache_path, 'r', encoding='utf-8') as f:
                    cache_data = json.load(f)
                current_time = time.time()
                for req_hash, req_data in cache_data.get('requests', {}).items():
                    if current_time - req_data['timestamp'] < self.duplicate_window:
                        self.request_cache[req_hash] = req_data
                for model_name, usage in cache_data.get('model_usage', {}).items():
                    if model_name in self.model_quotas:
                        self.model_quotas[model_name]['tokens_used'] = usage.get('tokens_used', 0)
                        self.model_quotas[model_name]['requests_count'] = usage.get('requests_count', 0)
            except (json.JSONDecodeError, KeyError):
                pass
    
    def _save_cache(self) -> None:
        if not self.cache_enabled:
            return
        cache_data = {
            'requests': self.request_cache,
            'model_usage': {
                model: {
                    'tokens_used': quota['tokens_used'],
                    'requests_count': quota['requests_count']
                }
                for model, quota in self.model_quotas.items()
            },
            'last_updated': time.time()
        }
        with open(self.cache_path, 'w', encoding='utf-8') as f:
            json.dump(cache_data, f, indent=2, ensure_ascii=False)
    
    def _estimate_tokens(self, text: str) -> int:
        if not text:
            return 0
        cjk_count = sum(1 for c in text if '\u4e00' <= c <= '\u9fff' or '\u3040' <= c <= '\u309f' or '\u30a0' <= c <= '\u30ff')
        chars = len(text)
        non_cjk_chars = chars - cjk_count
        non_cjk_tokens = max(1, non_cjk_chars // 4) if non_cjk_chars > 0 else 0
        words = len(text.split())
        word_boundary_tokens = words // 2 if words > 0 else 0
        return cjk_count + non_cjk_tokens + word_boundary_tokens
    
    def _compute_request_hash(self, model: str, text: str) -> str:
        content = f"{model}:{text}"
        return hashlib.sha256(content.encode('utf-8')).hexdigest()[:16]
    
    def _is_duplicate(self, request_hash: str) -> bool:
        if request_hash not in self.request_cache:
            return False
        cached = self.request_cache[request_hash]
        current_time = time.time()
        if current_time - cached['timestamp'] < self.duplicate_window:
            return True
        del self.request_cache[request_hash]
        return False
    
    def _check_quota(self, model: str, tokens: int) -> Tuple[bool, str]:
        if model not in self.model_quotas:
            return False, "UNKNOWN_MODEL"
        quota = self.model_quotas[model]
        tokens_used = quota['tokens_used']
        tpm_limit = quota['tpm_limit']
        soft_pct = quota['soft_limit_pct'] / 100.0
        hard_pct = quota['hard_limit_pct'] / 100.0
        soft_limit = tpm_limit * soft_pct
        hard_limit = tpm_limit * hard_pct
        if tokens_used + tokens > hard_limit:
            return False, "HARD_LIMIT_EXCEEDED"
        if tokens_used + tokens > soft_limit:
            return True, "SOFT_LIMIT_WARNING"
        return True, "OK"
    
    def process_request(self, request_id: str, model: str, text: str) -> Dict[str, Any]:
        token_estimate = self._estimate_tokens(text)
        request_hash = self._compute_request_hash(model, text)
        
        if self._is_duplicate(request_hash):
            return {
                'request_id': request_id,
                'model': model,
                'status': 'BLOCKED_DUPLICATE',
                'token_estimate': token_estimate,
                'hash': request_hash,
                'duplicate_of': self.request_cache[request_hash]['request_id']
            }
        
        can_proceed, quota_status = self._check_quota(model, token_estimate)
        
        if not can_proceed:
            return {
                'request_id': request_id,
                'model': model,
                'status': 'BLOCKED_QUOTA',
                'token_estimate': token_estimate,
                'hash': request_hash,
                'quota_status': quota_status
            }
        
        self.model_quotas[model]['tokens_used'] += token_estimate
        self.model_quotas[model]['requests_count'] += 1
        
        self.request_cache[request_hash] = {
            'request_id': request_id,
            'model': model,
            'timestamp': time.time(),
            'tokens': token_estimate
        }
        
        status = 'ALLOWED_FALLBACK' if quota_status == 'SOFT_LIMIT_WARNING' else 'ALLOWED'
        
        return {
            'request_id': request_id,
            'model': model,
            'status': status,
            'token_estimate': token_estimate,
            'hash': request_hash,
            'quota_status': quota_status
        }
    
    def process_batch(self, prompts: List[Dict[str, str]]) -> List[Dict[str, Any]]:
        results = []
        for prompt in prompts:
            result = self.process_request(
                request_id=prompt['id'],
                model=prompt['model'],
                text=prompt['text']
            )
            results.append(result)
        return results
    
    def get_report(self) -> Dict[str, Any]:
        blocked_count = sum(1 for r in self.request_cache.values() if self._is_duplicate(r['request_id']))
        blocks = sum(1 for m in self.model_quotas.values() if m['tokens_used'] > m['tpm_limit'] * m['hard_limit_pct'] / 100.0)
        fallbacks = sum(1 for m in self.model_quotas.values() if m['tokens_used'] > m['tpm_limit'] * m['soft_limit_pct'] / 100.0)
        
        models_info = {}
        for model_name, quota in self.model_quotas.items():
            models_info[model_name] = {
                'tpm_limit': quota['tpm_limit'],
                'tokens_used': quota['tokens_used'],
                'requests_count': quota['requests_count'],
                'utilization_pct': round(quota['tokens_used'] / quota['tpm_limit'] * 100, 2)
            }
        
        return {
            'models': models_info,
            'stats': {
                'total_blocks': blocks,
                'total_fallbacks': fallbacks
            }
        }
    
    def save_report(self, report_path: str) -> None:
        report = self.get_report()
        with open(report_path, 'w', encoding='utf-8') as f:
            json.dump(report, f, indent=2, ensure_ascii=False)
