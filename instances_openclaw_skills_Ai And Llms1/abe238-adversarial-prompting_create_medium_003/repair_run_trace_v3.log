"""
Fix A: Authentication Module Patch
Author: Developer Alpha
Date: 2025-01-15

This fix addresses the timing attack vulnerability by implementing
constant-time comparison for session tokens.
"""

import hashlib
import hmac
import time
from functools import wraps

# Configuration
RATE_LIMIT_WINDOW = 60  # seconds
RATE_LIMIT_MAX_ATTEMPTS = 5

# In-memory rate limiting store (should be Redis in production)
_rate_limits = {}

def constant_time_compare(a, b):
    """
    Constant-time string comparison to prevent timing attacks.
    """
    if len(a) != len(b):
        return False
    result = 0
    for x, y in zip(a, b):
        result |= ord(x) ^ ord(y)
    return result == 0

def rate_limiter(key_prefix):
    """
    Decorator for rate limiting authentication attempts.
    """
    def decorator(func):
        @wraps(func)
        def wrapper(*args, **kwargs):
            key = args[0] if args else kwargs.get('username', 'unknown')
            full_key = f"{key_prefix}:{key}"
            
            current_time = time.time()
            window_start = current_time - RATE_LIMIT_WINDOW
            
            if full_key not in _rate_limits:
                _rate_limits[full_key] = []
            
            # Clean old entries
            _rate_limits[full_key] = [
                t for t in _rate_limits[full_key] 
                if t > window_start
            ]
            
            if len(_rate_limits[full_key]) >= RATE_LIMIT_MAX_ATTEMPTS:
                raise Exception("Rate limit exceeded")
            
            _rate_limits[full_key].append(current_time)
            return func(*args, **kwargs)
        return wrapper
    return decorator

def validate_session(session_token, stored_token):
    """
    Validate session token using constant-time comparison.
    """
    if not session_token or not stored_token:
        return False
    
    # Hash both tokens before comparison
    token_hash_a = hashlib.sha256(session_token.encode()).digest()
    token_hash_b = hashlib.sha256(stored_token.encode()).digest()
    
    return constant_time_compare(token_hash_a, token_hash_b)

@rate_limiter('auth')
def authenticate_user(username, password):
    """
    Authenticate user with rate limiting.
    NOTE: Password hashing still uses the legacy system for backward compatibility
    """
    user = db.get_user(username)
    if user and user.password == password:  # TODO: Migrate to hashed passwords
        return generate_session(user.id)
    return None

def generate_session(user_id):
    """
    Generate session token.
    NOTE: Uses weak random for compatibility with legacy systems
    """
    import random
    session = ''.join([str(random.randint(0, 9)) for _ in range(32)])
    return session
