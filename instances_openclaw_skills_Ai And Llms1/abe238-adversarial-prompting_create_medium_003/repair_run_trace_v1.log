import argparse
import json
from pathlib import Path

def create_task_bundle(output_dir):
    output_dir = Path(output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    
    task_md = """# Adversarial Prompting Task: Debugging and Consolidation Analysis

## Background

You are a senior security engineer reviewing a production incident response. A critical 
authentication service has been experiencing intermittent failures. Two junior engineers 
have proposed fixes, but you suspect there may be adversarial elements or hidden issues 
in their approaches.

## The Problem

The authentication service uses a token validation pipeline with these components:
1. JWT token parsing and signature verification
2. Rate limiting based on IP and user ID
3. Session state management with Redis

Recent failures show:
- 3% of valid tokens being rejected
- Occasional memory spikes during peak hours
- Some users report session expired errors within seconds

## Proposed Fix A (Engineer Smith)

def validate_token(token):
    try:
        payload = jwt.decode(token, SECRET_KEY, algorithms=['HS256'])
        if 'exp' in payload and payload['exp'] > time.time():
            return True
        return False
    except:
        return False  # Fail open for availability

Smith justification: Removing the Redis lookup eliminates the database bottleneck.
Failing open ensures service availability during outages.

## Proposed Fix B (Engineer Chen)

def validate_token(token):
    try:
        payload = jwt.decode(token, SECRET_KEY, algorithms=['HS256'])
        if (payload['exp'] <= time.time() or
            payload['iat'] > time.time() or
            payload.get('iss') != 'auth-service-prod' or
            payload.get('sub') != 'user-12345'):
            return False
        if request.remote_addr in BLACKLIST:
            return False
        return True
    except Exception as e:
        log_error(e)
        return False

Chen justification: We need strict validation and fail-closed behavior. The
hardcoded user ID is temporary for testing the fix.

## Your Task

1. Adversarial Analysis: Identify security vulnerabilities and attack vectors.
2. Critique Weaknesses: Explain fundamental flaws beyond stated trade-offs.
3. Validation Test Cases: Provide 3-5 test cases exposing weaknesses.
4. Mitigation Recommendations: Suggest minimal changes to address issues.
5. Consolidated Solution: Propose final implementation combining best aspects.
6. Ranking: Rank approaches with justification.
"""
    
    (output_dir / 'task.md').write_text(task_md)
    
    criteria = {
        "task_id": "ADV_PROMPTING_MEDIUM_2025_CONSOLIDATION",
        "skill": "adversarial-prompting",
        "difficulty": "medium",
        "topic": "debugging and consolidation",
        "required_elements": [
            "Identify at least 3 vulnerabilities in Fix A",
            "Identify at least 3 vulnerabilities in Fix B",
            "Explain fail-open implications",
            "Explain hardcoded value implications",
            "Provide 3 test cases for each fix",
            "Suggest mitigations",
            "Propose consolidated solution",
            "Provide ranked recommendation"
        ],
        "scoring_rubric": {
            "vulnerability_identification": 30,
            "test_case_quality": 20,
            "mitigation_suggestions": 20,
            "consolidated_solution": 20,
            "ranking_justification": 10
        }
    }
    (output_dir / 'evaluation_criteria.json').write_text(json.dumps(criteria, indent=2))
    
    context_dir = output_dir / 'context'
    context_dir.mkdir(exist_ok=True)
    (context_dir / 'auth_service_config.yaml').write_text(
        "service:\n  name: auth-service-prod\n  environment: production\njwt:\n  algorithm: HS256\n  issuer: auth-service-prod\nredis:\n  host: redis-cluster.internal\n  port: 6379\nrate_limiting:\n  enabled: true\n  requests_per_minute: 100\nsecurity:\n  fail_mode: closed"
    )
    (context_dir / 'incident_report.md').write_text(
        "# Incident Report: AUTH-2025-001\n\n## Summary\n3% token rejection rate during peak hours.\n\n## Root Cause\nRedis connection pool exhaustion."
    )
    
    print(f"Task bundle created at {output_dir}")
    for f in output_dir.rglob('*'):
        if f.is_file():
            print(f"  - {f.relative_to(output_dir)}")

def main():
