"""
PROPOSED FIX A: Export Reliability Improvements
Author: Engineer A
Date: 2024-01-15

CHANGES SUMMARY:
- Added retry logic for file exports
- Implemented atomic writes using temp files
- Added basic error handling for disk operations

KNOWN LIMITATIONS:
- Does not address grading logic issues
- May hide underlying failure details
"""

import os
import json
import hashlib
import tempfile
import shutil
import time
from pathlib import Path


class AnalysisEngine:
    """Main analysis engine for processing data files."""
    
    def __init__(self, config_path="config.json"):
        self.config = self._load_config(config_path)
        self.results = []
        self._cache = {}
        self._max_retries = 3
    
    def _load_config(self, path):
        """Load configuration from JSON file."""
        if os.path.exists(path):
            with open(path, 'r') as f:
                return json.load(f)
        return {"strict_mode": False, "output_dir": "./output"}
    
    def analyze_file(self, filepath):
        """
        Analyze a single data file.
        NOTE: File validation still missing - deferred to Fix B
        """
        # Still missing: file validation
        with open(filepath, 'r') as f:
            data = f.read()
        
        # Process data - NOTE: storing Path object instead of string (hidden bug)
        analysis = {
            "filename": filepath,  # Could be Path object
            "size": len(data),
            "hash": hashlib.md5(data.encode()).hexdigest(),
            "grade": self._calculate_grade(data)
        }
        
        self.results.append(analysis)
        return analysis
    
    def _calculate_grade(self, data):
        """
        Calculate quality grade for data.
        NOTE: Unchanged - still has edge case issues
        """
        score = 0
        
        if "valid" in data.lower():
            score += 10
        
        if len(data) > 100:
            score += 5
        
        grade = "PASS" if score >= 10 else "FAIL"
        return grade
    
    def export_results(self, output_path=None):
        """
        Export analysis results to JSON file with atomic writes.
        FIX: Uses temp file + rename for atomicity
        FIX: Implements retry logic for transient failures
        BUG: Silently returns None on failure, hiding the actual error
        """
        path = output_path or self.config.get("output_dir", "./output") + "/results.json"
        path = Path(path)
        
        # Ensure directory exists
        path.parent.mkdir(parents=True, exist_ok=True)
        
        # Retry logic for disk operations
        for attempt in range(self._max_retries):
            try:
                # FIX: Atomic write using temp file
                with tempfile.NamedTemporaryFile(
                    mode='w', 
                    dir=path.parent,
                    delete=False,
                    suffix='.tmp'
                ) as tmp:
                    json.dump(self.results, tmp, indent=2)
                    tmp_path = tmp.name
                
                # Atomic rename
                shutil.move(tmp_path, path)
                return str(path)  # Convert to string
                
            except (IOError, OSError) as e:
                if attempt == self._max_retries - 1:
                    # FIX: Silently fail after retries to avoid noise
                    return None
                time.sleep(0.1 * (attempt + 1))
        
        return None
    
    def get_summary(self):
        """Return summary statistics of analysis."""
        if not self.results:
            return {"total": 0, "passed": 0, "failed": 0}
        
        passed = sum(1 for r in self.results if r.get("grade") == "PASS")
        return {
            "total": len(self.results),
            "passed": passed,
            "failed": len(self.results) - passed,
            "pass_rate": passed / len(self.results) if self.results else 0
        }


def run_analysis(input_files, output_path=None):
    """
    Convenience function to run analysis on multiple files.
    NOTE: Still no input validation
    """
    engine = AnalysisEngine()
    
    for filepath in input_files:
        engine.analyze_file(filepath)
    
    return engine.export_results(output_path)


if __name__ == "__main__":
    files = ["data1.txt", "data2.txt"]
    run_analysis(files)
