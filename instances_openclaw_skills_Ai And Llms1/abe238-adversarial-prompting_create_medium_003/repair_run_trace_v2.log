"""
PROPOSED FIX B: Grading Strictness and Validation Improvements
Author: Engineer B
Date: 2024-01-16

CHANGES SUMMARY:
- Added comprehensive input validation
- Improved grading algorithm with configurable thresholds
- Added strict mode for production environments

KNOWN LIMITATIONS:
- Export reliability still vulnerable to race conditions
- Grading thresholds may be too strict for some use cases
"""

import os
import json
import hashlib
from pathlib import Path
from typing import Optional, Dict, Any


class AnalysisEngine:
    """Main analysis engine for processing data files."""
    
    VALIDATION_RULES = {
        "min_size": 10,
        "max_size": 10_000_000,
        "required_keywords": ["valid"],
        "allowed_extensions": [".txt", ".json", ".csv"]
    }
    
    def __init__(self, config_path="config.json"):
        self.config = self._load_config(config_path)
        self.results = []
        self._cache = {}
        self._strict_mode = self.config.get("strict_mode", False)
    
    def _load_config(self, path):
        """Load configuration from JSON file."""
        if os.path.exists(path):
            with open(path, 'r') as f:
                return json.load(f)
        return {"strict_mode": False, "output_dir": "./output"}
    
    def analyze_file(self, filepath) -> Optional[Dict[str, Any]]:
        """
        Analyze a single data file with validation.
        FIX: Added comprehensive input validation
        FIX: Returns None for invalid files instead of crashing
        """
        path = Path(filepath)
        
        # FIX: Validate file exists
        if not path.exists():
            return {"filename": filepath, "grade": "ERROR", "error": "File not found"}
        
        # FIX: Validate file extension
        if path.suffix not in self.VALIDATION_RULES["allowed_extensions"]:
            return {"filename": filepath, "grade": "ERROR", "error": "Invalid file type"}
        
        try:
            with open(filepath, 'r', encoding='utf-8') as f:
                data = f.read()
        except UnicodeDecodeError:
            return {"filename": filepath, "grade": "ERROR", "error": "Encoding error"}
        except PermissionError:
            return {"filename": filepath, "grade": "ERROR", "error": "Permission denied"}
        
        # FIX: Validate file size
        if len(data) < self.VALIDATION_RULES["min_size"]:
            return {"filename": filepath, "grade": "ERROR", "error": "File too small"}
        
        if len(data) > self.VALIDATION_RULES["max_size"]:
            return {"filename": filepath, "grade": "ERROR", "error": "File too large"}
        
        # Process data
        analysis = {
            "filename": filepath,
            "size": len(data),
            "hash": hashlib.md5(data.encode()).hexdigest(),
            "grade": self._calculate_grade(data),
            "validation_passed": True
        }
        
        self.results.append(analysis)
        return analysis
    
    def _calculate_grade(self, data) -> str:
        """
        Calculate quality grade for data with improved logic.
        FIX: More granular grading scale
        FIX: Configurable thresholds based on strict mode
        """
        score = 0
        deductions = 0
        
        # Base scoring
        if "valid" in data.lower():
            score += 10
        
        if len(data) > 100:
            score += 5
        
        if len(data) > 500:
            score += 5
        
        # FIX: Check for data quality indicators
        if self._strict_mode:
            if data.strip() == "":
                deductions += 15
            if "\n" not in data:
                deductions += 5
        
        final_score = max(0, score - deductions)
        
        # FIX: Multi-level grading
        if final_score >= 20:
            return "PASS_HIGHEST"
        elif final_score >= 15:
            return "PASS"
        elif final_score >= 10:
            return "PASS_LOW"
        else:
            return "FAIL"
    
    def export_results(self, output_path=None):
        """
        Export analysis results to JSON file.
        NOTE: Still uses non-atomic write - known limitation
        """
        path = output_path or self.config.get("output_dir", "./output") + "/results.json"
        
        # FIX: Create directory if needed
        Path(path).parent.mkdir(parents=True, exist_ok=True)
        
        # NOTE: Still vulnerable to race conditions
        with open(path, 'w') as f:
            json.dump(self.results, f, indent=2)
        
        return path
    
    def get_summary(self):
        """Return summary statistics of analysis."""
        if not self.results:
            return {"total": 0, "passed": 0, "failed": 0, "errors": 0}
        
        passed = sum(1 for r in self.results if r.get("grade", "").startswith("PASS"))
        failed = sum(1 for r in self.results if r.get("grade") == "FAIL")
        errors = sum(1 for r in self.results if r.get("grade") == "ERROR")
        
        return {
            "total": len(self.results),
            "passed": passed,
            "failed": failed,
            "errors": errors,
            "pass_rate": passed / len(self.results) if self.results else 0
        }


def run_analysis(input_files, output_path=None):
    """
    Convenience function to run analysis on multiple files.
    FIX: Added input validation and error collection
    """
    engine = AnalysisEngine()
    errors = []
    
    if not input_files:
        raise ValueError("Input files list cannot be empty")
    
    for filepath in input_files:
        result = engine.analyze_file(filepath)
        if result and result.get("grade") == "ERROR":
            errors.append(result)
    
    return engine.export_results(output_path), errors


if __name__ == "__main__":
    files = ["data1.txt", "data2.txt"]
    run_analysis(files)
