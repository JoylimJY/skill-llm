import requests
import json

# Colormind API endpoint
API_URL = "https://colormind.io/api/v1/generate"

# 1. Generate palette with default model, no locked colors
print("Generating default model palette...")
response_default = requests.post(API_URL, json={"model": "default"})
palette_default = response_default.json()
print(f"Response: {palette_default}")

# 2. Generate palette with ui model, first color locked to 0,122,255
print("\nGenerating ui model palette with locked first color...")
response_ui = requests.post(API_URL, json={
    "model": "ui",
    "locked": [True, False, False, False, False],
    "palette": ["0,122,255", "", "", "", ""]
})
palette_ui = response_ui.json()
print(f"Response: {palette_ui}")

# Save as JSON files
with open("palette_default.json", "w") as f:
    json.dump(palette_default, f, indent=2)
print("\nSaved palette_default.json")

with open("palette_ui.json", "w") as f:
    json.dump(palette_ui, f, indent=2)
print("Saved palette_ui.json")

# Helper function to convert RGB to hex
def rgb_to_hex(rgb_str):
    if not rgb_str:
        return ""
    r, g, b = map(int, rgb_str.split(","))
    return f"#{r:02x}{g:02x}{b:02x}"

# Create Markdown summary
md_content = """# Colormind Palettes

## Default Model (No Locked Colors)

| Color 1 | Color 2 | Color 3 | Color 4 | Color 5 |
|---------|---------|---------|---------|---------|
"""

if "palette" in palette_default:
    for color in palette_default["palette"]:
        md_content += f"| {rgb_to_hex(color)} |"
    md_content += "|\n"

md_content += "\n## UI Model (First Color Locked to #007aff)\n\n"
md_content += "| Color 1 | Color 2 | Color 3 | Color 4 | Color 5 |\n"
md_content += "|---------|---------|---------|---------|---------|\n"

if "palette" in palette_ui:
    for color in palette_ui["palette"]:
        md_content += f"| {rgb_to_hex(color)} |"
    md_content += "|\n"

with open("palettes_summary.md", "w") as f:
    f.write(md_content)
print("Saved palettes_summary.md")

print("\nDone!")

