import requests
import json
import urllib3

# Disable SSL warnings
urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

# Try different API endpoints
endpoints = [
    "https://colormind.io/api/generate",
    "https://api.colormind.io/v1/generate",
    "https://colormind.io/api/v1/generate",
]

for url in endpoints:
    try:
        print(f"Trying: {url}")
        response = requests.post(url, json={"model": "default"}, verify=False, timeout=10)
        print(f"  Status: {response.status_code}")
        print(f"  Response: {response.text[:200]}")
    except Exception as e:
        print(f"  Error: {e}")
