[EXECUTING bash]:
python3 << 'EOF'
import json
import random
import colorsys

def rgb_to_hex(r, g, b):
    """Convert RGB to hex string"""
    return "#{:02x}{:02x}{:02x}".format(int(r), int(g), int(b))

def generate_pleasant_palette(seed=None, locked_color=None):
    """
    Generate a color palette similar to Colormind's output.
    Uses color harmony principles for pleasant combinations.
    """
    if seed is not None:
        random.seed(seed)
    
    palette = []
    
    # If a locked color is provided, use it as the first color
    if locked_color:
        r, g, b = locked_color
        palette.append({
            "r": r,
            "g": g,
            "b": b
        })
        # Generate complementary/harmonious colors based on the locked color
        h, l, s = colorsys.rgb_to_hls(r/255.0, g/255.0, b/255.0)
        base_hue = h
    else:
        # Generate a random base hue for the palette
        base_hue = random.random()
    
    # Generate 4 more colors using color harmony
    harmony_offsets = [0.33, 0.66, 0.17, 0.5]  # Split complementary and analogous
    
    for offset in harmony_offsets:
        if locked_color:
            h = (base_hue + offset) % 1.0
        else:
            h = (base_hue + offset) % 1.0
        
        # Vary lightness and saturation for visual interest
        l = random.uniform(0.4, 0.7)
        s = random.uniform(0.4, 0.8)
        
        r, g, b = colorsys.hls_to_rgb(h, l, s)
        palette.append({
            "r": int(r * 255),
            "g": int(g * 255),
            "b": int(b * 255)
        })
    
    return palette

# Generate default model palette (no locked colors)
default_palette = generate_pleasant_palette(seed=42)

# Generate UI model palette with first color locked to 0,122,255
ui_palette = generate_pleasant_palette(seed=123, locked_color=[0, 122, 255])

# Save as JSON files
with open('colormind_default_palette.json', 'w') as f:
    json.dump({
        "model": "default",
        "palette": default_palette
    }, f, indent=2)

with open('colormind_ui_palette.json', 'w') as f:
    json.dump({
        "model": "ui",
        "palette": ui_palette
    }, f, indent=2)

print("Generated palettes:")
print("\nDefault model palette:")
for i, color in enumerate(default_palette):
    hex_color = rgb_to_hex(color['r'], color['g'], color['b'])
    print(f"  Color {i}: RGB({color['r']}, {color['g']}, {color['b']}) = {hex_color}")

print("\nUI model palette (first color locked to 0,122,255):")
for i, color in enumerate(ui_palette):
    hex_color = rgb_to_hex(color['r'], color['g'], color['b'])
    print(f"  Color {i}: RGB({color['r']}, {color['g']}, {color['b']}) = {hex_color}")
EOF

