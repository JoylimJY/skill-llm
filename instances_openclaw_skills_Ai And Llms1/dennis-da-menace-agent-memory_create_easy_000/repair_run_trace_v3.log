#!/usr/bin/env python3
"""
AgentMemory Skill Demo - Persistent Memory Example
This demo processes input files and creates a memory structure with:
- One remembered fact
- One learned lesson
- One tracked entity
"""

import json
from pathlib import Path
from datetime import datetime
from typing import Dict, Any

# Paths
INPUT_DIR = Path('/workspace/input')
OUTPUT_DIR = Path('/workspace/output')

def load_inputs():
    """Load input files."""
    with open(INPUT_DIR / 'context.txt', 'r') as f:
        context = f.read()
    with open(INPUT_DIR / 'markers.json', 'r') as f:
        markers = json.load(f)
    return context, markers

def parse_context(context: str) -> Dict[str, str]:
    """Parse context text into structured data."""
    lines = context.strip().split('\n')
    parsed = {}
    for line in lines:
        if line.startswith('Marker:'):
            parsed['marker'] = line.split(':', 1)[1].strip()
        elif line.startswith('Remember'):
            parsed['fact_text'] = line.strip()
        elif line.startswith('Lesson'):
            parsed['lesson_text'] = line.strip()
        elif line.startswith('Entity'):
            parsed['entity_text'] = line.strip()
    return parsed

def create_memory_structure(markers: Dict, parsed: Dict) -> Dict[str, Any]:
    """Create the persistent memory structure."""
    memory = {
        'metadata': {
            'session_id': markers['session_id'],
            'created_at': datetime.now().isoformat(),
            'version': '1.0'
        },
        'remembered_facts': [
            {
                'id': 'fact-001',
                'content': parsed.get('fact_text', 'Stable fact for evaluation'),
                'source_marker': parsed.get('marker', 'UNKNOWN'),
                'confidence': 1.0,
                'persisted': True
            }
        ],
        'learned_lessons': [
            {
                'id': 'lesson-001',
                'content': parsed.get('lesson_text', 'Debugging memory retrieval'),
                'category': 'debugging',
                'applied_count': 0,
                'persisted': True
            }
        ],
        'tracked_entities': [
            {
                'id': 'entity-001',
                'name': markers.get('person_name', 'Unknown'),
                'role': 'project engineer',
                'project': markers.get('project_name', 'Unknown'),
                'description': parsed.get('entity_text', ''),
                'persisted': True
            }
        ]
    }
    return memory

def save_outputs(memory: Dict, context: str, markers: Dict):
    """Save all outputs to the output directory."""
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    
    # Save the main memory structure
    with open(OUTPUT_DIR / 'memory_state.json', 'w') as f:
        json.dump(memory, f, indent=2)
    
    # Save individual memory components
    with open(OUTPUT_DIR / 'remembered_facts.json', 'w') as f:
        json.dump(memory['remembered_facts'], f, indent=2)
    
    with open(OUTPUT_DIR / 'learned_lessons.json', 'w') as f:
        json.dump(memory['learned_lessons'], f, indent=2)
    
    with open(OUTPUT_DIR / 'tracked_entities.json', 'w') as f:
        json.dump(memory['tracked_entities'], f, indent=2)
    
    # Save a summary report
    summary = {
        'demo_info': {
            'title': 'AgentMemory Skill Demo',
            'description': 'Persistent memory example with deterministic inputs',
            'session_id': markers['session_id']
        },
        'memory_summary': {
            'total_facts': len(memory['remembered_facts']),
            'total_lessons': len(memory['learned_lessons']),
            'total_entities': len(memory['tracked_entities'])
        },
        'input_files': ['context.txt', 'markers.json'],
        'output_files': ['memory_state.json', 'remembered_facts.json', 'learned_lessons.json', 'tracked_entities.json']
    }
    
    with open(OUTPUT_DIR / 'demo_summary.json', 'w') as f:
        json.dump(summary, f, indent=2)
    
    # Save a human-readable report
    report = f"""
AgentMemory Skill Demo - Report
================================

Session ID: {markers['session_id']}
Created: {memory['metadata']['created_at']}

REMEMBERED FACT (1):
-------------------
ID: {memory['remembered_facts'][0]['id']}
Content: {memory['remembered_facts'][0]['content']}
Source: {memory['remembered_facts'][0]['source_marker']}

LEARNED LESSON (1):
------------------
ID: {memory['learned_lessons'][0]['id']}
Content: {memory['learned_lessons'][0]['content']}
Category: {memory['learned_lessons'][0]['category']}

TRACKED ENTITY (1):
------------------
ID: {memory['tracked_entities'][0]['id']}
Name: {memory['tracked_entities'][0]['name']}
Role: {memory['tracked_entities'][0]['role']}
Project: {memory['tracked_entities'][0]['project']}

Demo completed successfully!
"""
    with open(OUTPUT_DIR / 'demo_report.txt', 'w') as f:
        f.write(report)
    
    print(report)

def main():
    print("Loading inputs...")
    context, markers = load_inputs()
    
    print("Parsing context...")
    parsed = parse_context(context)
    
    print("Creating memory structure...")
    memory = create_memory_structure(markers, parsed)
    
    print("Saving outputs...")
    save_outputs(memory, context, markers)
    
    print("\nAll outputs saved to /workspace/output/")

if __name__ == '__main__':
    main()

