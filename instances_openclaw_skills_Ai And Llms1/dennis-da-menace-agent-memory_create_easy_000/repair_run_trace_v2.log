[EXECUTING python]:
#!/usr/bin/env python3
"""
AgentMemory Skill - Persistent Memory Demo
Creates a small demo with deterministic input files showing:
- One remembered fact
- One learned lesson
- One tracked entity
"""

import json
from pathlib import Path
from datetime import datetime

# Paths
INPUT_DIR = Path('/workspace/input')
OUTPUT_DIR = Path('/workspace/output')

# Ensure output directory exists
OUTPUT_DIR.mkdir(exist_ok=True)

# Read input files
context_text = (INPUT_DIR / 'context.txt').read_text(encoding='utf-8')
markers_data = json.loads((INPUT_DIR / 'markers.json').read_text(encoding='utf-8'))

# Parse and extract memory components
def extract_memory_components(context: str, markers: dict) -> dict:
    """Extract fact, lesson, and entity from context."""
    
    # Extract the remembered fact (stable fact line)
    lines = context.strip().split('\n')
    fact = None
    lesson = None
    entity = None
    
    for line in lines:
        line_lower = line.lower()
        if 'remember' in line_lower and 'fact' in line_lower:
            fact = line.strip()
        elif 'lesson' in line_lower:
            lesson = line.strip()
        elif 'entity' in line_lower:
            entity = line.strip()
    
    # Build the memory structure
    memory = {
        "session_id": markers.get("session_id", "unknown"),
        "timestamp": datetime.utcnow().isoformat() + "Z",
        "remembered_facts": [
            {
                "id": "fact-001",
                "content": fact or "No fact found",
                "marker": "ORCHID-42",
                "persistence": True
            }
        ],
        "learned_lessons": [
            {
                "id": "lesson-001",
                "content": lesson or "No lesson found",
                "category": "debugging",
                "applied": False
            }
        ],
        "tracked_entities": [
            {
                "id": "entity-001",
                "name": markers.get("person_name", "Unknown"),
                "role": "project engineer",
                "project": markers.get("project_name", "Unknown"),
                "description": entity or "No entity description"
            }
        ],
        "metadata": {
            "input_files": ["context.txt", "markers.json"],
            "demo_type": "persistent_memory",
            "skill": "AgentMemory"
        }
    }
    
    return memory

# Generate memory output
memory_output = extract_memory_components(context_text, markers_data)

# Save the main memory file
memory_file = OUTPUT_DIR / 'agent_memory.json'
memory_file.write_text(json.dumps(memory_output, indent=2), encoding='utf-8')

# Save individual component files for clarity
facts_file = OUTPUT_DIR / 'remembered_facts.json'
facts_file.write_text(json.dumps(memory_output['remembered_facts'], indent=2), encoding='utf-8')

lessons_file = OUTPUT_DIR / 'learned_lessons.json'
lessons_file.write_text(json.dumps(memory_output['learned_lessons'], indent=2), encoding='utf-8')

entities_file = OUTPUT_DIR / 'tracked_entities.json'
entities_file.write_text(json.dumps(memory_output['tracked_entities'], indent=2), encoding='utf-8')

# Save a summary text file
summary = f"""AgentMemory Demo - Summary
============================
Session ID: {memory_output['session_id']}
Timestamp: {memory_output['timestamp']}

REMEMBERED FACT (1):
- {memory_output['remembered_facts'][0]['content']}

LEARNED LESSON (1):
- {memory_output['learned_lessons'][0]['content']}

TRACKED ENTITY (1):
- Name: {memory_output['tracked_entities'][0]['name']}
- Role: {memory_output['tracked_entities'][0]['role']}
- Project: {memory_output['tracked_entities'][0]['project']}

Output Files:
- agent_memory.json (complete memory state)
- remembered_facts.json
- learned_lessons.json
- tracked_entities.json
"""

summary_file = OUTPUT_DIR / 'demo_summary.txt'
summary_file.write_text(summary, encoding='utf-8')

print("AgentMemory Demo Complete!")
print(f"Output files saved to: {OUTPUT_DIR}")
print(f"\n{summary}")

