[EXECUTING python]:
from pathlib import Path
import json
from datetime import datetime

# Read input files
context_path = Path('input/context.txt')
markers_path = Path('input/markers.json')

context_text = context_path.read_text(encoding='utf-8')
markers = json.loads(markers_path.read_text(encoding='utf-8'))

# Parse the context to extract memory components
lines = context_text.strip().split('\n')

# Extract fact (second line)
fact = lines[1]  # "Remember this stable fact for evaluation."

# Extract lesson (third line, after "Lesson context:")
lesson_line = lines[2]
lesson = lesson_line.replace('Lesson context: ', '').strip()

# Extract entity (fourth line, after "Entity context:")
entity_line = lines[3]
entity = entity_line.replace('Entity context: ', '').strip()

# Create memory structures
remembered_facts = {
    "id": "fact-001",
    "content": fact,
    "source": "context.txt",
    "timestamp": datetime.utcnow().isoformat() + "Z"
}

learned_lessons = {
    "id": "lesson-001",
    "topic": lesson,
    "source": "context.txt",
    "timestamp": datetime.utcnow().isoformat() + "Z"
}

tracked_entities = {
    "id": "entity-001",
    "name": markers['person_name'],
    "role": "project engineer",
    "project": markers['project_name'],
    "description": entity,
    "timestamp": datetime.utcnow().isoformat() + "Z"
}

# Create the complete memory store
memory_store = {
    "session_id": markers['session_id'],
    "created_at": datetime.utcnow().isoformat() + "Z",
    "remembered_facts": [remembered_facts],
    "learned_lessons": [learned_lessons],
    "tracked_entities": [tracked_entities],
    "metadata": {
        "total_facts": 1,
        "total_lessons": 1,
        "total_entities": 1
    }
}

# Save to output directory
output_dir = Path('output')
output_dir.mkdir(exist_ok=True)

# Save the main memory store
memory_file = output_dir / 'agent_memory.json'
memory_file.write_text(json.dumps(memory_store, indent=2), encoding='utf-8')

# Save individual components for easy verification
(output_dir / 'remembered_fact.json').write_text(json.dumps(remembered_facts, indent=2), encoding='utf-8')
(output_dir / 'learned_lesson.json').write_text(json.dumps(learned_lessons, indent=2), encoding='utf-8')
(output_dir / 'tracked_entity.json').write_text(json.dumps(tracked_entities, indent=2), encoding='utf-8')

print("AgentMemory Demo - Persistent Memory Created")
print("=" * 50)
print(f"Session: {markers['session_id']}")
print(f"\nRemembered Fact:")
print(f"  - {remembered_facts['content']}")
print(f"\nLearned Lesson:")
print(f"  - Topic: {learned_lessons['topic']}")
print(f"\nTracked Entity:")
print(f"  - Name: {tracked_entities['name']}")
print(f"  - Role: {tracked_entities['role']}")
print(f"  - Project: {tracked_entities['project']}")
print(f"\nOutputs saved to: {output_dir}/")
print("  - agent_memory.json (complete memory store)")
print("  - remembered_fact.json")
print("  - learned_lesson.json")
print("  - tracked_entity.json")

