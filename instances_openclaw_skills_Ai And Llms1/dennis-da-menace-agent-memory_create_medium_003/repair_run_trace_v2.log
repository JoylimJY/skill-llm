"""
AgentMemory - A simple persistent memory layer for AI agents.
Uses SQLite for persistence in the default .agent-memory/ directory.
"""

import sqlite3
import json
from pathlib import Path
from typing import List, Dict, Any, Optional
from datetime import datetime

class AgentMemory:
    """Persistent memory store for AI agents using SQLite."""
    
    DEFAULT_DB_PATH = ".agent-memory/memory.db"
    
    def __init__(self, db_path: Optional[str] = None):
        """Initialize the memory layer with optional custom database path."""
        self.db_path = db_path or self.DEFAULT_DB_PATH
        self._ensure_db()
    
    def _ensure_db(self):
        """Create database and tables if they don't exist."""
        db_dir = Path(self.db_path).parent
        db_dir.mkdir(parents=True, exist_ok=True)
        
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        # Sessions table
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS sessions (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                session_name TEXT UNIQUE,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        ''')
        
        # Facts table
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS facts (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                content TEXT NOT NULL,
                session_id INTEGER,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                FOREIGN KEY (session_id) REFERENCES sessions(id)
            )
        ''')
        
        # Lessons table
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS lessons (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                content TEXT NOT NULL,
                session_id INTEGER,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                FOREIGN KEY (session_id) REFERENCES sessions(id)
            )
        ''')
        
        # Entities table
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS entities (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                entity_type TEXT NOT NULL,
                attributes TEXT,
                session_id INTEGER,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                FOREIGN KEY (session_id) REFERENCES sessions(id)
            )
        ''')
        
        conn.commit()
        conn.close()
    
    def add_session(self, session_name: str) -> int:
        """Add or retrieve a session."""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        cursor.execute(
            'INSERT OR IGNORE INTO sessions (session_name) VALUES (?)',
            (session_name,)
        )
        
        cursor.execute(
            'SELECT id FROM sessions WHERE session_name = ?',
            (session_name,)
        )
        result = cursor.fetchone()
        session_id = result[0] if result else None
        
        conn.commit()
        conn.close()
        return session_id
    
    def add_fact(self, content: str, session_id: Optional[int] = None) -> int:
        """Add a fact to memory."""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        cursor.execute(
            'INSERT INTO facts (content, session_id) VALUES (?, ?)',
            (content, session_id)
        )
        fact_id = cursor.lastrowid
        
        conn.commit()
        conn.close()
        return fact_id
    
    def add_lesson(self, content: str, session_id: Optional[int] = None) -> int:
        """Add a lesson to memory."""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        cursor.execute(
            'INSERT INTO lessons (content, session_id) VALUES (?, ?)',
            (content, session_id)
        )
        lesson_id = cursor.lastrowid
        
        conn.commit()
        conn.close()
        return lesson_id
    
    def add_entity(self, name: str, entity_type: str, attributes: Dict[str, Any], 
                   session_id: Optional[int] = None) -> int:
        """Add an entity to memory."""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        attributes_json = json.dumps(attributes)
        cursor.execute(
            'INSERT INTO entities (name, entity_type, attributes, session_id) VALUES (?, ?, ?, ?)',
            (name, entity_type, attributes_json, session_id)
        )
        entity_id = cursor.lastrowid
        
        conn.commit()
        conn.close()
        return entity_id
    
    def get_all_facts(self) -> List[str]:
        """Retrieve all facts."""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        cursor.execute('SELECT content FROM facts')
        facts = [row[0] for row in cursor.fetchall()]
        
        conn.close()
        return facts
    
    def get_all_lessons(self) -> List[str]:
        """Retrieve all lessons."""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        cursor.execute('SELECT content FROM lessons')
        lessons = [row[0] for row in cursor.fetchall()]
        
        conn.close()
        return lessons
    
    def get_all_entities(self) -> List[Dict[str, Any]]:
        """Retrieve all entities."""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        cursor.execute('SELECT name, entity_type, attributes FROM entities')
        entities = []
        for row in cursor.fetchall():
            entities.append({
                'name': row[0],
                'type': row[1],
                'attributes': json.loads(row[2]) if row[2] else {}
            })
        
        conn.close()
        return entities
    
    def get_all_sessions(self) -> List[str]:
        """Retrieve all session names."""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        cursor.execute('SELECT session_name FROM sessions')
        sessions = [row[0] for row in cursor.fetchall()]
        
        conn.close()
        return sessions
    
    def get_summary(self) -> Dict[str, Any]:
        """Get a summary of all stored memory."""
        return {
            'sessions': self.get_all_sessions(),
            'facts': self.get_all_facts(),
            'lessons': self.get_all_lessons(),
            'entities': self.get_all_entities()
        }


if __name__ == '__main__':
    print("AgentMemory module loaded successfully.")
EOF

