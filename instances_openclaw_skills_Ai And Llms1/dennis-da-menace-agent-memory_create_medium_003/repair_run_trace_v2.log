#!/usr/bin/env python3
"""
Persistent Memory Layer Demo for AI Agent
Loads data from memory_input.json, stores it using AgentMemory,
and writes a summary file showing what was remembered.
"""

import json
import sys
from pathlib import Path
from agent_memory import AgentMemory

def main():
    workspace = Path(__file__).parent
    
    # Load input data
    input_file = workspace / 'memory_input.json'
    if not input_file.exists():
        print(f"Error: {input_file} not found")
        sys.exit(1)
    
    with open(input_file, 'r', encoding='utf-8') as f:
        data = json.load(f)
    
    # Initialize memory (uses default .agent-memory/memory.db)
    memory = AgentMemory()
    
    # Add session
    session_name = data.get('session', 'default-session')
    session_id = memory.add_session(session_name)
    print(f"Session '{session_name}' stored (id: {session_id})")
    
    # Add facts
    facts = data.get('facts', [])
    for fact in facts:
        fact_id = memory.add_fact(fact, session_id)
        print(f"Fact stored (id: {fact_id}): {fact[:50]}...")
    
    # Add lesson
    lesson = data.get('lesson', '')
    if lesson:
        lesson_id = memory.add_lesson(lesson, session_id)
        print(f"Lesson stored (id: {lesson_id}): {lesson[:50]}...")
    
    # Add entity
    entity = data.get('entity', {})
    if entity:
        entity_id = memory.add_entity(
            name=entity.get('name', 'Unknown'),
            entity_type=entity.get('type', 'unknown'),
            attributes=entity.get('attributes', {}),
            session_id=session_id
        )
        print(f"Entity stored (id: {entity_id}): {entity.get('name')}")
    
    # Get summary from persistent storage
    summary = memory.get_summary()
    
    # Write summary file
    summary_file = workspace / 'memory_summary.txt'
    with open(summary_file, 'w', encoding='utf-8') as f:
        f.write("=" * 60 + "\n")
        f.write("AGENT MEMORY SUMMARY\n")
        f.write("=" * 60 + "\n\n")
        
        f.write("SESSIONS:\n")
        f.write("-" * 40 + "\n")
        for session in summary['sessions']:
            f.write(f"  - {session}\n")
        f.write("\n")
        
        f.write("FACTS:\n")
        f.write("-" * 40 + "\n")
        for fact in summary['facts']:
            f.write(f"  * {fact}\n")
        f.write("\n")
        
        f.write("LESSONS:\n")
        f.write("-" * 40 + "\n")
        for lesson in summary['lessons']:
            f.write(f"  * {lesson}\n")
        f.write("\n")
        
        f.write("ENTITIES:\n")
        f.write("-" * 40 + "\n")
        for entity in summary['entities']:
            f.write(f"  - {entity['name']} ({entity['type']})\n")
            for key, value in entity.get('attributes', {}).items():
                f.write(f"      {key}: {value}\n")
        f.write("\n")
        
        f.write("=" * 60 + "\n")
        f.write(f"Database: {memory.db_path}\n")
        f.write(f"Total facts: {len(summary['facts'])}\n")
        f.write(f"Total lessons: {len(summary['lessons'])}\n")
        f.write(f"Total entities: {len(summary['entities'])}\n")
        f.write("=" * 60 + "\n")
    
    print(f"\nSummary written to: {summary_file}")
    print("Memory persistence verified - data stored in SQLite database.")

if __name__ == '__main__':
    main()
EOF

