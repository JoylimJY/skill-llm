[EXECUTING python]:
import json
from datetime import datetime, timedelta

# Read inputs
with open('/workspace/inputs/product_brief.json', 'r') as f:
    product_brief = json.load(f)

with open('/workspace/inputs/backlog_seed.json', 'r') as f:
    backlog_seed = json.load(f)

with open('/workspace/inputs/marker_note.txt', 'r') as f:
    marker_content = f.read().strip()

# Extract marker
marker = marker_content.split(': ')[-1].strip()

# Calculate capacity
velocity = product_brief['teams']['velocity']
availability = product_brief['teams']['availability_factor']
sprint_days = product_brief['teams']['sprint_days']

effective_capacity = velocity * availability
committed_capacity = int(effective_capacity * 0.85)
buffer_capacity = int(effective_capacity * 0.10)

# Create INVEST-compliant user stories with acceptance criteria
user_stories = []

for item in backlog_seed:
    story = {
        "id": item['id'],
        "title": item['title'],
        "as_a": item['persona'],
        "i_want": item['need'],
        "so_that": item['benefit'],
        "priority": item['priority_hint'],
        "story_points": min(item['complexity_hint'], 8),
        "invest_check": {
            "independent": True,
            "negotiable": True,
            "valuable": True,
            "estimable": True,
            "small": True,
            "testable": True
        },
        "acceptance_criteria": [],
        "definition_of_done": [
            "Code reviewed and merged",
            "Unit tests passing",
            "Acceptance criteria verified",
            "Documentation updated if needed",
            "No regression in existing features"
        ]
    }
    
    if item['id'] == 'ONB-101':
        story['acceptance_criteria'] = [
            "Given a new administrator account, when they log in for the first time, then a welcome checklist modal is displayed",
            "Given the welcome checklist, when I complete each step, then the step is marked as complete with visual indication",
            "Given the welcome checklist, when I mark all steps complete, then a success message is shown",
            "Given the welcome checklist, when I close it without completion, then I can reopen it from the dashboard",
            "Given the welcome checklist, when I navigate away, then my progress is saved"
        ]
    elif item['id'] == 'ONB-102':
        story['acceptance_criteria'] = [
            "Given I am on the dashboard, when I view key metrics, then I see at least 5 relevant KPIs for my role",
            "Given the dashboard, when I hover over a metric, then I see additional context and trend indicators",
            "Given the dashboard, when metrics data is unavailable, then I see a loading state or graceful fallback",
            "Given the dashboard, when I refresh the page, then metrics reload within 3 seconds",
            "Given the dashboard, when I have no data yet, then I see helpful guidance"
        ]
    elif item['id'] == 'ONB-103':
        story['acceptance_criteria'] = [
            "Given I am using keyboard navigation, when I press Tab, then focus moves logically through elements",
            "Given keyboard navigation, when I press Enter on a focused button, then the action is triggered",
            "Given keyboard navigation, when I press Escape, then any open modal or dropdown is closed",
            "Given keyboard navigation, when I use arrow keys, then I can navigate between related options",
            "Given keyboard navigation, when I am in a focused element, then the focus outline is clearly visible"
        ]
    elif item['id'] == 'ONB-104':
        story['acceptance_criteria'] = [
            "Given I am on the progress page, when I click Export PDF, then a PDF file is generated and downloaded",
            "Given the exported PDF, when I open it, then it contains all completed checklist items with timestamps",
            "Given the exported PDF, when I open it, then it includes the user name and export date",
            "Given the export function, when I have no progress data, then I see a message explaining no data to export",
            "Given the exported PDF, when I verify the content, then all formatting is clean and readable"
        ]
    elif item['id'] == 'ONB-105':
        story['acceptance_criteria'] = [
            "Given a setup screen with form fields, when I hover over a field label, then a tooltip appears",
            "Given a tooltip, when I move my cursor away, then the tooltip disappears after a brief delay",
            "Given a tooltip, when I press Escape, then the tooltip is immediately dismissed",
            "Given a setup screen, when tooltips are enabled, then each input field has contextual help",
            "Given a tooltip, when I verify its content, then the text is concise and actionable"
        ]
    
    user_stories.append(story)

# Sort by priority
priority_order = {'High': 0, 'Medium': 1, 'Low': 2}
user_stories.sort(key=lambda x: (priority_order[x['priority']], x['id']))

# Sprint plan calculation
sprint_stories = []
running_total = 0
for story in user_stories:
    if running_total + story['story_points'] <= committed_capacity:
        sprint_stories.append(story['id'])
        running_total += story['story_points']

# Sprint timeline
sprint_start = datetime.now()
sprint_end = sprint_start + timedelta(days=sprint_days)

# Create the sprint planning package
sprint_plan = {
    "metadata": {
        "generated_at": datetime.now().isoformat(),
        "marker": marker,
        "document_version": "1.0"
    },
    "epic_summary": {
        "name": product_brief['epic_name'],
        "business_goal": product_brief['business_goal'],
        "stakeholders": product_brief['stakeholders'],
        "marker": marker
    },
    "team_capacity": {
        "base_velocity": velocity,
        "availability_factor": availability,
        "sprint_duration_days": sprint_days,
        "effective_capacity_points": round(effective_capacity, 1),
        "committed_capacity_limit": committed_capacity,
        "reserved_buffer_points": buffer_capacity,
        "utilization_percentage": round((committed_capacity / effective_capacity) * 100, 1)
    },
    "constraints_applied": product_brief['constraints'],
    "backlog": {
        "total_stories": len(user_stories),
        "stories_by_priority": {
            "High": len([s for s in user_stories if s['priority'] == 'High']),
            "Medium": len([s for s in user_stories if s['priority'] == 'Medium']),
            "Low": len([s for s in user_stories if s['priority'] == 'Low'])
        },
        "total_story_points": sum(s['story_points'] for s in user_stories),
        "items": user_stories
    },
    "sprint_plan": {
        "sprint_name": "Sprint 1 - Customer Onboarding Foundation",
        "start_date": sprint_start.strftime("%Y-%m-%d"),
        "end_date": sprint_end.strftime("%Y-%m-%d"),
        "committed_stories": sprint_stories,
        "committed_points": running_total,
        "remaining_buffer": committed_capacity - running_total,
        "deferred_to_next_sprint": [s['id'] for s in user_stories if s['id'] not in sprint_stories],
        "timeline": {
            "day_1": "Sprint planning and story refinement",
            "day_2_to_7": "Development work on committed stories",
            "day_8": "Code review and integration",
            "day_9": "Testing and QA validation",
            "day_10": "Sprint review and retrospective"
        }
    }
}

# Write output
with open('/workspace/sprint_planning_package.json', 'w') as f:
    json.dump(sprint_plan, f, indent=2)

print("Sprint planning package generated successfully!")
print(f"Marker: {marker}")
print(f"Effective capacity: {round(effective_capacity, 1)} points")
print(f"Committed capacity (85%): {committed_capacity} points")
print(f"Buffer (10%): {buffer_capacity} points")
print(f"Stories in sprint: {sprint_stories} ({running_total} points)")
print(f"Deferred stories: {[s['id'] for s in user_stories if s['id'] not in sprint_stories]}")

