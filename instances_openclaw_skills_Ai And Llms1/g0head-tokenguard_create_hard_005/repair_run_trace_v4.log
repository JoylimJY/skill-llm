cat > /workspace/tokenguard_report.py << 'EOF'
#!/usr/bin/env python3
"""
TokenGuard Session Reporting Utility

Reads TokenGuard session data and generates:
- Human-readable text report (tokenguard_report.txt)
- Machine-readable JSON summary (tokenguard_report.json)
- Markdown summary (tokenguard_summary.md)
"""

import json
import sys
from datetime import datetime
from pathlib import Path


def load_session_data(filepath: str) -> dict:
    """Load and parse session data from JSON file."""
    path = Path(filepath)
    if not path.exists():
        raise FileNotFoundError(f"Session input file not found: {filepath}")
    
    with open(path, 'r') as f:
        return json.load(f)


def calculate_metrics(data: dict) -> dict:
    """Calculate session metrics from raw data."""
    limit = float(data.get('limit', 0))
    spent = float(data.get('spent', 0))
    remaining = limit - spent
    percentage = (spent / limit * 100) if limit > 0 else 0
    num_entries = len(data.get('entries', []))
    is_warning = percentage > 80
    
    return {
        'limit': limit,
        'spent': spent,
        'remaining': remaining,
        'percentage': percentage,
        'num_entries': num_entries,
        'is_warning': is_warning,
        'marker': data.get('marker', 'N/A'),
        'entries': data.get('entries', [])
    }


def generate_text_report(metrics: dict, timestamp: str) -> str:
    """Generate human-readable text report."""
    warning_line = ""
    if metrics['is_warning']:
        warning_line = f"\n⚠️  WARNING: Session spending is above 80% of limit ({metrics['percentage']:.1f}%)"
    
    report = f"""================================================================================
                    TOKENGUARD SESSION REPORT
================================================================================
Generated: {timestamp}
Session Marker: {metrics['marker']}

--------------------------------------------------------------------------------
                         SPENDING SUMMARY
--------------------------------------------------------------------------------
Current Limit:      ${metrics['limit']:.2f}
Amount Spent:       ${metrics['spent']:.2f}
Remaining Budget:   ${metrics['remaining']:.2f}
Usage Percentage:   {metrics['percentage']:.1f}%
Logged Entries:     {metrics['num_entries']}
{warning_line}

--------------------------------------------------------------------------------
                         ENTRY DETAILS
--------------------------------------------------------------------------------
"""
    
    for i, entry in enumerate(metrics['entries'], 1):
        amount = entry.get('amount', 0)
        description = entry.get('description', 'No description')
        report += f"  {i}. ${amount:.2f} - {description}\n"
    
    report += """
================================================================================
                           END OF REPORT
================================================================================
"""
    return report


def generate_json_summary(metrics: dict, timestamp: str) -> dict:
    """Generate machine-readable JSON summary."""
    return {
        'report_metadata': {
            'generated_at': timestamp,
            'session_marker': metrics['marker']
        },
        'spending_summary': {
            'limit': metrics['limit'],
            'spent': metrics['spent'],
            'remaining': metrics['remaining'],
            'usage_percentage': round(metrics['percentage'], 2)
        },
        'session_info': {
            'num_entries': metrics['num_entries'],
            'warning_above_80_percent': metrics['is_warning']
        },
        'entries': metrics['entries']
    }


def generate_markdown_summary(metrics: dict, timestamp: str) -> str:
    """Generate Markdown summary with key metrics."""
    warning_status = "🟡 WARNING" if metrics['is_warning'] else "🟢 OK"
    warning_msg = f"**⚠️ WARNING**: Spending exceeds 80% of limit!" if metrics['is_warning'] else ""
    
    md = f"""# TokenGuard Session Report

> Generated: {timestamp}  
> **Session Marker**: `{metrics['marker']}`

## Key Metrics

| Metric | Value |
|--------|-------|
| Current Limit | ${metrics['limit']:.2f} |
| Amount Spent | ${metrics['spent']:.2f} |
| Remaining Budget | ${metrics['remaining']:.2f} |
| Usage Percentage | {metrics['percentage']:.1f}% |
| Logged Entries | {metrics['num_entries']} |
| Status | {warning_status} |

{warning_msg}

## Entry Details

| # | Amount | Description |
|---|--------|-------------|
"""
    
    for i, entry in enumerate(metrics['entries'], 1):
        amount = entry.get('amount', 0)
        description = entry.get('description', 'No description')
        md += f"| {i} | ${amount:.2f} | {description} |\n"
    
    md += f"""
---
*Report generated by TokenGuard Reporting Utility*
"""
    return md


def main(input_file: str = 'session_input.json') -> None:
    """Main entry point for the reporting utility."""
    workspace_root = Path(__file__).parent
    
    # Load session data
    print(f"Loading session data from: {input_file}")
    data = load_session_data(input_file)
    
    # Calculate metrics
    metrics = calculate_metrics(data)
    
    # Generate timestamp
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    
    # Generate reports
    text_report = generate_text_report(metrics, timestamp)
    json_summary = generate_json_summary(metrics, timestamp)
    markdown_summary = generate_markdown_summary(metrics, timestamp)
    
    # Write output files
    txt_path = workspace_root / 'tokenguard_report.txt'
    json_path = workspace_root / 'tokenguard_report.json'
    md_path = workspace_root / 'tokenguard_summary.md'
    
    with open(txt_path, 'w') as f:
        f.write(text_report)
    print(f"✓ Generated: {txt_path}")
    
    with open(json_path, 'w') as f:
        json.dump(json_summary, f, indent=2)
    print(f"✓ Generated: {json_path}")
    
    with open(md_path, 'w') as f:
        f.write(markdown_summary)
    print(f"✓ Generated: {md_path}")
    
    # Print summary to console
    print(f"\n--- Quick Summary ---")
    print(f"Limit: ${metrics['limit']:.2f} | Spent: ${metrics['spent']:.2f} | Remaining: ${metrics['remaining']:.2f}")
    print(f"Usage: {metrics['percentage']:.1f}% ({metrics['num_entries']} entries)")
    if metrics['is_warning']:
        print(f"⚠️  WARNING: Above 80% threshold!")


if __name__ == '__main__':
    input_file = sys.argv[1] if len(sys.argv) > 1 else 'session_input.json'
    main(input_file)
EOF

