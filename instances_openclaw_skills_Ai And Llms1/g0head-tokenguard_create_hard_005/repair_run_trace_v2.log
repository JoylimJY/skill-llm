#!/usr/bin/env python3
"""
TokenGuard Session Reporting Utility

Generates human-readable and machine-readable reports from TokenGuard session data.
"""

import json
import sys
from pathlib import Path
from datetime import datetime
from typing import Dict, Any, List


def load_session_data(input_path: str) -> Dict[str, Any]:
    """Load and validate session data from JSON file."""
    path = Path(input_path)
    if not path.exists():
        raise FileNotFoundError(f"Session input file not found: {input_path}")
    
    with open(path, 'r') as f:
        data = json.load(f)
    
    required_fields = ['limit', 'spent', 'entries', 'marker']
    for field in required_fields:
        if field not in data:
            raise ValueError(f"Missing required field: {field}")
    
    return data


def calculate_metrics(data: Dict[str, Any]) -> Dict[str, Any]:
    """Calculate session metrics from raw data."""
    limit = data['limit']
    spent = data['spent']
    entries = data['entries']
    marker = data['marker']
    
    remaining = limit - spent
    usage_percentage = (spent / limit * 100) if limit > 0 else 0
    is_warning = usage_percentage > 80
    entry_count = len(entries)
    calculated_spent = sum(entry.get('amount', 0) for entry in entries)
    
    return {
        'limit': limit,
        'spent': spent,
        'remaining': remaining,
        'usage_percentage': round(usage_percentage, 2),
        'entry_count': entry_count,
        'is_warning': is_warning,
        'marker': marker,
        'calculated_spent': calculated_spent,
        'generated_at': datetime.now().isoformat()
    }


def generate_text_report(metrics: Dict[str, Any], entries: List[Dict]) -> str:
    """Generate human-readable text report."""
    lines = [
        "=" * 60,
        "TOKENGUARD SESSION REPORT",
        "=" * 60,
        "",
        f"Marker: {metrics['marker']}",
        f"Generated: {metrics['generated_at']}",
        "",
        "-" * 40,
        "SPENDING SUMMARY",
        "-" * 40,
        f"  Limit:        ${metrics['limit']:.2f}",
        f"  Spent:        ${metrics['spent']:.2f}",
        f"  Remaining:    ${metrics['remaining']:.2f}",
        f"  Usage:        {metrics['usage_percentage']:.1f}%",
        f"  Entries:      {metrics['entry_count']}",
        "",
    ]
    
    if metrics['is_warning']:
        lines.extend([
            "!" * 40,
            "WARNING: Session usage above 80%!",
            "!" * 40,
            "",
        ])
    
    lines.extend([
        "-" * 40,
        "ENTRY DETAILS",
        "-" * 40,
    ])
    
    for i, entry in enumerate(entries, 1):
        lines.append(f"  {i}. {entry.get('description', 'N/A')}: ${entry.get('amount', 0):.2f}")
    
    lines.extend([
        "",
        "-" * 40,
        f"Total from entries: ${metrics['calculated_spent']:.2f}",
        "=" * 60,
    ])
    
    return "\n".join(lines)


def generate_json_report(metrics: Dict[str, Any]) -> str:
    """Generate machine-readable JSON report."""
    report = {
        'report_type': 'tokenguard_session_summary',
        'version': '1.0',
        'marker': metrics['marker'],
        'generated_at': metrics['generated_at'],
        'metrics': {
            'limit': metrics['limit'],
            'spent': metrics['spent'],
            'remaining': metrics['remaining'],
            'usage_percentage': metrics['usage_percentage'],
            'entry_count': metrics['entry_count'],
            'calculated_spent': metrics['calculated_spent']
        },
        'alerts': {
            'is_warning': metrics['is_warning'],
            'threshold': 80,
            'message': 'Session usage above 80% of limit' if metrics['is_warning'] else None
        }
    }
    return json.dumps(report, indent=2)


def generate_markdown_report(metrics: Dict[str, Any], entries: List[Dict]) -> str:
    """Generate Markdown summary report."""
    warning_emoji = "⚠️" if metrics['is_warning'] else "✅"
    status = "⚠️ ABOVE 80%" if metrics['is_warning'] else "✅ OK"
    
    lines = [
        "# TokenGuard Session Report",
        "",
        f"**Marker:** `{metrics['marker']}`",
        f"**Generated:** {metrics['generated_at']}",
        "",
        "## 📊 Key Metrics",
        "",
        "| Metric | Value |",
        "|--------|-------|",
        f"| Limit | ${metrics['limit']:.2f} |",
        f"| Spent | ${metrics['spent']:.2f} |",
        f"| Remaining | ${metrics['remaining']:.2f} |",
        f"| Usage | {metrics['usage_percentage']:.1f}% |",
        f"| Entry Count | {metrics['entry_count']} |",
        "",
        f"## {warning_emoji} Status: {status}",
        "",
    ]
    
    if metrics['is_warning']:
        lines.extend([
            "> **Warning:** Session usage is above 80% of the configured limit.",
            "",
        ])
    
    lines.extend([
        "## 📝 Entry Details",
        "",
        "| # | Description | Amount |",
        "|---|-------------|--------|",
    ])
    
    for i, entry in enumerate(entries, 1):
        lines.append(f"| {i} | {entry.get('description', 'N/A')} | ${entry.get('amount', 0):.2f} |")
    
    lines.extend([
        "",
        f"**Total:** ${metrics['calculated_spent']:.2f}",
        "",
        "---",
        "*Generated by TokenGuard Reporting Utility*",
    ])
    
    return "\n".join(lines)


def main():
    """Main entry point for the reporting utility."""
    input_file = "session_input.json"
    
    if len(sys.argv) > 1:
        input_file = sys.argv[1]
    
    output_dir = Path.cwd()
    
    try:
        print(f"Loading session data from: {input_file}")
        data = load_session_data(input_file)
        
        metrics = calculate_metrics(data)
        
        text_report = generate_text_report(metrics, data['entries'])
        json_report = generate_json_report(metrics)
        markdown_report = generate_markdown_report(metrics, data['entries'])
        
        text_output = output_dir / "tokenguard_report.txt"
        json_output = output_dir / "tokenguard_report.json"
        md_output = output_dir / "tokenguard_summary.md"
        
        with open(text_output, 'w') as f:
            f.write(text_report)
        print(f"✓ Generated: {text_output}")
        
        with open(json_output, 'w') as f:
            f.write(json_report)
        print(f"✓ Generated: {json_output}")
        
        with open(md_output, 'w') as f:
            f.write(markdown_report)
        print(f"✓ Generated: {md_output}")
        
        print("\n" + "=" * 40)
        print("SUMMARY")
        print("=" * 40)
        print(f"Marker: {metrics['marker']}")
        print(f"Usage: {metrics['usage_percentage']:.1f}% ({metrics['spent']:.2f} / {metrics['limit']:.2f})")
        status_text = "⚠️ WARNING (above 80%)" if metrics['is_warning'] else "✅ OK"
        print(f"Status: {status_text}")
        print("=" * 40)
        
    except FileNotFoundError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)
    except json.JSONDecodeError as e:
        print(f"Error: Invalid JSON in input file: {e}", file=sys.stderr)
        sys.exit(1)
    except ValueError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
ENDOFSCRIPT

