    limit = float(session_data['limit'])
    spent = float(session_data['spent'])
    entries = session_data['entries']
    marker = session_data['marker']
    
    remaining = limit - spent
    usage_percentage = (spent / limit * 100) if limit > 0 else 0
    is_warning = usage_percentage > 80
    
    return {
        'limit': limit,
        'spent': spent,
        'remaining': remaining,
        'usage_percentage': round(usage_percentage, 2),
        'entry_count': len(entries),
        'entries': entries,
        'marker': marker,
        'is_warning': is_warning,
        'generated_at': datetime.utcnow().isoformat() + 'Z'
    }


def generate_human_readable_report(summary: dict) -> str:
