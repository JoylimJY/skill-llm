import argparse
import json
import os
import sys
from datetime import datetime
from pathlib import Path


def load_session_data(input_path: Path) -> dict:
    """Load and validate TokenGuard session data from JSON file."""
    if not input_path.exists():
        raise FileNotFoundError(f"Session input file not found: {input_path}")
    
    with open(input_path, 'r', encoding='utf-8') as f:
        data = json.load(f)
    
    # Validate required fields
    required_fields = ['limit', 'spent', 'entries', 'marker']
    for field in required_fields:
