#!/usr/bin/env python3
"""
TokenGuard Session Reporting Utility

This utility reads TokenGuard session data and generates:
- A human-readable report (stdout)
- A machine-readable JSON summary (output/report.json)

Usage:
    python tokenguard_report.py [--input FILE] [--output-dir DIR]
"""

import argparse
import json
import os
import sys
from datetime import datetime
from pathlib import Path


def load_session_data(input_path: Path) -> dict:
    """Load and validate TokenGuard session data from JSON file."""
    if not input_path.exists():
        raise FileNotFoundError(f"Session input file not found: {input_path}")
    
    with open(input_path, 'r', encoding='utf-8') as f:
        data = json.load(f)
    
    # Validate required fields
    required_fields = ['limit', 'spent', 'entries', 'marker']
    for field in required_fields:
        if field not in data:
            raise ValueError(f"Missing required field: {field}")
    
    return data


def calculate_session_summary(session_data: dict) -> dict:
    """Calculate session summary statistics."""
    limit = float(session_data['limit'])
    spent = float(session_data['spent'])
    entries = session_data['entries']
    marker = session_data['marker']
    
    remaining = limit - spent
    usage_percentage = (spent / limit * 100) if limit > 0 else 0
    is_warning = usage_percentage > 80
    
    return {
        'limit': limit,
        'spent': spent,
        'remaining': remaining,
        'usage_percentage': round(usage_percentage, 2),
        'entry_count': len(entries),
        'entries': entries,
        'marker': marker,
        'is_warning': is_warning,
        'generated_at': datetime.utcnow().isoformat() + 'Z'
    }


def generate_human_readable_report(summary: dict) -> str:
    """Generate a human-readable report string."""
    lines = []
    lines.append("=" * 60)
    lines.append("           TOKENGUARD SESSION REPORT")
    lines.append("=" * 60)
    lines.append("")
    lines.append(f"Reference Marker: {summary['marker']}")
    lines.append(f"Generated At: {summary['generated_at']}")
    lines.append("")
    lines.append("-" * 60)
    lines.append("BUDGET SUMMARY")
    lines.append("-" * 60)
    lines.append(f"  Limit:           ${summary['limit']:.2f}")
    lines.append(f"  Spent:           ${summary['spent']:.2f}")
    lines.append(f"  Remaining:       ${summary['remaining']:.2f}")
    lines.append(f"  Usage:           {summary['usage_percentage']:.1f}%")
    lines.append("")
    
    # Warning section
    if summary['is_warning']:
        lines.append("  ⚠️  WARNING: Session has exceeded 80% of the limit!")
        lines.append(f"  ⚠️  Only ${summary['remaining']:.2f} remaining from ${summary['limit']:.2f} limit")
    else:
        lines.append("  ✓ Status: Within normal usage limits")
    
    lines.append("")
    lines.append("-" * 60)
    lines.append(f"LOGGED ENTRIES ({summary['entry_count']} total)")
    lines.append("-" * 60)
    
    for i, entry in enumerate(summary['entries'], 1):
        lines.append(f"  {i}. ${entry['amount']:.2f} - {entry['description']}")
    
    lines.append("")
    lines.append("=" * 60)
    lines.append("                    END OF REPORT")
    lines.append("=" * 60)
    
    return "\n".join(lines)


def save_json_report(summary: dict, output_path: Path) -> None:
    """Save machine-readable JSON report."""
    output_path.parent.mkdir(parents=True, exist_ok=True)
    with open(output_path, 'w', encoding='utf-8') as f:
        json.dump(summary, f, indent=2)


def main():
    parser = argparse.ArgumentParser(
        description="TokenGuard Session Reporting Utility",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  python tokenguard_report.py
  python tokenguard_report.py --input custom_session.json
  python tokenguard_report.py --output-dir ./reports
        """
    )
    parser.add_argument(
        '--input', '-i',
        type=str,
        default='session_input.json',
        help='Path to TokenGuard session input JSON file (default: session_input.json)'
    )
    parser.add_argument(
        '--output-dir', '-o',
        type=str,
        default='output',
        help='Directory for output files (default: output)'
    )
    
    args = parser.parse_args()
    
    # Determine paths
    workspace = Path('.')
    input_path = workspace / args.input
    output_dir = workspace / args.output_dir
    json_output = output_dir / 'report.json'
    
    try:
        # Load session data
        session_data = load_session_data(input_path)
        
        # Calculate summary
        summary = calculate_session_summary(session_data)
        
        # Generate human-readable report
        report = generate_human_readable_report(summary)
        print(report)
        
        # Save JSON report
        save_json_report(summary, json_output)
        print(f"\nJSON report saved to: {json_output.absolute()}")
        
        # Exit with warning code if over 80%
        sys.exit(1 if summary['is_warning'] else 0)
        
    except FileNotFoundError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(2)
    except ValueError as e:
        print(f"Validation Error: {e}", file=sys.stderr)
        sys.exit(3)
    except json.JSONDecodeError as e:
        print(f"JSON Parse Error: {e}", file=sys.stderr)
        sys.exit(4)


if __name__ == '__main__':
    main()
