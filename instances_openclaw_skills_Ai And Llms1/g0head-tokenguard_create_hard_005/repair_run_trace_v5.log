script = '''#!/usr/bin/env python3
"""
TokenGuard Session Reporting Utility

A production-style utility that reads TokenGuard session data and generates
human-readable, machine-readable, and markdown reports summarizing session spending.
"""

import json
import sys
from datetime import datetime
from pathlib import Path
from typing import Any


def load_session_data(filepath: Path) -> dict[str, Any]:
    """Load and validate TokenGuard session data from JSON file."""
    if not filepath.exists():
        raise FileNotFoundError(f"Session input file not found: {filepath}")
    
    with open(filepath, 'r', encoding='utf-8') as f:
        data = json.load(f)
    
    required_fields = ['limit', 'spent', 'entries', 'marker']
    missing = [field for field in required_fields if field not in data]
    if missing:
        raise ValueError(f"Missing required fields: {', '.join(missing)}")
    
    return data


def calculate_metrics(data: dict[str, Any]) -> dict[str, Any]:
    """Calculate spending metrics from session data."""
    limit = float(data['limit'])
    spent = float(data['spent'])
    remaining = limit - spent
    percentage = (spent / limit * 100) if limit > 0 else 0
    entry_count = len(data['entries'])
    warning = percentage > 80
    
    return {
        'limit': limit,
        'spent': spent,
        'remaining': remaining,
        'percentage': round(percentage, 2),
        'entry_count': entry_count,
        'warning': warning,
        'marker': data['marker'],
        'timestamp': datetime.utcnow().isoformat() + 'Z'
    }


def generate_text_report(metrics: dict[str, Any], entries: list[dict]) -> str:
    """Generate human-readable text report."""
    lines = [
        "=" * 60,
        "TOKENGUARD SESSION SPENDING REPORT",
        "=" * 60,
        "",
        "Generated: " + metrics['timestamp'],
        "Reference Marker: " + metrics['marker'],
        "",
        "-" * 60,
        "BUDGET SUMMARY",
        "-" * 60,
        "  Limit:       ${:.2f}".format(metrics['limit']),
        "  Spent:       ${:.2f}".format(metrics['spent']),
        "  Remaining:   ${:.2f}".format(metrics['remaining']),
        "  Usage:       {:.1f}%".format(metrics['percentage']),
        "",
        "-" * 60,
        "ENTRY DETAILS",
        "-" * 60,
        "  Total Entries: {}".format(metrics['entry_count']),
        "",
    ]
    
    if entries:
        lines.append("  Individual Entries:")
        for i, entry in enumerate(entries, 1):
            lines.append("    {}. {}: ${:.2f}".format(i, entry.get('description', 'N/A'), entry.get('amount', 0)))
        lines.append("")
    
    if metrics['warning']:
        lines.extend([
            "!" * 60,
            "WARNING: Session spending exceeds 80% of limit!",
            "!" * 60,
            "",
        ])
    
    lines.extend([
        "=" * 60,
        "END OF REPORT",
        "=" * 60,
    ])
    
    return "\\n".join(lines)


def generate_json_report(metrics: dict[str, Any], entries: list[dict]) -> str:
    """Generate machine-readable JSON report."""
    report = {
        "report_type": "tokenguard_session_summary",
        "version": "1.0",
        "metadata": {
            "generated_at": metrics['timestamp'],
            "reference_marker": metrics['marker']
        },
        "budget": {
            "limit": metrics['limit'],
            "spent": metrics['spent'],
            "remaining": metrics['remaining'],
            "usage_percentage": metrics['percentage']
        },
        "statistics": {
            "total_entries": metrics['entry_count'],
            "average_per_entry": round(metrics['spent'] / metrics['entry_count'], 2) if metrics['entry_count'] > 0 else 0
        },
        "alerts": {
            "over_80_percent": metrics['warning'],
            "warning_threshold": 80
        },
        "entries": entries
    }
    
    return json.dumps(report, indent=2)


def generate_markdown_report(metrics: dict[str, Any], entries: list[dict]) -> str:
    """Generate Markdown summary report."""
    status_icon = "WARNING" if metrics['warning'] else "OK"
    status_text = "WARNING: Above 80% threshold" if metrics['warning'] else "Within budget"
    
    lines = [
        "# TokenGuard Session Summary",
        "",
        "**Reference Marker:** `{}`".format(metrics['marker']),
        "**Generated:** {}".format(metrics['timestamp']),
        "",
        "## Key Metrics",
        "",
        "| Metric | Value |",
        "|--------|-------|",
        "| Budget Limit | ${:.2f} |".format(metrics['limit']),
        "| Amount Spent | ${:.2f} |".format(metrics['spent']),
        "| Remaining | ${:.2f} |".format(metrics['remaining']),
        "| Usage Percentage | {:.1f}% |".format(metrics['percentage']),
        "| Total Entries | {} |".format(metrics['entry_count']),
        "",
        "## Status: {}".format(status_text),
        "",
        "### Entry Breakdown",
        "",
        "| # | Description | Amount |",
        "|---|-------------|--------|",
    ]
    
    for i, entry in enumerate(entries, 1):
        desc = entry.get('description', 'N/A')
        amount = entry.get('amount', 0)
        lines.append("| {} | {} | ${:.2f} |".format(i, desc, amount))
    
    lines.extend([
        "",
        "---",
        "",
        "*Report generated by TokenGuard Reporting Utility*",
    ])
    
    return "\\n".join(lines)


def write_report(content: str, filepath: Path, encoding: str = 'utf-8') -> None:
    """Write report content to file."""
    with open(filepath, 'w', encoding=encoding) as f:
        f.write(content)
    print("  [OK] Written: {}".format(filepath))


def main(input_file=None):
    """Main entry point for the reporting utility."""
    workspace = Path(__file__).parent.resolve()
    
    if input_file is None:
        input_path = workspace / "session_input.json"
    else:
        input_path = Path(input_file)
        if not input_path.is_absolute():
            input_path = workspace / input_file
    
    print("TokenGuard Reporting Utility")
    print("=" * 40)
    print("Input file: {}".format(input_path))
    print()
    
    try:
        print("Loading session data...")
        data = load_session_data(input_path)
        print("  [OK] Loaded: {}".format(data['marker']))
        
        print("Calculating metrics...")
        metrics = calculate_metrics(data)
        status = "WARNING" if metrics['warning'] else "OK"
        print("  [OK] Usage: {:.1f}% ({})".format(metrics['percentage'], status))
        
        print()
        print("Generating reports...")
        
        text_report = generate_text_report(metrics, data['entries'])
        write_report(text_report, workspace / "tokenguard_report.txt")
        
        json_report = generate_json_report(metrics, data['entries'])
        write_report(json_report, workspace / "tokenguard_report.json")
        
        md_report = generate_markdown_report(metrics, data['entries'])
        write_report(md_report, workspace / "tokenguard_summary.md")
        
        print()
        print("=" * 40)
        print("Report generation complete!")
        return 0
        
    except FileNotFoundError as e:
        print("Error: {}".format(e), file=sys.stderr)
        return 1
    except json.JSONDecodeError as e:
        print("Error: Invalid JSON in input file: {}".format(e), file=sys.stderr)
        return 1
    except ValueError as e:
        print("Error: {}".format(e), file=sys.stderr)
        return 1
    except Exception as e:
        print("Error: Unexpected error: {}".format(e), file=sys.stderr)
        return 1


if __name__ == "__main__":
    input_file = sys.argv[1] if len(sys.argv) > 1 else None
    sys.exit(main(input_file))
'''

with open('/workspace/tokenguard_report.py', 'w') as f:
    f.write(script)
print("Script written successfully")

