import json
from datetime import datetime

# Read the conversation logs
with open('/workspace/conversations.json', 'r') as f:
    conversations = json.load(f)

# Extract entities from conversations
entities = {
    "projects": ["Project Orion", "Percept"],
    "people": ["Avery", "Jordan", "Nina", "Marco"],
    "organizations": ["Northstar Labs"],
    "technologies": ["SQLite", "LanceDB"],
    "resources": ["dashboard"],
    "timestamps": ["Friday"]
}

# Extract relationships
relationships = [
    {"subject": "Avery", "predicate": "works_on", "object": "Project Orion"},
    {"subject": "Marco", "predicate": "works_with", "object": "Avery"},
    {"subject": "Marco", "predicate": "works_on", "object": "Project Orion"},
    {"subject": "Northstar Labs", "predicate": "is_client_of", "object": "Project Orion"},
    {"subject": "Nina", "predicate": "informed_about", "object": "Project Orion"},
    {"subject": "dashboard", "predicate": "runs_on_port", "object": "8960"},
    {"subject": "Project Orion", "predicate": "deadline_is", "object": "Friday"},
    {"subject": "Project Orion", "predicate": "stores_data_in", "object": "SQLite"},
    {"subject": "Project Orion", "predicate": "stores_data_in", "object": "LanceDB"},
    {"subject": "Northstar Labs", "predicate": "approved", "object": "privacy settings update"}
]

# Create the ambient context pack summary
context_pack = {
    "summary": {
        "topic": "Project Orion development with Northstar Labs client",
        "key_points": [
            "Deadline is Friday",
            "Privacy settings update approved by Northstar Labs",
            "Local storage using SQLite and LanceDB",
            "Dashboard accessible on port 8960",
            "Team: Avery, Marco, Jordan, Nina"
        ],
        "generated_at": datetime.utcnow().isoformat() + "Z"
    },
    "latest_conversations": conversations[-3:],
    "entities": entities,
    "relationships": relationships,
    "history": {
        "conversation_count": len(conversations),
        "date_range": {
            "start": conversations[0]["timestamp"],
            "end": conversations[-1]["timestamp"]
        },
        "participants": list(set(c["speaker"] for c in conversations))
    }
}

# Write the output
with open('/workspace/output.json', 'w') as f:
    json.dump(context_pack, f, indent=2)

print("output.json created successfully")

