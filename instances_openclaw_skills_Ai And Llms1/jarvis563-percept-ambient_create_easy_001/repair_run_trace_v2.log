import json

# Read the conversation logs
with open('/workspace/conversations.json', 'r') as f:
    conversations = json.load(f)

# Extract entities
entities = {
    "people": ["Avery", "Jordan", "Nina", "Marco"],
    "projects": ["Project Orion"],
    "organizations": ["Northstar Labs"],
    "systems": ["Percept", "SQLite", "LanceDB"],
    "technical": ["dashboard", "port 8960"],
    "deadlines": ["Friday"]
}

# Extract relationships
relationships = [
    {"subject": "Avery", "relation": "works_on", "object": "Project Orion"},
    {"subject": "Marco", "relation": "works_with", "object": "Avery"},
    {"subject": "Marco", "relation": "works_on", "object": "Project Orion"},
    {"subject": "Nina", "relation": "informed", "object": "Northstar Labs is client"},
    {"subject": "Northstar Labs", "relation": "approved", "object": "privacy settings update"},
    {"subject": "dashboard", "relation": "runs_on", "object": "port 8960"},
    {"subject": "Project Orion", "relation": "deadline", "object": "Friday"}
]

# Create compact context summary
context_pack = {
    "summary": {
        "topic": "Project Orion development for Northstar Labs client",
        "key_points": [
            "Client: Northstar Labs",
            "Team: Avery, Marco",
            "Deadline: Friday",
            "Tech stack: SQLite, LanceDB (local storage)",
            "Dashboard: port 8960"
        ]
    },
    "entities": entities,
    "relationships": relationships,
    "recent_conversations": [
        {
            "id": c["id"],
            "speaker": c["speaker"],
            "text": c["text"],
            "timestamp": c["timestamp"]
        }
        for c in conversations[-3:]  # Latest 3 conversations
    ],
    "metadata": {
        "total_messages": len(conversations),
        "date_range": {
            "start": conversations[0]["timestamp"],
            "end": conversations[-1]["timestamp"]
        }
    }
}

# Write output
with open('/workspace/output.json', 'w') as f:
    json.dump(context_pack, f, indent=2)

print("Created output.json successfully")

