cat > /workspace/rv-measure << 'EOF'
#!/usr/bin/env python3
"""
rv-measure: Analyzes recursive self-observation traces and reports R_V contraction summary.
"""

import json
import os
import re
import sys
from pathlib import Path


def extract_marker(content):
    """Extract the RV-TRACE MARKER from file content."""
    match = re.search(r'#\s*RV-TRACE\s+MARKER:\s*(\S+)', content)
    if match:
        return match.group(1)
    return None


def extract_contraction_values(content):
    """Extract contraction values from file content, handling different formats."""
    values = []
    
    for line in content.strip().split('\n'):
        if line.startswith('#'):
            continue
        
        # Try to find contraction or shrink values
        # Format 1: contraction=X or contraction: X
        # Format 2: shrink=X or shrink: X
        
        # Match patterns like: contraction=0.12, contraction: 0.08, shrink=0.05
        contraction_match = re.search(r'contraction[=:]\s*([\d.]+)', line, re.IGNORECASE)
        shrink_match = re.search(r'shrink[=:]\s*([\d.]+)', line, re.IGNORECASE)
        
        if contraction_match:
            values.append(float(contraction_match.group(1)))
        elif shrink_match:
            values.append(float(shrink_match.group(1)))
    
    return values


def calculate_contraction_score(values):
    """Calculate the contraction score from a list of values."""
    if not values:
        return 0.0
    return sum(values) / len(values)


def analyze_trace_file(filepath):
    """Analyze a single trace file and return its metrics."""
    with open(filepath, 'r', encoding='utf-8') as f:
        content = f.read()
    
    marker = extract_marker(content)
    contraction_values = extract_contraction_values(content)
    score = calculate_contraction_score(contraction_values)
    
    return {
        'marker': marker,
        'contraction_values': contraction_values,
        'score': round(score, 6)
    }


def main():
    # Determine input directory
    script_dir = Path(__file__).parent.resolve()
    input_dir = script_dir / 'inputs'
    
    if not input_dir.exists():
        print(f"Error: Input directory {input_dir} does not exist", file=sys.stderr)
        sys.exit(1)
    
    # Read manifest for expected markers
    manifest_path = script_dir / 'inputs_manifest.json'
    expected_markers = []
    if manifest_path.exists():
        with open(manifest_path, 'r', encoding='utf-8') as f:
            manifest = json.load(f)
            expected_markers = manifest.get('expected_markers', [])
    
    # Find all trace files in inputs directory
    trace_files = sorted([f for f in input_dir.iterdir() if f.is_file() and f.suffix == '.txt'])
    
    # Analyze each file
    file_results = {}
    markers_found = []
    all_scores = []
    
    for filepath in trace_files:
        result = analyze_trace_file(filepath)
        file_results[filepath.name] = {
            'marker': result['marker'],
            'score': result['score'],
            'value_count': len(result['contraction_values'])
        }
        if result['marker']:
            markers_found.append(result['marker'])
        all_scores.append(result['score'])
    
    # Calculate overall score
    overall_score = sum(all_scores) / len(all_scores) if all_scores else 0.0
    
    # Check marker confirmation
    marker_confirmation = {}
    for marker in expected_markers:
        marker_confirmation[marker] = marker in markers_found
    
    # Generate conclusion
    if all(marker_confirmation.values()) and len(markers_found) == len(expected_markers):
        conclusion = "All expected markers confirmed. R_V contraction analysis complete."
    else:
        missing = [m for m in expected_markers if m not in markers_found]
        conclusion = f"Marker verification incomplete. Missing: {missing}"
    
    # Build output report
    report = {
        'input_file_count': len(trace_files),
        'marker_confirmation': marker_confirmation,
        'per_file_scores': file_results,
        'overall_score': round(overall_score, 6),
        'conclusion': conclusion
    }
    
    # Write output
    output_path = script_dir / 'output.json'
    with open(output_path, 'w', encoding='utf-8') as f:
        json.dump(report, f, indent=2)
    
    print(f"Analysis complete. Output written to {output_path}")
    return 0


if __name__ == '__main__':
    sys.exit(main())
