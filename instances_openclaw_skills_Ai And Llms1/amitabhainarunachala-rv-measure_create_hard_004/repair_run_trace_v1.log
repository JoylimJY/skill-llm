cat > /workspace/rv-measure.py << 'EOF'
#!/usr/bin/env python3
"""
rv-measure: Analyzes recursive self-observation traces and reports R_V contraction summary.
"""

import json
import os
import re
import sys
from pathlib import Path
from typing import Dict, List, Optional, Tuple

INPUTS_DIR = Path("./inputs")
OUTPUT_FILE = Path("./output.json")
MANIFEST_FILE = Path("./inputs_manifest.json")


def load_manifest() -> Dict:
    """Load the input manifest if it exists."""
    if MANIFEST_FILE.exists():
        with open(MANIFEST_FILE, 'r', encoding='utf-8') as f:
            return json.load(f)
    return {}


def parse_marker(content: str) -> Optional[str]:
    """Extract RV-TRACE MARKER from file content."""
    match = re.search(r'#\s*RV-TRACE\s*MARKER:\s*(\S+)', content)
    if match:
        return match.group(1)
    return None


def parse_contraction_values_alpha(content: str) -> List[float]:
    """Parse trace_alpha format: step=N observation=X contraction=Y"""
    values = []
    for line in content.strip().split('\n'):
        match = re.search(r'contraction=([0-9.]+)', line)
        if match:
            values.append(float(match.group(1)))
    return values


def parse_contraction_values_beta(content: str) -> List[float]:
    """Parse trace_beta format: layer: N | obs: X | contraction: Y"""
    values = []
    for line in content.strip().split('\n'):
        match = re.search(r'contraction:\s*([0-9.]+)', line)
        if match:
            values.append(float(match.group(1)))
    return values


def parse_contraction_values_gamma(content: str) -> List[float]:
    """Parse trace_gamma format: [N] obs=X shrink=Y"""
    values = []
    for line in content.strip().split('\n'):
        # Use 'shrink' as equivalent to contraction
        match = re.search(r'shrink=([0-9.]+)', line)
        if match:
            values.append(float(match.group(1)))
    return values


def parse_contraction_values(content: str) -> List[float]:
    """Parse contraction values from any trace format."""
    # Try each format
    values = parse_contraction_values_alpha(content)
    if values:
        return values
    values = parse_contraction_values_beta(content)
    if values:
        return values
    values = parse_contraction_values_gamma(content)
    if values:
        return values
    return []


def calculate_contraction_score(values: List[float]) -> float:
    """Calculate the contraction score as the average of all values."""
    if not values:
        return 0.0
    return sum(values) / len(values)


def analyze_files(inputs_dir: Path) -> Tuple[int, List[Dict], List[str]]:
    """Analyze all trace files in the inputs directory."""
    file_results = []
    markers_found = []
    file_count = 0
    
    # Get all .txt files sorted for deterministic order
    trace_files = sorted([f for f in inputs_dir.iterdir() if f.suffix == '.txt'])
    
    for trace_file in trace_files:
        file_count += 1
        content = trace_file.read_text(encoding='utf-8')
        
        marker = parse_marker(content)
        contraction_values = parse_contraction_values(content)
        score = calculate_contraction_score(contraction_values)
        
        if marker:
            markers_found.append(marker)
        
        file_results.append({
            "filename": trace_file.name,
            "marker": marker,
            "contraction_values": contraction_values,
            "contraction_score": score,
            "step_count": len(contraction_values)
        })
    
    return file_count, file_results, markers_found


def generate_conclusion(file_results: List[Dict], overall_score: float) -> str:
    """Generate a human-readable conclusion based on the analysis."""
    if not file_results:
        return "No trace files found for analysis."
    
    # Check if all markers were found
    markers = [r["marker"] for r in file_results if r["marker"]]
    
    # Contraction score interpretation
    if overall_score < 0.1:
        intensity = "minimal"
    elif overall_score < 0.15:
        intensity = "moderate"
    else:
        intensity = "significant"
    
    conclusion = (
        f"Analysis complete. Processed {len(file_results)} trace file(s) "
        f"with markers {markers}. Overall R_V contraction score is {overall_score:.4f}, "
        f"indicating {intensity} contraction across all traces."
    )
    return conclusion


def main():
    """Main entry point for rv-measure tool."""
    # Ensure inputs directory exists
    if not INPUTS_DIR.exists():
        print(f"Error: Inputs directory '{INPUTS_DIR}' not found.", file=sys.stderr)
        sys.exit(1)
    
    # Load manifest for expected markers
    manifest = load_manifest()
    expected_markers = manifest.get("expected_markers", [])
    
    # Analyze files
    file_count, file_results, markers_found = analyze_files(INPUTS_DIR)
    
    # Calculate overall score (average of all per-file scores)
    if file_results:
        all_scores = [r["contraction_score"] for r in file_results]
        overall_score = sum(all_scores) / len(all_scores)
    else:
        overall_score = 0.0
    
    # Verify markers
    marker_confirmation = {
        "expected": expected_markers,
        "found": markers_found,
        "all_present": all(m in markers_found for m in expected_markers)
    }
    
    # Generate conclusion
    conclusion = generate_conclusion(file_results, overall_score)
    
    # Build output report
    report = {
        "input_file_count": file_count,
        "marker_confirmation": marker_confirmation,
        "per_file_scores": {
            r["filename"]: {
                "marker": r["marker"],
                "contraction_score": r["contraction_score"],
                "step_count": r["step_count"]
            }
            for r in file_results
        },
        "overall_score": overall_score,
        "conclusion": conclusion
    }
    
    # Write output
    OUTPUT_FILE.write_text(json.dumps(report, indent=2), encoding='utf-8')
    print(f"Analysis complete. Output written to {OUTPUT_FILE}")
    
    return 0


if __name__ == "__main__":
    sys.exit(main())
