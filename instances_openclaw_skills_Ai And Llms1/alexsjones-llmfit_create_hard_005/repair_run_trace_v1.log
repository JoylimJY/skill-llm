        "unified_memory": system["unified_memory"]
    },
    "recommendations": {
        "coding": {
            "primary": {
                "name": coding_models[0]["name"],
                "provider": coding_models[0]["provider"],
                "params_b": coding_models[0]["params_b"],
                "best_quant": coding_models[0]["best_quant"],
                "estimated_tps": coding_models[0]["estimated_tps"],
                "memory_gb": coding_models[0]["memory_required_gb"],
                "context_length": coding_models[0]["context_length"],
                "score": coding_models[0]["score"]
            },
            "alternative": {
                "name": coding_models[1]["name"],
                "provider": coding_models[1]["provider"],
                "params_b": coding_models[1]["params_b"],
                "best_quant": coding_models[1]["best_quant"],
                "estimated_tps": coding_models[1]["estimated_tps"],
                "memory_gb": coding_models[1]["memory_required_gb"],
                "context_length": coding_models[1]["context_length"],
                "score": coding_models[1]["score"]
            }
        },
        "chat": {
            "primary": {
                "name": chat_models[0]["name"],
                "provider": chat_models[0]["provider"],
                "params_b": chat_models[0]["params_b"],
                "best_quant": chat_models[0]["best_quant"],
                "estimated_tps": chat_models[0]["estimated_tps"],
                "memory_gb": chat_models[0]["memory_required_gb"],
                "context_length": chat_models[0]["context_length"],
                "score": chat_models[0]["score"]
            }
        }
    },
    "configuration": {
        "ollama": {
            "install_command": "brew install --cask ollama",
            "pull_commands": [
                "ollama pull qwen2.5-coder:7b",
