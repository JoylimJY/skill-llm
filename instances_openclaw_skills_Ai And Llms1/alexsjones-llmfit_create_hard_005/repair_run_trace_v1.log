            ],
            "run_commands": {
                "coding": "ollama run qwen2.5-coder:7b",
                "chat": "ollama run llama3.1:8b"
            }
        },
        "lm_studio": {
            "download_url": "https://lmstudio.ai/",
            "settings": {
                "gpu_offloading": "Metal (MPS)",
                "recommended_quant": "Q6_K_M",
                "context_size_coding": 32768,
                "context_size_chat": 16384,
                "threads": 12
            }
        }
    },
    "performance_summary": {
        "can_run_simultaneously": "Two 7B-8B models (~16GB total)",
        "recommended_strategy": "Keep one coding + one chat model loaded"
    },
    "markers": {
        "system_marker": system["marker"],
        "rec_marker": recs_data["marker"]
    }
}

# Write automation JSON
json_path = workspace / 'llm_recommendation_report.json'
