recs_data = json.loads((workspace / 'recommendations.json').read_text())

system = system_data['system']
models = recs_data['models']

# Separate models by use case
coding_models = [m for m in models if m['use_case'] == 'coding']
chat_models = [m for m in models if m['use_case'] == 'chat']

# Sort by score
