[EXECUTING python]:
import json

# Read input files
with open('/workspace/system.json', 'r') as f:
    system = json.load(f)

with open('/workspace/recommendations.json', 'r') as f:
    recommendations = json.load(f)

sys_info = system['system']
models = recommendations['models']

# Create the output structure
output = {
    "summary": {
        "hardware": f"{sys_info['cpu_name']} ({sys_info['cpu_cores']} cores), {sys_info['gpu_name']} GPU",
        "memory": f"{sys_info['total_ram_gb']}GB total ({sys_info['available_ram_gb']}GB available), {sys_info['gpu_vram_gb']}GB VRAM, {sys_info['unified_memory'] and 'Unified' or 'Discrete'} Memory Architecture",
        "notes": f"Apple Silicon M2 Max with Metal backend, unified memory allows flexible resource allocation between CPU and GPU"
    },
    "recommendations": [
        {
            "name": "Qwen/Qwen2.5-Coder-7B-Instruct",
            "use_case": "coding",
            "reason": "Highest overall score (96) with perfect fit for this hardware. 7B params require only 7.8GB memory (24.4% utilization), delivering 42.1 tokens/sec. Best quantization: Q6_K_M."
        },
        {
            "name": "meta-llama/Llama-3.1-8B-Instruct",
            "use_case": "chat",
            "reason": "Excellent chat model with score 94 and perfect fit. 8B params use 8.4GB memory (26.2% utilization) at 39.5 tokens/sec. Large 128K context window. Best quantization: Q6_K_M."
        }
    ],
    "config": {
        "ollama": {
            "gpu_layers": -1,
            "num_ctx": 32768,
            "num_thread": 12,
            "keep_alive": 300,
            "notes": "Run with: ollama run qwen2.5-coder:7b or ollama run llama3.1:8b"
        },
        "lmstudio": {
            "device": "metal",
            "gpu_layers": 35,
            "context_size": 32768,
            "main_gpu": 0,
            "flash_attention": True,
            "notes": "Enable Metal acceleration, set GPU layers to max for unified memory systems"
        }
    }
}

# Write output
with open('/workspace/output.json', 'w') as f:
    json.dump(output, f, indent=2)

print("output.json created successfully!")

