import json

# Read input files
with open('/workspace/system.json', 'r') as f:
    system_data = json.load(f)

with open('/workspace/recommendations.json', 'r') as f:
    rec_data = json.load(f)

sys = system_data['system']
models = rec_data['models']

# Find coding and chat models
coding_models = [m for m in models if m['use_case'] == 'coding']
chat_models = [m for m in models if m['use_case'] == 'chat']

# Select top coding model (highest score)
top_coding = max(coding_models, key=lambda x: x['score'])
# Select top chat model
top_chat = max(chat_models, key=lambda x: x['score'])

# Build output
output = {
    "summary": {
        "hardware": f"Apple M2 Max (12-core CPU, integrated GPU with Metal backend)",
        "memory": f"32GB unified memory (24.5GB available)",
        "notes": "Apple Silicon with unified memory architecture enables efficient GPU-accelerated inference via Metal. Both recommended models fit comfortably in available memory with ~24-26% utilization."
    },
    "recommendations": [
        {
            "name": top_coding['name'],
            "use_case": "coding",
            "reason": f"Top-scoring coding model (score: {top_coding['score']}) with {top_coding['params_b']}B parameters. Runs at ~{top_coding['estimated_tps']} tokens/sec with {top_coding['best_quant']} quantization. Uses only {top_coding['utilization_pct']}% of available memory."
        },
        {
            "name": top_chat['name'],
            "use_case": "chat",
            "reason": f"Best chat model (score: {top_chat['score']}) with {top_chat['params_b']}B parameters and {top_chat['context_length']} context length. Runs at ~{top_chat['estimated_tps']} tokens/sec with {top_chat['best_quant']} quantization."
        }
    ],
    "config": {
        "ollama": {
            "model": "qwen2.5-coder:7b",
            "parameters": {
                "num_ctx": 32768,
                "num_gpu": 1,
                "num_thread": 12,
                "memory": "32GB"
            },
            "command": "ollama run qwen2.5-coder:7b"
        },
        "lmstudio": {
            "backend": "Metal",
            "gpu_layers": -1,
            "context_size": 32768,
            "threads": 12,
            "recommended_model": "Qwen/Qwen2.5-Coder-7B-Instruct-GGUF",
            "quantization": "Q6_K_M"
        }
    }
}

# Write output
with open('/workspace/output.json', 'w') as f:
    json.dump(output, f, indent=2)

print("output.json created successfully!")
print(json.dumps(output, indent=2))

