[EXECUTING bash]:
python3 << 'EOF'
import pytesseract
from PIL import Image
import json
import re

# Load the screenshot
img = Image.open('/workspace/screenshot.png')

# Get OCR data with coordinates
data = pytesseract.image_to_data(img, output_type=pytesseract.Output.DICT)

# Find title (first large text at top)
title_match = None
title_coords = None
for i in range(len(data['text'])):
    text = data['text'][i].strip()
    if text in ['Finance', 'Dashboard']:
        if title_match is None:
            title_match = text
            title_coords = [data['left'][i], data['top'][i]]
        elif text == 'Dashboard' and title_match == 'Finance':
            title_match = "Finance Dashboard"
            break

# Find balance (numeric value after "Balance:")
balance_match = None
balance_coords = None
for i in range(len(data['text'])):
    text = data['text'][i].strip()
    if text == 'Balance:':
        # Look for the next numeric value
        for j in range(i+1, min(i+5, len(data['text']))):
            if re.match(r'^\d+$', data['text'][j].strip()):
                balance_match = data['text'][j].strip()
                balance_coords = [data['left'][j], data['top'][j]]
                break
        break

# Find alerts counter
alerts_match = None
alerts_coords = None
for i in range(len(data['text'])):
    text = data['text'][i].strip()
    if text == 'Alerts':
        # Look for the number nearby
        for j in range(i, min(i+3, len(data['text']))):
            if re.match(r'^\d+$', data['text'][j].strip()) and len(data['text'][j].strip()) <= 2:
                alerts_match = data['text'][j].strip()
                alerts_coords = [data['left'][j], data['top'][j]]
                break
        break

# Create the output JSON
output = {
    "title": {
        "text": title_match,
        "coordinates": title_coords
    },
    "balance": {
        "text": balance_match,
        "coordinates": balance_coords
    },
    "alerts": {
        "text": alerts_match,
        "coordinates": alerts_coords
    }
}

# Save to file
with open('/workspace/output.json', 'w') as f:
    json.dump(output, f, indent=2)

print("Output saved to /workspace/output.json")
print(json.dumps(output, indent=2))
EOF

