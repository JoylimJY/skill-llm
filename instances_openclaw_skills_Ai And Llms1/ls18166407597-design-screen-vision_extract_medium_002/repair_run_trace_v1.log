import pytesseract
from PIL import Image
import json
import re

# Load the screenshot
img = Image.open('/workspace/screenshot.png')

# Get full text with data (including coordinates)
data = pytesseract.image_to_data(img, output_type=pytesseract.Output.DICT)

# Get full text for analysis
full_text = pytesseract.image_to_string(img)

print("Full OCR text:")
print(full_text)
print("\n" + "="*50)

# Analyze text to find title, balances, and counters
lines = full_text.strip().split('\n')

# Find title (usually first prominent line)
title = None
title_coords = None

# Find numeric values that look like balances or counters
balances = []
counters = []

# Parse individual text elements with coordinates
texts = data['text']
lefts = data['left']
tops = data['top']
widths = data['width']
heights = data['height']

for i, text in enumerate(texts):
    text = text.strip()
    if not text:
        continue
    
    # Check for title-like text (uppercase, prominent)
    if text.upper() == text and len(text) > 5 and not text.replace(' ', '').isdigit():
        if 'FINANCE' in text.upper() or 'DASHBOARD' in text.upper() or 'TITLE' in text.upper():
            title = text
            title_coords = (lefts[i], tops[i])
            break
    
    # Check for numeric values (balances - decimal numbers)
    if re.match(r'^\d+\.\d+$', text):
        balances.append({'value': text, 'coords': (lefts[i], tops[i])})
    
    # Check for single digit counters
    if re.match(r'^\d$', text) or re.match(r'^\d{1,2}$', text):
        counters.append({'value': text, 'coords': (lefts[i], tops[i])})

print(f"Found title: {title} at {title_coords}")
print(f"Found balances: {balances}")
print(f"Found counters: {counters}")

# Create the summary report
report = {
    "main_title": title if title else "Unknown",
    "title_coords": list(title_coords) if title_coords else None,
    "balances": [{"value": b['value'], "coords": list(b['coords'])} for b in balances],
    "counters": [{"value": c['value'], "coords": list(c['coords'])} for c in counters],
    "raw_text": full_text.strip()
}

# Save the report
with open('/workspace/ocr_summary.json', 'w') as f:
    json.dump(report, f, indent=2)

print("\nReport saved to /workspace/ocr_summary.json")
EOF

