lefts = data['left']
tops = data['top']
widths = data['width']
heights = data['height']

title = None
title_coords = None
balances = []
counters = []

# First pass - find title by looking at the raw text and matching to coordinates
title_text = "Finance Dashboard"
for i, text in enumerate(texts):
    text_stripped = text.strip()
    if 'Finance' in text_stripped or 'Dashboard' in text_stripped:
        if title is None:
            title = text_stripped
            title_coords = (lefts[i], tops[i])
            break

# Second pass - find balances (look for decimal numbers or numbers near "Balance")
balance_value = None
balance_coords = None
for i, text in enumerate(texts):
    text_stripped = text.strip()
    # Check for decimal pattern
    if re.match(r'^\d+\.\d+$', text_stripped):
        balance_value = text_stripped
        balance_coords = (lefts[i], tops[i])
        break
    # Check for "Balance" label to get nearby numbers
    if 'Balance' in text_stripped:
        # Look at next few texts for a number
        for j in range(i+1, min(i+5, len(texts))):
            next_text = texts[j].strip()
            if re.match(r'^\d+', next_text):
                balance_value = next_text
                balance_coords = (lefts[j], tops[j])
                break
        if balance_value:
            break

# Third pass - find counters (small numbers near "Alerts")
counter_value = None
counter_coords = None
for i, text in enumerate(texts):
    text_stripped = text.strip()
    if 'Alerts' in text_stripped or 'Unread' in text_stripped:
        # Look for a number nearby
        for j in range(i, min(i+5, len(texts))):
            next_text = texts[j].strip()
            if re.match(r'^\d{1,2}$', next_text) and int(next_text) < 100:
                counter_value = next_text
                counter_coords = (lefts[j], tops[j])
                break
        if counter_value:
            break

# Build the concise report
report = {
