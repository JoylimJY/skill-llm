python3 << 'EOF'
import pytesseract
from PIL import Image
import json
import re

# Load the screenshot
img = Image.open('/workspace/screenshot.png')

# Get full text with data (including coordinates)
data = pytesseract.image_to_data(img, output_type=pytesseract.Output.DICT)

# Get full text for analysis
full_text = pytesseract.image_to_string(img)

# Parse individual text elements with coordinates
texts = data['text']
lefts = data['left']
tops = data['top']
widths = data['width']
heights = data['height']

# Find title - combine nearby texts on same line
title = None
title_coords = None

# Group texts by line (similar y-coordinate)
line_threshold = 10
lines = []
for i in range(len(texts)):
    text = texts[i].strip()
    if not text:
        continue
    
    found_line = False
    for line in lines:
        if abs(line['y'] - tops[i]) < line_threshold:
            line['texts'].append((lefts[i], text))
            line['y'] = tops[i]
            found_line = True
            break
    
    if not found_line:
        lines.append({'y': tops[i], 'texts': [(lefts[i], text)]})

# Sort lines by y-coordinate and find title line
lines.sort(key=lambda x: x['y'])

for line in lines:
    # Sort texts in line by x-coordinate
    line['texts'].sort(key=lambda x: x[0])
    line_text = ' '.join([t[1] for t in line['texts']])
    
    if 'Finance' in line_text and 'Dashboard' in line_text:
        title = line_text
        title_coords = (line['texts'][0][0], line['y'])
        break

# Find balance - look for decimal number or number near "Balance"
balance_value = None
balance_coords = None

for i, text in enumerate(texts):
    text_stripped = text.strip()
    # Check for decimal pattern
    if re.match(r'^\d+\.\d+$', text_stripped):
        balance_value = text_stripped
        balance_coords = (lefts[i], tops[i])
        break
    
    # Check for large number (4+ digits) which might be a balance
    if re.match(r'^\d{4,}$', text_stripped):
        balance_value = text_stripped
        balance_coords = (lefts[i], tops[i])

# Find counter - small number near "Alerts"
counter_value = None
counter_coords = None

for i, text in enumerate(texts):
    text_stripped = text.strip()
    if 'Alerts' in text_stripped or 'Unread' in text_stripped:
        # Look for a small number nearby
        for j in range(max(0, i-2), min(i+5, len(texts))):
            next_text = texts[j].strip()
            if re.match(r'^\d{1,2}$', next_text) and int(next_text) < 100:
                counter_value = next_text
                counter_coords = (lefts[j], tops[j])
                break
        if counter_value:
            break

# Build the concise report
report = {
    "main_title": title if title else "Unknown",
    "title_coords": list(title_coords) if title_coords else None,
    "balance": balance_value,
    "balance_coords": list(balance_coords) if balance_coords else None,
    "counter": counter_value,
    "counter_coords": list(counter_coords) if counter_coords else None
}

# Save the report
with open('/workspace/ocr_summary.json', 'w') as f:
    json.dump(report, f, indent=2)

print("Final OCR Summary Report:")
print(json.dumps(report, indent=2))
EOF

