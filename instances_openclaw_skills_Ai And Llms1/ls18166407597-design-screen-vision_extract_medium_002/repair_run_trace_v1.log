python3 << 'EOF'
import pytesseract
from PIL import Image
import json
import re

# Load the screenshot
img = Image.open('/workspace/screenshot.png')

# Get full text with data (including coordinates)
data = pytesseract.image_to_data(img, output_type=pytesseract.Output.DICT)

# Get full text for analysis
full_text = pytesseract.image_to_string(img)

# Parse individual text elements with coordinates
texts = data['text']
lefts = data['left']
tops = data['top']
widths = data['width']
heights = data['height']

title = None
title_coords = None
balances = []
counters = []

for i, text in enumerate(texts):
    text = text.strip()
    if not text:
        continue
    
    # Check for title-like text
    if 'Finance Dashboard' in text or 'finance dashboard' in text.lower():
        title = text.replace('\n', ' ').strip()
        title_coords = (lefts[i], tops[i])
        break

# Second pass for balance
for i, text in enumerate(texts):
    text = text.strip()
    if not text:
        continue
    # Look for decimal number pattern (balance)
    if re.match(r'^\d+\.\d+$', text):
        balances.append({'value': text, 'coords': (lefts[i], tops[i])})
    # Also check for numbers with space before decimal (OCR might split)
    if re.match(r'^\d+$', text) and len(text) >= 4:
        # Check if previous/next text has decimal part
        balances.append({'value': text, 'coords': (lefts[i], tops[i])})

# Check for counters (small single/double digit numbers)
for i, text in enumerate(texts):
    text = text.strip()
    if not text:
        continue
    if re.match(r'^\d{1,2}$', text) and int(text) < 100:
        # Check if it's near "Alerts" or "Unread"
        counters.append({'value': text, 'coords': (lefts[i], tops[i])})

# Build report
report = {
    "main_title": title if title else "Unknown",
    "title_coords": list(title_coords) if title_coords else None,
    "balances": [{"value": b['value'], "coords": list(b['coords'])} for b in balances[:1]],  # First balance
    "counters": [{"value": c['value'], "coords": list(c['coords'])} for c in counters],
    "raw_text": full_text.strip()
}

# Save the report
with open('/workspace/ocr_summary.json', 'w') as f:
    json.dump(report, f, indent=2)

print(json.dumps(report, indent=2))
EOF

