    "title_coords": list(title_coords) if title_coords else None,
    "balance": balance_value,
    "balance_coords": list(balance_coords) if balance_coords else None,
    "counter": counter_value,
    "counter_coords": list(counter_coords) if counter_coords else None
}

# Save the report
with open('/workspace/ocr_summary.json', 'w') as f:
    json.dump(report, f, indent=2)

print("OCR Summary Report:")
print(json.dumps(report, indent=2))
