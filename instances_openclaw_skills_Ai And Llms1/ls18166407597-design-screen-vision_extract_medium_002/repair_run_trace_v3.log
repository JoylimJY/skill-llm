import json
import pytesseract
import re
from PIL import Image

# Load the screenshot
img = Image.open('/workspace/screenshot.png')

# Get full image text with data
data = pytesseract.image_to_data(img, output_type=pytesseract.Output.DICT)

# Get full text for context
full_text = pytesseract.image_to_string(img)

results = {
    "title": None,
    "balance": None,
    "alerts": None,
    "coordinates": {}
}

# Iterate through detected text blocks
for i in range(len(data['text'])):
    text = data['text'][i].strip()
    if not text:
        continue
    
    x = data['left'][i]
    y = data['top'][i]
    w = data['width'][i]
    h = data['height'][i]
    conf = data['conf'][i]
    
    # Skip low confidence detections
    if conf < 30:
        continue
    
    # Look for title
    if results["title"] is None:
        if 'finance' in text.lower() or 'dashboard' in text.lower():
            results["title"] = text
            results["coordinates"]["title"] = {"x": x, "y": y, "width": w, "height": h}
    
    # Look for balance - check for patterns like "128450" which might be "1284.50"
    if results["balance"] is None:
        # Try to find balance patterns
        balance_match = re.search(r'\d{4,5}', text)
        if balance_match:
            val = balance_match.group()
            # If 5 digits, assume format is XXXX.XX (insert decimal before last 2 digits)
            if len(val) == 5:
                results["balance"] = val[:-2] + "." + val[-2:]
            else:
                results["balance"] = val
            results["coordinates"]["balance"] = {"x": x, "y": y, "width": w, "height": h}
    
    # Look for alerts count
    if results["alerts"] is None:
        if 'alert' in text.lower() or 'unread' in text.lower():
            alerts_match = re.search(r'\b\d{1,2}\b', text)
            if alerts_match:
                results["alerts"] = alerts_match.group()
                results["coordinates"]["alerts"] = {"x": x, "y": y, "width": w, "height": h}

# Also check full text for "Finance Dashboard" as title
if results["title"] is None or results["title"] == "Finance":
    # Search for "Finance Dashboard" in the full text
    if "Finance Dashboard" in full_text:
        results["title"] = "Finance Dashboard"
        # Find coordinates for "Finance" and "Dashboard" together
        for i in range(len(data['text'])):
            if data['text'][i].strip() == 'Finance':
                results["coordinates"]["title"] = {"x": data['left'][i], "y": data['top'][i], "width": data['width'][i], "height": data['height'][i]}
                break

# Save results
with open('/workspace/output.json', 'w') as f:
    json.dump(results, f, indent=2)

print(json.dumps(results, indent=2))
