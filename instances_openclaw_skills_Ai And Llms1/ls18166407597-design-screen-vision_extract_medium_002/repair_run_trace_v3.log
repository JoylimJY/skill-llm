import json
import pytesseract
import re
from PIL import Image

# Load the screenshot
img = Image.open('/workspace/screenshot.png')

# Get full image text with data
data = pytesseract.image_to_data(img, output_type=pytesseract.Output.DICT)

# Get full text for context
full_text = pytesseract.image_to_string(img)

print("Full OCR text:")
print(repr(full_text))
print("\n--- Text blocks ---")
for i in range(len(data['text'])):
    if data['text'][i].strip():
        print(f"[{i}] x={data['left'][i]}, y={data['top'][i]}, w={data['width'][i]}, h={data['height'][i]}: '{data['text'][i]}'")

results = {
    "title": None,
    "balance": None,
    "alerts": None,
    "coordinates": {}
}

# Iterate through detected text blocks
for i in range(len(data['text'])):
    text = data['text'][i].strip()
    if not text:
        continue
    
    x = data['left'][i]
    y = data['top'][i]
    w = data['width'][i]
    h = data['height'][i]
    
    # Look for title
    if results["title"] is None:
        if 'finance' in text.lower() or 'dashboard' in text.lower():
            results["title"] = text
            results["coordinates"]["title"] = {"x": x, "y": y, "width": w, "height": h}
    
    # Look for balance - find numeric values with USD
    if results["balance"] is None:
        if 'usd' in text.lower() or 'balance' in text.lower():
            # Find all numbers in this line
            numbers = re.findall(r'\d+', text)
            if numbers:
                # Take the largest number as balance
                num_str = max(numbers, key=len)
                if len(num_str) >= 4:
                    # Format as XXXX.XX if 5+ digits, or keep as is
                    if len(num_str) >= 5:
                        results["balance"] = num_str[:-2] + "." + num_str[-2:]
                    else:
                        results["balance"] = num_str
                    results["coordinates"]["balance"] = {"x": x, "y": y, "width": w, "height": h}
    
    # Look for alerts count
    if results["alerts"] is None:
        if 'alert' in text.lower() or 'unread' in text.lower():
            alerts_match = re.search(r'\b(\d+)\b', text)
            if alerts_match:
                results["alerts"] = alerts_match.group(1)
                results["coordinates"]["alerts"] = {"x": x, "y": y, "width": w, "height": h}

# Fallback: if title is just "Finance", combine with "Dashboard"
if results["title"] == "Finance":
    results["title"] = "Finance Dashboard"

# Save results
with open('/workspace/output.json', 'w') as f:
    json.dump(results, f, indent=2)

print("\n--- Results ---")
print(json.dumps(results, indent=2))
