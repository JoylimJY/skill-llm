# Search for title and numeric values with coordinates
results = {
    "title": None,
    "balance": None,
    "alerts": None,
    "coordinates": {}
}

# Iterate through detected text blocks
for i in range(len(data['text'])):
    text = data['text'][i].strip()
    if not text:
        continue
    
    x = data['left'][i]
    y = data['top'][i]
    w = data['width'][i]
    h = data['height'][i]
    conf = data['conf'][i]
    
    # Skip low confidence detections
    if conf < 50:
        continue
    
    # Look for title (should contain "Finance Dashboard" or similar)
    if results["title"] is None:
        if 'finance' in text.lower() or 'dashboard' in text.lower():
            results["title"] = text
            results["coordinates"]["title"] = {"x": x, "y": y, "width": w, "height": h}
    
    # Look for balance (numeric value like 1284.50)
    if results["balance"] is None:
        import re
        balance_match = re.search(r'\d+\.\d{2}', text)
        if balance_match:
            results["balance"] = balance_match.group()
            results["coordinates"]["balance"] = {"x": x, "y": y, "width": w, "height": h}
    
    # Look for alerts count (single digit or small number)
    if results["alerts"] is None:
        import re
        alerts_match = re.search(r'\b\d{1,2}\b', text)
        if alerts_match and 'alert' in text.lower():
            results["alerts"] = alerts_match.group()
            results["coordinates"]["alerts"] = {"x": x, "y": y, "width": w, "height": h}

# If we didn't find alerts with "alert" text, look for standalone small numbers
if results["alerts"] is None:
    for i in range(len(data['text'])):
        text = data['text'][i].strip()
        if not text:
            continue
        x = data['left'][i]
        y = data['top'][i]
        w = data['width'][i]
        h = data['height'][i]
        
        import re
        if re.match(r'^\d{1,2}$', text):
            results["alerts"] = text
            results["coordinates"]["alerts"] = {"x": x, "y": y, "width": w, "height": h}
            break

# Save results
with open('/workspace/output.json', 'w') as f:
    json.dump(results, f, indent=2)

print(json.dumps(results, indent=2))
print("\nFull OCR text for reference:")
print(full_text)
