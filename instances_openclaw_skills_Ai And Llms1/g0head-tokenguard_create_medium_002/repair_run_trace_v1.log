import json

# Read input files
with open('/workspace/inputs/limit.json', 'r') as f:
    limit_data = json.load(f)

with open('/workspace/inputs/session.json', 'r') as f:
    session_data = json.load(f)

# Verify markers
assert limit_data['marker'] == 'TOKENGUARD_LIMIT_MARKER_ALPHA_7421'
assert session_data['marker'] == 'TOKENGUARD_SESSION_MARKER_BETA_9183'

# Extract values
current_limit = limit_data['current_limit_usd']
warning_pct = limit_data['warning_pct']
total_spent = session_data['spent_usd']
remaining_budget = current_limit - total_spent
entries = session_data['entries']

# Check if $5.00 call would fit
new_call_amount = 5.00
fits_in_budget = remaining_budget >= new_call_amount

# Create JSON summary
summary_json = {
    "current_limit_usd": current_limit,
    "total_spent_usd": total_spent,
    "remaining_budget_usd": remaining_budget,
    "warning_threshold_pct": warning_pct,
    "entries": entries,
    "new_call_fits_in_budget": fits_in_budget,
    "new_call_amount_usd": new_call_amount
}

# Write JSON file
with open('/workspace/tokenguard_summary.json', 'w') as f:
    json.dump(summary_json, f, indent=2)

# Create human-readable text summary
txt_content = f"""TokenGuard Billing Summary
==========================

Current Spending Limit: ${current_limit:.2f}
Total Spent So Far:     ${total_spent:.2f}
Remaining Budget:       ${remaining_budget:.2f}
Warning Threshold:      {warning_pct * 100:.0f}%

Logged Entries:
{chr(10).join([f"  - ${e['amount_usd']:.2f} - {e['description']}" for e in entries])}

New $5.00 API Call:     {'WILL FIT' if fits_in_budget else 'WILL NOT FIT'} within budget
"""

# Write text file
with open('/workspace/tokenguard_summary.txt', 'w') as f:
    f.write(txt_content)

print("Files generated successfully!")
print(f"Remaining budget: ${remaining_budget:.2f}")
print(f"$5.00 call fits: {fits_in_budget}")

