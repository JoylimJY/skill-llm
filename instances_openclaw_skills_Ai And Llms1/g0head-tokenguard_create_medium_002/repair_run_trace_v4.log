[EXECUTING python]:
import json

# Read input files
with open('/workspace/inputs/limit.json', 'r') as f:
    limit_data = json.load(f)

with open('/workspace/inputs/session.json', 'r') as f:
    session_data = json.load(f)

# Verify markers
assert limit_data['marker'] == 'TOKENGUARD_LIMIT_MARKER_ALPHA_7421', "Invalid limit marker"
assert session_data['marker'] == 'TOKENGUARD_SESSION_MARKER_BETA_9183', "Invalid session marker"

# Extract values
current_limit = limit_data['current_limit_usd']
warning_pct = limit_data['warning_pct']
total_spent = session_data['spent_usd']
entries = session_data['entries']

# Calculate remaining budget
remaining_budget = current_limit - total_spent

# Check if $5.00 API call would fit
new_call_amount = 5.00
would_fit = remaining_budget >= new_call_amount

# Create JSON summary
summary_json = {
    "current_spending_limit_usd": current_limit,
    "total_spent_usd": total_spent,
    "remaining_budget_usd": remaining_budget,
    "warning_threshold_percentage": warning_pct,
    "logged_entries": [
        {
            "amount_usd": entry['amount_usd'],
            "description": entry['description']
        }
        for entry in entries
    ],
    "new_call_would_fit": would_fit,
    "new_call_amount_usd": new_call_amount
}

# Write JSON file
with open('/workspace/tokenguard_summary.json', 'w') as f:
    json.dump(summary_json, f, indent=2)

# Create human-readable summary
warning_pct_display = int(warning_pct * 100)
would_fit_str = "Yes" if would_fit else "No"
over_budget = total_spent > current_limit

txt_summary = f"""TokenGuard Billing Summary
==========================

Spending Limit:     ${current_limit:.2f}
Total Spent:        ${total_spent:.2f}
Remaining Budget:   ${remaining_budget:.2f}
Warning Threshold:  {warning_pct_display}%

{'*** BUDGET OVER LIMIT ***' if over_budget else ''}

Logged Entries:
"""

for entry in entries:
    txt_summary += f"  - ${entry['amount_usd']:.2f}: {entry['description']}\n"

txt_summary += f"""
New $5.00 API Call Would Fit: {would_fit_str}
"""

# Write text file
with open('/workspace/tokenguard_summary.txt', 'w') as f:
    f.write(txt_summary)

print("Generated tokenguard_summary.json and tokenguard_summary.txt")

[OUTPUT]:
Generated tokenguard_summary.json and tokenguard_summary.txt


