```python
import re

# Read the input log file
with open('/workspace/input.log', 'r') as f:
    content = f.read()

# Define patterns for sensitive information
patterns = {
    'password': r'password=[^\s]+',
    'bearer_token': r'bearer token:[^\s]+',
    'api_key': r'api_key=[^\s]+',
    'session_id': r'session_id=[^\s]+',
}

# Replace sensitive values with [REDACTED]
sanitized = content

for key, pattern in patterns.items():
    sanitized = re.sub(pattern, f'{key}=[REDACTED]', sanitized, flags=re.IGNORECASE)

# Write the sanitized content to the output file
with open('/workspace/sanitized.log', 'w') as f:
    f.write(sanitized)

print("Sanitization complete!")
print("\nSanitized content:")
print(sanitized)
```

