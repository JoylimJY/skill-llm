```python
import re

# Read the input log file
with open('/workspace/input.log', 'r') as f:
    content = f.read()

# Define patterns to sanitize
# Passwords - match password=value patterns
content = re.sub(r'password=\S+', 'password=[REDACTED]', content)

# Bearer tokens - match "bearer token: <value>" patterns
content = re.sub(r'bearer token:\s*\S+', 'bearer token: [REDACTED]', content, flags=re.IGNORECASE)

# API keys - match api_key=<value> patterns
content = re.sub(r'api_key=\S+', 'api_key=[REDACTED]', content)

# Session IDs - match session_id=<value> patterns
content = re.sub(r'session_id=\S+', 'session_id=[REDACTED]', content)

# Write the sanitized content to output file
with open('/workspace/sanitized.log', 'w') as f:
    f.write(content)

print("Sanitization complete!")
```

