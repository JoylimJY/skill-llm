[EXECUTING bash]:
cat > /workspace/client.js << 'EOF'
const WebSocket = require('ws');
const crypto = require('crypto');
const fs = require('fs');

// Read server credentials (in real scenario, these would be provided)
const publicId = process.argv[2] || 'demo-public-id';
const sessionSecret = process.argv[3] || 'demo-secret';

console.log('AAP Attestation Client');
console.log(`Connecting to ws://localhost:3000/aap`);

const ws = new WebSocket('ws://localhost:3000/aap');

ws.on('open', () => {
  console.log('Connected to server');
  
  // Create attestation message
  const timestamp = Date.now();
  const nonce = crypto.randomBytes(8).toString('hex');
  
  // Create signature
  const signature = crypto
    .createHmac('sha256', sessionSecret)
    .update(JSON.stringify({
      publicId,
      timestamp,
      nonce
    }))
    .digest('hex');
  
  const attestMessage = {
    type: 'attest',
    publicId,
    timestamp,
    nonce,
    signature
  };
  
  console.log('Sending attestation request...');
  ws.send(JSON.stringify(attestMessage));
});

ws.on('message', (data) => {
  const response = JSON.parse(data);
  
  console.log('Server response:', JSON.stringify(response, null, 2));
  
  if (response.type === 'verified') {
    console.log('\n✓ Attestation successful!');
    
    // Write summary file
    const summary = {
      status: 'success',
      publicId: response.publicId,
      sessionToken: response.sessionToken,
      verified: true,
      timestamp: new Date().toISOString()
    };
    
    fs.writeFileSync('/workspace/attestation_summary.json', JSON.stringify(summary, null, 2));
    console.log('\nSummary written to /workspace/attestation_summary.json');
    console.log('Summary content:');
    console.log(JSON.stringify(summary, null, 2));
  } else if (response.type === 'rejected') {
    console.log('\n✗ Attestation rejected:', response.reason);
  }
  
  ws.close();
});

ws.on('close', () => {
  console.log('Connection closed');
  process.exit(0);
});

ws.on('error', (err) => {
  console.error('WebSocket error:', err);
  process.exit(1);
});
EOF

