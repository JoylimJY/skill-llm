[EXECUTING bash]:
cat > /workspace/server.js << 'EOF'
const WebSocket = require('ws');
const crypto = require('crypto');

// Generate a simple key pair for demo purposes
const privateKey = crypto.createPrivateKey({
  key: crypto.randomBytes(32),
  type: 'pkcs8',
  format: 'raw'
});

// For demo, we'll use a simple HMAC-based signature scheme
const sessionSecret = crypto.randomBytes(32).toString('hex');
const publicId = crypto.randomUUID();

console.log(`AAP Attestation Server starting on port 3000, path /aap`);
console.log(`Public ID: ${publicId}`);
console.log(`Session Secret: ${sessionSecret}`);

const wss = new WebSocket.Server({ 
  port: 3000,
  path: '/aap'
});

wss.on('connection', (ws) => {
  console.log('New client connected');
  
  ws.on('message', (data) => {
    try {
      const message = JSON.parse(data);
      
      if (message.type === 'attest') {
        // Verify signature
        const expectedSignature = crypto
          .createHmac('sha256', sessionSecret)
          .update(JSON.stringify({
            publicId,
            timestamp: message.timestamp,
            nonce: message.nonce
          }))
          .digest('hex');
        
        const isValid = message.signature === expectedSignature;
        
        console.log('--- Verification Result ---');
        console.log(`Public ID: ${publicId}`);
        console.log(`Timestamp: ${message.timestamp}`);
        console.log(`Nonce: ${message.nonce}`);
        console.log(`Signature Valid: ${isValid}`);
        console.log('---------------------------');
        
        if (isValid) {
          // Generate session token
          const sessionToken = crypto.randomBytes(16).toString('hex');
          console.log(`Session Token Generated: ${sessionToken}`);
          
          ws.send(JSON.stringify({
            type: 'verified',
            publicId,
            sessionToken,
            valid: true
          }));
        } else {
          ws.send(JSON.stringify({
            type: 'rejected',
            valid: false,
            reason: 'Invalid signature'
          }));
        }
      }
    } catch (err) {
      console.error('Error processing message:', err);
      ws.send(JSON.stringify({
        type: 'error',
        message: 'Invalid message format'
      }));
    }
  });
  
  ws.on('close', () => {
    console.log('Client disconnected');
  });
});

console.log('Server ready for connections');
EOF

