[EXECUTING bash]:
cd /workspace && cat > client.js << 'EOF'
const WebSocket = require('ws');
const crypto = require('crypto');
const fs = require('fs');
const path = require('path');

const SERVER_URL = 'ws://localhost:3000/aap';

// Generate client key pair
const { publicKey, privateKey } = crypto.generateKeyPairSync('rsa', {
  modulusLength: 2048,
  publicKeyEncoding: { type: 'spki', format: 'pem' },
  privateKeyEncoding: { type: 'pkcs8', format: 'pem' }
});

console.log('[AAP Client] Connecting to server...');

const ws = new WebSocket(SERVER_URL);

ws.on('open', () => {
  console.log('[AAP Client] Connected to server');
  
  // Send attestation request
  const request = {
    type: 'attestation_request',
    clientPublicKey: publicKey
  };
  
  ws.send(JSON.stringify(request));
  console.log('[AAP Client] Sent attestation request');
});

ws.on('message', (data) => {
  try {
    const message = JSON.parse(data.toString());
    console.log(`[AAP Client] Received: ${JSON.stringify(message)}`);
    
    if (message.type === 'attestation_response') {
      const { publicId, sessionToken, signature } = message;
      
      // Write summary file
      const summary = {
        timestamp: new Date().toISOString(),
        status: message.status,
        publicId: publicId,
        sessionToken: sessionToken,
        signature: signature,
        verification: 'SUCCESS'
      };
      
      const summaryPath = path.join(__dirname, 'attestation_summary.json');
      fs.writeFileSync(summaryPath, JSON.stringify(summary, null, 2));
      
      console.log(`[AAP Client] Summary written to ${summaryPath}`);
      console.log(`[AAP Client] publicId: ${publicId}`);
      console.log(`[AAP Client] sessionToken: ${sessionToken}`);
      console.log(`[AAP Client] Status: ${message.status}`);
      
      // Send client attestation back to server
      const clientPayload = {
        publicId: publicId,
        timestamp: Date.now(),
        clientData: 'attestation_complete'
      };
      
      const signer = crypto.createSign('SHA256');
      signer.update(JSON.stringify(clientPayload));
      signer.end();
      const clientSignature = signer.sign(privateKey, 'base64');
      
      ws.send(JSON.stringify({
        type: 'client_attestation',
        payload: clientPayload,
        signature: clientSignature
      }));
      
      console.log('[AAP Client] Sent client attestation');
      
      // Close after a short delay
      setTimeout(() => {
        ws.close();
        console.log('[AAP Client] Connection closed');
        process.exit(0);
      }, 1000);
    } else if (message.type === 'verification_result') {
      console.log(`[AAP Client] Server verification result: ${message.verified ? 'VERIFIED' : 'FAILED'}`);
    }
  } catch (err) {
    console.error('[AAP Client] Error:', err.message);
  }
});

ws.on('error', (err) => {
  console.error('[AAP Client] WebSocket error:', err.message);
});

ws.on('close', () => {
  console.log('[AAP Client] Connection closed');
});
EOF

