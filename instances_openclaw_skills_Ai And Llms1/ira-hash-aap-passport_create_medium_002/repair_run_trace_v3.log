[EXECUTING bash]:
cd /workspace && cat > server.js << 'EOF'
const WebSocket = require('ws');
const crypto = require('crypto');

const PORT = 3000;
const PATH = '/aap';

// Generate a simple key pair for demo purposes
const { publicKey, privateKey } = crypto.generateKeyPairSync('rsa', {
  modulusLength: 2048,
  publicKeyEncoding: { type: 'spki', format: 'pem' },
  privateKeyEncoding: { type: 'pkcs8', format: 'pem' }
});

// Store the public key for verification
const serverPublicKey = publicKey;
console.log('[AAP Server] Public key generated');

const wss = new WebSocket.Server({ 
  path: PATH,
  port: PORT 
});

console.log(`[AAP Server] Listening on ws://localhost:${PORT}${PATH}`);

wss.on('connection', (ws) => {
  console.log('[AAP Server] Client connected');
  
  ws.on('message', (data) => {
    try {
      const message = JSON.parse(data.toString());
      
      console.log(`[AAP Server] Received message: ${JSON.stringify(message)}`);
      
      if (message.type === 'attestation_request') {
        // Generate session token and publicId
        const publicId = crypto.randomBytes(16).toString('hex');
        const sessionToken = crypto.randomBytes(32).toString('hex');
        
        // Create attestation payload
        const payload = {
          publicId,
          sessionToken,
          timestamp: Date.now(),
          nonce: crypto.randomBytes(8).toString('hex')
        };
        
        // Sign the payload with server's private key
        const signer = crypto.createSign('SHA256');
        signer.update(JSON.stringify(payload));
        signer.end();
        const signature = signer.sign(privateKey, 'base64');
        
        // Verify the signature (server-side verification)
        const verify = crypto.createVerify('SHA256');
        verify.update(JSON.stringify(payload));
        verify.end();
        const isValid = verify.verify(publicKey, signature, 'base64');
        
        console.log(`[AAP Server] Signature verification: ${isValid ? 'SUCCESS' : 'FAILED'}`);
        
        // Send attestation response
        const response = {
          type: 'attestation_response',
          status: isValid ? 'verified' : 'failed',
          publicId,
          sessionToken,
          signature
        };
        
        ws.send(JSON.stringify(response));
        console.log(`[AAP Server] Sent attestation response for publicId: ${publicId}`);
      } else if (message.type === 'client_attestation') {
        // Verify client's attestation
        const { payload, signature } = message;
        
        const verify = crypto.createVerify('SHA256');
        verify.update(JSON.stringify(payload));
        verify.end();
        
        const isValid = verify.verify(serverPublicKey, signature, 'base64');
        
        console.log(`[AAP Server] Client attestation verification: ${isValid ? 'SUCCESS' : 'FAILED'}`);
        
        ws.send(JSON.stringify({
          type: 'verification_result',
          verified: isValid
        }));
      }
      
    } catch (err) {
      console.error('[AAP Server] Error processing message:', err.message);
      ws.send(JSON.stringify({ type: 'error', message: err.message }));
    }
  });
  
  ws.on('close', () => {
    console.log('[AAP Server] Client disconnected');
  });
  
  ws.on('error', (err) => {
    console.error('[AAP Server] WebSocket error:', err.message);
  });
});
EOF

