[EXECUTING bash]:
cat > /workspace/client.js << 'EOF'
const WebSocket = require('ws');
const crypto = require('crypto');
const fs = require('fs');

const SERVER_URL = 'ws://localhost:3000/aap';

console.log('[Client] Starting AAP WebSocket client...');
console.log('[Client] Connecting to:', SERVER_URL);

const ws = new WebSocket(SERVER_URL);

ws.on('open', () => {
  console.log('[Client] Connected to server');
  
  // Create a payload for attestation
  const payload = JSON.stringify({
    type: 'attestation-request',
    client: 'aap-demo-client',
    timestamp: new Date().toISOString(),
    nonce: crypto.randomBytes(16).toString('hex')
  });
  
  // Create a signature (simulated for demo)
  const signature = crypto.createHash('sha256')
    .update(payload + 'AAP_DEMO_SECRET')
    .digest('hex');
  
  const message = {
    type: 'attestation',
    payload: payload,
    signature: signature
  };
  
  console.log('[Client] Sending attestation request with signature...');
  ws.send(JSON.stringify(message));
});

ws.on('message', (data) => {
  const response = JSON.parse(data.toString());
  console.log('[Client] Received response:', JSON.stringify(response));
  
  if (response.type === 'verification-result' && response.status === 'success') {
    const summary = {
      status: 'SUCCESS',
      publicId: response.publicId,
      sessionToken: response.sessionToken,
      timestamp: response.timestamp,
      outcome: 'Attestation verified successfully via AAP protocol'
    };
    
    // Write summary file
    const summaryFile = '/workspace/attestation_summary.json';
    fs.writeFileSync(summaryFile, JSON.stringify(summary, null, 2));
    console.log(`[Client] Summary written to: ${summaryFile}`);
    console.log('[Client] Summary:', JSON.stringify(summary, null, 2));
    
    ws.close();
  } else if (response.type === 'error') {
    console.log('[Client] Verification failed:', response.message);
    ws.close();
  }
});

ws.on('close', () => {
  console.log('[Client] Connection closed');
});

ws.on('error', (err) => {
  console.log('[Client] Error:', err.message);
});
EOF

