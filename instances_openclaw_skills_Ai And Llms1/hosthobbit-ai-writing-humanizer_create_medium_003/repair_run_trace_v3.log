"""Main entry point for AI Writing Humanizer."""
import argparse
import re
import sys


def humanize_text(text):
    """
    Rewrite text to sound more natural and human-like.
    Removes AI-sounding phrases and corporate language.
    """
    # Define AI/corporate phrases to remove or replace
    replacements = {
        # Remove filler phrases
        r'\bat the end of the day\b': '',
        r'\bfirstly\b': 'First',
        r'\bsecondly\b': 'Next',
        r'\bfinally\b': 'And finally',
        r'\bit is important to remember that\b': '',
        r'\bit is worth noting that\b': '',
        r'\bthe process was simple\b': 'things were straightforward',
        r'\bthe update has been reviewed\b': 'I reviewed the update',
        r'\bthe summary was prepared with care\b': 'I put care into the summary',
        r'\bthe language has been adjusted\b': 'I adjusted the language',
    }
    
    result = text
    
    # Apply replacements
    for pattern, replacement in replacements.items():
        result = re.sub(pattern, replacement, result, flags=re.IGNORECASE)
    
    # Clean up awkward spacing and punctuation
    result = re.sub(r'\s+', ' ', result)
    result = re.sub(r'\s*([,.!?;:])\s*', r'\1 ', result)
    result = re.sub(r'\s+([.,!?;:])', r'\1', result)
    result = re.sub(r'^\s+', '', result)
    result = re.sub(r'\s+$', '', result)
    
    # Fix sentence starts after removals
    result = re.sub(r'^\s*,\s*', '', result)
    result = re.sub(r'\s*,\s+', ', ', result)
    
    # Handle common AI closing phrases
    result = re.sub(r'I hope this helps, and let me know if you have any questions\.', 'Feel free to reach out if you have questions.', result, flags=re.IGNORECASE)
    
    # Clean up double spaces that might remain
    result = re.sub(r'\s{2,}', ' ', result)
    
    return result.strip()


def main():
    parser = argparse.ArgumentParser(description='Humanize AI-written text')
    parser.add_argument('--input', required=True, help='Input file path')
    parser.add_argument('--output', required=True, help='Output file path')
    
    args = parser.parse_args()
    
    try:
        with open(args.input, 'r') as f:
            text = f.read()
        
        humanized = humanize_text(text)
        
        with open(args.output, 'w') as f:
            f.write(humanized)
        
        print(f"Successfully wrote humanized text to {args.output}")
        
    except FileNotFoundError:
        print(f"Error: Input file '{args.input}' not found.", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()
