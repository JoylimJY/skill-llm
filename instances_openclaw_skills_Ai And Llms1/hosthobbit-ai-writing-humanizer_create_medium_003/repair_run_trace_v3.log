    Removes AI-sounding phrases and corporate language.
    """
    result = text
    
    # Remove "at the end of the day"
    result = re.sub(r'\bat the end of the day\b', '', result, flags=re.IGNORECASE)
    
    # Replace "the process was simple" with more natural phrasing
    result = re.sub(r'\bthe process was simple\b', 'things were straightforward', result, flags=re.IGNORECASE)
    
    # Remove "it is important to remember that"
    result = re.sub(r'\bit is important to remember that\b', '', result, flags=re.IGNORECASE)
    
    # Replace stock transitions with natural ones
    result = re.sub(r'\bfirstly\b', 'First', result, flags=re.IGNORECASE)
    result = re.sub(r'\bsecondly\b', 'Next', result, flags=re.IGNORECASE)
    result = re.sub(r'\band finally\b', 'and lastly', result, flags=re.IGNORECASE)
    result = re.sub(r'\bfinally\b', 'lastly', result, flags=re.IGNORECASE)
    
    # Replace passive corporate language with active voice
    result = re.sub(r'\bthe update has been reviewed\b', 'I reviewed the update', result, flags=re.IGNORECASE)
    result = re.sub(r'\bthe summary was prepared with care\b', 'I put care into the summary', result, flags=re.IGNORECASE)
    result = re.sub(r'\bthe language has been adjusted\b', 'I adjusted the language', result, flags=re.IGNORECASE)
    
    # Remove "it is worth noting that"
    result = re.sub(r'\bit is worth noting that\b', '', result, flags=re.IGNORECASE)
    
    # Replace stock closing phrase
    result = re.sub(r'I hope this helps, and let me know if you have any questions\.', 
                    'Feel free to reach out if you have questions.', result, flags=re.IGNORECASE)
    
    # Clean up spacing
    result = re.sub(r'\s+', ' ', result)
    result = re.sub(r'\s*([,.!?;:])\s*', r'\1 ', result)
    result = re.sub(r'\s+([.,!?;:])', r'\1', result)
    result = re.sub(r'^\s+', '', result)
    result = re.sub(r'\s+$', '', result)
    
    # Remove leading comma if present
    result = re.sub(r'^\s*,\s*', '', result)
    
    # Clean up double spaces
    result = re.sub(r'\s{2,}', ' ', result)
    
    # Fix the transition pattern - "Next, ..., Finally, ..." should flow better
    result = re.sub(r'Next, it should avoid obvious patterns, Finally,', 
                    'Next, it should avoid obvious patterns. Finally,', result, flags=re.IGNORECASE)
    
    # Capitalize first letter
    result = result[0].upper() + result[1:] if result else result
    
    return result.strip()


def main():
    parser = argparse.ArgumentParser(description='Humanize AI-written text')
    parser.add_argument('--input', required=True, help='Input file path')
    parser.add_argument('--output', required=True, help='Output file path')
    
