cat > /workspace/ai_writing_humanizer/__main__.py << 'EOF'
import argparse
import re
import sys

def humanize_text(text):
    """Rewrite text to sound more natural and human-like."""
    
    # Remove AI-sounding phrases and replace with natural alternatives
    replacements = [
        # Time/summary phrases
        (r'\bAt the end of the day\b', 'Looking back'),
        (r'\bIt is worth noting that\b', 'Note that'),
        (r'\bit is important to remember that\b', 'remember that'),
        
        # Ordering phrases that sound robotic
        (r'\bFirstly\b', 'First'),
        (r'\bSecondly\b', 'Next'),
        (r'\band finally\b', 'and lastly'),
        
        # Stock phrases
        (r'\bI hope this helps,?\s*(?:and let me know if you have any questions)?\b', 'Let me know if you have questions'),
        (r'\bThe update has been reviewed\b', 'The update was reviewed'),
        (r'\bthe summary was prepared with care\b', 'we put care into the summary'),
        (r'\bthe language has been adjusted\b', 'we adjusted the language'),
    ]
    
    result = text
    for pattern, replacement in replacements:
        result = re.sub(pattern, replacement, result, flags=re.IGNORECASE)
    
    # Fix awkward sentence structures
    result = result.replace('but it is important to remember', 'but remember')
    result = result.replace('something a person would actually send', 'something a real person would send')
    
    # Remove passive voice where possible
    result = re.sub(r'was full of', 'had plenty of', result)
    result = re.sub(r'should sound natural', 'needs to sound natural', result)
    result = re.sub(r'should avoid', 'should steer clear of', result)
    result = re.sub(r'should read like', 'should feel like', result)
    
    # Clean up extra spaces
    result = re.sub(r'\s+', ' ', result).strip()
    
    # Add a more natural flow
    result = result.replace('. Firstly,', '. First,')
    result = result.replace('. Secondly,', '. Next,')
    result = result.replace(', and finally,', ', and lastly,')
    
    return result

def main():
    parser = argparse.ArgumentParser(description='Humanize AI-written text')
    parser.add_argument('--input', required=True, help='Input file path')
    parser.add_argument('--output', required=True, help='Output file path')
    
    args = parser.parse_args()
    
    try:
        with open(args.input, 'r') as f:
            text = f.read()
        
        humanized = humanize_text(text)
        
        with open(args.output, 'w') as f:
            f.write(humanized)
        
        print(f"Successfully wrote humanized text to {args.output}")
        
    except FileNotFoundError:
        print(f"Error: Input file '{args.input}' not found", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

if __name__ == '__main__':
    main()
EOF

