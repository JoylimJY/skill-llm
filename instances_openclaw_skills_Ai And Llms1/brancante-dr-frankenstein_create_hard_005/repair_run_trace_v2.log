#!/usr/bin/env python3
"""
gen_inputs.py - Generate deterministic input files for dr-frankenstein task.
"""

from pathlib import Path
from textwrap import dedent
import json
import hashlib

SEED = 4242
base = Path('.')

def md5_hash(s: str) -> str:
    return hashlib.md5(s.encode()).hexdigest()[:8].upper()

def generate_patient_profile():
    return dedent(f'''
    # Patient Profile: Elena Vasquez
    
    ## Demographics
    - Age: 34
    - Gender: Female
    - Occupation: Software Engineer
    - Last visit: 2025-03-15
    
    ## Chief Complaints
    1. Chronic fatigue (6 months duration)
    2. Weight gain despite diet changes (+8kg in 3 months)
    3. Cold intolerance
    4. Hair thinning and dry skin
    5. Irregular menstrual cycles
    
    ## Medical History
    - No prior thyroid diagnosis
    - Family history: mother had hypothyroidism diagnosed at age 40
    - No known drug allergies
    - Currently not on any medications
    
    ## Initial Lab Results
    - TSH: 8.7 mIU/L (elevated, ref: 0.4-4.0)
    - Free T4: 0.8 ng/dL (low, ref: 0.9-1.7)
    - Anti-TPO Antibodies: 180 IU/mL (elevated, ref: <35)
    
    Marker: PATIENT_PROFILE_HASH_{md5_hash("elena_vasquez_34")}
    ''').strip() + '\n'

def generate_interview_notes():
    return dedent(f'''
    # Raw Interview Notes - Dr. Frankenstein Protocol
    
    ## Session Date: 2025-04-12
    ## Duration: 45 minutes
    ## Interviewer: Dr. A. Frankenstein
    
    ### Key Patient Statements
    - "I wake up tired and stay tired"
    - "Need 3 cups of coffee just to function"
    - "Afternoon crashes around 3 PM daily"
    - "Eating same amount, gaining weight"
    - "Always cold when others comfortable"
    - "Hair falling out in clumps"
    - "Sleep does not feel restorative"
    
    ### Patient Questions
    1. "Is this definitely thyroid?"
    2. "How long until I feel better?"
    3. "Will I need medication forever?"
    
    ### Physical Exam
    - BP: 118/76, HR: 62 bpm
    - Weight: 72.4 kg (up from 64.5 kg)
    - Thyroid: slightly enlarged, no nodules
    - Reflexes: delayed relaxation phase
    
    Marker: INTERVIEW_NOTES_HASH_{md5_hash("frankstein_session_apr12")}
    ''').strip() + '\n'

def generate_laboratory_results():
    return dedent(f'''
    # Laboratory Results - Elena Vasquez
    
    ## Collection: 2025-04-12 08:30 AM
    ## Lab ID: LAB-2025-0412-EV
    
    ### Thyroid Panel
    | Test | Result | Reference | Status |
    |------|--------|-----------|--------|
    | TSH | 8.7 mIU/L | 0.4-4.0 | HIGH |
    | Free T4 | 0.8 ng/dL | 0.9-1.7 | LOW |
    | Free T3 | 2.1 pg/mL | 2.3-4.2 | LOW |
    | Anti-TPO | 180 IU/mL | <35 | HIGH |
    
    ### Additional Labs
    | Test | Result | Reference | Status |
    |------|--------|-----------|--------|
    | Vitamin D | 22 ng/mL | 30-100 | LOW |
    | HbA1c | 5.4% | <5.7 | Normal |
    | LDL | 145 mg/dL | <100 | HIGH |
    
    Marker: LAB_RESULTS_HASH_{md5_hash("lab_apr12_ev")}
    ''').strip() + '\n'

def generate_treatment_guidelines():
    return dedent(f'''
    # Hashimotos Treatment Guidelines
    
    ## First-Line: Levothyroxine (T4)
    
    ### Dosing
    - Initial: 1.6 mcg/kg/day for healthy adults <50 years
    - Start: 50-75 mcg daily for moderate-severe cases
    - Adjust by 12.5-25 mcg based on TSH
    
    ### Administration
    - Take on empty stomach, 30-60 min before breakfast
    - Consistent timing daily
    - Avoid calcium/iron within 4 hours
    
    ### Monitoring
    - Recheck TSH in 6-8 weeks after dose change
    - Target TSH: 0.5-2.5 mIU/L
    
    ### Supplement Recommendations
    - Vitamin D3: 2000-4000 IU daily
    - Selenium: 200 mcg daily
    - Omega-3: 1000 mg daily
    
    Marker: GUIDELINES_HASH_{md5_hash("hashimoto_guidelines")}
    ''').strip() + '\n'

def generate_cron_requirements():
    return dedent(f'''
    # Medication Schedule Requirements
    
    ## Patient: Elena Vasquez
    ## Start Date: 2025-04-15
    
    ### Daily Medications
    1. Levothyroxine 75mcg - 7:00 AM daily (empty stomach)
    2. Vitamin D3 2000IU - 8:00 AM daily (with breakfast)
    3. Selenium 200mcg - 12:00 PM daily (with lunch)
    4. Omega-3 1000mg - 7:00 PM daily (with dinner)
    
    ### Reminder Schedule
    - Morning reminder: 6:45 AM (levothyroxine)
    - Lunch reminder: 11:45 AM (selenium)
    - Evening reminder: 6:45 PM (omega-3)
    
    ### Follow-up Appointments
    - 6 weeks: 2025-05-27 (TSH recheck)
    - 12 weeks: 2025-06-24 (full panel)
    - 6 months: 2025-10-12 (annual review)
    
    Marker: CRON_REQ_HASH_{md5_hash("med_schedule_ev")}
    ''').strip() + '\n'

def main():
    base = Path('.')
    (base / 'memory').mkdir(exist_ok=True)
    (base / 'memory' / 'dreams').mkdir(parents=True, exist_ok=True)
    (base / 'memory' / 'journal').mkdir(parents=True, exist_ok=True)
    (base / 'memory' / 'soul').mkdir(parents=True, exist_ok=True)
    (base / 'inputs').mkdir(exist_ok=True)
    
    files = {
        'inputs/patient_profile.md': generate_patient_profile(),
        'inputs/interview_notes.md': generate_interview_notes(),
        'inputs/laboratory_results.md': generate_laboratory_results(),
        'inputs/treatment_guidelines.md': generate_treatment_guidelines(),
        'inputs/cron_requirements.md': generate_cron_requirements(),
    }
    
    for name, content in files.items():
        p = base / name
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(content, encoding='utf-8')
    
    metadata = {
        'agent_name': 'Atlas',
        'human_name': 'Mira',
        'patient_name': 'Elena Vasquez',
        'seed': SEED,
        'marker': 'TASK_INSTANCE_MARKER_' + md5_hash('dr_frankenstein_hard'),
        'diagnosis': 'Hashimotos Thyroiditis',
        'prescription': 'Levothyroxine 75mcg daily',
    }
    (base / 'task_metadata.json').write_text(json.dumps(metadata, indent=2), encoding='utf-8')
    
    print("Generated input files for dr-frankenstein task")
    print(f"Task marker: {metadata['marker']}")

if __name__ == '__main__':
    main()
GENEOF

