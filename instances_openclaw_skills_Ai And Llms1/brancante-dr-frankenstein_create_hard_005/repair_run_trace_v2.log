cat > /workspace/task.yaml << 'TASKYAML'
# Task Specification: dr-frankenstein (Hard Difficulty)
# Medical Interview Synthesis and Prescription Generation

name: dr-frankenstein-hard
version: "1.0"
difficulty: hard
description: |
  Synthesize a professional medical interview transcript from raw notes,
  derive a hormonal prescription based on lab results and guidelines,
  generate cron commands for medication scheduling, and create memory
  artifacts documenting the treatment plan.

inputs:
  - path: inputs/patient_profile.md
    description: Patient demographics, complaints, and medical history
    required: true
  - path: inputs/interview_notes.md
    description: Raw interview notes to be synthesized into transcript
    required: true
  - path: inputs/laboratory_results.md
    description: Lab results for diagnosis and treatment planning
    required: true
  - path: inputs/treatment_guidelines.md
    description: Clinical guidelines for Hashimotos treatment
    required: true
  - path: inputs/cron_requirements.md
    description: Medication schedule requirements
    required: true

outputs:
  - path: outputs/interview_transcript.md
    description: |
      Professional medical interview transcript synthesizing raw notes.
      Must include: patient demographics, chief complaints, symptom
      history, family history, physical exam findings, and diagnosis
      discussion. Format as a dialogue with clear speaker labels.
    validation:
      - type: file_exists
      - type: contains_marker
        marker_pattern: "TRANSCRIPT_HASH_"
      - type: contains_text
        patterns:
          - "Dr. Frankenstein"
          - "Elena Vasquez"
          - "Hashimoto's"
          - "levothyroxine"

  - path: outputs/prescription.json
    description: |
      JSON prescription document with medication details, dosing,
      administration instructions, and monitoring schedule.
      Must be valid JSON with required fields.
    validation:
      - type: file_exists
      - type: valid_json
      - type: json_schema
        schema:
          required:
            - patient_name
            - patient_dob
            - diagnosis
            - medications
            - monitoring_schedule
          properties:
            medications:
              type: array
              items:
                required:
                  - name
                  - dosage
                  - frequency
                  - instructions

  - path: outputs/cron_commands.sh
    description: |
      Shell script containing cron commands for medication reminders.
      Each command must be properly formatted with comments explaining
      the schedule. Must be executable and syntactically valid.
    validation:
      - type: file_exists
      - type: contains_text
        patterns:
          - "# Medication Reminder Cron Jobs"
          - "LEVOthyroxine"
          - "Vitamin D3"
          - "Selenium"
          - "Omega-3"
      - type: executable
        required: true

  - path: outputs/memory/treatment_plan.md
    description: |
      Memory artifact documenting the treatment plan with embedded
      markers for future reference. Must include diagnosis, prescribed
      medications, expected timeline, and follow-up schedule.
    validation:
      - type: file_exists
      - type: contains_marker
        marker_pattern: "TREATMENT_PLAN_HASH_"

  - path: outputs/memory/patient_status.md
    description: |
      Memory artifact tracking current patient status at treatment start.
      Must include baseline vitals, lab values, and symptom checklist.
    validation:
      - type: file_exists
      - type: contains_marker
        marker_pattern: "PATIENT_STATUS_HASH_"

evaluation:
  criteria:
    - name: transcript_quality
      weight: 0.25
      description: |
        Transcript must be professionally formatted with clear dialogue,
        accurate medical terminology, and logical flow. Must synthesize
        all key information from interview notes.
      
    - name: prescription_accuracy
      weight: 0.30
      description: |
        Prescription must correctly identify Hashimoto's thyroiditis
        diagnosis, prescribe appropriate levothyroxine dosage (75mcg),
        include proper administration instructions, and specify monitoring.
      
    - name: cron_validity
      weight: 0.20
      description: |
        Cron commands must be syntactically correct, include all four
        medications with correct timing, and have clear comments.
      
    - name: memory_artifacts
      weight: 0.15
      description: |
        Memory files must contain required markers and comprehensive
        treatment documentation for future reference.
      
    - name: marker_preservation
      weight: 0.10
      description: |
        All output files must contain embedded hash markers derived
        deterministically from input content.

  scoring:
    pass_threshold: 0.75
    point_system:
      - criterion: transcript_quality
        points:
          - condition: "contains all patient statements from notes"
            score: 1.0
          - condition: "proper medical dialogue format"
            score: 0.8
          - condition: "includes diagnosis discussion"
            score: 0.6
      - criterion: prescription_accuracy
        points:
          - condition: "correct diagnosis (Hashimoto's)"
            score: 0.4
          - condition: "correct medication (levothyroxine 75mcg)"
            score: 0.3
          - condition: "complete administration instructions"
            score: 0.2
          - condition: "monitoring schedule included"
            score: 0.1
      - criterion: cron_validity
        points:
          - condition: "all 4 medications scheduled"
            score: 0.5
          - condition: "correct times (7:00, 8:00, 12:00, 19:00)"
            score: 0.3
          - condition: "valid cron syntax"
            score: 0.2
      - criterion: memory_artifacts
        points:
          - condition: "treatment_plan.md exists with marker"
            score: 0.75
          - condition: "patient_status.md exists with marker"
            score: 0.25
      - criterion: marker_preservation
        points:
          - condition: "all markers present and valid"
            score: 1.0

metadata:
  skill: dr-frankenstein
  domain: healthcare-simulation
  expected_duration_minutes: 45
  complexity_factors:
    - multi-file synthesis
    - medical domain knowledge
    - cron scheduling
    - JSON schema compliance
    - marker generation
