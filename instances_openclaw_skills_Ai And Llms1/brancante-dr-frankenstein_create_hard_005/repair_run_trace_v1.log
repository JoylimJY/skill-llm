# Create evaluator script
from pathlib import Path

base = Path('/workspace')

evaluator = '''#!/usr/bin/env python3
"""
Dr-Frankenstein Task Evaluator
Verifies that the model has correctly:
1. Synthesized an interview analysis
2. Derived a hormonal prescription
3. Generated cron commands
4. Created memory artifacts
"""

import json
import re
import sys
from pathlib import Path

def check_marker_exists(content, marker_name):
    """Check if a marker exists in content."""
    return marker_name in content

def evaluate():
    errors = []
    warnings = []
    outputs_dir = Path('outputs')
    
    # Check outputs directory exists
    if not outputs_dir.exists():
        errors.append("outputs directory does not exist")
        return errors, warnings
    
    # 1. Check prescription.md exists and has required content
    prescription_file = outputs_dir / 'prescription.md'
    if not prescription_file.exists():
        errors.append("prescription.md not found in outputs/")
    else:
        prescription_content = prescription_file.read_text()
        
        # Check for marker
        if not check_marker_exists(prescription_content, 'PRESCRIPTION_MARKER'):
            errors.append("PRESCRIPTION_MARKER not found in prescription.md")
        
        # Check for required prescription elements
        required_elements = [
            'Levothyroxine',
            'mcg',
            'daily',
            'empty stomach',
            'TSH'
        ]
        for elem in required_elements:
            if elem.lower() not in prescription_content.lower():
                warnings.append(f"Prescription missing expected element: {elem}")
        
        # Check dose calculation (should be around 100-110 mcg for 68kg patient)
        dose_match = re.search(r'(\\d+)\\s*mcg', prescription_content)
        if dose_match:
            dose = int(dose_match.group(1))
            if dose < 80 or dose > 130:
                warnings.append(f"Dose of {dose} mcg seems outside expected range (80-130 mcg)")
    
    # 2. Check cron_jobs.txt exists and has valid cron format
    cron_file = outputs_dir / 'cron_jobs.txt'
    if not cron_file.exists():
        errors.append("cron_jobs.txt not found in outputs/")
    else:
        cron_content = cron_file.read_text()
        
        # Check for valid cron entries
        cron_pattern = r'^\\d+\\s+\\d+\\s+\\*\\s+\\*\\s+\\*$'
        cron_lines = [l.strip() for l in cron_content.split('\\n') if l.strip() and not l.strip().startswith('#')]
        
        valid_cron_count = 0
        for line in cron_lines:
            if re.match(cron_pattern, line.split()[0:5] if len(line.split()) >= 5 else ''):
                valid_cron_count += 1
        
        if valid_cron_count < 2:
            errors.append(f"Expected at least 2 valid cron entries, found {valid_cron_count}")
        
        # Check for medication reminder cron
        if 'medication' not in cron_content.lower() and 'reminder' not in cron_content.lower():
            warnings.append("No medication reminder cron job found")
    
    # 3. Check memory artifacts
    memory_dir = outputs_dir / 'memory'
    if not memory_dir.exists():
        errors.append("outputs/memory directory does not exist")
    else:
        # Check for prescription memory file
        prescription_memories = list(memory_dir.glob('prescription_*.md'))
        if not prescription_memories:
            errors.append("No prescription_*.md file found in outputs/memory/")
        else:
            for pm in prescription_memories:
                pm_content = pm.read_text()
                if not check_marker_exists(pm_content, 'PRESCRIPTION_MARKER'):
                    warnings.append(f"PRESCRIPTION_MARKER not found in {pm.name}")
        
        # Check for followup_plan.md
        followup_file = memory_dir / 'followup_plan.md'
        if not followup_file.exists():
            errors.append("followup_plan.md not found in outputs/memory/")
        else:
            followup_content = followup_file.read_text()
            required_followup = ['6 weeks', 'TSH', 'follow-up']
            for req in required_followup:
                if req.lower() not in followup_content.lower():
                    warnings.append(f"Followup plan missing expected content: {req}")
    
    # 4. Verify input markers were present (deterministic check)
    input_markers = {
        'patient_interview.md': 'INTERVIEW_MARKER_ELENA_20250412',
        'patient_profile.json': 'PROFILE_MARKER_ELENA_PV20250412',
        'hormone_reference.md': 'REFERENCE_MARKER_HORMONE_V21'
    }
    
    for input_file, marker in input_markers.items():
        if Path(input_file).exists():
            content = Path(input_file).read_text()
            if marker not in content:
                errors.append(f"Input file {input_file} missing marker: {marker}")
        else:
            errors.append(f"Input file {input_file} not found")
    
    return errors, warnings

if __name__ == '__main__':
    errors, warnings = evaluate()
    
    print("=" * 60)
    print("DR-FRANKENSTEIN TASK EVALUATION RESULTS")
    print("=" * 60)
    
    if warnings:
        print("\\nWARNINGS:")
        for w in warnings:
            print(f"  - {w}")
    
    if errors:
        print("\\nERRORS:")
        for e in errors:
            print(f"  - {e}")
        print("\\nEVALUATION: FAILED")
        sys.exit(1)
    else:
        print("\\nEVALUATION: PASSED")
        sys.exit(0)
'''

(base / 'evaluator.py').write_text(evaluator)
(base / 'evaluator.py').chmod(0o755)
print("Created evaluator.py")

