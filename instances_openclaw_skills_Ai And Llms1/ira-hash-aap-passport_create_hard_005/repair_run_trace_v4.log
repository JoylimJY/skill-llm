import { AAPServer } from './server.js';
import { AAPClient, writeVerificationSummary } from './client.js';

async function runAAPVerificationDemo() {
  const serverPort = 8080;
  const serverUrl = `ws://localhost:${serverPort}/aap`;

  console.log('=== AAP Verification Demo ===\n');

  // Start the server
  const server = new AAPServer(serverPort);
  await server.start();

  // Give server a moment to fully initialize
  await new Promise(resolve => setTimeout(resolve, 100));

  try {
    // Create and connect client
    const client = new AAPClient(serverUrl);
    await client.connect();

    // Perform verification
    const result = await client.verify();

    // Write verification summary
    const summary = await writeVerificationSummary(result);

    // Log summary for automated test validation
    console.log('\n=== Verification Summary ===');
    console.log(JSON.stringify(summary, null, 2));

    return summary;
  } finally {
    // Cleanup
    await client.close();
    server.stop();
    console.log('\nDemo completed successfully');
  }
}

// Run the demo
runAAPVerificationDemo().catch(err => {
  console.error('Demo failed:', err);
  process.exit(1);
});
