cat > /workspace/src/server.js << 'EOF'
import { WebSocketServer } from 'ws';
import crypto from 'crypto';

export class AAPServer {
  constructor(port = 8080) {
    this.port = port;
    this.wss = null;
    this.started = false;
  }

  async start() {
    return new Promise((resolve, reject) => {
      this.wss = new WebSocketServer({ port: this.port }, () => {
        this.started = true;
        console.log(`AAP Server started on port ${this.port}`);
        console.log('server-started');
        resolve();
      });

      this.wss.on('connection', (ws) => {
        ws.on('message', (data) => this.handleMessage(ws, data));
        ws.on('close', () => console.log('Client disconnected'));
      });
    });
  }

  handleMessage(ws, data) {
    try {
      const request = JSON.parse(data.toString());
      console.log('Received request:', request.type);

      if (request.type === 'verify') {
        const response = this.verifyProof(request.payload);
        ws.send(JSON.stringify(response));
      } else {
        ws.send(JSON.stringify({ error: 'Unknown request type' }));
      }
    } catch (err) {
      ws.send(JSON.stringify({ error: err.message }));
    }
  }

  verifyProof(payload) {
    // Simulate AAP verification logic
    const { identity, proof, timestamp, marker } = payload;
    
    // Verify proof signature (deterministic check)
    const expectedHash = crypto
      .createHash('sha256')
      .update(identity + marker + timestamp)
      .digest('hex');

    const proofValid = proof === expectedHash;

    return {
      type: 'verification-result',
      verified: proofValid,
      identity: identity,
      timestamp: timestamp,
      marker: marker,
      proofDetails: {
        proofHash: proof,
        expectedHash: expectedHash,
        match: proofValid
      }
    };
  }

  stop() {
    if (this.wss) {
      this.wss.close();
    }
  }
}
EOF

