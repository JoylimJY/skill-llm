cat > /workspace/src/client.js << 'EOF'
import { WebSocket } from 'ws';
import crypto from 'crypto';
import fs from 'fs';
import path from 'path';

export class AAPClient {
  constructor(serverUrl = 'ws://localhost:8080/aap') {
    this.serverUrl = serverUrl;
    this.ws = null;
    this.marker = 'AAP-DETERMINISTIC-MARKER-42';
  }

  // Generate deterministic test identity
  generateTestIdentity() {
    return 'test-identity-' + crypto.createHash('sha256').update('aap-demo-2024').digest('hex').slice(0, 8);
  }

  // Generate signed proof payload
  generateProofPayload(identity, timestamp) {
    const proof = crypto
      .createHash('sha256')
      .update(identity + this.marker + timestamp)
      .digest('hex');

    return {
      identity: identity,
      proof: proof,
      timestamp: timestamp,
      marker: this.marker
    };
  }

  async connect() {
    return new Promise((resolve, reject) => {
      this.ws = new WebSocket(this.serverUrl);
      
      this.ws.on('open', () => {
        console.log('Connected to AAP server');
        resolve();
      });

      this.ws.on('error', (err) => reject(err));
    });
  }

  async verify() {
    return new Promise((resolve, reject) => {
      const identity = this.generateTestIdentity();
      const timestamp = Date.now().toString();
      const payload = this.generateProofPayload(identity, timestamp);

      console.log('Sending verification request...');
      console.log('Proof payload:', JSON.stringify(payload, null, 2));

      this.ws.send(JSON.stringify({
        type: 'verify',
        payload: payload
      }));

      this.ws.once('message', (data) => {
        const response = JSON.parse(data.toString());
        console.log('Verification response:', JSON.stringify(response, null, 2));
        resolve({ payload, response });
      });
    });
  }

  async close() {
    if (this.ws) {
      this.ws.close();
    }
  }
}

export async function writeVerificationSummary(result, outputPath = '/workspace/verification-summary.json') {
  const summary = {
    status: result.response.verified ? 'VERIFIED' : 'FAILED',
    marker: result.payload.marker,
    identity: result.payload.identity,
    timestamp: result.payload.timestamp,
    proof: {
      submitted: result.payload.proof,
      verifiedHash: result.response.proofDetails.expectedHash,
      match: result.response.proofDetails.match
    },
    serverResponse: result.response
  };

  fs.writeFileSync(outputPath, JSON.stringify(summary, null, 2));
  console.log(`\nVerification summary written to: ${outputPath}`);
  return summary;
}
EOF

