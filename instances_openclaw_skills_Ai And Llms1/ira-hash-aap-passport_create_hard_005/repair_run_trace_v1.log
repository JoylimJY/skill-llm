cat > /workspace/run.js << 'EOF'
const { wss, PORT } = require('./server');
const { runVerification, generateProof, TEST_IDENTITY } = require('./client');
const fs = require('fs');

async function main() {
  console.log('=== AAP Verification Demo ===\n');
  
  // Wait a moment for server to be ready
  await new Promise(resolve => setTimeout(resolve, 500));
  
  try {
    // Run the verification
    const summary = await runVerification();
    
    // Write server log marker
    fs.writeFileSync('server.log', 'server-started\n');
    
    // Display proof payload for inspection
    console.log('\n=== Signed Proof Payload ===');
    const proof = generateProof(TEST_IDENTITY);
    console.log(JSON.stringify(proof.proof, null, 2));
    console.log('=============================\n');
    
    // Display verification summary
    console.log('=== Verification Summary ===');
    console.log(JSON.stringify(summary, null, 2));
    console.log('=============================\n');
    
    console.log('All outputs written successfully');
    console.log('  - verification-summary.json: Full verification details');
    console.log('  - server.log: Server startup marker');
    
    // Close server
    wss.close();
    
  } catch (err) {
    console.error('Error during verification:', err);
    process.exit(1);
  }
}

main();
EOF

