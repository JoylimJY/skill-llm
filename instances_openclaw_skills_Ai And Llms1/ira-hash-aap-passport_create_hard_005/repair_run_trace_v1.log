[EXECUTING bash]:
cat > /workspace/client.js << 'EOF'
const WebSocket = require('ws');
const crypto = require('crypto');
const fs = require('fs');

const PORT = 8080;
const PATH = '/aap';

// Deterministic test identity
const TEST_IDENTITY = {
  id: 'user-12345',
  name: 'Test User',
  email: 'test@example.com',
  marker: 'AAP-DETERMINISTIC-MARKER-42'
};

// Generate deterministic proof
function generateProof(identity) {
  const salt = 'aap-salt-2024';
  const payload = JSON.stringify(identity);
  const hash = crypto.createHash('sha256').update(payload + salt).digest('hex');
  
  return {
    type: 'verify',
    proof: {
      identity: identity.id,
      payload: payload,
      salt: salt,
      signature: hash.substring(0, 16),
      algorithm: 'sha256-truncated'
    }
  };
}

async function runVerification() {
  console.log('AAP Verification Client');
  console.log('Connecting to ws://localhost:' + PORT + PATH);
  
  const ws = new WebSocket('ws://localhost:' + PORT + PATH);
  
  return new Promise((resolve, reject) => {
    ws.on('open', () => {
      console.log('Connected to server');
      
      // Generate and send proof
      const proofData = generateProof(TEST_IDENTITY);
      console.log('Sending proof:');
      console.log(JSON.stringify(proofData, null, 2));
      
      ws.send(JSON.stringify(proofData));
    });

    ws.on('message', (data) => {
      const response = JSON.parse(data);
      console.log('Received response:', response);
      
      // Create verification summary
      const summary = {
        verification: {
          status: response.status,
          identity: response.identity,
          timestamp: response.timestamp,
          serverHash: response.hash
        },
        clientProof: proofData.proof,
        testIdentity: TEST_IDENTITY,
        marker: TEST_IDENTITY.marker,
        completed: true
      };
      
      // Write summary to file
      fs.writeFileSync('verification-summary.json', JSON.stringify(summary, null, 2));
      console.log('Verification summary written to verification-summary.json');
      
      ws.close();
      resolve(summary);
    });

    ws.on('error', (err) => {
      console.error('WebSocket error:', err);
      reject(err);
    });
  });
}

// Export for use in run.js
module.exports = { runVerification, TEST_IDENTITY, generateProof };

// Run if executed directly
if (require.main === module) {
  runVerification()
    .then(() => console.log('Verification complete'))
    .catch(err => console.error('Verification failed:', err));
}
EOF

