[EXECUTING bash]:
cat > /workspace/server.js << 'EOF'
const WebSocket = require('ws');
const crypto = require('crypto');

const PORT = 8080;
const PATH = '/aap';

// Create WebSocket server
const wss = new WebSocket.Server({ 
  port: PORT,
  path: PATH 
});

console.log(`AAP Verification Server started on ws://localhost:${PORT}${PATH}`);
console.log('server-started');

wss.on('connection', (ws) => {
  console.log('Client connected');

  ws.on('message', (message) => {
    try {
      const data = JSON.parse(message);
      console.log('Received:', JSON.stringify(data, null, 2));

      if (data.type === 'verify') {
        // Perform deterministic verification
        const proof = data.proof;
        
        // Verify the proof signature (simplified deterministic check)
        const hash = crypto.createHash('sha256')
          .update(proof.payload + proof.salt)
          .digest('hex');
        
        const isValid = proof.signature === hash.substring(0, 16);
        
        const response = {
          type: 'verification-result',
          status: isValid ? 'verified' : 'failed',
          identity: proof.identity,
          timestamp: new Date().toISOString(),
          hash: hash
        };

        console.log('Verification result:', response);
        ws.send(JSON.stringify(response));
      }
    } catch (err) {
      console.error('Error processing message:', err);
      ws.send(JSON.stringify({ type: 'error', message: err.message }));
    }
  });

  ws.on('close', () => {
    console.log('Client disconnected');
  });
});

module.exports = { wss, PORT };
EOF

