cat > /workspace/server.js << 'EOF'
const WebSocket = require('ws');
const crypto = require('crypto');

const PORT = process.env.AAP_PORT || 8080;
const PATH = '/aap';

// Deterministic test identity for verification
const TEST_IDENTITY = {
  id: 'user-deterministic-001',
  name: 'AAP Test User',
  email: 'test@aap.example.com',
  marker: 'AAP-DETERMINISTIC-MARKER-42'
};

// Create a simple HMAC-based signing for proof
function createSignedProof(data) {
  const secret = 'aap-verification-secret-key';
  const payload = JSON.stringify(data);
  const signature = crypto.createHmac('sha256', secret).update(payload).digest('hex');
  return {
    payload: payload,
    signature: signature,
    timestamp: Date.now()
  };
}

function verifyProof(proof) {
  const secret = 'aap-verification-secret-key';
  const expectedSignature = crypto.createHmac('sha256', secret).update(proof.payload).digest('hex');
  return proof.signature === expectedSignature;
}

const wss = new WebSocket.Server({ port: PORT, path: PATH });

console.log(`AAP Verification Server started on ws://localhost:${PORT}${PATH}`);

wss.on('connection', (ws) => {
  console.log('Client connected to AAP server');
  
  ws.on('message', (message) => {
    try {
      const request = JSON.parse(message.toString());
      
      if (request.type === 'verify') {
        // Create signed proof for the identity
        const proof = createSignedProof({
          ...TEST_IDENTITY,
          requestNonce: request.nonce || crypto.randomBytes(8).toString('hex')
        });
        
        const verificationResult = {
          type: 'verified',
          identity: TEST_IDENTITY,
          proof: proof,
          verified: true,
          serverTime: Date.now()
        };
        
        ws.send(JSON.stringify(verificationResult));
        console.log('Verification completed successfully');
      }
      
      if (request.type === 'inspect_proof') {
        // Return proof inspection data
        const proof = createSignedProof(TEST_IDENTITY);
        ws.send(JSON.stringify({
          type: 'proof_inspection',
          payload: JSON.parse(proof.payload),
          signature: proof.signature,
          signatureAlgorithm: 'HMAC-SHA256'
        }));
      }
      
    } catch (err) {
      ws.send(JSON.stringify({ type: 'error', message: err.message }));
    }
  });
  
  ws.on('close', () => {
    console.log('Client disconnected');
  });
});

module.exports = { wss, createSignedProof, verifyProof, TEST_IDENTITY };
EOF

