[EXECUTING bash]:
cat > /workspace/client.js << 'EOF'
const WebSocket = require('ws');
const fs = require('fs');
const path = require('path');

const PORT = process.env.AAP_PORT || 8080;
const PATH = '/aap';

async function runVerification() {
  const ws = new WebSocket(`ws://localhost:${PORT}${PATH}`);
  
  return new Promise((resolve, reject) => {
    let verificationResult = null;
    let proofInspection = null;
    
    ws.on('open', () => {
      console.log('Connected to AAP Verification Server');
      // Send verification request
      ws.send(JSON.stringify({ type: 'verify', nonce: 'deterministic-nonce-42' }));
    });
    
    ws.on('message', (data) => {
      const response = JSON.parse(data.toString());
      
      if (response.type === 'verified') {
        verificationResult = response;
        console.log('Received verification result');
        // Request proof inspection
        ws.send(JSON.stringify({ type: 'inspect_proof' }));
      }
      
      if (response.type === 'proof_inspection') {
        proofInspection = response;
        console.log('Received proof inspection data');
        finalize();
      }
    });
    
    ws.on('error', (err) => {
      reject(err);
    });
    
    function finalize() {
      ws.close();
      
      // Create verification summary
      const summary = {
        status: 'success',
        marker: 'AAP-DETERMINISTIC-MARKER-42',
        identity: verificationResult.identity,
        verification: {
          verified: verificationResult.verified,
          timestamp: verificationResult.serverTime
        },
        proof: {
          payload: proofInspection.payload,
          signature: proofInspection.signature,
          algorithm: proofInspection.signatureAlgorithm
        },
        summary: 'AAP verification completed with deterministic test identity'
      };
      
      // Write summary to file
      const summaryPath = path.join(__dirname, 'verification-summary.json');
      fs.writeFileSync(summaryPath, JSON.stringify(summary, null, 2));
      console.log(`Verification summary written to ${summaryPath}`);
      
      // Also output to stdout for automated test validation
      console.log('--- VERIFICATION SUMMARY ---');
      console.log(JSON.stringify(summary, null, 2));
      console.log('--- END SUMMARY ---');
      
      resolve(summary);
    }
  });
}

// Run the verification
runVerification()
  .then(() => {
    console.log('AAP verification flow completed successfully');
    process.exit(0);
  })
  .catch((err) => {
    console.error('Verification failed:', err);
    process.exit(1);
  });
EOF

