cat > /workspace/run.js << 'EOF'
const { spawn } = require('child_process');
const fs = require('fs');
const path = require('path');

const PORT = process.env.AAP_PORT || 8080;

// Write server log marker
const serverLogPath = path.join(__dirname, 'server.log');
fs.writeFileSync(serverLogPath, 'server-started\n', 'utf-8');
console.log('Server log written:', serverLogPath);

// Start the server
const server = spawn('node', ['server.js'], {
  cwd: __dirname,
  env: { ...process.env, AAP_PORT: PORT },
  stdio: ['ignore', 'pipe', 'pipe']
});

let serverOutput = '';
server.stdout.on('data', (data) => {
  serverOutput += data.toString();
  process.stdout.write(data);
});

server.stderr.on('data', (data) => {
  process.stderr.write(data);
});

// Wait for server to start, then run client
setTimeout(() => {
  console.log('\n--- Starting AAP Client Verification ---\n');
  
  const client = spawn('node', ['client.js'], {
    cwd: __dirname,
    env: { ...process.env, AAP_PORT: PORT },
    stdio: 'inherit'
  });
  
  client.on('close', (code) => {
    console.log(`\nClient exited with code ${code}`);
    server.kill();
    
    // Verify output file exists
    const summaryPath = path.join(__dirname, 'verification-summary.json');
    if (fs.existsSync(summaryPath)) {
      console.log('\n✓ Verification summary file created successfully');
      console.log('Location:', summaryPath);
    } else {
      console.log('\n✗ Verification summary file not found');
    }
    
    process.exit(code);
  });
}, 1000);

server.on('error', (err) => {
  console.error('Server failed to start:', err);
  process.exit(1);
});
EOF

