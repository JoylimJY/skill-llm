[EXECUTING bash]:
cat > /workspace/aap-verification/server.js << 'EOF'
const WebSocket = require('ws');
const crypto = require('crypto');
const fs = require('fs');

const PORT = process.env.AAP_PORT || 8765;
const SERVER_LOG_FILE = '/workspace/aap-verification/server-log.txt';

// Server log for verification
fs.writeFileSync(SERVER_LOG_FILE, 'server-started\n', 'utf-8');

const wss = new WebSocket.Server({ port: PORT, path: '/aap' });

console.log(`AAP Verification Server started on ws://localhost:${PORT}/aap`);

wss.on('connection', (ws) => {
  console.log('Client connected to /aap');
  
  ws.on('message', (data) => {
    try {
      const message = JSON.parse(data.toString());
      console.log('Received:', JSON.stringify(message));
      
      if (message.type === 'verify_request') {
        // Process verification request
        const { identity, challenge } = message;
        
        // Create a deterministic proof using the identity and challenge
        const proofPayload = {
          identity,
          challenge,
          timestamp: Date.now(),
          marker: 'AAP-DETERMINISTIC-MARKER-42'
        };
        
        // Sign the proof payload (simulated signing with HMAC)
        const secret = 'aap-deterministic-secret-key';
        const signature = crypto
          .createHmac('sha256', secret)
          .update(JSON.stringify(proofPayload))
          .digest('hex');
        
        const proof = {
          payload: proofPayload,
          signature
        };
        
        // Verify response
        const response = {
          type: 'verify_response',
          verified: true,
          proof,
          summary: {
            identity: identity,
            marker: 'AAP-DETERMINISTIC-MARKER-42',
            verified: true,
            timestamp: new Date().toISOString()
          }
        };
        
        ws.send(JSON.stringify(response));
        console.log('Sent verification response');
      }
    } catch (err) {
      console.error('Error processing message:', err);
      ws.send(JSON.stringify({ type: 'error', message: err.message }));
    }
  });
  
  ws.on('close', () => {
    console.log('Client disconnected');
  });
});

// Keep server running
process.on('SIGINT', () => {
  console.log('Server shutting down...');
  wss.close(() => {
    process.exit(0);
  });
});
EOF

