const fs = require('fs');
const crypto = require('crypto');

const RESULT_FILE = '/workspace/verification-summary.json';
const PROOF_FILE = '/workspace/aap-verification/proof-payload.json';

console.log('=== AAP Verification Test ===\n');

// Read verification summary
const summary = JSON.parse(fs.readFileSync(RESULT_FILE, 'utf-8'));
const proof = JSON.parse(fs.readFileSync(PROOF_FILE, 'utf-8'));

let passed = 0;
let failed = 0;

function test(name, condition) {
  if (condition) {
    console.log(`✓ ${name}`);
    passed++;
  } else {
    console.log(`✗ ${name}`);
    failed++;
  }
}

// Tests
test('Summary file exists', summary !== undefined);
test('Server log indicates started', summary.server_log === 'server-started');
test('Marker matches expected', summary.marker === 'AAP-DETERMINISTIC-MARKER-42');
test('Verification succeeded', summary.verification.verified === true);
test('Identity is present', summary.verification.identity.id === 'test-user-001');

// Verify signature
const secret = 'aap-deterministic-secret-key';
const expectedSignature = crypto
  .createHmac('sha256', secret)
  .update(JSON.stringify(proof.payload))
  .digest('hex');

test('Signature is valid', proof.signature === expectedSignature);
test('Proof contains marker', proof.payload.marker === 'AAP-DETERMINISTIC-MARKER-42');
test('Proof contains challenge', proof.payload.challenge === 'aap-challenge-2024-deterministic');

console.log(`\n=== Results: ${passed} passed, ${failed} failed ===`);
process.exit(failed > 0 ? 1 : 0);
EOF

