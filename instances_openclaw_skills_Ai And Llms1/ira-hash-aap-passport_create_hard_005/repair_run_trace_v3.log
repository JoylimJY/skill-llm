cat > /workspace/aap-verification/client.js << 'EOF'
const WebSocket = require('ws');
const fs = require('fs');
const path = require('path');

const PORT = process.env.AAP_PORT || 8765;
const RESULT_FILE = '/workspace/verification-summary.json';
const PROOF_FILE = '/workspace/aap-verification/proof-payload.json';

// Deterministic test identity
const TEST_IDENTITY = {
  id: 'test-user-001',
  name: 'AAP Test User',
  role: 'verifier'
};

// Deterministic challenge
const CHALLENGE = 'aap-challenge-2024-deterministic';

async function runVerification() {
  return new Promise((resolve, reject) => {
    const ws = new WebSocket(`ws://localhost:${PORT}/aap`);
    
    ws.on('open', () => {
      console.log('Connected to AAP server');
      
      // Send verification request
      const request = {
        type: 'verify_request',
        identity: TEST_IDENTITY,
        challenge: CHALLENGE
      };
      
      ws.send(JSON.stringify(request));
      console.log('Sent verification request');
    });
    
    ws.on('message', (data) => {
      try {
        const response = JSON.parse(data.toString());
        console.log('Received response:', JSON.stringify(response, null, 2));
        
        if (response.type === 'verify_response') {
          // Write verification summary
          const summary = {
            server_log: 'server-started',
            result_file: 'verification-summary.json',
            marker: 'AAP-DETERMINISTIC-MARKER-42',
            verification: response.summary,
            proof_inspection: response.proof
          };
          
          fs.writeFileSync(RESULT_FILE, JSON.stringify(summary, null, 2), 'utf-8');
          console.log(`Verification summary written to ${RESULT_FILE}`);
          
          // Write proof payload for inspection
          fs.writeFileSync(PROOF_FILE, JSON.stringify(response.proof, null, 2), 'utf-8');
          console.log(`Proof payload written to ${PROOF_FILE}`);
          
          ws.close();
          resolve(summary);
        } else if (response.type === 'error') {
          reject(new Error(response.message));
        }
      } catch (err) {
        reject(err);
      }
    });
    
    ws.on('error', reject);
    ws.on('close', () => {
      console.log('Connection closed');
    });
  });
}

// Wait for server to be ready, then run verification
async function main() {
  const delay = (ms) => new Promise(resolve => setTimeout(resolve, ms));
  
  // Wait a bit for server to start
  await delay(500);
  
  try {
    const result = await runVerification();
    console.log('\n=== VERIFICATION COMPLETE ===');
    console.log('Summary:', JSON.stringify(result, null, 2));
    process.exit(0);
  } catch (err) {
    console.error('Verification failed:', err);
    process.exit(1);
  }
}

main();
EOF

