[EXECUTING bash]:
cat > /workspace/attestation.js << 'EOF'
const fs = require('fs');
const path = require('path');
const crypto = require('crypto');

// Read input fixtures
const transcriptPath = path.join(__dirname, 'input_transcript.json');
const markerPath = path.join(__dirname, 'marker.txt');

const transcript = JSON.parse(fs.readFileSync(transcriptPath, 'utf-8'));
const marker = fs.readFileSync(markerPath, 'utf-8').trim();

// Validate transcript structure
function validateTranscript(t) {
  const required = ['protocol', 'requireSignature', 'challengeCount', 'totalTimeMs', 'nonce', 'publicId', 'timestamp', 'answers', 'sessionToken'];
  for (const field of required) {
    if (!(field in t)) {
      throw new Error(`Missing required field: ${field}`);
    }
  }
  if (t.answers.length !== t.challengeCount) {
    throw new Error(`Answer count mismatch: expected ${t.challengeCount}, got ${t.answers.length}`);
  }
  return true;
}

// Derive signed proof payload from transcript
function deriveSignedProof(transcript) {
  // Create a deterministic hash from transcript data
  const proofData = {
    protocol: transcript.protocol,
    nonce: transcript.nonce,
    publicId: transcript.publicId,
    timestamp: transcript.timestamp,
    answersHash: crypto.createHash('sha256').update(transcript.answers.join(':')).digest('hex'),
    challengeCount: transcript.challengeCount
  };
  
  // Generate proof signature (simulated)
  const proofString = JSON.stringify(proofData, Object.keys(proofData).sort());
  const signature = crypto.createHash('sha256').update(proofString).digest('hex');
  
  return {
    ...proofData,
    signature: signature
  };
}

// Normalize handshake summary
function normalizeHandshakeSummary(transcript) {
  return {
    protocolVersion: transcript.protocol,
    challengesCompleted: transcript.challengeCount,
    allChallengesAnswered: transcript.answers.length === transcript.challengeCount,
    totalTimeMs: transcript.totalTimeMs,
    signatureRequired: transcript.requireSignature,
    nonce: transcript.nonce,
    timestamp: transcript.timestamp
  };
}

// Main execution
try {
  // Validate the transcript
  validateTranscript(transcript);
  
  // Derive the signed proof
  const signedProof = deriveSignedProof(transcript);
  
  // Create normalized summary
  const handshakeSummary = normalizeHandshakeSummary(transcript);
  
  // Build output report
  const output = {
    verified: {
      publicIdentity: transcript.publicId,
      sessionToken: transcript.sessionToken
    },
    handshake: handshakeSummary,
    proof: signedProof,
    marker: marker,
    status: "VERIFIED"
  };
  
  // Write output.json
  const outputPath = path.join(__dirname, 'output.json');
  fs.writeFileSync(outputPath, JSON.stringify(output, null, 2), 'utf-8');
  
  console.log('Attestation handshake completed successfully.');
  console.log(`Output written to: ${outputPath}`);
  console.log(`Verified public identity: ${transcript.publicId}`);
  console.log(`Session token: ${transcript.sessionToken}`);
  console.log(`Marker processed: ${marker}`);
  
} catch (error) {
  console.error('Attestation failed:', error.message);
  process.exit(1);
}
EOF

