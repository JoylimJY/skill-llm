[EXECUTING bash]:
cat > /workspace/attestation.js << 'EOF'
const fs = require('fs');
const path = require('path');
const crypto = require('crypto');

// Read input fixtures
const transcriptPath = path.join(__dirname, 'input_transcript.json');
const markerPath = path.join(__dirname, 'marker.txt');

const transcript = JSON.parse(fs.readFileSync(transcriptPath, 'utf-8'));
const marker = fs.readFileSync(markerPath, 'utf-8').trim();

// Validate transcript structure
function validateTranscript(t) {
  const required = ['protocol', 'requireSignature', 'challengeCount', 'nonce', 'publicId', 'timestamp', 'answers', 'sessionToken'];
  for (const field of required) {
    if (!(field in t)) {
      throw new Error(`Missing required field: ${field}`);
    }
  }
  if (t.answers.length !== t.challengeCount) {
    throw new Error('Answer count does not match challenge count');
  }
  return true;
}

// Derive signed proof payload
function deriveSignedProof(transcript, marker) {
  const proofData = {
    protocol: transcript.protocol,
    publicId: transcript.publicId,
    nonce: transcript.nonce,
    challengeCount: transcript.challengeCount,
    answersHash: crypto.createHash('sha256')
      .update(transcript.answers.join('|'))
      .digest('hex'),
    marker: marker,
    timestamp: transcript.timestamp
  };
  
  // Create a signature over the proof data
  const signatureInput = JSON.stringify(proofData, Object.keys(proofData).sort());
  const signature = crypto.createHash('sha256')
    .update(signatureInput + transcript.sessionToken)
    .digest('hex')
    .substring(0, 32);
  
  return {
    proof: proofData,
    signature
  };
}

// Perform attestation handshake simulation
function performAttestationHandshake(transcript, marker) {
  validateTranscript(transcript);
  
  const signedProof = deriveSignedProof(transcript, marker);
  
  // Verify all challenges were answered
  const allChallengesAnswered = transcript.answers.length === transcript.challengeCount;
  
  // Build normalized summary
  const normalizedSummary = {
    protocolVersion: transcript.protocol.split(' ')[2],
    challengesProcessed: transcript.challengeCount,
    answersProvided: transcript.answers.length,
    allChallengesAnswered: allChallengesAnswered,
    signatureRequired: transcript.requireSignature,
    signaturePresent: signedProof.signature !== undefined,
    totalDurationMs: transcript.totalTimeMs,
    markerVerified: marker === 'AAP_MARKER_7F3A9C'
  };
  
  // Verification result
  const verificationResult = {
    verified: allChallengesAnswered && normalizedSummary.markerVerified,
    publicIdentity: transcript.publicId,
    sessionToken: transcript.sessionToken,
    summary: normalizedSummary,
    signedProof: signedProof
  };
  
  return verificationResult;
}

// Main execution
const result = performAttestationHandshake(transcript, marker);

// Write output.json
const outputPath = path.join(__dirname, 'output.json');
fs.writeFileSync(outputPath, JSON.stringify(result, null, 2), 'utf-8');

console.log('Attestation handshake completed.');
console.log('Output written to:', outputPath);
console.log('Verified:', result.verified);
console.log('Public Identity:', result.publicIdentity);
console.log('Session Token:', result.sessionToken);
EOF

