[EXECUTING bash]:
cat > /workspace/attestation.js << 'EOF'
const fs = require('fs');
const path = require('path');
const crypto = require('crypto');

// Read input fixtures
const transcriptPath = path.join(__dirname, 'input_transcript.json');
const markerPath = path.join(__dirname, 'marker.txt');

const transcript = JSON.parse(fs.readFileSync(transcriptPath, 'utf-8'));
const marker = fs.readFileSync(markerPath, 'utf-8').trim();

// Validate the transcript structure
function validateTranscript(t) {
    const required = ['protocol', 'requireSignature', 'challengeCount', 'totalTimeMs', 'nonce', 'publicId', 'timestamp', 'answers', 'sessionToken'];
    for (const field of required) {
        if (!(field in t)) {
            throw new Error(`Missing required field: ${field}`);
        }
    }
    if (t.answers.length !== t.challengeCount) {
        throw new Error('Answer count does not match challenge count');
    }
    return true;
}

// Derive signed proof payload from the transcript
function deriveSignedProofPayload(t) {
    const proofData = {
        nonce: t.nonce,
        publicId: t.publicId,
        timestamp: t.timestamp,
        challengeCount: t.challengeCount,
        answerHash: crypto.createHash('sha256').update(t.answers.join(':')).digest('hex')
    };
    const proofString = JSON.stringify(proofData, Object.keys(proofData).sort());
    return crypto.createHash('sha256').update(proofString).digest('hex');
}

// Normalize the handshake summary
function normalizeHandshakeSummary(t) {
    return {
        protocol: t.protocol,
        challengesCompleted: t.answers.length,
        totalTimeMs: t.totalTimeMs,
        signatureRequired: t.requireSignature,
        nonce: t.nonce,
        allChallengesPassed: t.answers.length === t.challengeCount
    };
}

// Verify and process
validateTranscript(transcript);
const signedProof = deriveSignedProofPayload(transcript);
const summary = normalizeHandshakeSummary(transcript);

// Build output report
const output = {
    verified: {
        publicIdentity: transcript.publicId,
        sessionToken: transcript.sessionToken
    },
    handshake: {
        summary: summary,
        signedProof: signedProof
    },
    marker: marker
};

// Write output
const outputPath = path.join(__dirname, 'output.json');
fs.writeFileSync(outputPath, JSON.stringify(output, null, 2), 'utf-8');

console.log('Attestation handshake verification complete.');
console.log('Output written to:', outputPath);
EOF

