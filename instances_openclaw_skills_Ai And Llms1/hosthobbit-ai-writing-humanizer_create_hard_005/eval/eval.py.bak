import json
import os
import re
import sys
from pathlib import Path


def normalize(text):
    try:
        text = text.lower()
        text = re.sub(r'[^a-z0-9]+', ' ', text)
        return re.sub(r'\s+', ' ', text).strip()
    except Exception:
        return ''


def main():
    checks = []
    workspace = Path(sys.argv[1]) if len(sys.argv) > 1 else Path('.')
    out_path = workspace / 'output.txt'
    input_path = workspace / 'input.txt'

    # Check 1: output exists
    try:
        exists = out_path.exists()
        checks.append({
            'name': 'output_exists',
            'passed': bool(exists),
            'detail': 'output.txt found' if exists else 'output.txt is missing'
        })
    except Exception as e:
        checks.append({
            'name': 'output_exists',
            'passed': False,
            'detail': f'error checking output existence: {e}'
        })

    # Check 2: output removes stock phrases
    try:
        text = out_path.read_text(encoding='utf-8', errors='replace') if out_path.exists() else ''
        norm = normalize(text)
        banned = [
            'at the end of the day',
            'first',
            'secondly',
            'i hope this helps',
            'let me know if you have any questions'
        ]
        present = [phrase for phrase in banned if normalize(phrase) in norm]
        passed = len(present) == 0 and bool(norm)
        checks.append({
            'name': 'no_stock_phrases',
            'passed': passed,
            'detail': 'banned phrases present: ' + ', '.join(present) if present else 'stock phrases removed'
        })
    except Exception as e:
        checks.append({
            'name': 'no_stock_phrases',
            'passed': False,
            'detail': f'error analyzing output text: {e}'
        })

    # Check 3: meaning preserved with key facts
    try:
        text = out_path.read_text(encoding='utf-8', errors='replace') if out_path.exists() else ''
        norm = normalize(text)
        required_groups = [
            ['project', 'successful'],
            ['team', 'timeline', 'budget'],
            ['planning', 'phase'],
            ['implementation', 'phase'],
            ['schedule']
        ]
        group_results = []
        for group in required_groups:
            group_results.append(any(all(term in norm for term in [normalize(t) for t in group]) for _ in [0]))
        passed = all(group_results)
        checks.append({
            'name': 'meaning_preserved',
            'passed': passed,
            'detail': 'required concepts found' if passed else 'some required concepts are missing'
        })
    except Exception as e:
        checks.append({
            'name': 'meaning_preserved',
            'passed': False,
            'detail': f'error checking meaning preservation: {e}'
        })

    # Check 4: output is reasonably concise and not identical to input
    try:
        out_text = out_path.read_text(encoding='utf-8', errors='replace') if out_path.exists() else ''
        in_text = input_path.read_text(encoding='utf-8', errors='replace') if input_path.exists() else ''
        passed = bool(out_text.strip()) and normalize(out_text) != normalize(in_text)
        checks.append({
            'name': 'not_identical_to_input',
            'passed': passed,
            'detail': 'output differs from input' if passed else 'output is empty or too similar to input'
        })
    except Exception as e:
        checks.append({
            'name': 'not_identical_to_input',
            'passed': False,
            'detail': f'error comparing input and output: {e}'
        })

    total = len(checks)
    passed_count = sum(1 for c in checks if c.get('passed'))
    result = {
        'passed': passed_count == total,
        'score': (passed_count / total) if total else 0.0,
        'checks': checks,
    }
    print(json.dumps(result, ensure_ascii=False))


if __name__ == '__main__':
    try:
        main()
    except Exception as e:
        print(json.dumps({'passed': False, 'score': 0.0, 'checks': [{'name': 'fatal_error', 'passed': False, 'detail': str(e)}]}))
