cat > /workspace/agents/analyst/run.py << 'EOF'
#!/usr/bin/env python3
import json
from datetime import datetime

# Update status to running
status = {
    "agent": "analyst",
    "status": "running",
    "started_at": datetime.now().isoformat(),
    "completed_at": None,
    "input_file": "/workspace/agents/data-collector/workspace/extracted_metrics.json",
    "output_file": "/workspace/agents/analyst/workspace/trend_analysis.json",
    "message": "Analyzing metrics..."
}
with open("/workspace/agents/analyst/status.json", "w") as f:
    json.dump(status, f, indent=2)

# Read extracted metrics
with open("/workspace/agents/data-collector/workspace/extracted_metrics.json", "r") as f:
    metrics = json.load(f)

# Analyze sectors and identify top 3 trends
# Sort by growth rate to identify trends
sectors_by_growth = sorted(metrics["sectors"], key=lambda x: x["growth_rate"], reverse=True)

# Define sentiment scores
sentiment_scores = {
    "very_bullish": 4,
    "bullish": 3,
    "neutral": 2,
    "bearish": 1,
    "very_bearish": 0
}

# Calculate composite score for trend ranking
def calculate_trend_score(sector):
    growth_score = sector["growth_rate"]
    sentiment_score = sentiment_scores.get(sector["sentiment"], 2) * 10
    size_score = sector["market_size_bn"] / 100
    return growth_score + sentiment_score + size_score

ranked_sectors = sorted(sectors_by_growth, key=calculate_trend_score, reverse=True)

# Identify top 3 trends
top_trends = []
for i, sector in enumerate(ranked_sectors[:3]):
    trend = {
        "rank": i + 1,
        "sector": sector["name"],
        "growth_rate": sector["growth_rate"],
        "market_size_bn": sector["market_size_bn"],
        "sentiment": sector["sentiment"],
        "key_players": sector["key_players"],
        "insight": f"{sector['name']} leads with {sector['growth_rate']}% growth and {sector['sentiment']} sentiment"
    }
    top_trends.append(trend)

# Create trend analysis output
trend_analysis = {
    "analysis_id": metrics["analysis_id"],
    "report_date": metrics["report_date"],
    "overall_market_growth": metrics["overall_market_growth"],
    "total_market_size_bn": metrics["total_market_size_bn"],
    "top_3_trends": top_trends,
    "methodology": "Trends ranked by composite score: growth_rate + (sentiment_score * 10) + (market_size_bn / 100)",
    "sectors_analyzed": len(metrics["sectors"])
}

# Write trend analysis
with open("/workspace/agents/analyst/workspace/trend_analysis.json", "w") as f:
    json.dump(trend_analysis, f, indent=2)

# Update status to completed
status["status"] = "completed"
status["completed_at"] = datetime.now().isoformat()
status["message"] = "Successfully identified top 3 market trends"
with open("/workspace/agents/analyst/status.json", "w") as f:
    json.dump(status, f, indent=2)

print("Analyst completed successfully!")
EOF
