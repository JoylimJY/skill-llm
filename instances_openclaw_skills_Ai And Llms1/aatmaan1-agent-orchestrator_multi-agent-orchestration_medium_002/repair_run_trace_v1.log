#!/usr/bin/env python3
import json
from datetime import datetime

# Update status to running
status = {
    "agent": "data-collector",
    "status": "running",
    "started_at": datetime.now().isoformat(),
    "completed_at": None,
    "input_file": "/workspace/raw_market_data.json",
    "output_file": "/workspace/agents/data-collector/workspace/extracted_metrics.json",
    "message": "Processing data..."
}
with open("/workspace/agents/data-collector/status.json", "w") as f:
    json.dump(status, f, indent=2)

# Read raw market data
with open("/workspace/raw_market_data.json", "r") as f:
    raw_data = json.load(f)

# Extract key metrics
extracted_metrics = {
    "report_date": raw_data["report_date"],
    "overall_market_growth": raw_data["overall_market_growth"],
    "total_market_size_bn": raw_data["total_market_size_bn"],
    "analysis_id": raw_data["analysis_id"],
    "sectors": []
}

for sector in raw_data["sectors"]:
    extracted_metrics["sectors"].append({
        "name": sector["name"],
        "growth_rate": sector["growth_rate"],
        "market_size_bn": sector["market_size_bn"],
        "key_players": sector["key_players"],
        "sentiment": sector["sentiment"],
        "marker": sector["marker"]
    })

# Write extracted metrics
with open("/workspace/agents/data-collector/workspace/extracted_metrics.json", "w") as f:
    json.dump(extracted_metrics, f, indent=2)

# Update status to completed
status["status"] = "completed"
status["completed_at"] = datetime.now().isoformat()
status["message"] = "Successfully extracted metrics from raw_market_data.json"
with open("/workspace/agents/data-collector/status.json", "w") as f:
    json.dump(status, f, indent=2)

print("Data collector completed successfully!")
EOF
