python << 'EOF'
import json

# Analyst Agent
print("=== Running Analyst Agent ===")

# Read extracted metrics
with open('/workspace/data-collector/outbox/extracted_metrics.json', 'r') as f:
    metrics = json.load(f)

# Analyze sectors and identify top 3 trends
sectors = metrics["sectors"]

# Sort sectors by growth rate
sorted_by_growth = sorted(sectors, key=lambda x: x["growth_rate"], reverse=True)

# Identify top 3 trends based on growth rate and sentiment
trends = []

# Trend 1: Highest growth sector
top_growth = sorted_by_growth[0]
trends.append({
    "rank": 1,
    "trend_name": f"{top_growth['name']} Leading Market Growth",
    "sector": top_growth["name"],
    "growth_rate": top_growth["growth_rate"],
    "market_size_bn": top_growth["market_size_bn"],
    "sentiment": top_growth["sentiment"],
    "key_players": top_growth["key_players"],
    "insight": f"{top_growth['name']} is experiencing exceptional growth at {top_growth['growth_rate']}%, making it the fastest-growing sector with a market size of ${top_growth['market_size_bn']}B."
})

# Trend 2: Second highest growth
second_growth = sorted_by_growth[1]
trends.append({
    "rank": 2,
    "trend_name": f"{second_growth['name']} Strong Expansion",
    "sector": second_growth["name"],
    "growth_rate": second_growth["growth_rate"],
    "market_size_bn": second_growth["market_size_bn"],
    "sentiment": second_growth["sentiment"],
    "key_players": second_growth["key_players"],
    "insight": f"{second_growth['name']} shows robust expansion at {second_growth['growth_rate']}% growth, positioning it as a key growth driver with ${second_growth['market_size_bn']}B market size."
})

# Trend 3: Third highest growth
third_growth = sorted_by_growth[2]
trends.append({
    "rank": 3,
    "trend_name": f"{third_growth['name']} Steady Growth",
    "sector": third_growth["name"],
    "growth_rate": third_growth["growth_rate"],
    "market_size_bn": third_growth["market_size_bn"],
    "sentiment": third_growth["sentiment"],
    "key_players": third_growth["key_players"],
    "insight": f"{third_growth['name']} maintains solid growth trajectory at {third_growth['growth_rate']}%, contributing significantly to overall market performance."
})

# Sector rankings
sector_rankings = []
for i, sector in enumerate(sorted_by_growth, 1):
    sector_rankings.append({
        "rank": i,
        "name": sector["name"],
        "growth_rate": sector["growth_rate"],
        "market_size_bn": sector["market_size_bn"],
        "sentiment": sector["sentiment"]
    })

# Analysis results
analysis_results = {
    "report_date": metrics["report_date"],
    "overall_market_growth": metrics["overall_market_growth"],
    "total_market_size_bn": metrics["total_market_size_bn"],
    "analysis_id": metrics["analysis_id"],
    "top_3_trends": trends,
    "sector_rankings": sector_rankings,
    "market_summary": {
        "total_sectors": metrics["summary"]["total_sectors"],
        "positive_growth_count": metrics["summary"]["positive_growth_sectors"],
        "negative_growth_count": metrics["summary"]["negative_growth_sectors"],
        "bullish_sectors": metrics["summary"]["bullish_sectors"],
        "bearish_sectors": metrics["summary"]["bearish_sectors"]
    }
}

# Save analysis results
with open('/workspace/analyst/outbox/analysis_results.json', 'w') as f:
    json.dump(analysis_results, f, indent=2)

print(f"Identified top 3 trends:")
for trend in trends:
    print(f"  {trend['rank']}. {trend['trend_name']} ({trend['growth_rate']}% growth)")

# Update status
status = {
    "agent": "analyst",
    "status": "completed",
    "input_file": "/workspace/data-collector/outbox/extracted_metrics.json",
    "output_file": "outbox/analysis_results.json"
}
with open('/workspace/analyst/status.json', 'w') as f:
    json.dump(status, f, indent=2)

print("Analyst Agent: COMPLETED")
EOF

