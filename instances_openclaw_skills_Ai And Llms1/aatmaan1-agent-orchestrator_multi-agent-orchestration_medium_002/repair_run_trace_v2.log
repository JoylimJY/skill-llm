python << 'EOF'
import json

# Data Collector Agent
print("=== Running Data Collector Agent ===")

# Read raw market data
with open('/workspace/raw_market_data.json', 'r') as f:
    raw_data = json.load(f)

# Extract key metrics
extracted_metrics = {
    "report_date": raw_data["report_date"],
    "overall_market_growth": raw_data["overall_market_growth"],
    "total_market_size_bn": raw_data["total_market_size_bn"],
    "analysis_id": raw_data["analysis_id"],
    "sectors": [],
    "summary": {
        "total_sectors": len(raw_data["sectors"]),
        "positive_growth_sectors": 0,
        "negative_growth_sectors": 0,
        "bullish_sectors": [],
        "bearish_sectors": []
    }
}

for sector in raw_data["sectors"]:
    sector_data = {
        "name": sector["name"],
        "growth_rate": sector["growth_rate"],
        "market_size_bn": sector["market_size_bn"],
        "key_players": sector["key_players"],
        "sentiment": sector["sentiment"],
        "marker": sector["marker"]
    }
    extracted_metrics["sectors"].append(sector_data)
    
    # Update summary
    if sector["growth_rate"] > 0:
        extracted_metrics["summary"]["positive_growth_sectors"] += 1
    else:
        extracted_metrics["summary"]["negative_growth_sectors"] += 1
    
    if sector["sentiment"] in ["bullish", "very_bullish"]:
        extracted_metrics["summary"]["bullish_sectors"].append(sector["name"])
    elif sector["sentiment"] == "bearish":
        extracted_metrics["summary"]["bearish_sectors"].append(sector["name"])

# Save extracted metrics
with open('/workspace/data-collector/outbox/extracted_metrics.json', 'w') as f:
    json.dump(extracted_metrics, f, indent=2)

print(f"Extracted metrics for {extracted_metrics['summary']['total_sectors']} sectors")
print(f"Positive growth: {extracted_metrics['summary']['positive_growth_sectors']}")
print(f"Bearish sectors: {extracted_metrics['summary']['bearish_sectors']}")

# Update status
status = {
    "agent": "data-collector",
    "status": "completed",
    "input_file": "/workspace/raw_market_data.json",
    "output_file": "outbox/extracted_metrics.json"
}
with open('/workspace/data-collector/status.json', 'w') as f:
    json.dump(status, f, indent=2)

print("Data Collector Agent: COMPLETED")
EOF

