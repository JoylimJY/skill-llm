import json
import datetime

# Data Collector Agent Execution
print("=== Running Data Collector Agent ===")

# Update status to running
with open('/workspace/agents/data-collector/status.json', 'w') as f:
    json.dump({
        "agent": "data-collector",
        "status": "running",
        "started_at": datetime.datetime.now().isoformat(),
        "completed_at": None,
        "output_file": None,
        "message": "Processing raw market data..."
    }, f, indent=2)

# Read raw market data
with open('/workspace/raw_market_data.json', 'r') as f:
    raw_data = json.load(f)

# Extract key metrics
extracted_metrics = {
    "report_date": raw_data["report_date"],
    "analysis_id": raw_data["analysis_id"],
    "overall_market_growth": raw_data["overall_market_growth"],
    "total_market_size_bn": raw_data["total_market_size_bn"],
    "sectors": [],
    "positive_growth_sectors": [],
    "negative_growth_sectors": []
}

for sector in raw_data["sectors"]:
    sector_data = {
        "name": sector["name"],
        "growth_rate": sector["growth_rate"],
        "market_size_bn": sector["market_size_bn"],
        "sentiment": sector["sentiment"],
        "key_players": sector["key_players"],
        "marker": sector["marker"]
    }
    extracted_metrics["sectors"].append(sector_data)
    
    if sector["growth_rate"] > 0:
        extracted_metrics["positive_growth_sectors"].append(sector["name"])
    else:
        extracted_metrics["negative_growth_sectors"].append(sector["name"])

# Save extracted metrics
with open('/workspace/agents/data-collector/extracted_metrics.json', 'w') as f:
    json.dump(extracted_metrics, f, indent=2)

print(f"Extracted {len(extracted_metrics['sectors'])} sectors")
print(f"Positive growth: {len(extracted_metrics['positive_growth_sectors'])} sectors")
print(f"Negative growth: {len(extracted_metrics['negative_growth_sectors'])} sectors")

# Update status to completed
with open('/workspace/agents/data-collector/status.json', 'w') as f:
    json.dump({
        "agent": "data-collector",
        "status": "completed",
        "started_at": datetime.datetime.now().isoformat(),
        "completed_at": datetime.datetime.now().isoformat(),
        "output_file": "/workspace/agents/data-collector/extracted_metrics.json",
        "message": "Successfully extracted metrics from raw market data"
    }, f, indent=2)

print("Data Collector Agent: COMPLETED")

