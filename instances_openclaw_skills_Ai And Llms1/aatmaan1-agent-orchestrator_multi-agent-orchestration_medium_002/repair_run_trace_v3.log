import json
import datetime

# Analyst Agent Execution
print("=== Running Analyst Agent ===")

# Update status to running
with open('/workspace/agents/analyst/status.json', 'w') as f:
    json.dump({
        "agent": "analyst",
        "status": "running",
        "started_at": datetime.datetime.now().isoformat(),
        "completed_at": None,
        "output_file": None,
        "message": "Analyzing extracted metrics..."
    }, f, indent=2)

# Read extracted metrics
with open('/workspace/agents/data-collector/extracted_metrics.json', 'r') as f:
    metrics = json.load(f)

# Analyze and identify top 3 trends
sectors = metrics["sectors"]

# Sort sectors by growth rate to find top performers
sorted_by_growth = sorted(sectors, key=lambda x: x["growth_rate"], reverse=True)

# Identify trends based on growth, sentiment, and market dynamics
trends = []

# Trend 1: AI/ML Infrastructure leading growth
top_growth = sorted_by_growth[0]
trends.append({
    "rank": 1,
    "trend": "AI/ML Infrastructure Dominance",
    "sector": top_growth["name"],
    "growth_rate": top_growth["growth_rate"],
    "market_size_bn": top_growth["market_size_bn"],
    "sentiment": top_growth["sentiment"],
    "key_players": top_growth["key_players"],
    "analysis": f"The AI/ML Infrastructure sector is experiencing exceptional growth at {top_growth['growth_rate']}%, making it the fastest-growing segment. With NVIDIA, AMD, and Intel as key players, this sector represents the strongest investment opportunity."
})

# Trend 2: Cloud Computing maintains strong position
cloud = sorted_by_growth[1]
trends.append({
    "rank": 2,
    "trend": "Cloud Computing Expansion",
    "sector": cloud["name"],
    "growth_rate": cloud["growth_rate"],
    "market_size_bn": cloud["market_size_bn"],
    "sentiment": cloud["sentiment"],
    "key_players": cloud["key_players"],
    "analysis": f"Cloud Computing continues to demonstrate robust growth at {cloud['growth_rate']}% with the largest market size of ${cloud['market_size_bn']}B. AWS, Azure, and GCP maintain their leadership positions in this mature but still expanding market."
})

# Trend 3: Edge Computing emerging opportunity
edge = sorted_by_growth[2]
trends.append({
    "rank": 3,
    "trend": "Edge Computing Emergence",
    "sector": edge["name"],
    "growth_rate": edge["growth_rate"],
    "market_size_bn": edge["market_size_bn"],
    "sentiment": edge["sentiment"],
    "key_players": edge["key_players"],
    "analysis": f"Edge Computing shows strong growth momentum at {edge['growth_rate']}%, representing an emerging opportunity. Cloudflare, Fastly, and Akamai are positioned to capitalize on the shift toward distributed computing architectures."
})

# Create trend analysis output
trend_analysis = {
    "analysis_id": metrics["analysis_id"],
    "report_date": metrics["report_date"],
    "overall_market_growth": metrics["overall_market_growth"],
    "total_market_size_bn": metrics["total_market_size_bn"],
    "top_3_trends": trends,
    "sector_rankings": [
        {"rank": i+1, "sector": s["name"], "growth_rate": s["growth_rate"]}
        for i, s in enumerate(sorted_by_growth)
    ],
    "sentiment_summary": {
        "very_bullish": sum(1 for s in sectors if s["sentiment"] == "very_bullish"),
        "bullish": sum(1 for s in sectors if s["sentiment"] == "bullish"),
        "bearish": sum(1 for s in sectors if s["sentiment"] == "bearish")
    }
}

# Save trend analysis
with open('/workspace/agents/analyst/trend_analysis.json', 'w') as f:
    json.dump(trend_analysis, f, indent=2)

print(f"Identified top 3 trends:")
for t in trends:
    print(f"  {t['rank']}. {t['trend']} ({t['growth_rate']}% growth)")

# Update status to completed
with open('/workspace/agents/analyst/status.json', 'w') as f:
    json.dump({
        "agent": "analyst",
        "status": "completed",
        "started_at": datetime.datetime.now().isoformat(),
        "completed_at": datetime.datetime.now().isoformat(),
        "output_file": "/workspace/agents/analyst/trend_analysis.json",
        "message": "Successfully identified top 3 market trends"
    }, f, indent=2)

print("Analyst Agent: COMPLETED")

