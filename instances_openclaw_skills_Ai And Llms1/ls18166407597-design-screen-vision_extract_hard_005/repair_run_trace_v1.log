import pytesseract
from PIL import Image, ImageFilter, ImageOps
import json
import numpy as np

# Open the image
img = Image.open('/workspace/screen_capture.png')

# Convert to grayscale and enhance contrast
gray = img.convert('L')
# Apply some sharpening
enhanced = gray.point(lambda x: 0 if x < 10 else (255 if x > 200 else x))

# Try different PSM configurations
results = {}

# PSM 3 - Fully automatic
data3 = pytesseract.image_to_data(enhanced, lang='eng+chi_tra+chi_sim', output_type=pytesseract.Output.DICT, config='--psm 3')

# PSM 6 - Uniform block
data6 = pytesseract.image_to_data(enhanced, lang='eng+chi_tra+chi_sim', output_type=pytesseract.Output.DICT, config='--psm 6')

# PSM 11 - Sparse text
data11 = pytesseract.image_to_data(enhanced, lang='eng+chi_tra+chi_sim', output_type=pytesseract.Output.DICT, config='--psm 11')

# Combine all results and deduplicate
all_items = {}

for data in [data3, data6, data11]:
    for i in range(len(data['text'])):
        text = data['text'][i].strip()
        conf = int(data['conf'][i])
        
        if text and conf > 40:
            x = int(data['left'][i])
            y = int(data['top'][i])
            w = int(data['width'][i])
            h = int(data['height'][i])
            
            # Use position as key for deduplication
            key = (x, y, w, h)
            if key not in all_items or conf > all_items[key]['confidence']:
                all_items[key] = {
                    "text": text,
                    "x": x,
                    "y": y,
                    "width": w,
                    "height": h,
                    "confidence": conf
                }

# Convert to list and sort
text_items = list(all_items.values())
text_items.sort(key=lambda x: (x['y'] // 20 * 20, x['x']))

# Save to JSON
with open('/workspace/screen_text_map.json', 'w', encoding='utf-8') as f:
    json.dump(text_items, f, ensure_ascii=False, indent=2)

print(f"Extracted {len(text_items)} text items:")
