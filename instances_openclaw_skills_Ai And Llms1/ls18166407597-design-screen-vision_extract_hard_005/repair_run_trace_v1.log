data = pytesseract.image_to_data(img, lang='eng+chi_sim', output_type=pytesseract.Output.DICT, config='--psm 6')

# Group text fragments by line
fragments = []
for i in range(len(data['text'])):
    text = data['text'][i].strip()
    conf = int(data['conf'][i])
    
    if text and conf > 30:
        x = int(data['left'][i])
        y = int(data['top'][i])
        w = int(data['width'][i])
        h = int(data['height'][i])
        
        fragments.append({
            'text': text,
            'x': x,
            'y': y,
            'width': w,
            'height': h,
            'confidence': conf
        })

# Group by line (y within 15 pixels)
lines = {}
for frag in fragments:
    line_key = frag['y'] // 15 * 15
    if line_key not in lines:
        lines[line_key] = []
    lines[line_key].append(frag)

# Merge fragments on same line into logical text items
text_items = []
for line_y, frags in sorted(lines.items()):
    # Sort by x position
    frags.sort(key=lambda f: f['x'])
    
    # Try to merge adjacent fragments
    current_items = []
    i = 0
    while i < len(frags):
        frag = frags[i]
        # Check if next fragment is close enough to merge
        next_frag = frags[i + 1] if i + 1 < len(frags) else None
        
        if next_frag and next_frag['x'] - (frag['x'] + frag['width']) < 15:
            # Merge these fragments
            merged_text = frag['text'] + " " + next_frag['text']
            merged_x = frag['x']
            merged_y = frag['y']
            merged_w = next_frag['x'] + next_frag['width'] - merged_x
            merged_h = max(frag['height'], next_frag['height'])
            merged_conf = (frag['confidence'] + next_frag['confidence']) // 2
            
            # Keep merging if more fragments are close
            j = i + 2
            while j < len(frags):
                next_frag2 = frags[j]
                if next_frag2['x'] - (merged_x + merged_w) < 15:
                    merged_text += " " + next_frag2['text']
                    merged_w = next_frag2['x'] + next_frag2['width'] - merged_x
                    merged_h = max(merged_h, next_frag2['height'])
                    merged_conf = (merged_conf * (j - i) + next_frag2['confidence']) // (j - i + 1)
                    j += 1
                else:
                    break
            
            current_items.append({
                "text": merged_text,
                "x": merged_x,
                "y": merged_y,
                "width": merged_w,
                "height": merged_h,
                "confidence": merged_conf
            })
            i = j
        else:
            current_items.append({
