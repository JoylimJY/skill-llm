[EXECUTING python]:
import pytesseract
from PIL import Image
import json

# Open the image
img = Image.open('/workspace/screen_capture.png')
width, height = img.size

# Try with PSM 4 (assume a single column of text) for better line detection
# Also try PSM 6 for uniform block
data = pytesseract.image_to_data(img, lang='eng+chi_sim', output_type=pytesseract.Output.DICT, config='--psm 6')

# Group text by line (y-coordinate)
lines = {}
for i in range(len(data['text'])):
    text = data['text'][i].strip()
    conf = int(data['conf'][i])
    
    if text and conf > 30:
        x = int(data['left'][i])
        y = int(data['top'][i])
        w = int(data['width'][i])
        h = int(data['height'][i])
        
        # Group by approximate line (y within 10 pixels)
        line_key = y // 10 * 10
        
        if line_key not in lines:
            lines[line_key] = []
        
        lines[line_key].append({
            'text': text,
            'x': x,
            'y': y,
            'width': w,
            'height': h,
            'confidence': conf
        })

# Merge fragments on the same line
text_items = []
for line_y, fragments in sorted(lines.items()):
    # Sort by x position
    fragments.sort(key=lambda f: f['x'])
    
    # Merge adjacent fragments
    merged_text = ""
    merged_x = fragments[0]['x']
    merged_y = fragments[0]['y']
    merged_w = 0
    merged_h = max(f['height'] for f in fragments)
    total_conf = 0
    count = 0
    
    for frag in fragments:
        # Check if this fragment is adjacent to the previous one
        if merged_text and frag['x'] - merged_x - merged_w < 20:
            # Add space if there's a gap
            gap = frag['x'] - merged_x - merged_w
            if gap > 5:
                merged_text += " "
            merged_text += frag['text']
            merged_w = frag['x'] + frag['width'] - merged_x
            total_conf += frag['confidence']
            count += 1
        else:
            # Save previous merged item if exists
            if merged_text:
                text_items.append({
                    "text": merged_text,
                    "x": merged_x,
                    "y": merged_y,
                    "width": merged_w,
                    "height": merged_h,
                    "confidence": int(total_conf / count)
                })
            # Start new merge
            merged_text = frag['text']
            merged_x = frag['x']
            merged_y = frag['y']
            merged_w = frag['width']
            merged_h = frag['height']
            total_conf = frag['confidence']
            count = 1
    
    # Don't forget the last item
    if merged_text:
        text_items.append({
            "text": merged_text,
            "x": merged_x,
            "y": merged_y,
            "width": merged_w,
            "height": merged_h,
            "confidence": int(total_conf / count)
        })

# Save to JSON
with open('/workspace/screen_text_map.json', 'w', encoding='utf-8') as f:
    json.dump(text_items, f, ensure_ascii=False, indent=2)

print(f"Extracted {len(text_items)} text items:")
for item in text_items:
    print(f"  '{item['text']}' at ({item['x']}, {item['y']}) - conf: {item['confidence']}")

