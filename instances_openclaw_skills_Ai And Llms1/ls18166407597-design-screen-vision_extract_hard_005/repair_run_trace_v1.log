# PSM 6 = Assume a single uniform block of text
# PSM 11 = Sparse text, find words instead of lines

# First, let's try PSM 3 with better config
data = pytesseract.image_to_data(img, lang='eng+chi_sim', output_type=pytesseract.Output.DICT, config='--psm 3 -c tessedit_char_whitelist=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789:.,_-取消确认')

# Process results with minimal merging - keep individual words
