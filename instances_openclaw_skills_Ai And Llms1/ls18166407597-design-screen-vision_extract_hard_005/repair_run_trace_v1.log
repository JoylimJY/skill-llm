[EXECUTING python]:
import pytesseract
from PIL import Image, ImageEnhance
import json

# Open the image
img = Image.open('/workspace/screen_capture.png')
width, height = img.size

# Enhance contrast
enhancer = ImageEnhance.Contrast(img.convert('L'))
enhanced = enhancer.enhance(1.5)

# Get word-level data with multiple PSM modes
all_fragments = []

for psm in [3, 6, 11, 13]:
    data = pytesseract.image_to_data(enhanced, lang='eng+chi_tra+chi_sim', output_type=pytesseract.Output.DICT, config=f'--psm {psm}')
    
    for i in range(len(data['text'])):
        text = data['text'][i].strip()
        conf = int(data['conf'][i])
        
        if text and conf > 45:
            x = int(data['left'][i])
            y = int(data['top'][i])
            w = int(data['width'][i])
            h = int(data['height'][i])
            
            all_fragments.append({
                'text': text,
                'x': x,
                'y': y,
                'width': w,
                'height': h,
                'confidence': conf,
                'psm': psm
            })

# Group by line (y within 12 pixels) and merge
lines = {}
for frag in all_fragments:
    line_key = frag['y'] // 12 * 12
    if line_key not in lines:
        lines[line_key] = []
    lines[line_key].append(frag)

# Merge fragments on same line
text_items = []
for line_y, frags in sorted(lines.items()):
    # Sort by x position
    frags.sort(key=lambda f: f['x'])
    
    # Deduplicate overlapping fragments (keep highest confidence)
    deduped = []
    for frag in frags:
        overlap = False
        for existing in deduped:
            # Check if fragments overlap significantly
            if abs(frag['x'] - existing['x']) < 10 and abs(frag['y'] - existing['y']) < 10:
                if frag['confidence'] > existing['confidence']:
                    deduped.remove(existing)
                else:
                    overlap = True
        if not overlap:
            deduped.append(frag)
    
    # Merge adjacent fragments
    if deduped:
        current_line = [deduped[0]]
        for i in range(1, len(deduped)):
            frag = deduped[i]
            last_frag = current_line[-1]
            gap = frag['x'] - (last_frag['x'] + last_frag['width'])
            
            if gap < 15:
                current_line.append(frag)
            else:
                # Save current group
                text_items.append({
                    "text": " ".join(f['text'] for f in current_line),
                    "x": current_line[0]['x'],
                    "y": current_line[0]['y'],
                    "width": current_line[-1]['x'] + current_line[-1]['width'] - current_line[0]['x'],
                    "height": max(f['height'] for f in current_line),
                    "confidence": sum(f['confidence'] for f in current_line) // len(current_line)
                })
                current_line = [frag]
        
        # Last group
        if current_line:
            text_items.append({
                "text": " ".join(f['text'] for f in current_line),
                "x": current_line[0]['x'],
                "y": current_line[0]['y'],
                "width": current_line[-1]['x'] + current_line[-1]['width'] - current_line[0]['x'],
                "height": max(f['height'] for f in current_line),
                "confidence": sum(f['confidence'] for f in current_line) // len(current_line)
            })

# Sort by position
text_items.sort(key=lambda x: (x['y'] // 20 * 20, x['x']))

# Save to JSON
with open('/workspace/screen_text_map.json', 'w', encoding='utf-8') as f:
    json.dump(text_items, f, ensure_ascii=False, indent=2)

print(f"Extracted {len(text_items)} text items:")
for item in text_items:
    print(f"  '{item['text']}' at ({item['x']}, {item['y']}) - conf: {item['confidence']}")

