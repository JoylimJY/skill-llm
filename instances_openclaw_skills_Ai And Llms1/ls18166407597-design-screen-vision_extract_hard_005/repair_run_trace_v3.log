    combined_text = combined_text.replace('cannotbe', 'cannot be')
    combined_text = combined_text.replace('pat', 'pdf')  # Fix file extension
    
    avg_x = sum(w['x'] for w in line_words_sorted) / len(line_words_sorted)
    avg_y = sum(w['y'] for w in line_words_sorted) / len(line_words_sorted)
    final_items.append({
        "text": combined_text,
        "x": int(avg_x),
        "y": int(avg_y)
    })

