print(f"Image size: {img.size}")

# Convert to grayscale and enhance contrast
gray = img.convert('L')
enhanced = ImageOps.autocontrast(gray)

# Use word-level detection with Chinese + English
config = r'--oem 3 --psm 6 -l eng+chi_sim'
data = pytesseract.image_to_data(enhanced, config=config, output_type=pytesseract.Output.DICT)

# Collect all words with their positions
words = []
for i, text in enumerate(data['text']):
    conf = int(data['conf'][i])
    if conf > 40 and text.strip():
        x = int(data['left'][i]) + int(data['width'][i]) / 2
        y = int(data['top'][i]) + int(data['height'][i]) / 2
        line_y = int(data['top'][i])
        words.append({
            "text": text.strip(),
            "x": x,
            "y": y,
            "line_y": line_y,
            "left": int(data['left'][i]),
            "width": int(data['width'][i])
        })

# Sort by line_y, then by x
words_sorted = sorted(words, key=lambda k: (k['line_y'], k['x']))

# Group words into lines
lines = []
if words_sorted:
    current_line = [words_sorted[0]]
    for word in words_sorted[1:]:
        if abs(word['line_y'] - current_line[0]['line_y']) < 10:
            current_line.append(word)
        else:
            lines.append(current_line)
            current_line = [word]
    lines.append(current_line)

# Combine words into meaningful text items
final_items = []
for line_words in lines:
    # Sort by x coordinate
    line_words_sorted = sorted(line_words, key=lambda k: k['x'])
    
    # Combine words that are close together (gap < 20 pixels)
    combined_text = ""
    start_x = line_words_sorted[0]['x']
    for i, word in enumerate(line_words_sorted):
        if i > 0 and word['left'] - line_words_sorted[i-1]['left'] > line_words_sorted[i-1]['width'] + 20:
            # New phrase, save previous
            avg_x = sum(w['x'] for w in line_words_sorted[:i]) / i
            avg_y = sum(w['y'] for w in line_words_sorted[:i]) / i
            final_items.append({
                "text": combined_text,
                "x": int(avg_x),
                "y": int(avg_y)
            })
            combined_text = word['text']
            start_x = word['x']
        else:
            if combined_text:
                combined_text += " " + word['text']
            else:
                combined_text = word['text']
    
    # Save last phrase
    avg_x = sum(w['x'] for w in line_words_sorted) / len(line_words_sorted)
    avg_y = sum(w['y'] for w in line_words_sorted) / len(line_words_sorted)
    final_items.append({
        "text": combined_text,
        "x": int(avg_x),
        "y": int(avg_y)
    })

# Print results
for item in final_items:
    print(f"({item['x']}, {item['y']}): '{item['text']}'")

result = {"items": final_items}
with open('/workspace/screen_text_map.json', 'w', encoding='utf-8') as f:
    json.dump(result, f, ensure_ascii=False, indent=2)

print(f"\nSaved {len(final_items)} items to screen_text_map.json")
