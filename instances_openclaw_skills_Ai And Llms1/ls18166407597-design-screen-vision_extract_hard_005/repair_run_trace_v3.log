cat > /workspace/ocr_script.py << 'PYEOF'
from PIL import Image
import pytesseract
import json

# Load the image
img = Image.open('/workspace/screen_capture.png')
print(f"Image size: {img.size}")

# Try with Chinese + English
custom_config = r'--oem 3 --psm 6 -l eng+chi_sim'

# Get text with coordinates
data = pytesseract.image_to_data(img, config=custom_config, output_type=pytesseract.Output.DICT)

# Group text by line (using y coordinate with tolerance)
lines = []
for i, text in enumerate(data['text']):
    conf = int(data['conf'][i])
    if conf > 40 and text.strip():
        x = int(data['left'][i]) + int(data['width'][i]) / 2
        y = int(data['top'][i]) + int(data['height'][i]) / 2
        line_y = int(data['top'][i])
        lines.append({
            "text": text.strip(),
            "x": x,
            "y": y,
            "line_y": line_y,
            "conf": conf
        })

# Group by line (y within 10 pixels)
lines_sorted = sorted(lines, key=lambda k: k['line_y'])
grouped_lines = []
if lines_sorted:
    current_line = [lines_sorted[0]]
    for item in lines_sorted[1:]:
        if abs(item['line_y'] - current_line[0]['line_y']) < 10:
            current_line.append(item)
        else:
            grouped_lines.append(current_line)
            current_line = [item]
    grouped_lines.append(current_line)

# Combine text on same line
final_items = []
for line_items in grouped_lines:
    # Sort by x coordinate
    line_items_sorted = sorted(line_items, key=lambda k: k['x'])
    combined_text = ' '.join([item['text'] for item in line_items_sorted])
    avg_x = sum(item['x'] for item in line_items_sorted) / len(line_items_sorted)
    avg_y = sum(item['y'] for item in line_items_sorted) / len(line_items_sorted)
    final_items.append({
        "text": combined_text,
        "x": int(avg_x),
        "y": int(avg_y)
    })

# Print results
for item in final_items:
    print(f"({item['x']}, {item['y']}): '{item['text']}'")

result = {"items": final_items}
with open('/workspace/screen_text_map.json', 'w', encoding='utf-8') as f:
    json.dump(result, f, ensure_ascii=False, indent=2)

print(f"\nSaved {len(final_items)} items to screen_text_map.json")
