#!/usr/bin/env python3
"""
Adversarial Prompting Task: Deployment Strategy Analysis

This task requires the assistant to perform a comprehensive adversarial analysis
of deployment strategies for a latency-sensitive service, then export findings
to a markdown file with specific sections.

Usage:
    python3 task.py --input ./workspace --mode adversarial-prompting
"""

import argparse
import json
import os
import sys
from pathlib import Path


def load_context(input_dir: Path) -> dict:
    """Load the decision context from input files."""
    context = {}
    
    # Load decision context JSON
    context_file = input_dir / "decision_context.json"
    if context_file.exists():
        with open(context_file, 'r') as f:
            context = json.load(f)
    
    # Load README brief
    readme_file = input_dir / "README_brief.txt"
    if readme_file.exists():
        context['readme'] = readme_file.read_text()
    
    return context


def validate_output(output_path: Path) -> dict:
    """Validate the output markdown file has required sections."""
    required_sections = [
        "## 1. Three Deployment Approaches",
        "## 2. Adversarial Critique",
        "## 3. Identified Fixes",
        "## 4. Validation Strategy",
        "## 5. Consolidated Findings",
        "## 6. Ranked Options",
        "## 7. Final Recommendation"
    ]
    
    if not output_path.exists():
        return {"valid": False, "error": "Output file does not exist"}
    
    content = output_path.read_text()
    
    # Check for marker
    if "ATLAS-DELTA-77" not in content:
        return {"valid": False, "error": "Missing required marker ATLAS-DELTA-77"}
    
    # Check for all required sections
    missing = []
    for section in required_sections:
        if section not in content:
            missing.append(section)
    
    if missing:
        return {"valid": False, "error": f"Missing sections: {', '.join(missing)}"}
    
    # Check for three approaches mentioned
    approaches = ["blue-green", "canary", "shadow"]
    for approach in approaches:
        if approach.lower() not in content.lower():
            return {"valid": False, "error": f"Missing approach: {approach}"}
    
    # Check for failure modes
    if "failure" not in content.lower() and "risk" not in content.lower():
        return {"valid": False, "error": "Missing failure mode analysis"}
    
    # Check for ranking
    if "rank" not in content.lower() and "order" not in content.lower() and "priority" not in content.lower():
        return {"valid": False, "error": "Missing ranking analysis"}
    
    return {"valid": True, "sections_found": len(required_sections)}


def main():
    parser = argparse.ArgumentParser(description="Adversarial Prompting Task")
    parser.add_argument("--input", type=str, default="./workspace", help="Input directory")
    parser.add_argument("--mode", type=str, default="adversarial-prompting", help="Task mode")
    parser.add_argument("--output", type=str, default="./workspace/analysis.md", help="Output file path")
    args = parser.parse_args()
    
    input_dir = Path(args.input)
    output_path = Path(args.output)
    
    if args.mode != "adversarial-prompting":
        print(f"Error: unsupported mode '{args.mode}'. Use 'adversarial-prompting'.")
        sys.exit(1)
    
    # Validate input directory
    if not input_dir.exists():
        print(f"Error: input directory '{input_dir}' does not exist")
        sys.exit(1)
    
    # Load context
    context = load_context(input_dir)
    if not context:
        print("Error: need a hard benchmark instance for the adversarial-prompting skill.")
        sys.exit(1)
    
    # Display task instructions
    print("=" * 60)
    print("ADVERSARIAL PROMPTING TASK: Deployment Strategy Analysis")
    print("=" * 60)
    print(f"\nProject: {context.get('project', 'Unknown')}")
    print(f"Service: {context.get('service', 'Unknown')}")
    print(f"Traffic Target: {context.get('traffic', 'Unknown')}")
    print(f"Marker: {context.get('marker', 'Unknown')}")
    print(f"\nRequired Approaches to Analyze:")
    for i, approach in enumerate(context.get('must_consider', []), 1):
        print(f"  {i}. {approach}")
    print(f"\nOutput File: {output_path}")
    print("\n" + "=" * 60)
    print("INSTRUCTIONS:")
    print("=" * 60)
    print("""
You must create a comprehensive adversarial analysis markdown file with these sections:

1. Three Deployment Approaches - Detail each of the three required strategies
2. Adversarial Critique - Attack each approach with failure scenarios
3. Identified Fixes - Propose mitigations for each failure mode
4. Validation Strategy - How to verify each approach works
5. Consolidated Findings - Synthesize all analysis
6. Ranked Options - Order approaches by suitability
7. Final Recommendation - Justify the best choice

Key Requirements:
- Include the marker: ATLAS-DELTA-77
- Address latency constraints (12k req/s, p95 < 120ms)
- Consider: configuration drift, slow warm-up, rollback checks
- Identify hidden failure modes for each approach
- Provide deterministic, verifiable recommendations
""")
    print("=" * 60)
    
    # Check if output already exists
    if output_path.exists():
        print(f"\nOutput file exists at {output_path}")
        validation = validate_output(output_path)
        if validation["valid"]:
            print("✓ Output file passes validation")
            print(f"  Sections found: {validation['sections_found']}/7")
        else:
            print(f"✗ Output file validation failed: {validation['error']}")
    else:
        print(f"\nPlease create the analysis file at: {output_path}")
    
    return 0


if __name__ == "__main__":
    sys.exit(main())
