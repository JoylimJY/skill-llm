with open('/workspace/ops_notes.pdf', 'rb') as f:
    content = f.read()

# Find content between stream and endstream more flexibly
start = content.find(b'stream\n')
end = content.find(b'\nendstream')
if start >= 0 and end >= 0:
    stream_data = content[start+7:end]
    print("Raw stream:", stream_data[:50])
    # ASCII85 decode
    ascii85_decoded = base64.a85decode(stream_data + b'~~>')
    print("ASCII85 decoded:", ascii85_decoded[:50])
