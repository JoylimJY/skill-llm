import zlib

# Custom ASCII85 decoder for PDF
def ascii85_decode_pdf(data):
    result = bytearray()
    buffer = 0
    count = 0
    
    for byte in data:
        c = chr(byte)
        if c == '~>':  # End marker
            break
        if c == 'z':  # Special case for four zero bytes
            result.extend([0, 0, 0, 0])
            continue
        if c == '\n' or c == '\r':
            continue
        if c == '~':
            continue
            
        buffer = buffer * 85 + (ord(c) - 33)
        count += 1
        
        if count == 5:
            result.append((buffer >> 32) & 0xff)
            result.append((buffer >> 24) & 0xff)
            result.append((buffer >> 16) & 0xff)
            result.append((buffer >> 8) & 0xff)
            result.append(buffer & 0xff)
            buffer = 0
            count = 0
    
    return bytes(result)

# Read the PDF
with open('/workspace/ops_notes.pdf', 'rb') as f:
    content = f.read()

