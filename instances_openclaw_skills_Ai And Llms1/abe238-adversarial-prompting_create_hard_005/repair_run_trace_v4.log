stream_match = re.search(rb'stream\n(.*?)\nendstream', content, re.DOTALL)
if stream_match:
    stream_data = stream_match.group(1)
    # Try ASCII85 decode then FlateDecode
    import base64
    # ASCII85 decode
    ascii85_decoded = base64.a85decode(stream_data + b'~~>')
    # Flate decode (zlib)
    try:
        text = zlib.decompress(ascii85_decoded)
        print(text.decode('utf-8'))
    except Exception as e:
        print(f"Error: {e}")
        print(ascii85_decoded)
