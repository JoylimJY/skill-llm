cat > /workspace/task.py << 'EOF'
#!/usr/bin/env python3
"""
Atlas Delta - Adversarial Prompting Task
Generate a multi-section adversarial analysis for deployment strategy selection.
"""

import argparse
import json
import os
import sys
from pathlib import Path


def load_context(input_dir: Path) -> dict:
    """Load the decision context from input files."""
    context_file = input_dir / "decision_context.json"
    if not context_file.exists():
        raise FileNotFoundError(f"Context file not found: {context_file}")
    
    with open(context_file, 'r') as f:
        return json.load(f)


def validate_output(output_path: Path) -> bool:
    """Validate the output markdown file structure."""
    if not output_path.exists():
        return False
    
    content = output_path.read_text()
    
    # Required sections
    required_sections = [
        "## 1. Three Approaches",
        "## 2. Adversarial Critique",
        "## 3. Hidden Failure Modes",
        "## 4. Proposed Fixes",
        "## 5. Validation Plan",
        "## 6. Consolidation",
        "## 7. Ranked Options",
        "## 8. Final Recommendation"
    ]
    
    for section in required_sections:
        if section not in content:
            print(f"Missing section: {section}")
            return False
    
    # Must include the marker
    if "ATLAS-DELTA-77" not in content:
        print("Missing marker ATLAS-DELTA-77")
        return False
    
    # Must mention all three approaches
    approaches = ["blue-green", "canary", "shadow"]
    for approach in approaches:
        if approach.lower() not in content.lower():
            print(f"Missing approach: {approach}")
            return False
    
    # Must have ranking with positions
    if not any(pos in content for pos in ["1.", "2.", "3."]):
        print("Missing ranked positions")
        return False
    
    return True


def main():
    parser = argparse.ArgumentParser(description="Atlas Delta Adversarial Analysis Task")
    parser.add_argument("--input", type=Path, default=Path("./workspace"), help="Input directory")
    parser.add_argument("--mode", type=str, default="adversarial-prompting", help="Task mode")
    parser.add_argument("--output", type=Path, default=Path("./analysis_report.md"), help="Output file")
    
    args = parser.parse_args()
    
    if args.mode != "adversarial-prompting":
        print(f"Error: unsupported mode '{args.mode}'")
        sys.exit(1)
    
    # Load context
    try:
        context = load_context(args.input)
    except FileNotFoundError as e:
        print(f"Error: {e}")
        sys.exit(1)
    
    print("=" * 60)
    print("ATLAS DELTA - DEPLOYMENT STRATEGY ANALYSIS")
    print("=" * 60)
    print(f"Project: {context['project']}")
    print(f"Service: {context['service']}")
    print(f"Traffic Target: {context['traffic']}")
    print(f"Marker: {context['marker']}")
    print()
    print("Required Approaches to Analyze:")
    for i, approach in enumerate(context['must_consider'], 1):
        print(f"  {i}. {approach}")
    print()
    print("=" * 60)
    print("TASK: Generate adversarial analysis report")
    print("=" * 60)
    print()
    print("Your output must include these sections in a markdown file:")
    print("  1. Three Approaches - describe each deployment strategy")
    print("  2. Adversarial Critique - attack each approach's assumptions")
    print("  3. Hidden Failure Modes - identify non-obvious failure points")
    print("  4. Proposed Fixes - address the identified failures")
    print("  5. Validation Plan - how to verify each approach works")
    print("  6. Consolidation - synthesize findings across approaches")
    print("  7. Ranked Options - order by suitability for constraints")
    print("  8. Final Recommendation - single best choice with justification")
    print()
    print(f"Write your analysis to: {args.output}")
    print("Include marker ATLAS-DELTA-77 in your output.")
    print()
    
    # Return context for the solver
    return context


if __name__ == "__main__":
    main()
