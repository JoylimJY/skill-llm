cat > /workspace/grader.py << 'EOF'
#!/usr/bin/env python3
"""
Grader for Atlas Delta Adversarial Prompting Task
Validates the generated analysis report against requirements.
"""

import argparse
import json
import re
import sys
from pathlib import Path


def load_context(input_dir: Path) -> dict:
    """Load the decision context."""
    context_file = input_dir / "decision_context.json"
    with open(context_file, 'r') as f:
        return json.load(f)


def grade_report(output_path: Path, context: dict) -> tuple[bool, list[str], dict]:
    """
    Grade the generated report.
    Returns: (passed, messages, scores)
    """
    messages = []
    scores = {}
    total_score = 0
    max_score = 100
    
    if not output_path.exists():
        return False, [f"Output file not found: {output_path}"], {}
    
    content = output_path.read_text()
    
    # 1. Check marker presence (10 points)
    if "ATLAS-DELTA-77" in content:
        scores["marker"] = 10
        total_score += 10
        messages.append("[PASS] Marker ATLAS-DELTA-77 found")
    else:
        scores["marker"] = 0
        messages.append("[FAIL] Missing marker ATLAS-DELTA-77")
    
    # 2. Check required sections (20 points - 2.5 each)
    required_sections = [
        ("## 1. Three Approaches", "three_approaches"),
        ("## 2. Adversarial Critique", "adversarial_critique"),
        ("## 3. Hidden Failure Modes", "hidden_failure_modes"),
        ("## 4. Proposed Fixes", "proposed_fixes"),
        ("## 5. Validation Plan", "validation_plan"),
        ("## 6. Consolidation", "consolidation"),
        ("## 7. Ranked Options", "ranked_options"),
        ("## 8. Final Recommendation", "final_recommendation"),
    ]
    
    section_points = 100 // len(required_sections)
    for section_header, key in required_sections:
        if section_header in content:
            scores[key] = section_points
            total_score += section_points
            messages.append(f"[PASS] Section found: {section_header}")
        else:
            scores[key] = 0
            messages.append(f"[FAIL] Missing section: {section_header}")
    
    # 3. Check all three approaches are discussed (15 points - 5 each)
    approaches = {
        "blue-green": re.compile(r"blue[-\s]?green|blue green", re.IGNORECASE),
        "canary": re.compile(r"canary", re.IGNORECASE),
        "shadow": re.compile(r"shadow", re.IGNORECASE),
    }
    
    for name, pattern in approaches.items():
        if pattern.search(content):
            scores[f"approach_{name}"] = 5
            total_score += 5
            messages.append(f"[PASS] Approach discussed: {name}")
        else:
            scores[f"approach_{name}"] = 0
            messages.append(f"[FAIL] Approach not discussed: {name}")
    
    # 4. Check for adversarial elements (15 points)
    adversarial_keywords = ["risk", "failure", "problem", "issue", "weakness", "vulnerability", "attack", "exploit"]
    adversarial_count = sum(1 for kw in adversarial_keywords if kw.lower() in content.lower())
    if adversarial_count >= 3:
        scores["adversarial_content"] = 15
        total_score += 15
        messages.append(f"[PASS] Adversarial analysis present ({adversarial_count} keywords)")
    else:
        scores["adversarial_content"] = 0
        messages.append(f"[FAIL] Insufficient adversarial content ({adversarial_count} keywords)")
    
    # 5. Check ranking is present (10 points)
    ranking_patterns = [
        re.compile(r"1\.\s*|ranked\s*1|first\s*place|top\s*choice", re.IGNORECASE),
        re.compile(r"2\.\s*|ranked\s*2|second\s*place|runner[-\s]?up", re.IGNORECASE),
        re.compile(r"3\.\s*|ranked\s*3|third\s*place", re.IGNORECASE),
    ]
    ranking_count = sum(1 for pattern in ranking_patterns if pattern.search(content))
    if ranking_count >= 2:
        scores["ranking"] = 10
        total_score += 10
        messages.append("[PASS] Ranking structure present")
    else:
        scores["ranking"] = 0
        messages.append("[FAIL] Ranking structure incomplete")
    
    # 6. Check recommendation is explicit (10 points)
    recommendation_keywords = ["recommend", "recommendation", "best choice", "final decision", "selected"]
    rec_count = sum(1 for kw in recommendation_keywords if kw.lower() in content.lower())
    if rec_count >= 1:
        scores["recommendation"] = 10
        total_score += 10
        messages.append("[PASS] Recommendation present")
    else:
        scores["recommendation"] = 0
        messages.append("[FAIL] No explicit recommendation")
    
    # 7. Check for failure mode analysis (10 points)
    failure_keywords = ["rollback", "latency", "traffic", "spike", "cascade", "timeout", "circuit breaker", "health check"]
    failure_count = sum(1 for kw in failure_keywords if kw.lower() in content.lower())
    if failure_count >= 3:
        scores["failure_analysis"] = 10
        total_score += 10
        messages.append(f"[PASS] Failure mode analysis present ({failure_count} keywords)")
    else:
        scores["failure_analysis"] = 0
        messages.append(f"[FAIL] Insufficient failure analysis ({failure_count} keywords)")
    
    # 8. Check validation content (10 points)
    validation_keywords = ["test", "verify", "monitor", "metric", "threshold", "check", "validate", "benchmark"]
    validation_count = sum(1 for kw in validation_keywords if kw.lower() in content.lower())
    if validation_count >= 3:
        scores["validation"] = 10
        total_score += 10
        messages.append(f"[PASS] Validation plan present ({validation_count} keywords)")
    else:
        scores["validation"] = 0
        messages.append(f"[FAIL] Insufficient validation content ({validation_count} keywords)")
    
    passed = total_score >= 70  # 70% threshold
    
    return passed, messages, scores


def main():
    parser = argparse.ArgumentParser(description="Grade Atlas Delta Analysis Report")
    parser.add_argument("--input", type=Path, default=Path("./workspace"), help="Input directory")
    parser.add_argument("--output", type=Path, default=Path("./analysis_report.md"), help="Output file to grade")
    
    args = parser.parse_args()
    
    # Load context
    context = load_context(args.input)
    
    print("=" * 60)
    print("ATLAS DELTA - GRADER")
    print("=" * 60)
    print(f"Grading: {args.output}")
    print()
    
    passed, messages, scores = grade_report(args.output, context)
    
    # Print results
    for msg in messages:
        print(msg)
    
    print()
    print("Score Breakdown:")
    for key, score in scores.items():
        print(f"  {key}: {score}")
    
    total = sum(scores.values())
    print()
    print(f"Total Score: {total}/100")
    print()
    
    if passed:
        print("=" * 60)
        print("RESULT: PASSED")
        print("=" * 60)
        sys.exit(0)
    else:
        print("=" * 60)
        print("RESULT: FAILED")
        print("=" * 60)
        sys.exit(1)


if __name__ == "__main__":
    main()
EOF
