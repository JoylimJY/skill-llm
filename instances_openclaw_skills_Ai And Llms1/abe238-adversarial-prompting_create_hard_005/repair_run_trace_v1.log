#!/usr/bin/env python3
"""
Adversarial Prompting Task: Deployment Strategy Analysis for Atlas Delta

This task requires analyzing three competing deployment strategies for a 
latency-sensitive service, performing adversarial critique, and producing
a ranked recommendation with validation.
"""

import argparse
import json
import os
import sys
from pathlib import Path


def load_context(workspace: Path) -> dict:
    """Load the decision context from workspace."""
    context_file = workspace / "decision_context.json"
    with open(context_file, 'r', encoding='utf-8') as f:
        return json.load(f)


def load_brief(workspace: Path) -> str:
    """Load the README brief."""
    brief_file = workspace / "README_brief.txt"
    with open(brief_file, 'r', encoding='utf-8') as f:
        return f.read()


def validate_output(output_path: Path) -> dict:
    """Validate the output markdown file contains required sections."""
    if not output_path.exists():
        return {"valid": False, "error": f"Output file not found: {output_path}"}
    
    content = output_path.read_text(encoding='utf-8')
    content_lower = content.lower()
    
    required_sections = [
        ("## approach", "three approaches must be documented"),
        ("## adversarial", "adversarial critique section required"),
        ("## fixes", "mitigation fixes section required"),
        ("## validation", "validation criteria section required"),
        ("## ranked", "ranked options section required"),
        ("## recommendation", "final recommendation section required"),
    ]
    
    results = {"valid": True, "sections": {}}
    
    for keyword, description in required_sections:
        found = keyword in content_lower
        results["sections"][description] = found
        if not found:
            results["valid"] = False
    
    # Check for the marker
    if "ATLAS-DELTA-77" not in content:
        results["valid"] = False
        results["sections"]["marker present"] = False
    else:
        results["sections"]["marker present"] = True
    
    # Check for all three approaches
    approaches = ["blue-green", "canary", "shadow"]
    for approach in approaches:
        if approach not in content_lower:
            results["valid"] = False
            results["sections"][f"{approach} approach"] = False
        else:
            results["sections"][f"{approach} approach"] = True
    
    return results


def main():
    parser = argparse.ArgumentParser(description="Adversarial Prompting Task")
    parser.add_argument("--input", type=str, default="./workspace",
                        help="Input workspace directory")
    parser.add_argument("--mode", type=str, default="standard",
                        help="Task mode: standard or adversarial-prompting")
    parser.add_argument("--output", type=str, default="./deployment_analysis.md",
                        help="Output markdown file path")
    
    args = parser.parse_args()
    
    workspace = Path(args.input)
    
    if args.mode == "adversarial-prompting":
        # Validate we have the required inputs
        if not (workspace / "decision_context.json").exists():
            print("Error: need a hard benchmark instance for the adversarial-prompting skill.")
            print("Missing: decision_context.json")
            sys.exit(1)
        
        if not (workspace / "README_brief.txt").exists():
            print("Error: need a hard benchmark instance for the adversarial-prompting skill.")
            print("Missing: README_brief.txt")
            sys.exit(1)
        
        # Load and display context
        context = load_context(workspace)
        brief = load_brief(workspace)
        
        print("=" * 70)
        print("ATLAS DELTA - DEPLOYMENT STRATEGY ANALYSIS TASK")
        print("=" * 70)
        print("\nPROJECT CONTEXT:")
        print(f"  Project: {context['project']}")
        print(f"  Service: {context['service']}")
        print(f"  Traffic: {context['traffic']}")
        print(f"  Marker: {context['marker']}")
        print("\nREQUIRED APPROACHES TO ANALYZE:")
        for i, approach in enumerate(context['must_consider'], 1):
            print(f"  {i}. {approach}")
        print("\n" + brief)
        print("\n" + "=" * 70)
        print("TASK: Produce a comprehensive adversarial analysis document")
        print("      that evaluates all three approaches, identifies failure modes,")
        print("      proposes fixes, and provides a ranked recommendation.")
        print("\nOUTPUT: Write your analysis to:", args.output)
        print("=" * 70)
        
        return 0
    
    else:
        print("Standard mode not implemented. Use --mode adversarial-prompting")
        return 1


if __name__ == "__main__":
    sys.exit(main())
