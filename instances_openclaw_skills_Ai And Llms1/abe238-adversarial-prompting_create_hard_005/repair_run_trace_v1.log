#!/usr/bin/env python3
"""Grader for Adversarial Prompting Task - Deployment Strategy Analysis"""

import argparse
import json
import sys
from pathlib import Path
from typing import Dict, List, Tuple


class AdversarialTaskGrader:
    def __init__(self, workspace: Path, output_path: Path):
        self.workspace = workspace
        self.output_path = output_path
        
    def load_context(self) -> dict:
        with open(self.workspace / "decision_context.json", 'r') as f:
            return json.load(f)
    
    def load_output(self) -> str:
        if not self.output_path.exists():
            raise FileNotFoundError(f"Output file not found: {self.output_path}")
        return self.output_path.read_text(encoding='utf-8')
    
    def check_sections(self, content: str) -> Tuple[bool, Dict[str, bool]]:
        content_lower = content.lower()
        section_checks = {
            "three_approaches": ("## approach" in content_lower or "## approaches" in content_lower),
            "adversarial_critique": ("## adversarial" in content_lower or "## critique" in content_lower),
            "fixes_section": ("## fixes" in content_lower or "## mitigations" in content_lower),
            "validation_section": ("## validation" in content_lower or "## verification" in content_lower),
            "ranked_options": ("## ranked" in content_lower or "## ranking" in content_lower),
            "recommendation": ("## recommendation" in content_lower or "## final recommendation" in content_lower),
        }
        return all(section_checks.values()), section_checks
    
    def check_approaches(self, content: str, required_approaches: List[str]) -> Tuple[bool, Dict]:
        content_lower = content.lower()
        approach_scores = {}
        for approach in required_approaches:
            approach_lower = approach.lower()
            present = approach_lower in content_lower
            mentions = content_lower.count(approach_lower)
            approach_scores[approach] = {"present": present, "mentions": mentions}
        all_present = all(info["present"] for info in approach_scores.values())
        return all_present, approach_scores
    
    def check_failure_modes(self, content: str) -> Tuple[bool, List[str]]:
        content_lower = content.lower()
        failure_patterns = {
            "configuration_drift": "config" in content_lower,
            "slow_warmup": "warm" in content_lower,
            "rollback_failure": "rollback" in content_lower,
            "database_lock": "lock" in content_lower and "database" in content_lower,
            "latency_spike": "latency" in content_lower,
            "cascading_failure": "cascade" in content_lower,
            "health_check_failure": "health" in content_lower,
        }
        identified = [k for k, v in failure_patterns.items() if v]
        return len(identified) >= 3, identified
    
    def check_ranking(self, content: str) -> Tuple[bool, str]:
        content_lower = content.lower()
        ranking_indicators = ["1.", "2.", "3.", "first", "second", "third", "ranked"]
        has_ranking = any(ind in content_lower for ind in ranking_indicators)
        rec_indicators = ["recommended", "best option", "preferred", "choose"]
        has_recommendation = any(ind in content_lower for ind in rec_indicators)
        if has_ranking and has_recommendation:
            return True, "Clear ranking and recommendation found"
        return False, "Ranking or recommendation unclear"
    
    def check_marker(self, content: str, marker: str) -> bool:
        return marker in content
    
    def grade(self) -> Dict:
        context = self.load_context()
        content = self.load_output()
        results = {"valid": False, "score": 0.0, "max_score": 100.0, "checks": {}, "feedback": []}
        
        sections_ok, section_details = self.check_sections(content)
        sections_score = 20 if sections_ok else sum(10 for v in section_details.values() if v)
        results["checks"]["sections"] = {"passed": sections_ok, "score": sections_score, "details": section_details}
        
        approaches_ok, approach_details = self.check_approaches(content, context["must_consider"])
        approaches_score = 0
        for approach, info in approach_details.items():
            if info["present"] and info["mentions"] >= 3:
                approaches_score += 8
            elif info["present"]:
                approaches_score += 5
        results["checks"]["approaches"] = {"passed": approaches_ok, "score": min(approaches_score, 25), "details": approach_details}
        
        failures_ok, identified_failures = self.check_failure_modes(content)
        failures_score = min(len(identified_failures) * 7, 20)
        results["checks"]["failure_modes"] = {"passed": failures_ok, "score": failures_score, "identified": identified_failures}
        
        ranking_ok, ranking_feedback = self.check_ranking(content)
        ranking_score = 15 if ranking_ok else 5
        results["checks"]["ranking"] = {"passed": ranking_ok, "score": ranking_score, "feedback": ranking_feedback}
        
        marker_ok = self.check_marker(content, context["marker"])
        marker_score = 10 if marker_ok else 0
        results["checks"]["marker"] = {"passed": marker_ok, "score": marker_score}
        
        validation_keywords = ["p95", "latency", "120ms", "threshold", "metric", "sla", "slo"]
        validation_count = sum(1 for kw in validation_keywords if kw in content.lower())
        validation_score = min(validation_count * 2, 10)
        results["checks"]["validation"] = {"passed": validation_count >= 3, "score": validation_score, "keywords_found": validation_count}
        
        total_score = sections_score + min(approaches_score, 25) + failures_score + ranking_score + marker_score + validation_score
        results["score"] = total_score
        results["valid"] = total_score >= 70
        
        if not sections_ok:
            missing = [k for k, v in section_details.items() if not v]
            results["feedback"].append(f"Missing sections: {missing}")
        if not approaches_ok:
            missing = [a for a, info in approach_details.items() if not info["present"]]
            results["feedback"].append(f"Missing approaches: {missing}")
        if not failures_ok:
            results["feedback"].append(f"Only {len(identified_failures)} failure modes identified, need at least 3")
        if not marker_ok:
            results["feedback"].append(f"Marker {context['marker']} not found in output")
        
        return results


def main():
    parser = argparse.ArgumentParser(description="Grade adversarial-prompting task output")
    parser.add_argument("--input", type=str, default="./workspace", help="Input workspace directory")
    parser.add_argument("--output", type=str, default="./deployment_analysis.md", help="Output file to grade")
    args = parser.parse_args()
    
    workspace = Path(args.input)
    output_path = Path(args.output)
    
    try:
        grader = AdversarialTaskGrader(workspace, output_path)
        results = grader.grade()
        
        print("=" * 60)
        print("ADVERSARIAL PROMPTING TASK - GRADING RESULTS")
        print("=" * 60)
        print(f"Score: {results['score']:.1f} / {results['max_score']}")
        print(f"Valid: {'PASS' if results['valid'] else 'FAIL'}")
        print()
        print("CHECK DETAILS:")
        for check_name, check_result in results["checks"].items():
            status = "PASS" if check_result.get("passed", False) else "FAIL"
            print(f"  {check_name}: {check_result['score']} points [{status}]")
        print()
        if results["feedback"]:
            print("FEEDBACK:")
            for feedback in results["feedback"]:
                print(f"  - {feedback}")
        print("=" * 60)
        
        return 0 if results["valid"] else 1
        
    except FileNotFoundError as e:
        print(f"Error: {e}")
        return 1
    except Exception as e:
        print(f"Grading error: {e}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
