[EXECUTING python]:
import json
import os

# Read config
with open('/workspace/data/config.json', 'r') as f:
    config = json.load(f)

marker = config['marker']
skill = config['skill']

# Find input files
data_dir = '/workspace/data'
input_files = [f for f in os.listdir(data_dir) if f.startswith('input_') and f.endswith('.txt')]
input_files.sort()

# Process files and check for marker
files_with_marker = []
for filename in input_files:
    filepath = os.path.join(data_dir, filename)
    with open(filepath, 'r') as f:
        content = f.read()
    if marker in content:
        files_with_marker.append(filename)

# Determine conclusion
marker_found = len(files_with_marker) > 0

# Create report
report = {
    "skill": skill,
    "detected_marker": marker,
    "number_of_input_files_processed": len(input_files),
    "files_containing_marker": files_with_marker,
    "conclusion": f"The marker '{marker}' was {'found' if marker_found else 'not found'} in {len(files_with_marker)} out of {len(input_files)} input files."
}

# Write output
with open('/workspace/output.json', 'w') as f:
    json.dump(report, f, indent=2)

print("Report generated successfully!")
print(json.dumps(report, indent=2))

