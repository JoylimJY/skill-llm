[EXECUTING bash]:
cat > /workspace/verify-handshakes.js << 'EOF'
const fs = require('fs');
const path = require('path');

// Configuration
const INPUT_FILE = path.join(__dirname, 'handshakes.json');
const REPORT_FILE = path.join(__dirname, 'report.txt');
const SUMMARY_FILE = path.join(__dirname, 'summary.json');
const MARKER_PREFIX = 'MARKER::';

function main() {
  // Read input file
  let inputData;
  try {
    const raw = fs.readFileSync(INPUT_FILE, 'utf-8');
    inputData = JSON.parse(raw);
  } catch (err) {
    console.error(`Error reading input file: ${err.message}`);
    process.exit(1);
  }

  // Validate structure
  if (!inputData.session_id || typeof inputData.session_id !== 'string') {
    console.error('Invalid structure: missing or invalid session_id');
    process.exit(1);
  }

  if (!Array.isArray(inputData.records)) {
    console.error('Invalid structure: records must be an array');
    process.exit(1);
  }

  // Validate each record
  for (let i = 0; i < inputData.records.length; i++) {
    const record = inputData.records[i];
    if (typeof record.publicId !== 'string') {
      console.error(`Invalid record at index ${i}: missing or invalid publicId`);
      process.exit(1);
    }
    if (typeof record.verified !== 'boolean') {
      console.error(`Invalid record at index ${i}: missing or invalid verified`);
      process.exit(1);
    }
    if (typeof record.latencyMs !== 'number') {
      console.error(`Invalid record at index ${i}: missing or invalid latencyMs`);
      process.exit(1);
    }
    if (typeof record.note !== 'string') {
      console.error(`Invalid record at index ${i}: missing or invalid note`);
      process.exit(1);
    }
  }

  // Count successful vs failed verifications
  let successCount = 0;
  let failCount = 0;
  let markerRecord = null;
  let markerValue = null;

  for (const record of inputData.records) {
    if (record.verified) {
      successCount++;
    } else {
      failCount++;
    }

    // Extract marker record
    if (record.note && record.note.startsWith(MARKER_PREFIX)) {
      markerRecord = record;
      markerValue = record.note;
    }
  }

  // Generate human-readable report
  const reportLines = [
    'AAP Server Handshake Verification Report',
    '========================================',
    '',
    `Session ID: ${inputData.session_id}`,
    `Total Records: ${inputData.records.length}`,
    `Successful Verifications: ${successCount}`,
    `Failed Verifications: ${failCount}`,
    '',
    'Record Details:',
    '---------------'
  ];

  for (const record of inputData.records) {
    const status = record.verified ? 'SUCCESS' : 'FAILED';
    reportLines.push(`- ${record.publicId}: ${status} (${record.latencyMs}ms) - ${record.note}`);
  }

  reportLines.push('');
  reportLines.push(`Embedded Marker: ${markerValue || 'None found'}`);
  reportLines.push('');
  reportLines.push('--- End of Report ---');

  fs.writeFileSync(REPORT_FILE, reportLines.join('\n'), 'utf-8');
  console.log(`Report written to: ${REPORT_FILE}`);

  // Generate machine-readable summary
  const summary = {
    session_id: inputData.session_id,
    total_records: inputData.records.length,
    successful_verifications: successCount,
    failed_verifications: failCount,
    marker_value: markerValue,
    marker_record: markerRecord
  };

  fs.writeFileSync(SUMMARY_FILE, JSON.stringify(summary, null, 2), 'utf-8');
  console.log(`Summary written to: ${SUMMARY_FILE}`);

  console.log('\nVerification complete.');
  console.log(`Marker value: ${markerValue}`);
}

main();
EOF

