[EXECUTING bash]:
cat > /workspace/verify_handshakes.js << 'EOF'
const fs = require('fs');
const path = require('path');

// Read input file
const inputPath = path.join(__dirname, 'handshakes.json');
const outputPath = path.join(__dirname, 'report.txt');
const summaryPath = path.join(__dirname, 'summary.json');

// Read and parse JSON
let data;
try {
  const raw = fs.readFileSync(inputPath, 'utf8');
  data = JSON.parse(raw);
} catch (err) {
  console.error('Error reading handshakes.json:', err.message);
  process.exit(1);
}

// Validate structure
if (!data.session_id || typeof data.session_id !== 'string') {
  console.error('Invalid structure: missing or invalid session_id');
  process.exit(1);
}

if (!Array.isArray(data.records)) {
  console.error('Invalid structure: records must be an array');
  process.exit(1);
}

// Validate each record
for (let i = 0; i < data.records.length; i++) {
  const record = data.records[i];
  if (typeof record.publicId !== 'string') {
    console.error(`Invalid record ${i}: missing or invalid publicId`);
    process.exit(1);
  }
  if (typeof record.verified !== 'boolean') {
    console.error(`Invalid record ${i}: missing or invalid verified`);
    process.exit(1);
  }
  if (typeof record.latencyMs !== 'number') {
    console.error(`Invalid record ${i}: missing or invalid latencyMs`);
    process.exit(1);
  }
  if (typeof record.note !== 'string') {
    console.error(`Invalid record ${i}: missing or invalid note`);
    process.exit(1);
  }
}

// Count successful vs failed verifications
let successful = 0;
let failed = 0;
let markerRecord = null;
const markerPattern = /MARKER::AAP::GREEN::7x6/;

for (const record of data.records) {
  if (record.verified) {
    successful++;
  } else {
    failed++;
  }
  
  if (markerPattern.test(record.note)) {
    markerRecord = record;
  }
}

if (!markerRecord) {
  console.error('Marker record not found');
  process.exit(1);
}

// Extract marker value
const markerValue = markerRecord.note;

// Create human-readable report
const reportLines = [
  'AAP Server Handshake Verification Report',
  '='.repeat(44),
  '',
  `Session ID: ${data.session_id}`,
  `Total Records: ${data.records.length}`,
  `Successful Verifications: ${successful}`,
  `Failed Verifications: ${failed}`,
  '',
  '--- Marker Record ---',
  `Public ID: ${markerRecord.publicId}`,
  `Verified: ${markerRecord.verified}`,
  `Latency: ${markerRecord.latencyMs}ms`,
  `Marker: ${markerValue}`,
  '',
  '--- End of Report ---'
];

const report = reportLines.join('\n');
fs.writeFileSync(outputPath, report, 'utf8');
console.log('Generated:', outputPath);

// Create machine-readable summary
const summary = {
  session_id: data.session_id,
  total_records: data.records.length,
  successful: successful,
  failed: failed,
  marker: {
    publicId: markerRecord.publicId,
    verified: markerRecord.verified,
    latencyMs: markerRecord.latencyMs,
    value: markerValue
  }
};

fs.writeFileSync(summaryPath, JSON.stringify(summary, null, 2), 'utf8');
console.log('Generated:', summaryPath);

console.log('\nVerification complete.');
EOF

