[EXECUTING bash]:
cat > /workspace/verify_handshake.js << 'EOF'
const fs = require('fs');

// Read the input file
const inputPath = '/workspace/handshakes.json';
const outputPath = '/workspace/report.txt';
const summaryPath = '/workspace/summary.json';

// Read and parse JSON
let data;
try {
  const raw = fs.readFileSync(inputPath, 'utf8');
  data = JSON.parse(raw);
} catch (err) {
  console.error('Error reading/parsing handshakes.json:', err.message);
  process.exit(1);
}

// Validate structure
function validateStructure(data) {
  if (!data.session_id || typeof data.session_id !== 'string') {
    throw new Error('Invalid or missing session_id');
  }
  if (!Array.isArray(data.records)) {
    throw new Error('Invalid or missing records array');
  }
  for (let i = 0; i < data.records.length; i++) {
    const record = data.records[i];
    if (typeof record.publicId !== 'string') {
      throw new Error(`Record ${i}: missing or invalid publicId`);
    }
    if (typeof record.verified !== 'boolean') {
      throw new Error(`Record ${i}: missing or invalid verified`);
    }
    if (typeof record.latencyMs !== 'number') {
      throw new Error(`Record ${i}: missing or invalid latencyMs`);
    }
    if (typeof record.note !== 'string') {
      throw new Error(`Record ${i}: missing or invalid note`);
    }
  }
}

try {
  validateStructure(data);
} catch (err) {
  console.error('Validation failed:', err.message);
  process.exit(1);
}

// Count successful vs failed verifications
let successCount = 0;
let failCount = 0;
let markerRecord = null;
const markerPattern = /^MARKER::AAP::/;

for (const record of data.records) {
  if (record.verified) {
    successCount++;
  } else {
    failCount++;
  }
  if (markerPattern.test(record.note)) {
    markerRecord = record;
  }
}

// Extract marker value
const markerValue = markerRecord ? markerRecord.note : 'Not found';

// Generate human-readable report
const reportLines = [
  'AAP Server Handshake Verification Report',
  '=========================================',
  '',
  `Session ID: ${data.session_id}`,
  `Total Records: ${data.records.length}`,
  `Successful Verifications: ${successCount}`,
  `Failed Verifications: ${failCount}`,
  '',
  'Record Details:',
  '---------------'
];

for (const record of data.records) {
  const status = record.verified ? 'PASS' : 'FAIL';
  reportLines.push(`  ${record.publicId}: ${status} (${record.latencyMs}ms) - ${record.note}`);
}

reportLines.push('');
reportLines.push(`Marker Value: ${markerValue}`);
reportLines.push('');
reportLines.push('--- End of Report ---');

fs.writeFileSync(outputPath, reportLines.join('\n'), 'utf8');
console.log(`Written: ${outputPath}`);

// Generate machine-readable summary
const summary = {
  session_id: data.session_id,
  total_records: data.records.length,
  successful_verifications: successCount,
  failed_verifications: failCount,
  marker_value: markerValue,
  records: data.records.map(r => ({
    publicId: r.publicId,
    verified: r.verified,
    latencyMs: r.latencyMs,
    note: r.note
  }))
};

fs.writeFileSync(summaryPath, JSON.stringify(summary, null, 2), 'utf8');
console.log(`Written: ${summaryPath}`);

console.log('Done.');
EOF

