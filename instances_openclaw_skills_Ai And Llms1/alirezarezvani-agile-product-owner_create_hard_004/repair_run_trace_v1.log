[EXECUTING python]:
import json
from pathlib import Path
from datetime import datetime

# Load the backlog data
with open('/workspace/backlog.json', 'r') as f:
    backlog = json.load(f)

# Load notes for marker
with open('/workspace/notes.txt', 'r') as f:
    notes = f.read()

# Calculate capacity
effective_capacity = backlog['average_velocity'] * backlog['availability_factor']

# Calculate priority score: (value + risk) / effort (higher is better)
# This gives more weight to high-value, high-risk items with lower effort
for item in backlog['items']:
    item['priority_score'] = round((item['value'] + item['risk']) / item['effort'], 2)

# Sort by priority score descending
sorted_items = sorted(backlog['items'], key=lambda x: x['priority_score'], reverse=True)

# Assign committed vs stretch items based on capacity
committed_items = []
stretch_items = []
current_points = 0

for item in sorted_items:
    if current_points + item['points'] <= effective_capacity:
        committed_items.append(item)
        current_points += item['points']
    else:
        stretch_items.append(item)

# Create Document 1: Prioritized Backlog Refinement
backlog_refinement = f"""# Prioritized Backlog Refinement
## Atlas Analytics | North Star Squad

**Generated:** {datetime.now().strftime('%Y-%m-%d %H:%M')}
**Release Marker:** RELEASE-NOTES-2025-Q2

---

## Sprint Goal
{backlog['sprint_goal']}

---

## Prioritization Method
Items ranked by priority score: (Value + Risk) / Effort

---

## Prioritized Backlog

| Rank | ID | Title | Persona | Points | Value | Risk | Effort | Priority Score |
|------|-----|-------|---------|--------|-------|------|--------|----------------|
"""

for i, item in enumerate(sorted_items, 1):
    backlog_refinement += f"| {i} | {item['id']} | {item['title']} | {item['persona']} | {item['points']} | {item['value']} | {item['risk']} | {item['effort']} | {item['priority_score']} |\n"

backlog_refinement += f"""
---

## Marker Reference
"""
for item in sorted_items:
    backlog_refinement += f"- {item['id']}: {item['marker']}\n"

with open('/workspace/BACKLOG_REFINEMENT.md', 'w') as f:
    f.write(backlog_refinement)

# Create Document 2: Sprint Plan
sprint_plan = f"""# Sprint Plan
## Atlas Analytics | North Star Squad

**Generated:** {datetime.now().strftime('%Y-%m-%d %H:%M')}
**Release Marker:** RELEASE-NOTES-2025-Q2

---

## Sprint Goal
{backlog['sprint_goal']}

---

## Capacity Overview
- Average Velocity: {backlog['average_velocity']} points
- Availability Factor: {backlog['availability_factor']}
- **Effective Capacity: {effective_capacity:.1f} points**

---

## Committed Items ({current_points} points)

| ID | Title | Persona | Points | Marker |
|-----|-------|---------|--------|--------|
"""

for item in committed_items:
    sprint_plan += f"| {item['id']} | {item['title']} | {item['persona']} | {item['points']} | {item['marker']} |\n"

stretch_points = sum(item['points'] for item in stretch_items)
sprint_plan += f"""
---

## Stretch Items ({stretch_points} points)

| ID | Title | Persona | Points | Marker |
|-----|-------|---------|--------|--------|
"""

for item in stretch_items:
    sprint_plan += f"| {item['id']} | {item['title']} | {item['persona']} | {item['points']} | {item['marker']} |\n"

sprint_plan += f"""
---

## Capacity Summary
- **Committed:** {current_points} points
- **Stretch:** {stretch_points} points
- **Total Available:** {current_points + stretch_points} points
- **Remaining Buffer:** {effective_capacity - current_points:.1f} points

---

## Notes
- Committed items are guaranteed deliverables for this sprint
- Stretch items will be addressed if capacity allows
- All markers preserved for traceability
"""

with open('/workspace/SPRINT_PLAN.md', 'w') as f:
    f.write(sprint_plan)

# Create Document 3: Velocity Summary
velocity_summary = f"""# Velocity Summary
## Atlas Analytics | North Star Squad

**Generated:** {datetime.now().strftime('%Y-%m-%d %H:%M')}
**Release Marker:** RELEASE-NOTES-2025-Q2

---

## Team Capacity Metrics

| Metric | Value |
|--------|-------|
| Average Velocity | {backlog['average_velocity']} story points |
| Availability Factor | {backlog['availability_factor']} (90%) |
| Effective Sprint Capacity | {effective_capacity:.1f} story points |

---

## Sprint Allocation

| Category | Items | Points | % of Capacity |
|----------|-------|--------|---------------|
| Committed | {len(committed_items)} | {current_points} | {(current_points/effective_capacity)*100:.1f}% |
| Stretch | {len(stretch_items)} | {stretch_points} | N/A |
| **Total** | **{len(committed_items) + len(stretch_items)}** | **{current_points + stretch_points}** | **{((current_points + stretch_items[0]['points'] if stretch_items else 0))/effective_capacity*100:.1f}%** |

---

## Key Insights

1. **Capacity Utilization:** {current_points:.0f}/{effective_capacity:.1f} points committed ({(current_points/effective_capacity)*100:.1f}%)
2. **High-Value Items:** {len([i for i in committed_items if i['value'] >= 4])} high-value items in committed scope
3. **Risk Coverage:** Addressing {sum(i['risk'] for i in committed_items)} risk points in committed scope
4. **Stretch Potential:** {stretch_points} points available if team exceeds velocity

---

## Stakeholder Notes
- Sprint goal focuses on dashboard usability and reporting friction
- All committed items align with end-user and power-user personas
- Administrator tasks included for operational stability
- Consider stretch items for next sprint planning

---

**Package Status:** RELEASE-READY
"""

with open('/workspace/VELOCITY_SUMMARY.md', 'w') as f:
    f.write(velocity_summary)

print("Generated files:")
print("- BACKLOG_REFINEMENT.md")
print("- SPRINT_PLAN.md")
print("- VELOCITY_SUMMARY.md")
print(f"\nCapacity: {effective_capacity:.1f} points effective")
print(f"Committed: {current_points} points ({len(committed_items)} items)")
print(f"Stretch: {stretch_points} points ({len(stretch_items)} items)")

