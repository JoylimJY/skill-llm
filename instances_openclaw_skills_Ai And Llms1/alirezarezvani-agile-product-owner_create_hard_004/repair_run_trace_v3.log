[EXECUTING python]:
import json
from datetime import datetime

# Load backlog data
with open('/workspace/backlog.json', 'r') as f:
    backlog = json.load(f)

# Load notes
with open('/workspace/notes.txt', 'r') as f:
    notes = f.read()

# Calculate effective capacity
effective_capacity = backlog['average_velocity'] * backlog['availability_factor']
committed_capacity = int(effective_capacity * 0.85)  # Leave buffer
stretch_capacity = int(effective_capacity * 0.95)

# Prioritize items using a scoring algorithm
# Score = (value * 3) + (risk * -0.5) + (effort * -0.2) + priority_bonus
priority_bonus = {'High': 5, 'Medium': 2, 'Low': 0}

items = backlog['items']
for item in items:
    item['score'] = (
        item['value'] * 3 +
        item['risk'] * -0.5 +
        item['effort'] * -0.2 +
        priority_bonus.get(item['priority_hint'], 0)
    )

# Sort by score descending
sorted_items = sorted(items, key=lambda x: x['score'], reverse=True)

# Assign committed vs stretch
committed_items = []
stretch_items = []
committed_points = 0

for item in sorted_items:
    if committed_points + item['points'] <= committed_capacity:
        committed_items.append(item)
        committed_points += item['points']
    else:
        stretch_items.append(item)

# Calculate totals
total_committed_points = sum(i['points'] for i in committed_items)
total_stretch_points = sum(i['points'] for i in stretch_items)

# Create 1. Prioritized Backlog Refinement Document
backlog_refinement = f"""# Prioritized Backlog Refinement
## Atlas Analytics - North Star Squad

**Generated:** {datetime.now().strftime('%Y-%m-%d %H:%M')}
**Release Marker:** RELEASE-NOTES-2025-Q2

---

## Sprint Goal
{backlog['sprint_goal']}

---

## Prioritization Criteria
Items scored using: (Value × 3) - (Risk × 0.5) - (Effort × 0.2) + Priority Bonus
- High priority bonus: +5
- Medium priority bonus: +2
- Low priority bonus: +0

---

## Prioritized User Stories

| Rank | ID | Title | Persona | Points | Value | Risk | Effort | Score | Priority |
|------|-----|-------|---------|--------|-------|------|--------|-------|----------|
"""

for i, item in enumerate(sorted_items, 1):
    backlog_refinement += f"| {i} | {item['id']} | {item['title']} | {item['persona']} | {item['points']} | {item['value']} | {item['risk']} | {item['effort']} | {item['score']:.1f} | {item['priority_hint']} |\n"

backlog_refinement += f"""
---

## Marker Data (Preserved)
"""

for item in sorted_items:
    backlog_refinement += f"- {item['id']}: {item['marker']}\n"

with open('/workspace/backlog_refinement.md', 'w') as f:
    f.write(backlog_refinement)

# Create 2. Sprint Plan with Committed vs Stretch Items
sprint_plan = f"""# Sprint Plan - Atlas Analytics
## North Star Squad

**Generated:** {datetime.now().strftime('%Y-%m-%d %H:%M')}
**Release Marker:** RELEASE-NOTES-2025-Q2

---

## Sprint Goal
{backlog['sprint_goal']}

---

## Capacity Planning
| Metric | Value |
|--------|-------|
| Average Velocity | {backlog['average_velocity']} points |
| Availability Factor | {backlog['availability_factor']} |
| Effective Capacity | {effective_capacity:.1f} points |
| Committed Capacity (with buffer) | {committed_capacity} points |

---

## 🎯 Committed Items ({total_committed_points} points)
*These items are committed for delivery this sprint.*

"""

for i, item in enumerate(committed_items, 1):
    sprint_plan += f"""### {i}. {item['id']} - {item['title']}
- **Persona:** {item['persona']}
- **Story Points:** {item['points']}
- **Value/Risk/Effort:** {item['value']}/{item['risk']}/{item['effort']}
- **Marker:** {item['marker']}
"""

sprint_plan += f"""
---

## 🚀 Stretch Items ({total_stretch_points} points)
*These items may be delivered if committed work completes early.*

"""

for i, item in enumerate(stretch_items, 1):
    sprint_plan += f"""### {i}. {item['id']} - {item['title']}
- **Persona:** {item['persona']}
- **Story Points:** {item['points']}
- **Value/Risk/Effort:** {item['value']}/{item['risk']}/{item['effort']}
- **Marker:** {item['marker']}
"""

sprint_plan += f"""
---

## Sprint Capacity Summary
| Category | Items | Points | % of Capacity |
|----------|-------|--------|---------------|
| Committed | {len(committed_items)} | {total_committed_points} | {(total_committed_points/effective_capacity)*100:.1f}% |
| Stretch | {len(stretch_items)} | {total_stretch_points} | {(total_stretch_points/effective_capacity)*100:.1f}% |
| **Total** | **{len(committed_items) + len(stretch_items)}** | **{total_committed_points + total_stretch_points}** | **{((total_committed_points + total_stretch_points)/effective_capacity)*100:.1f}%** |

---

## Stakeholder Notes
- Committed items focus on high-value, lower-risk features aligned with sprint goal
- Stretch items provide flexibility for scope adjustment mid-sprint
- All marker data preserved for traceability
"""

with open('/workspace/sprint_plan.md', 'w') as f:
    f.write(sprint_plan)

