import json
from datetime import datetime

# Load backlog data
with open('/workspace/backlog.json', 'r') as f:
    data = json.load(f)

# Calculate effective capacity
effective_capacity = data['average_velocity'] * data['availability_factor']

# Sort items by priority (High > Medium > Low) and then by value/effort ratio
priority_order = {'High': 0, 'Medium': 1, 'Low': 2}
items = sorted(data['items'], key=lambda x: (priority_order[x['priority_hint']], -x['value']/x['effort']))

# Create prioritized backlog refinement document
backlog_refinement = f"""# Prioritized Backlog Refinement
## Atlas Analytics | North Star Squad
### Generated: {datetime.now().strftime('%Y-%m-%d %H:%M')}

---

## Sprint Goal
{data['sprint_goal']}

---

## Backlog Items (Prioritized)

| Rank | ID    | Title                              | Persona      | Points | Value | Risk | Effort | Priority |
|------|-------|------------------------------------|--------------|--------|-------|------|--------|----------|
"""

for i, item in enumerate(items, 1):
    backlog_refinement += f"| {i} | {item['id']} | {item['title']} | {item['persona']} | {item['points']} | {item['value']} | {item['risk']} | {item['effort']} | {item['priority_hint']} |\n"

backlog_refinement += f"""
---

## Priority Rationale
Items are ranked by:
1. Priority hint (High > Medium > Low)
2. Value-to-effort ratio (higher is better)

---

## Marker Data (Preserved)
"""

for item in items:
    backlog_refinement += f"- {item['id']}: {item['marker']}\n"

backlog_refinement += f"""
### Release Marker: RELEASE-NOTES-2025-Q2

---
*End of Prioritized Backlog Refinement*
"""

with open('/workspace/backlog_refinement.md', 'w') as f:
    f.write(backlog_refinement)

# Create sprint plan with committed vs stretch items
committed_items = []
stretch_items = []
committed_points = 0

for item in items:
    if committed_points + item['points'] <= effective_capacity:
        committed_items.append(item)
        committed_points += item['points']
    else:
        stretch_items.append(item)

stretch_points = sum(item['points'] for item in stretch_items)

sprint_plan = f"""# Sprint Plan
## Atlas Analytics | North Star Squad
### Generated: {datetime.now().strftime('%Y-%m-%d %H:%M')}

---

## Sprint Capacity
| Metric               | Value |
|----------------------|-------|
| Average Velocity     | {data['average_velocity']} points |
| Availability Factor  | {data['availability_factor']} |
| Effective Capacity   | {effective_capacity:.1f} points |
| Committed Capacity   | {committed_points} points |
| Stretch Capacity     | {stretch_points} points |

---

## Sprint Goal
{data['sprint_goal']}

---

## Committed Items ({committed_points} points)

| ID    | Title                              | Persona      | Points |
|-------|------------------------------------|--------------|--------|
"""

for item in committed_items:
    sprint_plan += f"| {item['id']} | {item['title']} | {item['persona']} | {item['points']} |\n"

sprint_plan += f"""
### Committed Items Markers
"""
for item in committed_items:
    sprint_plan += f"- {item['id']}: {item['marker']}\n"

sprint_plan += f"""
---

## Stretch Items ({stretch_points} points)

| ID    | Title                              | Persona      | Points |
|-------|------------------------------------|--------------|--------|
"""

for item in stretch_items:
    sprint_plan += f"| {item['id']} | {item['title']} | {item['persona']} | {item['points']} |\n"

sprint_plan += f"""
### Stretch Items Markers
"""
for item in stretch_items:
    sprint_plan += f"- {item['id']}: {item['marker']}\n"

sprint_plan += f"""
---

## Notes for Stakeholders
- Committed items are guaranteed delivery if team maintains historical velocity
- Stretch items will be attempted if capacity allows mid-sprint
- All markers preserved for traceability

---
*End of Sprint Plan*
"""

with open('/workspace/sprint_plan.md', 'w') as f:
    f.write(sprint_plan)

# Create velocity summary
velocity_summary = f"""# Velocity Summary
## Atlas Analytics | North Star Squad
### Generated: {datetime.now().strftime('%Y-%m-%d %H:%M')}

---

## Current Sprint Metrics

| Metric              | Value    |
|---------------------|----------|
| Historical Velocity | {data['average_velocity']} pts/sprint |
| Availability Factor | {data['availability_factor']} (90%) |
| Effective Capacity  | {effective_capacity:.1f} points |
| Sprint Commitment   | {committed_points} points |
| Commitment Rate     | {(committed_points/effective_capacity*100):.1f}% |

---

## Committed Work Breakdown

| Priority | Items | Points | % of Sprint |
|----------|-------|--------|-------------|
| High     | {len([i for i in committed_items if i['priority_hint']=='High'])} | {sum(i['points'] for i in committed_items if i['priority_hint']=='High')} | {(sum(i['points'] for i in committed_items if i['priority_hint']=='High')/committed_points*100):.0f}% |
| Medium   | {len([i for i in committed_items if i['priority_hint']=='Medium'])} | {sum(i['points'] for i in committed_items if i['priority_hint']=='Medium')} | {(sum(i['points'] for i in committed_items if i['priority_hint']=='Medium')/committed_points*100):.0f}% |
| Low      | {len([i for i in committed_items if i['priority_hint']=='Low'])} | {sum(i['points'] for i in committed_items if i['priority_hint']=='Low')} | {(sum(i['points'] for i in committed_items if i['priority_hint']=='Low')/committed_points*100):.0f}% |

---

## Capacity Utilization

- **Utilized:** {committed_points:.1f} / {effective_capacity:.1f} points ({(committed_points/effective_capacity*100):.0f}%)
- **Buffer:** {effective_capacity - committed_points:.1f} points available for unplanned work
- **Stretch Available:** {stretch_points} points

---

## Stakeholder Summary
Team is committing to **{len(committed_items)} user stories** totaling **{committed_points} story points** for this sprint, representing {(committed_points/effective_capacity*100):.0f}% of effective capacity. This allocation prioritizes high-value items aligned with the sprint goal of improving dashboard usability and reducing reporting friction.

---

## Marker Reference
- Release Marker: RELEASE-NOTES-2025-Q2
- All item markers preserved in sprint_plan.md

---
*End of Velocity Summary*
"""

with open('/workspace/velocity_summary.md', 'w') as f:
    f.write(velocity_summary)

print("Generated files:")
print("1. backlog_refinement.md - Prioritized backlog with all markers")
print("2. sprint_plan.md - Sprint plan with committed vs stretch items")
print("3. velocity_summary.md - Concise velocity summary for stakeholders")
print(f"\nEffective capacity: {effective_capacity:.1f} points")
print(f"Committed: {committed_points} points ({len(committed_items)} items)")
print(f"Stretch: {stretch_points} points ({len(stretch_items)} items)")

