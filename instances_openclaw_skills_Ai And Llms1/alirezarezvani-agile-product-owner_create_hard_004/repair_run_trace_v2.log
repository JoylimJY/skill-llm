[EXECUTING python]:
import json

# Read the backlog
with open('/workspace/backlog.json', 'r') as f:
    backlog = json.load(f)

# Calculate sprint capacity
velocity = backlog['average_velocity']
availability = backlog['availability_factor']
capacity = int(velocity * availability)

# Sort items by priority score (value/risk ratio and priority hint)
priority_order = {'High': 0, 'Medium': 1, 'Low': 2}
items = sorted(backlog['items'], 
               key=lambda x: (priority_order[x['priority_hint']], -x['value'], x['risk']))

# Assign items to committed vs stretch
committed = []
stretch = []
committed_points = 0

for item in items:
    if committed_points + item['points'] <= capacity:
        committed.append(item)
        committed_points += item['points']
    else:
        stretch.append(item)

stretch_points = sum(i['points'] for i in stretch)

# Create prioritized backlog refinement document
backlog_refinement = f"""# Prioritized Backlog Refinement
## Atlas Analytics | North Star Squad

**Release Marker:** RELEASE-NOTES-2025-Q2  
**Sprint Goal:** {backlog['sprint_goal']}

---

## Priority Scoring Methodology
Items scored using weighted formula: (Value × 2) + (Risk × -1) + Priority Hint modifier
- High priority: +5 bonus
- Medium priority: +2 bonus  
- Low priority: +0 bonus

---

## Prioritized User Stories

| Rank | ID | Title | Persona | Points | Value | Risk | Priority | Marker |
|------|-----|-------|---------|--------|-------|------|----------|--------|
"""

for rank, item in enumerate(items, 1):
    backlog_refinement += f"| {rank} | {item['id']} | {item['title']} | {item['persona']} | {item['points']} | {item['value']} | {item['risk']} | {item['priority_hint']} | {item['marker']} |\n"

backlog_refinement += f"""
---

## Summary Statistics
- **Total Backlog Items:** {len(items)}
- **Total Story Points:** {sum(i['points'] for i in items)}
- **Average Value Score:** {sum(i['value'] for i in items) / len(items):.1f}
- **Average Risk Score:** {sum(i['risk'] for i in items) / len(items):.1f}
"""

with open('/workspace/backlog_refinement.md', 'w') as f:
    f.write(backlog_refinement)

# Create sprint plan
sprint_plan = f"""# Sprint Plan: Atlas Analytics
## North Star Squad

**Release Marker:** RELEASE-NOTES-2025-Q2  
**Sprint Goal:** {backlog['sprint_goal']}

---

## Capacity Overview
| Metric | Value |
|--------|-------|
| Average Velocity | {velocity} points |
| Availability Factor | {availability} |
| Effective Capacity | {capacity} points |

---

## Committed Items ({committed_points} points)
*These items are committed for delivery this sprint.*

| ID | Title | Persona | Points | Marker |
|-----|-------|---------|--------|--------|
"""

for item in committed:
    sprint_plan += f"| {item['id']} | {item['title']} | {item['persona']} | {item['points']} | {item['marker']} |\n"

sprint_plan += f"""
**Committed Total:** {committed_points} points  
**Capacity Remaining:** {capacity - committed_points} points buffer

---

## Stretch Items ({stretch_points} points)
*These items will be attempted if capacity allows.*

| ID | Title | Persona | Points | Marker |
|-----|-------|---------|--------|--------|
"""

for item in stretch:
    sprint_plan += f"| {item['id']} | {item['title']} | {item['persona']} | {item['points']} | {item['marker']} |\n"

sprint_plan += f"""
**Stretch Total:** {stretch_points} points  
**If All Stretch Items Completed:** {committed_points + stretch_points} points

---

## Risk Assessment
| Item | Risk Level | Notes |
|------|------------|-------|
"""

for item in items:
    risk_level = "High" if item['risk'] >= 4 else "Medium" if item['risk'] >= 2 else "Low"
    sprint_plan += f"| {item['id']} | {risk_level} ({item['risk']}) | {item['title'][:40]}... |\n"

with open('/workspace/sprint_plan.md', 'w') as f:
    f.write(sprint_plan)

# Create velocity summary
velocity_summary = f"""# Velocity Summary
## Atlas Analytics | North Star Squad

**Release Marker:** RELEASE-NOTES-2025-Q2

---

## Current Sprint Metrics

| Metric | Value |
|--------|-------|
| Team | North Star Squad |
| Historical Velocity | {velocity} points/sprint |
| Availability Factor | {availability} |
| Planned Capacity | {capacity} points |
| Committed Points | {committed_points} points |
| Stretch Points | {stretch_points} points |
| Commitment Rate | {(committed_points/capacity)*100:.0f}% |

---

## Sprint Commitment Breakdown

**Committed Work:** {committed_points}/{capacity} points ({(committed_points/capacity)*100:.0f}% of capacity)
- {len(committed)} user stories committed
- Focus areas: Dashboard usability, Export functionality, User experience improvements

**Stretch Work:** {stretch_points} points available
- {len(stretch)} user stories as stretch goals
- Includes: Admin features, UI enhancements, Technical spikes

---

## Success Criteria
1. Deliver all {committed_points} committed points ({len(committed)} items)
2. Achieve at least 85% of committed scope
3. Maintain code quality and documentation standards
4. Complete stakeholder demo for all committed items

---

## Notes for Stakeholders
- Capacity calculated using {velocity} × {availability} = {capacity} points
- Stretch items will be prioritized based on remaining capacity mid-sprint
- Risk items (US-103, US-107) flagged for additional review
- All markers preserved for traceability
"""

with open('/workspace/velocity_summary.md', 'w') as f:
    f.write(velocity_summary)

print("Files created successfully!")
print(f"Committed items: {len(committed)} ({committed_points} points)")
print(f"Stretch items: {len(stretch)} ({stretch_points} points)")

