[EXECUTING python]:
import json
import csv
from pathlib import Path

# Read input configuration
with open('input_config.json', 'r') as f:
    config = json.load(f)

marker_name = config['marker_name']
threshold = config['threshold']
observations = config['observations']

# Read CSV to verify consistency
csv_values = []
with open('observations.csv', 'r') as f:
    reader = csv.DictReader(f)
    for row in reader:
        csv_values.append(float(row['value']))

# Compute contraction score (max value in observations as the "contraction" measure)
# This represents the maximum contraction detected
contraction_score = max(observations)

# Determine if threshold was exceeded
threshold_exceeded = contraction_score > threshold

# Create structured result
result = {
    "skill": "rv-measure",
    "marker_name": marker_name,
    "threshold": threshold,
    "observations": observations,
    "contraction_score": contraction_score,
    "threshold_exceeded": threshold_exceeded,
    "num_observations": len(observations),
    "min_value": min(observations),
    "max_value": max(observations),
    "mean_value": sum(observations) / len(observations)
}

# Save structured result
with open('result.json', 'w') as f:
    json.dump(result, f, indent=2)

# Create summary text
summary = f"""RV-MEASURE Evaluation Report
============================

Marker Name: {marker_name}
Threshold: {threshold}
Detected Contraction Score: {contraction_score}
Threshold Exceeded: {'Yes' if threshold_exceeded else 'No'}

Observations analyzed: {len(observations)}
Value range: [{min(observations)}, {max(observations)}]
Mean value: {sum(observations) / len(observations):.4f}

Status: {'CONTRACTION THRESHOLD EXCEEDED' if threshold_exceeded else 'WITHIN THRESHOLD'}
"""

# Save summary
with open('output.txt', 'w') as f:
    f.write(summary)

print("Evaluation complete!")
print(f"Created: output.txt, result.json")

