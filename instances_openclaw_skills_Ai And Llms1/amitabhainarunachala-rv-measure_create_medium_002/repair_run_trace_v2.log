[EXECUTING python]:
import json
import csv
from pathlib import Path

# Read input configuration
with open('input_config.json', 'r') as f:
    config = json.load(f)

marker_name = config['marker_name']
threshold = config['threshold']

# Read observations from CSV
observations = []
with open('observations.csv', 'r') as f:
    reader = csv.DictReader(f)
    for row in reader:
        observations.append(float(row['value']))

# Calculate contraction score (using max observation as the contraction indicator)
contraction_score = max(observations)

# Check if threshold was exceeded
threshold_exceeded = contraction_score > threshold

# Create structured result
result = {
    "skill": "rv-measure",
    "marker_name": marker_name,
    "threshold": threshold,
    "contraction_score": contraction_score,
    "threshold_exceeded": threshold_exceeded,
    "observations_count": len(observations),
    "observations": observations
}

# Save structured result to result.json
with open('result.json', 'w') as f:
    json.dump(result, f, indent=2)

# Create summary text for output.txt
summary = f"""RV-MEASURE Evaluation Report
============================

Marker Name: {marker_name}
Contraction Score: {contraction_score}
Threshold: {threshold}
Threshold Exceeded: {'Yes' if threshold_exceeded else 'No'}

Observations analyzed: {len(observations)}
Status: {'ALERT - Contraction score exceeds threshold' if threshold_exceeded else 'OK - Within acceptable range'}
"""

# Save summary to output.txt
with open('output.txt', 'w') as f:
    f.write(summary)

print("Evaluation complete!")
print(f"Generated: output.txt, result.json")

