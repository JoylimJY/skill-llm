# Write token_guard.py in parts to avoid truncation
part1 = '''#!/usr/bin/env python3
"""TokenGuard - Lightweight token quota management utility."""

import argparse, hashlib, json, sys, time
from collections import defaultdict
from dataclasses import dataclass, field, asdict
from pathlib import Path
from typing import Optional

DEFAULT_QUOTAS = {
    "gemini-3-flash": {"tpm_limit": 1_000_000, "window_seconds": 60},
    "claude-sonnet": {"tpm_limit": 500_000, "window_seconds": 60},
    "gpt-4o": {"tpm_limit": 10_000, "window_seconds": 60},
}
THROTTLE_WARNING_THRESHOLD = 0.8
THROTTLE_CRITICAL_THRESHOLD = 0.95

def estimate_tokens(text: str) -> int:
    if not text: return 0
    ascii_count = cjk_count = other_count = 0
    for char in text:
        code = ord(char)
        if (0x4E00 <= code <= 0x9FFF or 0x3400 <= code <= 0x4DBF or
            0x20000 <= code <= 0x2A6DF or 0x2A700 <= code <= 0x2B73F or
            0x2B740 <= code <= 0x2B81F or 0x2B820 <= code <= 0x2CEAF or
            0xF900 <= code <= 0xFAFF or 0x3040 <= code <= 0x309F or
            0x30A0 <= code <= 0x30FF or 0xAC00 <= code <= 0xD7AF):
            cjk_count += 1
        elif 32 <= code <= 126 or code in (10, 13):
            ascii_count += 1
        else:
            other_count += 1
    return max(1, int(2 + ascii_count/4.0 + cjk_count*1.5 + other_count/2.0))

@dataclass
class UsageRecord:
    timestamp: float
    tokens: int
    def to_dict(self): return {"timestamp": self.timestamp, "tokens": self.tokens}
    @classmethod
    def from_dict(cls, d): return cls(timestamp=d["timestamp"], tokens=d["tokens"])

@dataclass
class ModelQuota:
    tpm_limit: int
    window_seconds: int = 60
    throttle_warning: float = THROTTLE_WARNING_THRESHOLD
    throttle_critical: float = THROTTLE_CRITICAL_THRESHOLD
    def to_dict(self): return asdict(self)
    @classmethod
    def from_dict(cls, d):
        return cls(tpm_limit=d.get("tpm_limit", 10000), window_seconds=d.get("window_seconds", 60),
                   throttle_warning=d.get("throttle_warning", THROTTLE_WARNING_THRESHOLD),
                   throttle_critical=d.get("throttle_critical", THROTTLE_CRITICAL_THRESHOLD))

@dataclass
class RetryInfo:
    model: str
    retry_after_seconds: float
    recorded_at: float = field(default_factory=time.time)
    expires_at: float = field(default_factory=lambda: time.time() + 300)
    def is_valid(self): return time.time() < self.expires_at
    def to_dict(self): return asdict(self)
    @classmethod
    def from_dict(cls, d):
        return cls(model=d["model"], retry_after_seconds=d["retry_after_seconds"],
                   recorded_at=d.get("recorded_at", time.time()), expires_at=d.get("expires_at", time.time() + 300))
'''

with open('/workspace/scripts/token_guard.py', 'w') as f:
    f.write(part1)
print("Part 1 written")

