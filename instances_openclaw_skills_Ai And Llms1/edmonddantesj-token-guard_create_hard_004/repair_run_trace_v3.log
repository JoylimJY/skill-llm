#!/usr/bin/env python3
"""
TokenGuard - A pure-Python token estimation and quota management utility.

Features:
- CJK-aware token estimation without external tokenizers
- Per-model quota tracking
- 429 retry-delay parsing
- CLI interface for quota management
"""

import argparse
import json
import re
import sys
import time
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path
from typing import Optional


DEFAULT_QUOTAS = {
    "gemini-3-flash": {"tpm_limit": 1000000},
    "claude-sonnet": {"tpm_limit": 500000},
    "gpt-4o": {"tpm_limit": 3000000},
}


@dataclass
class ModelQuota:
    model: str
    tpm_limit: int
    used_this_minute: int = 0
    retry_after_seconds: Optional[float] = None
    last_429_at: Optional[float] = None
    
    @property
    def remaining(self) -> int:
        return max(0, self.tpm_limit - self.used_this_minute)
    
    @property
    def is_available(self) -> bool:
        return self.used_this_minute < self.tpm_limit
    
    def to_dict(self) -> dict:
        return {
            "model": self.model,
            "tpm_limit": self.tpm_limit,
            "used_this_minute": self.used_this_minute,
            "remaining": self.remaining,
            "retry_after_seconds": self.retry_after_seconds,
            "last_429_at": self.last_429_at,
        }


@dataclass
class TokenGuard:
    quotas: dict = field(default_factory=dict)
    custom_quotas: dict = field(default_factory=dict)
    
    def __post_init__(self):
        for model, config in DEFAULT_QUOTAS.items():
            self.quotas[model] = ModelQuota(
                model=model,
                tpm_limit=config["tpm_limit"]
            )
    
    def add_custom_quota(self, model: str, tpm_limit: int) -> None:
        self.custom_quotas[model] = {"tpm_limit": tpm_limit}
        self.quotas[model] = ModelQuota(model=model, tpm_limit=tpm_limit)
    
    def estimate_tokens(self, text: str) -> int:
        if not text:
            return 0
        token_count = 0
        cjk_pattern = re.compile(
            r'[\u4e00-\u9fff]' +
            r'[\u3400-\u4dbf]' +
            r'[\uf900-\ufaff]' +
            r'[\u3040-\u309f]' +
            r'[\u30a0-\u30ff]' +
            r'[\uac00-\ud7af]'
        )
        for char in text:
            if cjk_pattern.match(char):
                token_count += 1
            elif char.isspace():
                token_count += 0.25
            elif char.isalnum() or char in '.,!?;:()[]{}""\'':
                token_count += 0.25
            else:
                token_count += 0.5
        return int(round(token_count))
    
    def get_quota(self, model: str) -> Optional[ModelQuota]:
        return self.quotas.get(model)
    
    def check_request(self, model: str, text: str) -> dict:
        quota = self.get_quota(model)
        if not quota:
            return {"allowed": False, "reason": "unknown_model", "model": model}
        estimated_tokens = self.estimate_tokens(text)
        can_proceed = estimated_tokens <= quota.remaining
        return {
            "allowed": can_proceed,
            "estimated_tokens": estimated_tokens,
            "remaining": quota.remaining,
            "tpm_limit": quota.tpm_limit,
            "model": model,
            "reason": None if can_proceed else "quota_exceeded",
        }
    
    def record_usage(self, model: str, tokens: int) -> dict:
        quota = self.get_quota(model)
        if not quota:
            return {"success": False, "reason": "unknown_model", "model": model}
        quota.used_this_minute += tokens
        return {
            "success": True,
            "model": model,
            "tokens_recorded": tokens,
            "used_this_minute": quota.used_this_minute,
            "remaining": quota.remaining,
        }
    
    def parse_retry_after(self, retry_after: str) -> Optional[float]:
        try:
            return float(retry_after.strip())
        except ValueError:
            pass
        date_formats = ["%a, %d %b %Y %H:%M:%S GMT", "%a, %d %b %Y %H:%M:%S %Z"]
        for fmt in date_formats:
            try:
                retry_time = datetime.strptime(retry_after.strip(), fmt)
                if retry_time.tzinfo is None:
                    retry_time = retry_time.replace(tzinfo=timezone.utc)
                now = datetime.now(timezone.utc)
                delta = (retry_time - now).total_seconds()
                return max(0.0, delta)
            except ValueError:
                continue
        return None
    
    def record_429(self, model: str, retry_after: str) -> dict:
        quota = self.get_quota(model)
        if not quota:
            return {"success": False, "reason": "unknown_model", "model": model}
        retry_seconds = self.parse_retry_after(retry_after)
        if retry_seconds is None:
            return {"success": False, "reason": "invalid_retry_after", "model": model}
        quota.retry_after_seconds = retry_seconds
        quota.last_429_at = time.time()
        return {
            "success": True,
            "model": model,
            "retry_after_seconds": retry_seconds,
            "last_429_at": quota.last_429_at,
        }
    
    def status_summary(self) -> dict:
        return {
            "status": "active",
            "marker": "TOKEN_GUARD_READY",
            "models": {model: quota.to_dict() for model, quota in self.quotas.items()},
            "custom_quotas": self.custom_quotas,
            "timestamp": time.time(),
        }
