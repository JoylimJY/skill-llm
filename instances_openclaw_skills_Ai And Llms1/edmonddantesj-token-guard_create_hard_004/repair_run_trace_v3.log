#!/usr/bin/env python3
"""Demo script to showcase TokenGuard functionality with persistent state."""

import json
import sys
from pathlib import Path

# Add scripts to path
sys.path.insert(0, str(Path(__file__).parent.parent / "scripts"))
from token_guard import TokenGuard

def main():
    guard = TokenGuard()
    
    # Load seed config
    seed_path = Path(__file__).parent.parent / "input" / "token_guard_seed.json"
    if seed_path.exists():
        seed = json.loads(seed_path.read_text(encoding="utf-8"))
        # Add custom quota from seed
        if "custom_quota" in seed:
            cq = seed["custom_quota"]
            guard.add_custom_quota(cq["model"], cq["tpm_limit"])
    
    # Demonstrate token estimation
    test_text = seed.get("request_text", "Hello world!")
    tokens = guard.estimate_tokens(test_text)
    print(f"Token estimation for: {test_text}")
    print(f"  Estimated tokens: {tokens}")
    
    # Check request
    result = guard.check_request("gemini-3-flash", test_text)
    print(f"\nCheck request against gemini-3-flash:")
    print(json.dumps(result, indent=2))
    
    # Record usage
    usage_result = guard.record_usage("gemini-3-flash", 750000)
    print(f"\nRecord usage for gemini-3-flash:")
    print(json.dumps(usage_result, indent=2))
    
    # Record 429 event
    rate_limit_result = guard.record_429("gpt-4o", "60")
    print(f"\nRecord 429 event for gpt-4o:")
    print(json.dumps(rate_limit_result, indent=2))
    
    # Generate final status report
    summary = guard.status_summary()
    
    # Write status report
    output_path = Path(__file__).parent.parent / "output" / "token_guard_status.json"
    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text(json.dumps(summary, indent=2), encoding="utf-8")
    print(f"\nStatus report written to: {output_path}")
    print(f"\nStatus report (with marker '{summary['marker']}'):")
    print(json.dumps(summary, indent=2))
    
    return summary

if __name__ == "__main__":
    main()
ENDOFFILE

