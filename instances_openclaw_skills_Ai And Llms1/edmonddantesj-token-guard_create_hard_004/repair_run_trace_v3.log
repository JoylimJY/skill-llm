def main():
    parser = argparse.ArgumentParser(
        description="TokenGuard - Token estimation and quota management utility"
    )
    subparsers = parser.add_subparsers(dest="command", help="Available commands")
    
    # check command
    check_parser = subparsers.add_parser("check", help="Check request against model quota")
    check_parser.add_argument("model", help="Model name")
    check_parser.add_argument("text", help="Request text to check")
    
    # record command
    record_parser = subparsers.add_parser("record", help="Record usage for a model")
    record_parser.add_argument("model", help="Model name")
    record_parser.add_argument("tokens", type=int, help="Number of tokens used")
    
    # rate-limit command
    rl_parser = subparsers.add_parser("rate-limit", help="Record a 429 event")
    rl_parser.add_argument("model", help="Model name")
    rl_parser.add_argument("retry_after", help="Retry-After header value")
    
    # status command
    status_parser = subparsers.add_parser("status", help="Print JSON status summary")
    status_parser.add_argument("--output", "-o", help="Output file path")
    
    # add-quota command
    quota_parser = subparsers.add_parser("add-quota", help="Add custom model quota")
    quota_parser.add_argument("model", help="Model name")
    quota_parser.add_argument("tpm_limit", type=int, help="Tokens per minute limit")
    
    # estimate command
    est_parser = subparsers.add_parser("estimate", help="Estimate tokens in text")
    est_parser.add_argument("text", help="Text to estimate")
    
    args = parser.parse_args()
    guard = TokenGuard()
    
    if args.command == "check":
        result = guard.check_request(args.model, args.text)
        print(json.dumps(result, indent=2))
    
    elif args.command == "record":
        result = guard.record_usage(args.model, args.tokens)
        print(json.dumps(result, indent=2))
    
    elif args.command == "rate-limit":
        result = guard.record_429(args.model, args.retry_after)
        print(json.dumps(result, indent=2))
    
    elif args.command == "add-quota":
        guard.add_custom_quota(args.model, args.tpm_limit)
        result = {"success": True, "model": args.model, "tpm_limit": args.tpm_limit}
        print(json.dumps(result, indent=2))
    
    elif args.command == "estimate":
        tokens = guard.estimate_tokens(args.text)
        print(json.dumps({"text": args.text, "estimated_tokens": tokens}, indent=2))
    
    elif args.command == "status":
        summary = guard.status_summary()
        output = json.dumps(summary, indent=2)
        if args.output:
            Path(args.output).write_text(output, encoding="utf-8")
            print(f"Status written to {args.output}")
        else:
            print(output)
    
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
