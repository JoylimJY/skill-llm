{
  "files": [
    "system.json",
    "recommendations.json"
  ],
  "properties": {
    "system.json": {
      "must_contain_keys": [
        "system"
      ],
      "system_must_contain_keys": [
        "cpu_name",
        "total_ram_gb"
      ]
    },
    "recommendations.json": {
      "must_contain_keys": [
        "models"
      ],
      "models_array_nonempty": true,
      "at_least_one_model_should_match_use_case_or_name": "coding"
    }
  }
}