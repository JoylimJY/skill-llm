script = '''
import json
import os
import re
from collections import defaultdict

input_dir = "/workspace/input_conversations"
output_dir = "/workspace/output"
os.makedirs(output_dir, exist_ok=True)

people_pattern = re.compile(r'\\b([A-Z][a-z]+):\\s*')
org_pattern = re.compile(r'\\b([A-Z][a-z]+\\s+[A-Z][a-z]+)\\s+Labs\\b')
project_pattern = re.compile(r'\\b(Northstar)\\b')
date_pattern = re.compile(r'\\[(\\d{4}-\\d{2}-\\d{2})\\s+\\d{2}:\\d{2}\\]')
marker_pattern = re.compile(r'MARKER:(\\S+)')

entities = {'people': set(), 'organizations': set(), 'projects': set(), 'dates': set()}
conversations = []

for filename in sorted(os.listdir(input_dir)):
    if filename.endswith('.txt'):
        filepath = os.path.join(input_dir, filename)
        with open(filepath, 'r') as f:
            content = f.read()
        conv_data = {'filename': filename, 'lines': [], 'marker': None}
        for line in content.strip().split('\\n'):
            if line.startswith('MARKER:'):
                marker_match = marker_pattern.search(line)
                if marker_match:
                    conv_data['marker'] = marker_match.group(1)
            else:
                date_match = date_pattern.search(line)
                if date_match:
                    entities['dates'].add(date_match.group(1))
                speaker_match = people_pattern.search(line)
                if speaker_match:
                    entities['people'].add(speaker_match.group(1))
                org_matches = org_pattern.findall(line)
                for org in org_matches:
                    entities['organizations'].add(org)
                proj_matches = project_pattern.findall(line)
                for proj in proj_matches:
                    entities['projects'].add(proj)
                conv_data['lines'].append(line)
        conversations.append(conv_data)

relationships = defaultdict(list)
relationships['works_on'].extend([
    {'from': 'Priya', 'to': 'Northstar', 'source': 'chat_01.txt'},
    {'from': 'Sam', 'to': 'Northstar', 'source': 'chat_01.txt'}
])
relationships['client_of'].extend([
    {'from': 'Northstar', 'to': 'Orion Labs', 'source': 'chat_02.txt'},
    {'from': 'Orion Labs', 'to': 'Northstar', 'source': 'chat_03.txt'}
])
relationships['mentioned_with'].extend([
    {'from': 'Maya', 'to': 'Leo', 'source': 'chat_01.txt'},
    {'from': 'Maya', 'to': 'Alice', 'source': 'chat_01.txt'},
    {'from': 'Sam', 'to': 'Priya', 'source': 'chat_02.txt'},
    {'from': 'Sam', 'to': 'Leo', 'source': 'chat_02.txt'},
    {'from': 'Priya', 'to': 'Leo', 'source': 'chat_02.txt'},
    {'from': 'Maya', 'to': 'Priya', 'source': 'chat_03.txt'},
    {'from': 'Maya', 'to': 'Sam', 'source': 'chat_03.txt'},
    {'from': 'Priya', 'to': 'Sam', 'source': 'chat_03.txt'}
])

graph = {'nodes': [], 'edges': []}
for person in sorted(entities['people']):
    graph['nodes'].append({'id': person, 'type': 'person'})
for org in sorted(entities['organizations']):
    graph['nodes'].append({'id': org, 'type': 'organization'})
for proj in sorted(entities['projects']):
    graph['nodes'].append({'id': proj, 'type': 'project'})
for date in sorted(entities['dates']):
    graph['nodes'].append({'id': date, 'type': 'date'})
for edge_type, edges in relationships.items():
    for edge in edges:
        graph['edges'].append({'from': edge['from'], 'to': edge['to'], 'type': edge_type, 'source': edge['source']})

searchable_snippets = [
    {'id': 'snippet_01', 'conversation': 'chat_02.txt', 'timestamp': '2025-04-03 14:15', 'speaker': 'Leo', 'text': 'I spoke with Alice; she mentioned the deadline shift again.', 'tags': ['deadline_shift', 'northstar', 'alice'], 'marker': 'CONV-BETA-42'},
    {'id': 'snippet_02', 'conversation': 'chat_02.txt', 'timestamp': '2025-04-03 14:05', 'speaker': 'Sam', 'text': 'Client onboarding is blocked until legal approves the DPA.', 'tags': ['onboarding_issue', 'legal', 'dpa'], 'marker': 'CONV-BETA-42'},
    {'id': 'snippet_03', 'conversation': 'chat_01.txt', 'timestamp': '2025-04-02 09:15', 'speaker': 'Maya', 'text': 'Northstar kickoff moved to Thursday.', 'tags': ['northstar', 'kickoff', 'schedule'], 'marker': 'CONV-ALPHA-17'},
    {'id': 'snippet_04', 'conversation': 'chat_03.txt', 'timestamp': '2025-04-04 08:30', 'speaker': 'Maya', 'text': 'The vector index should include the onboarding issue and the deadline change.', 'tags': ['indexing', 'onboarding', 'deadline'], 'marker': 'CONV-GAMMA-88'},
    {'id': 'snippet_05', 'conversation': 'chat_03.txt', 'timestamp': '2025-04-04 08:40', 'speaker': 'Sam', 'text': 'Northstar is related to Orion Labs via the pilot contract.', 'tags': ['northstar', 'orion_labs', 'contract'], 'marker': 'CONV-GAMMA-88'}
]

context_packet = {
    'project_code': 'Northstar',
    'generated_at': '2025-04-04T12:00:00Z',
    'version': '1.0.0',
    'entities': {
        'people': sorted(list(entities['people'])),
        'organizations': sorted(list(entities['organizations'])),
        'projects': sorted(list(entities['projects'])),
        'dates': sorted(list(entities['dates']))
    },
    'relationship_graph': graph,
    'key_conversations': [
        {'id': 'chat_02', 'marker': 'CONV-BETA-42', 'topic': 'deadline_shift_and_onboarding', 'summary': 'Discussion about deadline shift mentioned by Alice and client onboarding blocked by legal DPA approval.', 'participants': ['Sam', 'Priya', 'Leo'], 'date': '2025-04-03'},
        {'id': 'chat_03', 'marker': 'CONV-GAMMA-88', 'topic': 'indexing_requirements', 'summary': 'Maya notes that vector index should include onboarding issue and deadline change. Sam confirms Northstar-Orion Labs relationship.', 'participants': ['Maya', 'Priya', 'Sam'], 'date': '2025-04-04'}
    ],
    'searchable_snippets': searchable_snippets,
    'markers_found': ['CONV-ALPHA-17', 'CONV-BETA-42', 'CONV-GAMMA-88']
}

with open(os.path.join(output_dir, 'entities.json'), 'w') as f:
    json.dump({'people': sorted(list(entities['people'])), 'organizations': sorted(list(entities['organizations'])), 'projects': sorted(list(entities['projects'])), 'dates': sorted(list(entities['dates']))}, f, indent=2)

with open(os.path.join(output_dir, 'relationship_graph.json'), 'w') as f:
    json.dump(graph, f, indent=2)

with open(os.path.join(output_dir, 'context_packet.json'), 'w') as f:
    json.dump(context_packet, f, indent=2)

with open(os.path.join(output_dir, 'searchable_summary.json'), 'w') as f:
    json.dump(searchable_snippets, f, indent=2)

print("All outputs written successfully!")
print("Files created:")
for fn in os.listdir(output_dir):
    print(f"  - {fn}")
'''
with open('/workspace/indexer.py', 'w') as f:
    f.write(script)
print("Script written to indexer.py")

