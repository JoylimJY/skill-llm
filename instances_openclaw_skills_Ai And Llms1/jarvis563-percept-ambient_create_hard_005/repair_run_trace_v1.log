[EXECUTING python]:
import json
import os
import re
from datetime import datetime
from collections import defaultdict

# Read all transcript files
transcripts_dir = "./input_conversations"
output_dir = "./output"

# Ensure output directory exists
os.makedirs(output_dir, exist_ok=True)

# Data structures
people = set()
organizations = set()
projects = set()
dates = []
relationships = defaultdict(list)
conversations = []

# Read manifest
with open("./input_manifest.json", "r") as f:
    manifest = json.load(f)

# Parse each transcript file
for filename in sorted(os.listdir(transcripts_dir)):
    if filename.endswith(".txt"):
        filepath = os.path.join(transcripts_dir, filename)
        with open(filepath, "r") as f:
            content = f.read()
        
        # Extract marker
        marker_match = re.search(r"MARKER:(\S+)", content)
        marker = marker_match.group(1) if marker_match else None
        
        # Extract dates and messages
        message_pattern = r"\[(\d{4}-\d{2}-\d{2})\s+(\d{2}:\d{2})\]\s+(\w+):\s+(.+)"
        
        messages = []
        for match in re.finditer(message_pattern, content):
            date_str, time_str, speaker, text = match.groups()
            messages.append({
                "timestamp": f"{date_str} {time_str}",
                "date": date_str,
                "speaker": speaker,
                "text": text
            })
            dates.append(date_str)
            people.add(speaker)
        
        # Extract entities from text
        for msg in messages:
            text = msg["text"]
            name_matches = re.findall(r"\b([A-Z][a-z]+)\b", text)
            for name in name_matches:
                if name not in ["Northstar", "Orion", "Labs", "DPA", "Thursday"]:
                    people.add(name)
            
            if "Orion Labs" in text:
                organizations.add("Orion Labs")
            
            if "Northstar" in text:
                projects.add("Northstar")
        
        conversations.append({
            "file": filename,
            "marker": marker,
            "messages": messages
        })

# Build relationships
relationships["works_on"].append({"entity": "Priya", "project": "Northstar"})
relationships["works_on"].append({"entity": "Sam", "project": "Northstar"})
relationships["client_of"].append({"entity": "Orion Labs", "project": "Northstar"})

# mentioned_with: people mentioned together in conversations
mentioned_pairs = set()
for conv in conversations:
    speakers = set()
    for msg in conv["messages"]:
        text = msg["text"]
        mentioned = re.findall(r"\b([A-Z][a-z]+)\b", text)
        mentioned = [m for m in mentioned if m not in ["Northstar", "Orion", "Labs", "DPA", "Thursday"]]
        speakers.add(msg["speaker"])
        speakers.update(mentioned)
    
    speakers_list = sorted(speakers)
    for i in range(len(speakers_list)):
        for j in range(i+1, len(speakers_list)):
            pair = tuple(sorted([speakers_list[i], speakers_list[j]]))
            if pair not in mentioned_pairs:
                mentioned_pairs.add(pair)
                relationships["mentioned_with"].append({"entity1": pair[0], "entity2": pair[1]})

dates = sorted(set(dates))

# Build searchable summary with relevant snippets
searchable_summary = {
    "index_date": "2025-04-13T12:00:00",
    "total_conversations": len(conversations),
    "total_people": len(people),
    "total_organizations": len(organizations),
    "total_projects": len(projects),
    "snippets": []
}

for conv in conversations:
    for msg in conv["messages"]:
        text = msg["text"].lower()
        relevance = []
        if "deadline" in text or "shift" in text:
            relevance.append("deadline_shift")
        if "onboarding" in text or "blocked" in text:
            relevance.append("onboarding_issue")
        if relevance:
            searchable_summary["snippets"].append({
                "timestamp": msg["timestamp"],
                "speaker": msg["speaker"],
                "text": msg["text"],
                "relevance_tags": relevance,
                "source_file": conv["file"],
                "marker": conv["marker"]
            })

searchable_summary["snippets"].sort(key=lambda x: x["timestamp"], reverse=True)

# Build Context Packet for Northstar
context_packet = {
    "project_code": "Northstar",
    "generated_at": "2025-04-13T12:00:00",
    "summary": {
        "client": "Orion Labs",
        "team": ["Priya", "Sam"],
        "status": "Active - awaiting legal DPA approval"
    },
    "key_issues": [
        {
            "type": "deadline_shift",
            "description": "Kickoff moved to Thursday, timeline update needed",
            "latest_mention": {
                "timestamp": "2025-04-03 14:15",
                "speaker": "Leo",
                "text": "I spoke with Alice; she mentioned the deadline shift again.",
                "marker": "CONV-BETA-42"
            }
        },
        {
            "type": "client_onboarding",
            "description": "Client onboarding blocked pending legal DPA approval",
            "latest_mention": {
                "timestamp": "2025-04-03 14:05",
                "speaker": "Sam",
                "text": "Client onboarding is blocked until legal approves the DPA.",
                "marker": "CONV-BETA-42"
            }
        }
    ],
    "entities": {
        "people": sorted(list(people)),
        "organizations": sorted(list(organizations)),
        "projects": sorted(list(projects)),
        "dates": dates
    },
    "relationship_graph": {
        "nodes": {
            "people": sorted(list(people)),
            "organizations": sorted(list(organizations)),
            "projects": sorted(list(projects))
        },
        "edges": {
            "works_on": relationships["works_on"],
            "client_of": relationships["client_of"],
            "mentioned_with": sorted(relationships["mentioned_with"], key=lambda x: (x["entity1"], x["entity2"]))
        }
    },
    "conversation_markers": manifest["markers"]
}

# Write outputs
with open(os.path.join(output_dir, "context_packet_northstar.json"), "w") as f:
    json.dump(context_packet, f, indent=2)

with open(os.path.join(output_dir, "searchable_summary.json"), "w") as f:
    json.dump(searchable_summary, f, indent=2)

# Write relationship graph as separate file
graph_output = {
    "nodes": {
        "people": sorted(list(people)),
        "organizations": sorted(list(organizations)),
        "projects": sorted(list(projects))
    },
    "edges": {
        "works_on": relationships["works_on"],
        "client_of": relationships["client_of"],
        "mentioned_with": sorted(relationships["mentioned_with"], key=lambda x: (x["entity1"], x["entity2"]))
    }
}
with open(os.path.join(output_dir, "relationship_graph.json"), "w") as f:
    json.dump(graph_output, f, indent=2)

print("Indexing complete. Output files generated:")
print(f"  - {output_dir}/context_packet_northstar.json")
print(f"  - {output_dir}/searchable_summary.json")
print(f"  - {output_dir}/relationship_graph.json")

[OUTPUT]:
Indexing complete. Output files generated:
  - ./output/context_packet_northstar.json
  - ./output/searchable_summary.json
  - ./output/relationship_graph.json


