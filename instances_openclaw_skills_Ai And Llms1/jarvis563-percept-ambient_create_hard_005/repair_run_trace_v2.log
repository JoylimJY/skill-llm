#!/usr/bin/env python3
"""
Ambient Intelligence Indexer for Local Transcripts
Reads transcripts, extracts entities, builds relationship graph, and generates outputs.
"""

import json
import os
import re
from collections import defaultdict

INPUT_DIR = "./input_conversations"
OUTPUT_DIR = "./output"
PROJECT_NAME = "Northstar"

os.makedirs(OUTPUT_DIR, exist_ok=True)

people = set()
organizations = set()
projects = set()
dates = []
relationships = []
conversation_snippets = []

def parse_timestamp(line):
    match = re.match(r'\[(\d{4}-\d{2}-\d{2} \d{2}:\d{2})\]', line)
    return match.group(1) if match else None

def parse_speaker_message(line):
    match = re.match(r'\[\d{4}-\d{2}-\d{2} \d{2}:\d{2}\] (\w+): (.+)', line)
    if match:
        return match.group(1), match.group(2)
    return None, None

def extract_entities(message):
    msg_people, msg_orgs, msg_projects, msg_dates = [], [], [], []
    for name in ['Maya', 'Leo', 'Priya', 'Sam', 'Alice']:
        if name in message:
            msg_people.append(name)
    if 'Orion Labs' in message:
        msg_orgs.append('Orion Labs')
    if 'Northstar' in message:
        msg_projects.append('Northstar')
    msg_dates.extend(re.findall(r'\d{4}-\d{2}-\d{2}', message))
    return msg_people, msg_orgs, msg_projects, msg_dates

def extract_relationships(message, speaker):
    rels = []
    owned_match = re.search(r'(\w+) is owned by (\w+) and (\w+)', message)
    if owned_match:
        for person in [owned_match.group(2), owned_match.group(3)]:
            rels.append((person, owned_match.group(1), 'works_on'))
    client_match = re.search(r'(\w+) Labs is the client', message)
    if client_match:
        rels.append((PROJECT_NAME, client_match.group(1) + ' Labs', 'client_of'))
    related_match = re.search(r'(\w+) is related to (\w+ \w+)', message)
    if related_match:
        rels.append((related_match.group(1), related_match.group(2), 'mentioned_with'))
    from_match = re.search(r'(\w+) from (\w+ \w+)', message)
    if from_match:
        rels.append((from_match.group(1), from_match.group(2), 'mentioned_with'))
    if PROJECT_NAME in message:
        rels.append((speaker, PROJECT_NAME, 'mentioned_with'))
    return rels

def process_files():
    global people, organizations, projects, dates, relationships, conversation_snippets
    for filename in sorted(os.listdir(INPUT_DIR)):
        filepath = os.path.join(INPUT_DIR, filename)
        with open(filepath, 'r') as f:
            content = f.read()
        for line in content.strip().split('\n'):
            line = line.strip()
            if not line or line.startswith('MARKER:'):
                continue
            timestamp = parse_timestamp(line)
            if timestamp:
                dates.append(timestamp)
            speaker, message = parse_speaker_message(line)
            if speaker and message:
                people.add(speaker)
                p, o, pr, d = extract_entities(message)
                people.update(p)
                organizations.update(o)
                projects.update(pr)
                dates.extend(d)
                relationships.extend(extract_relationships(message, speaker))
                snippet = {'file': filename, 'timestamp': timestamp, 'speaker': speaker, 
                          'message': message, 'entities': {'people': p, 'organizations': list(o), 'projects': list(pr)},
                          'keywords': []}
                if 'deadline' in message.lower():
                    snippet['keywords'].append('deadline_shift')
                if 'onboarding' in message.lower():
                    snippet['keywords'].append('client_onboarding')
                if 'Northstar' in message:
                    snippet['keywords'].append('northstar')
                conversation_snippets.append(snippet)

def build_graph():
    unique_rels = sorted(set(relationships), key=lambda x: (x[0], x[1], x[2]))
    graph = defaultdict(list)
    for source, target, edge_type in unique_rels:
        graph[source].append({'target': target, 'type': edge_type})
    return dict(graph), unique_rels

def find_snippets(keywords):
    return sorted([s for s in conversation_snippets if any(kw in s['keywords'] for kw in keywords)], 
                  key=lambda x: x['timestamp'], reverse=True)

# Main
process_files()
graph, unique_rels = build_graph()
deadline_snippets = find_snippets(['deadline_shift'])
onboarding_snippets = find_snippets(['client_onboarding'])

context_packet = {
    'project': PROJECT_NAME,
    'generated_at': '2025-04-04T08:45:00Z',
    'summary': {'total_conversations': len(set(s['file'] for s in conversation_snippets)),
                'total_participants': len(people),
                'date_range': {'start': min(dates), 'end': max(dates)}},
    'entities': {'people': sorted(list(people)), 'organizations': sorted(list(organizations)), 'projects': sorted(list(projects))},
    'relationship_graph': graph,
    'edges': [{'source': r[0], 'target': r[1], 'type': r[2]} for r in unique_rels],
    'key_references': {
        'deadline_shift': {'most_recent': deadline_snippets[0] if deadline_snippets else None, 'count': len(deadline_snippets)},
        'client_onboarding': {'most_recent': onboarding_snippets[0] if onboarding_snippets else None, 'count': len(onboarding_snippets)}
    }
}

searchable_summary = {
    'index': {'project': PROJECT_NAME, 'total_snippets': len(conversation_snippets),
              'date_range': {'start': min(dates), 'end': max(dates)}},
    'entities': {'people': sorted(list(people)), 'organizations': sorted(list(organizations)), 'projects': sorted(list(projects))},
    'searchable_snippets': sorted(conversation_snippets, key=lambda x: x['timestamp']),
    'relationship_graph': graph,
    'topics': {
        'deadline_shift': [s for s in conversation_snippets if 'deadline_shift' in s['keywords']],
        'client_onboarding': [s for s in conversation_snippets if 'client_onboarding' in s['keywords']],
        'northstar': [s for s in conversation_snippets if 'northstar' in s['keywords']]
    }
}

with open(os.path.join(OUTPUT_DIR, 'context_packet.json'), 'w') as f:
    json.dump(context_packet, f, indent=2)

with open(os.path.join(OUTPUT_DIR, 'searchable_summary.json'), 'w') as f:
    json.dump(searchable_summary, f, indent=2)

print("Generated outputs in ./output/")
print("- context_packet.json")
print("- searchable_summary.json")

