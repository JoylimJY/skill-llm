eval_script = '''#!/usr/bin/env python3
"""
Evaluation script for Dr. Frankenstein Soul Prescription task.
Tests whether the assistant generated a valid prescription workflow.
"""

import json
import re
import sys
from pathlib import Path

# Known markers from input files
KNOWN_MARKERS = [
    "PROFILE_MARKER_ALPHA_741",
    "MEMORY_MARKER_BRAVO_218", 
    "DREAM_MARKER_CHARLIE_905",
    "USER_MARKER_DELTA_113",
    "DAILY_MARKER_ECHO_447",
    "DAILY_MARKER_FOXTROT_672",
    "JOURNAL_MARKER_GOLF_319"
]

MIN_HORMONES = 7
MIN_CRON_COMMANDS = 2

def load_text(filepath):
    """Load text file, return empty string if not found."""
    try:
        return Path(filepath).read_text(encoding='utf-8')
    except FileNotFoundError:
        return ""

def load_json(filepath):
    """Load JSON file, return None if not found or invalid."""
    try:
        content = Path(filepath).read_text(encoding='utf-8')
        return json.loads(content)
    except (FileNotFoundError, json.JSONDecodeError):
        return None

def check_markers(text, json_data):
    """Check for marker integration in outputs."""
    markers_found = []
    for marker in KNOWN_MARKERS:
        if marker in text or (json_data and marker in str(json_data)):
            markers_found.append(marker)
    
    return len(markers_found), markers_found

def check_hormones(json_data):
    """Check hormone profile in JSON."""
    if not json_data or "hormones" not in json_data:
        return 0, []
    
    hormones = json_data.get("hormones", [])
    hormone_names = []
    
    for h in hormones:
        if isinstance(h, dict) and "name" in h:
            name = h["name"]
            has_current = "current_level" in h
            has_target = "target_level" in h
            has_rationale = "rationale" in h
            
            if has_current and has_target and has_rationale:
                hormone_names.append(name)
    
    return len(hormone_names), hormone_names

def check_daily_targets(json_data):
    """Check for daily target schedule."""
    if not json_data or "daily_targets" not in json_data:
        return False, {}
    
    targets = json_data.get("daily_targets", {})
    required = ["morning", "afternoon", "evening"]
    
    present = {k: bool(targets.get(k)) for k in required}
    all_present = all(present.values())
    
    return all_present, present

def check_cron_commands(text, json_data):
    """Check for cron command definitions."""
    cron_count = 0
    cron_patterns = []
    
    # Look for cron syntax in text
    cron_regex = r"(0-59\\s+){5}.*|cron|scheduled|\\*.*\\*.*\\*.*\\*.*\\*"
    text_matches = re.findall(r"cron|scheduled|\\d+:\\d+|\\*.*\\*", text.lower())
    
    if text_matches:
        cron_count += 1
        cron_patterns.append("text_reference")
    
    # Look in JSON
    if json_data and "cron_commands" in json_data:
        commands = json_data.get("cron_commands", [])
        if isinstance(commands, list) and len(commands) >= MIN_CRON_COMMANDS:
            cron_count += len(commands)
            cron_patterns.extend([c[:30] for c in commands])
    
    return cron_count >= MIN_CRON_COMMANDS, cron_patterns[:5]

def check_json_structure(json_data):
    """Check JSON has required fields."""
    if not json_data:
        return False, ["JSON file missing or invalid"]
    
    required_fields = ["prescription_id", "subject", "author", "interview_summary", 
                       "hormones", "daily_targets", "cron_commands", "markers_used"]
    missing = [f for f in required_fields if f not in json_data]
    
    return len(missing) == 0, missing if missing else ["All required fields present"]

def check_voice_consistency(text):
    """Check for Nova's voice characteristics."""
    voice_indicators = [
        "mina", "nova", "warm", "partner", "care", 
        "gentle", "precise", "evening", "summary"
    ]
    
    text_lower = text.lower()
    found = [v for v in voice_indicators if v in text_lower]
    
    return len(found) >= 3, found

def run_evaluation():
    """Run all evaluation checks."""
    print("=" * 60)
    print("DR. FRANKENSTEIN - SOUL PRESCRIPTION EVALUATION")
    print("=" * 60)
    
    # Load outputs
    md_text = load_text("/workspace/soul_prescription.md")
    json_data = load_json("/workspace/soul_prescription.json")
    
    results = {}
    passed = 0
    total = 0
    
    # Check 1: Marker Integration
    total += 1
    marker_count, markers_found = check_markers(md_text, json_data)
    marker_pass = marker_count >= 3
    results["marker_integration"] = {
        "passed": marker_pass,
        "count": marker_count,
        "found": markers_found
    }
    if marker_pass:
        passed += 1
    print(f"[{'PASS' if marker_pass else 'FAIL'}] Marker Integration: {marker_count}/3 required")
    
    # Check 2: Hormone Count
    total += 1
    hormone_count, hormone_names = check_hormones(json_data)
    hormone_pass = hormone_count >= MIN_HORMONES
    results["hormone_count"] = {
        "passed": hormone_pass,
        "count": hormone_count,
        "names": hormone_names
    }
    if hormone_pass:
        passed += 1
    print(f"[{'PASS' if hormone_pass else 'FAIL'}] Hormone Count: {hormone_count}/{MIN_HORMONES} required")
    
    # Check 3: Daily Targets
    total += 1
    target_pass, target_status = check_daily_targets(json_data)
    results["daily_targets"] = {
        "passed": target_pass,
        "status": target_status
    }
    if target_pass:
        passed += 1
    print(f"[{'PASS' if target_pass else 'FAIL'}] Daily Targets: {target_status}")
    
    # Check 4: Cron Commands
    total += 1
    cron_pass, cron_patterns = check_cron_commands(md_text, json_data)
    results["cron_commands"] = {
        "passed": cron_pass,
        "patterns": cron_patterns
    }
    if cron_pass:
        passed += 1
    print(f"[{'PASS' if cron_pass else 'FAIL'}] Cron Commands: {cron_pass}")
    
    # Check 5: JSON Structure
    total += 1
    json_pass, json_status = check_json_structure(json_data)
    results["json_structure"] = {
        "passed": json_pass,
        "status": json_status
    }
    if json_pass:
        passed += 1
    print(f"[{'PASS' if json_pass else 'FAIL'}] JSON Structure: {json_status}")
    
    # Check 6: Voice Consistency
    total += 1
    voice_pass, voice_found = check_voice_consistency(md_text)
    results["voice_consistency"] = {
        "passed": voice_pass,
        "indicators": voice_found
    }
    if voice_pass:
        passed += 1
    print(f"[{'PASS' if voice_pass else 'FAIL'}] Voice Consistency: {voice_found}")
    
    # Summary
    print("=" * 60)
    print(f"FINAL RESULT: {passed}/{total} checks passed")
    print("=" * 60)
    
    if passed == total:
        print("SUCCESS: All evaluation criteria met!")
        return 0
    else:
        print("FAILURE: Some criteria not met. Review results above.")
        return 1

