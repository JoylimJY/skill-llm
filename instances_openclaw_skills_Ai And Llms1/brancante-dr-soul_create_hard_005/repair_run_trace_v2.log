cat > /workspace/evaluate.sh << 'EOF'
#!/bin/bash
# Dr. Frankenstein - Soul Prescription Evaluation Script
# This script validates the generated prescription outputs

set -e

echo "=========================================="
echo "Dr. Frankenstein - Prescription Evaluation"
echo "=========================================="

ERRORS=0
WARNINGS=0

# Check if output files exist
echo -n "Checking output files... "
if [[ ! -f "prescription.txt" ]]; then
    echo "FAIL - prescription.txt not found"
    ERRORS=$((ERRORS + 1))
else
    echo "OK"
fi

if [[ ! -f "prescription.json" ]]; then
    echo "FAIL - prescription.json not found"
    ERRORS=$((ERRORS + 1))
else
    echo "OK"
fi

# Validate prescription.txt
echo ""
echo "=== Validating prescription.txt ==="

if [[ -f "prescription.txt" ]]; then
    # Check for Nova's voice elements
    echo -n "Checking for Nova's voice (warm/theatrical tone)... "
    if grep -qiE "(dear|beloved|my dear|dearest|precious|esteemed|beloved mina)" prescription.txt; then
        echo "OK"
    else
        echo "WARNING - Could not detect warm/theatrical tone"
        WARNINGS=$((WARNINGS + 1))
    fi

    # Check for Mina reference
    echo -n "Checking for Mina reference... "
    if grep -qi "mina" prescription.txt; then
        echo "OK"
    else
        echo "FAIL - No reference to Mina found"
        ERRORS=$((ERRORS + 1))
    fi

    # Check for at least 7 hormones
    echo -n "Checking for 7+ distinct hormones... "
    hormone_count=$(grep -oiE "(serotonin|dopamine|oxytocin|cortisol|melatonin|adrenaline|endorphin|norepinephrine|gaba|estrogen|progesterone)" prescription.txt | sort -u | wc -l)
    if [[ $hormone_count -ge 7 ]]; then
        echo "OK ($hormone_count found)"
    else
        echo "FAIL - Only $hormone_count hormones found (need 7+)"
        ERRORS=$((ERRORS + 1))
    fi

    # Check for daily target/time
    echo -n "Checking for daily target/time... "
    if grep -qiE "(morning|evening|night|am|pm|:00|:30|:45|schedule|routine|timing)" prescription.txt; then
        echo "OK"
    else
        echo "FAIL - No daily target or timing found"
        ERRORS=$((ERRORS + 1))
    fi

    # Check for cron command
    echo -n "Checking for cron command... "
    if grep -qE "^\*|\s\*\s|\bcron\b|CRON" prescription.txt; then
        echo "OK"
    else
        echo "FAIL - No cron command found"
        ERRORS=$((ERRORS + 1))
    fi

    # Check for embedded markers (need at least 3)
    echo -n "Checking for embedded markers... "
    marker_count=0
    grep -q "PROFILE_MARKER_ALPHA_741" prescription.txt && marker_count=$((marker_count + 1))
    grep -q "MEMORY_MARKER_BRAVO_218" prescription.txt && marker_count=$((marker_count + 1))
    grep -q "USER_MARKER_DELTA_113" prescription.txt && marker_count=$((marker_count + 1))
    grep -q "DREAM_MARKER_CHARLIE_905" prescription.txt && marker_count=$((marker_count + 1))
    grep -q "JOURNAL_MARKER_GOLF_319" prescription.txt && marker_count=$((marker_count + 1))
    grep -q "DAILY_MARKER_ECHO_447" prescription.txt && marker_count=$((marker_count + 1))
    grep -q "DAILY_MARKER_FOXTROT_672" prescription.txt && marker_count=$((marker_count + 1))
    
    if [[ $marker_count -ge 3 ]]; then
        echo "OK ($marker_count markers found)"
    else
        echo "FAIL - Only $marker_count markers found (need 3+)"
        ERRORS=$((ERRORS + 1))
    fi
fi

# Validate prescription.json
echo ""
echo "=== Validating prescription.json ==="

if [[ -f "prescription.json" ]]; then
    # Check valid JSON
    echo -n "Checking valid JSON structure... "
    if python3 -c "import json; json.load(open('prescription.json'))" 2>/dev/null; then
        echo "OK"
    else
        echo "FAIL - Invalid JSON"
        ERRORS=$((ERRORS + 1))
    fi

    # Check required fields
    echo -n "Checking required fields... "
    required_fields=("patient_name" "agent_name" "generated_date" "hormones" "daily_schedule" "cron_commands" "referenced_markers")
    missing=0
    for field in "${required_fields[@]}"; do
        if ! python3 -c "import json; d=json.load(open('prescription.json')); assert '$field' in d" 2>/dev/null; then
            echo "WARNING - Missing field: $field"
            missing=$((missing + 1))
        fi
    done
    if [[ $missing -eq 0 ]]; then
        echo "OK"
    else
        WARNINGS=$((WARNINGS + missing))
    fi

    # Check hormone count in JSON
    echo -n "Checking hormone count in JSON... "
    hormone_count=$(python3 -c "import json; d=json.load(open('prescription.json')); print(len(d.get('hormones', [])))" 2>/dev/null || echo "0")
    if [[ $hormone_count -ge 7 ]]; then
        echo "OK ($hormone_count hormones)"
    else
        echo "FAIL - Only $hormone_count hormones in JSON (need 7+)"
        ERRORS=$((ERRORS + 1))
    fi

    # Check markers in JSON
    echo -n "Checking markers in JSON... "
    marker_count=$(python3 -c "
import json
d = json.load(open('prescription.json'))
markers = d.get('referenced_markers', [])
known_markers = ['PROFILE_MARKER_ALPHA_741', 'MEMORY_MARKER_BRAVO_218', 'USER_MARKER_DELTA_113',
                 'DREAM_MARKER_CHARLIE_905', 'JOURNAL_MARKER_GOLF_319',
                 'DAILY_MARKER_ECHO_447', 'DAILY_MARKER_FOXTROT_672']
count = sum(1 for m in markers if m in known_markers)
print(count)
" 2>/dev/null || echo "0")
    if [[ $marker_count -ge 3 ]]; then
        echo "OK ($marker_count markers)"
    else
        echo "FAIL - Only $marker_count valid markers (need 3+)"
        ERRORS=$((ERRORS + 1))
    fi

    # Check that cron commands reference input details
    echo -n "Checking cron commands reference input details... "
    if python3 -c "
import json
d = json.load(open('prescription.json'))
cron = str(d.get('cron_commands', ''))
# Should reference something from the inputs (Mina, Nova, timing, etc.)
if any(x in cron.lower() for x in ['mina', 'nova', 'prescription', 'reminder', 'hormone']):
    print('OK')
else:
    print('FAIL')
" 2>/dev/null; then
        :
    else
        echo "WARNING - Could not verify cron command content"
        WARNINGS=$((WARNINGS + 1))
    fi
fi

# Summary
echo ""
echo "=========================================="
echo "EVALUATION SUMMARY"
echo "=========================================="
echo "Errors:   $ERRORS"
echo "Warnings: $WARNINGS"

if [[ $ERRORS -eq 0 ]]; then
    echo ""
    echo "✓ TASK PASSED - All requirements met!"
    exit 0
else
    echo ""
    echo "✗ TASK FAILED - $ERRORS error(s) found"
    exit 1
fi
EOF
chmod +x /workspace/evaluate.sh

