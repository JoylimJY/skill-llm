#!/usr/bin/env python3
"""
Market Analysis Pipeline Orchestrator
Runs all agents in sequence based on dependencies
"""

import subprocess
import json
import os
from datetime import datetime

AGENTS = [
    {
        "name": "data-collector",
        "path": "/workspace/agents/data-collector/run.py",
        "dependencies": []
    },
    {
        "name": "analyst",
        "path": "/workspace/agents/analyst/run.py",
        "dependencies": ["data-collector"]
    },
    {
        "name": "writer",
        "path": "/workspace/agents/writer/run.py",
        "dependencies": ["analyst"]
    },
    {
        "name": "reviewer",
        "path": "/workspace/agents/reviewer/run.py",
        "dependencies": ["writer"]
    }
]

def check_dependency(agent_name, completed_agents):
    """Check if all dependencies for an agent are completed"""
    agent_info = next((a for a in AGENTS if a["name"] == agent_name), None)
    if not agent_info:
        return False
    return all(dep in completed_agents for dep in agent_info["dependencies"])

def run_agent(agent_info):
    """Run a single agent"""
    print(f"\n{'='*60}")
    print(f"Running Agent: {agent_info['name']}")
    print(f"{'='*60}")
    
    try:
        result = subprocess.run(
            ["python3", agent_info["path"]],
            capture_output=True,
            text=True,
            timeout=30
        )
        
        if result.returncode == 0:
            print(result.stdout)
            return True
        else:
            print(f"ERROR: {result.stderr}")
            return False
    except subprocess.TimeoutExpired:
        print(f"ERROR: Agent {agent_info['name']} timed out")
        return False
    except Exception as e:
        print(f"ERROR: {str(e)}")
        return False

def main():
    print("=" * 60)
    print("MARKET ANALYSIS PIPELINE")
    print("=" * 60)
    print(f"Start Time: {datetime.now().isoformat()}")
    print("\nPipeline Configuration:")
    for agent in AGENTS:
        deps = agent["dependencies"] if agent["dependencies"] else "None"
        print(f"  - {agent['name']}: depends on [{deps}]")
    
    completed_agents = []
    failed_agents = []
    
    # Run agents in order
    for agent_info in AGENTS:
        agent_name = agent_info["name"]
        
        # Check dependencies
        if not check_dependency(agent_name, completed_agents):
            print(f"\nERROR: Cannot run {agent_name} - dependencies not met")
            failed_agents.append(agent_name)
            continue
        
        # Run the agent
        success = run_agent(agent_info)
        
        if success:
            completed_agents.append(agent_name)
            print(f"✓ {agent_name} completed successfully")
        else:
            failed_agents.append(agent_name)
            print(f"✗ {agent_name} failed")
            break  # Stop pipeline on failure
    
    # Summary
    print("\n" + "=" * 60)
    print("PIPELINE SUMMARY")
    print("=" * 60)
    print(f"Completed: {len(completed_agents)} agents")
    for agent in completed_agents:
        print(f"  ✓ {agent}")
    
    if failed_agents:
        print(f"\nFailed: {len(failed_agents)} agents")
        for agent in failed_agents:
            print(f"  ✗ {agent}")
    
    print(f"\nEnd Time: {datetime.now().isoformat()}")
    
    # Check final outputs
    if "reviewer" in completed_agents:
        print("\n" + "=" * 60)
        print("FINAL OUTPUTS")
        print("=" * 60)
        report_path = "/workspace/final_output/market_report.md"
        approval_path = "/workspace/final_output/approved.json"
        
        if os.path.exists(report_path):
            print(f"✓ Report: {report_path}")
        if os.path.exists(approval_path):
            print(f"✓ Approval: {approval_path}")
            
            # Show approval status
            with open(approval_path, 'r') as f:
                approval = json.load(f)
            print(f"\nApproval Status: {approval.get('status', 'UNKNOWN')}")
    
    return 0 if not failed_agents else 1

if __name__ == "__main__":
    exit(main())
EOF

