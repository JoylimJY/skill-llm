#!/usr/bin/env python3
"""Reviewer Agent - Reviews and approves the market report"""

import json
import os
import shutil
from datetime import datetime

def run():
    # Update status
    status_file = "/workspace/agents/reviewer/status.json"
    with open(status_file, 'r') as f:
        status = json.load(f)
    status["status"] = "running"
    with open(status_file, 'w') as f:
        json.dump(status, f, indent=2)
    
    # Read draft report
    input_file = "/workspace/agents/writer/outbox/draft_report.md"
    with open(input_file, 'r') as f:
        report_content = f.read()
    
    # Validation checks
    required_sections = [
        "Executive Summary",
        "Market Overview",
        "Company Analysis",
        "Key Insights",
        "Key Trends",
        "Risk Assessment",
        "Recommendations"
    ]
    
    validation_results = {}
    for section in required_sections:
        validation_results[section.lower().replace(" ", "_")] = section in report_content
    
    all_sections_present = all(validation_results.values())
    
    # Check for data consistency
    data_checks = {
        "has_report_id": "Report ID:" in report_content,
        "has_sector": "Sector:" in report_content,
        "has_market_size": "$" in report_content,
        "has_companies": "Market Leader:" in report_content
    }
    
    all_data_present = all(data_checks.values())
    
    # Determine approval status
    is_approved = all_sections_present and all_data_present
    
    # Create approval record
    approval = {
        "approval_timestamp": datetime.now().isoformat(),
        "report_id": "MKT-2024-Q1",
        "sector": "Electric Vehicles",
        "approved": is_approved,
        "reviewer": "reviewer-agent",
        "validation": {
            "sections_checked": validation_results,
            "data_checks": data_checks,
            "all_sections_present": all_sections_present,
            "all_data_present": all_data_present
        },
        "comments": "Report passed all validation checks" if is_approved else "Report requires revision",
        "final_report_path": "/workspace/final_output/market_report.md",
        "status": "APPROVED" if is_approved else "REJECTED"
    }
    
    # Write approval to outbox
    approval_file = "/workspace/agents/reviewer/outbox/approved.json"
    with open(approval_file, 'w') as f:
        json.dump(approval, f, indent=2)
    
    # Copy report to final output
    final_report_path = "/workspace/final_output/market_report.md"
    shutil.copy(input_file, final_report_path)
    
    # Copy approval to final output
    final_approval_path = "/workspace/final_output/approved.json"
    shutil.copy(approval_file, final_approval_path)
    
    # Update status
    status["status"] = "completed"
    status["output_file"] = approval_file
    status["final_report"] = final_report_path
    status["final_approval"] = final_approval_path
    with open(status_file, 'w') as f:
        json.dump(status, f, indent=2)
    
    print(f"Reviewer: Completed - Report {'APPROVED' if is_approved else 'REJECTED'}")
    print(f"Final report: {final_report_path}")
    print(f"Final approval: {final_approval_path}")

if __name__ == "__main__":
    run()
EOF

