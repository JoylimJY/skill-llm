cat > /workspace/agents/analyst/run.py << 'EOF'
#!/usr/bin/env python3
"""Analyst Agent - Analyzes market data and produces insights"""

import json
import os
from datetime import datetime

def run():
    # Update status
    status_file = "/workspace/agents/analyst/status.json"
    with open(status_file, 'r') as f:
        status = json.load(f)
    status["status"] = "running"
    with open(status_file, 'w') as f:
        json.dump(status, f, indent=2)
    
    # Read collected data
    input_file = "/workspace/agents/data-collector/outbox/collected_data.json"
    with open(input_file, 'r') as f:
        collected = json.load(f)
    
    # Analyze the data
    companies = collected.get("companies", [])
    
    # Calculate metrics
    total_market_share = sum(c.get("market_share", 0) for c in companies)
    total_revenue = sum(c.get("revenue_bn", 0) for c in companies)
    
    # Find top performers
    sorted_by_growth = sorted(companies, key=lambda x: x.get("yoy_growth", 0), reverse=True)
    sorted_by_revenue = sorted(companies, key=lambda x: x.get("revenue_bn", 0), reverse=True)
    
    # Identify leaders
    market_leader = sorted_by_revenue[0] if sorted_by_revenue else None
    growth_leader = sorted_by_growth[0] if sorted_by_growth else None
    
    analysis = {
        "analysis_timestamp": datetime.now().isoformat(),
        "report_id": collected.get("report_id"),
        "sector": collected.get("sector"),
        "market_overview": {
            "total_market_size_bn": collected.get("total_market_size_bn"),
            "projected_cagr": collected.get("projected_cagr"),
            "cagr_percentage": f"{collected.get('projected_cagr', 0) * 100:.1f}%",
            "companies_analyzed": len(companies),
            "total_analyzed_revenue_bn": round(total_revenue, 2),
            "revenue_coverage": f"{(total_revenue / collected.get('total_market_size_bn', 1)) * 100:.1f}%"
        },
        "company_analysis": {
            "market_leader": {
                "name": market_leader.get("name") if market_leader else None,
                "market_share": f"{market_leader.get('market_share', 0) * 100:.1f}%" if market_leader else None,
                "revenue_bn": market_leader.get("revenue_bn") if market_leader else None
            },
            "growth_leader": {
                "name": growth_leader.get("name") if growth_leader else None,
                "yoy_growth": f"{growth_leader.get('yoy_growth', 0) * 100:.1f}%" if growth_leader else None
            },
            "company_rankings": {
                "by_revenue": [c.get("name") for c in sorted_by_revenue],
                "by_growth": [c.get("name") for c in sorted_by_growth]
            }
        },
        "key_insights": [
            f"{market_leader.get('name') if market_leader else 'Market leader'} dominates with {market_leader.get('market_share', 0) * 100:.1f}% market share" if market_leader else "Market leader analysis pending",
            f"{growth_leader.get('name') if growth_leader else 'Growth leader'} shows strongest growth at {growth_leader.get('yoy_growth', 0) * 100:.1f}%" if growth_leader else "Growth analysis pending",
            f"Market projected to grow at {collected.get('projected_cagr', 0) * 100:.1f}% CAGR",
            f"Total market size: ${collected.get('total_market_size_bn', 0):.1f}B"
        ],
        "trends_analysis": collected.get("key_trends", []),
        "risk_analysis": collected.get("risks", []),
        "recommendations": [
            "Focus on battery cost reduction opportunities",
            "Monitor lithium supply chain developments",
            "Track government incentive program changes"
        ]
    }
    
    # Write to outbox
    output_file = "/workspace/agents/analyst/outbox/analysis.json"
    with open(output_file, 'w') as f:
        json.dump(analysis, f, indent=2)
    
    # Update status
    status["status"] = "completed"
    status["output_file"] = output_file
    with open(status_file, 'w') as f:
        json.dump(status, f, indent=2)
    
    print(f"Analyst: Completed - {output_file}")

if __name__ == "__main__":
    run()
EOF

