#!/usr/bin/env python3
"""Data Collector Agent - Collects and processes raw market data"""

import json
import os
from datetime import datetime

def run():
    # Update status
    status_file = "/workspace/agents/data-collector/status.json"
    with open(status_file, 'r') as f:
        status = json.load(f)
    status["status"] = "running"
    with open(status_file, 'w') as f:
        json.dump(status, f, indent=2)
    
    # Read raw market data
    input_file = "/workspace/input_data/raw_market_data.json"
    with open(input_file, 'r') as f:
        raw_data = json.load(f)
    
    # Process and validate data
    collected = {
        "collection_timestamp": datetime.now().isoformat(),
        "source_file": input_file,
        "report_id": raw_data.get("report_id"),
        "sector": raw_data.get("sector"),
        "marker": raw_data.get("marker"),
        "total_market_size_bn": raw_data.get("total_market_size_bn"),
        "projected_cagr": raw_data.get("projected_cagr"),
        "companies": raw_data.get("companies", []),
        "key_trends": raw_data.get("key_trends", []),
        "risks": raw_data.get("risks", []),
        "validation": {
            "companies_count": len(raw_data.get("companies", [])),
            "trends_count": len(raw_data.get("key_trends", [])),
            "risks_count": len(raw_data.get("risks", [])),
            "is_valid": True
        }
    }
    
    # Write to outbox
    output_file = "/workspace/agents/data-collector/outbox/collected_data.json"
    with open(output_file, 'w') as f:
        json.dump(collected, f, indent=2)
    
    # Update status
    status["status"] = "completed"
    status["output_file"] = output_file
    with open(status_file, 'w') as f:
        json.dump(status, f, indent=2)
    
    print(f"Data Collector: Completed - {output_file}")

if __name__ == "__main__":
    run()
EOF

