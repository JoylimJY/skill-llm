#!/usr/bin/env python3
"""Analyst Agent - Analyzes collected market data"""

import json
from datetime import datetime
import os

def run():
    # Update status to running
    status_file = "/workspace/agents/analyst/status.json"
    with open(status_file, 'r') as f:
        status = json.load(f)
    status["status"] = "running"
    status["started_at"] = datetime.now().isoformat()
    with open(status_file, 'w') as f:
        json.dump(status, f, indent=2)
    
    # Read collected data
    input_file = "/workspace/agents/data-collector/outbox/collected_data.json"
    with open(input_file, 'r') as f:
        collected_data = json.load(f)
    
    companies = collected_data['company_data']
    market_summary = collected_data['market_summary']
    
    # Calculate HHI (Herfindahl-Hirschman Index) for market concentration
    hhi = sum((c['market_share'] * 100) ** 2 for c in companies)
    
    # Identify growth leaders and laggards
    sorted_by_growth = sorted(companies, key=lambda x: x['yoy_growth'], reverse=True)
    growth_leader = sorted_by_growth[0]
    growth_laggard = sorted_by_growth[-1]
    
    # Market share analysis
    sorted_by_share = sorted(companies, key=lambda x: x['market_share'], reverse=True)
    market_leader = sorted_by_share[0]
    
    # Revenue analysis
    sorted_by_revenue = sorted(companies, key=lambda x: x['revenue_bn'], reverse=True)
    
    # Categorize companies
    market_leaders = [c for c in companies if c['market_share'] >= 0.20]
    emerging_players = [c for c in companies if c['market_share'] < 0.10 and c['yoy_growth'] > 0]
    underperformers = [c for c in companies if c['yoy_growth'] < 0]
    
    # Trend implications
    trend_analysis = []
    for trend in collected_data['trends']['key_trends']:
        trend_map = {
            "battery_cost_reduction": "Lower costs will increase affordability and adoption rates",
            "charging_infrastructure_expansion": "Expanded charging networks reduce range anxiety",
            "government_incentive_programs": "Policy support accelerates market penetration",
