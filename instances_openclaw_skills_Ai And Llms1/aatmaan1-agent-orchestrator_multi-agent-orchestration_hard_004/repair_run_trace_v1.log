#!/usr/bin/env python3
"""
Market Analysis Pipeline Orchestrator
Executes all agents in sequence with proper dependency management
"""

import subprocess
import sys
from datetime import datetime

def run_agent(agent_name, script_path):
    """Execute an agent script and return success status"""
    print(f"\n{'='*60}")
    print(f"EXECUTING: {agent_name.upper()} AGENT")
    print(f"{'='*60}")
    
    try:
        result = subprocess.run(
            [sys.executable, script_path],
            capture_output=True,
            text=True,
            cwd="/workspace"
        )
        
        if result.returncode == 0:
            print(f"✓ {agent_name} completed successfully")
            return True
        else:
            print(f"✗ {agent_name} failed with error:")
            print(result.stderr)
            return False
    except Exception as e:
        print(f"✗ {agent_name} raised exception: {e}")
        return False

def main():
    print("\n" + "="*60)
    print("MARKET ANALYSIS PIPELINE - ORCHESTRATOR")
    print("="*60)
    print(f"Pipeline Start Time: {datetime.now().isoformat()}")
    
    agents = [
        ("data-collector", "/workspace/agents/data-collector/run.py"),
        ("analyst", "/workspace/agents/analyst/run.py"),
        ("writer", "/workspace/agents/writer/run.py"),
        ("reviewer", "/workspace/agents/reviewer/run.py"),
    ]
    
    all_success = True
    
    for agent_name, script_path in agents:
        success = run_agent(agent_name, script_path)
        if not success:
            all_success = False
            print(f"\n⚠ Pipeline halted due to {agent_name} failure")
            break
    
    print("\n" + "="*60)
    print("PIPELINE EXECUTION SUMMARY")
    print("="*60)
    
    if all_success:
        print("✓ ALL AGENTS COMPLETED SUCCESSFULLY")
        print("\nFinal Deliverables:")
        print("  - Market Report: /workspace/final_output/market_report.md")
        print("  - Approval Doc:  /workspace/final_output/approved.json")
        print(f"\nPipeline End Time: {datetime.now().isoformat()}")
        print("STATUS: PIPELINE COMPLETE")
    else:
        print("✗ PIPELINE FAILED - Check agent outputs for details")
    
    return 0 if all_success else 1

if __name__ == "__main__":
    sys.exit(main())
EOF

