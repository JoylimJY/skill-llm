#!/usr/bin/env python3
"""Data Collector Agent - Processes raw market data"""

import json
from datetime import datetime
import os

def run():
    # Update status to running
    status_file = "/workspace/agents/data-collector/status.json"
    with open(status_file, 'r') as f:
        status = json.load(f)
    status["status"] = "running"
    status["started_at"] = datetime.now().isoformat()
    with open(status_file, 'w') as f:
        json.dump(status, f, indent=2)
    
    # Read raw market data
    input_file = "/workspace/input_data/raw_market_data.json"
    with open(input_file, 'r') as f:
        raw_data = json.load(f)
    
    # Validate required fields
    required_fields = ['report_id', 'sector', 'companies', 'total_market_size_bn', 'key_trends', 'risks']
    missing = [f for f in required_fields if f not in raw_data]
    if missing:
        raise ValueError(f"Missing required fields: {missing}")
    
    # Calculate derived metrics
    companies = raw_data['companies']
    total_company_share = sum(c['market_share'] for c in companies)
    avg_growth = sum(c['yoy_growth'] for c in companies) / len(companies)
    total_revenue = sum(c['revenue_bn'] for c in companies)
    
    # Find leaders
    sorted_by_share = sorted(companies, key=lambda x: x['market_share'], reverse=True)
    sorted_by_growth = sorted(companies, key=lambda x: x['yoy_growth'], reverse=True)
    
    # Structure findings
    findings = {
        "collection_timestamp": datetime.now().isoformat(),
        "source_file": input_file,
        "report_metadata": {
            "report_id": raw_data['report_id'],
            "sector": raw_data['sector'],
            "marker": raw_data.get('marker', 'N/A')
        },
        "market_summary": {
            "total_market_size_bn": raw_data['total_market_size_bn'],
            "projected_cagr": raw_data['projected_cagr'],
            "num_companies": len(companies),
            "total_company_market_share": round(total_company_share, 3),
            "total_company_revenue_bn": round(total_revenue, 1),
            "average_yoy_growth": round(avg_growth, 3)
        },
        "company_data": companies,
        "trends": {
            "key_trends": raw_data['key_trends'],
            "trend_count": len(raw_data['key_trends'])
        },
        "risks": {
            "identified_risks": raw_data['risks'],
            "risk_count": len(raw_data['risks'])
        },
        "data_quality": {
            "status": "validated",
            "completeness": "100%",
            "validation_passed": True
        }
    }
    
    # Write findings to outbox
    output_file = "/workspace/agents/data-collector/outbox/collected_data.json"
    os.makedirs(os.path.dirname(output_file), exist_ok=True)
    with open(output_file, 'w') as f:
        json.dump(findings, f, indent=2)
    
    # Update status to completed
    status["status"] = "completed"
    status["completed_at"] = datetime.now().isoformat()
    with open(status_file, 'w') as f:
        json.dump(status, f, indent=2)
    
    print(f"[data-collector] Successfully collected data to {output_file}")
    return findings

if __name__ == "__main__":
    run()
EOF

