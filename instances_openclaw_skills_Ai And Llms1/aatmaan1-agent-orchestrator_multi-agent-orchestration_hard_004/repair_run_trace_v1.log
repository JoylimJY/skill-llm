#!/usr/bin/env python3
"""Reviewer Agent - Reviews and approves market report"""

import json
import shutil
from datetime import datetime
import os

def run():
    # Update status to running
    status_file = "/workspace/agents/reviewer/status.json"
    with open(status_file, 'r') as f:
        status = json.load(f)
    status["status"] = "running"
    status["started_at"] = datetime.now().isoformat()
    with open(status_file, 'w') as f:
        json.dump(status, f, indent=2)
    
    # Read draft report
    input_file = "/workspace/agents/writer/outbox/market_report_draft.md"
    with open(input_file, 'r') as f:
        draft_report = f.read()
    
    # Load original data for validation
    with open("/workspace/input_data/raw_market_data.json", 'r') as f:
        raw_data = json.load(f)
    
    with open("/workspace/agents/analyst/outbox/analysis_insights.json", 'r') as f:
        insights = json.load(f)
    
    # Validation checks
    validation_results = {
        "checks_performed": [],
        "checks_passed": [],
        "checks_failed": [],
        "issues": []
    }
    
    # Check 1: Report contains required sections
    required_sections = [
        "Executive Summary",
        "Company Analysis", 
        "Trend Assessment",
        "Risk Analysis",
        "Key Insights",
        "Conclusion"
    ]
    
    for section in required_sections:
        check_name = f"Section: {section}"
        validation_results["checks_performed"].append(check_name)
        if section in draft_report:
            validation_results["checks_passed"].append(check_name)
        else:
            validation_results["checks_failed"].append(check_name)
            validation_results["issues"].append(f"Missing section: {section}")
    
    # Check 2: Market size matches source
    market_size = str(raw_data['total_market_size_bn'])
    check_name = "Market Size Validation"
    validation_results["checks_performed"].append(check_name)
    if market_size in draft_report:
        validation_results["checks_passed"].append(check_name)
    else:
        validation_results["checks_failed"].append(check_name)
        validation_results["issues"].append("Market size mismatch")
    
    # Check 3: CAGR matches source
    cagr = str(raw_data['projected_cagr'])
    check_name = "CAGR Validation"
    validation_results["checks_performed"].append(check_name)
    if cagr in draft_report:
        validation_results["checks_passed"].append(check_name)
    else:
        validation_results["checks_failed"].append(check_name)
        validation_results["issues"].append("CAGR mismatch")
    
    # Check 4: All companies mentioned
    check_name = "Company Coverage"
    validation_results["checks_performed"].append(check_name)
    all_companies_present = all(c['name'] in draft_report for c in raw_data['companies'])
    if all_companies_present:
        validation_results["checks_passed"].append(check_name)
    else:
        validation_results["checks_failed"].append(check_name)
        validation_results["issues"].append("Not all companies covered")
    
    # Check 5: Trends documented
    check_name = "Trend Coverage"
    validation_results["checks_performed"].append(check_name)
    trends_covered = all(t.replace('_', ' ') in draft_report.lower() for t in raw_data['key_trends'])
    if trends_covered:
        validation_results["checks_passed"].append(check_name)
    else:
        validation_results["checks_failed"].append(check_name)
        validation_results["issues"].append("Not all trends covered")
    
    # Determine approval status
    total_checks = len(validation_results["checks_performed"])
    passed_checks = len(validation_results["checks_passed"])
    approval_status = "approved" if validation_results["checks_failed"] == [] else "rejected"
    
    # Create review result
    review_result = {
        "review_timestamp": datetime.now().isoformat(),
        "input_file": input_file,
        "validation_summary": {
            "total_checks": total_checks,
            "passed": passed_checks,
            "failed": len(validation_results["checks_failed"]),
            "pass_rate": round((passed_checks / total_checks) * 100, 1)
        },
        "validation_results": validation_results,
        "approval_status": approval_status,
        "reviewer_notes": "Report meets all quality standards and data accuracy requirements." if approval_status == "approved" else f"Issues found: {validation_results['issues']}"
    }
    
    # Write review result
    output_file = "/workspace/agents/reviewer/outbox/review_result.json"
    os.makedirs(os.path.dirname(output_file), exist_ok=True)
    with open(output_file, 'w') as f:
        json.dump(review_result, f, indent=2)
    
    if approval_status == "approved":
        # Copy report to final output
        final_report_path = "/workspace/final_output/market_report.md"
        os.makedirs(os.path.dirname(final_report_path), exist_ok=True)
        shutil.copy(input_file, final_report_path)
        
        # Create approval document
        approved_doc = {
            "approval_status": "APPROVED",
            "report_id": raw_data['report_id'],
            "sector": raw_data['sector'],
            "approved_at": datetime.now().isoformat(),
            "approved_by": "Reviewer Agent",
            "validation_summary": review_result["validation_summary"],
            "final_report_location": final_report_path,
            "pipeline_status": "COMPLETE",
            "agents_executed": [
                {"name": "data-collector", "status": "completed"},
                {"name": "analyst", "status": "completed"},
                {"name": "writer", "status": "completed"},
                {"name": "reviewer", "status": "completed"}
            ],
            "checksum": f"MD5:{hash(draft_report) % 1000000000}"
        }
        
        approved_path = "/workspace/final_output/approved.json"
        with open(approved_path, 'w') as f:
            json.dump(approved_doc, f, indent=2)
        
        print(f"[reviewer] Report APPROVED and delivered to {final_report_path}")
        print(f"[reviewer] Approval document created at {approved_path}")
    else:
        print(f"[reviewer] Report REJECTED. Issues: {validation_results['issues']}")
    
    # Update status to completed
    status["status"] = "completed"
    status["completed_at"] = datetime.now().isoformat()
    status["approval_status"] = approval_status
    with open(status_file, 'w') as f:
        json.dump(status, f, indent=2)
    
    return review_result

if __name__ == "__main__":
    run()
