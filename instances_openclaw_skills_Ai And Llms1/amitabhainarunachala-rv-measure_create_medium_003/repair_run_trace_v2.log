[EXECUTING python]:
import json
import os

def main():
    # Read signals.jsonl
    samples = []
    run_id = None
    signals_marker = None
    
    try:
        with open('/workspace/signals.jsonl', 'r') as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    data = json.loads(line)
                    if run_id is None and 'run_id' in data:
                        run_id = data['run_id']
                    if signals_marker is None and 'marker' in data:
                        signals_marker = data['marker']
                    if 'contraction_score' in data:
                        samples.append(data)
                except json.JSONDecodeError:
                    # Skip malformed JSON lines
                    continue
    except FileNotFoundError:
        print("Warning: signals.jsonl not found")
        return

    # Read notes.txt
    notes_content = ""
    notes_marker = None
    try:
        with open('/workspace/notes.txt', 'r') as f:
            notes_content = f.read()
            # Look for the secondary marker
            if 'recursive self-observation' in notes_content:
                notes_marker = 'recursive self-observation'
    except FileNotFoundError:
        print("Warning: notes.txt not found")
        return

    # Compute metrics
    total_samples = len(samples)
    contracted_count = sum(1 for s in samples if s.get('contraction_score', 1.0) < 0.50)
    
    scores = [s.get('contraction_score', 0) for s in samples if 'contraction_score' in s]
    if scores:
        average_score = round(sum(scores) / len(scores), 3)
    else:
        average_score = 0.0

    # Check if both markers are found
    marker_found = (signals_marker is not None and notes_marker is not None)

    # Create rv_report.json
    report = {
        "run_id": run_id,
        "contracted_count": contracted_count,
        "average_score": average_score,
        "marker_found": marker_found
    }

    with open('/workspace/rv_report.json', 'w') as f:
        json.dump(report, f, indent=2)

    # Create rv_summary.txt
    summary = f"""R_V Contraction Summary
=======================
Total samples: {total_samples}
Contracted samples (score < 0.50): {contracted_count}
Average contraction score: {average_score}
Run ID: {run_id}
"""

    with open('/workspace/rv_summary.txt', 'w') as f:
        f.write(summary)

    print("Pipeline completed successfully!")
    print(f"Generated rv_report.json and rv_summary.txt")

if __name__ == '__main__':
    main()

