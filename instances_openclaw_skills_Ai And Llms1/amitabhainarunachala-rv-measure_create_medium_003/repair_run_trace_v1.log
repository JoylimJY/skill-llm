[EXECUTING python]:
import json

# Read signals.jsonl
signals = []
with open('/workspace/signals.jsonl', 'r') as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        try:
            data = json.loads(line)
            signals.append(data)
        except json.JSONDecodeError:
            # Handle malformed lines gracefully
            continue

# Read notes.txt
notes_content = ""
with open('/workspace/notes.txt', 'r') as f:
    notes_content = f.read()

# Extract run_id from first valid signal entry
run_id = ""
if signals:
    run_id = signals[0].get('run_id', '')

# Calculate contracted_count (samples with contraction_score < 0.50)
contracted_count = 0
total_score = 0.0
valid_samples = 0
for s in signals:
    try:
        score = s.get('contraction_score')
        if score is not None:
            total_score += score
            valid_samples += 1
            if score < 0.50:
                contracted_count += 1
    except (TypeError, ValueError):
        continue

# Calculate average_score
average_score = round(total_score / valid_samples, 3) if valid_samples > 0 else 0.0

# Check for markers
signals_marker_found = False
for s in signals:
    if s.get('marker') == 'signals-marker':
        signals_marker_found = True
        break

notes_marker_found = 'recursive self-observation' in notes_content

marker_found = signals_marker_found and notes_marker_found

# Create rv_report.json
report = {
    'run_id': run_id,
    'contracted_count': contracted_count,
    'average_score': average_score,
    'marker_found': marker_found
}

with open('/workspace/rv_report.json', 'w') as f:
    json.dump(report, f, indent=2)

# Create rv_summary.txt
summary = f"R_V Contraction Analysis Summary\n"
summary += f"================================\n"
summary += f"Total samples: {valid_samples}\n"
summary += f"Contraction count (score < 0.50): {contracted_count}\n"
summary += f"Average score: {average_score}\n"

with open('/workspace/rv_summary.txt', 'w') as f:
    f.write(summary)

print("Generated rv_report.json and rv_summary.txt")
print(f"Report: {report}")

