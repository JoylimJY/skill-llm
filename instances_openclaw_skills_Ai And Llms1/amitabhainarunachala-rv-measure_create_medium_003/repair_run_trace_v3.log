[EXECUTING python]:
import json

def main():
    run_id = None
    samples = []
    signals_marker = None
    notes_marker = None
    
    # Read signals.jsonl
    try:
        with open('signals.jsonl', 'r') as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    data = json.loads(line)
                    if run_id is None and 'run_id' in data:
                        run_id = data['run_id']
                    if 'marker' in data:
                        signals_marker = data['marker']
                    if 'contraction_score' in data:
                        samples.append(data['contraction_score'])
                except json.JSONDecodeError:
                    continue  # Handle malformed lines gracefully
    except FileNotFoundError:
        pass
    
    # Read notes.txt
    try:
        with open('notes.txt', 'r') as f:
            content = f.read()
            # Look for "recursive self-observation" marker
            if 'recursive self-observation' in content:
                notes_marker = 'recursive self-observation'
    except FileNotFoundError:
        pass
    
    # Calculate metrics
    total_samples = len(samples)
    contracted_count = sum(1 for s in samples if s < 0.50)
    average_score = round(sum(samples) / len(samples), 3) if samples else 0.0
    
    # Check if both markers are found
    marker_found = signals_marker is not None and notes_marker is not None
    
    # Create rv_report.json
    report = {
        "run_id": run_id if run_id else "",
        "contracted_count": contracted_count,
        "average_score": average_score,
        "marker_found": marker_found
    }
    
    with open('rv_report.json', 'w') as f:
        json.dump(report, f, indent=2)
    
    # Create rv_summary.txt
    summary = f"""R_V Contraction Summary
=======================
Total samples: {total_samples}
Samples with contraction score below 0.50: {contracted_count}
Average contraction score: {average_score}
Run ID: {run_id if run_id else 'N/A'}
Markers detected: {marker_found}
"""
    
    with open('rv_summary.txt', 'w') as f:
        f.write(summary)
    
    print("Generated rv_report.json and rv_summary.txt")

if __name__ == "__main__":
    main()

