import json
from datetime import datetime

# Define the context packet structure for ORBIT-17
context_packet = {
    "project_marker": "ORBIT-17",
    "generated_at": datetime.now().isoformat(),
    "summary": {
        "description": "Ambient intelligence context packet summarizing recent conversations",
        "conversation_count": 3,
        "participants": ["Alice", "Bob", "Carol"]
    },
    "resolved_entities": [
        {"name": "Alice", "type": "person", "role": "team_member"},
        {"name": "Bob", "type": "person", "role": "team_member"},
        {"name": "Carol", "type": "person", "role": "team_member"},
        {"name": "Project Atlas", "type": "project", "status": "active"},
        {"name": "Northwind Labs", "type": "organization", "role": "client"}
    ],
    "relationships": [
        {
            "source": "Northwind Labs",
            "target": "Project Atlas",
            "type": "client_of",
            "description": "Northwind Labs is the client for Project Atlas"
        }
    ],
    "conversation_history": [
        {
            "id": "conv_001",
            "source_file": "conversation_1.txt",
            "participants": ["Alice", "Bob"],
            "topics": ["launch checklist", "timeline", "client notification"],
            "key_points": [
                "Launch checklist for Project Atlas due by Friday",
                "Bob to notify Northwind Labs about updated timeline"
            ]
        },
        {
            "id": "conv_002",
            "source_file": "conversation_2.txt",
            "participants": ["Alice", "Carol"],
            "topics": ["dashboard", "ambient context", "entity linking"],
            "key_points": [
                "Dashboard should display ambient context packets for recent meetings",
                "Carol linked Northwind Labs and Project Atlas relationship in notes"
            ]
        },
        {
            "id": "conv_003",
            "source_file": "conversation_3.txt",
            "participants": ["Bob", "Alice"],
            "topics": ["privacy controls", "transcripts", "entity graph"],
            "key_points": [
                "Privacy controls must keep transcripts local only",
                "Entity graph should be mentioned in the summary"
            ]
        }
    ],
    "relevant_history": {
        "project_status": "active",
        "pending_actions": [
            "Finalize launch checklist for Project Atlas by Friday",
            "Notify Northwind Labs about updated timeline",
            "Implement ambient context packets in dashboard",
            "Ensure privacy controls keep transcripts local"
        ],
        "entity_graph_notes": "Relationship between Northwind Labs and Project Atlas documented"
    }
}

# Write to JSON file with pretty formatting
with open('/workspace/context_packet.json', 'w') as f:
    json.dump(context_packet, f, indent=2)

print("✓ Context packet generated successfully")
print(f"  → /workspace/context_packet.json")

