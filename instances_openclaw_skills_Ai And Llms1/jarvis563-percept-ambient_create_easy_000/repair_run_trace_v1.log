import json
from datetime import datetime

# Read the conversation files
conversations = []
with open('/workspace/conversation_1.txt', 'r') as f:
    conversations.append(f.read().strip())
with open('/workspace/conversation_2.txt', 'r') as f:
    conversations.append(f.read().strip())
with open('/workspace/conversation_3.txt', 'r') as f:
    conversations.append(f.read().strip())

# Parse and structure the data
context_packet = {
    "meta": {
        "marker": "ORBIT-17",
        "generated_at": datetime.utcnow().isoformat() + "Z",
        "version": "1.0.0",
        "source_files": ["conversation_1.txt", "conversation_2.txt", "conversation_3.txt"]
    },
    "summary": {
        "description": "Ambient intelligence context packet for project ORBIT-17",
        "total_conversations": 3,
        "participants": ["Alice", "Bob", "Carol"]
    },
    "resolved_entities": {
        "people": [
            {"id": "P001", "name": "Alice", "role": "project_lead", "mentions": 3},
            {"id": "P002", "name": "Bob", "role": "communications", "mentions": 2},
            {"id": "P003", "name": "Carol", "role": "documentation", "mentions": 1}
        ],
        "projects": [
            {"id": "PRJ001", "name": "Project Atlas", "status": "in_progress", "deadline": "Friday"}
        ],
        "organizations": [
            {"id": "ORG001", "name": "Northwind Labs", "type": "client"}
        ]
    },
    "relationships": [
        {
            "source": "Northwind Labs",
            "target": "Project Atlas",
            "type": "client_project",
            "noted_by": "Carol"
        },
        {
            "source": "Alice",
            "target": "Project Atlas",
            "type": "leads",
            "noted_by": "system"
        },
        {
            "source": "Bob",
            "target": "Northwind Labs",
            "type": "communicates_with",
            "noted_by": "system"
        }
    ],
    "conversation_history": [
        {
            "file": "conversation_1.txt",
            "timestamp": "session_001",
            "key_points": [
                "Launch checklist for Project Atlas due Friday",
                "Client notification to Northwind Labs pending"
            ],
            "action_items": [
                {"assignee": "Alice", "task": "Finalize launch checklist", "due": "Friday"},
                {"assignee": "Bob", "task": "Notify Northwind Labs of updated timeline"}
            ]
        },
        {
            "file": "conversation_2.txt",
            "timestamp": "session_002",
            "key_points": [
                "Dashboard to show ambient context packets",
                "Entity relationship graph updated"
            ],
            "action_items": [
                {"assignee": "Carol", "task": "Link Northwind Labs and Project Atlas in notes", "status": "completed"}
            ]
        },
        {
            "file": "conversation_3.txt",
            "timestamp": "session_003",
            "key_points": [
                "Privacy controls require local-only transcripts",
                "Entity graph to be included in summary"
            ],
            "action_items": [
                {"assignee": "team", "task": "Ensure privacy controls keep transcripts local"},
                {"assignee": "system", "task": "Include entity graph in summary"}
            ]
        }
    ],
    "entity_graph": {
        "nodes": [
            {"label": "Alice", "type": "person"},
            {"label": "Bob", "type": "person"},
            {"label": "Carol", "type": "person"},
            {"label": "Project Atlas", "type": "project"},
            {"label": "Northwind Labs", "type": "organization"}
        ],
        "edges": [
            {"from": "Alice", "to": "Project Atlas", "relation": "leads"},
            {"from": "Bob", "to": "Northwind Labs", "relation": "notifies"},
            {"from": "Northwind Labs", "to": "Project Atlas", "relation": "client_of"}
        ]
    }
}

# Write to JSON file with pretty formatting
with open('/workspace/context_packet.json', 'w') as f:
    json.dump(context_packet, f, indent=2)

print("[OK] context_packet.json generated successfully")
print(f"[INFO] Marker: ORBIT-17")
print(f"[INFO] Entities resolved: 5 (3 people, 1 project, 1 organization)")
print(f"[INFO] Relationships mapped: 3")
print(f"[INFO] Conversations indexed: 3")

