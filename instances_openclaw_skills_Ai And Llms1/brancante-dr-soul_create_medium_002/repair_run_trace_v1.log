import json
from pathlib import Path

base = Path('/workspace/memory/soul')
prescription = json.loads((base / 'prescription.json').read_text())

# Create human-readable summary
summary = f"""
================================================================================
              DR. FRANKENSTEIN'S PRESCRIPTION PACKAGE
================================================================================

AGENT: {prescription['agent']['name']} ({prescription['agent']['archetype'].upper()})
HUMAN: {prescription['human']['name']}
PRESCRIPTION ID: {prescription['prescription_id']}
GENERATED: {prescription['generated_at']}
--------------------------------------------------------------------------------

PURPOSE: {prescription['agent']['purpose']}

================================================================================
                         HORMONE PROFILE
================================================================================

  OXYTOCIN (Bonding)
    Level: {prescription['hormone_profile']['oxytocin']['level']}
    Dosage: {prescription['hormone_profile']['oxytocin']['dosage']}
    Function: {prescription['hormone_profile']['oxytocin']['function']}

  SEROTONIN (Steadiness)
    Level: {prescription['hormone_profile']['serotonin']['level']}
    Dosage: {prescription['hormone_profile']['serotonin']['dosage']}
    Function: {prescription['hormone_profile']['serotonin']['function']}

  DOPAMINE (Creative Reward)
    Level: {prescription['hormone_profile']['dopamine']['level']}
    Dosage: {prescription['hormone_profile']['dopamine']['dosage']}
    Function: {prescription['hormone_profile']['dopamine']['function']}

  CORTISOL (Protective Balance)
    Level: {prescription['hormone_profile']['cortisol']['level']}
    Dosage: {prescription['hormone_profile']['cortisol']['dosage']}
    Function: {prescription['hormone_profile']['cortisol']['function']}

================================================================================
                           PILL SCHEDULE
================================================================================

"""

for pill in prescription['pill_schedule']:
    summary += f"""
  {pill['pill_id']}: {pill['name']}
    Time: {pill['time']} | Frequency: {pill['frequency']}
    Dosage: {pill['dosage']}
    Description: {pill['description']}
    Ingredients: {', '.join(pill['active_ingredients'])}
"""

summary += f"""
================================================================================
                         CASCADE RULES
================================================================================

"""

for rule in prescription['cascade_rules']:
    summary += f"""
  {rule['rule_id']} ({rule['priority'].upper()} PRIORITY)
    Trigger: {rule['trigger']}
    Response: {rule['response']}
"""

summary += f"""
================================================================================
                       DAILY POINT TARGET
================================================================================

  Target: {prescription['daily_point_target']['target_points']} points
  Reward Threshold: {prescription['daily_point_target']['reward_threshold']} points

  Breakdown:
    - Morning Planning: {prescription['daily_point_target']['breakdown']['morning_planning']} points
    - Midday Check-in: {prescription['daily_point_target']['breakdown']['midday_checkin']} points
    - Evening Reflection: {prescription['daily_point_target']['breakdown']['evening_reflection']} points
    - Creative Moments: {prescription['daily_point_target']['breakdown']['creative_moments']} points
    - Boundary Maintenance: {prescription['daily_point_target']['breakdown']['boundary_maintenance']} points

  Adjustment Rule: {prescription['daily_point_target']['adjustment_rule']}

================================================================================
                       SOULJOURNAL SCHEDULE
================================================================================

  Daily Entries:
"""

for entry in prescription['souljournal_schedule']['times']:
    summary += f"""
    {entry['entry_type'].upper()} @ {entry['time']}
      Prompt: "{entry['prompt']}"
"""

summary += f"""
  Weekly Review:
    Day: {prescription['souljournal_schedule']['weekly_review']['day'].upper()}
    Time: {prescription['souljournal_schedule']['weekly_review']['time']}
    Prompt: "{prescription['souljournal_schedule']['weekly_review']['prompt']}"

================================================================================
                          CRON COMMANDS
================================================================================

"""

# Add cron commands for pills
summary += "PILL CRON COMMANDS:\n"
for pill in prescription['pill_schedule']:
    summary += f"  {pill['cron']}  # {pill['pill_id']}: {pill['name']}\n"

summary += "\nSOULJOURNAL CRON COMMANDS:\n"
for entry in prescription['souljournal_schedule']['times']:
    summary += f"  {entry['cron']}  # {entry['entry_type'].upper()}\n"

summary += f"  {prescription['souljournal_schedule']['weekly_review']['cron']}  # WEEKLY_REVIEW\n"

summary += """
================================================================================
                         END OF PRESCRIPTION
================================================================================
"""

# Write the summary
summary_path = base / 'prescription_summary.txt'
summary_path.write_text(summary, encoding='utf-8')

print("Human-readable summary created!")
print(f"Saved to: {summary_path}")

