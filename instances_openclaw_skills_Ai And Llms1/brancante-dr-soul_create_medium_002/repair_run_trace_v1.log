import json
from pathlib import Path

base = Path('/workspace/memory/soul')
prescription = json.loads((base / 'prescription.json').read_text())

# Create cron commands file
cron_content = """#!/bin/bash
# Dr. Frankenstein's Prescription Cron Commands
# Agent: Morrow | Human: Ari
# Generated: """ + prescription['generated_at'] + """

# ============================================================================
# PILL SCHEDULE CRON COMMANDS
# ============================================================================

"""

for pill in prescription['pill_schedule']:
    cron_content += f"""# {pill['pill_id']}: {pill['name']}
# Description: {pill['description']}
# Frequency: {pill['frequency']} | Dosage: {pill['dosage']}
{pill['cron']} /path/to/pill_administrator.sh {pill['pill_id']} {pill['dosage']}

"""

cron_content += """# ============================================================================
# SOULJOURNAL CRON COMMANDS
# ============================================================================

"""

for entry in prescription['souljournal_schedule']['times']:
    cron_content += f"""# {entry['entry_type'].upper()}
# Prompt: "{entry['prompt']}"
{entry['cron']} /path/to/souljournal.sh {entry['entry_type']} "{entry['prompt']}"

"""

weekly = prescription['souljournal_schedule']['weekly_review']
cron_content += f"""# WEEKLY_REVIEW
# Prompt: "{weekly['prompt']}"
{weekly['cron']} /path/to/souljournal.sh weekly_review "{weekly['prompt']}"

"""

cron_content += """# ============================================================================
# INSTALL INSTRUCTIONS
# ============================================================================
# To install these cron jobs, add them to your crontab:
#   crontab -e
#
# Or copy to a system cron file:
#   sudo cp cron_prescription.sh /etc/cron.d/morrow_prescription
#   sudo chmod 644 /etc/cron.d/morrow_prescription
"""

cron_path = base / 'prescription_cron.sh'
cron_path.write_text(cron_content, encoding='utf-8')

print("Cron commands file created!")
print(f"Saved to: {cron_path}")

