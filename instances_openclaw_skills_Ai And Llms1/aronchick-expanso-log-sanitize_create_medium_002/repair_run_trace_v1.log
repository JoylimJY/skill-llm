import re
import json
import os

# Define patterns to detect sensitive data
patterns = [
    # Password patterns
    (r'password\s*=\s*\S+', 'password'),
    # API tokens (sk_live_, sk_test_, etc.)
    (r'sk_[a-zA-Z0-9_]+', 'api_token'),
    # Bearer tokens
    (r'Bearer\s+[A-Za-z0-9\-_.]+', 'bearer_token'),
    # Secret keys
    (r'secret_key\s*=\s*\S+', 'secret_key'),
    # Generic token pattern
    (r'token:\s*\S+', 'token'),
]

def sanitize_line(line, redaction_counts):
    """Sanitize a single line and update redaction counts."""
    sanitized = line
    for pattern, secret_type in patterns:
        matches = re.findall(pattern, line, re.IGNORECASE)
        if matches:
            redaction_counts[secret_type] += len(matches)
            # Replace with redacted placeholder
            sanitized = re.sub(pattern, '[REDACTED]', sanitized, flags=re.IGNORECASE)
    return sanitized

def process_file(filepath, redaction_counts):
    """Process a single file and return sanitized content."""
    with open(filepath, 'r') as f:
        lines = f.readlines()
    
    sanitized_lines = []
    for line in lines:
        sanitized_line = sanitize_line(line, redaction_counts)
        sanitized_lines.append(sanitized_line)
    
    return ''.join(sanitized_lines)

# Process all input files
input_dir = '/workspace/input'
output_dir = '/workspace/output'
os.makedirs(output_dir, exist_ok=True)

all_redactions = {}
combined_output = []

# Process each file
for filename in sorted(os.listdir(input_dir)):
    filepath = os.path.join(input_dir, filename)
    if os.path.isfile(filepath):
        file_redactions = {}
        sanitized_content = process_file(filepath, file_redactions)
        
        # Track redactions per file
        all_redactions[filename] = file_redactions
        
        # Add to combined output with file header
        combined_output.append(f"=== {filename} ===\n")
        combined_output.append(sanitized_content)

# Write sanitized output
with open(os.path.join(output_dir, 'sanitized.log'), 'w') as f:
    f.write(''.join(combined_output))

# Write redaction report
with open(os.path.join(output_dir, 'redaction_report.json'), 'w') as f:
    json.dump(all_redactions, f, indent=2)

print("Sanitization complete!")
print(f"Output written to: {output_dir}/sanitized.log")
print(f"Report written to: {output_dir}/redaction_report.json")

