[EXECUTING python]:
import re
import json
import os

# Define patterns for sensitive data
patterns = {
    'password': r'(password\s*[=:]?\s*)[^,\s\n]+',
    'api_token': r'(token[:\s]*)sk_[^\s]+',
    'bearer_token': r'(Bearer\s+)[^\s]+',
    'secret_key': r'(secret_key\s*[=:]?\s*)[^,\s\n]+',
    'api_key': r'(api[_-]?key\s*[=:]?\s*)[^,\s\n]+',
    'authorization': r'(Authorization:\s*)Bearer\s+[^\s]+',
}

# Compile regex patterns
compiled_patterns = {
    name: re.compile(pattern, re.IGNORECASE) 
    for name, pattern in patterns.items()
}

# Input and output paths
input_dir = '/workspace/input'
output_dir = '/workspace/output'
sanitized_output = os.path.join(output_dir, 'sanitized.log')
report_output = os.path.join(output_dir, 'redaction_report.json')

# Track redactions per file
redaction_counts = {}

# Process each file in input directory
output_lines = []
for filename in sorted(os.listdir(input_dir)):
    filepath = os.path.join(input_dir, filename)
    if not os.path.isfile(filepath):
        continue
    
    redactions = 0
    file_output_lines = []
    
    with open(filepath, 'r') as f:
        lines = f.readlines()
    
    for line in lines:
        original_line = line
        for pattern_name, pattern in compiled_patterns.items():
            # Count matches before replacing
            matches = pattern.findall(line)
            redactions += len(matches)
            # Replace with redacted value
            line = pattern.sub(r'\1[REDACTED]', line)
        
        file_output_lines.append(line)
    
    redaction_counts[filename] = redactions
    
    # Add filename header to output
    output_lines.append(f"=== {filename} ===")
    output_lines.extend(file_output_lines)
    output_lines.append("")

# Write sanitized output
with open(sanitized_output, 'w') as f:
    f.writelines(output_lines)

# Write redaction report
report = {
    "files_processed": list(redaction_counts.keys()),
    "redactions_per_file": redaction_counts,
    "total_redactions": sum(redaction_counts.values())
}

with open(report_output, 'w') as f:
    json.dump(report, f, indent=2)

print("Sanitization complete!")
print(f"Total redactions: {sum(redaction_counts.values())}")
print(f"Redactions per file: {redaction_counts}")

