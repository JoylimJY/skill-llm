[EXECUTING python]:
import re
import json
import os

# Define patterns for sensitive data
patterns = {
    'password': r'password\s*=\s*[^,\s}\]]+',
    'api_token': r'token:\s*sk_[a-zA-Z0-9]+',
    'bearer_token': r'Bearer\s+[a-zA-Z0-9._-]+',
    'secret_key': r'secret_key\s*=\s*[a-zA-Z0-9_-]+',
    'generic_secret': r'secret\s*=\s*[^,\s}\]]+',
}

def redact_line(line, patterns):
    redactions = 0
    for pattern_name, pattern in patterns.items():
        matches = re.findall(pattern, line, re.IGNORECASE)
        redactions += len(matches)
        line = re.sub(pattern, f'[{pattern_name.upper()}_REDACTED]', line, flags=re.IGNORECASE)
    return line, redactions

def sanitize_file(input_path, patterns):
    with open(input_path, 'r') as f:
        lines = f.readlines()
    
    redacted_lines = []
    total_redactions = 0
    
    for line in lines:
        redacted_line, count = redact_line(line, patterns)
        redacted_lines.append(redacted_line)
        total_redactions += count
    
    return redacted_lines, total_redactions

# Process all input files
input_dir = '/workspace/input'
output_dir = '/workspace/output'
report = {}

all_redacted_content = []

for filename in sorted(os.listdir(input_dir)):
    filepath = os.path.join(input_dir, filename)
    if os.path.isfile(filepath):
        redacted_lines, count = sanitize_file(filepath, patterns)
        report[filename] = count
        
        all_redacted_content.append(f"=== {filename} ===")
        all_redacted_content.extend(redacted_lines)
        all_redacted_content.append("")  # Blank line separator

# Write sanitized.log
with open(os.path.join(output_dir, 'sanitized.log'), 'w') as f:
    f.write('\n'.join(all_redacted_content).rstrip() + '\n')

# Write redaction report
with open(os.path.join(output_dir, 'redaction_report.json'), 'w') as f:
    json.dump(report, f, indent=2)

print("Sanitization complete!")
print(f"Redaction report: {report}")

[OUTPUT]:
Sanitization complete!
Redaction report: {'app.log': 2, 'audit.log': 2, 'marker.json': 0}


