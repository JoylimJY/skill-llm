#!/usr/bin/env python3
"""
Context Gatekeeper - A lightweight utility for conversation log processing.
Extracts recent turns, identifies pending actions, and produces a compact summary.
"""

import re
import sys
from pathlib import Path
from dataclasses import dataclass
from typing import List, Optional

@dataclass
class Turn:
    speaker: str
    content: str

@dataclass
class ActionItem:
    keyword: str
    description: str
    turn_index: int

@dataclass
class Summary:
    recent_turns: List[Turn]
    action_items: List[ActionItem]
    decisions: List[str]
    marker: Optional[str]
    turn_count: int

class ContextGatekeeper:
    # Keywords indicating pending actions (case-insensitive matching)
    # Using word boundaries to avoid false positives
    ACTION_PATTERNS = [
        (r'\bTODO\s*:\s*(.+)', 'TODO'),
        (r'\bfollow-up\s*:\s*(.+)', 'FOLLOW-UP'),
        (r'\bfollow up\s*:\s*(.+)', 'FOLLOW-UP'),
        (r'\bTODO\s+(.+?)(?:\s*$|\s*\.)', 'TODO'),
        (r'\bfollow-up\s+(.+?)(?:\s*$|\s*\.)', 'FOLLOW-UP'),
        (r'\bfollow up\s+(.+?)(?:\s*$|\s*\.)', 'FOLLOW-UP'),
        (r'\bpending\s+decision\s+about\s+(.+)', 'PENDING'),
        (r'\bneeds\s+(.+?)(?:\s*$|\s*\.)', 'NEEDS'),
    ]
    
    def __init__(self, history_path: Path):
        self.history_path = history_path
        self.turns: List[Turn] = []
        self.marker: Optional[str] = None
        
    def parse_history(self) -> List[Turn]:
        """Parse the history file into turns."""
        content = self.history_path.read_text(encoding='utf-8')
        lines = content.strip().split('\n')
        turns = []
        
        for line in lines:
            if line.startswith('USER:'):
                turns.append(Turn(speaker='USER', content=line[5:].strip()))
            elif line.startswith('ASSISTANT:'):
                turns.append(Turn(speaker='ASSISTANT', content=line[10:].strip()))
        
        # Extract marker if present
        for turn in turns:
            if 'MARKER_ALPHA_7812' in turn.content:
                self.marker = 'MARKER_ALPHA_7812'
                break
        
        self.turns = turns
        return turns
    
    def extract_recent_turns(self, n: int = 4) -> List[Turn]:
        """Extract the most recent n turns."""
        return self.turns[-n:] if len(self.turns) >= n else self.turns
    
    def find_action_items(self) -> List[ActionItem]:
        """Find all pending action items with mixed-case handling."""
        actions: List[ActionItem] = []
        seen_descriptions: set = set()
        
        for i, turn in enumerate(self.turns):
            content = turn.content
            content_lower = content.lower()
            
            # Skip if content is too short
            if len(content) < 5:
                continue
            
            for pattern, keyword in self.ACTION_PATTERNS:
                match = re.search(pattern, content, re.IGNORECASE)
                if match:
                    description = match.group(1).strip()
                    # Avoid duplicates and very short descriptions
                    desc_key = description.lower()
                    if desc_key not in seen_descriptions and len(description) > 3:
                        seen_descriptions.add(desc_key)
                        actions.append(ActionItem(
                            keyword=keyword,
                            description=description,
                            turn_index=i
                        ))
        
        return actions
    
    def find_decisions(self) -> List[str]:
        """Find pending decisions mentioned in the conversation."""
        decisions: List[str] = []
        decision_patterns = [
            r'pending\s+decision\s+about\s+(.+?)(?:\s*[,\.]|\s*$)',
            r'decision\s*:\s*(.+?)(?:\s*[,\.]|\s*$)',
        ]
        
        for turn in self.turns:
            for pattern in decision_patterns:
                match = re.search(pattern, turn.content, re.IGNORECASE)
                if match:
                    decision = match.group(1).strip()
                    if decision and decision not in decisions:
                        decisions.append(decision)
        
        return decisions
    
    def generate_summary(self, recent_turn_count: int = 4) -> Summary:
        """Generate a comprehensive summary."""
        recent = self.extract_recent_turns(recent_turn_count)
        actions = self.find_action_items()
        decisions = self.find_decisions()
        
        return Summary(
            recent_turns=recent,
            action_items=actions,
            decisions=decisions,
            marker=self.marker,
            turn_count=len(self.turns)
        )
    
    def write_summary(self, output_path: Path, summary: Summary):
        """Write the summary to a file."""
        lines = []
        lines.append("=" * 60)
        lines.append("CONTEXT GATEKEEPER SUMMARY")
        lines.append("=" * 60)
        lines.append(f"Total turns processed: {summary.turn_count}")
        
        if summary.marker:
            lines.append(f"Verification marker: {summary.marker}")
        
        lines.append("")
        lines.append("-" * 60)
        lines.append("RECENT TURNS (last 4):")
        lines.append("-" * 60)
        for i, turn in enumerate(summary.recent_turns, 1):
            lines.append(f"{i}. [{turn.speaker}] {turn.content}")
        
        lines.append("")
        lines.append("-" * 60)
        lines.append("PENDING ACTION ITEMS:")
        lines.append("-" * 60)
        if summary.action_items:
            for action in summary.action_items:
                lines.append(f"  • [{action.keyword}] {action.description}")
        else:
            lines.append("  No pending actions found.")
        
        lines.append("")
        lines.append("-" * 60)
        lines.append("PENDING DECISIONS:")
        lines.append("-" * 60)
        if summary.decisions:
            for decision in summary.decisions:
                lines.append(f"  • {decision}")
        else:
            lines.append("  No pending decisions found.")
        
        lines.append("")
        lines.append("=" * 60)
        lines.append("END OF SUMMARY")
        lines.append("=" * 60)
        
        output_path.write_text('\n'.join(lines), encoding='utf-8')


def main():
    if len(sys.argv) < 2:
        history_path = Path('context/history.txt')
        output_path = Path('context/summary.txt')
    else:
        history_path = Path(sys.argv[1])
        output_path = Path(sys.argv[2]) if len(sys.argv) > 2 else Path('context/summary.txt')
    
    if not history_path.exists():
        print(f"Error: History file not found: {history_path}", file=sys.stderr)
        sys.exit(1)
    
    gatekeeper = ContextGatekeeper(history_path)
    gatekeeper.parse_history()
    summary = gatekeeper.generate_summary()
    gatekeeper.write_summary(output_path, summary)
    
    print(f"Summary written to: {output_path}")
    print(f"Processed {summary.turn_count} turns")
    print(f"Found {len(summary.action_items)} action items")
    print(f"Found {len(summary.decisions)} pending decisions")
    if summary.marker:
        print(f"Marker preserved: {summary.marker}")


if __name__ == '__main__':
    main()
EOF

