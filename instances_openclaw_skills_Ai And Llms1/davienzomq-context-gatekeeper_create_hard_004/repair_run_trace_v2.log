#!/usr/bin/env python3
"""
Evaluation Harness for Context Gatekeeper.
Verifies that the gatekeeper produces correct summaries with:
- Recent turn extraction
- Pending action detection (multiple keywords, mixed casing)
- Marker preservation
"""

import sys
from pathlib import Path
import subprocess

# Add parent to path for imports
sys.path.insert(0, str(Path(__file__).parent))

from gatekeeper import ContextGatekeeper

def test_gatekeeper_basic():
    """Test basic gatekeeper functionality."""
    print("=== Test: Basic Gatekeeper Functionality ===")
    
    history_path = Path('context/history.txt')
    gatekeeper = ContextGatekeeper(history_path)
    turns = gatekeeper.parse_history()
    
    assert len(turns) == 10, f"Expected 10 turns, got {len(turns)}"
    print(f"✓ Parsed {len(turns)} turns correctly")
    
    # Check recent turns extraction
    recent = gatekeeper.extract_recent_turns(4)
    assert len(recent) == 4, f"Expected 4 recent turns, got {len(recent)}"
    print(f"✓ Extracted {len(recent)} recent turns")
    
    # Check marker preservation
    assert gatekeeper.marker == 'MARKER_ALPHA_7812', f"Marker not found: {gatekeeper.marker}"
    print(f"✓ Marker preserved: {gatekeeper.marker}")
    
    return True

def test_action_item_detection():
    """Test detection of multiple action keywords with mixed casing."""
    print("\n=== Test: Action Item Detection ===")
    
    history_path = Path('context/history.txt')
    gatekeeper = ContextGatekeeper(history_path)
    gatekeeper.parse_history()
    
    actions = gatekeeper.find_action_items()
    
    # Should find TODO and follow-up (mixed case)
    keywords_found = {a.keyword for a in actions}
    
    assert 'TODO' in keywords_found, "TODO keyword not detected"
    print("✓ Detected TODO keyword")
    
    assert 'FOLLOW-UP' in keywords_found, "FOLLOW-UP keyword not detected"
    print("✓ Detected FOLLOW-UP keyword (mixed case)")
    
    # Should have at least 2 action items
    assert len(actions) >= 2, f"Expected at least 2 actions, got {len(actions)}"
    print(f"✓ Found {len(actions)} action items")
    
    return True

def test_summary_generation():
    """Test that summary is generated correctly."""
    print("\n=== Test: Summary Generation ===")
    
    history_path = Path('context/history.txt')
    output_path = Path('context/summary.txt')
    
    # Run the gatekeeper
    result = subprocess.run(
        [sys.executable, 'gatekeeper.py', str(history_path), str(output_path)],
        capture_output=True,
        text=True,
        cwd=str(Path(__file__).parent)
    )
    
    assert result.returncode == 0, f"Gatekeeper failed: {result.stderr}"
    print("✓ Gatekeeper executed successfully")
    
    # Verify output file exists
    assert output_path.exists(), "Summary file not created"
    print("✓ Summary file created")
    
    # Read and verify summary content
    summary_content = output_path.read_text()
    
    # Check for marker
    assert 'MARKER_ALPHA_7812' in summary_content, "Marker not in summary"
    print("✓ Marker present in summary")
    
    # Check for action items
    assert 'TODO' in summary_content or 'todo' in summary_content.lower(), "TODO not in summary"
    print("✓ TODO action item in summary")
    
    assert 'follow-up' in summary_content.lower(), "Follow-up not in summary"
    print("✓ Follow-up action item in summary")
    
    # Check for recent turns
    assert 'RECENT TURNS' in summary_content, "Recent turns section missing"
    print("✓ Recent turns section present")
    
    # Verify the last turns are included (MARKER should be there)
    assert 'MARKER_ALPHA_7812' in summary_content, "Marker from recent turns missing"
    print("✓ Recent turn content preserved")
    
    return True

def test_edge_cases():
    """Test edge cases: empty actions, single turn, etc."""
    print("\n=== Test: Edge Cases ===")
    
    # Test with minimal history
    test_history = Path('context/test_minimal.txt')
    test_history.write_text("USER: Hello\nASSISTANT: Hi there")
    
    gatekeeper = ContextGatekeeper(test_history)
    turns = gatekeeper.parse_history()
    assert len(turns) == 2, "Failed to parse minimal history"
    print("✓ Handles minimal history")
    
    # Test recent turns when fewer than requested
    recent = gatekeeper.extract_recent_turns(10)
    assert len(recent) == 2, "Failed to handle fewer turns than requested"
    print("✓ Handles fewer turns than requested")
    
    # Clean up
    test_history.unlink()
    
    return True

def run_all_tests():
    """Run all tests and report results."""
    print("=" * 60)
    print("CONTEXT GATEKEEPER EVALUATION HARNESS")
    print("=" * 60)
    
    tests = [
        test_gatekeeper_basic,
        test_action_item_detection,
        test_summary_generation,
        test_edge_cases,
    ]
    
    passed = 0
    failed = 0
    
    for test in tests:
        try:
            test()
            passed += 1
        except AssertionError as e:
            print(f"✗ FAILED: {e}")
            failed += 1
        except Exception as e:
            print(f"✗ ERROR: {e}")
            failed += 1
    
    print("\n" + "=" * 60)
    print(f"RESULTS: {passed} passed, {failed} failed")
    print("=" * 60)
    
    return failed == 0

if __name__ == '__main__':
    success = run_all_tests()
    sys.exit(0 if success else 1)
