#!/usr/bin/env python3
"""
Evaluation Harness for Context Gatekeeper.
Verifies that the summary artifact is created and contains expected content.
"""

import sys
from pathlib import Path
import subprocess


def run_gatekeeper(input_path: Path, output_path: Path) -> bool:
    """Run the context gatekeeper and return success status."""
    try:
        result = subprocess.run(
            ['python3', str(Path(__file__).parent / 'context_gatekeeper.py'),
             str(input_path), str(output_path)],
            capture_output=True,
            text=True,
            timeout=30
        )
        return result.returncode == 0
    except Exception as e:
        print(f"Error running gatekeeper: {e}", file=sys.stderr)
        return False


def verify_summary_exists(output_path: Path) -> bool:
    """Verify the summary file was created."""
    if not output_path.exists():
        print(f"FAIL: Summary file not found: {output_path}")
        return False
    print(f"PASS: Summary file exists: {output_path}")
    return True


def verify_recent_turns(summary: str, expected_turns: int = 4) -> bool:
    """Verify that recent turns are included in the summary."""
    # Check for RECENT TURNS section
    if 'RECENT TURNS' not in summary.upper():
        print("FAIL: RECENT TURNS section not found")
        return False
    
    # Check that we have turn indicators
    turn_count = summary.count('Turn')
    if turn_count < expected_turns:
        print(f"FAIL: Expected at least {expected_turns} turns, found {turn_count}")
        return False
    
    print(f"PASS: Recent turns section present with {turn_count} turns")
    return True


def verify_pending_actions(summary: str) -> bool:
    """
    Verify pending actions are extracted.
    Check for action keywords in a flexible way.
    """
    # Expected actions from the history (case-insensitive matching)
    expected_action_indicators = [
        'reconcile',  # from TODO: reconcile the June numbers
        'partner feedback',  # from follow-up: include the partner feedback
        'export format',  # from pending decision about export format
    ]
    
    found_actions = 0
    summary_lower = summary.lower()
    
    for indicator in expected_action_indicators:
        if indicator.lower() in summary_lower:
            found_actions += 1
    
    if found_actions < 2:
        print(f"FAIL: Expected at least 2 pending action indicators, found {found_actions}")
        return False
    
    print(f"PASS: Found {found_actions} pending action indicators")
    return True


def verify_markers(summary: str, expected_marker: str = 'MARKER_ALPHA_7812') -> bool:
    """Verify that marker strings are preserved."""
    if expected_marker not in summary:
        print(f"FAIL: Expected marker '{expected_marker}' not found in summary")
        return False
    
    print(f"PASS: Marker '{expected_marker}' preserved in summary")
    return True


def verify_structure(summary: str) -> bool:
    """Verify the summary has proper structure."""
    required_sections = ['RECENT TURNS', 'PENDING ACTIONS', 'MARKERS']
    summary_upper = summary.upper()
    
    missing = []
    for section in required_sections:
        if section not in summary_upper:
            missing.append(section)
    
    if missing:
        print(f"FAIL: Missing sections: {missing}")
        return False
    
    print("PASS: All required sections present")
    return True


def run_evaluation(input_path: Path, output_path: Path) -> bool:
    """Run full evaluation suite."""
    print("=" * 50)
    print("CONTEXT GATEKEEPER EVALUATION")
    print("=" * 50)
    
    # Run the gatekeeper
    print("\n[1/5] Running context gatekeeper...")
    if not run_gatekeeper(input_path, output_path):
        print("FAIL: Gatekeeper execution failed")
        return False
    print("PASS: Gatekeeper executed successfully")
    
    # Verify file exists
    print("\n[2/5] Verifying summary file...")
    if not verify_summary_exists(output_path):
        return False
    
    # Read summary content
    summary = output_path.read_text(encoding='utf-8')
    
    # Verify structure
    print("\n[3/5] Verifying summary structure...")
    if not verify_structure(summary):
        return False
    
    # Verify recent turns
    print("\n[4/5] Verifying recent turns...")
    if not verify_recent_turns(summary):
        return False
    
    # Verify pending actions
    print("\n[5/5] Verifying pending actions and markers...")
    if not verify_pending_actions(summary):
        return False
    
    if not verify_markers(summary):
        return False
    
    print("\n" + "=" * 50)
    print("ALL TESTS PASSED")
    print("=" * 50)
    return True


def main():
    input_path = Path('context/history.txt')
    output_path = Path('context/summary.txt')
    
    if not input_path.exists():
        print(f"Error: Input file not found: {input_path}", file=sys.stderr)
        sys.exit(1)
    
    success = run_evaluation(input_path, output_path)
    sys.exit(0 if success else 1)


if __name__ == '__main__':
    main()
