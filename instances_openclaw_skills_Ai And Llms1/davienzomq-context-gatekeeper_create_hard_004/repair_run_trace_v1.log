#!/usr/bin/env python3
"""
Context Gatekeeper - Lightweight utility for processing conversation logs.
Extracts recent turns, identifies pending actions, and preserves markers.
"""

import re
import sys
from pathlib import Path
from typing import List, Dict, Any


def parse_history(history_text: str) -> List[Dict[str, str]]:
    """Parse conversation history into turns."""
    turns = []
    lines = history_text.strip().split('\n')
    
    current_speaker = None
    current_content = []
    
    for line in lines:
        if line.startswith('USER:'):
            if current_speaker and current_content:
                turns.append({
                    'speaker': current_speaker,
                    'content': ' '.join(current_content)
                })
            current_speaker = 'USER'
            current_content = [line[5:].strip()]
        elif line.startswith('ASSISTANT:'):
            if current_speaker and current_content:
                turns.append({
                    'speaker': current_speaker,
                    'content': ' '.join(current_content)
                })
            current_speaker = 'ASSISTANT'
            current_content = [line[10:].strip()]
        else:
            # Continuation of previous turn
            if current_content:
                current_content.append(line.strip())
    
    # Don't forget the last turn
    if current_speaker and current_content:
        turns.append({
            'speaker': current_speaker,
            'content': ' '.join(current_content)
        })
    
    return turns


def extract_pending_actions(turns: List[Dict[str, str]]) -> List[str]:
    """
    Extract pending actions from turns.
    Handles multiple action keywords with mixed casing.
    """
    action_keywords = [
        r'\bTODO:\s*(.+?)(?:\s*$|\s*(?:USER|ASSISTANT))',
        r'\bTODO\s+(.+?)(?:\s*$)',
        r'\bfollow-up:\s*(.+?)(?:\s*$|\s*(?:USER|ASSISTANT))',
        r'\bfollow-up\s+(.+?)(?:\s*$)',
        r'\bpending\s+decision[:\s]+(.+?)(?:\s*$)',
        r'\bTODO\s*\((.+?)\)',
    ]
    
    actions = []
    for turn in turns:
        content = turn['content']
        for pattern in action_keywords:
            matches = re.findall(pattern, content, re.IGNORECASE)
            for match in matches:
                action = match.strip()
                if action and action not in actions:
                    actions.append(action)
    
    return actions


def extract_markers(turns: List[Dict[str, str]]) -> List[str]:
    """Extract marker strings (MARKER_*) from turns."""
    markers = []
    marker_pattern = r'\bMARKER_[A-Z0-9_]+\b'
    
    for turn in turns:
        matches = re.findall(marker_pattern, turn['content'])
        for match in matches:
            if match not in markers:
                markers.append(match)
    
    return markers


def get_recent_turns(turns: List[Dict[str, str]], n: int = 4) -> List[Dict[str, str]]:
    """Get the most recent n turns."""
    return turns[-n:] if len(turns) >= n else turns


def generate_summary(turns: List[Dict[str, str]], 
                     pending_actions: List[str],
                     markers: List[str],
                     recent_n: int = 4) -> str:
    """Generate a compact summary of the conversation."""
    recent = get_recent_turns(turns, recent_n)
    
    lines = []
    lines.append("=== CONTEXT GATEKEEPER SUMMARY ===")
    lines.append("")
    
    # Recent turns section
    lines.append("## RECENT TURNS (last {})".format(recent_n))
    for i, turn in enumerate(recent, 1):
        lines.append("  Turn {}: {} - {}".format(i, turn['speaker'], turn['content']))
    lines.append("")
    
    # Pending actions section
    lines.append("## PENDING ACTIONS")
    if pending_actions:
        for action in pending_actions:
            lines.append("  - [TODO] {}".format(action))
    else:
        lines.append("  - None identified")
    lines.append("")
    
    # Markers section
    lines.append("## PRESERVED MARKERS")
    if markers:
        for marker in markers:
            lines.append("  - {}".format(marker))
    else:
        lines.append("  - None found")
    lines.append("")
    
    lines.append("=== END SUMMARY ===")
    
    return '\n'.join(lines)


def process_history(input_path: Path, output_path: Path, recent_n: int = 4):
    """Process a history file and generate a summary."""
    history_text = input_path.read_text(encoding='utf-8')
    
    turns = parse_history(history_text)
    pending_actions = extract_pending_actions(turns)
    markers = extract_markers(turns)
    
    summary = generate_summary(turns, pending_actions, markers, recent_n)
    
    output_path.write_text(summary, encoding='utf-8')
    return summary


def main():
    # Default paths
    input_dir = Path('context')
    output_dir = Path('context')
    input_file = input_dir / 'history.txt'
    output_file = output_dir / 'summary.txt'
    
    # Allow command line overrides
    if len(sys.argv) >= 3:
        input_file = Path(sys.argv[1])
        output_file = Path(sys.argv[2])
    
    if not input_file.exists():
        print(f"Error: Input file not found: {input_file}", file=sys.stderr)
        sys.exit(1)
    
    summary = process_history(input_file, output_file)
    print(f"Summary written to: {output_file}")
    print(summary)


if __name__ == '__main__':
    main()
