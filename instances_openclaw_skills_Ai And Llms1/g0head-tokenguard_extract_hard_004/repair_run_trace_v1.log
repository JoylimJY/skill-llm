[EXECUTING python]:
import json
from datetime import datetime

# Load session data
with open('/workspace/tokenguard/session.json', 'r') as f:
    session = json.load(f)

# Load limit data
with open('/workspace/tokenguard/limit.json', 'r') as f:
    limits = json.load(f)

# Calculate metrics
limit_usd = session['limit_usd']
spent_usd = session['spent_usd']
remaining_usd = limit_usd - spent_usd
usage_pct = (spent_usd / limit_usd) * 100
warning_threshold_pct = session['warning_threshold_pct']
warning_threshold_usd = limit_usd * warning_threshold_pct

# Identify entries close to warning threshold
# An entry is "close" if adding it would push us over or near the warning threshold
close_to_warning = []
cumulative = 0
for entry in session['entries']:
    cumulative += entry['amount']
    if cumulative >= warning_threshold_usd * 0.9:  # Within 10% of threshold
        close_to_warning.append(entry)

# Build audit report
audit_report = {
    "audit_timestamp": datetime.utcnow().isoformat() + "Z",
    "session_info": {
        "session_date": session['session_date'],
        "currency": limits['currency']
    },
    "spend_summary": {
        "limit_usd": limit_usd,
        "spent_usd": spent_usd,
        "remaining_usd": remaining_usd,
        "usage_percentage": round(usage_pct, 2),
        "warning_threshold_percentage": round(warning_threshold_pct * 100, 2),
        "warning_threshold_usd": warning_threshold_usd
    },
    "status": "OK" if usage_pct < warning_threshold_pct * 100 else "WARNING",
    "entries": session['entries'],
    "entries_close_to_warning": close_to_warning,
    "analysis": {
        "total_entries": len(session['entries']),
        "entries_near_warning_threshold": len(close_to_warning),
        "is_at_warning": usage_pct >= warning_threshold_pct * 100
    }
}

# Write to file
with open('/workspace/tokenguard_audit.json', 'w') as f:
    json.dump(audit_report, f, indent=2)

print("Audit complete!")
print(f"\n=== TokenGuard Audit Summary ===")
print(f"Session Date: {session['session_date']}")
print(f"Currency: {limits['currency']}")
print(f"Limit: ${limit_usd:.2f}")
print(f"Spent: ${spent_usd:.2f}")
print(f"Remaining: ${remaining_usd:.2f}")
print(f"Usage: {usage_pct:.2f}%")
print(f"Warning Threshold: {warning_threshold_pct * 100:.0f}% (${warning_threshold_usd:.2f})")
print(f"Status: {audit_report['status']}")
print(f"\nEntries close to warning threshold: {len(close_to_warning)}")
print(f"\nAudit saved to: /workspace/tokenguard_audit.json")

