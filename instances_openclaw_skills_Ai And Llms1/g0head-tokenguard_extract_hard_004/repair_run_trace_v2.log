[EXECUTING python]:
import json
from datetime import datetime

# Load session data
with open('/workspace/tokenguard/session.json', 'r') as f:
    session = json.load(f)

with open('/workspace/tokenguard/limit.json', 'r') as f:
    limit_data = json.load(f)

# Calculate metrics
limit_usd = session['limit_usd']
spent_usd = session['spent_usd']
remaining_usd = limit_usd - spent_usd
spend_pct = (spent_usd / limit_usd) * 100
warning_threshold = limit_usd * session['warning_threshold_pct']
distance_to_warning = warning_threshold - spent_usd

# Identify entries close to warning threshold
# An entry is "close" if adding it would push spend within 20% of the remaining distance to warning
# Or if the entry itself is significant (>30% of remaining distance to warning)
close_to_warning_entries = []
for entry in session['entries']:
    # Check if this entry represents a significant portion of remaining budget to warning
    entry_ratio_to_warning = entry['amount'] / distance_to_warning if distance_to_warning > 0 else 0
    if entry_ratio_to_warning >= 0.3:  # Entry is >= 30% of distance to warning threshold
        close_to_warning_entries.append({
            **entry,
            'risk_level': 'HIGH' if entry_ratio_to_warning >= 0.8 else 'MEDIUM',
            'ratio_to_warning_distance': round(entry_ratio_to_warning, 3)
        })

# Build audit report
audit_report = {
    "audit_timestamp": datetime.utcnow().isoformat() + "Z",
    "session_date": session['session_date'],
    "summary": {
        "currency": limit_data['currency'],
        "limit_usd": limit_usd,
        "spent_usd": spent_usd,
        "remaining_usd": round(remaining_usd, 2),
        "spend_percentage": round(spend_pct, 2),
        "warning_threshold_usd": warning_threshold,
        "distance_to_warning_usd": round(distance_to_warning, 2),
        "status": "WARNING" if spent_usd >= warning_threshold else "OK"
    },
    "entries": session['entries'],
    "entries_close_to_warning": close_to_warning_entries,
    "analysis": {
        "total_entries": len(session['entries']),
        "entries_at_risk": len(close_to_warning_entries),
        "recommendation": "Consider reducing spend if approaching warning threshold" if spend_pct > 60 else "Spend is within safe limits"
    }
}

# Export to JSON
with open('/workspace/tokenguard_audit.json', 'w') as f:
    json.dump(audit_report, f, indent=2)

print("Audit report generated successfully!")
print(json.dumps(audit_report['summary'], indent=2))

