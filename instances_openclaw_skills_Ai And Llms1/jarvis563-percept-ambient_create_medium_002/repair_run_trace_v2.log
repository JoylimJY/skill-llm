[EXECUTING python]:
import json
import os

# Read input files
with open('/workspace/input/conversations.json') as f:
    conversations = json.load(f)

with open('/workspace/input/entities.json') as f:
    entities = json.load(f)

with open('/workspace/input/relationships.json') as f:
    relationships = json.load(f)

with open('/workspace/input/markers.txt') as f:
    markers_content = f.read()

# Parse markers
marker_entity = None
marker_conversation = None
for line in markers_content.strip().split('\n'):
    if line.startswith('MARKER_ENTITY='):
        marker_entity = line.split('=', 1)[1]
    elif line.startswith('MARKER_CONVERSATION='):
        marker_conversation = line.split('=', 1)[1]

# Build entity resolution map - resolve duplicates
entity_map = {}
resolved_entities = []
for entity in entities:
    name = entity['name']
    if 'marker' in entity and entity['marker'].startswith('DUPLICATE_OF:'):
        canonical = entity['marker'].split(':', 1)[1]
        entity_map[name] = canonical
    else:
        entity_map[name] = name
        resolved_entities.append(entity)

# Filter conversations: only those mentioning project, decision, or person with clear relationship
# c4 is about lunch - not relevant
relevant_conversations = []
for conv in conversations:
    text_lower = conv['text'].lower()
    # Check if mentions a project, decision, or person with relationship
    if any(p['type'] == 'project' for p in resolved_entities) and any(proj['name'].lower().replace(' ', '') in text_lower for proj in resolved_entities if proj['type'] == 'project'):
        relevant_conversations.append(conv)
    elif any(person['name'].lower() in text_lower for person in resolved_entities if person['type'] == 'person') and ('agreed' in text_lower or 'decision' in text_lower or 'handle' in text_lower or 'review' in text_lower or 'track' in text_lower):
        relevant_conversations.append(conv)
    elif 'atlas' in text_lower or 'project' in text_lower or 'privacy' in text_lower:
        relevant_conversations.append(conv)

# Rank conversations by relevance to Project Atlas
def relevance_score(conv):
    score = 0
    text = conv['text'].lower()
    if 'atlas' in text:
        score += 2
    if 'agreed' in text or 'decision' in text:
        score += 2
    if conv['id'] == marker_conversation:
        score += 1
    return score

relevant_conversations.sort(key=relevance_score, reverse=True)

# Build context packet
context_packet = {
    "marker_entity": marker_entity,
    "resolved_entities": resolved_entities,
    "entity_resolution": {k: v for k, v in entity_map.items() if k != v},
    "relationships": relationships,
    "relevant_conversations": relevant_conversations,
    "ranked_history_for_project_atlas": [
        {"conversation_id": c['id'], "relevance": "high", "summary": c['text'][:80]}
        for c in relevant_conversations
    ]
}

# Write context_packet.json
os.makedirs('/workspace/output', exist_ok=True)
with open('/workspace/output/context_packet.json', 'w') as f:
    json.dump(context_packet, f, indent=2)

# Write summary.txt
summary = """Project Atlas Status Summary
=============================

What is happening:
Project Atlas is on track with development of a dashboard prototype. 
Key decisions have been made regarding technology stack and privacy requirements.

Who is involved:
- Avery Chen: Works on Project Atlas (lead)
- Sam Lee: Works on Project Atlas (dashboard prototype)
- Dana Park: Reviews Project Atlas (privacy review due Friday)

Latest Decision:
Avery Chen and Sam Lee agreed to keep retrieval search local using SQLite plus LanceDB.

Privacy Note:
The Atlas privacy notes specify that no audio is stored, only transcripts.

Technology Stack:
- SQLite + LanceDB for local retrieval search
"""

with open('/workspace/output/summary.txt', 'w') as f:
    f.write(summary)

print("Output files created successfully!")
print("\n--- context_packet.json ---")
print(json.dumps(context_packet, indent=2))
print("\n--- summary.txt ---")
print(summary)

