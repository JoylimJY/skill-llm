import json
import os
import re

# Read input files
with open('/workspace/input/conversations.json', 'r') as f:
    conversations = json.load(f)

with open('/workspace/input/entities.json', 'r') as f:
    entities = json.load(f)

with open('/workspace/input/relationships.json', 'r') as f:
    relationships = json.load(f)

with open('/workspace/input/markers.txt', 'r') as f:
    markers_content = f.read()

# Parse markers
marker_entity = None
marker_conversation = None
for line in markers_content.strip().split('\n'):
    if line.startswith('MARKER_ENTITY='):
        marker_entity = line.split('=', 1)[1]
    elif line.startswith('MARKER_CONVERSATION='):
        marker_conversation = line.split('=', 1)[1]

# Build entity resolution map (merge duplicates)
# Sort by length descending to replace longer matches first (avoid partial replacements)
entity_replacements = []
for entity in entities:
    name = entity['name']
    if 'marker' in entity and entity['marker'].startswith('DUPLICATE_OF:'):
        canonical = entity['marker'].split(':', 1)[1]
        entity_replacements.append((name, canonical))

# Sort by length descending to handle "Atlas" after "Project Atlas" would be handled correctly
entity_replacements.sort(key=lambda x: len(x[0]), reverse=True)

# Resolve entity names in text
def resolve_entities(text):
    for dup, canonical in entity_replacements:
        # Use word boundary matching to avoid partial replacements
        # Replace "Atlas" only when not already part of "Project Atlas"
        if dup == "Atlas":
            # Only replace standalone "Atlas" or "Atlas" not preceded by "Project "
            pattern = r'(?<!Project )\b' + re.escape(dup) + r'\b'
            text = re.sub(pattern, canonical, text)
        else:
            text = text.replace(dup, canonical)
    return text

# Filter conversations - only include those mentioning project, decision, or person with relationship
def is_relevant_conv(conv):
    text = conv['text'].lower()
    # Check if mentions project, decision, or person with relationship
    relevant_patterns = ['project atlas', 'atlas', 'decision', 'agreed', 'handle', 'review', 
                        'dashboard', 'privacy', 'sqlite', 'lancedb']
    for pattern in relevant_patterns:
        if pattern in text:
            return True
    return False

# Filter and process conversations
filtered_conversations = []
for conv in conversations:
    if is_relevant_conv(conv):
        resolved_conv = {
            'id': conv['id'],
            'speaker': conv['speaker'],
            'text': resolve_entities(conv['text']),
            'timestamp': conv['timestamp']
        }
        filtered_conversations.append(resolved_conv)

# Rank conversations by relevance to Project Atlas
def rank_relevance(conv):
    text = conv['text'].lower()
    score = 0
    if 'project atlas' in text or ' atlas' in text:
        score += 2
    if conv['id'] == marker_conversation:
        score += 1
    return score

filtered_conversations.sort(key=rank_relevance, reverse=True)

# Build resolved entities list (canonical only)
resolved_entities = []
for entity in entities:
    name = entity['name']
    if 'marker' in entity and entity['marker'].startswith('DUPLICATE_OF:'):
        continue  # Skip duplicates
    resolved_entities.append({
        'name': name,
        'type': entity['type'],
        'marker': entity.get('marker')
    })

# Sort entities: marker entity first, then by type
resolved_entities.sort(key=lambda e: (0 if e['name'] == marker_entity else 1, e['type']))

# Build context packet
context_packet = {
    'marker_entity': marker_entity,
    'marker_conversation': marker_conversation,
    'resolved_entities': resolved_entities,
    'relationships': relationships,
    'conversations': filtered_conversations,
    'generated_at': '2025-04-18T12:00:00Z'
}

# Write context packet
os.makedirs('/workspace/output', exist_ok=True)
with open('/workspace/output/context_packet.json', 'w') as f:
    json.dump(context_packet, f, indent=2)

# Create summary
summary = """Ambient Intelligence Knowledge Pack Summary
============================================

Project: Project Atlas

Participants:
- Avery Chen (works on Project Atlas)
- Sam Lee (works on Project Atlas)
- Dana Park (reviews Project Atlas)

Latest Decision:
Avery Chen and Sam Lee agreed to keep the retrieval search local, using SQLite plus LanceDB.

Key Points:
1. Project Atlas is on track with Sam Lee handling the dashboard prototype.
2. Dana Park mentioned the privacy review is due Friday.
3. Privacy notes specify that no audio is stored, only transcripts.
4. Technology stack: SQLite + LanceDB for local retrieval search.

Relevant Conversations: 3 (filtered from 4 total)
Excluded: c4 (unrelated lunch discussion)
"""

