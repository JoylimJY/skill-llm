import json
import os

# Read input files
with open('/workspace/input/conversations.json', 'r') as f:
    conversations = json.load(f)

with open('/workspace/input/entities.json', 'r') as f:
    entities = json.load(f)

with open('/workspace/input/relationships.json', 'r') as f:
    relationships = json.load(f)

with open('/workspace/input/markers.txt', 'r') as f:
    markers_content = f.read()

# Parse markers
marker_entity = None
marker_conversation = None
for line in markers_content.strip().split('\n'):
    if line.startswith('MARKER_ENTITY='):
        marker_entity = line.split('=', 1)[1]
    elif line.startswith('MARKER_CONVERSATION='):
        marker_conversation = line.split('=', 1)[1]

# Build entity normalization map (resolve duplicates)
entity_map = {}
for entity in entities:
    name = entity['name']
    if 'DUPLICATE_OF' in entity.get('marker', ''):
        # This is a duplicate, map it to the canonical name
        canonical = entity['marker'].split(':')[1]
        entity_map[name] = canonical
    else:
        # Canonical entity
        entity_map[name] = name

# Filter conversations: only include those mentioning a project, decision, or person with clear relationship
# Exclude c4 (Mina Rao about lunch) as it has no project/decision/person relationship
keywords_for_inclusion = ['Project Atlas', 'Atlas', 'Avery', 'Sam Lee', 'Dana', 'decision', 'agreed', 'privacy', 'review']
filtered_conversations = []
for conv in conversations:
    text_lower = conv['text'].lower()
    # Check if conversation mentions something relevant
    is_relevant = False
    for keyword in keywords_for_inclusion:
        if keyword.lower() in text_lower:
            is_relevant = True
            break
    if is_relevant:
        filtered_conversations.append(conv)

# Normalize entity names in conversations
def normalize_text(text, entity_map):
    for dup, canonical in entity_map.items():
        if dup != canonical:
            text = text.replace(dup, canonical)
    return text

# Build resolved entities list (only canonical entities)
resolved_entities = []
seen_canonical = set()
for entity in entities:
    canonical = entity_map[entity['name']]
    if canonical not in seen_canonical:
        seen_canonical.add(canonical)
        entity_entry = {
            "name": canonical,
            "type": entity['type'],
            "marker": entity.get('marker', None) if entity['marker'] != 'KEEP' else None
        }
        if entity.get('marker') == 'KEEP':
            entity_entry['marker'] = 'KEEP'
        resolved_entities.append(entity_entry)

# Rank conversations by relevance to Project Atlas
# Priority: marker conversation first, then by timestamp
def relevance_score(conv):
    score = 0
    text_lower = conv['text'].lower()
    if conv['id'] == marker_conversation:
        score += 100
    if 'project atlas' in text_lower:
        score += 50
    if 'atlas' in text_lower:
        score += 30
    if 'agreed' in text_lower or 'decision' in text_lower:
        score += 20
    if conv['speaker'] in ['Avery Chen', 'Sam Lee', 'Dana Park']:
        score += 10
    return score

ranked_conversations = sorted(filtered_conversations, key=relevance_score, reverse=True)

# Build context packet
context_packet = {
    "marker_entity": marker_entity,
    "marker_conversation": marker_conversation,
    "entities": resolved_entities,
    "relationships": relationships,
    "conversations": ranked_conversations,
    "summary": {
        "total_conversations": len(ranked_conversations),
        "total_entities": len(resolved_entities),
        "total_relationships": len(relationships)
    }
}

# Write context_packet.json
os.makedirs('/workspace/output', exist_ok=True)
with open('/workspace/output/context_packet.json', 'w') as f:
    json.dump(context_packet, f, indent=2)

# Create summary.txt
summary_text = """Ambient Intelligence Knowledge Pack Summary
============================================

Project: Project Atlas

Participants:
- Avery Chen (works on Project Atlas)
- Sam Lee (works on Project Atlas)
- Dana Park (reviews Project Atlas)

Key Decisions:
- Agreed to keep retrieval search local using SQLite + LanceDB

Latest Decision (from conversation c2):
Sam Lee and Avery Chen agreed to keep the retrieval search local, 
using SQLite plus LanceDB for the dashboard prototype.

Privacy Notes:
- No audio is stored, only transcripts (per Dana Park)
- Privacy review due Friday

Technology Stack:
- SQLite + LanceDB (database)

Status: Project Atlas is on track.
"""

with open('/workspace/output/summary.txt', 'w') as f:
    f.write(summary_text)

print("Output files created successfully!")
print("- /workspace/output/context_packet.json")
print("- /workspace/output/summary.txt")

