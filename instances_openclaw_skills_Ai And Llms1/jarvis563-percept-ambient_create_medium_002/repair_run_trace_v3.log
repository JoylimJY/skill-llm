import json
import os
import re

# Read input files
with open('/workspace/input/conversations.json', 'r') as f:
    conversations = json.load(f)

with open('/workspace/input/entities.json', 'r') as f:
    entities = json.load(f)

with open('/workspace/input/relationships.json', 'r') as f:
    relationships = json.load(f)

# Parse markers
markers = {}
with open('/workspace/input/markers.txt', 'r') as f:
    for line in f:
        if '=' in line:
            key, value = line.strip().split('=', 1)
            markers[key] = value

marker_entity = markers.get('MARKER_ENTITY', '')
marker_conversation = markers.get('MARKER_CONVERSATION', '')

# Build entity resolution map - only for duplicates
duplicate_map = {}
for entity in entities:
    name = entity['name']
    if 'marker' in entity and entity['marker'].startswith('DUPLICATE_OF:'):
        canonical = entity['marker'].split(':', 1)[1]
        duplicate_map[name] = canonical

# Filter conversations - only include those mentioning project, decision, or person with clear relationship
def is_relevant_conversation(conv):
    text_lower = conv['text'].lower()
    if 'atlas' in text_lower:
        return True
    decision_keywords = ['agreed', 'decided', 'decision', 'will handle', 'due']
    for kw in decision_keywords:
        if kw in text_lower:
            return True
    person_names = ['avery', 'sam', 'dana']
    for name in person_names:
        if name in text_lower:
            return True
    return False

filtered_conversations = [c for c in conversations if is_relevant_conversation(c)]

# Normalize entity names - avoid replacing when already part of canonical name
def normalize_entities(text, duplicate_map):
    result = text
    # Sort by length descending to replace longer patterns first
    for original, canonical in sorted(duplicate_map.items(), key=lambda x: -len(x[0])):
        # Check if original is a substring of canonical to avoid double replacement
        if original in canonical:
            # Use negative lookbehind to avoid replacing when preceded by the prefix
            prefix = canonical.replace(original, '').rstrip()
            if prefix:
                # Only replace "Atlas" if NOT preceded by "Project "
                pattern = r'(?<!Project )\b' + re.escape(original) + r'\b'
                result = re.sub(pattern, canonical, result, flags=re.IGNORECASE)
            else:
                result = re.sub(r'\b' + re.escape(original) + r'\b', canonical, result)
        else:
            result = re.sub(r'\b' + re.escape(original) + r'\b', canonical, result)
    return result

normalized_conversations = []
for conv in filtered_conversations:
    normalized_conversations.append({
        'id': conv['id'],
        'speaker': conv['speaker'],
        'text': normalize_entities(conv['text'], duplicate_map),
        'timestamp': conv['timestamp']
    })

# Rank history items for Project Atlas
def rank_for_project_atlas(conv):
    text_lower = conv['text'].lower()
    if 'project atlas' in text_lower:
        return 0
    elif 'atlas' in text_lower:
        return 1
    elif conv['id'] == marker_conversation:
        return 2
    return 3

ranked_conversations = sorted(normalized_conversations, key=rank_for_project_atlas)

# Build unique entities list (normalized)
unique_entities = []
seen = set()
for entity in entities:
    name = entity['name']
    canonical_name = duplicate_map.get(name, name)
    if canonical_name not in seen:
        seen.add(canonical_name)
        unique_entities.append({
            'name': canonical_name,
            'type': entity['type'],
            'marker': entity.get('marker', '')
        })

# Normalize relationships
normalized_relationships = []
for rel in relationships:
    source = duplicate_map.get(rel['source'], rel['source'])
    target = duplicate_map.get(rel['target'], rel['target'])
    normalized_relationships.append({
        'source': source,
        'relation': rel['relation'],
        'target': target
    })

# Build context packet
context_packet = {
    'marker_entity': marker_entity,
    'marker_conversation': marker_conversation,
    'entities': unique_entities,
    'relationships': normalized_relationships,
    'conversations': ranked_conversations,
    'metadata': {
        'total_conversations': len(ranked_conversations),
        'total_entities': len(unique_entities),
        'total_relationships': len(normalized_relationships)
    }
}

# Write context_packet.json
os.makedirs('/workspace/output', exist_ok=True)
with open('/workspace/output/context_packet.json', 'w') as f:
    json.dump(context_packet, f, indent=2)

# Create summary
summary = """Project Atlas Status Summary
=============================

Project: Project Atlas (Marker Entity)

Team Members:
- Avery Chen (works on Project Atlas)
- Sam Lee (works on Project Atlas)
- Dana Park (reviews Project Atlas)

Technology Stack:
- SQLite + LanceDB for local retrieval search

Latest Decisions:
- Agreed to keep retrieval search local using SQLite and LanceDB
- Privacy notes specify no audio storage, only transcripts
- Privacy review due Friday

Current Status:
Project Atlas is on track. Sam Lee is handling the dashboard prototype.
Avery Chen and Sam Lee have aligned on the technical approach for data storage.
"""

with open('/workspace/output/summary.txt', 'w') as f:
    f.write(summary)

print("Output files created successfully!")

