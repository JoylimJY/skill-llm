with open('/workspace/mnemon_impl.py', 'w') as f:
    f.write('''#!/usr/bin/env python3
import json
import uuid
from datetime import datetime
from typing import Dict, List, Optional

class Memory:
    def __init__(self, fact_id: str, content: str, category: str, entities: List[str]):
        self.id = fact_id
        self.content = content
        self.category = category
        self.entities = entities
        self.created_at = datetime.now().isoformat()
    
    def to_dict(self) -> dict:
        return {"id": self.id, "content": self.content, "category": self.category, 
                "entities": self.entities, "created_at": self.created_at}

class Link:
    def __init__(self, link_id: str, from_id: str, to_id: str, relationship_type: str, description: str):
        self.id = link_id
        self.from_id = from_id
        self.to_id = to_id
        self.relationship_type = relationship_type
        self.description = description
    
    def to_dict(self) -> dict:
        return {"id": self.id, "from_id": self.from_id, "to_id": self.to_id,
                "relationship_type": self.relationship_type, "description": self.description}

class MnemonStore:
    def __init__(self):
        self.memories: Dict[str, Memory] = {}
        self.links: Dict[str, Link] = {}
        self.marker_note: Optional[str] = None
        self.marker_task: Optional[str] = None
    
    def add_memory(self, content: str, category: str, entities: List[str]) -> str:
        mem_id = f"mem_{uuid.uuid4().hex[:8]}"
        memory = Memory(mem_id, content, category, entities)
        self.memories[mem_id] = memory
        return mem_id
    
    def add_link(self, from_id: str, to_id: str, relationship_type: str, description: str) -> str:
        if from_id not in self.memories or to_id not in self.memories:
            raise ValueError("Memory ID not found")
        link_id = f"link_{uuid.uuid4().hex[:8]}"
        link = Link(link_id, from_id, to_id, relationship_type, description)
        self.links[link_id] = link
        return link_id
    
    def get_all_memories(self): return list(self.memories.values())
    def get_all_links(self): return list(self.links.values())
    
    def verify_store(self) -> dict:
        return {"total_facts": len(self.memories), "total_links": len(self.links),
                "fact_ids": list(self.memories.keys()), "link_ids": list(self.links.keys()),
                "marker_note": self.marker_note, "marker_task": self.marker_task}
    
    def export(self) -> dict:
        return {"memories": [m.to_dict() for m in self.get_all_memories()],
                "links": [l.to_dict() for l in self.get_all_links()],
                "metadata": {"marker_note": self.marker_note, "marker_task": self.marker_task,
                            "exported_at": datetime.now().isoformat()}}

def parse_meeting_notes(notes_path: str) -> dict:
    with open(notes_path, "r") as f:
        content = f.read()
    lines = content.strip().split("\\n")
    marker_note, marker_task, facts = None, None, []
    for line in lines:
        if "Marker:" in line:
            if "AURORA" in line:
                marker_note = line.split("Marker:")[1].strip()
            elif "TASK" in line:
                marker_task = line.split("Marker:")[1].strip()
        elif line.strip().startswith("-"):
            facts.append(line.strip()[1:].strip())
    return {"marker_note": marker_note, "marker_task": marker_task, "facts": facts}

def categorize_facts(facts: List[str]) -> List[dict]:
    categorized = []
    for fact in facts:
        if "launch review" in fact.lower() or "moved" in fact.lower():
            category, entities = "schedule", ["launch review", "demo environment", "QA"]
        elif "Nina" in fact:
            category, entities = "preferences", ["Nina", "status updates"]
        elif "API endpoint" in fact or "stable" in fact.lower():
            category, entities = "technical_decisions", ["API endpoint", "team"]
        elif "rollback" in fact.lower() or "playbook" in fact.lower():
            category, entities = "infrastructure", ["rollback playbook", "payments service"]
        elif "demo failure" in fact.lower() or "environment variable" in fact.lower():
            category, entities = "incidents", ["demo failure", "staging", "environment variable"]
        else:
            category, entities = "general", []
        categorized.append({"content": fact, "category": category, "entities": entities})
    return categorized

def create_meaningful_links(store, categorized_facts):
    link_ids = []
    mem_ids = []
    for fact in categorized_facts:
        mem_id = store.add_memory(fact["content"], fact["category"], fact["entities"])
        mem_ids.append((mem_id, fact))
    
    demo_failure_id = launch_review_id = None
    for mem_id, fact in mem_ids:
        if "demo failure" in fact["content"].lower(): demo_failure_id = mem_id
        if "launch review" in fact["content"].lower(): launch_review_id = mem_id
    if demo_failure_id and launch_review_id:
        link_ids.append(store.add_link(demo_failure_id, launch_review_id, "causal",
            "The demo failure revealed staging issues requiring extra QA time, causing launch review reschedule"))
    
    api_endpoint_id = rollback_id = None
    for mem_id, fact in mem_ids:
        if "API endpoint" in fact["content"]: api_endpoint_id = mem_id
        if "rollback" in fact["content"].lower(): rollback_id = mem_id
    if api_endpoint_id and rollback_id:
        link_ids.append(store.add_link(api_endpoint_id, rollback_id, "semantic",
            "Both decisions relate to system stability and risk management strategies"))
    return link_ids

def main():
    store = MnemonStore()
    parsed = parse_meeting_notes("/workspace/meeting_notes.txt")
    store.marker_note = parsed["marker_note"]
    store.marker_task = parsed["marker_task"]
    categorized = categorize_facts(parsed["facts"])
    create_meaningful_links(store, categorized)
    verification = store.verify_store()
    
    print("=" * 60)
    print("MNEMON MEMORY STORE VERIFICATION RESULTS")
    print("=" * 60)
    print(f"Marker Note: {store.marker_note}")
    print(f"Marker Task: {store.marker_task}")
    print(f"Total Facts Stored: {verification[\\'total_facts\\']}")
    print(f"Total Links Created: {verification[\\'total_links\\']}")
    print("-" * 60)
    print("STORED FACTS:")
    for mem in store.get_all_memories():
        print(f"  [{mem.id}] ({mem.category}): {mem.content}")
    print("-" * 60)
    print("LINKS CREATED:")
    for link in store.get_all_links():
        print(f"  [{link.id}] {link.relationship_type}: {link.from_id} -> {link.to_id}")
        print(f"    Description: {link.description}")
    print("=" * 60)
    
    export_data = store.export()
    with open("/workspace/memory_store.json", "w") as f:
        json.dump(export_data, f, indent=2)
    print("Memory store exported to /workspace/memory_store.json")
    
    with open("/workspace/expected_manifest.json", "r") as f:
        expected = json.load(f)
    print("-" * 60)
    print("VERIFICATION AGAINST EXPECTED MANIFEST:")
    print(f"  Expected facts: {expected[\\'expected_facts\\']}, Got: {verification[\\'total_facts\\']}")
    print(f"  Expected min links: {expected[\\'expected_links_min\\']}, Got: {verification[\\'total_links\\']}")
    if verification["total_facts"] == expected["expected_facts"] and verification["total_links"] >= expected["expected_links_min"]:
        print("  STATUS: PASS - All requirements met!")
    else:
        print("  STATUS: FAIL - Requirements not met")

if __name__ == "__main__":
    main()
''')
print("Script written successfully")

