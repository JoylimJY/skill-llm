[EXECUTING python]:
import json
from pathlib import Path
from datetime import datetime

class MemoryStore:
    def __init__(self):
        self.facts = []
        self.links = []
        self.markers = {}
    
    def add_marker(self, key, value):
        self.markers[key] = value
    
    def add_fact(self, content, category, entities=None):
        fact = {
            "id": len(self.facts) + 1,
            "content": content,
            "category": category,
            "entities": entities or [],
            "created_at": datetime.now().isoformat()
        }
        self.facts.append(fact)
        return fact["id"]
    
    def add_link(self, from_id, to_id, relationship_type, description):
        link = {
            "from_id": from_id,
            "to_id": to_id,
            "relationship_type": relationship_type,
            "description": description,
            "created_at": datetime.now().isoformat()
        }
        self.links.append(link)
        return link
    
    def get_fact(self, fact_id):
        for fact in self.facts:
            if fact["id"] == fact_id:
                return fact
        return None
    
    def verify(self, expected_facts, expected_links_min):
        result = {
            "total_facts": len(self.facts),
            "expected_facts": expected_facts,
            "facts_match": len(self.facts) == expected_facts,
            "total_links": len(self.links),
            "expected_links_min": expected_links_min,
            "links_sufficient": len(self.links) >= expected_links_min,
            "markers": self.markers
        }
        return result
    
    def to_json(self):
        return json.dumps({
            "markers": self.markers,
            "facts": self.facts,
            "links": self.links
        }, indent=2)

# Initialize memory store
memory = MemoryStore()

# Store markers from the notes
memory.add_marker("note_marker", "AURORA-ALPHA-91")
memory.add_marker("task_marker", "TASK-BRIEF-44")

# Extract and store key facts with categorization
# Fact 1: Launch review reschedule
fact1_id = memory.add_fact(
    "The launch review moved from Friday to Monday because the demo environment needed extra QA time.",
    category="schedule_change",
    entities=["launch review", "demo environment", "QA time"]
)

# Fact 2: Nina's preference
fact2_id = memory.add_fact(
    "Nina prefers concise status updates in bullet points.",
    category="team_preference",
    entities=["Nina", "status updates"]
)

# Fact 3: API endpoint stability decision
fact3_id = memory.add_fact(
    "The team decided to keep the new API endpoint stable for one more sprint.",
    category="technical_decision",
    entities=["API endpoint", "sprint"]
)

# Fact 4: Rollback playbook
fact4_id = memory.add_fact(
    "A rollback playbook exists for the payments service.",
    category="infrastructure",
    entities=["rollback playbook", "payments service"]
)

# Fact 5: Demo failure cause
fact5_id = memory.add_fact(
    "The demo failure last week was caused by a missing environment variable in staging.",
    category="incident",
    entities=["demo failure", "environment variable", "staging"]
)

# Create meaningful links (causal or semantic relationships)

# Link 1: Causal relationship - Demo failure (fact5) led to extra QA time need, which caused launch review reschedule (fact1)
memory.add_link(
    from_id=fact5_id,
    to_id=fact1_id,
    relationship_type="causal",
    description="The demo failure caused the need for extra QA time, which resulted in the launch review being moved"
)

# Link 2: Semantic relationship - API stability decision (fact3) relates to rollback playbook (fact4) as both are about system stability/safety measures
memory.add_link(
    from_id=fact3_id,
    to_id=fact4_id,
    relationship_type="semantic",
    description="Both facts relate to system stability and safety - keeping API stable and having rollback procedures"
)

# Verify the memory store
verification = memory.verify(expected_facts=5, expected_links_min=2)

# Output verification results
print("=" * 60)
print("MEMORY STORE VERIFICATION RESULTS")
print("=" * 60)
print(f"\nMarkers stored:")
for key, value in verification["markers"].items():
    print(f"  - {key}: {value}")

print(f"\nFacts Summary:")
print(f"  Total facts stored: {verification['total_facts']}")
print(f"  Expected facts: {verification['expected_facts']}")
print(f"  Facts match expected: {'YES' if verification['facts_match'] else 'NO'}")

print(f"\nFacts stored:")
for fact in memory.facts:
    print(f"  [{fact['id']}] ({fact['category']}): {fact['content'][:60]}...")

print(f"\nLinks Summary:")
print(f"  Total links created: {verification['total_links']}")
print(f"  Expected minimum links: {verification['expected_links_min']}")
print(f"  Links sufficient: {'YES' if verification['links_sufficient'] else 'NO'}")

print(f"\nLinks created:")
for link in memory.links:
    from_fact = memory.get_fact(link["from_id"])
    to_fact = memory.get_fact(link["to_id"])
    print(f"  [{link['from_id']}]->[{link['to_id']}] ({link['relationship_type']}): {link['description']}")

print(f"\n" + "=" * 60)
print("VERIFICATION STATUS:", "PASSED" if verification["facts_match"] and verification["links_sufficient"] else "FAILED")
print("=" * 60)

# Save memory store to file
Path("/workspace/memory_store.json").write_text(memory.to_json(), encoding="utf-8")
print(f"\nMemory store saved to /workspace/memory_store.json")

