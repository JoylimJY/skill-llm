#!/usr/bin/env python3
import json
import uuid
from dataclasses import dataclass, asdict
from typing import List, Dict
from datetime import datetime

@dataclass
class MemoryFact:
    id: str
    content: str
    category: str
    entities: List[str]
    timestamp: str
    def to_dict(self):
        return asdict(self)

@dataclass
class MemoryLink:
    id: str
    from_fact_id: str
    to_fact_id: str
    relationship_type: str
    description: str
    def to_dict(self):
        return asdict(self)

class MnemonMemoryStore:
    def __init__(self):
        self.facts = {}
        self.links = {}
        self.marker_notes = {}
        
    def store_marker(self, marker_type, value):
        self.marker_notes[marker_type] = value
        
    def add_fact(self, content, category, entities):
        fact_id = f"FACT-{uuid.uuid4().hex[:8].upper()}"
        fact = MemoryFact(id=fact_id, content=content, category=category, 
                         entities=entities, timestamp=datetime.now().isoformat())
        self.facts[fact_id] = fact
        return fact_id
    
    def add_link(self, from_fact_id, to_fact_id, relationship_type, description):
        link_id = f"LINK-{uuid.uuid4().hex[:8].upper()}"
        link = MemoryLink(id=link_id, from_fact_id=from_fact_id, to_fact_id=to_fact_id,
                         relationship_type=relationship_type, description=description)
        self.links[link_id] = link
        return link_id
    
    def get_all_facts(self):
        return list(self.facts.values())
    
    def get_all_links(self):
        return list(self.links.values())
    
    def export_manifest(self):
        return {
            "marker_notes": self.marker_notes,
            "facts_count": len(self.facts),
            "facts": [f.to_dict() for f in self.get_all_facts()],
            "links_count": len(self.links),
            "links": [l.to_dict() for l in self.get_all_links()]
        }
    
    def save_to_file(self, filepath):
        with open(filepath, 'w') as f:
            json.dump(self.export_manifest(), f, indent=2)

def curate_meeting_notes():
    store = MnemonMemoryStore()
    store.store_marker("AURORA", "AURORA-ALPHA-91")
    store.store_marker("TASK", "TASK-BRIEF-44")
    
    fact1_id = store.add_fact(
        content="The launch review moved from Friday to Monday because the demo environment needed extra QA time.",
        category="SCHEDULE_CHANGE",
        entities=["launch review", "demo environment", "QA"]
    )
    
    fact2_id = store.add_fact(
        content="Nina prefers concise status updates in bullet points.",
        category="PREFERENCE",
        entities=["Nina", "status updates"]
    )
    
    fact3_id = store.add_fact(
        content="The team decided to keep the new API endpoint stable for one more sprint.",
        category="TECHNICAL_DECISION",
        entities=["API endpoint", "team"]
    )
    
    fact4_id = store.add_fact(
        content="A rollback playbook exists for the payments service.",
        category="INFRASTRUCTURE",
        entities=["rollback playbook", "payments service"]
    )
    
    fact5_id = store.add_fact(
        content="The demo failure last week was caused by a missing environment variable in staging.",
        category="INCIDENT",
        entities=["demo failure", "environment variable", "staging"]
    )
    
    store.add_link(fact5_id, fact1_id, "CAUSAL", 
        "The demo failure (Fact 5) likely caused the need for extra QA time (Fact 1)")
    
    store.add_link(fact1_id, fact5_id, "SEMANTIC", 
        "Both facts relate to demo environment stability issues")
    
    return store

def verify_memory_store(store, expected):
    results = {"verification_passed": True, "checks": []}
    
    if store.marker_notes.get("AURORA") == expected.get("marker_note"):
        results["checks"].append({"check": "AURORA marker", "status": "PASS"})
    else:
        results["checks"].append({"check": "AURORA marker", "status": "FAIL"})
        results["verification_passed"] = False
    
    if store.marker_notes.get("TASK") == expected.get("marker_task"):
        results["checks"].append({"check": "TASK marker", "status": "PASS"})
    else:
        results["checks"].append({"check": "TASK marker", "status": "FAIL"})
        results["verification_passed"] = False
    
    facts_count = len(store.get_all_facts())
    if facts_count == expected.get("expected_facts", 0):
        results["checks"].append({"check": f"Facts count ({facts_count})", "status": "PASS"})
    else:
        results["checks"].append({"check": f"Facts count ({facts_count}), expected {expected.get('expected_facts')}", "status": "FAIL"})
        results["verification_passed"] = False
    
    links_count = len(store.get_all_links())
    if links_count >= expected.get("expected_links_min", 0):
        results["checks"].append({"check": f"Links count ({links_count}, min {expected.get('expected_links_min')})", "status": "PASS"})
    else:
        results["checks"].append({"check": f"Links count ({links_count}), min expected {expected.get('expected_links_min')}", "status": "FAIL"})
        results["verification_passed"] = False
    
    return results

def main():
    print("=" * 60)
    print("MNEMON MEMORY CURATION")
    print("=" * 60)
    
    with open('/workspace/expected_manifest.json', 'r') as f:
        expected = json.load(f)
    
    print("\n1. CURATING MEETING NOTES...")
    store = curate_meeting_notes()
    
    print("\n2. STORED FACTS:")
    for fact in store.get_all_facts():
        print(f"  [{fact.id}] {fact.category}")
        print(f"    {fact.content[:60]}...")
    
    print("\n3. CREATED LINKS:")
    for link in store.get_all_links():
        print(f"  [{link.id}] {link.from_fact_id} -> {link.to_fact_id}")
        print(f"      Type: {link.relationship_type}")
        print(f"      {link.description}")
    
    print("\n4. VERIFICATION RESULTS:")
    verification = verify_memory_store(store, expected)
    for check in verification["checks"]:
        print(f"  [{check['status']}] {check['check']}")
    
    print(f"\n  OVERALL: {'PASS' if verification['verification_passed'] else 'FAIL'}")
    
    store.save_to_file('/workspace/memory_store.json')
    print("\n5. Memory store saved to /workspace/memory_store.json")

if __name__ == "__main__":
    main()
ENDOFFILE

