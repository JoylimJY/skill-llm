#!/usr/bin/env python3
"""
Memory curation script using mnemon.
Stores facts from meeting notes and creates meaningful links.
"""

import mnemon
import json

# Initialize mnemon memory store
m = mnemon.mnc()

# Clear any existing data from our namespace
for key in ['aurora/fact/1', 'aurora/fact/2', 'aurora/fact/3', 'aurora/fact/4', 'aurora/fact/5',
            'aurora/link/1', 'aurora/link/2', 'aurora/marker']:
    try:
        del m[key]
    except KeyError:
        pass

print("=" * 50)
print("MEMORY CURATION FOR PROJECT AURORA")
print("=" * 50)

# Store the marker for this project
m['aurora/marker'] = 'AURORA-ALPHA-91'
print("\n[MARKER] Stored: AURORA-ALPHA-91")

# Store the 5 key facts with sensible categories
facts = {
    1: {
        'category': 'schedule_change',
        'fact': 'Launch review moved from Friday to Monday',
        'reason': 'Demo environment needed extra QA time',
        'entities': ['launch_review', 'demo_environment', 'QA']
    },
    2: {
        'category': 'team_preference',
        'fact': 'Nina prefers concise status updates in bullet points',
        'entities': ['Nina', 'status_updates']
    },
    3: {
        'category': 'technical_decision',
        'fact': 'Team decided to keep new API endpoint stable for one more sprint',
        'entities': ['API_endpoint', 'sprint']
    },
    4: {
        'category': 'infrastructure',
        'fact': 'A rollback playbook exists for the payments service',
        'entities': ['rollback_playbook', 'payments_service']
    },
    5: {
        'category': 'incident',
        'fact': 'Demo failure last week was caused by missing environment variable in staging',
        'cause': 'missing environment variable in staging',
        'entities': ['demo_failure', 'staging', 'environment_variable']
    }
}

print("\n[STORING FACTS]")
for fact_id, fact_data in facts.items():
    key = f'aurora/fact/{fact_id}'
    m[key] = fact_data
    print(f"  Fact {fact_id}: {fact_data['category']} - {fact_data['fact'][:50]}...")

# Create meaningful links (causal or semantic relationships)
# Link 1: The demo failure (fact 5) causally led to the launch review rescheduling (fact 1)
# because the demo environment needed extra QA time
link_1 = {
    'type': 'causal',
    'from': 'aurora/fact/5',
    'to': 'aurora/fact/1',
    'relationship': 'The demo failure in staging led to the launch review being rescheduled',
    'reasoning': 'Demo failure revealed QA gaps, requiring extra testing time'
}

# Link 2: The demo environment (mentioned in fact 1) and staging (mentioned in fact 5) 
# are semantically related as both are pre-production environments
link_2 = {
    'type': 'semantic',
    'from': 'aurora/fact/1',
    'to': 'aurora/fact/5',
    'relationship': 'Both facts involve pre-production environment issues',
    'reasoning': 'Demo environment and staging are related deployment stages'
}

print("\n[CREATING LINKS]")
m['aurora/link/1'] = link_1
print(f"  Link 1: {link_1['type']} - {link_1['from']} -> {link_1['to']}")

m['aurora/link/2'] = link_2
print(f"  Link 2: {link_2['type']} - {link_2['from']} -> {link_2['to']}")

# Verification
print("\n" + "=" * 50)
print("VERIFICATION")
print("=" * 50)

stored_facts = 0
stored_links = 0

for i in range(1, 6):
    key = f'aurora/fact/{i}'
    if m.get(key):
        stored_facts += 1

for i in range(1, 3):
    key = f'aurora/link/{i}'
    if m.get(key):
        stored_links += 1

marker = m.get('aurora/marker')

print(f"\nStored facts: {stored_facts}")
print(f"Stored links: {stored_links}")
print(f"Project marker: {marker}")

# Load expected manifest
with open('/workspace/expected_manifest.json', 'r') as f:
    expected = json.load(f)

print(f"\nExpected facts: {expected['expected_facts']}")
print(f"Expected links (min): {expected['expected_links_min']}")

# Validation
print("\n[VALIDATION]")
if stored_facts == expected['expected_facts']:
    print(f"✓ Fact count matches: {stored_facts} == {expected['expected_facts']}")
else:
    print(f"✗ Fact count mismatch: {stored_facts} != {expected['expected_facts']}")

if stored_links >= expected['expected_links_min']:
    print(f"✓ Link count meets minimum: {stored_links} >= {expected['expected_links_min']}")
else:
    print(f"✗ Link count below minimum: {stored_links} < {expected['expected_links_min']}")

if marker == expected['marker_note']:
    print(f"✓ Marker matches: {marker}")
else:
    print(f"✗ Marker mismatch: {marker} != {expected['marker_note']}")

print("\n" + "=" * 50)
print("MEMORY CURATION COMPLETE")
print("=" * 50)
EOF
