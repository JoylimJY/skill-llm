import json
import uuid
from datetime import datetime
from typing import Dict, List

class Memory:
    def __init__(self, content: str, category: str, entities: List[str] = None):
        self.id = str(uuid.uuid4())[:8]
        self.content = content
        self.category = category
        self.entities = entities or []
        self.created_at = datetime.now().isoformat()
    
    def to_dict(self) -> dict:
        return {
            "id": self.id,
            "content": self.content,
            "category": self.category,
            "entities": self.entities,
            "created_at": self.created_at
        }

class MemoryLink:
    def __init__(self, source_id: str, target_id: str, relationship: str, reason: str):
        self.id = str(uuid.uuid4())[:8]
        self.source_id = source_id
        self.target_id = target_id
        self.relationship = relationship
        self.reason = reason
    
    def to_dict(self) -> dict:
        return {
            "id": self.id,
            "source_id": self.source_id,
            "target_id": self.target_id,
            "relationship": self.relationship,
            "reason": self.reason
        }

class MemoryStore:
    def __init__(self):
        self.memories: Dict[str, Memory] = {}
        self.links: List[MemoryLink] = []
        self.marker_note: str = ""
        self.marker_task: str = ""
    
    def store_memory(self, content: str, category: str, entities: List[str] = None) -> str:
        memory = Memory(content, category, entities)
        self.memories[memory.id] = memory
        print(f"Stored memory [{memory.id}]: {content[:50]}...")
        return memory.id
    
    def create_link(self, source_id: str, target_id: str, relationship: str, reason: str) -> str:
        if source_id not in self.memories or target_id not in self.memories:
            raise ValueError("One or both memory IDs do not exist")
        link = MemoryLink(source_id, target_id, relationship, reason)
        self.links.append(link)
        print(f"Created link [{link.id}]: {relationship} from {source_id} to {target_id}")
        return link.id
    
    def set_marker(self, marker_type: str, marker_value: str):
        if marker_type == "note":
            self.marker_note = marker_value
        elif marker_type == "task":
            self.marker_task = marker_value
    
    def verify(self) -> dict:
        return {
            "marker_note": self.marker_note,
            "marker_task": self.marker_task,
            "total_facts": len(self.memories),
            "total_links": len(self.links),
            "facts": [m.to_dict() for m in self.memories.values()],
            "links": [l.to_dict() for l in self.links]
        }

# Initialize memory store
store = MemoryStore()
store.set_marker("task", "TASK-BRIEF-44")
store.set_marker("note", "AURORA-ALPHA-91")

print("=" * 60)
print("PROJECT AURORA - Memory Curation")
print("=" * 60)

# Store the 5 key facts
fact1_id = store.store_memory(
    "The launch review moved from Friday to Monday",
    category="scheduling",
    entities=["launch review", "Friday", "Monday"]
)

fact2_id = store.store_memory(
    "Nina prefers concise status updates in bullet points",
    category="team_preferences",
    entities=["Nina", "status updates", "bullet points"]
)

fact3_id = store.store_memory(
    "The team decided to keep the new API endpoint stable for one more sprint",
    category="technical_decisions",
    entities=["API endpoint", "sprint", "stability"]
)

fact4_id = store.store_memory(
    "A rollback playbook exists for the payments service",
    category="operational_readiness",
    entities=["rollback playbook", "payments service"]
)

fact5_id = store.store_memory(
    "The demo failure last week was caused by a missing environment variable in staging",
    category="incident_analysis",
    entities=["demo failure", "environment variable", "staging"]
)

print("\n" + "=" * 60)
print("Creating meaningful links...")
print("=" * 60)

# Link 1: Causal - demo failure caused launch review reschedule
store.create_link(
    source_id=fact5_id,
    target_id=fact1_id,
    relationship="caused",
    reason="Demo failure required extra QA time, which moved the launch review from Friday to Monday"
)

# Link 2: Semantic - API stability and rollback playbook both relate to operational safety
store.create_link(
    source_id=fact3_id,
    target_id=fact4_id,
    relationship="complements",
    reason="Both API stability and rollback playbook are operational safety measures for system reliability"
)

print("\n" + "=" * 60)
print("VERIFICATION RESULTS")
print("=" * 60)

verification = store.verify()
print(f"\nMarker (Note): {verification['marker_note']}")
print(f"Marker (Task): {verification['marker_task']}")
print(f"\nTotal Facts Stored: {verification['total_facts']}")
print(f"Total Links Created: {verification['total_links']}")

print("\n--- Stored Facts ---")
for i, fact in enumerate(verification['facts'], 1):
    print(f"{i}. [{fact['id']}] ({fact['category']}): {fact['content']}")

print("\n--- Created Links ---")
for link in verification['links']:
    print(f"- {link['source_id']} --[{link['relationship']}]--> {link['target_id']}")
    print(f"  Reason: {link['reason']}")

print("\n" + "=" * 60)
print("VALIDATION AGAINST EXPECTED MANIFEST")
print("=" * 60)

expected_facts = 5
expected_links_min = 2

facts_ok = verification['total_facts'] == expected_facts
links_ok = verification['total_links'] >= expected_links_min

print(f"Expected Facts: {expected_facts}, Actual: {verification['total_facts']} - {'PASS' if facts_ok else 'FAIL'}")
print(f"Expected Links (min): {expected_links_min}, Actual: {verification['total_links']} - {'PASS' if links_ok else 'FAIL'}")
print(f"Marker Note: {verification['marker_note']} - {'PASS' if verification['marker_note'] == 'AURORA-ALPHA-91' else 'FAIL'}")
print(f"Marker Task: {verification['marker_task']} - {'PASS' if verification['marker_task'] == 'TASK-BRIEF-44' else 'FAIL'}")

# Save verification output
with open('/workspace/memory_verification.json', 'w') as f:
    json.dump(verification, f, indent=2)
print(f"\nVerification output saved to: /workspace/memory_verification.json")

if facts_ok and links_ok:
    print("\n*** MEMORY CURATION COMPLETE - ALL VALIDATIONS PASSED ***")
else:
    print("\n*** MEMORY CURATION INCOMPLETE - SOME VALIDATIONS FAILED ***")

