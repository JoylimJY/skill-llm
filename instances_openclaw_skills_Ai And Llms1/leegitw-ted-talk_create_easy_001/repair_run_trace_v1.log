"""
Error Messages as User Interface - Best Practices Guide

Based on the insight: Error messages should be treated as a UI, not just output.
Cryptic messages like "operation failed" cost hours of debugging time.
Informative messages like "database connection timeout after 30s, retried 3 times" save time.
"""

from dataclasses import dataclass
from typing import Optional, List
from datetime import datetime


@dataclass
class ErrorContext:
    """Collect context for building informative error messages."""
    operation: str
    details: dict
    attempts: int = 0
    duration_ms: int = 0
    suggestions: List[str] = None
    
    def __post_init__(self):
        if self.suggestions is None:
            self.suggestions = []


class UserFacingError(Exception):
    """
    An exception that provides clear, actionable information to users.
    
    Bad: "Operation failed"
    Good: "Database connection timeout after 30s, retried 3 times. 
          Try: Check network connectivity, verify database is running."
    """
    
    def __init__(self, context: ErrorContext, 
                 user_message: str = None,
                 technical_details: str = None):
        self.context = context
        self.user_message = user_message
        self.technical_details = technical_details
        super().__init__(self._build_message())
    
    def _build_message(self) -> str:
        """Build a comprehensive, user-friendly error message."""
        parts = []
        
        # What happened
        if self.user_message:
            parts.append(self.user_message)
        
        # How many times we tried
        if self.context.attempts > 1:
            parts.append(f"Retried {self.context.attempts} times")
        
        # How long it took
        if self.context.duration_ms > 0:
            parts.append(f"after {self.context.duration_ms}ms")
        
        # Suggestions
        if self.context.suggestions:
            parts.append("Suggestions: " + ", ".join(self.context.suggestions))
        
        return ". ".join(parts) if parts else "An error occurred"
    
    def __str__(self) -> str:
        msg = super().__str__()
        if self.technical_details:
            msg += f"\n\nTechnical details: {self.technical_details}"
        return msg


def make_error_informative(context: ErrorContext) -> UserFacingError:
    """
    Transform a cryptic error into an informative one.
    
    Example transformation:
    - Before: "Operation failed"
    - After: "Database connection timeout after 30000ms, retried 3 times. 
             Try: Check network connectivity, verify database is running."
    """
    return UserFacingError(context)


# Example usage demonstrating the insight
if __name__ == "__main__":
    print("=" * 60)
    print("ERROR MESSAGES AS USER INTERFACE - DEMONSTRATION")
    print("=" * 60)
    
    # Bad example - what we had before
    print("\n❌ BEFORE (Cryptic):")
    print("   Error: operation failed")
    print("   Impact: 3 hours of debugging time lost")
    
    # Good example - what we should do
    print("\n✅ AFTER (Informative):")
    context = ErrorContext(
        operation="database_query",
        details={"table": "users", "query": "SELECT * FROM users WHERE id = ?"},
        attempts=3,
        duration_ms=30000,
        suggestions=[
            "Check network connectivity",
            "Verify database is running",
            "Check if port 5432 is open"
        ]
    )
    error = UserFacingError(
        context=context,
        user_message="Database connection timeout",
        technical_details="Connection refused on host db.example.com:5432"
    )
    print(f"   Error: {error}")
    print("   Impact: Debugging time reduced from 3 hours to minutes")
    
    print("\n" + "=" * 60)
    print("KEY TAKEAWAY: Treat error messages as a user interface.")
    print("=" * 60)
EOF

