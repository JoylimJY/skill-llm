import json
import uuid
from datetime import datetime

# Read existing memory store
with open('/workspace/memory_store.json', 'r') as f:
    memory_store = json.load(f)

# Create new memory entry
entry_id = str(uuid.uuid4())
new_entry = {
    "id": entry_id,
    "content": "The release checklist for Project Orion lives in the shared docs folder and should be reviewed before Friday.",
    "category": "fact",
    "importance": 4,
    "entities": ["Orion", "release checklist", "shared docs"],
    "source": "agent",
    "created_at": datetime.now().isoformat()
}

# Add to entries list
memory_store["entries"].append(new_entry)

# Save back to file
with open('/workspace/memory_store.json', 'w') as f:
    json.dump(memory_store, f, indent=2)

print(f"Entry saved successfully!")
print(f"Entry ID: {entry_id}")
print(f"\nStored entry details:")
print(json.dumps(new_entry, indent=2))
```

